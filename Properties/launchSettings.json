{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunmessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "https://localhost:7212;http://localhost:5106",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "Preview": {
      "commandName": "Project",
      "dotnetRunmessages": true,
      "launchBrowser": true,
      "launchUrl": "preview/member-report",
      "applicationUrl": "https://localhost:7212;http://localhost:5106",
      "hotReloadEnabled": true, //hot reload in razor view
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true" //hot reload in razor view
      }
    }
  }
}
