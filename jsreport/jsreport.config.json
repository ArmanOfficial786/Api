{
  "reportTimeout": 600000,
  "extensions": {
    "express": {
      "inputRequestLimit": "200mb"
    },
    "chrome-pdf": {
      "timeout": 600000,
      "launchOptions": {
        "executablePath": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "args": [
          "--no-sandbox",
          "--disable-setuid-sandbox",
          "--disable-dev-shm-usage",
          "--disable-gpu",
          "--memory-pressure-off",
          "--max_old_space_size=4096"
        ]
      }
    }
  }
}