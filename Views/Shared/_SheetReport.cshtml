@using NexgenCosysReport.Services.ReportService
@model SheetReport
@{
    var l = Model.Layout;
    var n = Model.ColCount;
    var tableMode = Model.Body == null;
    string Mm(double v) => SheetLayout.Mm(v);

    void ColGroup()
    {
        <colgroup>
            @foreach (var w in Model.Cols)
            {
                if (w > 0) { <col style="width:@Mm(w);" /> } else { <col /> }
            }
        </colgroup>
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    @if (Model.Head != null) { @Model.Head(null) }
    <script>
    window.JSREPORT_READY_TO_START = false;

    // Table mode: make every page group exactly one sheet tall. Measured in the real renderer,
    // so html and pdf end up identical (no server-side estimate).
    window.fitFooters = function () {
        var px = 96 / 25.4,
            page = @SheetLayout.Num(l.SheetHeightMm) * px,
            min = (@SheetLayout.Num(SheetReport.FooterMm) + @SheetLayout.Num(l.MarginBottomMm)) * px;
        document.querySelectorAll('tbody.pg').forEach(function (b) {
            var pf = b.querySelector('tr.pf'); if (!pf) return;
            var used = 0;
            b.querySelectorAll(':scope > tr').forEach(function (r) {
                if (r === pf || r.classList.contains('gap')) return;
                used += r.getBoundingClientRect().height;
            });
            var h = Math.max(min, page - used) + 'px';
            pf.style.height = h;
            pf.firstElementChild.style.height = h;
            var w = pf.querySelector('.pf-wrap'); if (w) w.style.height = h;
        });
    };

    window.reportReady = function () {
        if (window.__chartsReady) return;
        try {
            window.fitFooters();
            var ps = document.querySelectorAll('.report-page, tbody.pg'), n = ps.length;
            ps.forEach(function (p, i) {
                var f = p.querySelector('.page-footer, .pf-text');
                if (f) f.textContent = 'Page ' + (i + 1) + ' of ' + n;
            });
            if (window.parent && window.parent !== window)
                window.parent.postMessage({ type: 'REPORT_PAGES_READY', totalPages: n }, '*');
        } catch (e) { }
        finally {
            window.__chartsReady = true;
            window.JSREPORT_READY_TO_START = true;   // always reached
        }
    };

    window.scrollToPage = function (n) {
        var t = document.querySelector('[data-page="' + n + '"]'), b = document.getElementById('viewOuter');
        if (!t) return;
        if (b && b.classList.contains('view-outer'))
            b.scrollTo({ top: t.offsetTop, behavior: 'smooth' });
        else
            window.scrollTo({ top: window.pageYOffset + t.getBoundingClientRect().top, behavior: 'smooth' });
    };
    </script>
    <style>
        :root { --sheet-w: @Mm(l.WidthMm); --sheet-h: @Mm(l.SheetHeightMm); --row: @Mm(Model.RowMm); --head: @Mm(Model.HeaderMm);
                --lines: @Model.CellLines; --footer: @Mm(SheetReport.FooterMm); --mb: @Mm(l.MarginBottomMm); }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 8.5pt; color: #000; background: #e1e1e5; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .text-right { text-align: right !important; } .text-center { text-align: center !important; } .text-left { text-align: left !important; }

        .meta-title td { text-align: center; font-family: "Times New Roman", Times, serif; font-size: 14pt; font-weight: bold; text-decoration: underline; padding: 6px; }
        .meta-row td { padding: 2px 6px; font-size: 9pt; }
        .meta-spacer td { height: 6px; }
        .detail-row td { border-bottom: 1px solid #eee; }
        .alt td { background: #fafafa; border-bottom: 1px solid #eee; }
        .group-header td { font-weight: bold; border-top: 1px solid #999; border-bottom: 1px solid #999; }
        .grand-total td { font-weight: bold; border-top: 2px solid #000; border-bottom: 2px solid #000; background: #f9f9f9; }

        .c { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: var(--lines); line-clamp: var(--lines);
             overflow: hidden; line-height: 3.5mm; max-height: calc(var(--lines) * 3.5mm); word-break: break-word; }

        /* ═══ TABLE MODE: one table for html / pdf / excel ══ */
        .sheet { width: var(--sheet-w); margin: 12px auto; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,.18);
                 padding: 0 @Mm(l.MarginRightMm) 0 @Mm(l.MarginLeftMm); }
        table.sheet-table { width: 100%; border-collapse: collapse; table-layout: fixed; background: #fff; }
        table.sheet-table td, table.sheet-table th { padding: 0 5px; vertical-align: middle; overflow: hidden; }
        table.sheet-table th { height: var(--head); text-align: left; font-weight: bold; white-space: nowrap; text-overflow: ellipsis;
                               border-top: 2px solid #000; border-bottom: 1px solid #000; }
        table.sheet-table tbody tr { height: var(--row); }
        table.sheet-table tr.meta-title, table.sheet-table tr.meta-row, table.sheet-table tr.meta-spacer { height: auto; }
        table.sheet-table td.hdr-cell { padding: 0; border: 0; }

        /* top margin row */
        table.sheet-table tbody tr.mt td { padding: 0; border: 0; line-height: 0; font-size: 0; }

        /* footer row: height set by fitFooters(); box pinned to the bottom above the bottom margin,
           "Page X of Y" centred on both axes inside the box */
        table.sheet-table tbody tr.pf td,
        table.sheet-table.bordered tbody tr.pf td { padding: 0; border: 0; vertical-align: bottom; overflow: hidden; line-height: 0; font-size: 0; }
      .pf-wrap { display: flex; flex-direction: column; justify-content: flex-end; }
      .pf-box { height: calc(var(--footer) + var(--mb)); width: 100%;
          display: flex; align-items: center; justify-content: center;
          font-size: 8pt; font-weight: bold; line-height: 1; text-align: center;
          box-shadow: inset 0 1px 0 #ccc; }
      .pf-text { display: block; line-height: 1; text-align: center; }

        table.sheet-table tr { break-inside: avoid; page-break-inside: avoid; }
        table.sheet-table tbody.pg { break-after: page; page-break-after: always; }
        table.sheet-table tbody.pg:last-of-type { break-after: auto; page-break-after: auto; }
        table.sheet-table tbody.pg + tbody.pg { break-before: page; page-break-before: always; }
        table.sheet-table tbody.pg + tbody.pg > tr:first-child { break-before: page; page-break-before: always; }

        table.sheet-table tr.gap { height: 24px; }
        table.sheet-table tr.gap td { padding: 0; border: 0; background: #e1e1e5; height: 24px;
                                      box-shadow: 0 0 0 100vmax #e1e1e5; clip-path: inset(0 -100vmax); }
        table.sheet-table.bordered th, table.sheet-table.bordered td { border: 1px solid #999; }
        table.sheet-table.bordered th { background: #f2f2f2; text-align: center; }
        table.sheet-table.bordered td.hdr-cell, table.sheet-table.bordered tr.mt td, table.sheet-table.bordered tr.pf td { border: 0; }

        /* ═══ CUSTOM MODE (visual reports): fixed sheets ═══ */
        .view-outer { padding: 12px 16px 20px; height: 100vh; height: 100dvh; overflow: auto; }
        .report-page { width: var(--sheet-w); height: var(--sheet-h);
            padding: @Mm(l.MarginTopMm) @Mm(l.MarginRightMm) @Mm(l.MarginBottomMm) @Mm(l.MarginLeftMm);
            margin: 0 auto 24px; background: #fff; overflow: hidden; display: flex; flex-direction: column;
            box-shadow: 0 2px 8px rgba(0,0,0,.18); page-break-after: always; break-after: page; }
        .report-page:last-child { page-break-after: auto; break-after: auto; }
        .sheet-body { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }
        .common-header-wrap { flex: none; width: 100%; overflow: hidden; }
        .page-footer { flex: none; height: calc(var(--footer) + var(--mb)); margin-bottom: calc(-1 * var(--mb));
            box-shadow: inset 0 1px 0 #ccc; display: flex; align-items: center; justify-content: center;
            padding-bottom: var(--mb); font-size: 8pt; font-weight: bold; line-height: 1; }
        table.report-table { width: 100%; border-collapse: collapse; table-layout: fixed; background: #fff; }
        table.report-table th, table.report-table td { padding: 0 5px; vertical-align: middle; overflow: hidden; }
        table.report-table thead th { height: var(--head); text-align: left; font-weight: bold; white-space: nowrap; text-overflow: ellipsis;
                                      border-top: 2px solid #000; border-bottom: 1px solid #000; }
        table.report-table tbody tr { height: var(--row); }

        .data-table { width: 100%; border-collapse: collapse; font-size: 9pt; }
        .data-table td, .data-table th { padding: 3px 5px; vertical-align: middle; }
        .data-table th { border-top: 1.5px solid #000; border-bottom: 1px solid #000; background: #f2f2f2; font-weight: bold; text-align: left; white-space: nowrap; }
        .data-table .c { display: block; max-height: none; overflow: visible; }

        @@page { size: @Mm(l.WidthMm) @Mm(l.HeightMm); margin: 0; }
        @@media print {
            html, body { background: #fff; margin: 0; padding: 0; }
            .sheet { margin: 0; box-shadow: none; }          /* width stays = paper width, same as screen */
            .view-outer { padding: 0; height: auto !important; overflow: visible !important; }
            .report-page { box-shadow: none; margin: 0; }
            tr.gap { display: none !important; }
        }
    </style>
    @if (!string.IsNullOrWhiteSpace(Model.ExtraCss)) { <style>@Html.Raw(Model.ExtraCss)</style> }
</head>
<body>
@if (tableMode)
{
    var pages = Model.Pages;
    <div class="sheet" id="viewOuter" data-fixed-sheets
         data-sheet-w="@SheetLayout.Num(l.WidthMm)" data-sheet-h="@SheetLayout.Num(l.HeightMm)">
        <table class="sheet-table @(Model.Bordered ? "bordered" : "")" data-sheet-name="@Model.SheetName">
            @{ ColGroup(); }
            @for (var p = 0; p < pages.Count; p++)
            {
                var pg = pages[p];
                <tbody class="pg" data-page="@(p + 1)">
                    <tr class="no-xl mt" style="height:@Mm(l.MarginTopMm)"><td colspan="@n" style="height:@Mm(l.MarginTopMm)"></td></tr>
                    @if (p == 0)
                    {
                        <tr class="no-xl"><td colspan="@n" class="hdr-cell">@await Html.PartialAsync("_CommonHeader", Model.Data)</td></tr>
                        if (Model.Subheader != null) { @Model.Subheader(n) }
                        if (Model.ColHeader != null) { @Model.ColHeader(n) }
                        if (Model.RowCount == 0) { <tr><td colspan="@n" class="text-center">@Model.EmptyText</td></tr> }
                    }
                    @for (var i = pg.Start; i < pg.Start + pg.Count; i++) { @Model.Row!(i) }

                    @* initial height only; fitFooters() sets the exact value in the real renderer *@
                    @{ var pfH = Mm(SheetReport.FooterMm + l.MarginBottomMm); }
                    <tr class="no-xl pf" style="height:@pfH">
                        <td colspan="@n" style="height:@pfH">
                            <div class="pf-wrap" style="height:@pfH">
                                <div class="pf-box"><span class="pf-text">Page @(p + 1) of @pages.Count</span></div>
                            </div>
                        </td>
                    </tr>
                    @if (p < pages.Count - 1)
                    {
                        <tr class="no-xl gap"><td colspan="@n"></td></tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
else
{
    <div class="view-outer" id="viewOuter" data-fixed-sheets
         data-sheet-w="@SheetLayout.Num(l.WidthMm)" data-sheet-h="@SheetLayout.Num(l.HeightMm)">
        @Model.Body!(null)
    </div>
    @if (Model.ExcelBody != null)
    {
        <div id="excelSource" style="display:none" data-sheet-name="@Model.SheetName">@Model.ExcelBody(null)</div>
    }
}

<script>
(function () {
    'use strict';
    @if (!Model.DeferReady) { <text>
    // wait for logo + fonts: they change the header height that the footer fit depends on
    var go = function () { (document.fonts ? document.fonts.ready : Promise.resolve()).then(window.reportReady); };
    if (document.readyState === 'complete') go(); else window.addEventListener('load', go);
    </text> }
    if (!(window.parent && window.parent !== window)) return;
    var box = document.getElementById('viewOuter');
    var scrolled = box && box.classList.contains('view-outer');
    var target = scrolled ? box : window, last = 1;
    target.addEventListener('scroll', function () {
        var top0 = scrolled ? box.getBoundingClientRect().top : 0;
        var h = scrolled ? box.clientHeight : window.innerHeight;
        var cur = 1;
        document.querySelectorAll('[data-page]').forEach(function (p, i) {
            if (p.getBoundingClientRect().top - top0 <= h / 3) cur = i + 1;
        });
        if (cur !== last) { last = cur; window.parent.postMessage({ type: 'REPORT_PAGE_CHANGED', page: cur }, '*'); }
    }, { passive: true });
}());
</script>
</body>
</html>