
@* Views/Shared/_CommonHeader.cshtml *@

@using JsSampleReport.Dtos.ReportDtos
@model Dictionary<string, object>

@if (Model.ContainsKey("HeaderDataSet") && Model["HeaderDataSet"] is IEnumerable<CommonHeader> headers)
{
    foreach (var h in headers)
    {
        <div style="width: 100%; font-family: 'Times New Roman', Times, serif, ">

            <!-- Row 1: Logo | Company Name | Reg No -->
            <div style="display: flex; align-items: flex-start; width: 100%;">

                <!-- Logo — left, spans all 3 rows -->
                <div style="width: 15%; display: flex; align-items: center; justify-content: center; ">
                    @if (!string.IsNullOrEmpty(h.CompanyLogo))
                    {
                        <img src="@h.CompanyLogo"
                             style="width: 90px; height: 90px; object-fit: contain;" />
                    }
                </div>

                <!-- Center + Right stacked -->
                <div style="width: 100%; display: flex; flex-direction: column;  margin-top: 3px">

                    <!-- Company Name + Reg No -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-start">
                        <div style="flex: 1; text-align: center;">
                            <div style="font-size: 20pt; font-weight: bold;">@h.CompanyName</div>
                            <div style="font-size: 11pt; margin-top: 2px;">@h.CompanyAddress</div>
                        </div>
                        <div style="text-align: right; padding: 5px 10px; white-space: nowrap;">
                            @if (!string.IsNullOrEmpty(h.RegisteredNo))
                            {
                                <span style="font-size: 10pt;"><strong>Reg.No :</strong> @h.RegisteredNo</span>
                            }
                        </div>
                    </div>

                    

                    <!-- Phone+Fax | Email+Website+PanNo -->
                    <div style="display: flex; justify-content: space-between; padding: 30px 0;">

                        <!-- Phone & Fax — left -->
                        <div style="flex: 1; padding: 5px 10px;">
                            @if (!string.IsNullOrEmpty(h.PhoneNo))
                            {
                                <div>
                                    <span style="font-weight: 600; ">PhoneNo:</span>
                                    @h.PhoneNo
                                
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(h.FaxNo))
                            {
                                    <div style="margin-top: 8px;">
                                        <span style="font-weight: 600; ">Fax No :</span>
                                        @h.FaxNo
                                
                                    </div>
                            }
                        </div>

                        <!-- Email, Website, PanNo — right -->
                        <div style="flex: 1; padding: 5px 10px;">
                            @if (!string.IsNullOrEmpty(h.CompanyEmailId))
                            {
                                <div>
                                    <span style="font-weight: 600; ">Email :</span>
                                    @h.CompanyEmailId
                                
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(h.CompanyWebSite))
                            {
                                <div style="margin-top: 8px;">
                                    <span style="font-weight: 600; ">WebSite :</span>
                                    @h.CompanyWebSite
                                
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(h.PanNo))
                            {
                                <div style="margin-top: 8px; font-size: 10pt;"><span style="font-weight: 600; ">Pan No :</span> @h.PanNo</div>
                            }
                        </div>

                    </div>
                   

                </div>

            </div>

            <!-- Divider Line -->
            <hr style="border: none; border-top: 1.6px solid #333; margin-bottom: 2px" />

        </div>
    }
}





