@using JsSampleReport.Dtos.ReportDtos
@model Dictionary<string, object>


@if (Model.ContainsKey("HeaderDataSet") && Model["HeaderDataSet"] is IEnumerable<CommonHeader> headers)
{
    foreach (var h in headers)
    {
        <tr>
            <td colspan="8" style="padding: 0;">
                <table style="width: 100%; border: none; border-collapse: collapse; font-family: Arial, sans-serif;">

                    <!-- Row 1: Logo | Company Name | Reg No -->
                    <tr>
                        <!-- Logo -->
                        <td rowspan="3" style="width: 15%; border: none; vertical-align: middle; padding: 10px;">
                            @if (!string.IsNullOrEmpty(h.CompanyLogo))
                            {
                                <img src="@h.CompanyLogo"
                                     style="width: 90px; height: 90px; object-fit: cover; border-radius: 50%;" />
                            }
                        </td>

                        <!-- Company Name -->
                        <td style="width: 55%; border: none; text-align: center; vertical-align: bottom; padding: 5px;">
                            <span style="font-size: 20pt; font-weight: bold;">@h.CompanyName</span>
                        </td>

                        <!-- Reg No -->
                        <td style="width: 30%; border: none; text-align: right; vertical-align: top; padding: 10px;">
                            @if (!string.IsNullOrEmpty(h.RegisteredNo))
                            {
                                <span style="font-size: 10pt;"><strong>Reg.No :</strong> @h.RegisteredNo</span>
                            }
                        </td>
                    </tr>

                    <!-- Row 2: Company Address -->
                    <tr>
                        <td style="border: none; text-align: center; vertical-align: top; padding: 2px;">
                            <span style="font-size: 11pt;">@h.CompanyAddress</span>
                        </td>
                        <td style="border: none;"></td>
                    </tr>

                    <!-- Row 3: Phone+Fax | Email+Website+PanNo -->
                    <tr>
                        <!-- Phone & Fax -->
                        <td style="border: none; vertical-align: top; padding: 8px 5px;">
                            @if (!string.IsNullOrEmpty(h.PhoneNo))
                            {
                                <div><strong>PhoneNo:</strong> @h.PhoneNo</div>
                            }
                            @if (!string.IsNullOrEmpty(h.FaxNo))
                            {
                                <div style="margin-top: 4px;"><strong>Fax No :</strong> @h.FaxNo</div>
                            }
                        </td>

                        <!-- Email, Website, PanNo -->
                        <td style="border: none; vertical-align: top; padding: 8px 10px;">
                            @if (!string.IsNullOrEmpty(h.CompanyEmailId))
                            {
                                <div><strong>Email :</strong> @h.CompanyEmailId</div>
                            }
                            @if (!string.IsNullOrEmpty(h.CompanyWebSite))
                            {
                                <div style="margin-top: 4px;"><strong>WebSite :</strong> @h.CompanyWebSite</div>
                            }
                            @if (!string.IsNullOrEmpty(h.PanNo))
                            {
                                <div style="margin-top: 4px;"><strong>Pan No :</strong> @h.PanNo</div>
                            }
                        </td>
                    </tr>

                    <!-- Divider Line -->
                    <tr>
                        <td colspan="3" style="border: none; padding: 5px 0;">
                            <hr style="border: none; border-top: 1.5px solid #333; margin: 0;" />
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    }
}

