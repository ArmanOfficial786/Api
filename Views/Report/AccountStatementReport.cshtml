@model Dictionary<string, object>
@using JsSampleReport.Dtos.ReportDtos
@using JsSampleReport.Dtos.RequestDtos
@{
    Layout = null;

    var dataSet = (Model["AccountStatementDataSet"] as IEnumerable<AccountStatementModel>)
                  ?.ToList() ?? new List<AccountStatementModel>();

    var balanceData = (Model["CashBankBalanceDataSet"] as IEnumerable<CashBankBalanceModel>)
                      ?.ToList() ?? new List<CashBankBalanceModel>();

    var reportType      = Model.ContainsKey("ReportType")      ? Model["ReportType"]?.ToString()      : "Summary";
    var transactionType = Model.ContainsKey("TransactionType") ? Model["TransactionType"]?.ToString() : "All";
    var branchName      = Model.ContainsKey("BranchName")      ? Model["BranchName"]?.ToString()      : "All";
    var fromDate        = Model.ContainsKey("FromDate")        ? Model["FromDate"]?.ToString()        : "";
    var toDate          = Model.ContainsKey("ToDate")          ? Model["ToDate"]?.ToString()          : "";
    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";

    var balance     = balanceData.FirstOrDefault();
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    decimal grandDebit  = dataSet.Sum(x => x.DebitAmount);
    decimal grandCredit = dataSet.Sum(x => x.CreditAmount);
    var groupedByLedgerHead = dataSet.GroupBy(x => x.LedgerHead).ToList();

    string FormatBalance(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    // Helper: combine SubLedger and SubLedger1 for SubLedger mode display
    string FormatSubLedgerDisplay(AccountStatementModel row) =>
        string.IsNullOrEmpty(row.SubLedger1) || row.SubLedger1 == "-"
            ? row.SubLedger
            : $"{row.SubLedger} — {row.SubLedger1}";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Account Statement Report</title>
   <style>
    /* Screen styles */
    body {
        font-family: Arial, sans-serif;
        font-size: 9pt;
        margin: 0;
        padding: 20px;
    }
    .report-container {
        max-width: 210mm;
        margin: 0 auto;
        background: white;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, sans-serif;
    }

    /* ========== PRINT STYLES ========== */
    @@media print {
        /* Restore page margins (top, right, bottom, left) */
        @@page {
            margin: 1cm;
        }

        body {
            margin: 0;
            padding: 0;
        }

        /* Prevent page breaks inside table rows */
        tr {
            page-break-inside: avoid;
            break-inside: avoid;
        }

        /* Optional: keep group header rows (Ledger Head) with the next row */
        tr.ledger-head-row,
        tr.main-ledger-row {
            page-break-after: avoid;
            break-after: avoid;
        }

        /* Avoid breaking inside a group of sub‑rows */
        tbody tr.detail-row {
            page-break-inside: avoid;
            break-inside: avoid;
        }

        /* Repeat table headers on every printed page */
        thead {
            display: table-header-group;
        }

        /* Ensure the container does not clip content */
        .report-container {
            margin: 0;
            padding: 0;
            width: 100%;
        }
    }
</style>
</head>
<body>
<div class="report-container">
     <!-- ========== COMMON HEADER (partial – emits multiple <tr> rows) ========== -->
          @if (!isExcel)
          {
               @await Html.PartialAsync("_CommonHeader", Model)
          }
    <!--
        ╔══════════════════════════════════════════════════════════════════╗
        ║  SINGLE MASTER TABLE – no nested tables, all grouping flat      ║
        ║  using <tr> rows with appropriate colspan / styling.            ║
        ╚══════════════════════════════════════════════════════════════════╝
    -->

    <table data-sheet-name="AccountStatementReport">
        <tbody>

           

            <!-- ========== REPORT TITLE ROW ========== -->
            <tr>
                <td colspan="6"
                    style="text-align:center; font-size:14pt; font-weight:bold;
                           text-decoration:underline; padding:8px;">
                    Account Statement Report
                </td>
            </tr>

            <!-- ========== META INFORMATION ROWS ========== -->
            <tr>
                <td colspan="3" style="padding:4px 8px;">
                    <strong>Branch Name :</strong>@branchName
                </td>
                <td colspan="3" style="padding:4px 8px; text-align:right;">
                    <strong>From Date :</strong>@fromDate
                </td>
            </tr>
            <tr>
                <td colspan="3" style="padding:4px 8px;">
                    <strong>Report Generated On :</strong>@generatedOn
                </td>
                <td colspan="3" style="padding:4px 8px; text-align:right;">
                    <strong>To Date :</strong>@toDate
                </td>
            </tr>
            <tr><td colspan="6" style="height:6px;"></td></tr>

            <!-- ========== OPENING BALANCE ROWS (flat, inside main table) ========== -->
            @if (balance != null)
            {
                <tr>
                    <td colspan="2"
                        style="border:1px solid #000; background:#f0f0f0;
                               text-align:left; padding:6px; font-weight:bold;">
                        Opening Cash Balance :
                    </td>
                    <td colspan="4"
                        style="border:1px solid #000;
                               text-align:right; padding:6px;">
                        @balance.OpeningCashBalance.ToString("N2")
                    </td>
                </tr>
                <tr>
                    <td colspan="2"
                        style="border:1px solid #000; background:#f0f0f0;
                               text-align:left; padding:6px; font-weight:bold;">
                        Opening Bank Balance :
                    </td>
                    <td colspan="4"
                        style="border:1px solid #000;
                               text-align:right; padding:6px;">
                        @balance.OpeningBankBalance.ToString("N2")
                    </td>
                </tr>
                <tr><td colspan="6" style="height:6px;"></td></tr>
            }

            <!-- ========== COLUMN HEADERS ========== -->
            <tr>
                <th style="width:15%; border-top:2px solid #000; border-bottom:1px solid #000;
                           padding:5px 8px; text-align:left;">Ledger Head</th>
                <th style="width:8%;  border-top:2px solid #000; border-bottom:1px solid #000;
                           padding:5px 8px; text-align:left;">Ledger No</th>
                <th style="width:35%; border-top:2px solid #000; border-bottom:1px solid #000;
                           padding:5px 8px; text-align:left;">Sub Ledger</th>
                <th style="width:14%; border-top:2px solid #000; border-bottom:1px solid #000;
                           padding:5px 8px; text-align:right;">Debit Amount</th>
                <th style="width:14%; border-top:2px solid #000; border-bottom:1px solid #000;
                           padding:5px 8px; text-align:right;">Credit Amount</th>
                <th style="width:14%; border-top:2px solid #000; border-bottom:1px solid #000;
                           padding:5px 8px; text-align:right;">Balance</th>
            </tr>

            <!-- ===================== DATA ROWS – GROUPING LOGIC ===================== -->

            @if (reportType == "Summary")
            {
                // -------- SUMMARY MODE: LedgerHead + MainLedger (summed) --------
                int rowCounter = 0;
                foreach (var ledgerGroup in groupedByLedgerHead)
                {
                    decimal lhDebit   = ledgerGroup.Sum(x => x.DebitAmount);
                    decimal lhCredit  = ledgerGroup.Sum(x => x.CreditAmount);
                    decimal lhBalance = ledgerGroup.Sum(x => x.Balance);

                    var mainLedgerGroups = ledgerGroup
                        .GroupBy(x => new { x.LedgerNo, x.MainLedger })
                        .ToList();

                    <!-- ========== LedgerHead header row (summary) ========== -->
                    <tr style="background:#FFFFFF;">
                        <td colspan="3"
                            style="font-weight:bold; border-top:1px solid #ccc; padding:5px 8px;">
                            @ledgerGroup.Key
                        </td>
                        <td style="font-weight:bold; text-align:right; padding:5px 8px;">
                            @lhDebit.ToString("N2")
                        </td>
                        <td style="font-weight:bold; text-align:right; padding:5px 8px;">
                            @lhCredit.ToString("N2")
                        </td>
                        <td style="font-weight:bold; text-align:right; padding:5px 8px;">
                            @FormatBalance(lhBalance)
                        </td>
                    </tr>

                    @foreach (var mainGroup in mainLedgerGroups)
                    {
                        decimal mlDebit   = mainGroup.Sum(x => x.DebitAmount);
                        decimal mlCredit  = mainGroup.Sum(x => x.CreditAmount);
                        decimal mlBalance = mainGroup.Sum(x => x.Balance);

                        string bgColor = (rowCounter % 2 == 0) ? "#D1D5DB" : "#FFFFFF";
                        <!-- ========== MainLedger summary row (indented) ========== -->
                        <tr style="background:@bgColor;">
                            <td style="padding:3px 8px;"></td>
                            <td style="padding:3px 8px;">@mainGroup.Key.LedgerNo</td>
                            <td style="padding:3px 8px 3px 24px;">@mainGroup.Key.MainLedger</td>
                            <td style="text-align:right; padding:3px 8px;">@mlDebit.ToString("N2")</td>
                            <td style="text-align:right; padding:3px 8px;">@mlCredit.ToString("N2")</td>
                            <td style="text-align:right; padding:3px 8px;">@FormatBalance(mlBalance)</td>
                        </tr>
                        rowCounter++;
                    }
                }

                <!-- ========== Grand Total row ========== -->
                <tr style="background:#FFFFFF;">
                    <td colspan="3"
                        style="border-top:2px solid #000; border-bottom:2px solid #000;
                               font-weight:bold; text-align:right; padding:5px 8px;">
                        Grand Total :
                    </td>
                    <td style="border-top:2px solid #000; border-bottom:2px solid #000;
                               font-weight:bold; text-align:right; padding:5px 8px;">
                        @grandDebit.ToString("N2")
                    </td>
                    <td style="border-top:2px solid #000; border-bottom:2px solid #000;
                               font-weight:bold; text-align:right; padding:5px 8px;">
                        @grandCredit.ToString("N2")
                    </td>
                    <td style="border-top:2px solid #000; border-bottom:2px solid #000;"></td>
                </tr>
            }

            else if (reportType == "SubLedger")
            {
                // -------- SUBLEDGER MODE: LedgerHead + MainLedger header + SubLedger rows --------
                int rowCounter = 0;
                foreach (var ledgerGroup in groupedByLedgerHead)
                {
                    decimal lhDebit   = ledgerGroup.Sum(x => x.DebitAmount);
                    decimal lhCredit  = ledgerGroup.Sum(x => x.CreditAmount);
                    decimal lhBalance = ledgerGroup.Sum(x => x.Balance);

                    var mainLedgerGroups = ledgerGroup
                        .GroupBy(x => new { x.LedgerNo, x.MainLedger })
                        .ToList();

                    <!-- ========== LedgerHead header row ========== -->
                    <tr style="background:#FFFFFF;">
                        <td colspan="3"
                            style="font-weight:bold; border-top:1px solid #ccc; padding:5px 8px;">
                            @ledgerGroup.Key
                        </td>
                        <td style="font-weight:bold; text-align:right; padding:5px 8px;">
                            @lhDebit.ToString("N2")
                        </td>
                        <td style="font-weight:bold; text-align:right; padding:5px 8px;">
                            @lhCredit.ToString("N2")
                        </td>
                        <td style="font-weight:bold; text-align:right; padding:5px 8px;">
                            @FormatBalance(lhBalance)
                        </td>
                    </tr>

                    @foreach (var mainGroup in mainLedgerGroups)
                    {
                        decimal mlDebit   = mainGroup.Sum(x => x.DebitAmount);
                        decimal mlCredit  = mainGroup.Sum(x => x.CreditAmount);
                        decimal mlBalance = mainGroup.Sum(x => x.Balance);

                        <!-- ========== MainLedger sub‑header row (shows totals for the MainLedger group) ========== -->
                        <tr style="background:#F5F5F5; font-weight:bold;">
                            <td style="padding:3px 8px;"></td>
                            <td style="padding:3px 8px;">@mainGroup.Key.LedgerNo</td>
                            <td style="padding:3px 8px 3px 24px;">@mainGroup.Key.MainLedger</td>
                            <td style="text-align:right; padding:3px 8px;">@mlDebit.ToString("N2")</td>
                            <td style="text-align:right; padding:3px 8px;">@mlCredit.ToString("N2")</td>
                            <td style="text-align:right; padding:3px 8px;">@FormatBalance(mlBalance)</td>
                        </tr>

                        @foreach (var row in mainGroup)
                        {
                            if (string.IsNullOrEmpty(row.SubLedger) || row.SubLedger == "-")
                                continue;

                            string bgColor = (rowCounter % 2 == 0) ? "#D1D5DB" : "#FFFFFF";
                            <!-- ========== SubLedger detail row ========== -->
                            <tr style="background:@bgColor;">
                                <td style="padding:2px 8px;"></td>
                                <td style="padding:2px 8px;"></td>
                                <td style="padding:2px 8px 2px 40px;">@FormatSubLedgerDisplay(row)</td>
                                <td style="text-align:right; padding:2px 8px;">@row.DebitAmount.ToString("N2")</td>
                                <td style="text-align:right; padding:2px 8px;">@row.CreditAmount.ToString("N2")</td>
                                <td style="text-align:right; padding:2px 8px;">@FormatBalance(row.Balance)</td>
                            </tr>
                            rowCounter++;
                        }
                    }
                }

                <!-- ========== Grand Total row ========== -->
                <tr style="background:#FFFFFF;">
                    <td colspan="3"
                        style="border-top:2px solid #000; border-bottom:2px solid #000;
                               font-weight:bold; text-align:right; padding:5px 8px;">
                        Grand Total :
                    </td>
                    <td style="border-top:2px solid #000; border-bottom:2px solid #000;
                               font-weight:bold; text-align:right; padding:5px 8px;">
                        @grandDebit.ToString("N2")
                    </td>
                    <td style="border-top:2px solid #000; border-bottom:2px solid #000;
                               font-weight:bold; text-align:right; padding:5px 8px;">
                        @grandCredit.ToString("N2")
                    </td>
                    <td style="border-top:2px solid #000; border-bottom:2px solid #000;"></td>
                </tr>
            }

            else if (reportType == "Detail")
            {
                // -------- DETAIL MODE: LedgerHead + MainLedger header + every individual row --------
                int rowCounter = 0;
                foreach (var ledgerGroup in groupedByLedgerHead)
                {
                    decimal lhDebit   = ledgerGroup.Sum(x => x.DebitAmount);
                    decimal lhCredit  = ledgerGroup.Sum(x => x.CreditAmount);
                    decimal lhBalance = ledgerGroup.Sum(x => x.Balance);

                    var mainLedgerGroups = ledgerGroup
                        .GroupBy(x => new { x.LedgerNo, x.MainLedger })
                        .ToList();

                    <!-- ========== LedgerHead header row ========== -->
                    <tr style="background:#FFFFFF;">
                        <td colspan="3"
                            style="font-weight:bold; border-top:1px solid #ccc; padding:5px 8px;">
                            @ledgerGroup.Key
                        </td>
                        <td style="font-weight:bold; text-align:right; padding:5px 8px;">
                            @lhDebit.ToString("N2")
                        </td>
                        <td style="font-weight:bold; text-align:right; padding:5px 8px;">
                            @lhCredit.ToString("N2")
                        </td>
                        <td style="font-weight:bold; text-align:right; padding:5px 8px;">
                            @FormatBalance(lhBalance)
                        </td>
                    </tr>

                    @foreach (var mainGroup in mainLedgerGroups)
                    {
                        decimal mlDebit   = mainGroup.Sum(x => x.DebitAmount);
                        decimal mlCredit  = mainGroup.Sum(x => x.CreditAmount);
                        decimal mlBalance = mainGroup.Sum(x => x.Balance);

                        <!-- ========== MainLedger sub‑header row (summarizes the group) ========== -->
                        <tr style="background:#F5F5F5; font-weight:bold;">
                            <td style="padding:3px 8px;"></td>
                            <td style="padding:3px 8px;">@mainGroup.Key.LedgerNo</td>
                            <td style="padding:3px 8px 3px 24px;">@mainGroup.Key.MainLedger</td>
                            <td style="text-align:right; padding:3px 8px;">@mlDebit.ToString("N2")</td>
                            <td style="text-align:right; padding:3px 8px;">@mlCredit.ToString("N2")</td>
                            <td style="text-align:right; padding:3px 8px;">@FormatBalance(mlBalance)</td>
                        </tr>

                        @foreach (var row in mainGroup)
                        {
                            string bgColor = (rowCounter % 2 == 0) ? "#D1D5DB" : "#FFFFFF";
                            <!-- ========== Individual transaction detail row ========== -->
                            <tr style="background:@bgColor;">
                                <td style="padding:2px 8px;"></td>
                                <td style="padding:2px 8px;"></td>
                                <td style="padding:2px 8px 2px 40px;">
                                    @row.SubLedger
                                    @if (!string.IsNullOrEmpty(row.SubLedger1) && row.SubLedger1 != "-")
                                    {
                                        <span style="color:#555;"> — @row.SubLedger1</span>
                                    }
                                </td>
                                <td style="text-align:right; padding:2px 8px;">@row.DebitAmount.ToString("N2")</td>
                                <td style="text-align:right; padding:2px 8px;">@row.CreditAmount.ToString("N2")</td>
                                <td style="text-align:right; padding:2px 8px;">@FormatBalance(row.Balance)</td>
                            </tr>
                            rowCounter++;
                        }
                    }
                }

                <!-- ========== Grand Total row ========== -->
                <tr style="background:#FFFFFF;">
                    <td colspan="3"
                        style="border-top:2px solid #000; border-bottom:2px solid #000;
                               font-weight:bold; text-align:right; padding:5px 8px;">
                        Grand Total :
                    </td>
                    <td style="border-top:2px solid #000; border-bottom:2px solid #000;
                               font-weight:bold; text-align:right; padding:5px 8px;">
                        @grandDebit.ToString("N2")
                    </td>
                    <td style="border-top:2px solid #000; border-bottom:2px solid #000;
                               font-weight:bold; text-align:right; padding:5px 8px;">
                        @grandCredit.ToString("N2")
                    </td>
                    <td style="border-top:2px solid #000; border-bottom:2px solid #000;"></td>
                </tr>
            }

            <!-- ========== CLOSING BALANCE ROWS (flat, inside main table) ========== -->
            @if (balance != null)
            {
                <tr><td colspan="6" style="height:6px;"></td></tr>
                <tr>
                    <td colspan="2"
                        style="border:1px solid #000; background:#f0f0f0;
                               text-align:right; padding:6px 12px; font-weight:bold;">
                        Closing Cash Balance :
                    </td>
                    <td colspan="4"
                        style="border:1px solid #000;
                               text-align:right; padding:6px 12px;">
                        @balance.ClosingCashBalance.ToString("N2")
                    </td>
                </tr>
                <tr>
                    <td colspan="2"
                        style="border:1px solid #000; background:#f0f0f0;
                               text-align:right; padding:6px 12px; font-weight:bold;">
                        Closing Bank Balance :
                    </td>
                    <td colspan="4"
                        style="border:1px solid #000;
                               text-align:right; padding:6px 12px;">
                        @balance.ClosingBankBalance.ToString("N2")
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
</body>
</html>