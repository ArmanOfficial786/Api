@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    decimal TotalOr(string key, decimal fallback)
    {
        var value = Dec(key);
        return value != 0 ? value : fallback;
    }

    var rows = (Model["Rows"] as List<CollectorWiseVisitRowDto>) ?? new List<CollectorWiseVisitRowDto>();

    var monthName = Text("MonthName");
    var year = Text("Year");
    var collectorName = Text("CollectorName");
    var visitType = Text("VisitType", "Deposit");
    var orderBy = Text("OrderBy");
    var amountType = Text("AmountType", "C");
    var generateBy = Text("GenerateBy", "V");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    var displayLabel = amountType == "C" ? "Count" : "Amount";

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalVisits = (int)Dec("TotalVisits");
    var totalAmount = Dec("TotalAmount");

    var table = new ReportTable(Model, title: "Collector Wise Visit Report", sheetName: "CollectorWiseVisit")
        .Column("SN", 3, Align.Center)
        .Column("Member Id", 15)
        .Column("Member Name", 22)
        .Column("Account No", 15)
        .Column("Deposit Type", 20)
        .Column(displayLabel, 25, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; border-left: 1px solid #ccc; border-right: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-data td.hl-visit { color: #1565c0; font-weight: bold; }");

    table.MetaRow(Fmt.Join(
        Fmt.Labeled("Collector:", collectorName),
        Fmt.Labeled("Month:", monthName),
        Fmt.Labeled("Year:", year),
        Fmt.Labeled("Visit Type:", visitType),
        Fmt.Labeled("Order By:", orderBy),
        Fmt.Labeled("Generate By:", generateBy == "A" ? "All Account" : "Only Visit"),
        Fmt.Labeled("Display:", displayLabel),
        Fmt.Labeled("Generated:", generatedOn)));

    var sn = 0;
    foreach (var row in rows)
    {
        var displayValue = amountType == "C"
            ? (row.VisitCount?.ToString() ?? "0")
            : (row.TotalAmount?.ToString("N2") ?? "0.00");

        table.Data(
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left(row.MemberId ?? ""),
            ReportCell.Left(row.MemberName ?? ""),
            ReportCell.Left(row.AccountNo ?? ""),
            ReportCell.Left(row.DepositTypeName ?? ""),
            new ReportCell(displayValue, Align.Right, 1, "hl-visit"));
    }

    if (rows.Count > 0)
    {
        table.Total("Total", 5, amountType == "C" ? totalVisits.ToString() : totalAmount.ToString("N2"));
        table.Total("Total Records", 5, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())