@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<CollectorWiseVisitRowDto>) ?? new List<CollectorWiseVisitRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var totalVisits = Model["TotalVisits"] as int? ?? 0;
    var monthName = Model["MonthName"]?.ToString() ?? "";
    var year = Model["Year"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var visitType = Model["VisitType"]?.ToString() ?? "Deposit";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var reportType = Model["ReportType"]?.ToString() ?? "L";
    var amountType = Model["AmountType"]?.ToString() ?? "C";
    var generateBy = Model["GenerateBy"]?.ToString() ?? "V";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    var isLandscape = reportType == "L";
    var displayLabel = amountType == "C" ? "Count" : "Amount";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Collector Wise Visit Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: 1px solid #ccc;
                }

                .data-table th {
                    background: #f2f2f2;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                .data-table thead {
                    display: table-row-group;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .filter-info {
                margin-bottom: 4px;
            }

            .report-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
            }

            .highlight-visit {
                color: #1565c0;
                font-weight: bold;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }

            @@page {
                @if (isLandscape)
                {
                    <text>size: landscape;
                    </text>
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th colspan="6" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">
                        Collector Wise Visit Report
                    </th>
                </tr>
                <tr>
                    <td colspan="6">
                        <div class="filter-info">
                            <strong>Collector:</strong> @collectorName &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Month:</strong> @monthName &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Year:</strong> @year &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Visit Type:</strong> @visitType &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Order By:</strong> @orderBy &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Generate By:</strong> @(generateBy == "A" ? "All Account" : "Only Visit") &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Display:</strong> @displayLabel &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Generated:</strong> @generatedOn
                        </div>
                    </td>
                </tr>
                <tr>
                    <th style="width:3%;">SN</th>
                    <th style="width:15%;">Member Id</th>
                    <th style="width:22%;">Member Name</th>
                    <th style="width:15%;">Account No</th>
                    <th style="width:20%;">Deposit Type</th>
                    <th style="width:25%;" class="text-right">@displayLabel</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        var displayValue = amountType == "C"
                            ? (row.VisitCount?.ToString() ?? "0")
                            : (row.TotalAmount?.ToString("N2") ?? "0.00");
                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            <td>@(row.AccountNo ?? "")</td>
                            <td>@(row.DepositTypeName ?? "")</td>
                            <td class="text-right highlight-visit">@displayValue</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="5" class="text-right"><strong>Total</strong></td>
                        <td class="text-right">
                            <strong>@(amountType == "C" ? totalVisits.ToString() : totalAmount.ToString("N2"))</strong>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-right"><strong>@totalRecords</strong></td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="6" class="text-center">No visit records found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>