@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9.5pt";
    const int ColumnCount = 8;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<CollectorWiseAccountCloseRowDto>) ?? new List<CollectorWiseAccountCloseRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var collectorName = Text("CollectorName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalCharge = TotalOr("TotalCharge", rows.Sum(r => r.Charge ?? 0));
    var totalNetAmount = TotalOr("TotalNetAmount", rows.Sum(r => r.NetAmount ?? 0));
    var totalCloseAmount = TotalOr("TotalCloseAmount", rows.Sum(r => r.CloseAmount ?? 0));

    var table = new ReportTable(Model, title: "Collector Wise Account Close Report", sheetName: "CollectorWiseAccountClose")
        .Column("Member Id", 11)
        .Column("Member Name", 19)
        .Column("Account No", 11)
        .Column("Opened Date", 11)
        .Column("Closed Date", 11)
        .Column("Charge", 11, Align.Right)
        .Column("Net Amount", 13, Align.Right)
        .Column("Close Amount", 13, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; border-bottom: 1.5px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-total td { border-top: 1.5px solid #000; border-bottom: 0; }");

    table.MetaRow(
        Fmt.Join(),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        4);
    table.MetaRow(
        Fmt.Labeled("Report Generated On:", generatedOn),
        Fmt.Labeled("Collector Name :", collectorName),
        4);

    foreach (var row in rows)
    {
        table.Data(
            row.MemberId ?? "",
            row.MemberName ?? "",
            row.AccountNo ?? "",
            row.AccountOpenOnBs ?? "",
            row.AccountCloseOnBs ?? "",
            Fmt.Amount(row.Charge ?? 0),
            Fmt.Amount(row.NetAmount ?? 0),
            Fmt.Amount(row.CloseAmount ?? 0));
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total:", ColumnCount - 3,
            totalCharge.ToString("N2"),
            totalNetAmount.ToString("N2"),
            totalCloseAmount.ToString("N2"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())