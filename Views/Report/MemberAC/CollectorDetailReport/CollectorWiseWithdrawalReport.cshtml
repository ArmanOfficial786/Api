@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<CollectorWiseWithdrawalRowDto>) ?? new List<CollectorWiseWithdrawalRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Company / letterhead details - wire these up to your settings/config source
    var regNo = Model.ContainsKey("RegNo") ? Model["RegNo"]?.ToString() : "3535345345345";
    var orgName = Model.ContainsKey("OrgName") ? Model["OrgName"]?.ToString() : "Cosys SACCOS";
    var address = Model.ContainsKey("Address") ? Model["Address"]?.ToString() : "Pulchwok, Lalitpur";
    var phoneNo = Model.ContainsKey("PhoneNo") ? Model["PhoneNo"]?.ToString() : "9803391696";
    var faxNo = Model.ContainsKey("FaxNo") ? Model["FaxNo"]?.ToString() : "01-4243466 , 01-4243466";
    var email = Model.ContainsKey("Email") ? Model["Email"]?.ToString() : "cosyssoftwareprivate@gmail.com";
    var website = Model.ContainsKey("Website") ? Model["Website"]?.ToString() : "www.cosys.com.np";
    var panNo = Model.ContainsKey("PanNo") ? Model["PanNo"]?.ToString() : "4324235325235";
    var logoUrl = Model.ContainsKey("LogoUrl") ? Model["LogoUrl"]?.ToString() : "/images/logo.png";

    // Group rows by collector, matching the "Collector Name" section layout in the report
    var grouped = rows
        .GroupBy(r => string.IsNullOrEmpty(r.CollectoreName) ? collectorName : r.CollectoreName)
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Collector Wise Withdrawal Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9.5pt;
                color: #000;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
                padding: 10px 20px;
            }

            /* ---------- Letterhead ---------- */
            .letterhead-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 6px;
            }

                .letterhead-table td {
                    padding: 1px 4px;
                    vertical-align: top;
                    font-size: 9.5pt;
                }

            .logo-cell {
                width: 14%;
                text-align: left;
            }

                .logo-cell img {
                    height: 55px;
                    margin-right: 2px;
                }

            .reg-no {
                text-align: right;
                font-size: 9.5pt;
            }

            .org-name {
                text-align: center;
                font-size: 17pt;
                font-weight: bold;
            }

            .org-address {
                text-align: center;
                font-size: 10.5pt;
                font-weight: bold;
            }

            .info-left {
                width: 43%;
            }

            .info-right {
                width: 43%;
            }

            /* ---------- Title ---------- */
            .report-title {
                text-align: center;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                margin: 10px 0 8px 0;
            }

            /* ---------- Filter / meta info ---------- */
            .meta-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }

                .meta-table td {
                    padding: 2px 4px;
                    font-size: 9.5pt;
                }

            .meta-right {
                text-align: right;
            }

            /* ---------- Data table ---------- */
            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9.5pt;
            }

                .data-table th {
                    text-align: left;
                    font-weight: bold;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    padding: 4px 6px;
                }

                .data-table td {
                    padding: 3px 6px;
                }

            .col-sn {
                width: 6%;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .collector-row td {
                font-weight: bold;
                padding-top: 8px;
            }

            .data-row td {
                padding-left: 18px;
            }

                .data-row td:first-child {
                    padding-left: 24px;
                }

            .subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
            }

            .record-count-row td {
                padding-left: 24px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
            }

            @@media print {
                .data-table thead {
                    display: table-header-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">Collector Wise Withdrawl Report</div>

        <table class="meta-table">
            <tr>
                <td></td>
                <td class="meta-right">
                    <strong>From Date :</strong> @fromDate &nbsp;&nbsp;&nbsp;&nbsp;
                    <strong>To Date :</strong> @toDate
                </td>
            </tr>
            <tr>
                <td><strong>Report Generated On:</strong> @generatedOn</td>
                <td class="meta-right"><strong>Collector Name :</strong> @collectorName</td>
            </tr>
        </table>

        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-sn">Collector Name</th>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Account No</th>
                    <th class="text-right">Amount</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (grouped.Any())
                {
                    foreach (var group in grouped)
                    {
                        var groupAmount = group.Sum(r => r.Amount ?? 0);
                        int sn = 0;

                        <tr class="collector-row">
                            <td colspan="6">@group.Key</td>
                        </tr>

                        foreach (var row in group)
                        {
                            sn++;
                            <tr class="data-row">
                                <td>@sn</td>
                                <td>@(row.MemberId ?? "")</td>
                                <td>@(row.MemberName ?? "")</td>
                                <td>@(row.AccountNo ?? "")</td>
                                <td class="text-right">@(row.Amount.HasValue ? row.Amount.Value.ToString("N2") : "")</td>
                                <td>@(row.Date ?? "")</td>
                            </tr>
                        }

                        <tr class="subtotal-row">
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="text-right"><strong>Total Amount :</strong></td>
                            <td class="text-right"><strong>@groupAmount.ToString("N2")</strong></td>
                            <td></td>
                        </tr>
                        <tr class="record-count-row">
                            <td>@group.Count()</td>
                            <td colspan="5"></td>
                        </tr>
                    }

                    @if (grouped.Count > 1)
                    {
                        <tr class="grand-total-row">
                            <td colspan="3" class="text-right">Grand Total</td>
                            <td class="text-right">Total Records: @totalRecords</td>
                            <td class="text-right">@totalAmount.ToString("N2")</td>
                            <td></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No withdrawal transactions found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
