@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    decimal TotalOr(string key, decimal fallback)
    {
        var value = Dec(key);
        return value != 0 ? value : fallback;
    }

    var rows = (Model["Rows"] as List<CollectorWiseWithdrawalRowDto>) ?? new List<CollectorWiseWithdrawalRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var collectorName = Text("CollectorName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var grouped = rows
        .GroupBy(r => string.IsNullOrEmpty(r.CollectoreName) ? collectorName : r.CollectoreName)
        .ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalAmount = Dec("TotalAmount");

    var table = new ReportTable(Model, title: "Collector Wise Withdrawl Report", sheetName: "CollectorWiseWithdrawal")
        .Column("Collector Name", 14)
        .Column("Member Id", 16)
        .Column("Member Name", 26)
        .Column("Account No", 16)
        .Column("Amount", 14, Align.Right)
        .Column("Date", 14)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 8px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td.sn-cell { padding-left: 24px; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-total td { border-top: 2px solid #000; border-bottom: 2px solid #000; }");

    table.MetaRow(
        Fmt.Join(),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        3);
    table.MetaRow(
        Fmt.Labeled("Report Generated On:", generatedOn),
        Fmt.Labeled("Collector Name :", collectorName),
        3);

    foreach (var group in grouped)
    {
        var groupAmount = group.Sum(r => r.Amount ?? 0);

        table.GroupTitle(group.Key ?? "");

        var sn = 0;
        foreach (var row in group)
        {
            table.Data(
                new ReportCell((++sn).ToString(), Align.Left, 1, "sn-cell"),
                ReportCell.Left(row.MemberId ?? ""),
                ReportCell.Left(row.MemberName ?? ""),
                ReportCell.Left(row.AccountNo ?? ""),
                ReportCell.Right(Fmt.Amount(row.Amount)),
                ReportCell.Left(row.Date ?? ""));
        }

        table.SubTotal("Total Amount :", 4, groupAmount.ToString("N2"), "");

        table.Data(
            new ReportCell(group.Count().ToString(), Align.Left, 1, "sn-cell"),
            ReportCell.Left("", 5));
    }

    if (grouped.Count > 1)
    {
        table.Total("Grand Total", 3, $"Total Records: {totalRecords}", totalAmount.ToString("N2"), "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())