@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    var rows = (Model["Rows"] as List<CollectorWiseCommissionRowDto>) ?? new List<CollectorWiseCommissionRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var collectorName = Text("CollectorName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Collector Wise Commission Report", sheetName: "CollectorWiseCommission")
        .Column("Member Id", 12)
        .Column("Member Name", 22)
        .Column("Type", 16)
        .Column("Account No", 12)
        .Column("Collected Amount", 13, Align.Right)
        .Column("Commission Amount", 13, Align.Right)
        .Column("Date", 12)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; border-left: 1px solid #ccc; border-right: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-data td.hl-collected { color: #2e7d32; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-commission { color: #1565c0; font-weight: bold; }");

    table.MetaRow(
        Fmt.Join(),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        4);
    table.MetaRow(
        Fmt.Labeled("Report Generated On:", generatedOn),
        Fmt.Labeled("Collector Name :", collectorName),
        4);

    foreach (var row in rows)
    {
        table.Data(
            ReportCell.Left(row.MemberId ?? ""),
            ReportCell.Left(row.MemberName ?? ""),
            ReportCell.Left(row.Type ?? ""),
            ReportCell.Left(row.AccountNo ?? ""),
            new ReportCell(Fmt.Amount(row.CollectedAmount), Align.Right, 1, "hl-collected"),
            new ReportCell(Fmt.Amount(row.CommissionAmount), Align.Right, 1, "hl-commission"),
            ReportCell.Left(row.Date ?? ""));
    }

    if (rows.Count > 0)
    {
        table.Total("Total Amount :", 4,
            Dec("TotalCollectedAmount").ToString("N2"),
            Dec("TotalCommissionAmount").ToString("N2"),
            "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())