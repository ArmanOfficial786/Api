@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<CollectorWiseCommissionRowDto>) ?? new List<CollectorWiseCommissionRowDto>();
    var totalCollectedAmount = Model["TotalCollectedAmount"] as decimal? ?? 0;
    var totalCommissionAmount = Model["TotalCommissionAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Collector Wise Commission Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .report-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 10px 0;
            }

            .meta-row {
                width: 100%;
                padding: 2px 0;
            }

                .meta-row td {
                    padding: 2px 0;
                    border: none;
                }

            .meta-right {
                text-align: right;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                margin-top: 6px;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: 1px solid #ccc;
                }

                .data-table th {
                    background: #f2f2f2;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                .data-table thead {
                    display: table-row-group;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .highlight-collected {
                color: #2e7d32;
                font-weight: bold;
            }

            .highlight-commission {
                color: #1565c0;
                font-weight: bold;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">Collector Wise Commission Report</div>

        <table class="meta-row" style="width:100%;">
            <tr>
                <td></td>
                <td class="meta-right">
                    <strong>From Date :</strong>&nbsp;&nbsp;@fromDate&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <strong>To Date :</strong>&nbsp;&nbsp;@toDate
                </td>
            </tr>
            <tr>
                <td><strong>Report Generated On:</strong>&nbsp;&nbsp;@generatedOn</td>
                <td class="meta-right"><strong>Collector Name :</strong>&nbsp;&nbsp;@collectorName</td>
            </tr>
        </table>

        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:12%;">Member Id</th>
                    <th style="width:22%;">Member Name</th>
                    <th style="width:16%;">Type</th>
                    <th style="width:12%;">Account No</th>
                    <th style="width:13%;" class="text-right">Collected Amount</th>
                    <th style="width:13%;" class="text-right">Commission Amount</th>
                    <th style="width:12%;">Date</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    foreach (var row in rows)
                    {
                        <tr>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            <td>@(row.Type ?? "")</td>
                            <td>@(row.AccountNo ?? "")</td>
                            <td class="text-right highlight-collected">@(row.CollectedAmount.HasValue ? row.CollectedAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right highlight-commission">@(row.CommissionAmount.HasValue ? row.CommissionAmount.Value.ToString("N2") : "")</td>
                            <td>@(row.Date ?? "")</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="3"></td>
                        <td class="text-right"><strong>Total Amount :</strong></td>
                        <td class="text-right"><strong>@totalCollectedAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalCommissionAmount.ToString("N2")</strong></td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="7" style="text-align:center;">No commission transactions found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
