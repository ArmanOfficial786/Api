@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<CollectorWiseCommissionSummaryRowDto>) ?? new List<CollectorWiseCommissionSummaryRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalCollectedAmount = Model["TotalCollectedAmount"] as decimal? ?? 0;
    var totalCommissionAmount = Model["TotalCommissionAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var totalCollectors = Model["TotalCollectors"] as int? ?? 0;

    // Preserve the order collectors first appear in (rows already come pre-ordered from the SP)
    var groups = rows
        .GroupBy(r => r.Collector ?? "")
        .Select(g => new
        {
            Collector = g.Key,
            Items = g.ToList(),
            CollectedTotal = g.Sum(r => r.CollectedAmount ?? 0),
            CommissionTotal = g.Sum(r => r.CommissionAmount ?? 0)
        })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Collector Wise Commission Summary Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .report-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 10px 0;
            }

            .meta-row {
                width: 100%;
            }

                .meta-row td {
                    padding: 2px 0;
                    border: none;
                }

            .meta-right {
                text-align: right;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                margin-top: 8px;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: none;
                }

                .data-table th {
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                .data-table thead {
                    display: table-row-group;
                }

            .text-right {
                text-align: right !important;
            }

            .highlight-collected {
                color: #2e7d32;
                font-weight: bold;
            }

            .highlight-commission {
                color: #1565c0;
                font-weight: bold;
            }

            .group-header td {
                font-weight: bold;
                padding-top: 10px;
            }

            .group-total td {
                border-top: 1px solid #000;
                font-weight: bold;
            }

            .grand-total td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">Collector Wise Commission Summary Report</div>

        <table class="meta-row" style="width:100%;">
            <tr>
                <td><strong>Branch Name :</strong>&nbsp;&nbsp;@branchNames</td>
                <td></td>
            </tr>
            <tr>
                <td><strong>Report Generated On:</strong>&nbsp;&nbsp;@generatedOn</td>
                <td class="meta-right">
                    <strong>From Date :</strong>&nbsp;&nbsp;@fromDate&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <strong>To Date :</strong>&nbsp;&nbsp;@toDate
                </td>
            </tr>
        </table>

        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:20%;">Collector Name</th>
                    <th style="width:30%;">Type</th>
                    <th style="width:25%;" class="text-right">Collected Amount</th>
                    <th style="width:25%;" class="text-right">Commission Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (groups.Any())
                {
                    foreach (var grp in groups)
                    {
                        if (!string.IsNullOrWhiteSpace(grp.Collector))
                        {
                            <tr class="group-header">
                                <td>@grp.Collector</td>
                                <td colspan="3"></td>
                            </tr>
                        }
                        foreach (var row in grp.Items)
                        {
                            <tr>
                                <td></td>
                                <td>@(row.Type ?? "")</td>
                                <td class="text-right highlight-collected">@(row.CollectedAmount.HasValue ? row.CollectedAmount.Value.ToString("N2") : "")</td>
                                <td class="text-right highlight-commission">@(row.CommissionAmount.HasValue ? row.CommissionAmount.Value.ToString("N2") : "")</td>
                            </tr>
                        }
                        <tr class="group-total">
                            <td></td>
                            <td class="text-right">@(!string.IsNullOrWhiteSpace(grp.Collector) ? grp.Collector : "")</td>
                            <td class="text-right">@grp.CollectedTotal.ToString("N2")</td>
                            <td class="text-right">@grp.CommissionTotal.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="2" class="text-right">Grand Total (@totalCollectors Collector@(totalCollectors == 1 ? "" : "s"), @totalRecords Record@(totalRecords == 1 ? "" : "s"))</td>
                        <td class="text-right">@totalCollectedAmount.ToString("N2")</td>
                        <td class="text-right">@totalCommissionAmount.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="4" style="text-align:center;">No commission summary found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
