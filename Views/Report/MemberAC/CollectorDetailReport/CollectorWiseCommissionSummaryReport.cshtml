@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<CollectorWiseCommissionSummaryRowDto>) ?? new List<CollectorWiseCommissionSummaryRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalCollectedAmount = Model["TotalCollectedAmount"] as decimal? ?? 0;
    var totalCommissionAmount = Model["TotalCommissionAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    var totalCollectors = Model["TotalCollectors"] as int? ?? 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Collector Wise Commission Summary Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: 1px solid #ccc;
                }

                .data-table th {
                    background: #f2f2f2;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                .data-table thead {
                    display: table-row-group;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .filter-info {
                margin-bottom: 4px;
            }

            .report-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
            }

            .highlight-collected {
                color: #2e7d32;
                font-weight: bold;
            }

            .highlight-commission {
                color: #1565c0;
                font-weight: bold;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th colspan="5" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">
                        Collector Wise Commission Summary Report
                    </th>
                </tr>
                <tr>
                    <td colspan="5">
                        <div class="filter-info">
                            <strong>Branches:</strong> @branchNames &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>From:</strong> @fromDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>To:</strong> @toDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Order By:</strong> @orderBy &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Generated:</strong> @generatedOn
                        </div>
                    </td>
                </tr>
                <tr>
                    <th style="width:3%;">SN</th>
                    <th style="width:25%;">Collector</th>
                    <th style="width:20%;">Type</th>
                    <th style="width:25%;" class="text-right">Collected Amount</th>
                    <th style="width:27%;" class="text-right">Commission Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@(row.Collector ?? "")</td>
                            <td>@(row.Type ?? "")</td>
                            <td class="text-right highlight-collected">@(row.CollectedAmount.HasValue ? row.CollectedAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right highlight-commission">@(row.CommissionAmount.HasValue ? row.CommissionAmount.Value.ToString("N2") : "")</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="3" class="text-right"><strong>Total</strong></td>
                        <td class="text-right"><strong>@totalCollectedAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalCommissionAmount.ToString("N2")</strong></td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-right"><strong>Total Collectors</strong></td>
                        <td class="text-right"><strong>@totalCollectors</strong></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-right"><strong>@totalRecords</strong></td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="5" class="text-center">No commission summary found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>