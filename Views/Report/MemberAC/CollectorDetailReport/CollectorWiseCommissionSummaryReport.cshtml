@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.CollectorDetailReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    decimal TotalOr(string key, decimal fallback)
    {
        var value = Dec(key);
        return value != 0 ? value : fallback;
    }

    var rows = (Model["Rows"] as List<CollectorWiseCommissionSummaryRowDto>) ?? new List<CollectorWiseCommissionSummaryRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var groups = rows
        .GroupBy(r => r.Collector ?? "")
        .Select(g => new
        {
            Collector = g.Key,
            Items = g.ToList(),
            CollectedTotal = g.Sum(r => r.CollectedAmount ?? 0),
            CommissionTotal = g.Sum(r => r.CommissionAmount ?? 0)
        })
        .ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalCollectors = (int)TotalOr("TotalCollectors", groups.Count);
    var totalCollectedAmount = Dec("TotalCollectedAmount");
    var totalCommissionAmount = Dec("TotalCommissionAmount");

    var table = new ReportTable(Model, title: "Collector Wise Commission Summary Report", sheetName: "CollectorWiseCommissionSummary")
        .Column("Collector Name", 20)
        .Column("Type", 30)
        .Column("Collected Amount", 25, Align.Right)
        .Column("Commission Amount", 25, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 10px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td.hl-collected { color: #2e7d32; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-commission { color: #1565c0; font-weight: bold; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; border-bottom: 0; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
    table.MetaRow(
        Fmt.Labeled("Report Generated On:", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        2);

    foreach (var group in groups)
    {
        if (!string.IsNullOrWhiteSpace(group.Collector))
        {
            table.GroupBy(
                ReportCell.Left(group.Collector),
                ReportCell.Left("", 3));
        }

        foreach (var row in group.Items)
        {
            table.Data(
                ReportCell.Left(""),
                ReportCell.Left(row.Type ?? ""),
                new ReportCell(Fmt.Amount(row.CollectedAmount), Align.Right, 1, "hl-collected"),
                new ReportCell(Fmt.Amount(row.CommissionAmount), Align.Right, 1, "hl-commission"));
        }

        table.SubTotal(group.Collector, 2,
            group.CollectedTotal.ToString("N2"),
            group.CommissionTotal.ToString("N2"));
    }

    if (rows.Count > 0)
    {
        table.Total(
            $"Grand Total ({totalCollectors} Collector{(totalCollectors == 1 ? "" : "s")}, {totalRecords} Record{(totalRecords == 1 ? "" : "s")})",
            2,
            totalCollectedAmount.ToString("N2"),
            totalCommissionAmount.ToString("N2"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())