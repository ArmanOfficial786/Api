@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestExpenseReport
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<PayableInterestTransferredRowDto>) ?? new List<PayableInterestTransferredRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalInterest = Model["TotalInterest"] as decimal? ?? 0;
    var totalTax = Model["TotalTax"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Grouped by Deposit Type, matching the image: group label row, then member rows, then a subtotal row.
    // No re-ordering here — groups/rows print in the order the repository already returned.
    var depositTypeGroups = rows
        .GroupBy(r => r.DepositTypeName ?? "")
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Saving Interest Transfer To Payable Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .type-row td {
                font-weight: bold;
                padding-top: 8px;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 5px;
                padding-bottom: 5px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="PayableInterestTransferred">
            <colgroup>
                <col style="width:15%;" />
                <col style="width:12%;" />
                <col style="width:14%;" />
                <col style="width:10%;" />
                <col style="width:17%;" />
                <col style="width:14%;" />
                <col style="width:18%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="7">Saving Interest Transfer To Payable Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="4"><strong>Branch Name :</strong> @branchNames</td>
                    <td colspan="3"></td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <tr class="meta-row">
                    <td colspan="3"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="4" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <tr>
                    <th>Deposit Type</th>
                    <th>Member Id</th>
                    <th>Account No</th>
                    <th class="text-right">Interest Rate</th>
                    <th class="text-right">Interest Amount</th>
                    <th class="text-right">Tax Amount</th>
                    <th>Interest Date</th>
                </tr>

                @if (depositTypeGroups.Any())
                {
                    foreach (var typeGroup in depositTypeGroups)
                    {
                        <tr class="type-row">
                            <td>@typeGroup.Key</td>
                            <td colspan="6"></td>
                        </tr>

                        foreach (var row in typeGroup)
                        {
                            <tr class="detail-row">
                                <td></td>
                                <td>@(row.MemberId ?? "")</td>
                                <td>@(row.AccountNo ?? "")</td>
                                <td class="text-right">@(row.InterestRate.HasValue ? row.InterestRate.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.Interest.HasValue ? row.Interest.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.Tax.HasValue ? row.Tax.Value.ToString("N2") : "")</td>
                                <td>@(row.InterestDate ?? "")</td>
                            </tr>
                        }

                        <tr class="subtotal-row">
                            <td colspan="3" class="text-right">@typeGroup.Key</td>
                            <td></td>
                            <td class="text-right">@typeGroup.Sum(r => r.Interest ?? 0).ToString("N2")</td>
                            <td class="text-right">@typeGroup.Sum(r => r.Tax ?? 0).ToString("N2")</td>
                            <td></td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Grand Total</td>
                        <td class="text-right">@totalInterest.ToString("N2")</td>
                        <td class="text-right">@totalTax.ToString("N2")</td>
                        <td></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                        <td colspan="2"></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No payable interest transferred records found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
