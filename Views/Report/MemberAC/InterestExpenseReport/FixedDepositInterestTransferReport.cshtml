@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestExpenseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";
    const int ColumnCount = 8;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string Money(decimal? value) => (value ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<FixedDepositInterestTransferRowDto>) ?? new List<FixedDepositInterestTransferRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");

    var groupedRows = rows.GroupBy(r => r.DepositTypeName ?? "Uncategorized").ToList();

    var totalInterest = Dec("TotalInterest");
    var totalTax = Dec("TotalTax");
    var totalTransactions = (int)Dec("TotalTransactions");
    var totalRecords = (int)Dec("TotalRecords");

    var table = new ReportTable(Model, title: "Fixed Deposit Interest Transfer Report", sheetName: "FixedDepositInterestTransfer")
        .Column("Saving Type", 9)
        .Column("Member Id", 10)
        .Column("Member Name", 13)
        .Column("Account No", 9)
        .Column("Interest Date", 9, Align.Center)
        .Column("Interest (Rs)", 10, Align.Right)
        .Column("Tax (Rs)", 10, Align.Right)
        .Column("Remarks", 30)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            GroupBackground = "#f5f5f5",
            SubTotalBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5, headerMm: 7, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; border-left: 1px solid #ccc; border-right: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { padding-top: 8px; padding-bottom: 2px; border-top: 1px solid #999; }\n" +
            "table.sheet-table tr.r-group td.g-first { padding-top: 4px; }\n" +
            "table.sheet-table tr.r-data td { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-data td.last-row { border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-data td.hl-interest { color: #2e7d32; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-tax { color: #c62828; font-weight: bold; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #ccc; border-bottom: 2px solid #000; }");

    table.MetaRow(
        Fmt.Labeled("Branch Name:", branchNames),
        Fmt.Labeled("Report Generated On:", generatedOn),
        4);
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));

    var firstGroup = true;
    foreach (var group in groupedRows)
    {
        table.GroupBy(new ReportCell(group.Key, Align.Left, ColumnCount, firstGroup ? "g-first" : null));
        firstGroup = false;

        var items = group.ToList();
        for (var i = 0; i < items.Count; i++)
        {
            var row = items[i];
            var last = i == items.Count - 1 ? "last-row" : null;

            table.Data(
                new ReportCell(row.DepositTypeName ?? "", Align.Left, 1, last),
                new ReportCell(row.MemberId ?? "", Align.Left, 1, last),
                new ReportCell(row.MemberName ?? "", Align.Left, 1, last),
                new ReportCell(row.AccountNo ?? "", Align.Left, 1, last),
                new ReportCell(row.InterestDate ?? "", Align.Center, 1, last),
                new ReportCell(Money(row.Interest), Align.Right, 1, last is null ? "hl-interest" : "last-row hl-interest"),
                new ReportCell(Money(row.Tax), Align.Right, 1, last is null ? "hl-tax" : "last-row hl-tax"),
                new ReportCell(row.Remarks ?? "", Align.Left, 1, last));
        }

        table.SubTotal("Sub Total", 5,
            group.Sum(r => r.Interest ?? 0).ToString("N2"),
            group.Sum(r => r.Tax ?? 0).ToString("N2"),
            "");
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 5, totalInterest.ToString("N2"), totalTax.ToString("N2"), "");
        table.Total("Total Transactions", 5, totalTransactions.ToString(), "", "");
        table.Total("Total Records", 5, totalRecords.ToString(), "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())