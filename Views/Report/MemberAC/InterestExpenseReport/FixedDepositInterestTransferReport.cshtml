@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestExpenseReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<FixedDepositInterestTransferRowDto>) ?? new List<FixedDepositInterestTransferRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalInterestAmount = Model["TotalInterestAmount"] as decimal? ?? 0;
    var totalTaxAmount = Model["TotalTaxAmount"] as decimal? ?? 0;
    var totalNetAmount = Model["TotalNetAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    var totalTransactions = Model["TotalTransactions"] as int? ?? 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Fixed Deposit Interest Transfer Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: 1px solid #ccc;
                }

                .data-table th {
                    background: #f2f2f2;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                .data-table thead {
                    display: table-row-group;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .filter-info {
                margin-bottom: 4px;
            }

            .report-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
            }

            .highlight-interest {
                color: #2e7d32;
                font-weight: bold;
            }

            .highlight-tax {
                color: #c62828;
                font-weight: bold;
            }

            .highlight-net {
                color: #1565c0;
                font-weight: bold;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th colspan="10" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">
                        Fixed Deposit Interest Transfer Report
                    </th>
                </tr>
                <tr>
                    <td colspan="10">
                        <div class="filter-info">
                            <strong>Branches:</strong> @branchNames &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>From:</strong> @fromDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>To:</strong> @toDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Order By:</strong> @orderBy &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Generated:</strong> @generatedOn
                        </div>
                    </td>
                </tr>
                <tr>
                    <th style="width:3%;">SN</th>
                    <th style="width:11%;">Member Id</th>
                    <th style="width:15%;">Member Name</th>
                    <th style="width:10%;">Account No</th>
                    <th style="width:10%;">Deposit Type</th>
                    <th style="width:10%;">Interest Date</th>
                    <th style="width:10%;" class="text-right">Interest</th>
                    <th style="width:10%;" class="text-right">Tax</th>
                    <th style="width:11%;" class="text-right">Net Amount</th>
                    <th style="width:10%;">Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            <td>@(row.AccountNo ?? "")</td>
                            <td>@(row.DepositTypeName ?? "")</td>
                            <td>@(row.InterestDateBs ?? "")</td>
                            <td class="text-right highlight-interest">@(row.InterestAmount.HasValue ? row.InterestAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right highlight-tax">@(row.TaxAmount.HasValue ? row.TaxAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right highlight-net">@(row.NetAmount.HasValue ? row.NetAmount.Value.ToString("N2") : "")</td>
                            <td>@(row.Remarks ?? "")</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="6" class="text-right"><strong>Total</strong></td>
                        <td class="text-right"><strong>@totalInterestAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalTaxAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalNetAmount.ToString("N2")</strong></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="6" class="text-right"><strong>Total Transactions</strong></td>
                        <td class="text-right"><strong>@totalTransactions</strong></td>
                        <td colspan="3"></td>
                    </tr>
                    <tr>
                        <td colspan="6" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-right"><strong>@totalRecords</strong></td>
                        <td colspan="3"></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="10" class="text-center">No fixed deposit interest transfer records found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>