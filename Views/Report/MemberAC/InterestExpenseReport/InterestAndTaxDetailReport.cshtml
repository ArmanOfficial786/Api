@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestExpenseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "6.5pt";
    const int ColumnCount = 7;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string Money(decimal? value) => (value ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<InterestAndTaxDetailRowDto>) ?? new List<InterestAndTaxDetailRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var orderBy = Text("OrderBy");
    var memberId = Text("MemberId");
    var memberName = Text("MemberName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");

    var totalInterest = Dec("TotalInterest");
    var totalTax = Dec("TotalTax");
    var totalDepositTypes = (int)Dec("TotalDepositTypes");
    var totalRecords = (int)Dec("TotalRecords");

    var groupedData = rows
        .GroupBy(r => r.DepositTypeName ?? "Uncategorized")
        .Select(depositGroup => new
        {
            DepositType = depositGroup.Key,
            Members = depositGroup
                .GroupBy(r => new { r.MemberId, r.MemberName })
                .Select(memberGroup => new
                {
                    MemberId = memberGroup.Key.MemberId,
                    MemberName = memberGroup.Key.MemberName,
                    Accounts = memberGroup.ToList()
                })
                .ToList()
        })
        .ToList();

    var table = new ReportTable(Model, title: "Savings Interest/Tax Details Report", sheetName: "InterestAndTaxDetail")
        .Column("Saving Type", 10)
        .Column("Member Id", 10)
        .Column("Member Name", 14)
        .Column("Account No", 8)
        .Column("Particulars", 38)
        .Column("Interest", 10, Align.Right)
        .Column("Tax", 10, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            GroupBackground = "#f5f5f5",
            SubTotalBackground = "#f0f0f0",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 4.5, headerMm: 6, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1.5px 3px; border-left: 1px solid #ccc; border-right: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td.dep-hdr { font-size: 7pt; padding-top: 6px; padding-bottom: 1px; border-top: 1px solid #999; }\n" +
            "table.sheet-table tr.r-group td.dep-hdr.dep-first { padding-top: 2px; }\n" +
            "table.sheet-table tr.r-group td.mem-hdr { background: #fafafa; padding-top: 4px; padding-bottom: 1px; border-top: 0; border-bottom: 1px solid #ddd; }\n" +
            "table.sheet-table tr.r-data td { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-data td.c-int { color: #2e7d32; }\n" +
            "table.sheet-table tr.r-data td.c-tax { color: #c62828; }\n" +
            "table.sheet-table tr.r-data td.amt { font-family: 'Courier New', monospace; }\n" +
            "table.sheet-table tr.r-data td.m-sub { background: #f9f9f9; font-weight: bold; border-bottom: 1px solid #999; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #ccc; border-bottom: 2px solid #000; }");

    table.MetaRow(
        Fmt.Labeled("Branch Name:", branchNames),
        Fmt.Labeled("Report Generated On:", generatedOn),
        3);
    table.MetaRow(
        Fmt.Join(Fmt.Labeled("From Date:", fromDate), Fmt.Labeled("To Date:", toDate)),
        !string.IsNullOrEmpty(memberId)
            ? Fmt.Join(Fmt.Labeled("Member Id:", memberId), Fmt.Labeled("Member Name:", memberName))
            : Fmt.Labeled("Order By:", orderBy),
        4);

    var firstDeposit = true;
    foreach (var depositGroup in groupedData)
    {
        table.GroupBy(new ReportCell(
            depositGroup.DepositType, Align.Left, ColumnCount,
            firstDeposit ? "dep-hdr dep-first" : "dep-hdr"));
        firstDeposit = false;

        foreach (var memberGroup in depositGroup.Members)
        {
            table.GroupBy(
                new ReportCell("", Align.Left, 1, "mem-hdr"),
                new ReportCell(memberGroup.MemberId ?? "", Align.Left, 1, "mem-hdr"),
                new ReportCell(memberGroup.MemberName ?? "", Align.Left, 1, "mem-hdr"),
                new ReportCell("", Align.Left, ColumnCount - 3, "mem-hdr"));

            foreach (var row in memberGroup.Accounts)
            {
                var colour = (row.Narration?.Contains("Interest") ?? false) ? "c-int" : "c-tax";

                table.Data(
                    new ReportCell("", Align.Left, 1, colour),
                    new ReportCell("", Align.Left, 1, colour),
                    new ReportCell("", Align.Left, 1, colour),
                    new ReportCell(row.AccountNo ?? "", Align.Left, 1, colour),
                    new ReportCell(row.Narration ?? "", Align.Left, 1, colour),
                    new ReportCell(Money(row.Interest), Align.Right, 1, colour + " amt"),
                    new ReportCell(Money(row.Tax), Align.Right, 1, colour + " amt"));
            }

            table.Data(
                new ReportCell("", Align.Left, 1, "m-sub"),
                new ReportCell($"{memberGroup.MemberId} {memberGroup.MemberName}", Align.Left, 2, "m-sub"),
                new ReportCell("Sub Total", Align.Right, 2, "m-sub"),
                new ReportCell(memberGroup.Accounts.Sum(r => r.Interest ?? 0).ToString("N2"), Align.Right, 1, "m-sub"),
                new ReportCell(memberGroup.Accounts.Sum(r => r.Tax ?? 0).ToString("N2"), Align.Right, 1, "m-sub"));
        }

        var depositRows = depositGroup.Members.SelectMany(m => m.Accounts).ToList();
        table.SubTotal("Grand Total", 5,
            depositRows.Sum(r => r.Interest ?? 0).ToString("N2"),
            depositRows.Sum(r => r.Tax ?? 0).ToString("N2"));
    }

    if (rows.Count > 0)
    {
        table.Total("Overall Total", 5, totalInterest.ToString("N2"), totalTax.ToString("N2"));
        table.Total("Total Deposit Types", 5, totalDepositTypes.ToString(), "");
        table.Total("Total Records", 5, totalRecords.ToString(), "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())