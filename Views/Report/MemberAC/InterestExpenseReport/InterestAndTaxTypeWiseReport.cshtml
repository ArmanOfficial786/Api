@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestExpenseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string Money(decimal? value) => (value ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<InterestAndTaxTypeWiseRowDto>) ?? new List<InterestAndTaxTypeWiseRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var reportViewName = Text("ReportViewName", "Normal");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isTaxWise = reportViewName.Contains("Tax");
    var columnCount = isTaxWise ? 6 : 5;

    string[] Fill(int labelSpan, params string[] values)
    {
        var filled = new string[columnCount - labelSpan];
        for (var i = 0; i < filled.Length; i++)
            filled[i] = i < values.Length ? values[i] : "";
        return filled;
    }

    var totalInterest = Dec("TotalInterest");
    var totalTax = Dec("TotalTax");
    var totalNetAmount = Dec("TotalNetAmount");
    var totalDepositTypes = (int)Dec("TotalDepositTypes");
    var totalRecords = (int)Dec("TotalRecords");

    var table = new ReportTable(Model, title: "Savings Type Wise Interest & Tax Report", sheetName: "InterestAndTaxTypeWise")
        .Column("Saving Type", 25)
        .Column("From Date", 15, Align.Center)
        .Column("Interest (Rs)", 15, Align.Right)
        .Column("Tax (Rs)", 15, Align.Right)
        .Column("Net Amount", 15, Align.Right);

    if (isTaxWise)
        table.Column("Tax (%)", 15, Align.Right);

    table
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            GroupBackground = "#f5f5f5",
            SubTotalBackground = "#f0f0f0",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5, headerMm: 7, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; border-left: 1px solid #ccc; border-right: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td.dep-hdr { padding-top: 8px; padding-bottom: 2px; border-top: 1px solid #999; }\n" +
            "table.sheet-table tr.r-group td.dep-hdr.dep-first { padding-top: 4px; }\n" +
            "table.sheet-table tr.r-group td.date-hdr { background: #fafafa; padding: 4px 4px 2px 15px; border-top: 0; }\n" +
            "table.sheet-table tr.r-data td { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-data td.last-row { border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-data td.amt { font-family: 'Courier New', monospace; }\n" +
            "table.sheet-table tr.r-data td.hl-interest { color: #2e7d32; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-tax { color: #c62828; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-net { color: #1565c0; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-percent { color: #f57f17; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.d-sub { background: #f9f9f9; font-weight: bold; border-bottom: 1px solid #999; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #ccc; border-bottom: 2px solid #000; }");

    table.MetaRow(
        Fmt.Labeled("Branch Name:", branchNames),
        Fmt.Labeled("Report Generated On:", generatedOn),
        3);
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date:", fromDate), Fmt.Labeled("To Date:", toDate)));

    var firstDeposit = true;
    foreach (var depositGroup in rows.GroupBy(r => r.DepositTypeName ?? "Uncategorized"))
    {
        table.GroupBy(new ReportCell(
            depositGroup.Key, Align.Left, columnCount,
            firstDeposit ? "dep-hdr dep-first" : "dep-hdr"));
        firstDeposit = false;

        foreach (var dateGroup in depositGroup.GroupBy(r => r.Date ?? ""))
        {
            table.GroupBy(new ReportCell(dateGroup.Key, Align.Left, columnCount, "date-hdr"));

            var items = dateGroup.ToList();
            for (var i = 0; i < items.Count; i++)
            {
                var row = items[i];
                var tail = i == items.Count - 1 ? " last-row" : "";

                var cells = new List<ReportCell>
                {
                    new ReportCell("", Align.Left, 1, tail.Trim().Length > 0 ? "last-row" : null),
                    new ReportCell(row.Date ?? "", Align.Center, 1, tail.Trim().Length > 0 ? "last-row" : null),
                    new ReportCell(Money(row.Interest), Align.Right, 1, "amt hl-interest" + tail),
                    new ReportCell(Money(row.Tax), Align.Right, 1, "amt hl-tax" + tail),
                    new ReportCell(Money(row.NetAmount), Align.Right, 1, "amt hl-net" + tail)
                };

                if (isTaxWise)
                    cells.Add(new ReportCell(
                        row.PercentTax.HasValue ? row.PercentTax.Value.ToString("N2") + "%" : "0.00%",
                        Align.Right, 1, "hl-percent" + tail));

                table.Data(cells.ToArray());
            }

            var subCells = new List<ReportCell>
            {
                new ReportCell("", Align.Left, 1, "d-sub"),
                new ReportCell("Sub Total", Align.Right, 1, "d-sub"),
                new ReportCell(dateGroup.Sum(r => r.Interest ?? 0).ToString("N2"), Align.Right, 1, "d-sub"),
                new ReportCell(dateGroup.Sum(r => r.Tax ?? 0).ToString("N2"), Align.Right, 1, "d-sub"),
                new ReportCell(dateGroup.Sum(r => r.NetAmount ?? 0).ToString("N2"), Align.Right, 1, "d-sub")
            };

            if (isTaxWise)
                subCells.Add(new ReportCell("", Align.Left, 1, "d-sub"));

            table.Data(subCells.ToArray());
        }

        table.SubTotal("Grand Total", 2, Fill(2,
            depositGroup.Sum(r => r.Interest ?? 0).ToString("N2"),
            depositGroup.Sum(r => r.Tax ?? 0).ToString("N2"),
            depositGroup.Sum(r => r.NetAmount ?? 0).ToString("N2")));
    }

    if (rows.Count > 0)
    {
        table.Total("Overall Total", 2, Fill(2,
            totalInterest.ToString("N2"),
            totalTax.ToString("N2"),
            totalNetAmount.ToString("N2")));
        table.Total("Total Deposit Types", 2, Fill(2, totalDepositTypes.ToString()));
        table.Total("Total Records", 2, Fill(2, totalRecords.ToString()));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())