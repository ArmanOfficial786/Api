@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestExpenseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    var rows = (Model["Rows"] as List<InterestAndTaxPostedRowDto>) ?? new List<InterestAndTaxPostedRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var orderBy = Text("OrderBy");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");

    var totalInterest = Dec("TotalInterest");
    var totalTax = Dec("TotalTax");
    var totalNetBalance = Dec("TotalNetBalance");
    var totalDepositTypes = (int)Dec("TotalDepositTypes");
    var totalRecords = (int)Dec("TotalRecords");

    var table = new ReportTable(Model, title: "Saving Interest and Tax Posted Report", sheetName: "InterestAndTaxPosted")
        .Column("Saving Type", 8)
        .Column("Member ID", 10)
        .Column("Member Name", 15)
        .Column("Account No", 8)
        .Column("Interest Date", 10)
        .Column("Rate (%)", 6, Align.Right)
        .Column("Interest", 10, Align.Right)
        .Column("Tax", 8, Align.Right)
        .Column("Net Interest", 10, Align.Right)
        .Column("Net Balance", 10, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; border-left: 1px solid #ccc; border-right: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-data td.saving-type { background: #e8f5e9; }\n" +
            "table.sheet-table tr.r-data td.hl-member { font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-account { color: #00695c; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-date { color: #6a1b9a; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-rate { color: #f57f17; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-interest { color: #2e7d32; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-tax { color: #c62828; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-net-interest { color: #e65100; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.hl-net { color: #1565c0; font-weight: bold; }");

    table.MetaRow(Fmt.Join(
        Fmt.Labeled("Branches:", branchNames),
        Fmt.Labeled("From:", fromDate),
        Fmt.Labeled("To:", toDate),
        Fmt.Labeled("Order By:", orderBy),
        Fmt.Labeled("Generated:", generatedOn)));

    foreach (var row in rows)
    {
        var rate = !string.IsNullOrEmpty(row.InterestRate) && decimal.TryParse(row.InterestRate, out var parsedRate)
            ? parsedRate.ToString("N2") + " %"
            : "";

        table.Data(
            new ReportCell(row.DepositTypeName ?? "", Align.Left, 1, "saving-type"),
            ReportCell.Left(row.MemberId ?? ""),
            new ReportCell(row.MemberName ?? "", Align.Left, 1, "hl-member"),
            new ReportCell(row.AccountNo ?? "", Align.Left, 1, "hl-account"),
            new ReportCell(row.InterestDate ?? "", Align.Left, 1, "hl-date"),
            new ReportCell(rate, Align.Right, 1, "hl-rate"),
            new ReportCell(Fmt.Amount(row.Interest), Align.Right, 1, "hl-interest"),
            new ReportCell(Fmt.Amount(row.Tax), Align.Right, 1, "hl-tax"),
            new ReportCell(Fmt.Amount(row.NetInterest), Align.Right, 1, "hl-net-interest"),
            new ReportCell(Fmt.Amount(row.NetBalance), Align.Right, 1, "hl-net"));
    }

    if (rows.Count > 0)
    {
        table.Total("Total", 6,
            totalInterest.ToString("N2"),
            totalTax.ToString("N2"),
            (totalInterest - totalTax).ToString("N2"),
            totalNetBalance.ToString("N2"));
        table.Total("Total Deposit Types", 6, totalDepositTypes.ToString(), "", "", "");
        table.Total("Total Records", 6, totalRecords.ToString(), "", "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())