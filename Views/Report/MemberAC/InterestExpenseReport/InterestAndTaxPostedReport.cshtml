@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestExpenseReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<InterestAndTaxPostedRowDto>) ?? new List<InterestAndTaxPostedRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalInterest = Model["TotalInterest"] as decimal? ?? 0;
    var totalTax = Model["TotalTax"] as decimal? ?? 0;
    var totalNetBalance = Model["TotalNetBalance"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    var totalDepositTypes = Model["TotalDepositTypes"] as int? ?? 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Interest and Tax Posted Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: 1px solid #ccc;
                }

                .data-table th {
                    background: #f2f2f2;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                .data-table thead {
                    display: table-row-group;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .filter-info {
                margin-bottom: 4px;
            }

            .report-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
            }

            .highlight-interest {
                color: #2e7d32;
                font-weight: bold;
            }

            .highlight-tax {
                color: #c62828;
                font-weight: bold;
            }

            .highlight-net {
                color: #1565c0;
                font-weight: bold;
            }

            .highlight-rate {
                color: #f57f17;
                font-weight: bold;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th colspan="10" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">
                        Saving Interest and Tax Posted Report
                    </th>
                </tr>
                <tr>
                    <td colspan="10">
                        <div class="filter-info">
                            <strong>Branches:</strong> @branchNames &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>From:</strong> @fromDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>To:</strong> @toDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Order By:</strong> @orderBy &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Generated:</strong> @generatedOn
                        </div>
                    </td>
                </tr>
                <tr>
                    <th style="width:3%;">SN</th>
                    <th style="width:12%;">Deposit Type</th>
                    <th style="width:10%;">Member ID</th>
                    <th style="width:15%;">Member Name</th>
                    <th style="width:10%;">Account No</th>
                    <th style="width:8%;">Interest Date</th>
                    <th style="width:8%;" class="text-right">Rate (%)</th>
                    <th style="width:12%;" class="text-right">Interest</th>
                    <th style="width:10%;" class="text-right">Tax</th>
                    <th style="width:12%;" class="text-right">Net Balance</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@(row.DepositTypeName ?? "")</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            <td>@(row.AccountNo ?? "")</td>
                            <td>@(row.InterestDate ?? "")</td>
                            <td class="text-right highlight-rate">@(row.InterestRate.HasValue ? row.InterestRate.Value.ToString("N2") : "")</td>
                            <td class="text-right highlight-interest">@(row.Interest.HasValue ? row.Interest.Value.ToString("N2") : "")</td>
                            <td class="text-right highlight-tax">@(row.Tax.HasValue ? row.Tax.Value.ToString("N2") : "")</td>
                            <td class="text-right highlight-net">@(row.NetBalance.HasValue ? row.NetBalance.Value.ToString("N2") : "")</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="7" class="text-right"><strong>Total</strong></td>
                        <td class="text-right"><strong>@totalInterest.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalTax.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalNetBalance.ToString("N2")</strong></td>
                    </tr>
                    <tr>
                        <td colspan="7" class="text-right"><strong>Total Deposit Types</strong></td>
                        <td class="text-right"><strong>@totalDepositTypes</strong></td>
                        <td colspan="2"></td>
                    </tr>
                    <tr>
                        <td colspan="7" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-right"><strong>@totalRecords</strong></td>
                        <td colspan="2"></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">
                            No interest and tax posted records found for the selected criteria
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>