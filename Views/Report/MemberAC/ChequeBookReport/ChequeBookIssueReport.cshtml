@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.ChequeBookReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    var rows = (Model["Rows"] as List<ChequeBookIssueRowDto>) ?? new List<ChequeBookIssueRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var memberId = Text("MemberId");
    var memberName = Text("MemberName");
    var reportView = Text("ReportView", "Date");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Cheque Book Issue Report", sheetName: "ChequeBookIssue")
        .Column("Member ID", 16)
        .Column("Member Name", 22)
        .Column("A/C No.", 16)
        .Column("Issue Date", 15)
        .Column("Cheque No. From", 15)
        .Column("Cheque No. To", 16)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff"
        })
        .Sizing(rowMm: 6.5, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; border-bottom: 1.5px solid #000; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #000; }");

    if (reportView == "Member")
    {
        table.MetaRow(Fmt.Join(Fmt.Labeled("Member Id :", memberId), Fmt.Labeled("Member Name :", memberName)));
        table.MetaRow(Fmt.Labeled("Report Generated On:", generatedOn));
    }
    else
    {
        table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
        table.MetaRow(
            Fmt.Labeled("Report Generated On:", generatedOn),
            Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
            3);
    }

    foreach (var row in rows)
    {
        table.Data(
            row.MemberId ?? "",
            row.MemberName ?? "",
            row.AccountNo ?? "",
            row.ChequeIssueDateBs ?? "",
            Fmt.Int(row.ChequeNoFrom),
            Fmt.Int(row.ChequeNoTo));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())