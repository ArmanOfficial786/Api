@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.ChequeBookReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 7;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    var rows = (Model["Rows"] as List<ChequeBookLostRowDto>) ?? new List<ChequeBookLostRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var memberId = Text("MemberId");
    var memberName = Text("MemberName");
    var reportView = Text("ReportView", "Date");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.MemberName })
        .ToList();

    var table = new ReportTable(Model, title: "Cheque Lost Report", sheetName: "ChequeLost")
        .Column("Member ID", 12)
        .Column("Member Name", 18)
        .Column("A/C No.", 14)
        .Column("Cheque No", 14)
        .Column("Issue Date", 14)
        .Column("Lost Date", 14)
        .Column("Operator", 14)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #000; }");

    if (reportView == "Member")
    {
        table.MetaRow(Fmt.Join(Fmt.Labeled("Member Id :", memberId), Fmt.Labeled("Member Name :", memberName)));
        table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));
    }
    else
    {
        table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
        table.MetaRow(
            Fmt.Labeled("Report Generated On :", generatedOn),
            Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
            3);
    }

    foreach (var memberGroup in memberGroups)
    {
        table.GroupBy(
            ReportCell.Left(memberGroup.Key.MemberId ?? ""),
            ReportCell.Left(memberGroup.Key.MemberName ?? ""),
            ReportCell.Left("", ColumnCount - 2));

        foreach (var row in memberGroup)
        {
            table.Data(
                "",
                "",
                row.AccountNo ?? "",
                Fmt.Int(row.ChequeNo),
                row.ChequeIssueDateBs ?? "",
                row.LostDateBs ?? "",
                row.Operator ?? "");
        }
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())