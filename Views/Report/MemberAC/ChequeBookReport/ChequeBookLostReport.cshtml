@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.ChequeBookReport
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<ChequeBookLostRowDto>) ?? new List<ChequeBookLostRowDto>();
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var memberId = Model["MemberId"]?.ToString() ?? "";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var reportView = Model["ReportView"]?.ToString() ?? "Date";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Grouped by Member — matches the image: Member ID/Name printed once,
    // then each of that member's lost cheques listed below it.
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.MemberName })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Cheque Lost Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .member-row td {
                font-weight: bold;
            }

            .detail-row td {
                border-bottom: 1px solid #000;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="ChequeLost">
            <colgroup>
                <col style="width:12%;" />
                <col style="width:18%;" />
                <col style="width:14%;" />
                <col style="width:14%;" />
                <col style="width:14%;" />
                <col style="width:14%;" />
                <col style="width:14%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="7">Cheque Lost Report</td>
                </tr>

                @if (reportView == "Member")
                {
                    <tr class="meta-row">
                        <td colspan="7"><strong>Member Id :</strong> @memberId &nbsp;&nbsp;&nbsp;&nbsp; <strong>Member Name :</strong> @memberName</td>
                    </tr>
                    <tr class="meta-row">
                        <td colspan="7"><strong>Report Generated On :</strong> @generatedOn</td>
                    </tr>
                }
                else
                {
                    <tr class="meta-row">
                        <td colspan="7"><strong>Branch Name :</strong> @branchNames</td>
                    </tr>
                    <tr class="meta-row">
                        <td colspan="3"><strong>Report Generated On :</strong> @generatedOn</td>
                        <td colspan="4" class="text-right">
                            <strong>From Date :</strong> @fromDate
                            &nbsp;&nbsp;&nbsp;
                            <strong>To Date :</strong> @toDate
                        </td>
                    </tr>
                }

                <tr>
                    <th>Member ID</th>
                    <th>Member Name</th>
                    <th>A/C No.</th>
                    <th>Cheque No</th>
                    <th>Issue Date</th>
                    <th>Lost Date</th>
                    <th>Operator</th>
                </tr>

                @if (memberGroups.Any())
                {
                    foreach (var memberGroup in memberGroups)
                    {
                        <tr class="member-row">
                            <td>@(memberGroup.Key.MemberId ?? "")</td>
                            <td>@(memberGroup.Key.MemberName ?? "")</td>
                            <td colspan="5"></td>
                        </tr>

                        foreach (var row in memberGroup)
                        {
                            <tr class="detail-row">
                                <td></td>
                                <td></td>
                                <td>@(row.AccountNo ?? "")</td>
                                <td>@(row.ChequeNo.HasValue ? row.ChequeNo.Value.ToString() : "")</td>
                                <td>@(row.ChequeIssueDateBs ?? "")</td>
                                <td>@(row.LostDateBs ?? "")</td>
                                <td>@(row.Operator ?? "")</td>
                            </tr>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No cheque book lost records found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
