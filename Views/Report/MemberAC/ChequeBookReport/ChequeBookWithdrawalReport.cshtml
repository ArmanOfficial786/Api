@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.ChequeBookReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 6;

    var rows = (Model["Rows"] as List<ChequeBookWithdrawalRowDto>) ?? new List<ChequeBookWithdrawalRowDto>();

    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var memberGroups = rows.GroupBy(r => new { r.MemberId, r.MemberName }).ToList();

    var table = new ReportTable(Model, title: "Cheque Withdrawal Report", sheetName: "ChequeWithdrawal")
        .Column("Member ID", 14)
        .Column("Member Name", 20)
        .Column("A/C No.", 18)
        .Column("Cheque No", 16)
        .Column("Date", 16)
        .Column("Status", 16)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff"
        })
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; border-bottom: 1.5px solid #000; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-group td.m-first { padding-top: 6px; }\n" +
            "table.sheet-table tr.r-group td.m-next { padding-top: 12px; }\n" +
            "table.sheet-table tr.r-group td.acct { padding-top: 1px; }");

    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    var firstMember = true;
    foreach (var memberGroup in memberGroups)
    {
        var memberCss = firstMember ? "m-first" : "m-next";
        firstMember = false;

        table.GroupBy(
            new ReportCell(memberGroup.Key.MemberId ?? "", Align.Left, 1, memberCss),
            new ReportCell(memberGroup.Key.MemberName ?? "", Align.Left, 1, memberCss),
            new ReportCell("", Align.Left, ColumnCount - 2, memberCss));

        foreach (var accountGroup in memberGroup.GroupBy(r => r.AccountNo ?? ""))
        {
            table.GroupBy(
                new ReportCell("", Align.Left, 2, "acct"),
                new ReportCell(accountGroup.Key, Align.Left, 1, "acct"),
                new ReportCell("", Align.Left, ColumnCount - 3, "acct"));

            foreach (var row in accountGroup)
            {
                table.Data(
                    "",
                    "",
                    "",
                    row.ChequeNo.HasValue ? row.ChequeNo.Value.ToString("D6") : "",
                    row.WithdrawalDateBs ?? "",
                    row.Status ?? "");
            }
        }
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())