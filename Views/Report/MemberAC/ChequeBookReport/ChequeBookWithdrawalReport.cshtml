@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.ChequeBookReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<ChequeBookWithdrawalRowDto>) ?? new List<ChequeBookWithdrawalRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalWithdrawals = Model["TotalWithdrawals"] as int? ?? 0;
    var accountNo = Model["AccountNo"]?.ToString() ?? "";
    var memberId = Model["MemberId"]?.ToString() ?? "";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    var hasRows = rows != null && rows.Count > 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Cheque Book Withdrawal Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: 1px solid #ccc;
                }

                .data-table th {
                    background: #f2f2f2;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                .data-table thead {
                    display: table-row-group;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .filter-info {
                margin-bottom: 4px;
            }

            .report-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
            }

            .highlight-cheque {
                color: #1565c0;
                font-weight: bold;
            }

            .highlight-status {
                font-weight: bold;
            }

            .status-withdrawn {
                color: #c62828;
            }

            .status-cancelled {
                color: #f57f17;
            }

            .status-issued {
                color: #2e7d32;
            }

            .status-cleared {
                color: #1565c0;
            }

            .status-returned {
                color: #e65100;
            }

            .status-pending {
                color: #6a1b9a;
            }

            .badge {
                padding: 2px 8px;
                border-radius: 10px;
                font-size: 8pt;
                font-weight: bold;
                display: inline-block;
            }

            .badge-withdrawn {
                background: #ffcdd2;
                color: #c62828;
            }

            .badge-cancelled {
                background: #fff3e0;
                color: #f57f17;
            }

            .badge-issued {
                background: #c8e6c9;
                color: #2e7d32;
            }

            .badge-cleared {
                background: #bbdefb;
                color: #1565c0;
            }

            .badge-returned {
                background: #ffe0b2;
                color: #e65100;
            }

            .badge-pending {
                background: #e1bee7;
                color: #6a1b9a;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th colspan="10" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">
                        Cheque Book Withdrawal Report
                    </th>
                </tr>
                <tr>
                    <td colspan="10">
                        <div class="filter-info">
                            <strong>Account No:</strong> @accountNo &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Member ID:</strong> @memberId &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Member Name:</strong> @memberName &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Order By:</strong> @orderBy &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Generated:</strong> @generatedOn
                        </div>
                    </td>
                </tr>
                <tr>
                    <th style="width:3%;">SN</th>
                    <th style="width:12%;">Member ID</th>
                    <th style="width:20%;">Member Name</th>
                    <th style="width:12%;">Account No</th>
                    <th style="width:10%;" class="highlight-cheque">Cheque No</th>
                    <th style="width:10%;">Cheque Date</th>
                    <th style="width:10%;">Withdrawal Date</th>
                    <th style="width:8%;" class="text-right">Amount</th>
                    <th style="width:10%;">Status</th>
                    <th style="width:5%;">Branch</th>
                </tr>
            </thead>
            <tbody>
                @if (hasRows)
                {
                    int sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        string badgeClass = "badge";
                        string statusLower = (row.Status ?? "").ToLower();

                        if (statusLower.Contains("withdrawn") || statusLower.Contains("withdraw"))
                        {
                            badgeClass += " badge-withdrawn";
                        }
                        else if (statusLower.Contains("cancelled"))
                        {
                            badgeClass += " badge-cancelled";
                        }
                        else if (statusLower.Contains("issued"))
                        {
                            badgeClass += " badge-issued";
                        }
                        else if (statusLower.Contains("cleared"))
                        {
                            badgeClass += " badge-cleared";
                        }
                        else if (statusLower.Contains("returned"))
                        {
                            badgeClass += " badge-returned";
                        }
                        else if (statusLower.Contains("pending"))
                        {
                            badgeClass += " badge-pending";
                        }
                        else
                        {
                            badgeClass += " badge-issued";
                        }

                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            <td>@(row.AccountNo ?? "")</td>
                            <td class="text-right highlight-cheque">@(row.ChequeNo.HasValue ? row.ChequeNo.Value.ToString() : "")</td>
                            <td>@(row.ChequeDateBs ?? "")</td>
                            <td>@(row.WithdrawalDateBs ?? "")</td>
                            <td class="text-right">@(row.WithdrawalAmount.HasValue ? row.WithdrawalAmount.Value.ToString("N2") : "")</td>
                            <td class="text-center"><span class="@badgeClass">@(row.Status ?? "N/A")</span></td>
                            <td>@(row.BranchName ?? "")</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="8" class="text-right"><strong>Total Withdrawals</strong></td>
                        <td class="text-center"><strong>@totalWithdrawals</strong></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="8" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">
                            No cheque withdrawal records found for the selected account
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>