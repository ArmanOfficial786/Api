@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestPayableReport

@model Dictionary<string, object>
@{
    Layout = null;
    var certificateDetail = Model["CertificateDetail"] as FixedDepositCertificateDetailDto;
    var showHeader = Model["ShowHeader"] as bool? ?? true;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Fixed Deposit Certificate</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 10pt;
                background: white;
            }

            .report-container {
                width: 100%;
                max-width: 800px;
                margin: 0 auto;
                overflow: visible;
            }

            .certificate-box {
                border: 2px solid #000;
                padding: 20px;
                margin-top: 10px;
            }

            .certificate-title {
                text-align: center;
                font-size: 16pt;
                font-weight: bold;
                text-decoration: underline;
                margin-bottom: 15px;
            }

            .certificate-details {
                width: 100%;
                border-collapse: collapse;
            }

                .certificate-details td {
                    padding: 6px 8px;
                }

                .certificate-details .label {
                    font-weight: bold;
                    width: 35%;
                }

                .certificate-details .value {
                    width: 65%;
                    border-bottom: 1px solid #ccc;
                }

            .text-center {
                text-align: center !important;
            }

            .text-right {
                text-align: right !important;
            }

            .filter-info {
                margin-bottom: 4px;
                font-size: 9pt;
            }

            .signature-area {
                margin-top: 30px;
                display: flex;
                justify-content: space-between;
            }

            .signature-box {
                text-align: center;
            }

            .signature-line {
                border-top: 1px solid #000;
                width: 150px;
                margin: 30px auto 5px;
            }

            @@media print {
                .no-print {
                    display: none;
                }

                .certificate-box {
                    border: 2px solid #000;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel && showHeader)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="certificate-box">
            <div class="certificate-title">
                Fixed Deposit Certificate
            </div>

            <table class="certificate-details">
                <tr>
                    <td class="label">Certificate No:</td>
                    <td class="value">@(certificateDetail?.AccountNo ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Member ID:</td>
                    <td class="value">@(certificateDetail?.MemberId ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Member Name:</td>
                    <td class="value">@(certificateDetail?.MemberName ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Father's Name:</td>
                    <td class="value">@(certificateDetail?.FatherName ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Grand Father's Name:</td>
                    <td class="value">@(certificateDetail?.GrandFatherName ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Spouse Name:</td>
                    <td class="value">@(certificateDetail?.SpouseName ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Address:</td>
                    <td class="value">@(certificateDetail?.Address ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Phone No:</td>
                    <td class="value">@(certificateDetail?.PhoneNo ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Deposit Type:</td>
                    <td class="value">@(certificateDetail?.DepositTypeName ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Account Open Date:</td>
                    <td class="value">@(certificateDetail?.AccountOpenDateBs ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Maturity Date:</td>
                    <td class="value">@(certificateDetail?.MaturityDateBs ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Deposit Amount:</td>
                    <td class="value text-right">@(certificateDetail?.DepositAmount?.ToString("N2") ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Interest Rate:</td>
                    <td class="value text-right">@(certificateDetail?.InterestRate?.ToString("N2") ?? "")%</td>
                </tr>
                <tr>
                    <td class="label">Maturity Amount:</td>
                    <td class="value text-right">@(certificateDetail?.MaturityAmount?.ToString("N2") ?? "")</td>
                </tr>
                <tr>
                    <td class="label">Remarks:</td>
                    <td class="value">@(certificateDetail?.Remarks ?? "")</td>
                </tr>
            </table>

            <div class="signature-area">
                <div class="signature-box">
                    <div class="signature-line"></div>
                    <div>Member Signature</div>
                </div>
                <div class="signature-box">
                    <div class="signature-line"></div>
                    <div>Authorized Signature</div>
                </div>
            </div>

            <div class="filter-info" style="margin-top: 15px; text-align: center;">
                <strong>Generated:</strong> @generatedOn
            </div>
        </div>
    </div>
</body>
</html>