@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestPayableReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8.5pt";
    const int ColumnCount = 11;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<InterestPayableRowDto>) ?? new List<InterestPayableRowDto>();

    var tillDate = Text("TillDate");
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var depositTypeGroups = rows.GroupBy(r => r.DepositTypeName ?? "").ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalInterest = TotalOr("TotalInterest", rows.Sum(r => r.InterestAmount ?? 0));
    var totalTax = TotalOr("TotalTax", rows.Sum(r => r.TaxAmount ?? 0));

    var table = new ReportTable(Model, title: "Interest Payable Report", sheetName: "InterestPayable")
        .Column("MemberId", 9)
        .Column("Member Name", 14)
        .Column("Account No", 10)
        .Column("Rate", 6, Align.Right)
        .Column("Date From", 9)
        .Column("Interest", 10, Align.Right)
        .Column("Tax", 9, Align.Right)
        .Column("Maturity", 9)
        .Column("Type", 7)
        .Column("Balance", 10, Align.Right)
        .Column("IsActual/Provisional", 7)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5.5, headerMm: 10, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-bottom: 1.5px solid #000; white-space: normal; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 10px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td:first-child { padding-left: 10px; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; border-bottom: 1px solid #000; padding-top: 4px; padding-bottom: 4px; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName), Fmt.Labeled("Till Date :", tillDate), 6);
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var group in depositTypeGroups)
    {
        var groupRows = group.ToList();
        var firstRow = groupRows.First();

        table.GroupBy(
            ReportCell.Left(group.Key, 3),
            ReportCell.Left(firstRow.InterestCalculationType ?? "", 2),
            ReportCell.Left("", 3),
            ReportCell.Left(firstRow.BalanceType ?? ""),
            ReportCell.Left("", 2));

        foreach (var row in groupRows)
        {
            table.Data(
                row.MemberId ?? "",
                row.MemberName ?? "",
                row.AccountNo ?? "",
                Money(row.InterestRate),
                row.InterestFrom ?? "",
                Money(row.InterestAmount),
                Money(row.TaxAmount),
                row.MaturityDate ?? "",
                row.Type ?? "",
                Money(row.Balance),
                row.IsActualOrProvisional ?? "");
        }

        table.SubTotal(
            group.Key, 5,
            groupRows.Sum(r => r.InterestAmount ?? 0).ToString("N2"),
            groupRows.Sum(r => r.TaxAmount ?? 0).ToString("N2"),
            "", "", "", "");
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 5, totalInterest.ToString("N2"), totalTax.ToString("N2"), "", "", "", "");
        table.Total($"Total Records: {totalRecords}", ColumnCount);
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())