@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestPayableReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<SavingsAccountInterestTransferRowDto>) ?? new List<SavingsAccountInterestTransferRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Group by Saving Type — drives the bold group headers
    // ("1 Year Normal Saving", "Abc Saving 2 Year", "Bal Bachat Deposit Type", ...)
    var depositTypeGroups = rows.GroupBy(r => r.DepositTypeName ?? "").ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Savings Account Next Interest Transfer Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                background: white;
                color: #000;
                padding: 20px;
            }

            .report-container {
                width: 100%;
                max-width: 1200px;
                margin: 0 auto;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9.5pt;
            }

                .data-table td, .data-table th {
                    border: none;
                    vertical-align: top;
                }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            /* -------- Title row -------- */
            .report-title td {
                text-align: center;
                font-family: 'Times New Roman', Times, serif;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 0 12px 0;
            }

            /* -------- Filter rows (Branch / Generated / From-To) -------- */
            .filter-row td {
                padding: 2px 6px;
                font-size: 9.5pt;
            }

            .filter-row.filter-last td {
                padding-bottom: 6px;
                border-bottom: 1px solid #000;
            }

            .filter-row .label {
                font-weight: bold;
            }

            /* -------- Column header row -------- */
            .column-header-row th {
                text-align: left;
                font-weight: bold;
                font-size: 9.5pt;
                padding: 6px 6px 6px 6px;
                border-bottom: 1.5px solid #000;
                white-space: nowrap;
            }

            /* -------- Group header (saving type) -------- */
            .group-header-row td {
                font-weight: bold;
                font-size: 10pt;
                padding: 10px 6px 4px 6px;
            }

            .group-header-row.first-group td {
                padding-top: 8px;
            }

            /* -------- Detail rows -------- */
            .detail-row td {
                padding: 3px 6px;
            }

            /* -------- Rule drawn under the last row of every group -------- */
            .group-divider-row td {
                padding: 0 6px;
            }

            .group-divider-row hr {
                border: none;
                border-top: 1px solid #000;
                margin: 4px 0 0 0;
            }

            /* -------- Footer -------- */
            .summary-row td {
                padding: 6px 6px 3px 6px;
                font-weight: bold;
                border-top: 1.5px solid #000;
            }

            @@media print {
                body {
                    padding: 10px;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <colgroup>
                <col style="width:16%;">
                <col style="width:12%;">
                <col style="width:22%;">
                <col style="width:16%;">
                <col style="width:17%;">
                <col style="width:17%;">
            </colgroup>
            <tbody>
                <tr class="report-title">
                    <td colspan="6">Savings Account Next Interest Transfer Report</td>
                </tr>

                <tr class="filter-row">
                    <td colspan="6"><span class="label">Branch Name :</span> @branchNames</td>
                </tr>
                <tr class="filter-row filter-last">
                    <td colspan="2"><span class="label">Report Generated On:</span> @generatedOn</td>
                    <td colspan="2"><span class="label">From Date :</span> @fromDate</td>
                    <td colspan="2"><span class="label">To Date :</span> @toDate</td>
                </tr>

                <tr class="column-header-row">
                    <th>Saving Type</th>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Account No</th>
                    <th>A/C Opened Date</th>
                    <th>Interest Date</th>
                </tr>

                @if (depositTypeGroups.Any())
                {
                    bool isFirstGroup = true;
                    foreach (var group in depositTypeGroups)
                    {
                        var groupRows = group.ToList();

                        <tr class="group-header-row @(isFirstGroup ? "first-group" : "")">
                            <td colspan="6">@group.Key</td>
                        </tr>
                        isFirstGroup = false;

                        foreach (var row in groupRows)
                        {
                            <tr class="detail-row">
                                <td></td>
                                <td>@(row.MemberId ?? "")</td>
                                <td>@(row.MemberName ?? "")</td>
                                <td>@(row.AccountNo ?? "")</td>
                                <td>@(row.AccountOpenDate ?? "")</td>
                                <td>@(row.NextInterestDate ?? "")</td>
                            </tr>
                        }

                        <tr class="group-divider-row">
                            <td colspan="6"><hr /></td>
                        </tr>
                    }

                    <tr class="summary-row">
                        <td colspan="5" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center" style="padding: 20px 0; font-size: 10pt; color: #666;">
                            No savings account interest transfer records found for the selected criteria
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
