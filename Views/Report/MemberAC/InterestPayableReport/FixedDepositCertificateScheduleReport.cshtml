@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestPayableReport

@model Dictionary<string, object>
@{
    Layout = null;

    var certificateDetail = Model["CertificateDetail"] as FixedDepositCertificateDetailDto;
    var scheduleRows = (Model["ScheduleRows"] as List<FixedDepositScheduleRowDto>) ?? new List<FixedDepositScheduleRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalInterest = Model["TotalInterest"] as decimal? ?? 0;
    var totalTax = Model["TotalTax"] as decimal? ?? 0;
    var totalNetAmount = Model["TotalNetAmount"] as decimal? ?? 0;
    var showHeader = Model["ShowHeader"] as bool? ?? true;
    var accountNo = Model["AccountNo"]?.ToString() ?? "";
    var memberId = Model["MemberId"]?.ToString() ?? "";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var reportType = Model["ReportType"]?.ToString() ?? "Certificate";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    var isSchedule = reportType == "Schedule";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Fixed Deposit @(isSchedule ? "Schedule" : "Certificate")</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            /* ---- Shared header/meta ---- */
            .meta-title {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-block {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 6px;
            }

                .meta-block td {
                    padding: 3px 6px;
                }

            /* ---- Certificate mode ---- */
            .certificate-box {
                border: 2px solid #000;
                padding: 20px;
                margin-top: 10px;
                max-width: 800px;
                margin-left: auto;
                margin-right: auto;
            }

            .certificate-details {
                width: 100%;
                border-collapse: collapse;
            }

                .certificate-details td {
                    padding: 6px 8px;
                }

                .certificate-details .label {
                    font-weight: bold;
                    width: 35%;
                }

                .certificate-details .value {
                    width: 65%;
                    border-bottom: 1px solid #ccc;
                }

            .signature-area {
                margin-top: 30px;
                display: flex;
                justify-content: space-between;
            }

            .signature-box {
                text-align: center;
            }

            .signature-line {
                border-top: 1px solid #000;
                width: 150px;
                margin: 30px auto 5px;
            }

            /* ---- Schedule mode ---- */
            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

                .data-table th {
                    background: #f9f9f9;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                    white-space: nowrap;
                }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel && showHeader)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        @if (!isSchedule)
        {
            <div class="certificate-box">
                <div class="meta-title">Fixed Deposit Certificate</div>

                <table class="certificate-details">
                    <tr>
                        <td class="label">Certificate No:</td>
                        <td class="value">@(certificateDetail?.AccountNo ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Member ID:</td>
                        <td class="value">@(certificateDetail?.MemberId ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Member Name:</td>
                        <td class="value">@(certificateDetail?.MemberName ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Address:</td>
                        <td class="value">@(certificateDetail?.Address ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Phone No:</td>
                        <td class="value">@(certificateDetail?.PhoneNo ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Deposit Type:</td>
                        <td class="value">@(certificateDetail?.AccountType ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Account Open Date:</td>
                        <td class="value">@(certificateDetail?.AccountOpenOnBS ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Maturity Date:</td>
                        <td class="value">@(certificateDetail?.MaturityOnBs ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Deposit Amount:</td>
                        <td class="value text-right">@(certificateDetail?.DealAmount?.ToString("N2") ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Interest Rate:</td>
                        <td class="value text-right">@(certificateDetail?.InterestRate ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Interest Transfer:</td>
                        <td class="value">@(certificateDetail?.InterestTransfer ?? "")</td>
                    </tr>
                    <tr>
                        <td class="label">Interest Calculation:</td>
                        <td class="value">@(certificateDetail?.InterestCalculation ?? "")</td>
                    </tr>
                </table>

                <div class="signature-area">
                    <div class="signature-box">
                        <div class="signature-line"></div>
                        <div>Member Signature</div>
                    </div>
                    <div class="signature-box">
                        <div class="signature-line"></div>
                        <div>Authorized Signature</div>
                    </div>
                </div>

                <div class="meta-row text-center" style="margin-top: 15px;">
                    <strong>Generated:</strong> @generatedOn
                </div>
            </div>
        }
        else
        {
            <table class="data-table" data-sheet-name="FixedDepositSchedule">
                <colgroup>
                    <col style="width:8%;" />
                    <col style="width:22%;" />
                    <col style="width:18%;" />
                    <col style="width:18%;" />
                    <col style="width:18%;" />
                    <col style="width:16%;" />
                </colgroup>
                <tbody>
                    <tr class="meta-title">
                        <td colspan="6">Fixed Deposit Schedule Report</td>
                    </tr>

                    <tr class="meta-row">
                        <td colspan="3"><strong>Member Id :</strong> @memberId &nbsp;&nbsp;&nbsp; <strong>Name :</strong> @memberName</td>
                        <td colspan="3" class="text-right"><strong>Account No :</strong> @accountNo</td>
                    </tr>

                    <tr class="meta-row">
                        <td colspan="3"><strong>Deposit Type :</strong> @(certificateDetail?.AccountType ?? "")</td>
                        <td colspan="3" class="text-right"><strong>Report Generated On :</strong> @generatedOn</td>
                    </tr>

                    <tr>
                        <th>S.N.</th>
                        <th>Interest Date (BS)</th>
                        <th class="text-right">Days</th>
                        <th class="text-right">Interest</th>
                        <th class="text-right">Tax</th>
                        <th class="text-right">Net Amount</th>
                    </tr>

                    @if (scheduleRows.Any())
                    {
                        foreach (var row in scheduleRows)
                        {
                            <tr class="detail-row">
                                <td>@(row.SN?.ToString() ?? "")</td>
                                <td>@(row.InterestDateOnBs ?? "")</td>
                                <td class="text-right">@(row.DaysNo?.ToString() ?? "")</td>
                                <td class="text-right">@(row.Interest.HasValue ? row.Interest.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.Tax.HasValue ? row.Tax.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.NetAmount.HasValue ? row.NetAmount.Value.ToString("N2") : "")</td>
                            </tr>
                        }

                        <tr class="grand-total-row">
                            <td colspan="3" class="text-right">Grand Total</td>
                            <td class="text-right">@totalInterest.ToString("N2")</td>
                            <td class="text-right">@totalTax.ToString("N2")</td>
                            <td class="text-right">@totalNetAmount.ToString("N2")</td>
                        </tr>
                        <tr class="grand-total-row">
                            <td colspan="3" class="text-right">Total Records</td>
                            <td class="text-right" colspan="3">@totalRecords</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No schedule records found for this account</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</body>
</html>






