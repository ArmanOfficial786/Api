@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestPayableReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var certificateDetail = Model["CertificateDetail"] as FixedDepositCertificateDetailDto;
    var scheduleRows = (Model["ScheduleRows"] as List<FixedDepositScheduleRowDto>) ?? new List<FixedDepositScheduleRowDto>();

    var accountNo = Text("AccountNo");
    var memberId = Text("MemberId");
    var memberName = Text("MemberName");
    var isSchedule = Text("ReportType", "Certificate") == "Schedule";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");

    ReportTable table;

    if (isSchedule)
    {
        var totalRecords = (int)Dec("TotalRecords");

        table = new ReportTable(Model, title: "Fixed Deposit Schedule Report", sheetName: "FixedDepositSchedule")
            .Column("S.N.", 8)
            .Column("Interest Date (BS)", 22)
            .Column("Days", 18, Align.Right)
            .Column("Interest", 18, Align.Right)
            .Column("Tax", 18, Align.Right)
            .Column("Net Amount", 16, Align.Right)
            .Style(new ReportStyle
            {
                ZebraStripes = false
            })
            .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
            .Css(
                "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
                "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }");

        table.MetaRow(
            Fmt.Join(Fmt.Labeled("Member Id :", memberId), Fmt.Labeled("Name :", memberName)),
            Fmt.Labeled("Account No :", accountNo),
            3);
        table.MetaRow(
            Fmt.Labeled("Deposit Type :", certificateDetail?.AccountType ?? ""),
            Fmt.Labeled("Report Generated On :", generatedOn),
            3);

        foreach (var row in scheduleRows)
        {
            table.Data(
                row.SN?.ToString() ?? "",
                row.InterestDateOnBs ?? "",
                row.DaysNo?.ToString() ?? "",
                Money(row.Interest),
                Money(row.Tax),
                Money(row.NetAmount));
        }

        if (scheduleRows.Count > 0)
        {
            table.Total("Grand Total", 3,
                Dec("TotalInterest").ToString("N2"),
                Dec("TotalTax").ToString("N2"),
                Dec("TotalNetAmount").ToString("N2"));
            table.Total("Total Records", 5, totalRecords.ToString());
        }
        else
        {
            table.Data(ReportCell.Center("No schedule records found for this account", 6));
        }
    }
    else
    {
        table = new ReportTable(Model, title: "Fixed Deposit Certificate", sheetName: "FixedDepositCertificate")
            .Column("", 35)
            .Column("", 10)
            .Column("", 20)
            .Column("", 10)
            .Column("", 25)
            .NoColumnHeader()
            .Style(new ReportStyle
            {
                ZebraStripes = false
            })
            .Sizing(rowMm: 9, headerMm: 0, firstPageExtraMm: 60)
            .Css(
                "table.sheet-table tr.r-data td { font-size: " + fontSize + "; padding: 6px 8px; border-bottom: 0; }\n" +
                "table.sheet-table tr.r-data td.cert-label { font-weight: bold; }\n" +
                "table.sheet-table tr.r-data td.cert-value { border-bottom: 1px solid #ccc; }\n" +
                "table.sheet-table tr.r-data td.sig-space { height: 14mm; }\n" +
                "table.sheet-table tr.r-data td.sig { border-top: 1px solid #000; text-align: center; padding-top: 3px; }\n" +
                "table.sheet-table tr.r-data td.gen { text-align: center; }");

        ReportCell Label(string text) => new ReportCell(text, Align.Left, 1, "cert-label");
        ReportCell Value(string text, Align align = Align.Left) => new ReportCell(text, align, 4, "cert-value");

        table.Data(Label("Certificate No:"), Value(certificateDetail?.AccountNo ?? ""));
        table.Data(Label("Member ID:"), Value(certificateDetail?.MemberId ?? ""));
        table.Data(Label("Member Name:"), Value(certificateDetail?.MemberName ?? ""));
        table.Data(Label("Address:"), Value(certificateDetail?.Address ?? ""));
        table.Data(Label("Phone No:"), Value(certificateDetail?.PhoneNo ?? ""));
        table.Data(Label("Deposit Type:"), Value(certificateDetail?.AccountType ?? ""));
        table.Data(Label("Account Open Date:"), Value(certificateDetail?.AccountOpenOnBS ?? ""));
        table.Data(Label("Maturity Date:"), Value(certificateDetail?.MaturityOnBs ?? ""));
        table.Data(Label("Deposit Amount:"), Value(certificateDetail?.DealAmount?.ToString("N2") ?? "", Align.Right));
        table.Data(Label("Interest Rate:"), Value(certificateDetail?.InterestRate ?? "", Align.Right));
        table.Data(Label("Interest Transfer:"), Value(certificateDetail?.InterestTransfer ?? ""));
        table.Data(Label("Interest Calculation:"), Value(certificateDetail?.InterestCalculation ?? ""));

        table.Data(new ReportCell("", Align.Left, 5, "sig-space"));
        table.Data(
            new ReportCell("", Align.Left, 1),
            new ReportCell("Member Signature", Align.Center, 2, "sig"),
            new ReportCell("", Align.Left, 1),
            new ReportCell("Authorized Signature", Align.Center, 1, "sig"));

        table.Spacer();
        table.Data(new ReportCell($"Generated: {generatedOn}", Align.Center, 5, "gen"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())