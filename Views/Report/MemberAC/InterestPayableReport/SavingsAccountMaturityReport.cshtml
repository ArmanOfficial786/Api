@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestPayableReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9.5pt";
    const int ColumnCount = 7;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string N(decimal value) => value.ToString("N2");
    decimal BalanceOf(SavingsAccountMaturityRowDto r) => r.Balance ?? r.DepositAmount ?? 0;

    var rows = (Model["Rows"] as List<SavingsAccountMaturityRowDto>) ?? new List<SavingsAccountMaturityRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var depositTypeGroups = rows.GroupBy(r => r.DepositTypeName ?? "").ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalDepositTypes = (int)TotalOr("TotalDepositTypes", depositTypeGroups.Count);
    var totalDepositAmount = TotalOr("TotalDepositAmount", rows.Sum(BalanceOf));

    var table = new ReportTable(Model, title: "Savings Account Maturity Report", sheetName: "SavingsAccountMaturity")
        .Column("Saving Type", 16)
        .Column("Member Details", 34)
        .Column("Account No", 12)
        .Column("Opened Date", 12)
        .Column("Mat. Date", 12)
        .Column("Rate", 6, Align.Right)
        .Column("Balance", 14, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; border-bottom: 1.5px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { font-size: 10pt; border-top: 0; border-bottom: 0; padding-top: 12px; padding-bottom: 4px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-total td { border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; }\n" +
            "table.sheet-table tr.r-data td.summary-cell { font-weight: bold; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Report Generated On:", generatedOn));

    foreach (var group in depositTypeGroups)
    {
        table.GroupTitle(group.Key);

        foreach (var row in group)
        {
            table.Data(
                ReportCell.Left(""),
                ReportCell.Left($"{row.MemberId ?? ""}\u00A0\u00A0\u00A0{row.MemberName ?? ""}\u00A0\u00A0\u00A0{row.Phone ?? ""}"),
                ReportCell.Left(row.AccountNo ?? ""),
                ReportCell.Left(row.AccountOpenOnBs ?? ""),
                ReportCell.Left(row.MaturityOnBs ?? ""),
                ReportCell.Right(N(row.InterestRate ?? 0)),
                ReportCell.Right(N(BalanceOf(row))));
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", ColumnCount - 1, N(totalDepositAmount));
        table.Data(
            new ReportCell("Total Records", Align.Right, ColumnCount - 1, "summary-cell"),
            new ReportCell(totalRecords.ToString(), Align.Right, 1, "summary-cell"));
        table.Data(
            new ReportCell("Total Deposit Types", Align.Right, ColumnCount - 1, "summary-cell"),
            new ReportCell(totalDepositTypes.ToString(), Align.Right, 1, "summary-cell"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())