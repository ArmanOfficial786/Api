@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestPayableReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<SavingsAccountMaturityRowDto>) ?? new List<SavingsAccountMaturityRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalDepositAmount = Model["TotalDepositAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var totalDepositTypes = Model["TotalDepositTypes"] as int? ?? 0;

    // Group by Deposit Type (Saving Type) — this drives the bold group
    // headers ("Bal Bachat Deposit Type", "DOUBLE DEPOSIT FOR 5YEARS", ...)
    var depositTypeGroups = rows.GroupBy(r => r.DepositTypeName ?? "").ToList();

    Func<decimal, string> N = v => v.ToString("N2");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Savings Account Maturity Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                background: white;
                color: #000;
                padding: 20px;
            }

            .report-container {
                width: 100%;
                max-width: 1200px;
                margin: 0 auto;
            }

            /* -------- Single table for the whole report body -------- */
            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9.5pt;
            }

                .data-table td, .data-table th {
                    border: none;
                    vertical-align: top;
                }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            /* -------- Title row -------- */
            .report-title td {
                text-align: center;
                font-family: 'Times New Roman', Times, serif;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 0 12px 0;
            }

            /* -------- Filter rows (Branch / Generated / From-To) -------- */
            .filter-row td {
                padding: 2px 6px;
                font-size: 9.5pt;
            }

            .filter-row.filter-last td {
                padding-bottom: 6px;
                border-bottom: 1px solid #000;
            }

            .filter-row .label {
                font-weight: bold;
            }

            /* -------- Column header row -------- */
            .column-header-row th {
                text-align: left;
                font-weight: bold;
                font-size: 9.5pt;
                padding: 6px 6px 6px 6px;
                border-bottom: 1.5px solid #000;
                white-space: nowrap;
            }

            /* -------- Group header (deposit / saving type) -------- */
            .group-header-row td {
                font-weight: bold;
                font-size: 10pt;
                padding: 14px 6px 4px 6px;
            }

            .group-header-row.first-group td {
                padding-top: 8px;
            }

            /* -------- Detail rows -------- */
            .detail-row td {
                padding: 3px 6px;
            }

            /* -------- Member Details: MemberId, Name, Phone laid out inline -------- */
            .member-details {
                white-space: nowrap;
            }

                .member-details .detail-id {
                    display: inline-block;
                    min-width: 78px;
                    font-weight: normal;
                }

                .member-details .detail-name {
                    display: inline-block;
                    min-width: 150px;
                }

                .member-details .detail-phone {
                    display: inline-block;
                }

            /* -------- Totals -------- */
            .grand-total-row td {
                border-top: 1.5px solid #000;
                border-bottom: 1.5px solid #000;
                font-weight: bold;
                padding: 5px 6px;
            }

            .summary-row td {
                padding: 3px 6px;
                font-weight: bold;
            }

            @@media print {
                body {
                    padding: 10px;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <colgroup>
                <col style="width:16%;">
                <col style="width:34%;">
                <col style="width:12%;">
                <col style="width:12%;">
                <col style="width:12%;">
                <col style="width:6%;">
                <col style="width:14%;">
            </colgroup>
            <tbody>
                <tr class="report-title">
                    <td colspan="7">Savings Account Maturity Report</td>
                </tr>

                <tr class="filter-row">
                    <td colspan="7"><span class="label">Branch Name :</span> @branchNames</td>
                </tr>
                <tr class="filter-row filter-last">
                    <td colspan="3"><span class="label">Report Generated On:</span> @generatedOn</td>
                    <td colspan="2"><span class="label">From Date :</span> @fromDate</td>
                    <td colspan="2"><span class="label">To Date :</span> @toDate</td>
                </tr>

                <tr class="column-header-row">
                    <th>Saving Type</th>
                    <th>Member Details</th>
                    <th>Account No</th>
                    <th>Opened Date</th>
                    <th>Mat. Date</th>
                    <th class="text-right">Rate</th>
                    <th class="text-right">Balance</th>
                </tr>

                @if (depositTypeGroups.Any())
                {
                    bool isFirstGroup = true;
                    foreach (var group in depositTypeGroups)
                    {
                        <tr class="group-header-row @(isFirstGroup ? "first-group" : "")">
                            <td colspan="7">@group.Key</td>
                        </tr>
                        isFirstGroup = false;

                        foreach (var row in group)
                        {
                            var balance = row.Balance ?? row.DepositAmount ?? 0;
                            var rate = row.InterestRate ?? 0;

                            <tr class="detail-row">
                                <td></td>
                                <td>
                                    <span class="member-details">
                                        <span class="detail-id">@(row.MemberId ?? "")</span>
                                        <span class="detail-name">@(row.MemberName ?? "")</span>
                                        <span class="detail-phone">@(row.Phone ?? "")</span>
                                    </span>
                                </td>
                                <td>@(row.AccountNo ?? "")</td>
                                <td>@(row.AccountOpenOnBs ?? "")</td>
                                <td>@(row.MaturityOnBs ?? "")</td>
                                <td class="text-right">@N(rate)</td>
                                <td class="text-right">@N(balance)</td>
                            </tr>
                        }
                    }

                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Grand Total</td>
                        <td class="text-right">@N(totalDepositAmount)</td>
                    </tr>
                    <tr class="summary-row">
                        <td colspan="6" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                    </tr>
                    <tr class="summary-row">
                        <td colspan="6" class="text-right">Total Deposit Types</td>
                        <td class="text-right">@totalDepositTypes</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center" style="padding: 20px 0; font-size: 10pt; color: #666;">
                            No savings account maturity records found for the selected criteria
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
