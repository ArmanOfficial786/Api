@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.InterestPayableReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 7;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<PayableInterestTransferredRowDto>) ?? new List<PayableInterestTransferredRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var depositTypeGroups = rows
        .GroupBy(r => r.DepositTypeName ?? "")
        .ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalInterest = TotalOr("TotalInterest", rows.Sum(r => r.Interest ?? 0));
    var totalTax = TotalOr("TotalTax", rows.Sum(r => r.Tax ?? 0));

    var table = new ReportTable(Model, title: "Payable Interest Transfer to Account", sheetName: "PayableInterestTransferred")
        .Column("S.N.", 6)
        .Column("Member Id", 13)
        .Column("Name", 20)
        .Column("Account No", 15)
        .Column("Interest Amount", 15, Align.Right)
        .Column("Tax Amount", 14, Align.Right)
        .Column("Date", 17)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { border-top: 1px solid #000; border-bottom: 1px solid #000; padding-top: 5px; padding-bottom: 5px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        3);

    var serialNo = 0;
    foreach (var typeGroup in depositTypeGroups)
    {
        table.GroupBy(
            ReportCell.Left(""),
            ReportCell.Left(typeGroup.Key, 3),
            ReportCell.Right(typeGroup.Sum(r => r.Interest ?? 0).ToString("N2")),
            ReportCell.Right(typeGroup.Sum(r => r.Tax ?? 0).ToString("N2")),
            ReportCell.Left(""));

        foreach (var row in typeGroup)
        {
            table.Data(
                (++serialNo).ToString(),
                row.MemberId ?? "",
                row.MemberName ?? "",
                row.AccountNo ?? "",
                Money(row.Interest),
                Money(row.Tax),
                row.InterestDate ?? "");
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 4, totalInterest.ToString("N2"), totalTax.ToString("N2"), "");
        table.Total("Total Records", 4, totalRecords.ToString(), "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())