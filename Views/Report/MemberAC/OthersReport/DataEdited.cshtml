                font-family: "Times New Roman", Times, serif;
                font-size: 13pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 0 8px 0;
            }

            .meta-bar {
                width: 100%;
                font-size: 8.5pt;
                padding-bottom: 6px;
                border-bottom: 1px solid #000;
                margin-bottom: 4px;
            }

                .meta-bar td {
                    padding: 2px 4px;
                }

