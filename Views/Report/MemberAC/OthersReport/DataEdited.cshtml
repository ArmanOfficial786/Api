        <table class="data-table">
            <colgroup>
                <col style="width:5%">
                <col style="width:13%">
                <col style="width:18%">
                <col style="width:13%">
                <col style="width:22%">
                <col style="width:14%">
                <col style="width:13%">
                <col style="width:13%">
            </colgroup>
            <thead>
                <tr>
                    <th>SN</th>
                    <th>Date</th>
                    <th>Member Id / Name</th>
                    <th>A/C No</th>
                    <th>Description</th>
                    <th class="text-right">Actual Amount</th>
                    <th>Edited Date</th>
                    <th>Edited By</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn = 0;
                    foreach (var row in rows)
