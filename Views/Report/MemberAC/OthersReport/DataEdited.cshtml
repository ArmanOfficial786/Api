@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    string FormatAmount(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "0.00";

    var rows = (Model["Rows"] as List<DataEditedRowDto>) ?? new List<DataEditedRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var entryByName = Text("EntryByName", "All");
    var editedByName = Text("EditedByName", "All");
    var orderBy = Text("OrderBy");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");

    var table = new ReportTable(Model, title: "Data Edited Report", sheetName: "DataEditedReport")
        .Column("Date", 11)
        .Column("Member", 18)
        .Column("A/C No", 11)
        .Column("Description", 20)
        .Column("Amount", 13, Align.Right)
        .Column("Edited Date", 11)
        .Column("Edited By", 8)
        .Column("Entry By", 8)
        .Style(new ReportStyle
        {
            ZebraStripes = true,
            ZebraBackground = "#fafafa",
            HeaderBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 3px 8px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-data td.amt-pos { color: #196f3d; }\n" +
            "table.sheet-table tr.r-data td.amt-neg { color: #b03a2e; }");

    table.MetaRow(
        Fmt.Labeled("Branch :", branchName),
        Fmt.Labeled("Report Generated On :", generatedOn),
        4);
    table.MetaRow(
        Fmt.Labeled("Entry By :", entryByName),
        Fmt.Labeled("Order By :", orderBy),
        4);
    table.MetaRow(
        Fmt.Labeled("Edited By :", editedByName),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        4);

    foreach (var row in rows)
    {
        var member = !string.IsNullOrEmpty(row.MemberId) && !string.IsNullOrEmpty(row.MemberName)
            ? $"{row.MemberId} - {row.MemberName}"
            : !string.IsNullOrEmpty(row.MemberName)
                ? row.MemberName
                : row.MemberId ?? "";

        table.Data(
            ReportCell.Left(row.Date ?? ""),
            ReportCell.Left(member),
            ReportCell.Left(row.AccountNo ?? ""),
            ReportCell.Left(row.Description ?? ""),
            new ReportCell(FormatAmount(row.ActualAmount), Align.Right, 1, row.ActualAmount < 0 ? "amt-neg" : "amt-pos"),
            ReportCell.Left(row.EditedDate ?? ""),
            ReportCell.Left(row.EditedBy ?? ""),
            ReportCell.Left(row.EntryBy ?? ""));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())