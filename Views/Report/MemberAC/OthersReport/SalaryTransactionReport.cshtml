@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    var rows = (Model["Rows"] as List<SalaryTransactionRowDto>) ?? new List<SalaryTransactionRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var orderBy = Text("OrderBy");
    var reportType = Model.TryGetValue("ReportType", out var rt) && rt != null ? Convert.ToInt32(rt) : 0;
    var reportTypeText = reportType == 1 ? "Summary" : "Detail";
    var transferOn = Text("TransferOn", "A");
    var transferOnText = transferOn == "A" ? "All" : transferOn == "S" ? "Saving" : "Bank";
    var staffSelection = Text("StaffSelection", "O");
    var staffSelectionText = staffSelection == "O" ? "Office Wise" : "All Staff";
    var selectedStaffName = Text("SelectedStaffName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");

    var totalRecords = (int)Dec("TotalRecords");
    if (totalRecords == 0) totalRecords = rows.Count;

    var table = new ReportTable(Model, title: $"Salary Transaction Report ({reportTypeText})", sheetName: "SalaryTransaction")
        .Column("SN", 3, Align.Center)
        .Column("Date", 10)
        .Column("Staff Name", 15)
        .Column("Account No", 10)
        .Column("Salary", 7, Align.Right)
        .Column("TDS", 7, Align.Right)
        .Column("Allowance", 7, Align.Right)
        .Column("PFFO", 7, Align.Right)
        .Column("PFFS", 7, Align.Right)
        .Column("OverTime", 7, Align.Right)
        .Column("Net Salary", 7, Align.Right)
        .Column("Transfer", 8)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 3px 5px; border: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td.net-cell { font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.bold-cell { font-weight: bold; border: 0; }\n" +
            "table.sheet-table tr.r-data td.transfer-saving { background: #e8f5e9; color: #2e7d32; font-size: 7pt; font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.transfer-bank { background: #e3f2fd; color: #0d47a1; font-size: 7pt; font-weight: bold; }\n" +
            "table.sheet-table tr.r-total td { border-top: 2px solid #000; border-bottom: 2px solid #000; }");

    table.MetaRow(Fmt.Join(
        Fmt.Labeled("Branches:", branchNames),
        Fmt.Labeled("From:", fromDate),
        Fmt.Labeled("To:", toDate),
        Fmt.Labeled("Order By:", orderBy),
        Fmt.Labeled("Transfer On:", transferOnText),
        Fmt.Labeled("Staff:", staffSelectionText),
        Fmt.Labeled("Generated:", generatedOn)));

    if (!string.IsNullOrEmpty(selectedStaffName))
    {
        table.MetaRow(Fmt.Labeled("Selected Staff:", selectedStaffName));
    }

    var sn = 0;
    foreach (var row in rows)
    {
        var transferCss = row.TransferOn == "S" ? "transfer-saving" : "transfer-bank";
        var transferText = string.IsNullOrEmpty(row.TransferOn) ? "" : row.TransferOn == "S" ? "Saving" : "Bank";

        table.Data(
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left(row.Date ?? ""),
            ReportCell.Left(row.StaffName ?? ""),
            ReportCell.Left(row.AccountNo ?? ""),
            ReportCell.Right(Fmt.Amount(row.SalaryAmount)),
            ReportCell.Right(Fmt.Amount(row.TdsAmount)),
            ReportCell.Right(Fmt.Amount(row.AllowanceAmount)),
            ReportCell.Right(Fmt.Amount(row.PFFO)),
            ReportCell.Right(Fmt.Amount(row.PFFS)),
            ReportCell.Right(Fmt.Amount(row.OverTimeSalaryAmount)),
            new ReportCell(Fmt.Amount(row.NetSalary), Align.Right, 1, "net-cell"),
            new ReportCell(transferText, Align.Left, 1, transferText.Length > 0 ? transferCss : null));
    }

    if (rows.Count > 0)
    {
        table.Total("Total", 4,
            Dec("TotalSalaryAmount").ToString("N2"),
            Dec("TotalTdsAmount").ToString("N2"),
            Dec("TotalAllowanceAmount").ToString("N2"),
            Dec("TotalPFFO").ToString("N2"),
            Dec("TotalPFFS").ToString("N2"),
            Dec("TotalOverTimeSalary").ToString("N2"),
            Dec("TotalNetSalary").ToString("N2"),
            "");

        table.Data(
            new ReportCell("Total Records", Align.Right, 3, "bold-cell"),
            new ReportCell(totalRecords.ToString(), Align.Left, 9, "bold-cell"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())