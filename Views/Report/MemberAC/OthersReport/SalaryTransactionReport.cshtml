@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<SalaryTransactionRowDto>) ?? new List<SalaryTransactionRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalSalaryAmount = Model["TotalSalaryAmount"] as decimal? ?? 0;
    var totalTdsAmount = Model["TotalTdsAmount"] as decimal? ?? 0;
    var totalAllowanceAmount = Model["TotalAllowanceAmount"] as decimal? ?? 0;
    var totalPFFO = Model["TotalPFFO"] as decimal? ?? 0;
    var totalPFFS = Model["TotalPFFS"] as decimal? ?? 0;
    var totalOverTimeSalary = Model["TotalOverTimeSalary"] as decimal? ?? 0;
    var totalLeaveDeduction = Model["TotalLeaveDeduction"] as decimal? ?? 0;
    var totalAdvanceDeduction = Model["TotalAdvanceDeduction"] as decimal? ?? 0;
    var totalNetSalary = Model["TotalNetSalary"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var reportType = Model["ReportType"] as int? ?? 0;
    var reportTypeText = reportType == 1 ? "Summary" : "Detail";
    var transferOn = Model["TransferOn"]?.ToString() ?? "A";
    var transferOnText = transferOn == "A" ? "All" : transferOn == "S" ? "Saving" : "Bank";
    var staffSelection = Model["StaffSelection"]?.ToString() ?? "O";
    var staffSelectionText = staffSelection == "O" ? "Office Wise" : "All Staff";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    var selectedStaffName = Model["SelectedStaffName"]?.ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Salary Transaction Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8pt;
            }

                .data-table td, .data-table th {
                    padding: 3px 5px;
                    border: 1px solid #ccc;
                }

                .data-table th {
                    background: #f2f2f2;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                .data-table thead {
                    display: table-row-group;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .filter-info {
                margin-bottom: 4px;
            }

            .report-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
            }

            .negative-amount {
                color: red;
            }

            .positive-amount {
                color: green;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }

            .transfer-badge {
                display: inline-block;
                padding: 1px 6px;
                border-radius: 3px;
                font-size: 7pt;
                font-weight: bold;
            }

            .transfer-saving {
                background: #e8f5e9;
                color: #2e7d32;
            }

            .transfer-bank {
                background: #e3f2fd;
                color: #0d47a1;
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th colspan="12" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">
                        Salary Transaction Report (@reportTypeText)
                    </th>
                </tr>
                <tr>
                    <td colspan="12">
                        <div class="filter-info">
                            <strong>Branches:</strong> @branchNames &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>From:</strong> @fromDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>To:</strong> @toDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Order By:</strong> @orderBy &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Transfer On:</strong> @transferOnText &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Staff:</strong> @staffSelectionText &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Generated:</strong> @generatedOn
                        </div>
                        @if (!string.IsNullOrEmpty(selectedStaffName))
                        {
                            <div class="filter-info">
                                <strong>Selected Staff:</strong> @selectedStaffName
                            </div>
                        }
                    </td>
                </tr>
                <tr>
                    <th style="width:3%;">SN</th>
                    <th style="width:10%;">Date</th>
                    <th style="width:15%;">Staff Name</th>
                    <th style="width:10%;">Account No</th>
                    <th style="width:7%;" class="text-right">Salary</th>
                    <th style="width:7%;" class="text-right">TDS</th>
                    <th style="width:7%;" class="text-right">Allowance</th>
                    <th style="width:7%;" class="text-right">PFFO</th>
                    <th style="width:7%;" class="text-right">PFFS</th>
                    <th style="width:7%;" class="text-right">OverTime</th>
                    <th style="width:7%;" class="text-right">Net Salary</th>
                    <th style="width:8%;">Transfer</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        var transferClass = row.TransferOn == "S" ? "transfer-saving" : "transfer-bank";
                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@(row.Date ?? "")</td>
                            <td>@(row.StaffName ?? "")</td>
                            <td>@(row.AccountNo ?? "")</td>
                            <td class="text-right">@(row.SalaryAmount.HasValue ? row.SalaryAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.TdsAmount.HasValue ? row.TdsAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.AllowanceAmount.HasValue ? row.AllowanceAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.PFFO.HasValue ? row.PFFO.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.PFFS.HasValue ? row.PFFS.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.OverTimeSalaryAmount.HasValue ? row.OverTimeSalaryAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right"><strong>@(row.NetSalary.HasValue ? row.NetSalary.Value.ToString("N2") : "")</strong></td>
                            <td>
                                @if (!string.IsNullOrEmpty(row.TransferOn))
                                {
                                    <span class="transfer-badge @transferClass">@(row.TransferOn == "S" ? "Saving" : "Bank")</span>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="4" class="text-right"><strong>Total</strong></td>
                        <td class="text-right"><strong>@totalSalaryAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalTdsAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalAllowanceAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalPFFO.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalPFFS.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalOverTimeSalary.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalNetSalary.ToString("N2")</strong></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-right"><strong>Total Records</strong></td>
                        <td colspan="9" class="text-left"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="12" class="text-center">No salary transactions found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>