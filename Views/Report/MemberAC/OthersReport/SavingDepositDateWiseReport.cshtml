@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";

    var rows = (Model["Rows"] as IEnumerable<SavingDepositDateWiseRowDto>)?.ToList() ?? new List<SavingDepositDateWiseRowDto>();
    var branchNames = Text("BranchNames");
    if (branchNames == "") branchNames = "All Branches";
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    if (fromDate == "-1") fromDate = "";
    if (toDate == "-1") toDate = "";
    var transactionType = Text("TransactionType");
    if (transactionType == "") transactionType = "Deposit";
    var generatedOn = Text("ReportGeneratedOnBs");
    if (generatedOn == "") generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: $"Date Wise {transactionType} Report", sheetName: "SavingDepositDateWise")
        .Column("Date", 10)
        .Column("Saving Type", 14)
        .Column("S.N.", 5, Align.Center)
        .Column("Member Id", 11)
        .Column("Name", 18)
        .Column("Bill No.", 9)
        .Column("Account No", 19)
        .Column("Amount", 14, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaPair("Branch Name :", branchNames, "Report Generated On :", generatedOn);
    if (fromDate != "" || toDate != "") table.MetaPair("From Date :", fromDate, "To Date :", toDate);

    foreach (var dateGroup in rows.GroupBy(r => r.Date))
    {
        var dateText = dateGroup.Key?.ToString() ?? "";
        table.GroupTitle(dateText);

        decimal dateTotal = 0;
        var dateRecords = 0;

        foreach (var stGroup in dateGroup.GroupBy(r => r.SavingType))
        {
            table.GroupBy(
                ReportCell.Left(""),
                ReportCell.Left(stGroup.Key ?? "", 7));

            decimal stTotal = 0;
            var sn = 0;

            foreach (var row in stGroup)
            {
                sn++;
                dateRecords++;
                stTotal += row.Amount ?? 0;
                dateTotal += row.Amount ?? 0;

                table.Data(new[]
                {
                    ReportCell.Left(""),
                    ReportCell.Left(""),
                    ReportCell.Center(sn.ToString()),
                    ReportCell.Left(row.MemberId ?? ""),
                    ReportCell.Left(row.MemberName ?? ""),
                    ReportCell.Left(""),
                    ReportCell.Left(row.AccountNo ?? ""),
                    ReportCell.Right(Fmt.Amount(row.Amount))
                });
            }

            table.SubTotal(stGroup.Key ?? "", 7, Fmt.Amount(stTotal));
        }

        table.SubTotal($"{dateText}  —  Total Records: {dateRecords}", 7, Fmt.Amount(dateTotal));
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 7, Fmt.Amount(rows.Sum(r => r.Amount ?? 0)));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())