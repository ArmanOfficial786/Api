@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<SavingDepositDateWiseRowDto>) ?? new List<SavingDepositDateWiseRowDto>();
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var transactionType = Model["TransactionType"]?.ToString() ?? "Deposit"; // "Deposit" or "Withdrawl"
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";

    var generatedOn = Model.ContainsKey("ReportGeneratedOnBs") && Model["ReportGeneratedOnBs"] != null
        ? Model["ReportGeneratedOnBs"].ToString()
        : DateTime.Now.ToString("yyyy/MM/dd");

    // Rows must arrive pre-sorted Date -> SavingType (repository enforces this for
    // ReportMode == "DateWise" - GroupBy preserves first-seen order, it does not sort)
    var dateGroups = rows.GroupBy(r => r.Date).ToList();

    var reportTitle = $"Date Wise {transactionType} Report";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@reportTitle</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9.5pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .report-title {
                text-align: center;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 10px 0 12px 0;
            }

            .meta-table {
                width: 100%;
                margin-bottom: 6px;
                font-size: 9.5pt;
            }

                .meta-table td {
                    padding: 1px 4px;
                }

                .meta-table .label {
                    font-weight: bold;
                    white-space: nowrap;
                }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9.5pt;
            }

                .data-table td, .data-table th {
                    padding: 3px 6px;
                    border: none;
                }

                .data-table thead th {
                    text-align: left;
                    font-weight: bold;
                    border-top: 2px solid #000;
                    border-bottom: 1.5px solid #000;
                    padding: 5px 6px;
                }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            /* Date group header row */
            .date-row td {
                font-weight: bold;
                padding-top: 10px;
            }

            /* Saving type sub-header under a date */
            .savingtype-header td {
                font-weight: bold;
                padding-top: 4px;
                padding-bottom: 1px;
            }

            /* Individual numbered transaction rows */
            .txn-row td {
                padding-top: 1px;
                padding-bottom: 1px;
            }

            /* Saving type subtotal under its group */
            .savingtype-total td {
                font-weight: bold;
                border-top: 1px solid #000;
                padding-top: 3px;
                padding-bottom: 3px;
            }

            /* Per-date "Total Records" summary footer */
            .date-total td {
                font-weight: bold;
                border-top: 1px solid #000;
                border-bottom: 1px solid #000;
                padding-top: 4px;
                padding-bottom: 8px;
            }

            .grand-total td {
                font-weight: bold;
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                padding-top: 6px;
                padding-bottom: 6px;
            }

            @@media print {
                .data-table thead {
                    display: table-header-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">@reportTitle</div>

        <table class="meta-table">
            <tr>
                <td class="label" style="width:15%;">Report Generated On :</td>
                <td style="width:25%;">@generatedOn</td>
                <td class="label" style="width:12%;">From Date :</td>
                <td style="width:18%;">@(fromDate != "-1" ? fromDate : "")</td>
                <td class="label" style="width:12%;">To Date :</td>
                <td style="width:18%;">@(toDate != "-1" ? toDate : "")</td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td class="label">Branch Name :</td>
                <td colspan="3">@branchNames</td>
            </tr>
        </table>

        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:11%;">Date</th>
                    <th style="width:16%;">Saving Type</th>
                    <th style="width:12%;">Member Id</th>
                    <th style="width:18%;">Name</th>
                    <th style="width:10%;">Bill No.</th>
                    <th style="width:20%;">Account No</th>
                    <th style="width:13%;" class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (dateGroups.Any())
                {
                    foreach (var dateGroup in dateGroups)
                    {
                        <tr class="date-row">
                            <td colspan="7">@dateGroup.Key</td>
                        </tr>

                        var savingTypeGroups = dateGroup.GroupBy(r => r.SavingType);
                        decimal dateTotal = 0;
                        int dateRecordCount = 0;

                        foreach (var stGroup in savingTypeGroups)
                        {
                            <tr class="savingtype-header">
                                <td></td>
                                <td colspan="6">@stGroup.Key</td>
                            </tr>

                            decimal stTotal = 0;
                            int sn = 0;
                            foreach (var row in stGroup)
                            {
                                sn++;
                                dateRecordCount++;
                                stTotal += row.Amount ?? 0;
                                dateTotal += row.Amount ?? 0;

                                <tr class="txn-row">
                                    <td></td>
                                    <td></td>
                                    <td>@sn</td>
                                    <td>@row.MemberId</td>
                                    <td>@row.MemberName</td>
                                    @* Bill No. has no source field on SavingDepositDateWiseRowDto - left blank *@
                                    <td></td>
                                    <td>@row.AccountNo</td>
                                </tr>
                                <tr class="txn-row" style="display:none;"></tr>
                            }

                            <tr class="savingtype-total">
                                <td></td>
                                <td colspan="4"></td>
                                <td class="text-right">@stGroup.Key</td>
                                <td class="text-right">@stTotal.ToString("N2")</td>
                            </tr>
                        }

                        <tr class="date-total">
                            <td colspan="2" class="text-right">Total Records: @dateRecordCount</td>
                            <td colspan="3" class="text-center">@dateGroup.Key</td>
                            <td></td>
                            <td class="text-right">@dateTotal.ToString("N2")</td>
                        </tr>
                    }

                    <tr class="grand-total">
                        <td colspan="6" class="text-right">Grand Total</td>
                        <td class="text-right">@rows.Sum(r => r.Amount ?? 0).ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="7" class="text-center">No @transactionType.ToLower() transactions found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>