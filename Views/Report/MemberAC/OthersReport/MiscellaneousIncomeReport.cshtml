@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 5;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    var rows = (Model["Rows"] as List<MiscellaneousIncomeRowDto>) ?? new List<MiscellaneousIncomeRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var reportType = Text("ReportType");
    if (string.IsNullOrEmpty(reportType)) reportType = "Miscellaneous";
    var selectedMemberId = Text("SelectedMemberId");
    var selectedMemberName = Text("SelectedMemberName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalAmount = Dec("TotalAmount");
    var totalRecords = (int)Dec("TotalRecords");
    if (totalRecords == 0) totalRecords = rows.Count;

    var particularsGroups = rows
        .GroupBy(r => r.Particulars ?? "")
        .ToList();

    var table = new ReportTable(Model, title: $"{reportType} Income Report", sheetName: "MiscellaneousIncome")
        .Column("Particulars", 16)
        .Column("Member Details", 20)
        .Column("Details", 29)
        .Column("Date", 15)
        .Column("Amount", 20, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9",
            SubTotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-group td.part-hdr { padding-top: 8px; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; border-bottom: 0; padding-top: 5px; padding-bottom: 5px; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        2);

    if (!string.IsNullOrEmpty(selectedMemberId))
    {
        table.MetaRow(Fmt.Join(
            Fmt.Labeled("Member Id :", selectedMemberId),
            Fmt.Labeled("Member Name :", selectedMemberName)));
    }

    foreach (var particularsGroup in particularsGroups)
    {
        table.GroupBy(
            new ReportCell(particularsGroup.Key, Align.Left, 1, "part-hdr"),
            new ReportCell("", Align.Left, ColumnCount - 1, "part-hdr"));

        foreach (var memberGroup in particularsGroup.GroupBy(r => new { r.MemberId, r.MemberName }))
        {
            table.GroupBy(
                ReportCell.Left(""),
                ReportCell.Left($"{memberGroup.Key.MemberId}   {memberGroup.Key.MemberName}", ColumnCount - 1));

            foreach (var row in memberGroup)
            {
                table.Data(
                    ReportCell.Left(""),
                    ReportCell.Left(""),
                    ReportCell.Left(row.Details ?? ""),
                    ReportCell.Left(row.Date ?? ""),
                    ReportCell.Right(Fmt.Amount(row.Amount)));
            }
        }

        table.SubTotal(particularsGroup.Key, ColumnCount - 1, particularsGroup.Sum(r => r.Amount ?? 0).ToString("N2"));
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", ColumnCount - 1, totalAmount.ToString("N2"));
        table.Total("Total Records", ColumnCount - 1, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())