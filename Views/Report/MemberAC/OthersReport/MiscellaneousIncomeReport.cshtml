@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<MiscellaneousIncomeRowDto>) ?? new List<MiscellaneousIncomeRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var reportType = Model["ReportType"]?.ToString() ?? "Miscellaneous";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var selectedMemberId = Model.ContainsKey("SelectedMemberId") ? Model["SelectedMemberId"]?.ToString() : null;
    var selectedMemberName = Model.ContainsKey("SelectedMemberName") ? Model["SelectedMemberName"]?.ToString() : null;

    // Group exactly like the original DevExpress report: Particulars (level 1) -> Member (level 2) -> transaction rows.
    // No re-ordering here — groups/rows print in the order the repository already returned (driven by OrderBy).
    var particularsGroups = rows
        .GroupBy(r => r.Particulars ?? "")
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@reportType Income Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .particulars-row td {
                font-weight: bold;
                padding-top: 8px;
            }

            .member-row td {
                font-weight: bold;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 5px;
                padding-bottom: 5px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="MiscellaneousIncome">
            <colgroup>
                <col style="width:16%;" />
                <col style="width:20%;" />
                <col style="width:29%;" />
                <col style="width:15%;" />
                <col style="width:20%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="5">@reportType Income Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="5"><strong>Branch Name :</strong> @branchNames</td>
                </tr>
                <tr class="meta-spacer"><td colspan="5"></td></tr>

                <tr class="meta-row">
                    <td colspan="2"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="3" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                @if (!string.IsNullOrEmpty(selectedMemberId))
                {
                    <tr class="meta-row">
                        <td colspan="5">
                            <strong>Member Id :</strong> @selectedMemberId
                            &nbsp;&nbsp;&nbsp;
                            <strong>Member Name :</strong> @selectedMemberName
                        </td>
                    </tr>
                }
                <tr class="meta-spacer"><td colspan="5"></td></tr>

                <tr>
                    <th>Particulars</th>
                    <th>Member Details</th>
                    <th>Details</th>
                    <th>Date</th>
                    <th class="text-right">Amount</th>
                </tr>

                @if (particularsGroups.Any())
                {
                    foreach (var particularsGroup in particularsGroups)
                    {
                        <tr class="particulars-row">
                            <td>@particularsGroup.Key</td>
                            <td colspan="4"></td>
                        </tr>

                        var memberGroups = particularsGroup.GroupBy(r => new { r.MemberId, r.MemberName }).ToList();

                        foreach (var memberGroup in memberGroups)
                        {
                            <tr class="member-row">
                                <td></td>
                                <td colspan="4">@(memberGroup.Key.MemberId ?? "") &nbsp;&nbsp; @(memberGroup.Key.MemberName ?? "")</td>
                            </tr>

                            foreach (var row in memberGroup)
                            {
                                <tr class="detail-row">
                                    <td></td>
                                    <td></td>
                                    <td>@(row.Details ?? "")</td>
                                    <td>@(row.Date ?? "")</td>
                                    <td class="text-right">@(row.Amount.HasValue ? row.Amount.Value.ToString("N2") : "")</td>
                                </tr>
                            }
                        }

                        <tr class="subtotal-row">
                            <td colspan="4" class="text-right">@particularsGroup.Key</td>
                            <td class="text-right">@particularsGroup.Sum(r => r.Amount ?? 0).ToString("N2")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Grand Total</td>
                        <td class="text-right">@totalAmount.ToString("N2")</td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No @reportType.ToLower() income found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
