@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";
    var metaFontSize = "8pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";

    var rows = (Model["Rows"] as IEnumerable<SavingInterestChangeLogRowDto>)?.ToList() ?? new List<SavingInterestChangeLogRowDto>();
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var reportType = Text("ReportType");
    if (reportType == "") reportType = "1";
    var accountNo = Text("AccountNo");
    var depositTypeName = Text("DepositTypeName");
    var officeName = Text("OfficeName");
    if (officeName == "") officeName = "All";
    var generatedOn = Text("GeneratedOn");
    if (generatedOn == "") generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;
    var totalChanges = Model.TryGetValue("TotalChanges", out var tc) && tc != null && Convert.ToInt32(tc) > 0
        ? Convert.ToInt32(tc)
        : rows.Count;

    var remarks = "Saving A/C Interest changed different from Deposit Type.";

    var table = new ReportTable(Model,
        title: "Saving Interest Log Report By " + (reportType == "1" ? "Account No" : "Deposit Type"),
        sheetName: "SavingInterestChangeLog")
        .Column("SN", 4, Align.Center)
        .Column("Member Detail", 18)
        .Column("Account No", 12)
        .Column("Previous Rate", 8, Align.Center)
        .Column("Current Rate", 8, Align.Center)
        .Column("Activated Date", 10, Align.Center)
        .Column("Remarks", 20)
        .Column("Created Date", 10, Align.Center)
        .Column("Created By", 10)
        .Sizing(rowMm: 6, headerMm: 9, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-data td.rate-old  { color: #c62828; }
            table.sheet-table tr.r-data td.rate-new  { color: #2e7d32; }
            table.sheet-table tr.r-data td.highlight { color: #1565c0; font-weight: bold; }
            table.sheet-table tr.r-data td.remarks   { color: #555; }");

    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        leftSpan: 4);

    if (reportType == "1" && !string.IsNullOrEmpty(accountNo))
        table.MetaRow(Fmt.Labeled("Account No :", accountNo));
    else if (reportType == "2" && !string.IsNullOrEmpty(depositTypeName))
        table.MetaRow(Fmt.Labeled("Deposit Type :", depositTypeName));

    var sn = 0;
    foreach (var row in rows)
    {
        var oldRate = row.PreviousInterestRate.HasValue ? row.PreviousInterestRate.Value.ToString("N2") : "-";
        var newRate = row.CurrentInterestRate.HasValue ? row.CurrentInterestRate.Value.ToString("N2") : "-";
        var activated = row.InterestActivationOnbs ?? "";

        table.Data(new[]
        {
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left($"{row.MemberId} ({row.MemberName})"),
            ReportCell.Left(row.AccountNo ?? ""),
            new ReportCell(oldRate, Align.Center, 1, "rate-old"),
            new ReportCell(newRate, Align.Center, 1, "rate-new"),
            new ReportCell(activated, Align.Center, 1, "highlight"),
            new ReportCell(remarks, Align.Left, 1, "remarks"),
            ReportCell.Center(activated),
            ReportCell.Left(row.CreatedBy ?? "CoSys Software")
        });
    }

    if (rows.Count > 0)
    {
        table.Total("Total Changes", 8, totalChanges.ToString());
        table.Total("Total Records", 8, totalRecords.ToString());
        table.Data(ReportCell.Right("Office Name : " + officeName, 9));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())