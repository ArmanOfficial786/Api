@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string Dash(string? value) => string.IsNullOrEmpty(value) ? "-" : value;

    var rows = (Model["Rows"] as List<ChequeClearanceRowDto>) ?? new List<ChequeClearanceRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalAmount = Dec("TotalAmount");
    var totalRecords = (int)Dec("TotalRecords");
    if (totalRecords == 0) totalRecords = rows.Count;

    var table = new ReportTable(Model, title: "Cheque Report", sheetName: "ChequeReport")
        .Column("MemberId", 10)
        .Column("Member Name", 14)
        .Column("Cheque No", 10)
        .Column("Amount", 11, Align.Right)
        .Column("Receive Bs", 11)
        .Column("Send Bs", 11)
        .Column("Clearance Bs", 11)
        .Column("Rejected Bs", 11)
        .Column("Deleted Bs", 11)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1.5px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }");

    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        3);

    foreach (var row in rows)
    {
        table.Data(
            row.MemberId ?? "",
            row.MemberName ?? "",
            Fmt.Int(row.ChequeNo),
            Fmt.Amount(row.Amount),
            Dash(row.ReceiveDateBs),
            Dash(row.SendDateBs),
            Dash(row.ClearanceDateBs),
            Dash(row.RejectedDateBs),
            Dash(row.DeletedDateBs));
    }

    if (rows.Count > 0)
    {
        table.Total("Total Amount", 3, totalAmount.ToString("N2"), "", "", "", "", "");
        table.Total("Total Records", 3, totalRecords.ToString(), "", "", "", "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())