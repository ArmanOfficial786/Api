@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";

    var rows = (Model["Rows"] as IEnumerable<SavingDepositMemberWiseRowDto>)?.ToList() ?? new List<SavingDepositMemberWiseRowDto>();
    var branchNames = Text("BranchNames");
    if (branchNames == "") branchNames = "All Branches";
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    if (fromDate == "-1") fromDate = "";
    if (toDate == "-1") toDate = "";
    var transactionType = Text("TransactionType");
    if (transactionType == "") transactionType = "Deposit";
    var generatedOn = Text("ReportGeneratedOnBs");
    if (generatedOn == "") generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var grandTotal = rows.Sum(r => r.Amount ?? 0);

    var table = new ReportTable(Model, title: $"Member Wise {transactionType} Report", sheetName: "SavingDepositMemberWise")
        .Column("S.N.", 4, Align.Center)
        .Column("Member Id", 12)
        .Column("Name", 18)
        .Column("Saving Type", 20)
        .Column("Account No", 22)
        .Column("Amount", 12, Align.Right)
        .Column("Date", 12)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaPair("Branch Name :", branchNames, "Report Generated On :", generatedOn);
    if (fromDate != "" || toDate != "") table.MetaPair("From Date :", fromDate, "To Date :", toDate);

    var sn = 0;
    foreach (var memberGroup in rows.GroupBy(r => new { r.MemberId, r.MemberName }))
    {
        table.GroupBy(
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left(memberGroup.Key.MemberId ?? ""),
            ReportCell.Left(memberGroup.Key.MemberName ?? ""),
            ReportCell.Left("", 4));

        foreach (var stGroup in memberGroup.GroupBy(r => r.SavingType))
        {
            table.GroupBy(
                ReportCell.Left("", 3),
                ReportCell.Left(stGroup.Key ?? "", 4));

            decimal stTotal = 0;
            foreach (var row in stGroup)
            {
                stTotal += row.Amount ?? 0;
                table.Data(new[]
                {
                    ReportCell.Left(""),
                    ReportCell.Left(""),
                    ReportCell.Left(""),
                    ReportCell.Left(""),
                    ReportCell.Left(row.AccountNo ?? ""),
                    ReportCell.Right(Fmt.Amount(row.Amount)),
                    ReportCell.Left(Convert.ToString(row.Date) ?? "")
                });
            }

            table.SubTotal(stGroup.Key ?? "", 5, Fmt.Amount(stTotal), "");
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 5, Fmt.Amount(grandTotal), "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())