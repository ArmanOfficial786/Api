@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<SavingDepositMemberWiseRowDto>) ?? new List<SavingDepositMemberWiseRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var transactionType = Model["TransactionType"]?.ToString() ?? "Deposit";
    var reportMode = Model["ReportMode"]?.ToString() ?? "DateWise";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    var selectedMemberId = Model["SelectedMemberId"]?.ToString();
    var selectedMemberName = Model["SelectedMemberName"]?.ToString();
    var savingTypeName = Model["SavingTypeName"]?.ToString();
    var totalDepositAmount = Model["TotalDepositAmount"] as decimal? ?? 0;
    var totalWithdrawalAmount = Model["TotalWithdrawalAmount"] as decimal? ?? 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Saving Deposit/Withdrawal Member Wise Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: 1px solid #ccc;
                }

                .data-table th {
                    background: #f2f2f2;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                .data-table thead {
                    display: table-row-group;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .filter-info {
                margin-bottom: 4px;
            }

            .report-title {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
            }

            .sub-title {
                text-align: center;
                font-size: 11pt;
                font-weight: bold;
            }

            .highlight-deposit {
                color: green;
            }

            .highlight-withdrawal {
                color: red;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th colspan="7" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">
                        Saving @transactionType Report - @reportMode Wise
                    </th>
                </tr>
                <tr>
                    <td colspan="7">
                        <div class="filter-info">
                            <strong>Branches:</strong> @branchNames &nbsp;&nbsp;|&nbsp;&nbsp;
                            @if (!string.IsNullOrEmpty(fromDate) && fromDate != "-1")
                            {
                                <span><strong>From:</strong> @fromDate &nbsp;&nbsp;|&nbsp;&nbsp;</span>
                            }
                            @if (!string.IsNullOrEmpty(toDate) && toDate != "-1")
                            {
                                <span><strong>To:</strong> @toDate &nbsp;&nbsp;|&nbsp;&nbsp;</span>
                            }
                            <strong>Order By:</strong> @orderBy &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Transaction Type:</strong> @transactionType &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Generated:</strong> @generatedOn
                        </div>
                        @if (!string.IsNullOrEmpty(selectedMemberId))
                        {
                            <div class="filter-info">
                                <strong>Member ID:</strong> @selectedMemberId &nbsp;&nbsp;|&nbsp;&nbsp;
                                <strong>Member Name:</strong> @selectedMemberName
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(savingTypeName))
                        {
                            <div class="filter-info">
                                <strong>Saving Type:</strong> @savingTypeName
                            </div>
                        }
                    </td>
                </tr>
                <tr>
                    <th style="width:3%;">SN</th>
                    <th style="width:12%;">Date</th>
                    <th style="width:12%;">Member Id</th>
                    <th style="width:18%;">Member Name</th>
                    <th style="width:15%;">Account No</th>
                    <th style="width:15%;">Saving Type</th>
                    <th style="width:13%;" class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        var isDeposit = row.TransactionType == "Deposit";
                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@(row.Date ?? "")</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            <td>@(row.AccountNo ?? "")</td>
                            <td>@(row.SavingType ?? "")</td>
                            <td class="text-right @(isDeposit ? "highlight-deposit" : "highlight-withdrawal")">
                                @(row.Amount.HasValue ? row.Amount.Value.ToString("N2") : "")
                            </td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="6" class="text-right"><strong>Total</strong></td>
                        <td class="text-right"><strong>@totalAmount.ToString("N2")</strong></td>
                    </tr>
                    @if (totalDepositAmount > 0 && totalWithdrawalAmount > 0)
                    {
                        <tr>
                            <td colspan="5" class="text-right"><strong>Total Deposit</strong></td>
                            <td class="text-right highlight-deposit"><strong>@totalDepositAmount.ToString("N2")</strong></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-right"><strong>Total Withdrawal</strong></td>
                            <td class="text-right highlight-withdrawal"><strong>@totalWithdrawalAmount.ToString("N2")</strong></td>
                            <td></td>
                        </tr>
                    }
                    <tr>
                        <td colspan="5" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-right"><strong>@totalRecords</strong></td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="7" class="text-center">No @transactionType.ToLower() transactions found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>