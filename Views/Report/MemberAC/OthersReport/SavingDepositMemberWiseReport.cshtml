@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<SavingDepositMemberWiseRowDto>) ?? new List<SavingDepositMemberWiseRowDto>();
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var reportMode = Model["ReportMode"]?.ToString() ?? "MemberWise";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";

    // Prefer a BS-converted "GeneratedOn" if the controller supplies one, else fall back to now.
    var generatedOn = Model.ContainsKey("ReportGeneratedOnBs") && Model["ReportGeneratedOnBs"] != null
        ? Model["ReportGeneratedOnBs"].ToString()
        : DateTime.Now.ToString("yyyy/MM/dd");

    // Group strictly in the order rows arrived (repository must pre-sort by MemberId -> SavingType -> Date)
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.MemberName })
        .ToList();

    decimal grandTotal = rows.Sum(r => r.Amount ?? 0);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Member Wise Deposit Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9.5pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .report-title {
                text-align: center;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 10px 0 12px 0;
            }

            .meta-table {
                width: 100%;
                margin-bottom: 6px;
                font-size: 9.5pt;
            }

                .meta-table td {
                    padding: 1px 4px;
                }

                .meta-table .label {
                    font-weight: bold;
                    white-space: nowrap;
                }

            /* Main ledger table - NO grid borders, only rule lines where needed */
            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9.5pt;
            }

                .data-table td, .data-table th {
                    padding: 3px 6px;
                    border: none;
                }

                .data-table thead th {
                    text-align: left;
                    font-weight: bold;
                    border-top: 2px solid #000;
                    border-bottom: 1.5px solid #000;
                    padding: 5px 6px;
                }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            /* Member header row: SN | MemberId | Name */
            .member-row td {
                font-weight: bold;
                padding-top: 10px;
            }

            /* Saving type group header (e.g. "1 Year Normal Saving") */
            .savingtype-header td {
                font-weight: bold;
                padding-top: 6px;
                padding-bottom: 2px;
            }

            /* Individual transaction rows */
            .txn-row td {
                padding-top: 1px;
                padding-bottom: 1px;
            }

            /* Saving type subtotal row */
            .savingtype-total td {
                font-weight: bold;
                border-top: 1px solid #000;
                padding-top: 3px;
                padding-bottom: 6px;
            }

            .grand-total td {
                font-weight: bold;
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                padding-top: 6px;
                padding-bottom: 6px;
            }

            @@media print {
                .data-table thead {
                    display: table-header-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">Member Wise Deposit Report</div>

        <table class="meta-table">
            <tr>
                <td class="label" style="width:15%;">Branch Name :</td>
                <td style="width:35%;">@branchNames</td>
                <td class="label" style="width:15%;">Report Generated On:</td>
                <td style="width:35%;">@generatedOn</td>
            </tr>
            @if (!string.IsNullOrEmpty(fromDate) && fromDate != "-1" && !string.IsNullOrEmpty(toDate) && toDate != "-1")
            {
                <tr>
                    <td></td>
                    <td></td>
                    <td class="label">From Date :</td>
                    <td>@fromDate</td>
                </tr>
                <tr>
                    <td></td>
                    <td></td>
                    <td class="label">To Date :</td>
                    <td>@toDate</td>
                </tr>
            }
        </table>

        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:4%;"></th>
                    <th style="width:12%;">Member Id</th>
                    <th style="width:18%;">Name</th>
                    <th style="width:20%;">Saving Type</th>
                    <th style="width:22%;">Account No</th>
                    <th style="width:12%;" class="text-right">Amount</th>
                    <th style="width:12%;">Date</th>
                </tr>
            </thead>
            <tbody>
                @if (memberGroups.Any())
                {
                    int sn = 0;
                    foreach (var memberGroup in memberGroups)
                    {
                        sn++;

                        <tr class="member-row">
                            <td>@sn</td>
                            <td>@memberGroup.Key.MemberId</td>
                            <td>@memberGroup.Key.MemberName</td>
                            <td colspan="4"></td>
                        </tr>

                        var savingTypeGroups = memberGroup.GroupBy(r => r.SavingType);

                        foreach (var stGroup in savingTypeGroups)
                        {
                            <tr class="savingtype-header">
                                <td></td>
                                <td></td>
                                <td></td>
                                <td colspan="4">@stGroup.Key</td>
                            </tr>

                            decimal stTotal = 0;
                            foreach (var row in stGroup)
                            {
                                stTotal += row.Amount ?? 0;
                                <tr class="txn-row">
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td>@row.AccountNo</td>
                                    <td class="text-right">@(row.Amount.HasValue ? row.Amount.Value.ToString("N2") : "")</td>
                                    <td>@row.Date</td>
                                </tr>
                            }

                            <tr class="savingtype-total">
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="text-right">@stGroup.Key</td>
                                <td class="text-right">@stTotal.ToString("N2")</td>
                                <td></td>
                            </tr>
                        }
                    }

                    <tr class="grand-total">
                        <td colspan="4" class="text-right">Grand Total</td>
                        <td class="text-right">@grandTotal.ToString("N2")</td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="7" class="text-center">No deposit transactions found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>