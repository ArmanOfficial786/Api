@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8.5pt";
    const int ColumnCount = 8;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    var rows = (Model["Rows"] as List<BranchToBranchExpenseRowDto>) ?? new List<BranchToBranchExpenseRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchFromName = Text("BranchFromName", "All");
    var branchToName = Text("BranchToName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalAmount = Dec("TotalAmount");
    var totalRecords = (int)Dec("TotalRecords");
    if (totalRecords == 0) totalRecords = rows.Count;

    var dateGroups = rows
        .GroupBy(r => r.Date ?? "")
        .OrderBy(g => g.Key)
        .ToList();

    var table = new ReportTable(Model, title: "Branch To Branch Expense Report", sheetName: "BranchToBranchExpense")
        .Column("Date", 10)
        .Column("Saving Type", 12)
        .Column("Member Id", 10)
        .Column("Name", 16)
        .Column("Bill No.", 10)
        .Column("Account No", 16)
        .Column("Cheque No", 12)
        .Column("Amount", 14, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td.date-hdr { padding-top: 8px; border-top: 0; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-group td.type-hdr { padding-left: 14px; border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td.idx-cell { padding-left: 24px; }\n" +
            "table.sheet-table tr.r-data td.date-total { font-weight: bold; border-top: 1px solid #000; border-bottom: 2px solid #000; padding-top: 4px; padding-bottom: 6px; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; border-bottom: 0; }");

    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        4);
    table.MetaRow(
        Fmt.Labeled("Collection Branch Name :", branchFromName),
        Fmt.Labeled("Branch Name :", branchToName),
        4);

    foreach (var dateGroup in dateGroups)
    {
        table.GroupBy(new ReportCell(dateGroup.Key, Align.Left, ColumnCount, "date-hdr"));

        foreach (var typeGroup in dateGroup.GroupBy(r => r.Type ?? "").OrderBy(g => g.Key))
        {
            table.GroupBy(
                ReportCell.Left(""),
                new ReportCell(typeGroup.Key, Align.Left, ColumnCount - 1, "type-hdr"));

            var idx = 0;
            foreach (var row in typeGroup)
            {
                table.Data(
                    new ReportCell((++idx).ToString(), Align.Left, 1, "idx-cell"),
                    ReportCell.Left(""),
                    ReportCell.Left(row.MemberId ?? ""),
                    ReportCell.Left(row.MemberName ?? ""),
                    ReportCell.Left(row.BillNo ?? ""),
                    ReportCell.Left(row.AccountNo ?? ""),
                    ReportCell.Left(row.ChequeNo ?? ""),
                    ReportCell.Right(Fmt.Amount(row.Amount)));
            }

            table.SubTotal(typeGroup.Key, ColumnCount - 1, typeGroup.Sum(r => r.Amount ?? 0).ToString("N2"));
        }

        table.Data(
            new ReportCell($"Total Records : {dateGroup.Count()}", Align.Left, 3, "date-total"),
            new ReportCell(dateGroup.Key, Align.Center, 4, "date-total"),
            new ReportCell(dateGroup.Sum(r => r.Amount ?? 0).ToString("N2"), Align.Right, 1, "date-total"));
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", ColumnCount - 1, totalAmount.ToString("N2"));
        table.Total("Total Records", ColumnCount - 1, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())