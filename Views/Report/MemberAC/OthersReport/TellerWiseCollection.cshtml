@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";
    var metaFontSize = "8pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as IEnumerable<TellerWiseCollectionRowDto>)?.ToList() ?? new List<TellerWiseCollectionRowDto>();
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var tellerHeader = Text("TellerName");
    if (tellerHeader == "") tellerHeader = "All Tellers";
    var orderBy = Text("OrderBy");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;
    var grandShare = TotalOr("TotalShareAmount", rows.Sum(r => r.ShareAmount.GetValueOrDefault()));
    var grandSaving = TotalOr("TotalSavingAmount", rows.Sum(r => r.SavingAmount.GetValueOrDefault()));
    var grandPrinciple = TotalOr("TotalLoanPrinciple", rows.Sum(r => r.LoanPrinciple.GetValueOrDefault()));
    var grandInterest = TotalOr("TotalLoanInterest", rows.Sum(r => r.LoanInterest.GetValueOrDefault()));
    var grandPenalty = TotalOr("TotalLoanPenalty", rows.Sum(r => r.LoanPenalty.GetValueOrDefault()));
    var grandMisc = TotalOr("TotalMiscellaneousAmount", rows.Sum(r => r.MiscellaneousAmount.GetValueOrDefault()));
    var grandTotal = TotalOr("TotalAmount", rows.Sum(r => r.RowTotal));

    var table = new ReportTable(Model, title: "Teller Wise Collection Report", sheetName: "TellerWiseCollection")
        .Column("SN", 4, Align.Center)
        .Column("Member Id", 9)
        .Column("A/C No", 13)
        .Column("Bill No", 9)
        .Column("Share Amt", 9, Align.Right)
        .Column("Saving Amt", 9, Align.Right)
        .Column("Loan Principle", 9, Align.Right)
        .Column("Loan Interest", 9, Align.Right)
        .Column("Loan Penalty", 9, Align.Right)
        .Column("Misc. Amt", 9, Align.Right)
        .Column("Total", 11, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td, table.sheet-table tr.r-note td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaRow(
            Fmt.Labeled("Report Generated On :", generatedOn),
            Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
            leftSpan: 5)
         .MetaPair("Teller :", tellerHeader, "Order By :", orderBy);

    foreach (var tellerGroup in rows.GroupBy(r => string.IsNullOrEmpty(r.TellerName) ? tellerHeader : r.TellerName))
    {
        table.GroupTitle(tellerGroup.Key);

        foreach (var dateGroup in tellerGroup.GroupBy(r => r.Date))
        {
            var dateText = Convert.ToString(dateGroup.Key) ?? "";
            table.GroupTitle(dateText);

            var lineCount = 0;

            foreach (var memberGroup in dateGroup.GroupBy(r => new { r.MemberId, r.MemberName }))
            {
                table.GroupBy(
                    ReportCell.Left(""),
                    ReportCell.Left(memberGroup.Key.MemberId ?? ""),
                    ReportCell.Left(memberGroup.Key.MemberName ?? "", 9));

                var sn = 0;
                foreach (var row in memberGroup)
                {
                    sn++;
                    lineCount++;
                    table.Data(new[]
                    {
                        ReportCell.Center(sn.ToString()),
                        ReportCell.Left(""),
                        ReportCell.Left(row.Details ?? ""),
                        ReportCell.Left(row.BillNo ?? ""),
                        ReportCell.Right(Fmt.Amount(row.ShareAmount.GetValueOrDefault())),
                        ReportCell.Right(Fmt.Amount(row.SavingAmount.GetValueOrDefault())),
                        ReportCell.Right(Fmt.Amount(row.LoanPrinciple.GetValueOrDefault())),
                        ReportCell.Right(Fmt.Amount(row.LoanInterest.GetValueOrDefault())),
                        ReportCell.Right(Fmt.Amount(row.LoanPenalty.GetValueOrDefault())),
                        ReportCell.Right(Fmt.Amount(row.MiscellaneousAmount.GetValueOrDefault())),
                        ReportCell.Right(Fmt.Amount(row.RowTotal))
                    });
                }
            }

            var dTotal = dateGroup.Sum(r => r.RowTotal);

            table.SubTotal($"{dateText}  —  {lineCount} records", 4,
                Fmt.Amount(dateGroup.Sum(r => r.ShareAmount.GetValueOrDefault())),
                Fmt.Amount(dateGroup.Sum(r => r.SavingAmount.GetValueOrDefault())),
                Fmt.Amount(dateGroup.Sum(r => r.LoanPrinciple.GetValueOrDefault())),
                Fmt.Amount(dateGroup.Sum(r => r.LoanInterest.GetValueOrDefault())),
                Fmt.Amount(dateGroup.Sum(r => r.LoanPenalty.GetValueOrDefault())),
                Fmt.Amount(dateGroup.Sum(r => r.MiscellaneousAmount.GetValueOrDefault())),
                Fmt.Amount(dTotal));

            table.Note($"Date Wise Total Income : {Fmt.Amount(dTotal)}");
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 4,
            Fmt.Amount(grandShare), Fmt.Amount(grandSaving), Fmt.Amount(grandPrinciple),
            Fmt.Amount(grandInterest), Fmt.Amount(grandPenalty), Fmt.Amount(grandMisc), Fmt.Amount(grandTotal));
        table.Total("Total Records", 10, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())