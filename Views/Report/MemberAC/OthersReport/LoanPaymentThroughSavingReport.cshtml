@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    var rows = (Model["Rows"] as List<LoanPaymentThroughSavingRowDto>) ?? new List<LoanPaymentThroughSavingRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var isHorizontal = Text("ReportView", "Vertical") == "Horizontal";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var colCount = isHorizontal ? 11 : 8;
    var totalAmount = Dec("TotalAmount");
    var totalRecords = (int)Dec("TotalRecords");

    var table = new ReportTable(Model, title: "Loan Payment Through Saving Report", sheetName: "LoanPaymentThroughSaving");

    if (isHorizontal)
    {
        table
            .Column("S.NO.", 4, Align.Center)
            .Column("Member Id", 9)
            .Column("Member Name", 14)
            .Column("Saving", 9)
            .Column("Loan", 9)
            .Column("Fine", 8, Align.Right)
            .Column("Interest", 9, Align.Right)
            .Column("Principle", 9, Align.Right)
            .Column("Net Amount", 10, Align.Right)
            .Column("Date", 9)
            .Column("Operator", 10);
    }
    else
    {
        table
            .Column("S.NO.", 4, Align.Center)
            .Column("Date", 11)
            .Column("Member Id", 11)
            .Column("Member Name", 19)
            .Column("Type", 11)
            .Column("Account No", 16)
            .Column("Net Amount", 13, Align.Right)
            .Column("Operator", 15);
    }

    table
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        4);

    var sn = 0;
    foreach (var row in rows)
    {
        if (isHorizontal)
        {
            table.Data(
                (++sn).ToString(),
                row.MemberId ?? "",
                row.MemberName ?? "",
                row.SavingAccountNo ?? "",
                row.LoanAccountNo ?? "",
                Fmt.Amount(row.Fine),
                Fmt.Amount(row.Interest),
                Fmt.Amount(row.Principal),
                Fmt.Amount(row.NetAmount),
                row.Date ?? "",
                row.Operator ?? "");
        }
        else
        {
            table.Data(
                (++sn).ToString(),
                row.Date ?? "",
                row.MemberId ?? "",
                row.MemberName ?? "",
                row.Type ?? "",
                row.AccountNo ?? "",
                Fmt.Amount(row.NetAmount),
                row.Operator ?? "");
        }
    }

    if (rows.Count > 0)
    {
        if (isHorizontal)
        {
            table.Total("Grand Total", 5,
                rows.Sum(r => r.Fine ?? 0).ToString("N2"),
                rows.Sum(r => r.Interest ?? 0).ToString("N2"),
                rows.Sum(r => r.Principal ?? 0).ToString("N2"),
                totalAmount.ToString("N2"),
                "",
                "");
            table.Total("Total Records", 8, totalRecords.ToString(), "", "");
        }
        else
        {
            table.Total("Grand Total", 6, totalAmount.ToString("N2"), "");
            table.Total("Total Records", 6, totalRecords.ToString(), "");
        }
    }
    else
    {
        table.Data(ReportCell.Center("No data found for the selected criteria", colCount));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())