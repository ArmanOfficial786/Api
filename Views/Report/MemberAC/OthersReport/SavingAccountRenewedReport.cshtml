@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";

    var rows = (Model["Rows"] as IEnumerable<SavingAccountRenewedRowDto>)?.ToList() ?? new List<SavingAccountRenewedRowDto>();
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames");
    if (branchNames == "") branchNames = "All Branches";
    var generatedOn = Text("ReportGeneratedOnBs");
    if (generatedOn == "") generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;
    var totalRenewedAccounts = Model.TryGetValue("TotalRenewedAccounts", out var ta) && ta != null
        ? Convert.ToInt32(ta)
        : 0;

    var hasDates = !string.IsNullOrEmpty(fromDate) && fromDate != "-1"
        && !string.IsNullOrEmpty(toDate) && toDate != "-1";

    var table = new ReportTable(Model, title: "Savings Account Renewed Report", sheetName: "SavingAccountRenewed")
        .Column("Member Id", 14)
        .Column("Account No", 16)
        .Column("Deposit Type Name", 24)
        .Column("Interest Rate", 14, Align.Right)
        .Column("Open Date", 16)
        .Column("Renewed Date", 16)
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaPair("Branch Name :", branchNames, "Report Generated On :", generatedOn);
    if (hasDates) table.MetaPair("From Date :", fromDate, "To Date :", toDate);

    foreach (var grp in rows.GroupBy(x => new { x.MemberId, x.MemberName }))
    {
        table.GroupBy(
            ReportCell.Left(grp.Key.MemberId ?? ""),
            ReportCell.Left(grp.Key.MemberName ?? "", 5));

        foreach (var row in grp)
        {
            table.Data(new[]
            {
                ReportCell.Left(""),
                ReportCell.Left(row.AccountNo ?? ""),
                ReportCell.Left(row.DepositTypeName ?? ""),
                ReportCell.Right(row.InterestRate.HasValue ? row.InterestRate.Value.ToString("N2") : ""),
                ReportCell.Left(row.AccountOpenOnBs ?? ""),
                ReportCell.Left(row.MaturityOnBs ?? "")
            });
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Total Renewed Accounts", 5, totalRenewedAccounts.ToString());
        table.Total("Total Records", 5, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())