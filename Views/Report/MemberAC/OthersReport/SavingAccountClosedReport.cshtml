@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<SavingAccountClosedRowDto>) ?? new List<SavingAccountClosedRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalCloseAmount = Model["TotalCloseAmount"] as decimal? ?? 0;
    var totalClosedAccounts = Model["TotalClosedAccounts"] as int? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Two-level grouping matching the image: Member -> Deposit Type -> account rows.
    var memberGroups = rows.GroupBy(r => new { r.MemberId, r.Name }).ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Savings Account Closed Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8.5pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                border-top: 2px solid #000;
                border-bottom: 1.5px solid #000;
                text-align: left;
                white-space: nowrap;
                font-weight: bold;
            }

            .member-row td {
                font-weight: bold;
                padding-top: 12px;
                padding-bottom: 2px;
            }

            .member-row.first-group td {
                padding-top: 6px;
            }

            .deposit-type-row td {
                font-weight: bold;
                padding-left: 20px;
                padding-bottom: 2px;
            }

            .detail-row td:first-child {
                padding-left: 32px;
            }

            .deposit-subtotal-row td {
                border-bottom: 1px solid #000;
                padding-bottom: 4px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="SavingAccountClosed">
            <colgroup>
                <col style="width:16%;" />
                <col style="width:14%;" />
                <col style="width:10%;" />
                <col style="width:10%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:14%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="8">Savings Account Closed Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="4"><strong>Branch Name :</strong> @branchNames</td>
                    <td colspan="4" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="4"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="4"></td>
                </tr>
                <tr class="meta-spacer"><td colspan="8"></td></tr>

                <tr>
                    <th>Member Details</th>
                    <th>Account Details</th>
                    <th>Open Date</th>
                    <th>Close Date</th>
                    <th class="text-right">Charge</th>
                    <th class="text-right">Net Amount</th>
                    <th class="text-right">Close Amount</th>
                    <th>Operator</th>
                </tr>

                @if (memberGroups.Any())
                {
                    bool isFirstMemberGroup = true;
                    foreach (var memberGroup in memberGroups)
                    {
                        <tr class="member-row @(isFirstMemberGroup ? "first-group" : "")">
                            <td colspan="8">@memberGroup.Key.MemberId&nbsp;&nbsp;@memberGroup.Key.Name</td>
                        </tr>
                        isFirstMemberGroup = false;

                        var depositTypeGroups = memberGroup.GroupBy(r => r.DepositTypeName ?? "").ToList();

                        foreach (var typeGroup in depositTypeGroups)
                        {
                            <tr class="deposit-type-row">
                                <td colspan="8">@typeGroup.Key</td>
                            </tr>

                            var accountsInGroup = typeGroup.ToList();
                            for (int i = 0; i < accountsInGroup.Count; i++)
                            {
                                var row = accountsInGroup[i];
                                var isLast = i == accountsInGroup.Count - 1;
                                <tr class="detail-row @(isLast ? "deposit-subtotal-row" : "")">
                                    <td></td>
                                    <td>@(row.AccountNo ?? "")</td>
                                    <td>@(row.OpenedDate ?? "")</td>
                                    <td>@(row.ClosedDate ?? "")</td>
                                    <td class="text-right">@(row.ChargeAmount.HasValue ? row.ChargeAmount.Value.ToString("N2") : "")</td>
                                    <td class="text-right">@(row.NetAmount.HasValue ? row.NetAmount.Value.ToString("N2") : "")</td>
                                    <td class="text-right">@(row.CloseAmount.HasValue ? row.CloseAmount.Value.ToString("N2") : "")</td>
                                    <td>@(row.Operator ?? "")</td>
                                </tr>
                            }
                        }
                    }

                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Grand Total</td>
                        <td class="text-right">@totalCloseAmount.ToString("N2")</td>
                        <td></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Total Closed Accounts</td>
                        <td class="text-right">@totalClosedAccounts</td>
                        <td></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No closed saving accounts found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>