@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8.5pt";
    const int ColumnCount = 8;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    var rows = (Model["Rows"] as List<SavingAccountClosedRowDto>) ?? new List<SavingAccountClosedRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalCloseAmount = Dec("TotalCloseAmount");
    var totalClosedAccounts = (int)Dec("TotalClosedAccounts");
    var totalRecords = (int)Dec("TotalRecords");

    var memberGroups = rows.GroupBy(r => new { r.MemberId, r.Name }).ToList();

    var table = new ReportTable(Model, title: "Savings Account Closed Report", sheetName: "SavingAccountClosed")
        .Column("Member Details", 16)
        .Column("Account Details", 14)
        .Column("Open Date", 10)
        .Column("Close Date", 10)
        .Column("Charge", 12, Align.Right)
        .Column("Net Amount", 12, Align.Right)
        .Column("Close Amount", 12, Align.Right)
        .Column("Operator", 14)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 3px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1.5px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-group td.m-hdr { padding-top: 12px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-group td.m-first { padding-top: 6px; }\n" +
            "table.sheet-table tr.r-group td.type-hdr { padding-left: 20px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td.last-row { border-bottom: 1px solid #000; padding-bottom: 4px; }");

    table.MetaRow(
        Fmt.Labeled("Branch Name :", branchNames),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        4);
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    var firstMember = true;
    foreach (var memberGroup in memberGroups)
    {
        table.GroupBy(new ReportCell(
            $"{memberGroup.Key.MemberId}  {memberGroup.Key.Name}", Align.Left, ColumnCount,
            firstMember ? "m-hdr m-first" : "m-hdr"));
        firstMember = false;

        foreach (var typeGroup in memberGroup.GroupBy(r => r.DepositTypeName ?? ""))
        {
            table.GroupBy(new ReportCell(typeGroup.Key, Align.Left, ColumnCount, "type-hdr"));

            var accounts = typeGroup.ToList();
            for (var i = 0; i < accounts.Count; i++)
            {
                var row = accounts[i];
                var last = i == accounts.Count - 1 ? "last-row" : null;

                table.Data(
                    new ReportCell("", Align.Left, 1, last),
                    new ReportCell(row.AccountNo ?? "", Align.Left, 1, last),
                    new ReportCell(row.OpenedDate ?? "", Align.Left, 1, last),
                    new ReportCell(row.ClosedDate ?? "", Align.Left, 1, last),
                    new ReportCell(Fmt.Amount(row.ChargeAmount), Align.Right, 1, last),
                    new ReportCell(Fmt.Amount(row.NetAmount), Align.Right, 1, last),
                    new ReportCell(Fmt.Amount(row.CloseAmount), Align.Right, 1, last),
                    new ReportCell(row.Operator ?? "", Align.Left, 1, last));
            }
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 6, totalCloseAmount.ToString("N2"), "");
        table.Total("Total Closed Accounts", 6, totalClosedAccounts.ToString(), "");
        table.Total("Total Records", 6, totalRecords.ToString(), "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())