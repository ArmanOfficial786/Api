@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";
    var metaFontSize = "8pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a row is only ever filled in one of the four amount buckets, so the sum is that row's amount
    decimal RowTotal(TellerWiseExpenseRowDto r) =>
        (r.SavingWithdrawlAmount ?? 0) + (r.ShareReturnAmount ?? 0) +
        (r.LoanIssueAmount ?? 0) + (r.MiscellaneousAmount ?? 0);

    // BillNo arrives as text: show it as an amount when it parses, otherwise as it is
    string FormatBillNo(string? billNo)
    {
        if (string.IsNullOrWhiteSpace(billNo)) return "";
        return decimal.TryParse(billNo, out var parsed) && parsed != 0 ? parsed.ToString("N2") : billNo;
    }

    var rows = (Model["Rows"] as IEnumerable<TellerWiseExpenseRowDto>)?.ToList() ?? new List<TellerWiseExpenseRowDto>();
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var orderBy = Text("OrderBy");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;
    var totalWithdrawl = TotalOr("TotalSavingWithdrawlAmount", rows.Sum(r => r.SavingWithdrawlAmount ?? 0));
    var totalShareReturn = TotalOr("TotalShareReturnAmount", rows.Sum(r => r.ShareReturnAmount ?? 0));
    var totalLoanIssue = TotalOr("TotalLoanIssueAmount", rows.Sum(r => r.LoanIssueAmount ?? 0));
    var totalMisc = TotalOr("TotalMiscellaneousAmount", rows.Sum(r => r.MiscellaneousAmount ?? 0));
    var totalAmount = TotalOr("TotalAmount", rows.Sum(RowTotal));

    var table = new ReportTable(Model, title: "Teller Wise Expense Report", sheetName: "TellerWiseExpense")
        .Column("SN", 3, Align.Center)
        .Column("Member Id", 10)
        .Column("A/C No", 14)
        .Column("Bill No", 8, Align.Right)
        .Column("Savings Withdrawl Amt", 13, Align.Right)
        .Column("Share Return", 13, Align.Right)
        .Column("Loan Issue", 13, Align.Right)
        .Column("Miscellaneous Amt", 13, Align.Right)
        .Column("Total", 13, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 9, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        leftSpan: 4);
    if (!string.IsNullOrEmpty(orderBy)) table.MetaRow(Fmt.Labeled("Order By :", orderBy));

    var ordered = rows.OrderBy(r => r.TellerName ?? "").ThenBy(r => r.Date ?? "").ToList();

    foreach (var tellerGroup in ordered.GroupBy(r => r.TellerName ?? ""))
    {
        table.GroupTitle(tellerGroup.Key);

        foreach (var dateGroup in tellerGroup.GroupBy(r => r.Date ?? ""))
        {
            table.GroupTitle(dateGroup.Key);

            foreach (var memberGroup in dateGroup.GroupBy(r => new { r.MemberId, r.MemberName }))
            {
                table.GroupBy(
                    ReportCell.Left(""),
                    ReportCell.Left(memberGroup.Key.MemberId ?? ""),
                    ReportCell.Left(memberGroup.Key.MemberName ?? "", 7));

                var sn = 0;
                foreach (var row in memberGroup)
                {
                    table.Data(new[]
                    {
                        ReportCell.Center((++sn).ToString()),
                        ReportCell.Left(""),
                        ReportCell.Left(row.Details ?? ""),
                        ReportCell.Right(FormatBillNo(row.BillNo)),
                        ReportCell.Right(Fmt.Amount(row.SavingWithdrawlAmount ?? 0)),
                        ReportCell.Right(Fmt.Amount(row.ShareReturnAmount ?? 0)),
                        ReportCell.Right(Fmt.Amount(row.LoanIssueAmount ?? 0)),
                        ReportCell.Right(Fmt.Amount(row.MiscellaneousAmount ?? 0)),
                        ReportCell.Right(Fmt.Amount(RowTotal(row)))
                    });
                }
            }

            table.SubTotal("Date Wise Total Expense :", 8, Fmt.Amount(dateGroup.Sum(RowTotal)));
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 4,
            Fmt.Amount(totalWithdrawl), Fmt.Amount(totalShareReturn), Fmt.Amount(totalLoanIssue),
            Fmt.Amount(totalMisc), Fmt.Amount(totalAmount));
        table.Total("Total Records", 8, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())