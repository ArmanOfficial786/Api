@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";
    var metaFontSize = "8pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";

    var rows = (Model["Rows"] as IEnumerable<SavingIssueRowDto>)?.ToList() ?? new List<SavingIssueRowDto>();
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames");
    if (branchNames == "") branchNames = "All";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;
    var totalAccounts = Model.TryGetValue("TotalAccounts", out var ta) && ta != null && Convert.ToInt32(ta) > 0
        ? Convert.ToInt32(ta)
        : rows.Count;

    var table = new ReportTable(Model, title: "Savings Issue Report", sheetName: "SavingIssue")
        .Column("Deposit Type", 12)
        .Column("A/C No", 14)
        .Column("Member ID", 12)
        .Column("Member Name", 18)
        .Column("SMS Category", 16)
        .Column("A/C Type", 8)
        .Column("A/C Open Date", 12)
        .Column("Interest %", 8, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaRow(
            Fmt.Labeled("Branch Name :", branchNames),
            Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
            leftSpan: 4)
         .MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var depositGroup in rows.GroupBy(r => r.DepositTypeName ?? ""))
    {
        table.GroupTitle(depositGroup.Key);

        foreach (var installmentGroup in depositGroup.GroupBy(r => r.InstallmentTypeName ?? ""))
        {
            table.GroupBy(
                ReportCell.Left(""),
                ReportCell.Left(installmentGroup.Key, 7));

            foreach (var row in installmentGroup)
            {
                table.Data(new[]
                {
                    ReportCell.Left(""),
                    ReportCell.Left(row.AccountNo ?? ""),
                    ReportCell.Left(row.MemberId ?? ""),
                    ReportCell.Left(row.MemberName ?? ""),
                    ReportCell.Left(row.SmsCategory ?? ""),
                    ReportCell.Left(row.AccountType ?? ""),
                    ReportCell.Left(row.AccountOpenOnBs ?? ""),
                    ReportCell.Right(row.InterestRate.HasValue ? row.InterestRate.Value.ToString("N2") : "")
                });
            }
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Total Accounts", 7, totalAccounts.ToString());
        table.Total("Total Records", 7, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())