@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport

@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<BranchToBranchCollectionRowDto>) ?? new List<BranchToBranchCollectionRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchFromName = Model["BranchFromName"]?.ToString() ?? "";
    var branchToName = Model["BranchToName"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "All Collectors";
    var reportType = Model["ReportType"]?.ToString() ?? "";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Branch To Branch Collection Report</title>
    <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body { font-family: Arial, sans-serif; font-size: 9pt; background: white; }
            .report-container { width: 100%; overflow: visible; }
            .data-table { width: 100%; border-collapse: collapse; font-size: 9pt; }
            .data-table td, .data-table th { padding: 4px 6px; border: 1px solid #ccc; }
            .data-table th { background: #f2f2f2; border-top: 2px solid #000; border-bottom: 1px solid #000; text-align: left; }
            .data-table thead { display: table-row-group; }
            .grand-total { border-top: 2px solid #000; border-bottom: 2px solid #000; font-weight: bold; background: #f9f9f9; }
            .text-right { text-align: right !important; }
            .text-center { text-align: center !important; }
            .member-box { margin-bottom: 6px; }
            @@media print { .data-table thead { display: table-row-group; } }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th colspan="9" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">
                        Branch To Branch Collection Report
                    </th>
                </tr>
                <tr>
                    <td colspan="9">
                        <div class="member-box">
                            <strong>Collection Branch:</strong> @branchFromName &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Account Branch:</strong> @branchToName &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Collector:</strong> @collectorName &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Report Type:</strong> @reportType &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>From:</strong> @fromDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>To:</strong> @toDate &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Order By:</strong> @orderBy &nbsp;&nbsp;|&nbsp;&nbsp;
                            <strong>Generated:</strong> @generatedOn
                        </div>
                    </td>
                </tr>
                <tr>
                    <th style="width:3%;">SN</th>
                    <th style="width:10%;">Date</th>
                    <th style="width:10%;">Member Id</th>
                    <th style="width:18%;">Member Name</th>
                    <th style="width:10%;">Type</th>
                    <th style="width:15%;">Account No</th>
                    <th style="width:12%;">Collector</th>
                    <th style="width:10%;" class="text-right">Amount</th>
                    <th style="width:12%;">Operator</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@(row.Date ?? "")</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            <td>@(row.Type ?? "")</td>
                            <td>@(row.AccountNo ?? "")</td>
                            <td>@(row.Collector ?? "")</td>
                            <td class="text-right">@(row.Amount.HasValue ? row.Amount.Value.ToString("N2") : "")</td>
                            <td>@(row.Operator ?? "")</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="7" class="text-right"><strong>Total</strong></td>
                        <td class="text-right"><strong>@totalAmount.ToString("N2")</strong></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="7" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-right"><strong>@totalRecords</strong></td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="9" class="text-center">No data found for the selected criteria</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>