@* Views/Report/MemberAC/OthersReport/BranchToBranchCollection.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<BranchToBranchCollectionRowDto>) ?? new List<BranchToBranchCollectionRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchFromName = Model["BranchFromName"]?.ToString() ?? "All";
    var branchToName = Model["BranchToName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Repository normalizes Type from SavingType (with SP-name fallback),
    // so this grouping works whether the SP returned Type or SavingType.
    var dateGroups = rows
        .GroupBy(r => r.Date ?? "")
        .OrderBy(g => g.Key)
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Branch To Branch Collection Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8.5pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .meta-rule td {
                border-bottom: 1px solid #000;
                padding-bottom: 6px;
            }

            .data-table th {
                background: #f2f2f2;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .date-group-row td {
                font-weight: bold;
                padding-top: 8px;
                border-bottom: 1px solid #000;
            }

            .type-group-row td {
                font-weight: bold;
                padding-left: 14px;
            }

            .detail-row td:first-child {
                padding-left: 24px;
            }

            .type-subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
            }

            .date-total-row td {
                border-top: 1px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                padding-top: 4px;
                padding-bottom: 6px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="BranchToBranchCollection">
            <colgroup>
                <col style="width:12%;" />
                <col style="width:14%;" />
                <col style="width:12%;" />
                <col style="width:20%;" />
                <col style="width:14%;" />
                <col style="width:14%;" />
                <col style="width:14%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="7">Branch To Branch Collection Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="4"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="3" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row meta-rule">
                    <td colspan="4"><strong>Collection Branch Name :</strong> @branchFromName</td>
                    <td colspan="3" class="text-right"><strong>Branch Name :</strong> @branchToName</td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <tr>
                    <th>Date</th>
                    <th>Saving Type</th>
                    <th>Member Id</th>
                    <th>Name</th>
                    <th>Bill No.</th>
                    <th>Account No</th>
                    <th class="text-right">Amount</th>
                </tr>

                @if (dateGroups.Any())
                {
                    foreach (var dateGroup in dateGroups)
                    {
                        <tr class="date-group-row">
                            <td colspan="7">@dateGroup.Key</td>
                        </tr>

                        var typeGroups = dateGroup.GroupBy(r => r.Type ?? "").OrderBy(g => g.Key).ToList();

                        foreach (var typeGroup in typeGroups)
                        {
                            <tr class="type-group-row">
                                <td></td>
                                <td colspan="6">@typeGroup.Key</td>
                            </tr>

                            int idx = 0;
                            foreach (var row in typeGroup)
                            {
                                idx++;
                                <tr class="detail-row">
                                    <td>@idx</td>
                                    <td></td>
                                    <td>@(row.MemberId ?? "")</td>
                                    <td>@(row.MemberName ?? "")</td>
                                    <td>@(row.BillNo ?? "")</td>
                                    <td>@(row.AccountNo ?? "")</td>
                                    <td class="text-right">@(row.Amount.HasValue ? row.Amount.Value.ToString("N2") : "")</td>
                                </tr>
                            }

                            <tr class="type-subtotal-row">
                                <td colspan="6" class="text-right">@typeGroup.Key</td>
                                <td class="text-right">@typeGroup.Sum(r => r.Amount ?? 0).ToString("N2")</td>
                            </tr>
                        }

                        <tr class="date-total-row">
                            <td colspan="3">Total Records : @dateGroup.Count()</td>
                            <td colspan="3" class="text-center">@dateGroup.Key</td>
                            <td class="text-right">@dateGroup.Sum(r => r.Amount ?? 0).ToString("N2")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Grand Total</td>
                        <td class="text-right">@totalAmount.ToString("N2")</td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>