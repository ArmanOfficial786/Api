@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";

    var rows = (Model["Rows"] as IEnumerable<SavingTransferRowDto>)?.ToList() ?? new List<SavingTransferRowDto>();
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames");
    if (branchNames == "") branchNames = "All Branches";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;
    var totalAmount = Model.TryGetValue("TotalAmount", out var ta) && ta != null && Convert.ToDecimal(ta) != 0
        ? Convert.ToDecimal(ta)
        : rows.Sum(r => r.Amount ?? 0);

    var table = new ReportTable(Model, title: "Saving Transfer Report", sheetName: "SavingTransfer")
        .Column("Member Id", 10)
        .Column("Member Name", 17)
        .Column("Account No", 17)
        .Column("Type", 12)
        .Column("Amount", 14, Align.Right)
        .Column("Date", 14)
        .Column("Operator", 16)
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaRow(
            Fmt.Labeled("Branch Name :", branchNames),
            Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
            leftSpan: 3)
         .MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var row in rows)
    {
        table.Data(new[]
        {
            ReportCell.Left(row.MemberId ?? ""),
            ReportCell.Left(row.MemberName ?? ""),
            ReportCell.Left(row.AccountNo ?? ""),
            ReportCell.Left(row.Type ?? ""),
            ReportCell.Right(Fmt.Amount(row.Amount)),
            ReportCell.Left(row.Date ?? ""),
            ReportCell.Left(row.Operator ?? "")
        });
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 4, Fmt.Amount(totalAmount), "", "");
        table.Total("Total Records", 4, totalRecords.ToString(), "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())