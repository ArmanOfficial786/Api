@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9.5pt";
    const int ColumnCount = 6;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    var rows = (Model["Rows"] as List<SavingAccountDeletedRowDto>) ?? new List<SavingAccountDeletedRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalDeletedAccounts = Model.TryGetValue("TotalDeletedAccounts", out var tda) && tda != null ? Convert.ToInt32(tda) : 0;

    var typeGroups = rows.GroupBy(r => r.DepositTypeName).ToList();

    var table = new ReportTable(Model, title: "Savings Account Deleted Report", sheetName: "SavingAccountDeleted")
        .Column("Deposit Type", 22)
        .Column("Member Id", 14)
        .Column("Member Name", 24)
        .Column("Account No", 16)
        .Column("Opened Date", 12)
        .Column("Deleted Date", 12)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 9, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.3; padding: 3px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1.5px solid #000; padding: 5px 6px; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 14px; padding-bottom: 4px; }\n" +
            "table.sheet-table tr.r-group td.g-first { padding-top: 6px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; padding-top: 2px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-data td.last-row { border-bottom: 1px solid #000; padding-bottom: 4px; }\n" +
            "table.sheet-table tr.r-total td { border-top: 2px solid #000; border-bottom: 2px solid #000; padding-top: 6px; padding-bottom: 6px; }");

    table.MetaRow(
        Fmt.Labeled("Branch Name :", branchNames),
        Fmt.Labeled("From Date :", fromDate),
        3);
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Labeled("To Date :", toDate),
        3);

    var firstGroup = true;
    foreach (var typeGroup in typeGroups)
    {
        table.GroupBy(new ReportCell(typeGroup.Key ?? "", Align.Left, ColumnCount, firstGroup ? "g-first" : null));
        firstGroup = false;

        var accounts = typeGroup.ToList();
        for (var i = 0; i < accounts.Count; i++)
        {
            var row = accounts[i];
            var last = i == accounts.Count - 1 ? "last-row" : null;

            table.Data(
                new ReportCell("", Align.Left, 1, last),
                new ReportCell(row.MemberId ?? "", Align.Left, 1, last),
                new ReportCell(row.MemberName ?? "", Align.Left, 1, last),
                new ReportCell(row.AccountNo ?? "", Align.Left, 1, last),
                new ReportCell(row.AccountOpenOnBs ?? "", Align.Left, 1, last),
                new ReportCell(row.DeletedDate ?? "", Align.Left, 1, last));
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Total Deleted Accounts", ColumnCount - 1, totalDeletedAccounts.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())