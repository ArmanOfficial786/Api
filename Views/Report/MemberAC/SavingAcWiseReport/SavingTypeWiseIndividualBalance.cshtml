@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<SavingTypeWiseIndividualBalanceRowDto>) ?? new();
    var totalDeposit = Model["TotalDeposit"] as decimal? ?? 0;
    var totalWithdraw = Model["TotalWithdraw"] as decimal? ?? 0;
    var totalBalance = Model["TotalBalance"] as decimal? ?? 0;
    var totalOpening = Model["TotalOpening"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "";
    var opening = Model["OpeningBalance"] as bool? ?? false;
    var pct = Model["PercentageBalance"] as bool? ?? false;
    var byBranch = Model["GroupByBranch"] as bool? ?? false;
    var byCC = Model["GroupByCollectionCenter"] as bool? ?? false;
    var byGroup = Model["GroupByMemberGroup"] as bool? ?? false;
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string Amt(decimal v) => v < 0 ? $"({Math.Abs(v):N2})" : v.ToString("N2");
    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;

    // ── group by saving type: subtotal per type, accounts underneath ──
    var groups = rows
        .GroupBy(r => string.IsNullOrWhiteSpace(r.SavingType) ? "-" : r.SavingType!)
        .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
        .Select(g => new
        {
            SavingType = g.Key,
            Count = g.Select(r => r.AccountNo).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Count(),
            Opening = g.Sum(r => r.Opening), Deposit = g.Sum(r => r.Deposit),
            Withdraw = g.Sum(r => r.Withdraw), Balance = g.Sum(r => r.Balance),
            Branch = g.Select(r => r.BranchName).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)),
            Center = g.Select(r => r.CollectionCenterName).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)),
            Grp = g.Select(r => r.MemberGroupName).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)),
            Accounts = g.ToList()
        }).ToList();

    var gBal = groups.Sum(g => g.Balance);
    var gCount = groups.Sum(g => g.Count);

    // ── flat list for pagination: H = group header, A = account, T = grand total ──
    var lines = new List<(char Kind, int Group, int Item, int Sn)>();
    var serial = 0;
    for (var gi = 0; gi < groups.Count; gi++)
    {
        lines.Add(('H', gi, -1, 0));
        for (var ai = 0; ai < groups[gi].Accounts.Count; ai++) lines.Add(('A', gi, ai, ++serial));
    }
    if (groups.Count > 0) lines.Add(('T', -1, -1, 0));

    // ── column widths in mm (0 = flexible) ──
    var widths = new List<double>();
    if (byBranch) widths.Add(0);
    if (byCC) widths.Add(0);
    if (byGroup) widths.Add(0);
    widths.AddRange(new double[] { 12, 26, 30, 14 });      // S.N., MemberId, AccountNo, Count
    if (opening) widths.Add(0);
    widths.AddRange(new double[] { 0, 0, 0 });             // Deposit, Withdrawl, Net Balance
    if (pct) widths.Add(16);

    Func<int, IHtmlContent> subheader = @<text>
        <tr class="meta-title"><td colspan="@item">Savings Type Wise Individual Balance Report</td></tr>
        <tr class="meta-row"><td colspan="@item"><strong>Branch Name :</strong> @branchName</td></tr>
        <tr class="meta-row">
            <td colspan="@item">
                <strong>Report Generated On:</strong> @generatedOn &nbsp;|&nbsp;
                <strong>From Date :</strong> @fromDate &nbsp;|&nbsp;
                <strong>To Date :</strong> @toDate
                @if (opening) { <text>&nbsp;|&nbsp; <strong>With Opening Balance</strong></text> }
                @if (pct) { <text>&nbsp;|&nbsp; <strong>With Percentage</strong></text> }
            </td>
        </tr>
        <tr class="meta-spacer"><td colspan="@item"></td></tr>
    </text>;

    Func<int, IHtmlContent> colHeader = @<tr>
        @if (byBranch) { <th>Branch</th> }
        @if (byCC) { <th>Collection Center</th> }
        @if (byGroup) { <th>Member Group</th> }
        <th>S.N.</th><th>MemberId</th><th>AccountNo</th><th class="text-right">Count</th>
        @if (opening) { <th class="text-right">Opening</th> }
        <th class="text-right">Deposit</th><th class="text-right">Withdrawl</th><th class="text-right">Net Balance</th>
        @if (pct) { <th class="text-right">%</th> }
    </tr>;

    Func<int, IHtmlContent> row = @<text>
        @{ var ln = lines[item]; }
        @if (ln.Kind == 'H')
        {
            var grp = groups[ln.Group];
            <tr class="group-header">
                @if (byBranch) { <td>@Dash(grp.Branch)</td> }
                @if (byCC) { <td>@Dash(grp.Center)</td> }
                @if (byGroup) { <td>@Dash(grp.Grp)</td> }
                <td colspan="3">@grp.SavingType</td>
                <td class="text-right">@grp.Count</td>
                @if (opening) { <td class="text-right">@Amt(grp.Opening)</td> }
                <td class="text-right">@Amt(grp.Deposit)</td>
                <td class="text-right">@Amt(grp.Withdraw)</td>
                <td class="text-right">@Amt(grp.Balance)</td>
                @if (pct) { <td class="text-right">@(gBal == 0 ? "0.00%" : (grp.Balance / gBal * 100).ToString("F2") + "%")</td> }
            </tr>
        }
        else if (ln.Kind == 'A')
        {
            var ac = groups[ln.Group].Accounts[ln.Item];
            <tr class="detail-row">
                @if (byBranch) { <td></td> }
                @if (byCC) { <td></td> }
                @if (byGroup) { <td></td> }
                <td class="text-center">@ln.Sn</td>
                <td><div class="c">@Dash(ac.MemberId)</div></td>
                <td><div class="c">@Dash(ac.AccountNo)</div></td>
                <td></td>
                @if (opening) { <td class="text-right">@Amt(ac.Opening)</td> }
                <td class="text-right">@Amt(ac.Deposit)</td>
                <td class="text-right">@Amt(ac.Withdraw)</td>
                <td class="text-right">@Amt(ac.Balance)</td>
                @if (pct) { <td></td> }
            </tr>
        }
        else
        {
            <tr class="grand-total">
                @if (byBranch) { <td></td> }
                @if (byCC) { <td></td> }
                @if (byGroup) { <td></td> }
                <td colspan="3">Grand Total</td>
                <td class="text-right">@gCount</td>
                @if (opening) { <td class="text-right">@Amt(totalOpening)</td> }
                <td class="text-right">@Amt(totalDeposit)</td>
                <td class="text-right">@Amt(totalWithdraw)</td>
                <td class="text-right">@Amt(totalBalance)</td>
                @if (pct) { <td class="text-right">100.00%</td> }
            </tr>
        }
    </text>;

    var sheet = new SheetReport
    {
        Data = Model,
        Title = "Savings Type Wise Individual Balance Report",
        SheetName = "SavingTypeWiseIndividualBalance",
        Cols = widths.ToArray(),
        RowCount = lines.Count,
        Row = row,
        Subheader = subheader,
        ColHeader = colHeader,
        KeepWithNext = i => lines[i].Kind == 'H',   // a group header never ends a page
        RowMm = 7, HeaderMm = 8, FirstPageExtraMm = 70,
        EmptyText = "No data found"
    };
}
@await Html.PartialAsync("_SheetReport", sheet)