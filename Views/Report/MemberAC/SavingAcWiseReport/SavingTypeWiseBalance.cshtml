@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    bool Flag(string key) => Model.TryGetValue(key, out var fv) && fv is bool b && b;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string FormatAmount(decimal amount) => amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");
    string NullDisplay(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string FormatPercentage(decimal amount) => amount.ToString("F2") + "%";

    var rows = (Model["Rows"] as List<SavingTypeWiseBalanceRowDto>) ?? new List<SavingTypeWiseBalanceRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName");
    var openingBalance = Flag("OpeningBalance");
    var percentageBalance = Flag("PercentageBalance");
    var groupByBranch = Flag("GroupByBranch");
    var groupByCollectionCenter = Flag("GroupByCollectionCenter");
    var groupByMemberGroup = Flag("GroupByMemberGroup");
    var viewCollector = Flag("ViewCollector");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var groups = rows
        .GroupBy(r => string.IsNullOrWhiteSpace(r.SavingType) ? "-" : r.SavingType)
        .OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
        .Select(x => new
        {
            SavingType = x.Key,
            TransAccCount = x.Sum(r => r.TransAccCount),
            Opening = x.Sum(r => r.Opening),
            Deposit = x.Sum(r => r.Deposit),
            Withdraw = x.Sum(r => r.Withdraw),
            Balance = x.Sum(r => r.Balance),
            BranchName = x.Select(r => r.BranchName).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)),
            CollectionCenterName = x.Select(r => r.CollectionCenterName).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)),
            MemberGroupName = x.Select(r => r.MemberGroupName).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)),
            Collector = x.Select(r => r.MemberName).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))
        })
        .ToList();

    decimal grandBalanceForPct = groups.Sum(x => x.Balance);
    int grandTransAccCount = groups.Sum(x => x.TransAccCount);

    var totalOpening = TotalOr("TotalOpening", groups.Sum(x => x.Opening));
    var totalDeposit = TotalOr("TotalDeposit", groups.Sum(x => x.Deposit));
    var totalWithdraw = TotalOr("TotalWithdraw", groups.Sum(x => x.Withdraw));
    var totalBalance = TotalOr("TotalBalance", groups.Sum(x => x.Balance));

    var numericColumns = (openingBalance ? 1 : 0) + 3 + 1 + (percentageBalance ? 1 : 0);

    var table = new ReportTable(Model, title: "Saving Type Wise Balance Report", sheetName: "SavingTypeWiseBalance");
    if (groupByBranch) table.Column("Branch", 14);
    if (groupByCollectionCenter) table.Column("Collection Center", 14);
    if (groupByMemberGroup) table.Column("Member Group", 14);
    if (viewCollector) table.Column("Collector", 14);
    table.Column("Saving Type", 22);
    var labelColumns = (groupByBranch ? 1 : 0) + (groupByCollectionCenter ? 1 : 0) + (groupByMemberGroup ? 1 : 0) + (viewCollector ? 1 : 0) + 1;
    if (openingBalance) table.Column("Opening", 12, Align.Right);
    table.Column("Trans Acc Count", 10, Align.Right);
    table.Column("Deposit", 12, Align.Right);
    table.Column("Withdraw", 12, Align.Right);
    table.Column("Balance", 12, Align.Right);
    if (percentageBalance) table.Column("%", 8, Align.Right);

    table.NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 3px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }\n" +
            "table.sheet-table tr.r-total td { border-top: 2px solid #000; border-bottom: 0; }");

    table.MetaRow(Fmt.Labeled("Branch:", branchName));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date:", fromDate), Fmt.Labeled("To Date:", toDate)));
    table.MetaRow(Fmt.Labeled("Report Generated On:", generatedOn));
    if (openingBalance || percentageBalance)
    {
        var options = new List<string>();
        if (openingBalance) options.Add("With Opening Balance");
        if (percentageBalance) options.Add("With Percentage");
        table.MetaRow(Fmt.Labeled("Options:", string.Join(", ", options)));
    }

    table.Header();

    foreach (var grp in groups)
    {
        var values = new List<string>();
        if (groupByBranch) values.Add(NullDisplay(grp.BranchName));
        if (groupByCollectionCenter) values.Add(NullDisplay(grp.CollectionCenterName));
        if (groupByMemberGroup) values.Add(NullDisplay(grp.MemberGroupName));
        if (viewCollector) values.Add(NullDisplay(grp.Collector));
        values.Add(grp.SavingType);
        if (openingBalance) values.Add(FormatAmount(grp.Opening));
        values.Add(grp.TransAccCount.ToString());
        values.Add(FormatAmount(grp.Deposit));
        values.Add(FormatAmount(grp.Withdraw));
        values.Add(FormatAmount(grp.Balance));
        if (percentageBalance)
            values.Add(FormatPercentage(grandBalanceForPct == 0 ? 0 : (grp.Balance / grandBalanceForPct) * 100));

        table.Data(values.ToArray());
    }

    if (groups.Count > 0)
    {
        var totalValues = new List<string>();
        if (openingBalance) totalValues.Add(FormatAmount(totalOpening));
        totalValues.Add(grandTransAccCount.ToString());
        totalValues.Add(FormatAmount(totalDeposit));
        totalValues.Add(FormatAmount(totalWithdraw));
        totalValues.Add(FormatAmount(totalBalance));
        if (percentageBalance) totalValues.Add("100.00%");

        table.Total("Grand Total:", labelColumns, totalValues.ToArray());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())