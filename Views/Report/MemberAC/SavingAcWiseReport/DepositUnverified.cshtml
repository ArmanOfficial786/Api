@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport;
@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<DepositUnverifiedRowDto>) ?? new List<DepositUnverifiedRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var verifiedCount = Model["VerifiedCount"] as int? ?? 0;
    var unverifiedCount = Model["UnverifiedCount"] as int? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "";
    var reportType = Model["ReportType"]?.ToString() ?? "";
    var orderBy = Model["OrderBy"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string NullDisplay(object value) =>
        value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "" : value.ToString();

    string GetReportTypeLabel(string type) => type switch
    {
        "V" => "Verified",
        "U" => "Unverified",
        _ => "All"
    };

    int sn = 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Deposit Statement Verified/Unverified Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: 1px solid #ccc;
                }

                .data-table th {
                    background: #f2f2f2;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

                /* --- Stop the column-header block from repeating on every PDF page ---
                       By default a <thead> is display:table-header-group, which Chromium /
                       Puppeteer (and most CSS-paged-media renderers) repeat on every printed
                       page automatically. Overriding it to table-row-group makes it a plain
                       row group, so it renders once — only on the first page. */
                .data-table thead {
                    display: table-row-group;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .verified {
                color: #196f3d;
            }

            .unverified {
                color: #b03a2e;
            }

            @@media print {
                .data-table thead {
                    display: table-row-group;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th colspan="8" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">
                        Deposit Statement @GetReportTypeLabel(reportType) Report
                    </th>
                </tr>
                <tr>
                    <td colspan="8">
                        <strong>Branch:</strong> @branchName &nbsp;&nbsp;|&nbsp;&nbsp;
                        <strong>From:</strong> @fromDate &nbsp;&nbsp;|&nbsp;&nbsp;
                        <strong>To:</strong> @toDate &nbsp;&nbsp;|&nbsp;&nbsp;
                        <strong>Generated:</strong> @generatedOn &nbsp;&nbsp;|&nbsp;&nbsp;
                        <strong>Order By:</strong> @orderBy
                    </td>
                </tr>
                <tr>
                    <th style="width:5%;">S.No</th>
                    <th style="width:12%;">Member Id</th>
                    <th style="width:18%;">Member Name</th>
                    <th style="width:13%;">Account No</th>
                    <th style="width:13%;">Verified Date</th>
                    <th style="width:14%;">Verified P-Book Till</th>
                    <th style="width:13%;">Verified By</th>
                    <th style="width:12%;">Collector</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@NullDisplay(row.MemberId)</td>
                            <td>@NullDisplay(row.MemberName)</td>
                            <td>@NullDisplay(row.AccountNo)</td>
                            <td class="@(row.IsVerified ? "verified" : "")">@NullDisplay(row.VerifiedDate)</td>
                            <td>@NullDisplay(row.VerifiedTill)</td>
                            <td>@NullDisplay(row.VerifiedBy)</td>
                            <td>@NullDisplay(row.CollectorName)</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="7" class="text-right"><strong>Total Records</strong></td>
                        <td><strong>@totalRecords</strong></td>
                    </tr>
                    <tr>
                        <td colspan="7" class="text-right"><strong>Verified</strong></td>
                        <td class="verified"><strong>@verifiedCount</strong></td>
                    </tr>
                    <tr>
                        <td colspan="7" class="text-right"><strong>Unverified</strong></td>
                        <td class="unverified"><strong>@unverifiedCount</strong></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="8" class="text-center">No data found</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>