@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 8;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    int CountOr(string key, int fallback)
    {
        if (Model.TryGetValue(key, out var cv) && cv != null)
        {
            var iv = Convert.ToInt32(cv);
            if (iv != 0) return iv;
        }
        return fallback;
    }
    string NullDisplay(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "" : value.ToString()!;

    var rows = (Model["Rows"] as List<DepositUnverifiedRowDto>) ?? new List<DepositUnverifiedRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName");
    var reportType = Text("ReportType");
    var orderBy = Text("OrderBy");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var reportTypeLabel = reportType switch
    {
        "V" => "Verified",
        "U" => "Unverified",
        _ => "All"
    };

    var totalRecords = CountOr("TotalRecords", rows.Count);
    var verifiedCount = CountOr("VerifiedCount", rows.Count(r => r.IsVerified));
    var unverifiedCount = CountOr("UnverifiedCount", rows.Count(r => !r.IsVerified));

    var table = new ReportTable(Model, title: $"Deposit Statement {reportTypeLabel} Report", sheetName: "DepositUnverified")
        .Column("S.No", 5, Align.Center)
        .Column("Member Id", 12)
        .Column("Member Name", 18)
        .Column("Account No", 13)
        .Column("Verified Date", 13)
        .Column("Verified P-Book Till", 14)
        .Column("Verified By", 13)
        .Column("Collector", 12)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 6px; }\n" +
            "table.sheet-table tr.r-header th { border: 1px solid #ccc; border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-data td { border: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-data td.verified { color: #196f3d; }\n" +
            "table.sheet-table tr.r-data td.unverified { color: #b03a2e; }\n" +
            "table.sheet-table tr.r-data td.summary-cell { border: 0; font-weight: bold; }");

    table.MetaRow(Fmt.Join(Fmt.Labeled("Branch:", branchName), Fmt.Labeled("Order By:", orderBy)));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From:", fromDate), Fmt.Labeled("To:", toDate)));
    table.MetaRow(Fmt.Labeled("Generated:", generatedOn));

    table.Header();

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left(NullDisplay(row.MemberId)),
            ReportCell.Left(NullDisplay(row.MemberName)),
            ReportCell.Left(NullDisplay(row.AccountNo)),
            new ReportCell(NullDisplay(row.VerifiedDate), Align.Left, 1, row.IsVerified ? "verified" : null),
            ReportCell.Left(NullDisplay(row.VerifiedTill)),
            ReportCell.Left(NullDisplay(row.VerifiedBy)),
            ReportCell.Left(NullDisplay(row.CollectorName)));
    }

    if (rows.Count > 0)
    {
        table.Total("Total Records", ColumnCount - 1, totalRecords.ToString());
        table.Data(
            new ReportCell("Verified", Align.Right, ColumnCount - 1, "summary-cell"),
            new ReportCell(verifiedCount.ToString(), Align.Left, 1, "summary-cell verified"));
        table.Data(
            new ReportCell("Unverified", Align.Right, ColumnCount - 1, "summary-cell"),
            new ReportCell(unverifiedCount.ToString(), Align.Left, 1, "summary-cell unverified"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())