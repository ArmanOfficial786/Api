@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 10;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string NullDisplay(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "" : value.ToString()!;
    string FormatAmount(decimal amount) => amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    var rows = (Model["Rows"] as List<MemberAccountDeactiveRowDto>) ?? new List<MemberAccountDeactiveRowDto>();

    var tillDate = Text("TillDate");
    var branchName = Text("BranchName");
    var duePeriod = Model.TryGetValue("DuePeriod", out var dp) && dp != null ? Convert.ToInt32(dp) : 0;
    var duePeriodUnit = Text("DuePeriodUnit", "Days");
    var isActive = !Model.TryGetValue("IsActive", out var ia) || ia is not bool activeFlag || activeFlag;
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var statusLabel = isActive ? "Active" : "Inactive";

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalBalance = rows.Sum(r => r.Balance);

    var table = new ReportTable(Model, title: $"{statusLabel} Saving Account Detail Report", sheetName: "MemberAccountDeactive")
        .Column("SN", 4)
        .Column("MemberId", 9)
        .Column("Name", 13)
        .Column("Age", 5)
        .Column("Address", 12)
        .Column("Contact No", 11)
        .Column("Type", 12)
        .Column("Account No", 11)
        .Column("Balance", 11, Align.Right)
        .Column("Last Date", 12)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 6px; }\n" +
            "table.sheet-table tr.r-header th { border: 1px solid #ccc; border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-data td { border: 1px solid #ccc; }");

    table.MetaRow(
        Fmt.Labeled("Branch Name :", branchName),
        Fmt.Join(Fmt.Labeled("Till Date :", tillDate), Fmt.Labeled("Due Period :", $"{duePeriod} {duePeriodUnit}")),
        5);
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    table.Header();

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            (++sn).ToString(),
            NullDisplay(row.MemberId),
            NullDisplay(row.MemberName),
            Convert.ToString(row.Age) ?? "",
            NullDisplay(row.Address),
            NullDisplay(row.ContactNo),
            NullDisplay(row.Type),
            NullDisplay(row.AccountNo),
            FormatAmount(row.Balance),
            NullDisplay(row.LastTransactionDate));
    }

    if (rows.Count > 0)
        table.Total($"Total Records: {totalRecords}", 8, FormatAmount(totalBalance), "");
}
@await Html.PartialAsync("_SheetReport", table.Build())