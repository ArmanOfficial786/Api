@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    const int ColumnCount = 13;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    bool Flag(string key) => Model.TryGetValue(key, out var fv) && fv is bool b && b;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string NullDisplay(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "-" : value.ToString()!;
    string FormatAmount(decimal amt) => amt == 0 ? "-" : amt.ToString("N2");

    string GetOrderByDisplay(string value) => value switch
    {
        "MemberId" => "Member ID",
        "MemberName" => "Member Name",
        "Address" => "Address",
        "ShareAmount DESC" => "Share Amount",
        "NormalSaving DESC" => "Normal Saving",
        "RecurringSaving DESC" => "Recurring Saving",
        "FixedSaving DESC" => "Fixed Saving",
        "TermSaving DESC" => "Term Saving",
        "DoubleDeposit DESC" => "Double Deposit",
        "RegularSaving DESC" => "Regular Saving",
        "TotalSaving DESC" => "Total Saving",
        "LoanAmount DESC" => "Loan Amount",
        _ => value
    };

    var rows = (Model["Rows"] as List<MemberSummaryRowDto>) ?? new List<MemberSummaryRowDto>();
    var typeTotals = Model.TryGetValue("SavingTypeTotals", out var stt) ? stt as Dictionary<string, decimal> : null;

    decimal TypeTotal(string key, Func<MemberSummaryRowDto, decimal> selector)
    {
        var dv = typeTotals != null && typeTotals.TryGetValue(key, out var v) ? v : 0m;
        return dv != 0 ? dv : rows.Sum(selector);
    }

    var tillDate = Text("TillDate");
    var branchName = Text("BranchName");
    var orderBy = Text("OrderBy", "Member Id");
    var enableCollectionCenterGroup = Flag("EnableCollectionCenterGroup");
    var enableMemberGroupGroup = Flag("EnableMemberGroupGroup");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalShareAmount = TotalOr("TotalShareAmount", rows.Sum(r => r.ShareAmount));
    var totalSaving = TotalOr("TotalSaving", rows.Sum(r => r.TotalSaving));
    var totalLoan = TotalOr("TotalLoan", rows.Sum(r => r.LoanAmount));

    var table = new ReportTable(Model, title: "Member Summary Report", sheetName: "MemberSummaryReport")
        .Column("SN", 5, Align.Center)
        .Column("Member Id", 12)
        .Column("Member Name", 18)
        .Column("Address", 15)
        .Column("Share", 8, Align.Right)
        .Column("Normal", 8, Align.Right)
        .Column("Recurring", 8, Align.Right)
        .Column("Fixed", 8, Align.Right)
        .Column("Term", 8, Align.Right)
        .Column("Double", 8, Align.Right)
        .Column("Regular", 8, Align.Right)
        .Column("Total Saving", 10, Align.Right)
        .Column("Loan", 10, Align.Right)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            GroupBackground = "#e8e8e8",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 3px 5px; }\n" +
            "table.sheet-table tr.r-header th { border: 1px solid #ddd; border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-group td { border: 1px solid #ddd; border-top: 2px solid #666; }\n" +
            "table.sheet-table tr.r-data td { border: 1px solid #ddd; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(
        Fmt.Join(Fmt.Labeled("Report Generated On :", generatedOn), Fmt.Labeled("Till Date :", tillDate)),
        Fmt.Labeled("Order By :", GetOrderByDisplay(orderBy))));
    table.MetaRow(Fmt.Join(
        Fmt.Labeled("Group By Collection Center :", enableCollectionCenterGroup ? "Yes" : "No"),
        Fmt.Labeled("Group By Member Group :", enableMemberGroupGroup ? "Yes" : "No")));

    table.Header();

    var sn = 0;
    void AddRows(IEnumerable<MemberSummaryRowDto> items)
    {
        foreach (var row in items)
        {
            table.Data(
                ReportCell.Center((++sn).ToString()),
                ReportCell.Left(NullDisplay(row.MemberId)),
                ReportCell.Left(NullDisplay(row.MemberName)),
                ReportCell.Left(NullDisplay(row.Address)),
                ReportCell.Right(FormatAmount(row.ShareAmount)),
                ReportCell.Right(FormatAmount(row.NormalSaving)),
                ReportCell.Right(FormatAmount(row.RecurringSaving)),
                ReportCell.Right(FormatAmount(row.FixedSaving)),
                ReportCell.Right(FormatAmount(row.TermSaving)),
                ReportCell.Right(FormatAmount(row.DoubleDeposit)),
                ReportCell.Right(FormatAmount(row.RegularSaving)),
                ReportCell.Right(FormatAmount(row.TotalSaving)),
                ReportCell.Right(FormatAmount(row.LoanAmount)));
        }
    }

    if (enableCollectionCenterGroup)
    {
        foreach (var centerGroup in rows.GroupBy(r => r.CollectionCenter ?? "Unknown"))
        {
            if (enableMemberGroupGroup)
            {
                foreach (var group in centerGroup.GroupBy(r => r.MemberGroup ?? "Unknown"))
                {
                    table.GroupTitle($"{centerGroup.Key} - {group.Key}");
                    AddRows(group);
                }
            }
            else
            {
                table.GroupTitle(centerGroup.Key);
                AddRows(centerGroup);
            }
        }
    }
    else if (enableMemberGroupGroup)
    {
        foreach (var group in rows.GroupBy(r => r.MemberGroup ?? "Unknown"))
        {
            table.GroupTitle(group.Key);
            AddRows(group);
        }
    }
    else
    {
        AddRows(rows);
    }

    if (rows.Count > 0)
    {
        table.Total(
            $"Grand Total ({totalRecords})", 4,
            FormatAmount(totalShareAmount),
            FormatAmount(TypeTotal("NormalSaving", r => r.NormalSaving)),
            FormatAmount(TypeTotal("RecurringSaving", r => r.RecurringSaving)),
            FormatAmount(TypeTotal("FixedSaving", r => r.FixedSaving)),
            FormatAmount(TypeTotal("TermSaving", r => r.TermSaving)),
            FormatAmount(TypeTotal("DoubleDeposit", r => r.DoubleDeposit)),
            FormatAmount(TypeTotal("RegularSaving", r => r.RegularSaving)),
            FormatAmount(totalSaving),
            FormatAmount(totalLoan));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())