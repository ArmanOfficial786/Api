@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 6;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    string NullDisplay(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    var rows = (Model["Rows"] as List<SMSCategoryRowDto>) ?? new List<SMSCategoryRowDto>();

    var branchName = Text("BranchName");
    var smsCategoryId = Text("SmsCategoryId");
    var smsCategoryLabel = string.IsNullOrWhiteSpace(smsCategoryId) || smsCategoryId == "-1"
        ? "All SMS Criteria"
        : smsCategoryId;
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null ? Convert.ToInt32(tr) : 0;
    if (totalRecords == 0) totalRecords = rows.Count;

    var groups = rows
        .GroupBy(r => string.IsNullOrWhiteSpace(r.DepositTypeName) ? "-" : r.DepositTypeName!)
        .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
        .ToList();

    var table = new ReportTable(Model, title: "SMS Category Report", sheetName: "SMSCategory")
        .Column("Savings Type", 16)
        .Column("Member ID", 14)
        .Column("Member Name", 20)
        .Column("A/C No", 14)
        .Column("A/C Open Date", 14)
        .Column("SMS Criteria", 22)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 1px solid #999; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }\n" +
            "table.sheet-table tr.r-total td { border-top: 2px solid #000; border-bottom: 0; }");

    table.MetaRow(
        Fmt.Labeled("Report Generated On:", generatedOn),
        Fmt.Labeled("SMS Criteria :", smsCategoryLabel),
        3);
    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));

    foreach (var group in groups)
    {
        table.GroupBy(
            ReportCell.Left(group.Key),
            ReportCell.Left("", ColumnCount - 1));

        foreach (var row in group)
        {
            table.Data(
                "",
                NullDisplay(row.MemberId),
                NullDisplay(row.MemberName),
                NullDisplay(row.AccountNo),
                NullDisplay(row.DateOfAccountOpen),
                NullDisplay(row.SMSCriteria));
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Total Records", ColumnCount - 1, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())