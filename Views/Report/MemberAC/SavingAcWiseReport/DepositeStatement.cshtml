@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    bool Flag(string key, bool fallback) => Model.TryGetValue(key, out var fv) && fv is bool b ? b : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string NullDisplay(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "" : value.ToString()!;

    var rows = (Model["Rows"] as List<DepositStatementRowDto>) ?? new List<DepositStatementRowDto>();
    var memberDetail = Model.TryGetValue("MemberDetail", out var md) ? md as DepositStatementMemberDetailDto : null;

    var openingBalance = Dec("OpeningBalance");
    var closingBalance = Dec("ClosingBalance");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var accountNo = Text("AccountNo");
    var entryBy = Flag("EntryBy", false);
    var enableBillNumber = Flag("EnableBillNumber", false);
    var showValueDate = Flag("ValueDate", true);
    var verifiedTillBs = Text("VerifiedTillBs");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var isNepali = Text("Language") == "Nepali";

    var locale = new
    {
        ReportTitle = isNepali ? "निक्षेप विवरण प्रतिवेदन" : "Deposit Statement Report",
        ReportGeneratedOn = isNepali ? "प्रतिवेदन जारी मिति" : "Report Generated On",
        StatementBetween = isNepali ? "निक्षेप विवरण अवधि" : "Deposit Statement Between",

        MemberId = isNepali ? "सदस्य नं" : "Member Id",
        MemberName = isNepali ? "सदस्यको नाम" : "Member Name",
        MemberAddress = isNepali ? "सदस्यको ठेगाना" : "Member Address",
        AcNo = isNepali ? "खाता नं" : "A/C No",
        AcType = isNepali ? "खाताको किसिम" : "A/C Type",
        PhoneNo = isNepali ? "फोन नं" : "Phone No",
        InterestRate = isNepali ? "ब्याज दर" : "Interest Rate",
        AcOpenedDate = isNepali ? "खाता खोलेको मिति" : "A/C Opened Date",
        OpeningBalance = isNepali ? "सुरु मौज्दात" : "Opening Balance",

        SNo = isNepali ? "क्र.सं" : "S.No",
        DateEng = isNepali ? "मिति" : "DateEng",
        ValueDate = isNepali ? "मूल्य मिति" : "Value Date",
        Description = isNepali ? "विवरण" : "Description",
        BillNo = isNepali ? "बिल नं" : "Bill No",
        Withdrawal = isNepali ? "झिकुवा" : "Withdrawal",
        Deposit = isNepali ? "जम्मा" : "Deposit",
        Balance = isNepali ? "मौज्दात" : "Balance",
        EntryBy = isNepali ? "प्रविष्ट गर्ने" : "Entry By",

        Total = isNepali ? "जम्मा :" : "Total :",
        TransactionSummary = isNepali ? "कारोबार सारांश" : "Transaction Summary",
        ClosingBalance = isNepali ? "अन्तिम मौज्दात" : "Closing Balance",

        VerifiedTill = isNepali ? "पासबुक प्रमाणित मिति सम्म" : "Passbook Verified Till",
        NoVerification = isNepali ? "प्रमाणित मिति उपलब्ध छैन" : "No Verification Till Date"
    };

    var columnCount = 6 + (showValueDate ? 1 : 0) + (enableBillNumber ? 1 : 0) + (entryBy ? 1 : 0);
    var leadColSpan = 2 + (showValueDate ? 1 : 0) + 1 + (enableBillNumber ? 1 : 0);

    var totalWithdraw = rows.Sum(r => r.Withdraw ?? 0);
    var totalDeposit = rows.Sum(r => r.Deposit ?? 0);

    var summarySpans = new int[4];
    for (var i = 0; i < 4; i++) summarySpans[i] = columnCount / 4 + (i < columnCount % 4 ? 1 : 0);

    var nepaliCss = isNepali
        ? "\ntable.sheet-table td, table.sheet-table th { font-family: 'Preeti', Arial, sans-serif; }"
        : "";

    var table = new ReportTable(Model, title: locale.ReportTitle, sheetName: "DepositStatement")
        .Column(locale.SNo, 5, Align.Center)
        .Column(locale.DateEng, 10);
    if (showValueDate) table.Column(locale.ValueDate, 10);
    table.Column(locale.Description, enableBillNumber ? 24 : 34);
    if (enableBillNumber) table.Column(locale.BillNo, 8);
    table.Column(locale.Withdrawal, 13, Align.Right)
         .Column(locale.Deposit, 13, Align.Right)
         .Column(locale.Balance, 13, Align.Right);
    if (entryBy) table.Column(locale.EntryBy, 12);

    table.Style(new ReportStyle
    {
        ZebraStripes = false,
        HeaderBackground = "#f2f2f2",
        GroupBackground = "#fff",
        TotalBackground = "#f9f9f9"
    })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 100)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-data td { border: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-group td { border: 0; }\n" +
            "table.sheet-table tr.r-group td.summary-title { text-align: center; font-size: 10pt; padding-top: 6px; }\n" +
            "table.sheet-table tr.r-group td.summary-head { border: 1px solid #000; background: #f2f2f2; text-align: center; padding: 5px 8px; }\n" +
            "table.sheet-table tr.r-data td.summary-cell { border: 1px solid #000; text-align: center; padding: 5px 8px; }" +
            nepaliCss);

    table.MetaRow(
        Fmt.Labeled(locale.ReportGeneratedOn + " :", generatedOn),
        Fmt.Labeled(locale.StatementBetween + " :", fromDate + " - " + toDate));
    table.MetaRow(
        Fmt.Labeled(locale.MemberId + " :", NullDisplay(memberDetail?.MemberId)),
        Fmt.Labeled(locale.AcNo + " :", accountNo));
    table.MetaRow(
        Fmt.Labeled(locale.MemberName + " :", NullDisplay(memberDetail?.MemberName)),
        Fmt.Labeled(locale.AcType + " :", NullDisplay(memberDetail?.DepositTypeName)));
    table.MetaRow(
        Fmt.Labeled(locale.MemberAddress + " :", NullDisplay(memberDetail?.Address)),
        Fmt.Labeled(locale.PhoneNo + " :", NullDisplay(memberDetail?.MobileNo)));
    table.MetaRow(
        Fmt.Labeled(locale.InterestRate + " :", memberDetail?.InterestRate?.ToString("N2") ?? ""),
        Fmt.Labeled(locale.AcOpenedDate + " :", NullDisplay(memberDetail?.AccountOpenDate)));
    table.MetaRow(Fmt.Labeled(locale.OpeningBalance + " :", openingBalance.ToString("N2")));

    var sn = 0;
    foreach (var row in rows)
    {
        var cells = new List<ReportCell>
        {
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left(NullDisplay(row.Date))
        };
        if (showValueDate) cells.Add(ReportCell.Left(NullDisplay(row.ValueDate)));
        cells.Add(ReportCell.Left(NullDisplay(row.Particulars)));
        if (enableBillNumber) cells.Add(ReportCell.Left(NullDisplay(row.BillNo)));
        cells.Add(ReportCell.Right(row.Withdraw > 0 ? row.Withdraw.Value.ToString("N2") : ""));
        cells.Add(ReportCell.Right(row.Deposit > 0 ? row.Deposit.Value.ToString("N2") : ""));
        cells.Add(ReportCell.Right(row.Balance.ToString("N2")));
        if (entryBy) cells.Add(ReportCell.Left(NullDisplay(row.EntryBy)));

        table.Data(cells.ToArray());
    }

    if (rows.Count > 0)
    {
        var totalValues = new List<string> { totalWithdraw.ToString("N2"), totalDeposit.ToString("N2"), "" };
        if (entryBy) totalValues.Add("");
        table.Total(locale.Total, leadColSpan, totalValues.ToArray());

        table.Spacer();
        table.GroupBy(new ReportCell(locale.TransactionSummary + " :", Align.Center, columnCount, "summary-title"));
        table.GroupBy(
            new ReportCell(locale.OpeningBalance, Align.Center, summarySpans[0], "summary-head"),
            new ReportCell(locale.Withdrawal, Align.Center, summarySpans[1], "summary-head"),
            new ReportCell(locale.Deposit, Align.Center, summarySpans[2], "summary-head"),
            new ReportCell(locale.ClosingBalance, Align.Center, summarySpans[3], "summary-head"));
        table.Data(
            new ReportCell(openingBalance.ToString("N2"), Align.Center, summarySpans[0], "summary-cell"),
            new ReportCell(totalWithdraw.ToString("N2"), Align.Center, summarySpans[1], "summary-cell"),
            new ReportCell(totalDeposit.ToString("N2"), Align.Center, summarySpans[2], "summary-cell"),
            new ReportCell(closingBalance.ToString("N2"), Align.Center, summarySpans[3], "summary-cell"));
    }

    table.Note(!string.IsNullOrEmpty(verifiedTillBs)
        ? $"{locale.VerifiedTill} : {verifiedTillBs}"
        : locale.NoVerification);
}
@await Html.PartialAsync("_SheetReport", table.Build())