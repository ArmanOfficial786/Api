@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string NullDisplay(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "" : value.ToString()!;
    string FormatAmount(decimal amount) => amount == 0 ? "0" : amount.ToString("N0");

    var rows = (Model["Rows"] as List<MemberAccountDetailNoRowDto>) ?? new List<MemberAccountDetailNoRowDto>();

    var tillDate = Text("TillDate");
    var branchName = Text("BranchName");
    var memberType = Text("MemberType", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalSaving = TotalOr("TotalSaving", rows.Sum(r => r.Saving));
    var totalShare = TotalOr("TotalShare", rows.Sum(r => r.Share));
    var totalLoan = TotalOr("TotalLoan", rows.Sum(r => r.Loan));

    var table = new ReportTable(Model, title: $"{memberType} Member List Report", sheetName: "MemberAccountDetailNo")
        .Column("SN", 5, Align.Center)
        .Column("MemberId", 12)
        .Column("Name", 20)
        .Column("Address", 18)
        .Column("Contact No", 18)
        .Column("Saving", 9, Align.Right)
        .Column("Share", 9, Align.Right)
        .Column("Loan", 9, Align.Right)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 6px; }\n" +
            "table.sheet-table tr.r-header th { border: 1px solid #ddd; border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-data td { border: 1px solid #ddd; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(Fmt.Labeled("Report Generated On :", generatedOn), Fmt.Labeled("Till Date :", tillDate)));

    table.Header();

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left(NullDisplay(row.MemberId)),
            ReportCell.Left(NullDisplay(row.Name)),
            ReportCell.Left(NullDisplay(row.Address)),
            ReportCell.Left(NullDisplay(row.ContactNo)),
            ReportCell.Right(FormatAmount(row.Saving)),
            ReportCell.Right(FormatAmount(row.Share)),
            ReportCell.Right(FormatAmount(row.Loan)));
    }

    if (rows.Count > 0)
        table.Total($"Total ({totalRecords})", 5, FormatAmount(totalSaving), FormatAmount(totalShare), FormatAmount(totalLoan));
}
@await Html.PartialAsync("_SheetReport", table.Build())