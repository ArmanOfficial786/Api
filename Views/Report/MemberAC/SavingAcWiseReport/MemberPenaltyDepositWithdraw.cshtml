@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string NullDisplay(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "" : value.ToString()!;
    string FormatAmount(decimal amt) => amt == 0 ? "" : amt.ToString("N2");

    var rows = (Model["Rows"] as List<MemberPenaltyDepositWithdrawRowDto>) ?? new List<MemberPenaltyDepositWithdrawRowDto>();

    var branchName = Text("BranchName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalPenalty = TotalOr("TotalPenalty", rows.Sum(r => r.PenaltyAmount));

    var table = new ReportTable(Model, title: "Member Penalty Report", sheetName: "MemberPenaltyReport")
        .Column("SN", 5, Align.Center)
        .Column("Member Id", 18)
        .Column("Member Name", 22)
        .Column("Address", 18)
        .Column("Contact", 22)
        .Column("Penalty", 15, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f0f0f0",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 7, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 4px 8px; }\n" +
            "table.sheet-table tr.r-header th { border: 1px solid #000; border-top: 2px solid #000; }\n" +
            "table.sheet-table tr.r-data td { border: 1px solid #000; border-bottom: 1px solid #ddd; }\n" +
            "table.sheet-table tr.r-total td { border-left: 1px solid #000; border-right: 1px solid #000; padding: 6px 8px; }");

    table.MetaRow(Fmt.Labeled("Branch Name:", branchName));
    table.MetaRow(Fmt.Labeled("Report Generated On:", generatedOn));

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left(NullDisplay(row.MemberId)),
            ReportCell.Left(NullDisplay(row.MemberName)),
            ReportCell.Left(NullDisplay(row.Address)),
            ReportCell.Left(NullDisplay(row.Contact)),
            ReportCell.Right(FormatAmount(row.PenaltyAmount)));
    }

    if (rows.Count > 0)
        table.Total("Total:", 5, FormatAmount(totalPenalty));
}
@await Html.PartialAsync("_SheetReport", table.Build())