@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string NullDisplay(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "" : value.ToString()!;
    string FormatAmount(decimal amt) => amt == 0 ? "" : amt.ToString("N2");

    var rows = (Model["Rows"] as List<DepositWithdrawMaxAmountRowDto>) ?? new List<DepositWithdrawMaxAmountRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName");
    var transactionTypeValue = Model.TryGetValue("TransactionTypeValue", out var tt) && tt != null ? Convert.ToInt32(tt) : 3;
    var amount = Model.TryGetValue("Amount", out var am) && am != null ? Convert.ToDecimal(am) : 0m;
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var reportTitle = transactionTypeValue switch
    {
        1 => "Deposit Maximum Detail Report",
        2 => "Withdraw Maximum Detail Report",
        _ => "Deposit/Withdraw Maximum Detail Report"
    };

    var showDepositCol = transactionTypeValue == 1 || transactionTypeValue == 3;
    var showWithdrawCol = transactionTypeValue == 2 || transactionTypeValue == 3;
    var columnCount = 4 + (showDepositCol ? 1 : 0) + (showWithdrawCol ? 1 : 0);

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalDeposit = TotalOr("TotalDeposit", rows.Sum(r => r.DepositAmount));
    var totalWithdraw = TotalOr("TotalWithdraw", rows.Sum(r => r.WithdrawAmount));

    var table = new ReportTable(Model, title: reportTitle, sheetName: "DepositWithdrawMaximumAmountRange")
        .Column("Member Id", 15)
        .Column("Member Name", 25)
        .Column("Account", 20);
    if (showDepositCol) table.Column("Deposit", 17, Align.Right);
    if (showWithdrawCol) table.Column("Withdraw", 17, Align.Right);
    table.Column("Date", 16);

    table.Style(new ReportStyle
    {
        ZebraStripes = false,
        HeaderBackground = "#f2f2f2",
        GroupBackground = "#fff",
        TotalBackground = "#f9f9f9"
    })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 6px; }\n" +
            "table.sheet-table tr.r-header th { border: 1px solid #ddd; border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-group td { border: 1px solid #ddd; border-bottom: 0; padding-top: 8px; }\n" +
            "table.sheet-table tr.r-data td { border: 1px solid #ddd; border-top: 0; }\n" +
            "table.sheet-table tr.r-data td.particulars-text { padding-left: 15px; font-style: italic; color: #333; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(
        Fmt.Join(Fmt.Labeled("Report Generated On :", generatedOn), Fmt.Labeled("From Date :", fromDate)),
        Fmt.Join(Fmt.Labeled("To Date :", toDate), Fmt.Labeled("Amount :", FormatAmount(amount)))));

    string? lastMemberId = null;
    foreach (var row in rows)
    {
        if (row.MemberId != lastMemberId)
        {
            table.GroupBy(
                ReportCell.Left(NullDisplay(row.MemberId)),
                ReportCell.Left(NullDisplay(row.MemberName)),
                ReportCell.Left("", columnCount - 2));
            lastMemberId = row.MemberId;
        }

        var cells = new List<ReportCell>
        {
            ReportCell.Left(""),
            new ReportCell(NullDisplay(row.Particulars), Align.Left, 1, "particulars-text"),
            ReportCell.Left(NullDisplay(row.AccountNo))
        };
        if (showDepositCol) cells.Add(ReportCell.Right(FormatAmount(row.DepositAmount)));
        if (showWithdrawCol) cells.Add(ReportCell.Right(FormatAmount(row.WithdrawAmount)));
        cells.Add(ReportCell.Left(NullDisplay(row.TransactionDateBs)));

        table.Data(cells.ToArray());
    }

    if (rows.Count > 0)
    {
        var totalValues = new List<string>();
        if (showDepositCol) totalValues.Add(FormatAmount(totalDeposit));
        if (showWithdrawCol) totalValues.Add(FormatAmount(totalWithdraw));
        totalValues.Add("");
        table.Total($"Total ({totalRecords})", 3, totalValues.ToArray());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())