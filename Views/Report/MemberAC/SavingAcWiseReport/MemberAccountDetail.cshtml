@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.SavingAcWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    bool Flag(string key, bool fallback) => Model.TryGetValue(key, out var fv) && fv is bool b ? b : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string NullDisplay(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "" : value.ToString()!;
    string FormatAmount(decimal? amt) => (amt ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<MemberAccountDetailRowDto>) ?? new List<MemberAccountDetailRowDto>();
    var selectedColumns = (Model["SelectedColumns"] as IEnumerable<string>)?.ToList() ?? new List<string>();

    var tillDate = Text("TillDate");
    var branchName = Text("BranchName");
    var status = Text("Status");
    var orderBy = Text("OrderBy", "Member Name");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var enableCollectionCenterGroup = Flag("EnableCollectionCenterGroup", false);
    var enableMemberGroupGroup = Flag("EnableMemberGroupGroup", false);
    var enableSavingTypeGroup = Model.ContainsKey("EnableSavingTypeGroup")
        ? Flag("EnableSavingTypeGroup", true)
        : (!enableCollectionCenterGroup && !enableMemberGroupGroup);

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalDeposit = TotalOr("TotalDeposit", rows.Sum(r => r.Deposit ?? 0m));
    var totalWithdraw = TotalOr("TotalWithdraw", rows.Sum(r => r.Withdraw ?? 0m));
    var totalBalance = TotalOr("TotalBalance", rows.Sum(r => r.Balance ?? 0m));

    var allColumns = new List<(string Key, string Header, double Width, Func<MemberAccountDetailRowDto, string> Render)>
    {
        ("MemberId",                     "Member ID",             3.2, r => NullDisplay(r.MemberId)),
        ("Name",                         "Member Name",           5.3, r => NullDisplay(r.MemberName)),
        ("SavingAccountType",            "Saving Account",        4.3, r => NullDisplay(r.SavingAccountType)),
        ("AccountNo",                    "Account No.",           4.0, r => NullDisplay(r.AccountNo)),
        ("ContactNo",                    "Contact No",            3.8, r => NullDisplay(r.ContactNo)),
        ("BirthOnBS",                    "Birth On BS",           3.2, r => NullDisplay(r.BirthOnBS)),
        ("CitizenshipNo",                "Citizenship No",        3.8, r => NullDisplay(r.CitizenshipNo)),
        ("Father",                       "Father Name",           3.8, r => NullDisplay(r.FatherName)),
        ("Mother",                       "Mother Name",           3.8, r => NullDisplay(r.MotherName)),
        ("Spouse",                       "Spouse Name",           3.8, r => NullDisplay(r.SpouseName)),
        ("TemporaryAddress",             "Temporary Address",     5.0, r => NullDisplay(r.TemporaryAddress)),
        ("PermanentAddess",              "Permanent Address",     5.0, r => NullDisplay(r.PermanentAddress)),
        ("RegisteredOn",                 "Registration On",       3.1, r => NullDisplay(r.RegisteredOn)),
        ("AccountOpenOn",                "Acc. Open on",          3.2, r => NullDisplay(r.AccountOpenOn)),
        ("MatureDate",                   "Mature Date",           3.2, r => NullDisplay(r.MatureDate)),
        ("InterestTransferType",         "Int. transfer type",    3.8, r => NullDisplay(r.InterestTransferType)),
        ("InterestRate",                 "Int. rate",             2.7, r => FormatAmount(r.InterestRate)),
        ("TaxRate",                      "Tax Rate",              2.7, r => FormatAmount(r.TaxRate)),
        ("InterestTransferAccount",      "Int. transfer Account", 3.8, r => NullDisplay(r.InterestTransferAccount)),
        ("GuaranteeAmount",              "Guarantee Amt.",        3.4, r => FormatAmount(r.GuaranteeAmount)),
        ("TermDepositInstallmentAmount", "Installment Amt.",      3.4, r => FormatAmount(r.InstallmentAmount)),
        ("DueCount",                     "Due Count",             2.5, r => NullDisplay(r.DueCount)),
        ("InstallmentType",              "Installment Type",      3.4, r => NullDisplay(r.InstallmentType)),
        ("FreezeAmount",                 "Freeze Amt.",           3.4, r => FormatAmount(r.FreezeAmount)),
        ("Deposit",                      "Deposit",               3.8, r => FormatAmount(r.Deposit)),
        ("Withdraw",                     "Withdraw",              3.8, r => FormatAmount(r.Withdraw)),
        ("Balance",                      "Balance",               3.8, r => FormatAmount(r.Balance))
    };

    var columns = selectedColumns.Count == 0
        ? allColumns
        : allColumns.Where(c => selectedColumns.Contains(c.Key, StringComparer.OrdinalIgnoreCase)).ToList();

    var totalCols = columns.Count + 1;

    var table = new ReportTable(Model, title: "Member Account Detail Report", sheetName: "MemberAccountDetailReport")
        .Column("S.N.", 1.0, Align.Center);
    foreach (var col in columns) table.Column(col.Header, col.Width);

    table.NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.3; padding: 3px 4px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 1.5px solid #000; border-bottom: 1px solid #000; font-size: 6.8pt; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { border-top: 1.5px solid #000; border-bottom: 1px solid #000; padding: 5px 4px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #e0e0e0; }\n" +
            "table.sheet-table tr.r-total td { border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; text-align: left !important; }");

    ReportCell[] GroupHeaderCells(string groupLabel, string? groupValue, List<MemberAccountDetailRowDto> groupRows)
    {
        var value = string.IsNullOrWhiteSpace(groupValue) ? "Unknown" : groupValue;
        var texts = new[]
        {
            $"No.of Saving Acc.: {groupRows.Count}",
            $"{groupLabel} : {value}",
            $"Deposit: {FormatAmount(groupRows.Sum(r => r.Deposit ?? 0m))}",
            $"Withdraw: {FormatAmount(groupRows.Sum(r => r.Withdraw ?? 0m))}",
            $"Balance: {FormatAmount(groupRows.Sum(r => r.Balance ?? 0m))}"
        };

        if (totalCols < 5)
            return new[] { ReportCell.Left(string.Join("  |  ", texts), totalCols) };

        var spans = new int[5];
        if (totalCols >= 11)
        {
            spans = new[] { 3, 2, 2, 2, 2 };
        }
        else
        {
            for (var i = 0; i < 5; i++) spans[i] = totalCols / 5 + (i < totalCols % 5 ? 1 : 0);
        }

        var cells = new List<ReportCell>();
        for (var i = 0; i < 5; i++)
            cells.Add(i < 2 ? ReportCell.Left(texts[i], spans[i]) : ReportCell.Right(texts[i], spans[i]));
        if (totalCols > 11) cells.Add(ReportCell.Left("", totalCols - 11));
        return cells.ToArray();
    }

    var sn = 0;
    void AddRows(IEnumerable<MemberAccountDetailRowDto> items)
    {
        foreach (var row in items)
        {
            var values = new List<string> { (++sn).ToString() };
            foreach (var col in columns) values.Add(col.Render(row));
            table.Data(values.ToArray());
        }
    }

    table.MetaRow(Fmt.Join(Fmt.Join(Fmt.Labeled("Branch Name :", branchName), Fmt.Labeled("Till Date :", tillDate)), Fmt.Labeled("Status :", status)));
    table.MetaRow(Fmt.Join(
        Fmt.Join(Fmt.Labeled("Report Generated On :", generatedOn), Fmt.Labeled("Order By :", orderBy)),
        Fmt.Labeled("Group By :", enableCollectionCenterGroup || enableMemberGroupGroup || enableSavingTypeGroup ? "Yes" : "No")));

    table.Header();

    if (enableCollectionCenterGroup)
    {
        foreach (var centerGrp in rows.GroupBy(r => r.CollectionCenter ?? "Unknown"))
        {
            if (enableMemberGroupGroup)
            {
                foreach (var grp in centerGrp.GroupBy(r => r.MemberGroup ?? "Unknown"))
                {
                    table.GroupBy(GroupHeaderCells("Group", centerGrp.Key + " - " + grp.Key, grp.ToList()));
                    AddRows(grp);
                }
            }
            else
            {
                table.GroupBy(GroupHeaderCells("Collection Center", centerGrp.Key, centerGrp.ToList()));
                AddRows(centerGrp);
            }
        }
    }
    else if (enableMemberGroupGroup)
    {
        foreach (var grp in rows.GroupBy(r => r.MemberGroup ?? "Unknown"))
        {
            table.GroupBy(GroupHeaderCells("Member Group", grp.Key, grp.ToList()));
            AddRows(grp);
        }
    }
    else if (enableSavingTypeGroup)
    {
        foreach (var grp in rows.GroupBy(r => r.SavingAccountType ?? "Unknown"))
        {
            table.GroupBy(GroupHeaderCells("Saving Type", grp.Key, grp.ToList()));
            AddRows(grp);
        }
    }
    else
    {
        AddRows(rows);
    }

    if (rows.Count > 0)
    {
        table.Total($"Total Records : {totalRecords}", totalCols);
        if (columns.Any(c => c.Key == "Deposit"))
            table.Total($"Total Deposit : {FormatAmount(totalDeposit)}", totalCols);
        if (columns.Any(c => c.Key == "Withdraw"))
            table.Total($"Total Withdraw : {FormatAmount(totalWithdraw)}", totalCols);
        if (columns.Any(c => c.Key == "Balance"))
            table.Total($"Total Balance : {FormatAmount(totalBalance)}", totalCols);
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())