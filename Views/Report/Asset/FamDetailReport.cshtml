@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Asset
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    bool Flag(string key, bool fallback) => Model.TryGetValue(key, out var fv) && fv is bool b ? b : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a missing amount prints blank (same as before); totals always print two decimals
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";
    // quantities may be any numeric type; a missing one prints blank
    string Q(object? v) => v?.ToString() ?? "";

    // one cell with full control (span, alignment, css)
    ReportCell C(string t, int span = 1, Align a = Align.Left, string? css = null) => new(t, a, span, css);

    var rows = (Model["Rows"] as List<FamDetailReportRowDto>) ?? new List<FamDetailReportRowDto>();
    var summary = (Model["Summary"] as List<FamDetailReportSummaryDto>) ?? new List<FamDetailReportSummaryDto>();

    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var categoryName = Text("CategoryName", "All");
    var assetName = Text("AssetName", "All");
    var reportType = Text("ReportType", "ASSET");
    var isTypeWise = Flag("IsTypeWise", false);
    var isSummary = Flag("IsSummary", true);
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isAsset = reportType == "ASSET";
    var reportTitle = isAsset ? "Assets Detail Report" : "Stock Detail Report";
    var showSummaryTable = isSummary && !isTypeWise && summary.Any();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.Amount ?? 0m));

    var table = new ReportTable(Model, title: reportTitle, sheetName: "FamDetailReport")
        .Column("S.N.", 4, Align.Center)
        .Column("Code", 9)
        .Column("Asset Name", 16)
        .Column("Transaction Type", 10)
        .Column("Amount", 9, Align.Right)
        .Column("Date", 10)
        .Column("Purchase Status", 10)
        .Column("Verified To", 10)
        .Column("Transfer Out", 10)
        .Column("Transfer In / Clearance", 12)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            SectionBackground = "#fff",
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 10, firstPageExtraMm: 80)   // column titles may wrap to two lines
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }" +
            // column titles may wrap and sit at the bottom of the cell, as in the old report
            "table.sheet-table tr.r-header th { white-space: normal; line-height: 1.2; vertical-align: bottom; }" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #ccc; }" +
            // serial number in grey
            "table.sheet-table tr.r-data td:first-child { color: #555; }" +
            // "Summary" title: bold, underlined, no bar
            "table.sheet-table tr.r-section td { background: #fff; border: 0; font-size: 11pt; text-decoration: underline; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(
        Fmt.Labeled("Till Date :", toDate),
        Fmt.Labeled("Category :", categoryName),
        Fmt.Labeled("Asset :", assetName),
        Fmt.Labeled("Mode :", isTypeWise ? "Type Wise" : (isSummary ? "Summary" : "Detail"))));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // ── detail rows ──
    var sn = 0;
    foreach (var row in rows)
    {
        sn++;
        table.Data(
            sn.ToString(),
            row.Code ?? "",
            row.FixedAssetsName ?? "",
            row.TransactionType ?? "",
            N(row.Amount),
            row.TransactionDateBS ?? "",
            row.PurchaseStatus ?? "",
            row.VerifiedTo ?? "",
            row.TransferredOut ?? "",
            !string.IsNullOrEmpty(row.TransferredIn) ? row.TransferredIn : (row.Clearance ?? ""));
    }

    // label spans the first 4 columns; the amount fills column 5, the other 5 columns stay empty
    if (rows.Count > 0)
    {
        table.Total("Total Records: " + totalRecords, 4, totalAmount.ToString("N2"), "", "", "", "", "");
    }

    // ── summary table (only for the summary mode, not type wise) ──
    if (showSummaryTable)
    {
        table.Spacer();
        table.Section("Summary");
        table.Header(
            C("S.N.", 1, Align.Center),
            C("Asset Name", 2),
            C("Purchased", 1, Align.Right),
            C("Verified", 1, Align.Right),
            C("Transfer Out", 1, Align.Right),
            C("Transfer In", 1, Align.Right),
            C("Clearance", 1, Align.Right),
            C("Balance", 1, Align.Right),
            C(""));

        var ssn = 0;
        foreach (var s in summary)
        {
            ssn++;
            table.Data(
                C(ssn.ToString(), 1, Align.Center),
                C(s.FixedAssetsName ?? "", 2),
                C(Q(s.PurchaseStatusQty), 1, Align.Right),
                C(Q(s.VerifiedToQty), 1, Align.Right),
                C(Q(s.TransferredOutQty), 1, Align.Right),
                C(Q(s.TransferredInQty), 1, Align.Right),
                C(Q(s.ClearanceQty), 1, Align.Right),
                C(Q(s.Balance), 1, Align.Right),
                C(""));
        }
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())