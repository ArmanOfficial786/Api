@using NexgenCosysReport.Dtos.RequestDtos.Asset

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<FamDepreciationReportRowDto>) ?? new List<FamDepreciationReportRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalPurchaseAmt = Model.ContainsKey("TotalPurchaseAmt") ? (Model["TotalPurchaseAmt"] as decimal? ?? 0) : 0;
    var totalDepreciationAmt = Model.ContainsKey("TotalDepreciationAmt") ? (Model["TotalDepreciationAmt"] as decimal? ?? 0) : 0;
    var totalNewAssetValue = Model.ContainsKey("TotalNewAssetValue") ? (Model["TotalNewAssetValue"] as decimal? ?? 0) : 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Depreciation Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                text-align: left;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
            }

            .detail-row td {
                border-bottom: 1px solid #ccc;
            }

            .sn-col {
                text-align: center;
                color: #555;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="FamDepreciationReport">
            <colgroup>
                <col style="width:4%;" />
                <col style="width:10%;" />
                <col style="width:16%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:10%;" />
                <col style="width:7%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:8%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="11">Depreciation Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="11"><strong>Branch Name :</strong> @branchName</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="11">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <strong>Till Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="11"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="11"></td></tr>

                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Code</th>
                    <th>Asset Name</th>
                    <th>Purchase Date</th>
                    <th class="text-right">Purchase Amt</th>
                    <th>Method</th>
                    <th class="text-right">%</th>
                    <th>Depreciation On</th>
                    <th class="text-right">Prev Asset Value</th>
                    <th class="text-right">Depreciation Amt</th>
                    <th class="text-right">New Asset Value</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="detail-row">
                            <td class="sn-col">@sn</td>
                            <td>@(row.Code ?? "")</td>
                            <td>@(row.FixedAssetsName ?? "")</td>
                            <td>@(row.PurchaseDateOnBs ?? "")</td>
                            <td class="text-right">@(row.PurchaseAmt?.ToString("N2") ?? "")</td>
                            <td>@(row.MethodName ?? "")</td>
                            <td class="text-right">@(row.Percentage?.ToString("N2") ?? "")</td>
                            <td>@(row.DepreciationOnBs ?? "")</td>
                            <td class="text-right">@(row.PrevAssetValue?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.DepreciationAmt?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.NewAssetValue?.ToString("N2") ?? "")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">
                            Total Records: @totalRecords
                        </td>
                        <td class="text-right">@totalPurchaseAmt.ToString("N2")</td>
                        <td colspan="3"></td>
                        <td class="text-right">@totalDepreciationAmt.ToString("N2")</td>
                        <td class="text-right">@totalNewAssetValue.ToString("N2")</td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>