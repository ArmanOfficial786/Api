@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Asset
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a missing amount prints blank (same as before); totals always print two decimals
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<FamDepreciationReportRowDto>) ?? new List<FamDepreciationReportRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalPurchaseAmt = TotalOr("TotalPurchaseAmt", rows.Sum(r => r.PurchaseAmt ?? 0m));
    var totalDepreciationAmt = TotalOr("TotalDepreciationAmt", rows.Sum(r => r.DepreciationAmt ?? 0m));
    var totalNewAssetValue = TotalOr("TotalNewAssetValue", rows.Sum(r => r.NewAssetValue ?? 0m));

    var table = new ReportTable(Model, title: "Depreciation Report", sheetName: "FamDepreciationReport")
        .Column("S.N.", 4, Align.Center)
        .Column("Code", 10)
        .Column("Asset Name", 16)
        .Column("Purchase Date", 9)
        .Column("Purchase Amt", 9, Align.Right)
        .Column("Method", 10)
        .Column("%", 7, Align.Right)
        .Column("Depreciation On", 9)
        .Column("Prev Asset Value", 9, Align.Right)
        .Column("Depreciation Amt", 9, Align.Right)
        .Column("New Asset Value", 8, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 10, firstPageExtraMm: 75)   // column titles may wrap to two lines
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }" +
            // column titles may wrap and sit at the bottom of the cell, as in the old report
            "table.sheet-table tr.r-header th { white-space: normal; line-height: 1.2; vertical-align: bottom; }" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #ccc; }" +
            // serial number in grey
            "table.sheet-table tr.r-data td:first-child { color: #555; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("Till Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // ── rows ──
    var sn = 0;
    foreach (var row in rows)
    {
        sn++;
        table.Data(
            sn.ToString(),
            row.Code ?? "",
            row.FixedAssetsName ?? "",
            row.PurchaseDateOnBs ?? "",
            N(row.PurchaseAmt),
            row.MethodName ?? "",
            N(row.Percentage),
            row.DepreciationOnBs ?? "",
            N(row.PrevAssetValue),
            N(row.DepreciationAmt),
            N(row.NewAssetValue));
    }

    // label spans the first 4 columns; the 7 values fill columns 5 to 11 (empty text where a column has no total)
    if (rows.Count > 0)
    {
        table.Total("Total Records: " + totalRecords, 4,
            totalPurchaseAmt.ToString("N2"),     // Purchase Amt
            "", "", "",                          // Method, %, Depreciation On
            "",                                  // Prev Asset Value
            totalDepreciationAmt.ToString("N2"), // Depreciation Amt
            totalNewAssetValue.ToString("N2"));  // New Asset Value
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())