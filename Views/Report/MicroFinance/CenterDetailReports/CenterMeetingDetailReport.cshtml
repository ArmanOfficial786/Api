@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.CenterDetailReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<CenterMeetingDetailRowDto>) ?? new List<CenterMeetingDetailRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var collectionCenterName = Text("CollectionCenterName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isCollectionCenterFiltered = !string.IsNullOrEmpty(collectionCenterName);
    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);

    var table = new ReportTable(Model, title: "Center Meeting Detail Report", sheetName: "CenterMeetingDetail")
        .Column("SN", 6)
        .Column("Center Code", 12)
        .Column("Center Name", 20)
        .Column("Meeting Date", 24)
        .Column("Changed Meeting Date", 22)
        .Column("Collector Name", 16)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 7, headerMm: 8, firstPageExtraMm: 75)   // rows are a little taller than the other reports (5 px padding)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ font-size: " + fontSize + "; line-height: 1.35; padding: 3px 6px; vertical-align: top; }" +
            "table.sheet-table tr.r-header th { vertical-align: middle; }" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }" +
            // total line
            "table.sheet-table td.tt { font-weight: bold; background: #f9f9f9 !important; border-top: 2px solid #000 !important; border-bottom: 2px solid #000 !important; }");

    // ── title block ──
    // the center is shown next to the branch only when a center is selected
    table.MetaRow(isCollectionCenterFiltered
        ? Fmt.Join(Fmt.Labeled("Branch Name :", branchName), Fmt.Labeled("Center :", collectionCenterName))
        : Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        leftSpan: 2);

    // ── rows ──
    var sn = 0;
    foreach (var row in rows)
    {
        sn++;
        table.Data(
            sn.ToString(),
            row.CenterCode ?? "",
            row.CenterName ?? "",
            row.MeetingDate ?? "",
            row.ChangedDate ?? "",
            row.CollectorName ?? "");
    }

    // label spans the first 5 columns, right-aligned; the count is centred in the last column (same as before)
    if (rows.Count > 0)
    {
        table.Data(
            new ReportCell("Total Records", Align.Right, 5, "tt"),
            new ReportCell(totalRecords.ToString(), Align.Center, 1, "tt"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())