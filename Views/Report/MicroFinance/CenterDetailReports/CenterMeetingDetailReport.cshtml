@* Views/Report/Microfinance/CenterDetailReports/CenterMeetingDetailReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.CenterDetailReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<CenterMeetingDetailRowDto>) ?? new List<CenterMeetingDetailRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isCollectionCenterFiltered = !string.IsNullOrEmpty(collectionCenterName);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Center Meeting Detail Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 5px 6px;
                    vertical-align: top;
                    line-height: 1.35;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                vertical-align: middle;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="CenterMeetingDetail">
            <colgroup>
                <col style="width:6%;" />
                <col style="width:12%;" />
                <col style="width:20%;" />
                <col style="width:24%;" />
                <col style="width:22%;" />
                <col style="width:16%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="6">Center Meeting Detail Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="6">
                        <strong>Branch Name :</strong> @branchName
                        @if (isCollectionCenterFiltered)
                        {
                            <text>&nbsp;&nbsp;&nbsp;<strong>Center :</strong> @collectionCenterName</text>
                        }
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="6"></td></tr>

                <tr class="meta-row">
                    <td colspan="2"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="4" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="6"></td></tr>

                <tr>
                    <th>SN</th>
                    <th>Center Code</th>
                    <th>Center Name</th>
                    <th>Meeting Date</th>
                    <th>Changed Meeting Date</th>
                    <th>Collector Name</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="detail-row">
                            <td>@sn</td>
                            <td>@(row.CenterCode ?? "")</td>
                            <td>@(row.CenterName ?? "")</td>
                            <td>@(row.MeetingDate ?? "")</td>
                            <td>@(row.ChangedDate ?? "")</td>
                            <td>@(row.CollectorName ?? "")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="5" class="text-right">Total Records</td>
                        <td class="text-center">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>