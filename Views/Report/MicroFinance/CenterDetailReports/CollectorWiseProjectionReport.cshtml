@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.CenterDetailReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<CollectorWiseProjectionRowDto>) ?? new List<CollectorWiseProjectionRowDto>();

    var totalMemberProjection = Model["TotalMemberProjection"] as int? ?? 0;
    var totalMThisMAdd = Model["TotalMThisMAdd"] as int? ?? 0;
    var totalMUptoThisMAdd = Model["TotalMUptoThisMAdd"] as int? ?? 0;
    var totalMUptoThisMRemove = Model["TotalMUptoThisMRemove"] as int? ?? 0;
    var totalLoanProjection = Model["TotalLoanProjection"] as decimal? ?? 0;
    var totalLUptoThisMAdd = Model["TotalLUptoThisMAdd"] as decimal? ?? 0;
    var totalLUptoThisMProjected = Model["TotalLUptoThisMProjected"] as decimal? ?? 0;
    var totalBalanceLoan = Model["TotalBalanceLoan"] as decimal? ?? 0;
    var totalCenters = Model["TotalCenters"] as int? ?? 0;
    var totalMembers = Model["TotalMembers"] as int? ?? 0;

    var tillDateBs = Model["TillDate"]?.ToString() ?? "";
    var tillDateAd = Model.ContainsKey("TillDateAd") ? Model["TillDateAd"]?.ToString() ?? "" : "";
    var branchName = Model["BranchName"]?.ToString() ?? "All Branch";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // helpers
    Func<object?, decimal> D = o => Convert.ToDecimal(o ?? 0m);
    Func<object?, string> N0 = o => D(o).ToString("N0");
    Func<object?, string> N2 = o => D(o).ToString("N2");
    Func<decimal, decimal, string> Pct = (added, projected) =>
        projected == 0 ? "0" : Math.Round(added / projected * 100m, 0).ToString("N0");

    // Totals not supplied by the controller are summed here
    var totalSavingProjection = rows.Sum(r => D(r.SavingProjection));
    var totalSaUptoThisMAdd = rows.Sum(r => D(r.SaUptoThisMAdd));
    var totalShareProjection = rows.Sum(r => D(r.ShareProjection));
    var totalShUptoThisMAdd = rows.Sum(r => D(r.ShUptoThisMAdd));
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Collector Wise Projection Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Times New Roman", Times, serif;
                font-size: 6.5pt;
                background: #fff;
                color: #000;
            }

            .report-container {
                width: 100%;
            }

            .meta {
                width: 100%;
                font-family: Arial, sans-serif;
                font-size: 8pt;
                padding: 2px 4px 4px 4px;
            }

                .meta div {
                    padding: 1px 0;
                }

                .meta .lbl {
                    display: inline-block;
                    min-width: 110px;
                }

            .section-title {
                font-size: 9pt;
                font-weight: bold;
                text-align: center;
                border: 1px solid #000;
                border-bottom: none;
                padding: 3px 0;
            }

            .rpt {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                margin-bottom: 14px;
            }

                .rpt th, .rpt td {
                    border: 1px solid #000;
                    padding: 2px 2px;
                    font-size: 6.5pt;
                    line-height: 1.2;
                    vertical-align: middle;
                    /* wrap instead of overflow / overlap */
                    white-space: normal;
                    overflow-wrap: anywhere;
                    word-break: normal;
                    overflow: hidden;
                }

                .rpt th {
                    font-weight: bold;
                    text-align: center;
                    background: #fff;
                }

                .rpt td.num {
                    text-align: right;
                }

                .rpt td.ctr {
                    text-align: center;
                }

                .rpt td.name {
                    text-align: left;
                }

                .rpt tr.total td {
                    font-weight: bold;
                }

                .rpt thead {
                    display: table-row-group;
                }

                .rpt tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }

            @@media print {
                .rpt thead {
                    display: table-row-group;
                }

                .rpt tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="meta">
            <div><span class="lbl"><strong>Branch Name :</strong></span> @branchName</div>
            <div><span class="lbl"><strong>Till Date :</strong></span> @(string.IsNullOrEmpty(tillDateAd) ? tillDateBs : $"{tillDateAd} ( {tillDateBs} )")</div>
            <div><span class="lbl"><strong>Report Generated On :</strong></span> @generatedOn</div>
        </div>

        @* ═════════════════ TABLE 1 : MEMBER / LOAN PROJECTION ═════════════════ *@
        <div class="section-title">Member / Loan Projection</div>
        <table class="rpt" data-sheet-name="MemberLoanProjection">
            <colgroup>
                <col style="width:2.5%;" />
                <col style="width:12.5%;" />
                @for (int i = 0; i < 20; i++)
                {
                    <col style="width:3.8%;" />
                }
                <col style="width:9%;" />
            </colgroup>
            <thead>
                <tr>
                    <th rowspan="3">SNo</th>
                    <th rowspan="3">Staff's Name</th>
                    <th colspan="2" rowspan="2">Annual Projection</th>
                    <th colspan="9">Member</th>
                    <th colspan="7">Loan('000)</th>
                    <th colspan="2" rowspan="2">Total</th>
                    <th>('000)</th>
                </tr>
                <tr>
                    <th colspan="3">Upto Last Month</th>
                    <th colspan="3">This Month</th>
                    <th colspan="3">Upto This Month</th>
                    <th colspan="2">Upto Last Month</th>
                    <th colspan="2">This Month</th>
                    <th colspan="3">Upto This Month</th>
                    <th>Balance</th>
                </tr>
                <tr>
                    <th>Member</th>
                    <th>Loan</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Removed</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Removed</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Removed</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Progress</th>
                    <th>Centre</th>
                    <th>Member</th>
                    <th>Loan</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn1 = 0;
                    foreach (var row in rows)
                    {
                        sn1++;
                        <tr>
                            <td class="ctr">@sn1</td>
                            <td class="name">@(row.HurCollectorName ?? "")</td>

                            @* Annual projection *@
                            <td class="num">@N0(row.MemberProjection)</td>
                            <td class="num">@N0(row.LoanProjection)</td>

                            @* Member – Upto Last Month  (no DTO field yet) *@
                            <td class="num">0</td>
                            <td class="num">0</td>
                            <td class="num">0</td>
                            @* Member – This Month *@
                            <td class="num">0</td>
                            <td class="num">@N0(row.MThisMAdd)</td>
                            <td class="num">0</td>
                            @* Member – Upto This Month *@
                            <td class="num">0</td>
                            <td class="num">@N0(row.MUptoThisMAdd)</td>
                            <td class="num">@N0(row.MUptoThisMRemove)</td>

                            @* Loan – Upto Last Month (no DTO field yet) *@
                            <td class="num">0</td>
                            <td class="num">0</td>
                            @* Loan – This Month (no DTO field yet) *@
                            <td class="num">0</td>
                            <td class="num">0</td>
                            @* Loan – Upto This Month *@
                            <td class="num">@N0(row.LUptoThisMProjected)</td>
                            <td class="num">@N0(row.LUptoThisMAdd)</td>
                            <td class="num">@Pct(D(row.LUptoThisMAdd), D(row.LUptoThisMProjected))</td>

                            @* Total *@
                            <td class="ctr">@N0(row.TotalCenter)</td>
                            <td class="ctr">@N0(row.TotalMember)</td>

                            @* Balance *@
                            <td class="num">@N2(row.BalanceLoan)</td>
                        </tr>
                    }
                    <tr class="total">
                        <td colspan="2" class="num">Total:</td>
                        <td class="num">@N0(totalMemberProjection)</td>
                        <td class="num">@N0(totalLoanProjection)</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">@N0(totalMThisMAdd)</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">@N0(totalMUptoThisMAdd)</td>
                        <td class="num">@N0(totalMUptoThisMRemove)</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">@N0(totalLUptoThisMProjected)</td>
                        <td class="num">@N0(totalLUptoThisMAdd)</td>
                        <td class="num">@Pct(totalLUptoThisMAdd, totalLUptoThisMProjected)</td>
                        <td class="ctr">@totalCenters</td>
                        <td class="ctr">@totalMembers</td>
                        <td class="num">@N2(totalBalanceLoan)</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="23" class="ctr">No data found for the selected criteria</td></tr>
                }
            </tbody>
        </table>

        @* ═════════════════ TABLE 2 : SAVING / SHARE PROJECTION ═════════════════ *@
        <div class="section-title">Saving /Share Projection</div>
        <table class="rpt" data-sheet-name="SavingShareProjection">
            <colgroup>
                <col style="width:2.5%;" />
                <col style="width:12.9%;" />
                @for (int i = 0; i < 18; i++)
                {
                    <col style="width:4.7%;" />
                }
            </colgroup>
            <thead>
                <tr>
                    <th rowspan="3">SNo</th>
                    <th rowspan="3">Staff's Name</th>
                    <th colspan="2" rowspan="2">Annual Projection</th>
                    <th colspan="6">Saving('000)</th>
                    <th colspan="6">Share('000)</th>
                    <th colspan="2" rowspan="2">Total</th>
                    <th colspan="2" rowspan="2">Balance('000)</th>
                </tr>
                <tr>
                    <th colspan="2">Upto Last Month</th>
                    <th colspan="2">This Month</th>
                    <th colspan="2">Upto This Month</th>
                    <th colspan="2">Upto Last Month</th>
                    <th colspan="2">This Month</th>
                    <th colspan="2">Upto This Month</th>
                </tr>
                <tr>
                    <th>Saving</th>
                    <th>Share</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Projected</th>
                    <th>Added</th>
                    <th>Centre</th>
                    <th>Member</th>
                    <th>Saving</th>
                    <th>Share</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    int sn2 = 0;
                    foreach (var row in rows)
                    {
                        sn2++;
                        <tr>
                            <td class="ctr">@sn2</td>
                            <td class="name">@(row.HurCollectorName ?? "")</td>

                            @* Annual projection *@
                            <td class="num">@N0(row.SavingProjection)</td>
                            <td class="num">@N0(row.ShareProjection)</td>

                            @* Saving – Upto Last Month / This Month (no DTO field yet) *@
                            <td class="num">0</td>
                            <td class="num">0</td>
                            <td class="num">0</td>
                            <td class="num">0</td>
                            @* Saving – Upto This Month *@
                            <td class="num">0</td>
                            <td class="num">@N0(row.SaUptoThisMAdd)</td>

                            @* Share – Upto Last Month / This Month (no DTO field yet) *@
                            <td class="num">0</td>
                            <td class="num">0</td>
                            <td class="num">0</td>
                            <td class="num">0</td>
                            @* Share – Upto This Month *@
                            <td class="num">0</td>
                            <td class="num">@N0(row.ShUptoThisMAdd)</td>

                            @* Total *@
                            <td class="ctr">@N0(row.TotalCenter)</td>
                            <td class="ctr">@N0(row.TotalMember)</td>

                            @* Balance saving / share (no DTO field yet) *@
                            <td class="num">0.00</td>
                            <td class="num">0.00</td>
                        </tr>
                    }
                    <tr class="total">
                        <td colspan="2" class="num">Total:</td>
                        <td class="num">@N0(totalSavingProjection)</td>
                        <td class="num">@N0(totalShareProjection)</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">@N0(totalSaUptoThisMAdd)</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">0</td>
                        <td class="num">@N0(totalShUptoThisMAdd)</td>
                        <td class="ctr">@totalCenters</td>
                        <td class="ctr">@totalMembers</td>
                        <td class="num">0.00</td>
                        <td class="num">0.00</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="20" class="ctr">No data found for the selected criteria</td></tr>
                }
            </tbody>
        </table>

    </div>
</body>
</html>
