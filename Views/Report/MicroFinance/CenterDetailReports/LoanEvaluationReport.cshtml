@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.CenterDetailReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 8;   // number of .Column(...) lines below; every block below must add up to 8 columns

    decimal Total(string key) => Model.TryGetValue(key, out var tv) && tv != null ? Convert.ToDecimal(tv) : 0m;

    // a missing amount prints blank in the rows; totals always print two decimals
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";

    var member = Model["Member"] as LoanEvaluationMemberDto;
    var loanDetails = (Model["LoanDetails"] as List<LoanEvaluationLoanDetailDto>) ?? new List<LoanEvaluationLoanDetailDto>();
    var assetLedger = (Model["AssetLedger"] as List<LoanEvaluationAssetLedgerDto>) ?? new List<LoanEvaluationAssetLedgerDto>();
    var meeting = Model["Meeting"] as LoanEvaluationMeetingDto ?? new LoanEvaluationMeetingDto();
    var incomes = (Model["Incomes"] as List<LoanEvaluationIncomeDto>) ?? new List<LoanEvaluationIncomeDto>();
    var expenses = (Model["Expenses"] as List<LoanEvaluationExpenseDto>) ?? new List<LoanEvaluationExpenseDto>();
    var loanIssues = (Model["LoanIssues"] as List<LoanEvaluationLoanIssueDto>) ?? new List<LoanEvaluationLoanIssueDto>();

    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // ── cell helpers: text, span, css ──
    ReportCell T(string text, int span = 1, string? css = null) => new(text, Align.Left, span, css);
    ReportCell R(string text, int span = 1, string? css = null) => new(text, Align.Right, span, css);
    ReportCell C(string text, int span = 1, string? css = null) => new(text, Align.Center, span, css);

    // shading of every other row (the old report shaded the 1st, 3rd, 5th ... row) plus an optional extra class
    string? Css(int sn, string? extra = null)
    {
        var z = sn % 2 == 1 ? "z" : null;
        return z == null ? extra : extra == null ? z : z + " " + extra;
    }

    // one 8-column grid for the whole report: the loan detail block uses all 8 columns,
    // the other blocks join columns with spans
    var table = new ReportTable(Model, title: "Loan Evaluation Report", sheetName: "LoanEvaluation")
        .Column("S.N.", 5, Align.Center)
        .Column("Loan Type", 23)
        .Column("Saving", 12, Align.Right)
        .Column("Share", 12, Align.Right)
        .Column("Loan Issue", 12, Align.Right)
        .Column("Loan Remaining", 12, Align.Right)
        .Column("Loan Due", 12, Align.Right)
        .Column("Total", 12, Align.Right)
        .NoColumnHeader()                     // every block writes its own header
        .Style(new ReportStyle
        {
            ZebraStripes = false,             // shading is done per cell (class "z"), because some blocks must not stripe
            SectionBackground = "#e8e8e8",
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "table.sheet-table tr.r-section td, table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, " +
            "table.sheet-table tr.r-group td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-section td { font-family: 'Times New Roman', Times, serif; font-size: 11pt; }\n" +
            // header line of the blocks that need column spans (a group row styled like a header)
            "table.sheet-table tr.r-group td.sub-head { background: #f9f9f9; border-top: 1px solid #000; border-bottom: 1px solid #000; }\n" +
            // label cells of the member and meeting blocks
            "table.sheet-table tr.r-data td.label { font-weight: bold; background: #f9f9f9; }\n" +
            "table.sheet-table tr.r-data td.z { background: #f9f9f9; }\n" +
            "table.sheet-table tr.r-data td.positive { color: #006600; }");

    // ── title block ──
    table.MetaRow(HtmlString.Empty, Fmt.Labeled("Report Generated On :", generatedOn));

    // ═══ Member Detail: label + value, twice per line (2 + 2 + 2 + 2 columns) ═══
    table.Section("Member Detail");
    if (member != null)
    {
        table.Data(T("Member Id", 2, "label"), T(member.MemberId ?? "", 2), T("Member Name", 2, "label"), T(member.MemberName ?? "", 2));
        table.Data(T("Center", 2, "label"), T(member.CenterName ?? "", 2), T("Group", 2, "label"), T(member.GroupName ?? "", 2));
        table.Data(T("District", 2, "label"), T(member.DistrictName ?? "", 2), T("VDC", 2, "label"), T(member.VDCName ?? "", 2));
        table.Data(T("Permanent Address", 2, "label"), T(member.PermanentAddress ?? "", 2), T("Temporary Address", 2, "label"), T(member.TemporaryAddress ?? "", 2));
        table.Data(T("Contact No", 2, "label"), T(member.ContactNo ?? "", 6));
    }
    else
    {
        table.Data(C("No member data", ColumnCount));
    }

    // ═══ Loan Detail: all 8 columns ═══
    table.Section("Loan Detail");
    table.Header("S.N.", "Loan Type", "Saving", "Share", "Loan Issue", "Loan Remaining", "Loan Due", "Total");
    if (loanDetails.Count > 0)
    {
        var sn = 0;
        foreach (var row in loanDetails)
        {
            sn++;
            table.Data(
                C(sn.ToString(), 1, Css(sn)),
                T(row.LoanType ?? "", 1, Css(sn)),
                R(N(row.Saving), 1, Css(sn)),
                R(N(row.Share), 1, Css(sn)),
                R(N(row.LoanIssue), 1, Css(sn)),
                R(N(row.LoanRemaining), 1, Css(sn)),
                R(N(row.LoanDue), 1, Css(sn)),
                R(N(row.Total), 1, Css(sn, "positive")));
        }
        // label spans the first 2 columns; the 6 values fill the rest
        table.Total("Grand Total", 2,
            N(Total("TotalSaving")), N(Total("TotalShare")), N(Total("TotalLoanIssue")),
            N(Total("TotalLoanRemaining")), N(Total("TotalLoanDue")), N(Total("GrandTotal")));
    }
    else
    {
        table.Data(C("No loan data", ColumnCount));
    }

    // ═══ Member Asset Ledger: 1 + 1 + 2 + 2... = S.N. | Asset Ledger | Detail (2) | Number/Area (3) | Cost ═══
    table.Section("Member Asset Ledger");
    table.GroupBy(
        C("S.N.", 1, "sub-head"), T("Asset Ledger", 1, "sub-head"), T("Detail", 2, "sub-head"),
        T("Number/Area", 3, "sub-head"), R("Cost", 1, "sub-head"));
    if (assetLedger.Count > 0)
    {
        var sn = 0;
        foreach (var row in assetLedger)
        {
            sn++;
            table.Data(
                C(sn.ToString(), 1, Css(sn)),
                T(row.AssetLedger ?? "", 1, Css(sn)),
                T(row.LastColumn ?? "", 2, Css(sn)),
                T(row.NumberArea ?? "", 3, Css(sn)),
                R(N(row.Cost), 1, Css(sn)));
        }
        table.Total("Total Asset Cost", 7, N(Total("TotalAssetCost")));
    }
    else
    {
        table.Data(C("No asset data", ColumnCount));
    }

    // ═══ Meeting & Penalty Late: label + value, twice per line (2 + 2 + 2 + 2 columns) ═══
    table.Section("Meeting & Penalty Late");
    table.Data(T("Meeting Count", 2, "label"), T((meeting.MeetingCount ?? 0).ToString(), 2),
               T("Meeting Attended", 2, "label"), T((meeting.MeetingAttendedCount ?? 0).ToString(), 2));
    table.Data(T("Meeting Percent", 2, "label"), T((meeting.MeetingPercent ?? 0).ToString("N2"), 2),
               T("Late (Last 2 Loans)", 2, "label"), T(meeting.LateForLast2Loan ?? "No", 2));
    table.Data(T("Late Loan Payments (1 Yr)", 2, "label"), T((meeting.LateLoanPaymentForAYear ?? 0).ToString(), 6));

    // ═══ Income: S.N. | Income Ledger (6) | Amount ═══
    table.Section("Income");
    table.GroupBy(C("S.N.", 1, "sub-head"), T("Income Ledger", 6, "sub-head"), R("Amount", 1, "sub-head"));
    if (incomes.Count > 0)
    {
        var sn = 0;
        foreach (var row in incomes)
        {
            sn++;
            table.Data(C(sn.ToString(), 1, Css(sn)), T(row.IncomeLedger ?? "", 6, Css(sn)), R(N(row.Amount), 1, Css(sn)));
        }
        table.Total("Total Income", 7, N(Total("TotalIncome")));
    }
    else
    {
        table.Data(C("No income data", ColumnCount));
    }

    // ═══ Expense: S.N. | Expense Ledger (6) | Amount ═══
    table.Section("Expense");
    table.GroupBy(C("S.N.", 1, "sub-head"), T("Expense Ledger", 6, "sub-head"), R("Amount", 1, "sub-head"));
    if (expenses.Count > 0)
    {
        var sn = 0;
        foreach (var row in expenses)
        {
            sn++;
            table.Data(C(sn.ToString(), 1, Css(sn)), T(row.ExpenseLedger ?? "", 6, Css(sn)), R(N(row.Amount), 1, Css(sn)));
        }
        table.Total("Total Expense", 7, N(Total("TotalExpense")));
    }
    else
    {
        table.Data(C("No expense data", ColumnCount));
    }

    // ═══ Loan Issue Detail: S.N. | Loan Issue Date (3) | Loan Issue Amount (4, right-aligned) ═══
    table.Section("Loan Issue Detail");
    table.GroupBy(C("S.N.", 1, "sub-head"), T("Loan Issue Date (BS)", 3, "sub-head"), R("Loan Issue Amount", 4, "sub-head"));
    if (loanIssues.Count > 0)
    {
        var sn = 0;
        foreach (var row in loanIssues)
        {
            sn++;
            table.Data(C(sn.ToString(), 1, Css(sn)), T(row.LoanIssueOnBS ?? "", 3, Css(sn)), R(N(row.LoanIssueAmount), 4, Css(sn)));
        }
        table.Total("Total Loan Issue", 7, N(loanIssues.Sum(x => x.LoanIssueAmount ?? 0)));
    }
    else
    {
        table.Data(C("No loan issue data", ColumnCount));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())