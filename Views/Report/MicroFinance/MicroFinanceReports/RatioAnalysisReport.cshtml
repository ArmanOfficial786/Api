@using NexgenCosysReport.Dtos.RequestDtos.MicroFinance.MicroFinanceReports
@* Views/Report/Microfinance/MicrofinanceReport/RatioAnalysisReport.cshtml *@
@model Dictionary<string, object>
@{
    Layout = null;

    var groups = (Model["Groups"] as List<RatioAnalysisGroupDto>) ?? new List<RatioAnalysisGroupDto>();
    var branches = (Model["Branches"] as List<RatioAnalysisBranchDto>) ?? new List<RatioAnalysisBranchDto>();
    var branchCount = Model["BranchCount"] as int? ?? 0;
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var provisionType = Model["ProvisionType"]?.ToString() ?? "S";
    var provisionTypeName = Model["ProvisionTypeName"]?.ToString() ?? "Schedule Wise";
    var viewMode = Model["ViewMode"]?.ToString() ?? "D";
    var viewModeName = Model["ViewModeName"]?.ToString() ?? "Detail";
    var enable1To30Days = Model["Enable1To30Days"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isSummaryOnly = viewMode == "T";

    var colCount = 2 + branchCount;

    // Column accessor helper for the "ColN" / "ColPerN" dynamic properties
    Func<RatioAnalysisRowDto, int, decimal?> getCol = (r, idx) => idx switch
    {
        1 => r.Col1,
        2 => r.Col2,
        3 => r.Col3,
        4 => r.Col4,
        5 => r.Col5,
        6 => r.Col6,
        7 => r.Col7,
        8 => r.Col8,
        9 => r.Col9,
        10 => r.Col10,
        11 => r.Col11,
        12 => r.Col12,
        13 => r.Col13,
        14 => r.Col14,
        15 => r.Col15,
        _ => null
    };

    Func<RatioAnalysisRowDto, int, decimal?> getColPer = (r, idx) => idx switch
    {
        1 => r.ColPer1,
        2 => r.ColPer2,
        3 => r.ColPer3,
        4 => r.ColPer4,
        5 => r.ColPer5,
        6 => r.ColPer6,
        7 => r.ColPer7,
        8 => r.ColPer8,
        9 => r.ColPer9,
        10 => r.ColPer10,
        11 => r.ColPer11,
        12 => r.ColPer11,
        13 => r.ColPer13,
        14 => r.ColPer14,
        15 => r.ColPer15,
        _ => null
    };

    Func<string, string> formatValue = (raw) =>
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        if (decimal.TryParse(raw, out var d))
            return d.ToString("N2");
        return raw;
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ratio Analysis Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 4px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .group-header-row td {
                background: #d9edf7;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                font-weight: bold;
                font-size: 9pt;
                padding: 5px 6px;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .negative {
                color: #CC0000;
            }

            .provision-badge {
                display: inline-block;
                padding: 2px 10px;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            .badge-schedule {
                background: #d1ecf1;
                color: #0c5460;
            }

            .badge-remaining {
                background: #fff3cd;
                color: #856404;
            }

            .badge-maturity {
                background: #f8d7da;
                color: #721c24;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }

                .group-header-row {
                    page-break-after: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="RatioAnalysis">
            <colgroup>
                <col style="width:4%;" />
                <col style="width:36%;" />
                @for (int i = 0; i < branchCount; i++)
                {
                    <col style="width:@(60 / Math.Max(branchCount, 1))%;" />
                }
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="@colCount">Ratio Analysis Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="@(colCount / 2)">
                        <strong>Branch :</strong> @branchName
                        &nbsp;&nbsp;
                        <strong>From :</strong> @fromDate
                        &nbsp;&nbsp;
                        <strong>To :</strong> @toDate
                    </td>
                    <td colspan="@(colCount - colCount / 2)" class="text-right">
                        <strong>Provision :</strong>
                        <span class="provision-badge @(provisionType == "S" ? "badge-schedule" : provisionType == "R" ? "badge-remaining" : "badge-maturity")">
                            @provisionTypeName
                        </span>
                        &nbsp;&nbsp;
                        <strong>View :</strong> @viewModeName
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="@(colCount / 2)">
                        @if (enable1To30Days)
                        {
                            <strong>Enable 1 to 30 Days : Yes</strong>
                        }
                        else
                        {
                            <strong>Enable 1 to 30 Days : No</strong>
                        }
                    </td>
                    <td colspan="@(colCount - colCount / 2)" class="text-right">
                        <strong>Report Generated On :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="@colCount"></td></tr>

                @if (groups.Any())
                {
                    foreach (var group in groups)
                    {
                        <tr class="group-header-row">
                            <td colspan="@colCount">@(group.GroupName ?? "")</td>
                        </tr>

                        if (!isSummaryOnly)
                        {
                            <tr>
                                <th class="text-center">S.N.</th>
                                <th>Detail</th>
                                @for (int i = 1; i <= branchCount; i++)
                                {
                                    var branchLabel = i - 1 < branches.Count ? branches[i - 1].OfficeName : $"Branch {i}";
                                    <th class="text-right">@branchLabel</th>
                                }
                            </tr>
                        }

                        foreach (var row in group.Rows)
                        {
                            <tr class="@(row.SN % 2 == 0 ? "detail-row" : "detail-row-alt")">
                                <td class="text-center">@row.SN</td>
                                <td>@(row.Detail ?? "")</td>
                                @for (int i = 1; i <= branchCount; i++)
                                {
                                    var val = getCol(row, i);
                                    <td class="text-right @(val.HasValue && val.Value < 0 ? "negative" : "")">
                                        @(val.HasValue ? val.Value.ToString("N2") : "")
                                    </td>
                                }
                            </tr>
                        }
                    }

                    <tr class="grand-total-row">
                        <td colspan="@colCount" class="text-right">
                            <strong>Total Records : @totalRecords</strong>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="@colCount" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>