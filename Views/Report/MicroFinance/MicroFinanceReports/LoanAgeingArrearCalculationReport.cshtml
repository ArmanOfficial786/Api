@using NexgenCosysReport.Dtos.RequestDtos.MicroFinance.MicroFinanceReports
@* Views/Report/Microfinance/MicrofinanceReport/LoanAgeingArrearCalculationReport.cshtml *@
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanAgeingArrearCalculationRowDto>) ?? new List<LoanAgeingArrearCalculationRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalPrinciplePaidAmount = Model["TotalPrinciplePaidAmount"] as decimal? ?? 0;
    var totalLoanBalance = Model["TotalLoanBalance"] as decimal? ?? 0;
    var totalGoodLoan = Model["TotalGoodLoan"] as decimal? ?? 0;
    var totalBetween0to30Days = Model["TotalBetween0to30Days"] as decimal? ?? 0;
    var totalBetween31to365Days = Model["TotalBetween31to365Days"] as decimal? ?? 0;
    var totalGraterThan365Days = Model["TotalGraterThan365Days"] as decimal? ?? 0;
    var totalOverdue = Model["TotalOverdue"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var penaltyType = Model["PenaltyType"]?.ToString() ?? "S";
    var penaltyTypeName = Model["PenaltyTypeName"]?.ToString() ?? "Schedule Wise";
    var orderBy = Model["OrderBy"]?.ToString() ?? "-1";
    var enable1To30Days = Model["Enable1To30Days"] as bool? ?? false;
    var groupByCollectionCenter = Model["GroupByCollectionCenter"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isCollectionCenterFiltered = !string.IsNullOrEmpty(collectionCenterName);
    var isCollectorFiltered = !string.IsNullOrEmpty(collectorName);
    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);

    var extraCols = groupByCollectionCenter ? 1 : 0;
    var colCount = 4 + extraCols + 10;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Ageing Arrear Calculation Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 4px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .negative {
                color: #CC0000;
            }

            .positive {
                color: #006600;
            }

            .penalty-badge {
                display: inline-block;
                padding: 2px 10px;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            .badge-schedule {
                background: #d1ecf1;
                color: #0c5460;
            }

            .badge-remaining {
                background: #fff3cd;
                color: #856404;
            }

            .badge-maturity {
                background: #f8d7da;
                color: #721c24;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanAgeingArrearCalculation">
            <colgroup>
                <col style="width:3%;" />
                <col style="width:8%;" />
                <col style="width:14%;" />
                @if (groupByCollectionCenter)
                {
                    <col style="width:10%;" />
                }
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:8%;" />
                <col style="width:8%;" />
                <col style="width:8%;" />
                <col style="width:8%;" />
                <col style="width:7%;" />
                <col style="width:7%;" />
                <col style="width:7%;" />
                <col style="width:7%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="@colCount">Loan Ageing Arrear Calculation Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="@(colCount / 2)">
                        <strong>Branch :</strong> @branchName
                        &nbsp;&nbsp;
                        <strong>Till Date :</strong> @tillDate
                    </td>
                    <td colspan="@(colCount - colCount / 2)" class="text-right">
                        <strong>Penalty :</strong>
                        <span class="penalty-badge @(penaltyType == "S" ? "badge-schedule" : penaltyType == "R" ? "badge-remaining" : "badge-maturity")">
                            @penaltyTypeName
                        </span>
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="@(colCount / 2)">
                        @if (isCollectionCenterFiltered)
                        {
                            <strong>Center :</strong> 
                            @collectionCenterName
                            <text>&nbsp;&nbsp;</text>
                        }
                        @if (isCollectorFiltered)
                        {
                            <strong>Collector :</strong> 
                            @collectorName
                        }
                        @if (isMemberGroupFiltered)
                        {
                            <text>&nbsp;&nbsp;<strong>Group :</strong> @memberGroupName</text>
                        }
                    </td>
                    <td colspan="@(colCount - colCount / 2)" class="text-right">
                        <strong>Generated :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="@colCount"></td></tr>

                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    @if (groupByCollectionCenter)
                    {
                        <th>Center</th>
                    }
                    <th>Account No</th>
                    <th>Loan Type</th>
                    <th>Issue Date</th>
                    <th class="text-right">Issue Amount</th>
                    <th class="text-right">Paid</th>
                    <th class="text-right">Balance</th>
                    <th class="text-right">Good Loan</th>
                    <th class="text-right">0-30 Days</th>
                    <th class="text-right">31-365 Days</th>
                    <th class="text-right">&gt;365 Days</th>
                    <th class="text-right">Overdue</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td class="text-center">@sn</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.FullName ?? "")</td>
                            @if (groupByCollectionCenter)
                            {
                                <td>@(row.ContactAddress ?? "")</td>
                            }
                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            <td>@(row.LoanIssueOnBs ?? "")</td>
                            <td class="text-right">@(row.LoanIssueAmount?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.PrinciplePaidAmt?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.LoanBalance?.ToString("N2") ?? "")</td>
                            <td class="text-right positive">@(row.Goodloan?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Between0to30Days?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Between31to365Days?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.GraterThan365Days?.ToString("N2") ?? "")</td>
                            <td class="text-right negative">@(row.OverDue?.ToString("N2") ?? "")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="@(3 + extraCols)" class="text-right"><strong>Grand Total</strong></td>
                        <td></td>
                        <td></td>
                        <td class="text-right"><strong>@totalLoanIssueAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalPrinciplePaidAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalLoanBalance.ToString("N2")</strong></td>
                        <td class="text-right positive"><strong>@totalGoodLoan.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalBetween0to30Days.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalBetween31to365Days.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalGraterThan365Days.ToString("N2")</strong></td>
                        <td class="text-right negative"><strong>@totalOverdue.ToString("N2")</strong></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="@(colCount - 1)" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="@colCount" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>