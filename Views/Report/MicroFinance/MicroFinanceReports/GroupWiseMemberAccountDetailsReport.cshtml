@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.MicroFinance.MicroFinanceReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "10pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    bool Flag(string key) => Model.TryGetValue(key, out var fv) && fv is bool b && b;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // amounts always show two decimals, a missing amount prints 0.00 (same as before)
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<GroupWiseMemberAccountDetailsRowDto>) ?? new List<GroupWiseMemberAccountDetailsRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalBalance = TotalOr("TotalBalance", rows.Sum(r => r.Balance ?? 0m));

    var groupByBranch = Flag("GroupByBranch");
    var groupByCollectionCenter = Flag("GroupByCollectionCenter");
    var groupByMemberGroup = Flag("GroupByMemberGroup");
    var isGrouped = groupByBranch || groupByCollectionCenter || groupByMemberGroup;

    // the group line shows every group level the user picked, side by side
    string KeyOf(GroupWiseMemberAccountDetailsRowDto r)
    {
        var parts = new List<string>();
        if (groupByBranch) parts.Add("Office : " + r.OfficeName);
        if (groupByCollectionCenter) parts.Add("Collection Center : " + r.CollectionCenterName);
        if (groupByMemberGroup) parts.Add("Group : " + r.GroupCode + " " + r.GroupName);
        return string.Join("      ", parts);
    }

    // groups keep the order of the repository rows; without grouping there is one group and no group lines
    var groups = isGrouped
        ? rows.GroupBy(KeyOf).Select(g => (Key: g.Key, Items: g.ToList())).ToList()
        : new List<(string Key, List<GroupWiseMemberAccountDetailsRowDto> Items)> { (Key: "", Items: rows) };

    var table = new ReportTable(Model, title: "Group Wise Member Account Details Report", sheetName: "GroupWiseMemberAccountDetails")
        .Column("S.N.", 4, Align.Center)
        .Column("Collection Center Name", 17)
        .Column("G. code", 7)
        .Column("Group Name", 19)
        .Column("Member Id", 10)
        .Column("Member Name", 16)
        .Column("Account No", 13)
        .Column("Balance", 14, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 7, headerMm: 8, firstPageExtraMm: 70)   // one text line per row (the old report used 28 px rows)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-family: 'Times New Roman', Times, serif; font-size: " + fontSize + "; line-height: 1.25; padding: 1px 4px; }\n" +
            // every data row and group line has a rule under it, as before
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-total td { border-top: 1px solid #000; border-bottom: 1px solid #000; }");

    // ── title block ──
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // ── rows ──
    var sn = 0;                                   // the serial number keeps counting across groups
    foreach (var g in groups)
    {
        if (isGrouped)
            table.GroupTitle(g.Key);

        foreach (var row in g.Items)
        {
            sn++;
            table.Data(
                sn.ToString(),
                row.CollectionCenterName ?? "",
                row.GroupCode ?? "",
                row.GroupName ?? "",
                row.MemberId ?? "",
                row.MemberName ?? "",
                row.AccountNo ?? "",
                N(row.Balance));
        }

        // label spans the first 7 columns; the value fills Balance
        if (isGrouped)
            table.SubTotal($"Sub Total ({g.Items.Count})", 7, N(g.Items.Sum(x => x.Balance ?? 0m)));
    }

    if (rows.Count > 0)
        table.Total($"Grand Total ({totalRecords})", 7, N(totalBalance));
}
@await Html.PartialAsync("_SheetReport", table.Build())