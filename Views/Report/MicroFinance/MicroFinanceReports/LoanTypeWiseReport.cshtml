@using NexgenCosysReport.Dtos.RequestDtos.MicroFinance.MicroFinanceReports


@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanTypeWiseRowDto>) ?? new List<LoanTypeWiseRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalDisburseAmount = Model["TotalDisburseAmount"] as decimal? ?? 0;
    var totalOpeningDisburseAmount = Model["TotalOpeningDisburseAmount"] as decimal? ?? 0;
    var totalRepaid = Model["TotalRepaid"] as decimal? ?? 0;
    var totalBalanceAmount = Model["TotalBalanceAmount"] as decimal? ?? 0;
    var totalOpeningPaid = Model["TotalOpeningPaid"] as decimal? ?? 0;
    var totalOpeningBalance = Model["TotalOpeningBalance"] as decimal? ?? 0;
    var totalClosingBalance = Model["TotalClosingBalance"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var loanTypeName = Model["LoanTypeName"]?.ToString() ?? "";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var loanGuarantee = Model["LoanGuarantee"]?.ToString() ?? "-1";
    var shareType = Model["ShareType"]?.ToString() ?? "-1";
    var orderBy = Model["OrderBy"]?.ToString() ?? "-1";
    var showOpeningBalance = Model["ShowOpeningBalance"] as bool? ?? false;
    var showDetail = Model["ShowDetail"] as bool? ?? true;
    var groupByBranch = Model["GroupByBranch"] as bool? ?? false;
    var groupByCollectionCenter = Model["GroupByCollectionCenter"] as bool? ?? false;
    var groupByMemberGroup = Model["GroupByMemberGroup"] as bool? ?? false;
    var viewCollector = Model["ViewCollector"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isLoanTypeFiltered = !string.IsNullOrEmpty(loanTypeName);
    var isCollectionCenterFiltered = !string.IsNullOrEmpty(collectionCenterName);
    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);
    var isCollectorFiltered = !string.IsNullOrEmpty(collectorName);
    var isLoanGuaranteeFiltered = loanGuarantee != "-1";
    var isShareTypeFiltered = shareType != "-1";

    var shareTypeLabel = shareType switch
    {
        "1" => "Promoter Share",
        "3" => "Share Holder",
        _ => "All"
    };

    var extraCols = 0;
    if (groupByBranch) extraCols++;
    if (groupByCollectionCenter) extraCols++;
    if (groupByMemberGroup) extraCols++;
    if (viewCollector) extraCols++;

    var amountCols = showOpeningBalance ? 7 : 3;
    var colCount = 3 + extraCols + amountCols;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Type Wise Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 4px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .negative {
                color: #CC0000;
            }

            .positive {
                color: #006600;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanTypeWise">
            <colgroup>
                <col style="width:3%;" />
                <col style="width:7%;" />
                <col style="width:14%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                @if (groupByBranch)
                {
                    <col style="width:9%;" />
                }
                @if (groupByCollectionCenter)
                {
                    <col style="width:9%;" />
                }
                @if (groupByMemberGroup)
                {
                    <col style="width:9%;" />
                }
                @if (viewCollector)
                {
                    <col style="width:9%;" />
                }
                @if (showOpeningBalance)
                {
                    <col style="width:7%;" />
                }
                <col style="width:7%;" />
                <col style="width:7%;" />
                <col style="width:7%;" />
                @if (showOpeningBalance)
                {
                    <col style="width:7%;" />
                    <col style="width:7%;" />
                    <col style="width:7%;" />
                }
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="@colCount">Loan Type Wise Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="@(colCount / 2)">
                        <strong>Branch :</strong> @branchName
                        &nbsp;&nbsp;
                        <strong>From :</strong> @fromDate
                        &nbsp;&nbsp;
                        <strong>To :</strong> @toDate
                    </td>
                    <td colspan="@(colCount - colCount / 2)" class="text-right">
                        @if (isLoanTypeFiltered)
                        {
                            <strong>Loan Type :</strong> 
                            @loanTypeName
                            <text>&nbsp;&nbsp;</text>
                        }
                        @if (isLoanGuaranteeFiltered)
                        {
                            <strong>Guarantee :</strong> 
                            @loanGuarantee
                            <text>&nbsp;&nbsp;</text>
                        }
                        @if (isShareTypeFiltered)
                        {
                            <strong>Share Type :</strong> 
                            @shareTypeLabel
                        }
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="@(colCount / 2)">
                        @if (isCollectionCenterFiltered)
                        {
                            <strong>Collection Center :</strong> 
                            @collectionCenterName
                            <text>&nbsp;&nbsp;</text>
                        }
                        @if (isMemberGroupFiltered)
                        {
                            <strong>Member Group :</strong> 
                            @memberGroupName
                        }
                    </td>
                    <td colspan="@(colCount - colCount / 2)" class="text-right">
                        @if (isCollectorFiltered)
                        {
                            <strong>Collector :</strong> 
                            @collectorName
                            <text>&nbsp;&nbsp;</text>
                        }
                        <strong>Generated :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="@colCount"></td></tr>

                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Account No</th>
                    <th>Loan Type</th>
                    @if (groupByBranch)
                    {
                        <th>Office</th>
                    }
                    @if (groupByCollectionCenter)
                    {
                        <th>Collection Center</th>
                    }
                    @if (groupByMemberGroup)
                    {
                        <th>Member Group</th>
                    }
                    @if (viewCollector)
                    {
                        <th>Collector</th>
                    }
                    @if (showOpeningBalance)
                    {
                        <th class="text-right">Opening Disburse</th>
                    }
                    <th class="text-right">Disburse Amount</th>
                    @if (showOpeningBalance)
                    {
                        <th class="text-right">Opening Paid</th>
                    }
                    <th class="text-right">Repaid</th>
                    <th class="text-right">Balance</th>
                    @if (showOpeningBalance)
                    {
                        <th class="text-right">Opening Balance</th>
                        <th class="text-right">Closing Balance</th>
                    }
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td class="text-center">@sn</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.FullName ?? "")</td>
                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            @if (groupByBranch)
                            {
                                <td>@(row.OfficeName ?? "")</td>
                            }
                            @if (groupByCollectionCenter)
                            {
                                <td>@(row.CollectionCenterName ?? "")</td>
                            }
                            @if (groupByMemberGroup)
                            {
                                <td>@(row.GroupName ?? "")</td>
                            }
                            @if (viewCollector)
                            {
                                <td>@(row.CollectorName ?? "")</td>
                            }
                            @if (showOpeningBalance)
                            {
                                <td class="text-right">@(row.OpeningDisburseAmount?.ToString("N2") ?? "")</td>
                            }
                            <td class="text-right">@(row.DisburseAmount?.ToString("N2") ?? "")</td>
                            @if (showOpeningBalance)
                            {
                                <td class="text-right">@(row.OpeningPaid?.ToString("N2") ?? "")</td>
                            }
                            <td class="text-right">@(row.Repaid?.ToString("N2") ?? "")</td>
                            <td class="text-right @(row.BalanceAmount.HasValue && row.BalanceAmount.Value > 0 ? "negative" : "positive")">@(row.BalanceAmount?.ToString("N2") ?? "")</td>
                            @if (showOpeningBalance)
                            {
                                <td class="text-right">@(row.OpeningBalance?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.ClosingBalance?.ToString("N2") ?? "")</td>
                            }
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="@(3 + extraCols)" class="text-right"><strong>Grand Total</strong></td>
                        @if (showOpeningBalance)
                        {
                            <td class="text-right"><strong>@totalOpeningDisburseAmount.ToString("N2")</strong></td>
                        }
                        <td class="text-right"><strong>@totalDisburseAmount.ToString("N2")</strong></td>
                        @if (showOpeningBalance)
                        {
                            <td class="text-right"><strong>@totalOpeningPaid.ToString("N2")</strong></td>
                        }
                        <td class="text-right"><strong>@totalRepaid.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalBalanceAmount.ToString("N2")</strong></td>
                        @if (showOpeningBalance)
                        {
                            <td class="text-right"><strong>@totalOpeningBalance.ToString("N2")</strong></td>
                            <td class="text-right"><strong>@totalClosingBalance.ToString("N2")</strong></td>
                        }
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="@(colCount - 1)" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="@colCount" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>