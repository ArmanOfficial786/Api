@using NexgenCosysReport.Dtos.RequestDtos.MicroFinance.MicroFinanceReports

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<FundWithdrawlRowDto>) ?? new List<FundWithdrawlRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalCashWithdrawl = Model["TotalCashWithdrawl"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var orderBy = Model["OrderBy"]?.ToString() ?? "Name";
    var reportMode = Model["ReportMode"]?.ToString() ?? "1";
    var reportModeName = Model["ReportModeName"]?.ToString() ?? "Summary";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isSummary = reportMode == "1";


    var colCount = 7;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Fund Withdrawl Report</title>
    <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container { width: 100%; overflow: visible; }

            thead { display: table-row-group; }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

            .data-table td, .data-table th {
                word-wrap: break-word;
                overflow-wrap: break-word;
                padding: 4px 6px;
                vertical-align: middle;
            }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td { padding: 3px 6px; font-size: 9pt; }
            .meta-spacer td { height: 6px; }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td { border-bottom: 1px solid #eee; }
            .detail-row-alt td { background: #f9f9f9; border-bottom: 1px solid #eee; }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right { text-align: right !important; }
            .text-center { text-align: center !important; }

            .mode-badge {
                display: inline-block;
                padding: 2px 10px;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            .badge-summary { background: #d1ecf1; color: #0c5460; }
            .badge-detail  { background: #fff3cd; color: #856404; }

            @@media print {
                thead { display: table-row-group; }
                tr { page-break-inside: avoid; break-inside: avoid; }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="FundWithdrawl">
            <colgroup>
                <col style="width:5%;" />   @* SN *@
                <col style="width:12%;" />  @* Center Code *@
                <col style="width:12%;" />  @* Member Id *@
                <col style="width:20%;" />  @* Name *@
                <col style="width:20%;" />  @* Address *@
                <col style="width:13%;" />  @* Transaction Date *@
                <col style="width:13%;" />  @* Amount *@
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="@colCount">Fund Withdrawl Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="4">
                        <strong>Branch :</strong> @branchName
                        &nbsp;&nbsp;
                        <strong>From :</strong> @fromDate
                        &nbsp;&nbsp;
                        <strong>To :</strong> @toDate
                    </td>
                    <td colspan="3" class="text-right">
                        <strong>Report Type :</strong>
                        <span class="mode-badge @(isSummary ? "badge-summary" : "badge-detail")">
                            @reportModeName
                        </span>
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="4">
                        <strong>Order By :</strong> @orderBy
                    </td>
                    <td colspan="3" class="text-right">
                        <strong>Report Generated On :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="@colCount"></td></tr>

                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Center Code</th>
                    <th>Member Id</th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Transaction Date</th>
                    <th class="text-right">Amount</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td class="text-center">@sn</td>
                            <td>@(row.CollectionCenterShortCode ?? "")</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.Name ?? "")</td>
                            <td>@(row.PermanentAddessDetail ?? "")</td>
                            <td>@(row.TransactionOnBs ?? "")</td>
                            <td class="text-right">@(row.CashWithdrawl?.ToString("N2") ?? "")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalCashWithdrawl.ToString("N2")</strong></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="@colCount" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>