@using NexgenCosysReport.Dtos.RequestDtos.MicroFinance.MicroFinanceReports

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<FundWithdrawlRowDto>) ?? new List<FundWithdrawlRowDto>();
    var totalCashWithdrawl = Model["TotalCashWithdrawl"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var reportMode = Model["ReportMode"]?.ToString() ?? "1";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isSummary = reportMode == "1";
    const int colCount = 7;

    // Grouped by Fund Payment Type (alphabetical), rows keep the requested order inside each group
    var groups = rows
        .GroupBy(r => (r.TypeName ?? "").Trim())
        .OrderBy(g => g.Key)
        .ToList();

    Func<decimal?, string> N2 = v => (v ?? 0m).ToString("N2");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Fund Withdrawl Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Times New Roman", Times, serif;
                font-size: 11pt;
                background: #fff;
                color: #000;
            }

            .report-container {
                width: 100%;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    padding: 4px 5px;
                    vertical-align: middle;
                    overflow-wrap: anywhere;
                    word-break: normal;
                    border: none;
                }

            /* ── meta block (no borders) ── */
            .meta-title td {
                text-align: center;
                font-size: 16pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 2px 6px 8px 6px;
            }

            .meta-row td {
                padding: 3px 5px;
                font-size: 10.5pt;
            }

            .meta-row .lbl {
                font-weight: bold;
            }

            .meta-row .val {
                font-weight: normal;
                padding-left: 14px;
            }

            .meta-row .gen {
                font-weight: bold;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 18px;
            }

            /* ── bordered data cells ── */
            .data-table th.bd, .data-table td.bd {
                border: 1px solid #000;
                background: #fff;
            }

            .data-table th.bd {
                font-weight: bold;
                text-align: left;
            }

            .summary-row td.bd {
                font-weight: bold;
            }

            .group-head td.bd {
                font-weight: bold;
            }

            .detail-row td.bd {
                font-weight: normal;
                font-size: 10pt;
            }

            .total-row td.bd {
                font-weight: bold;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            thead {
                display: table-row-group;
            }

            tr {
                page-break-inside: avoid;
                break-inside: avoid;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="FundWithdrawl">
            <colgroup>
                <col style="width:5%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:20%;" />
                <col style="width:20%;" />
                <col style="width:13%;" />
                <col style="width:18%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="@colCount">Fund Withdrawl Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="2" class="lbl">Branch Name :</td>
                    <td colspan="5" class="val">@branchName</td>
                </tr>
                <tr class="meta-spacer"><td colspan="@colCount"></td></tr>
                <tr class="meta-row">
                    <td colspan="3" class="gen">Report Generated On: &nbsp; @generatedOn</td>
                    <td colspan="4" class="text-right">
                        <span class="lbl">From Date:</span> <span class="val">@fromDate</span>
                        &nbsp;&nbsp;
                        <span class="lbl">To Date:</span> <span class="val">@toDate</span>
                    </td>
                </tr>

                @if (isSummary)
                {
                    <tr>
                        <th class="bd" colspan="6">Fund Payment Type</th>
                        <th class="bd text-right">Amount</th>
                    </tr>

                    @if (groups.Any())
                    {
                        foreach (var grp in groups)
                        {
                            <tr class="summary-row">
                                <td class="bd" colspan="6">@grp.Key</td>
                                <td class="bd text-right">@N2(grp.Sum(r => r.CashWithdrawl ?? 0m))</td>
                            </tr>
                        }
                        <tr class="total-row">
                            <td class="bd text-right" colspan="6">Grand Total:</td>
                            <td class="bd text-right">@N2(totalCashWithdrawl)</td>
                        </tr>
                    }
                    else
                    {
                        <tr><td class="bd text-center" colspan="@colCount">No data found for the selected criteria</td></tr>
                    }
                }
                else
                {
                    <tr>
                        <th class="bd text-center">S.N.</th>
                        <th class="bd">Center Code</th>
                        <th class="bd">Member Id</th>
                        <th class="bd">Name</th>
                        <th class="bd">Address</th>
                        <th class="bd">Transaction Date</th>
                        <th class="bd text-right">Amount</th>
                    </tr>

                    @if (groups.Any())
                    {
                        foreach (var grp in groups)
                        {
                            <tr class="group-head">
                                <td class="bd" colspan="@colCount">Fund Payment Type: @grp.Key</td>
                            </tr>

                            var sn = 0;
                            foreach (var row in grp)
                            {
                                sn++;
                                <tr class="detail-row">
                                    <td class="bd text-center">@sn</td>
                                    <td class="bd">@(row.CollectionCenterShortCode ?? "")</td>
                                    <td class="bd">@(row.MemberId ?? "")</td>
                                    <td class="bd">@(row.Name ?? "")</td>
                                    <td class="bd">@(row.PermanentAddessDetail ?? "")</td>
                                    <td class="bd">@(row.TransactionOnBs ?? "")</td>
                                    <td class="bd text-right">@N2(row.CashWithdrawl)</td>
                                </tr>
                            }

                            <tr class="total-row">
                                <td class="bd text-right" colspan="6">Total:</td>
                                <td class="bd text-right">@N2(grp.Sum(r => r.CashWithdrawl ?? 0m))</td>
                            </tr>
                        }
                        <tr class="total-row">
                            <td class="bd text-right" colspan="6">Grand Total:</td>
                            <td class="bd text-right">@N2(totalCashWithdrawl)</td>
                        </tr>
                    }
                    else
                    {
                        <tr><td class="bd text-center" colspan="@colCount">No data found for the selected criteria</td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
</body>
</html>
