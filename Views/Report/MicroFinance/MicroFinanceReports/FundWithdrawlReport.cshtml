@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.MicroFinance.MicroFinanceReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "10pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // amounts always show two decimals, a missing amount prints 0.00 (same as before)
    string N2(decimal? v) => (v ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<FundWithdrawlRowDto>) ?? new List<FundWithdrawlRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalCashWithdrawl = TotalOr("TotalCashWithdrawl", rows.Sum(r => r.CashWithdrawl ?? 0m));

    // "1" = summary (one line per fund payment type), anything else = detail
    var isSummary = Text("ReportMode", "1") == "1";

    // grouped by fund payment type (alphabetical); rows keep the requested order inside each group
    var groups = rows
        .GroupBy(r => (r.TypeName ?? "").Trim())
        .OrderBy(g => g.Key)
        .ToList();

    var table = new ReportTable(Model, title: "Fund Withdrawl Report", sheetName: "FundWithdrawl");

    // the summary and the detail mode have different columns, so each mode defines its own
    if (isSummary)
    {
        table.Column("Fund Payment Type", 82)
             .Column("Amount", 18, Align.Right);
    }
    else
    {
        table.Column("S.N.", 5, Align.Center)
             .Column("Center Code", 12)
             .Column("Member Id", 12)
             .Column("Name", 20)
             .Column("Address", 20)
             .Column("Transaction Date", 13)
             .Column("Amount", 18, Align.Right);
    }

    table.Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-family: 'Times New Roman', Times, serif; font-size: " + fontSize + "; line-height: 1.25; padding: 1px 5px; border: 1px solid #000; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));

    // ── rows ──
    if (isSummary)
    {
        // one line per fund payment type
        foreach (var grp in groups)
            table.Data(grp.Key, N2(grp.Sum(r => r.CashWithdrawl ?? 0m)));

        table.Total("Grand Total:", 1, N2(totalCashWithdrawl));
    }
    else
    {
        // one block per fund payment type (type line, withdrawals, type total)
        foreach (var grp in groups)
        {
            table.GroupTitle($"Fund Payment Type: {grp.Key}");

            var sn = 0;
            foreach (var row in grp)
            {
                sn++;
                table.Data(
                    sn.ToString(),
                    row.CollectionCenterShortCode ?? "",
                    row.MemberId ?? "",
                    row.Name ?? "",
                    row.PermanentAddessDetail ?? "",
                    row.TransactionOnBs ?? "",
                    N2(row.CashWithdrawl));
            }

            // label spans the first 6 columns; the value fills Amount
            table.SubTotal("Total:", 6, N2(grp.Sum(r => r.CashWithdrawl ?? 0m)));
        }

        table.Total("Grand Total:", 6, N2(totalCashWithdrawl));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())