                        <th colspan="16">Saving Details</th>
                        <th colspan="24">Loan Details</th>
                        <th rowspan="3">Total<br />Receive<br />Amount</th>
                    </tr>
                    <tr id="grp2HeaderRow">
                        <th colspan="3"></th>
                        @for (int s = 1; s <= 4; s++)
                        {
                            <th colspan="4">Saving @s</th>
                        }
                        @for (int l = 1; l <= 4; l++)
                        {
                            <th colspan="6">Loan @l</th>
                        }
                    </tr>
                    <tr id="colHeaderRow">
                        <th>S.N</th>
                        <th>MemberId</th>
                        <th>Member Name</th>
                        @for (int s = 0; s < 4; s++)
                        {
                            <th>AccountNo</th>
                            <th>Bal Amt</th>
                            <th>Dep Amt</th>
                            <th>With Amt</th>
                        }
                        @for (int l = 0; l < 4; l++)
                        {
                            <th>AccountNo</th>
                            <th>Pri Bal</th>
                            <th>Pri</th>
                            <th>Int</th>
                            <th>Pri</th>
                            <th>Int</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grp in groups)
                    {
                        <tr class="detail-row group-header">
                            <td colspan="44">Group Name: @(grp.Key)</td>
                        </tr>

                        var sn = 0;
                        foreach (var row in grp)
                        {
                            sn++;
                            <tr class="detail-row">
                                <td class="text-center">@sn</td>
                                <td>@(row.MemberId ?? "")</td>
                                <td>@(row.MemberName ?? "")</td>

                                <td>@(row.Saving1AcNo ?? "")</td>
                                <td class="text-right">@(N(row.Saving1Balance))</td>
                                <td></td>
                                <td></td>
                                <td>@(row.Saving2AcNo ?? "")</td>
                                <td class="text-right">@(N(row.Saving2Balance))</td>
                                <td></td>
                                <td></td>
                                <td>@(row.Saving3AcNo ?? "")</td>
                                <td class="text-right">@(N(row.Saving3Balance))</td>
                                <td></td>
                                <td></td>
                                <td>@(row.Saving4AcNo ?? "")</td>
                                <td class="text-right">@(N(row.Saving4Balance))</td>
                                <td></td>
                                <td></td>

                                <td>@(row.Loan1AcNo ?? "")</td>
                                <td class="text-right">@(N(row.Loan1RemPrinciple))</td>
                                <td class="text-right">@(N(row.Loan1PayablePri))</td>
                                <td class="text-right">@(N(row.Loan1PayableInt))</td>
                                <td></td>
                                <td></td>
                                <td>@(row.Loan2AcNo ?? "")</td>
                                <td class="text-right">@(N(row.Loan2RemPrinciple))</td>
                                <td class="text-right">@(N(row.Loan2PayablePri))</td>
                                <td class="text-right">@(N(row.Loan2PayableInt))</td>
                                <td></td>
                                <td></td>
                                <td>@(row.Loan3AcNo ?? "")</td>
                                <td class="text-right">@(N(row.Loan3RemPrinciple))</td>
                                <td class="text-right">@(N(row.Loan3PayablePri))</td>
                                <td class="text-right">@(N(row.Loan3PayableInt))</td>
                                <td></td>
                                <td></td>
                                <td>@(row.Loan4AcNo ?? "")</td>
                                <td class="text-right">@(N(row.Loan4RemPrinciple))</td>
                                <td class="text-right">@(N(row.Loan4PayablePri))</td>
                                <td class="text-right">@(N(row.Loan4PayableInt))</td>
                                <td></td>
                                <td></td>

                                <td></td>
                            </tr>
                        }

                        <tr class="detail-row group-total">
                            <td colspan="43" class="text-right">Group Total:</td>
                            <td></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="view-outer" id="viewOuter"></div>
    }

    @if (!isView)
    {
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)

            <div class="report-subheader">
                <div class="subheader-title">Collection Sheet Report</div>
                <div class="subheader-meta">
                    <span><strong>Report Generated On :</strong> @generatedOn</span>
                    <span><strong>Till Date :</strong> @tillDate</span>
                </div>
                <table class="info-box">
                    <tr>
                        <td class="info-label">Agent Name</td>
                        <td>@(header.AgentName ?? "")</td>
                        <td class="info-label">Center Name</td>
                        <td>@(header.CollectionCenterName ?? "")</td>
                        <td class="info-label">VDC</td>
                        <td>@(header.VDCName ?? "")</td>
                        <td class="info-label">Address</td>
                        <td>@(header.Address ?? "")</td>
                    </tr>
                    <tr>
                        <td class="info-label">Contact No</td>
                        <td>@(header.ContactNo ?? "")</td>
                        <td class="info-label">Office</td>
                        <td>@(header.OfficeName ?? "")</td>
                        <td class="info-label">Date</td>
                        <td colspan="3"></td>
                    </tr>
                </table>
                <div class="subheader-spacer"></div>
            </div>
        }

        <table class="data-table" id="mainTable"
            @(isExcel ? Html.Raw("data-sheet-name=\"CollectionSheet\"") : Html.Raw(""))>
            <colgroup>
                <col class="c-sn" />
                <col class="c-mid" />
                <col class="c-mname" />
                @for (int s = 0; s < 4; s++)
                {
                    <col class="c-sac" />
                    <col class="c-sbal" />
                    <col class="c-sdep" />
                    <col class="c-swith" />
                }
                @for (int l = 0; l < 4; l++)
                {
                    <col class="c-lac" />
                    <col class="c-lpribal" />
                    <col class="c-lpaypri" />
                    <col class="c-payint" />
                    <col class="c-paidpri" />
                    <col class="c-paidint" />
                }
                <col class="c-total" />
            </colgroup>
            <thead>
                <tr>
                    <th colspan="3"></th>
                    <th colspan="16">Saving Details</th>
                    <th colspan="24">Loan Details</th>
                    <th rowspan="3">Total<br />Receive<br />Amount</th>
                </tr>
                <tr>
                    <th colspan="3"></th>
                    @for (int s = 1; s <= 4; s++)
                    {
                        <th colspan="4">Saving @s</th>
                    }
                    @for (int l = 1; l <= 4; l++)
                    {
                        <th colspan="6">Loan @l</th>
                    }
                </tr>
                <tr>
                    <th>S.N</th>
                    <th>MemberId</th>
                    <th>Member Name</th>
                    @for (int s = 0; s < 4; s++)
                    {
                        <th>AccountNo</th>
                        <th>Bal Amt</th>
                        <th>Dep Amt</th>
