@* Views/Report/Microfinance/MicrofinanceSheetReports/CenterCollectionSheetPrintReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.MicrofinanceSheetReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var header = Model["Header"] as CenterCollectionSheetHeaderDto ?? new CenterCollectionSheetHeaderDto();
    var rows = (Model["Rows"] as List<CenterCollectionSheetRowDto>) ?? new List<CenterCollectionSheetRowDto>();

    var tillDate = Model.ContainsKey("TillDateAd") && !string.IsNullOrEmpty(Model["TillDateAd"]?.ToString())
        ? Model["TillDateAd"]?.ToString()
        : Model["TillDate"]?.ToString() ?? "";

    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isView = format == "VIEW";
    var isExcel = format is "EXCEL" or "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string N(decimal? v) => (v ?? 0m).ToString("N0");

    // Grouped by member group, preserving first-appearance order — matches
    // the reference image's "Group Name: <name>" section headers.
    var groups = rows.GroupBy(r => r.GroupName ?? "Ungrouped").ToList();

    const int totalCols = 44;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Collection Sheet Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 7pt;
                background: @(isView ? "#d0d0d0" : "#fff");
                color: #000;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .report-subheader {
                width: 100%;
                padding: 4px 6px 0 6px;
                background: #fff;
            }

            .subheader-title {
                text-align: center;
                font-size: 13pt;
                font-family: "Times New Roman", Times, serif;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 4px 4px;
            }

            .subheader-meta {
                display: flex;
                justify-content: space-between;
                font-size: 8pt;
                padding: 2px 6px;
            }

            .info-box {
                border-collapse: collapse;
                width: 100%;
                margin: 4px 0;
            }

                .info-box td {
                    border: 1px solid #000;
                    padding: 3px 6px;
                    font-size: 8pt;
                }

            .info-label {
                font-weight: bold;
                white-space: nowrap;
                background: #f5f5f5;
            }

            .subheader-spacer {
                height: 6px;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 7pt;
            }

                .data-table td, .data-table th {
                    border: 1px solid #999;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 2px 3px;
                    vertical-align: middle;
                    background: #fff;
                    font-size: 7pt;
                }

            thead {
                display: table-row-group;
            }

            .data-table th {
                background: #f2f2f2;
                font-weight: bold;
                text-align: center;
            }

            .group-header td {
                font-weight: bold;
                text-decoration: underline;
                text-align: left;
                background: #fff;
                border: none;
                border-bottom: 1px solid #000;
            }

            .group-total td {
                font-weight: bold;
                background: #f9f9f9;
            }

            .detail-row td {
                color: #1a3d7c;
            }

            .grand-total td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                color: #000;
            }

            /* ── Column widths (px, view-mode wide layout) ── */
            col.c-sn {
                width: 30px;
            }

            col.c-mid {
                width: 70px;
            }

            col.c-mname {
                width: 110px;
            }

            col.c-sac {
                width: 70px;
            }

            col.c-sbal {
                width: 65px;
            }

            col.c-sdep {
                width: 55px;
            }

            col.c-swith {
                width: 55px;
            }

            col.c-lac {
                width: 65px;
            }

            col.c-lpribal {
                width: 60px;
            }

            col.c-lpaypri {
                width: 55px;
            }

            col.c-payint {
                width: 55px;
            }

            col.c-paidpri {
                width: 50px;
            }

            col.c-paidint {
                width: 50px;
            }

            col.c-total {
                width: 90px;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }

            /* ── VIEW chrome: horizontal-scroll paginated page cards ── */
            .view-outer {
                background: #d0d0d0;
                padding: 2px 16px 20px 16px;
                min-height: 100vh;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                cursor: grab;
            }

                .view-outer:active {
                    cursor: grabbing;
                }

            .view-page {
                background: #fff;
                margin: 0 auto 24px auto;
                box-shadow: 0 2px 8px rgba(0,0,0,.18);
                width: 2650px;
                height: 1587px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-page-content {
                flex: 1;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-page-footer {
                background: #fff;
                border-top: 1px solid #ccc;
                text-align: center;
                font-size: 9pt;
                font-weight: bold;
                padding: 6px 0;
                flex-shrink: 0;
            }

            .common-header-wrap {
                width: 2650px;
                overflow: hidden;
                flex-shrink: 0;
            }

            .page-subheader {
                flex-shrink: 0;
            }

            .page-table-wrap {
                flex: 1;
                overflow: hidden;
            }

            #sourceWrap {
                opacity: 0;
                pointer-events: none;
                width: 2650px;
                position: absolute;
                top: 0;
                left: 0;
            }

            #commonHeaderSource {
                visibility: hidden;
                position: absolute;
                top: 0;
                left: 0;
                width: 2650px;
                pointer-events: none;
            }
    </style>
</head>
<body>

    @if (!isExcel)
    {
        <div id="commonHeaderSource">
            @await Html.PartialAsync("_CommonHeader", Model)
        </div>
    }

    @if (isView)
    {
        <div id="sourceWrap">
            <div id="subheaderTemplate" class="report-subheader">
