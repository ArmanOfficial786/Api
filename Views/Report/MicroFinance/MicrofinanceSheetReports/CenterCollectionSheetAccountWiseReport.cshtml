@* Views/Report/Microfinance/MicrofinanceSheetReports/CenterCollectionSheetAccountWiseReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.MicrofinanceSheetReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var members = (Model["Members"] as List<CenterCollectionSheetAccountMemberDto>) ?? new List<CenterCollectionSheetAccountMemberDto>();

    var totalSaving1 = Model["TotalSaving1"] as decimal? ?? 0;
    var totalShare = Model["TotalShare"] as decimal? ?? 0;
    var totalLoan1 = Model["TotalLoan1"] as decimal? ?? 0;
    var totalLoan2 = Model["TotalLoan2"] as decimal? ?? 0;
    var totalLoan3 = Model["TotalLoan3"] as decimal? ?? 0;

    var saving1SchemeName = Model["Saving1SchemeName"]?.ToString() ?? "Saving";
    var loan1SchemeName = Model["Loan1SchemeName"]?.ToString() ?? "Loan 1";
    var loan2SchemeName = Model["Loan2SchemeName"]?.ToString() ?? "Loan 2";
    var loan3SchemeName = Model["Loan3SchemeName"]?.ToString() ?? "Loan 3";

    var agentName = Model["AgentName"]?.ToString() ?? "-";
    var meetingDate = Model["MeetingDateBs"]?.ToString() ?? "-";
    var changedDate = Model["ChangedDateBs"]?.ToString() ?? "-";
    var nextMeetingDate = Model["NextMeetingDateBs"]?.ToString() ?? "-";

    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Center Collection Sheet</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .meta-row td {
                padding: 4px 6px;
                font-size: 9pt;
                font-weight: bold;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    border: 1px solid #000;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 3px 5px;
                    vertical-align: middle;
                }

                .data-table th {
                    background: #fff;
                    text-align: center;
                    font-weight: bold;
                }

            .name-col {
                text-align: left;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .highlight-row td {
                background: #c0c0c0;
            }

            @@media print {
                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="CenterCollectionSheet">
            <colgroup>
                <col style="width:9%;" />
                <col style="width:19%;" />
                <col style="width:9%;" />
                <col style="width:8%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:10%;" />
            </colgroup>
            <tbody>
                <!-- Top meta strip -->
                <tr class="meta-row">
                    <td colspan="2">Agent Name : @agentName</td>
                    <td colspan="3">Meeting Date : @meetingDate</td>
                    <td colspan="2">Changed Date : @changedDate</td>
                    <td colspan="3">Next Meeting Date : @nextMeetingDate</td>
                </tr>

                <!-- 3-row header -->
                <tr>
                    <th rowspan="3">Member Id</th>
                    <th rowspan="3">Member Name</th>
                    <th colspan="1">Saving Balance</th>
                    <th rowspan="3">Share</th>
                    <th colspan="6">Loan Disbursement</th>
                </tr>
                <tr>
                    <th>@saving1SchemeName</th>
                    <th colspan="2">@loan1SchemeName</th>
                    <th colspan="2">@loan2SchemeName</th>
                    <th colspan="2">@loan3SchemeName</th>
                </tr>
                <tr>
                    <th></th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Amount</th>
                </tr>

                @if (members.Any())
                {
                    foreach (var row in members)
                    {
                        <tr>
                            <td>@(row.MemberId ?? "")</td>
                            <td class="name-col">@(row.MemberName ?? "")</td>
                            <td class="text-right">@(row.Saving1?.ToString("N0") ?? "0")</td>
                            <td class="text-right">@(row.Share?.ToString("N0") ?? "0")</td>
                            <td class="text-center">@(string.IsNullOrEmpty(row.Loan1Date) ? "" : row.Loan1Date)</td>
                            <td class="text-right">@(row.Loan1?.ToString("N0") ?? "0")</td>
                            <td class="text-center">@(string.IsNullOrEmpty(row.Loan2Date) ? "" : row.Loan2Date)</td>
                            <td class="text-right">@(row.Loan2?.ToString("N0") ?? "0")</td>
                            <td class="text-center">@(string.IsNullOrEmpty(row.Loan3Date) ? "" : row.Loan3Date)</td>
                            <td class="text-right">@(row.Loan3?.ToString("N0") ?? "0")</td>
                        </tr>
                    }

                    <tr>
                        <td colspan="2" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalSaving1.ToString("N0")</strong></td>
                        <td class="text-right"><strong>@totalShare.ToString("N0")</strong></td>
                        <td></td>
                        <td class="text-right"><strong>@totalLoan1.ToString("N0")</strong></td>
                        <td></td>
                        <td class="text-right"><strong>@totalLoan2.ToString("N0")</strong></td>
                        <td></td>
                        <td class="text-right"><strong>@totalLoan3.ToString("N0")</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>