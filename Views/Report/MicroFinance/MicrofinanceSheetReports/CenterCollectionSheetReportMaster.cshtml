@* Views/Report/Microfinance/MicrofinanceSheetReports/CenterCollectionSheetReportMaster.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.MicrofinanceSheetReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var schemes = (Model["Schemes"] as List<CenterCollectionSheetReportMasterDto>) ?? new List<CenterCollectionSheetReportMasterDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var canView = Model["CanView"] as bool? ?? false;
    var canModify = Model["CanModify"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Columns: SN, Saving Name, Saving Name Code, Loan Name, Loan Name Code
    // + conditional View / Modify link columns
    var colCount = 5 + (canView ? 1 : 0) + (canModify ? 1 : 0);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Center Collection Sheet Report Master</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .action-link {
                color: #0066cc;
                text-decoration: underline;
                cursor: pointer;
            }

            .empty-row {
                text-align: center;
                padding: 20px;
                color: #666;
                font-style: italic;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="CenterCollectionSheetReportMaster">
            <colgroup>
                <col style="width:6%;" />
                <col style="width:24%;" />
                <col style="width:15%;" />
                <col style="width:24%;" />
                <col style="width:15%;" />
                @if (canView)
                {
                    <col style="width:8%;" />
                }
                @if (canModify)
                {
                    <col style="width:8%;" />
                }
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="@colCount">Center Collection Sheet Report Master</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="@(colCount / 2)">
                        <strong>Total Schemes :</strong> @totalRecords
                    </td>
                    <td colspan="@(colCount - colCount / 2)" class="text-right">
                        <strong>Generated :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="@colCount"></td></tr>

                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Saving Name</th>
                    <th>Saving Name Code</th>
                    <th>Loan Name</th>
                    <th>Loan Name Code</th>
                    @if (canView)
                    {
                        <th class="text-center">View</th>
                    }
                    @if (canModify)
                    {
                        <th class="text-center">Modify</th>
                    }
                </tr>

                @if (schemes.Any())
                {
                    var sn = 0;
                    foreach (var row in schemes)
                    {
                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td class="text-center">@sn</td>
                            <td>@(row.SavingName ?? "")</td>
                            <td>@(row.SavingNameCode ?? "")</td>
                            <td>@(row.LoanName ?? "")</td>
                            <td>@(row.LoanNameCode ?? "")</td>
                            @if (canView)
                            {
                                <td class="text-center">
                                    <span class="action-link" data-id="@row.SycCollectionCenterScemeId" data-action="view">View</span>
                                </td>
                            }
                            @if (canModify)
                            {
                                <td class="text-center">
                                    <span class="action-link" data-id="@row.SycCollectionCenterScemeId" data-action="modify">Modify</span>
                                </td>
                            }
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="@(colCount - 1)" class="text-right">Total Records</td>
                        <td class="text-center">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="@colCount" class="empty-row">No Record found...</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>