@using System.Net
@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.MicrofinanceSheetReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    bool Flag(string key) => Model.TryGetValue(key, out var fv) && fv is bool fb && fb;

    var schemes = (Model["Schemes"] as IEnumerable<CenterCollectionSheetReportMasterDto>)?.ToList()
        ?? new List<CenterCollectionSheetReportMasterDto>();

    var format = Text("Format", "VIEW");
    var isExcel = format == "EXCEL" || format == "XLSX";

    // the View / Modify links only make sense on screen
    var canView = Flag("CanView") && !isExcel;
    var canModify = Flag("CanModify") && !isExcel;

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : schemes.Count;
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var colCount = 5 + (canView ? 1 : 0) + (canModify ? 1 : 0);

    string ActionLink(object? id, string action, string label) =>
        $"<span class=\"action-link\" data-id=\"{WebUtility.HtmlEncode(Convert.ToString(id))}\" data-action=\"{action}\">{label}</span>";

    var table = new ReportTable(Model, title: "Center Collection Sheet Report Master", sheetName: "CenterCollectionSheetReportMaster")
        .Column("S.N.", 6, Align.Center)
        .Column("Saving Name", 24)
        .Column("Saving Name Code", 15)
        .Column("Loan Name", 24)
        .Column("Loan Name Code", 15);
    if (canView) table.Column("View", 8, Align.Center);
    if (canModify) table.Column("Modify", 8, Align.Center);

    table.Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
         .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td, table.sheet-table tr.r-note td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            "table.sheet-table .action-link { color: #0066cc; text-decoration: underline; cursor: pointer; }");

    table.MetaPair("Total Schemes :", totalRecords.ToString(), "Generated :", generatedOn);

    var sn = 0;
    foreach (var row in schemes)
    {
        var cells = new List<ReportCell>
        {
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left(row.SavingName ?? ""),
            ReportCell.Left(row.SavingNameCode ?? ""),
            ReportCell.Left(row.LoanName ?? ""),
            ReportCell.Left(row.LoanNameCode ?? "")
        };
        if (canView) cells.Add(ReportCell.Raw(ActionLink(row.SycCollectionCenterScemeId, "view", "View"), Align.Center));
        if (canModify) cells.Add(ReportCell.Raw(ActionLink(row.SycCollectionCenterScemeId, "modify", "Modify"), Align.Center));
        table.Data(cells.ToArray());
    }

    if (schemes.Count > 0)
        table.Total("Total Records", colCount - 1, totalRecords.ToString());
    else
        table.Note("No Record found...");
}
@await Html.PartialAsync("_SheetReport", table.Build())