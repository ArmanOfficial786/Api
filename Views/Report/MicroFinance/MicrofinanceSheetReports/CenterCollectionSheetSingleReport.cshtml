@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.MicrofinanceSheetReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7pt";
    var metaFontSize = "8pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string N0<T>(T? v) where T : struct, IFormattable => v.HasValue ? v.Value.ToString("N0", null) : "";

    var rows = (Model["Rows"] as IEnumerable<CenterCollectionSheetSingleRowDto>)?.ToList() ?? new List<CenterCollectionSheetSingleRowDto>();
    var loanSummary = (Model["LoanSummary"] as IEnumerable<CenterCollectionSheetSingleLoanSummaryDto>)?.ToList() ?? new List<CenterCollectionSheetSingleLoanSummaryDto>();
    var savingSummary = (Model["SavingSummary"] as IEnumerable<CenterCollectionSheetSingleSavingSummaryDto>)?.ToList() ?? new List<CenterCollectionSheetSingleSavingSummaryDto>();
    var evaluation = Model["Evaluation"] as CenterCollectionSheetSingleEvaluationDto ?? new CenterCollectionSheetSingleEvaluationDto();

    var tillDate = Text("TillDate");
    var collectionCenterName = Text("CollectionCenterName");
    var collectionCenterAddress = Text("CollectionCenterAddress");
    var nextMeetingDate = Text("NextMeetingDate");
    var viewType = Text("ViewType", "T");
    var viewTypeName = Text("ViewTypeName", "Show Account Type");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var accountTitle = viewType == "A" ? "Account No" : "Type Code";

    // 15 columns: S.N., member (2), saving (6), loan (5), other (1). The summaries below reuse this grid with spans.
    var table = new ReportTable(Model, title: "Center Collection Single Sheet Report", sheetName: "CenterCollectionSheetSingle")
        .NoColumnHeader()
        .Column("S.N.", 3, Align.Center)
        .Column("Member Id", 6)
        .Column("Member Name", 11)
        .Column("Saving Type", 8)
        .Column(accountTitle, 8)
        .Column("Ledger", 6.5, Align.Right)
        .Column("Net", 6.5, Align.Right)
        .Column("Due", 6, Align.Right)
        .Column("Total", 6.5, Align.Right)
        .Column("Loan Type", 8)
        .Column(accountTitle, 8)
        .Column("Due Prin.", 6, Align.Right)
        .Column("Due Int.", 6, Align.Right)
        .Column("Installment", 6, Align.Right)
        .Column("Other Amt", 6.5, Align.Right)
        .Sizing(rowMm: 5, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-section td, table.sheet-table tr.r-total td, table.sheet-table tr.r-note td " +
            "{ font-size: " + fontSize + "; line-height: 1.2; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-data td.negative { color: #CC0000; }
            table.sheet-table tr.r-data td.positive { color: #006600; }");

    var centerParts = new List<IHtmlContent> { Fmt.Labeled("Center :", collectionCenterName) };
    if (!string.IsNullOrEmpty(collectionCenterAddress)) centerParts.Add(Fmt.Labeled("Address :", collectionCenterAddress));

    var dateParts = new List<IHtmlContent> { Fmt.Labeled("Collection Date :", tillDate) };
    if (!string.IsNullOrEmpty(nextMeetingDate)) dateParts.Add(Fmt.Labeled("Next Meeting :", nextMeetingDate));
    dateParts.Add(Fmt.Labeled("View :", viewTypeName));
    dateParts.Add(Fmt.Labeled("Generated :", generatedOn));

    table.MetaRow(Fmt.Join(centerParts.ToArray()))
         .MetaRow(Fmt.Join(dateParts.ToArray()));

    // ── 1. Member Saving & Loan Detail ──
    table.Section("Member Saving & Loan Detail");
    table.GroupBy(
        ReportCell.Left("", 3),
        ReportCell.Center("Saving", 6),
        ReportCell.Center("Loan", 5),
        ReportCell.Left(""));
    table.Header();

    if (rows.Count > 0)
    {
        var sn = 0;
        foreach (var row in rows)
        {
            table.Data(new[]
            {
                ReportCell.Center((++sn).ToString()),
                ReportCell.Left(row.MemberId ?? ""),
                ReportCell.Left(row.MemberName ?? ""),
                ReportCell.Left(row.SavingTypeName ?? ""),
                ReportCell.Left(row.SAccountNo ?? ""),
                ReportCell.Right(N0(row.SLedgerBalance)),
                ReportCell.Right(N0(row.SNetBalance)),
                new ReportCell(N0(row.SDueAmount), Align.Right, 1, "negative"),
                ReportCell.Right(N0(row.SGrandTotal)),
                ReportCell.Left(row.LoanTypeName ?? ""),
                ReportCell.Left(row.LoanAccountNo ?? ""),
                new ReportCell(N0(row.LDuePrinciple), Align.Right, 1, "negative"),
                new ReportCell(N0(row.LDueInterest), Align.Right, 1, "negative"),
                ReportCell.Right(row.LInstallment ?? ""),
                ReportCell.Right(N0(row.OtherAmount))
            });
        }

        table.Total("Grand Total", 3,
            "", "",
            Dec("TotalSLedgerBalance").ToString("N0"),
            Dec("TotalSNetBalance").ToString("N0"),
            Dec("TotalSDueAmount").ToString("N0"),
            Dec("TotalSGrandTotal").ToString("N0"),
            "", "",
            Dec("TotalLDuePrinciple").ToString("N0"),
            Dec("TotalLDueInterest").ToString("N0"),
            Dec("TotalLTotalInstallment").ToString("N0"),
            Dec("TotalOtherAmount").ToString("N0"));
    }
    else
    {
        table.Note("No data found");
    }

    // ── 2. Saving Summary ──
    table.Section("Saving Summary");
    table.GroupBy(
        ReportCell.Center("S.N."),
        ReportCell.Left("Saving Type", 5),
        ReportCell.Right("Ledger Balance", 4),
        ReportCell.Right("Due Amount", 5));

    if (savingSummary.Count > 0)
    {
        var sn = 0;
        foreach (var row in savingSummary)
        {
            table.Data(new[]
            {
                ReportCell.Center((++sn).ToString()),
                ReportCell.Left(row.SavingTypeName ?? "", 5),
                new ReportCell(N0(row.LedgerBalance), Align.Right, 4, "positive"),
                new ReportCell(N0(row.DueAmount), Align.Right, 5, "negative")
            });
        }

        table.GroupBy(
            ReportCell.Right("Grand Total", 6),
            ReportCell.Right(savingSummary.Sum(s => s.LedgerBalance ?? 0).ToString("N0"), 4),
            ReportCell.Right(savingSummary.Sum(s => s.DueAmount ?? 0).ToString("N0"), 5));
    }
    else
    {
        table.Note("No data found");
    }

    // ── 3. Loan Summary ──
    table.Section("Loan Summary");
    table.GroupBy(
        ReportCell.Center("S.N."),
        ReportCell.Left("Loan Type", 4),
        ReportCell.Right("Issue Amt", 2),
        ReportCell.Right("Remaining", 2),
        ReportCell.Right("Due Prin.", 2),
        ReportCell.Right("Due Int.", 2),
        ReportCell.Right("Due Pen.", 2));

    if (loanSummary.Count > 0)
    {
        var sn = 0;
        foreach (var row in loanSummary)
        {
            table.Data(new[]
            {
                ReportCell.Center((++sn).ToString()),
                ReportCell.Left(row.LoanTypeName ?? "", 4),
                ReportCell.Right(N0(row.LoanIssueAmount), 2),
                ReportCell.Right(N0(row.RemainingPrinciple), 2),
                new ReportCell(N0(row.DuePrinciple), Align.Right, 2, "negative"),
                new ReportCell(N0(row.DueInterest), Align.Right, 2, "negative"),
                new ReportCell(N0(row.DuePenalty), Align.Right, 2, "negative")
            });
        }

        table.GroupBy(
            ReportCell.Right("Grand Total", 5),
            ReportCell.Right(loanSummary.Sum(s => s.LoanIssueAmount ?? 0).ToString("N0"), 2),
            ReportCell.Right(loanSummary.Sum(s => s.RemainingPrinciple ?? 0).ToString("N0"), 2),
            ReportCell.Right(loanSummary.Sum(s => s.DuePrinciple ?? 0).ToString("N0"), 2),
            ReportCell.Right(loanSummary.Sum(s => s.DueInterest ?? 0).ToString("N0"), 2),
            ReportCell.Right(loanSummary.Sum(s => s.DuePenalty ?? 0).ToString("N0"), 2));
    }
    else
    {
        table.Note("No data found");
    }

    // ── 4. Evaluation Summary ──
    table.Section("Evaluation Summary");

    var evalRows = new (string Label, string Value)[]
    {
        ("Total Groups", evaluation.TotalGroup?.ToString("N0") ?? "0"),
        ("Total Active Groups", evaluation.TotalActiveGroup?.ToString("N0") ?? "0"),
        ("Total Members", evaluation.TotalMember?.ToString("N0") ?? "0"),
        ("Total Active Members", evaluation.TotalActiveMember?.ToString("N0") ?? "0"),
        ("Total Saving", evaluation.TotalSaving?.ToString("N0") ?? "0"),
        ("Total Loan", evaluation.TotalLoan?.ToString("N0") ?? "0"),
        ("Total Saving Members", evaluation.TotalSavingMember?.ToString("N0") ?? "0"),
        ("Total Loan Members", evaluation.TotalLoanMember?.ToString("N0") ?? "0"),
        ("Hit Kosh Balance", evaluation.HitKoshBalance?.ToString("N0") ?? "0")
    };

    foreach (var (label, value) in evalRows)
        table.Data(new[] { ReportCell.Right(label, 8), ReportCell.Right(value, 7) });

    table.GroupBy(
        ReportCell.Right("Total Collection", 8),
        ReportCell.Right(evaluation.TotalCollection?.ToString("N0") ?? "0", 7));
}
@await Html.PartialAsync("_SheetReport", table.Build())