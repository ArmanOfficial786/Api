@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.MicrofinanceSheetReports
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<CenterCollectionRowDto>) ?? new List<CenterCollectionRowDto>();
    var summary = (Model["Summary"] as List<CenterCollectionSummaryDto>) ?? new List<CenterCollectionSummaryDto>();

    var totalDeposit = Model["TotalDeposit"] as decimal? ?? 0;
    var totalWithdraw = Model["TotalWithdraw"] as decimal? ?? 0;
    var totalLoanPrinciple = Model["TotalLoanPrinciple"] as decimal? ?? 0;
    var totalLoan = Model["TotalLoan"] as decimal? ?? 0;

    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // ── Group detail rows by member, sorted for deterministic display —
    // the SP's final SELECT has no ORDER BY, so ordering here is what
    // guarantees a stable, alphabetical member sequence on every render.
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.MemberName })
        .OrderBy(g => g.Key.MemberId, StringComparer.OrdinalIgnoreCase)
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Center Collection Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8pt;
                table-layout: fixed;
                margin-bottom: 20px;
            }

                .data-table td,
                .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                    border: 1px solid #000;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
                border: none;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                border: none;
            }

            .group-header th {
                background: #fff;
                text-align: center;
                font-weight: bold;
                border: 1px solid #000;
            }

            .data-table th {
                background: #f9f9f9;
                text-align: left;
                white-space: normal;
            }

            .subtotal-row td {
                font-weight: bold;
            }

            .grand-total-row td {
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        @* ==================== Title & Meta ==================== *@
        <table class="data-table" style="margin-bottom:6px;">
            <tbody>
                <tr class="meta-title">
                    <td colspan="2">Center Collection Report</td>
                </tr>
                <tr class="meta-row">
                    <td><strong>Report Generated On:</strong> @generatedOn</td>
                    <td class="text-right"><strong>Date :</strong> @tillDate</td>
                </tr>
                <tr class="meta-row">
                    <td></td>
                    <td class="text-right"><strong>Collection Center :</strong> @collectionCenterName</td>
                </tr>
            </tbody>
        </table>

        @* ==================== Table 1: Member-wise Saving/Loan Detail ==================== *@
        <table class="data-table" data-sheet-name="CenterCollectionDetail">
            <colgroup>
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:10%;" />
                <col style="width:10%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:10%;" />
                <col style="width:9%;" />
                <col style="width:8%;" />
                <col style="width:9%;" />
            </colgroup>
            <thead>
                <tr class="group-header">
                    <th colspan="4">Saving</th>
                    <th colspan="6">Loan</th>
                </tr>
                <tr>
                    <th>Account No.</th>
                    <th>Deposit Type</th>
                    <th class="text-right">Deposit</th>
                    <th class="text-right">Withdraw</th>
                    <th>Account No.</th>
                    <th>Loan Type</th>
                    <th class="text-right">Principle</th>
                    <th class="text-right">Interest</th>
                    <th class="text-right">Penalty</th>
                    <th class="text-right">Total</th>
                </tr>
            </thead>
            <tbody>
                @if (memberGroups.Any())
                {
                    foreach (var group in memberGroups)
                    {
                        foreach (var row in group)
                        {
                            <tr>
                                <td>@(row.SAccountNo ?? "")</td>
                                <td>@(row.SAccountTypeName ?? "")</td>
                                <td class="text-right">@(row.SCashReceived?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.SCashWithdrawl?.ToString("N2") ?? "")</td>
                                <td>@(row.LAccountNo ?? "")</td>
                                <td>@(row.LAccountTypeName ?? "")</td>
                                <td class="text-right">@(row.LoanPrinciple?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.LoanInterest?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.LoanPenalty?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.TotalLoan?.ToString("N2") ?? "")</td>
                            </tr>
                        }

                        var gDeposit = group.Sum(r => r.SCashReceived ?? 0);
                        var gWithdraw = group.Sum(r => r.SCashWithdrawl ?? 0);
                        var gPrinciple = group.Sum(r => r.LoanPrinciple ?? 0);
                        var gTotal = group.Sum(r => r.TotalLoan ?? 0);

                        <tr class="subtotal-row">
                            <td colspan="2"></td>
                            <td class="text-right">D: @gDeposit.ToString("N2")</td>
                            <td class="text-right">W: @gWithdraw.ToString("N2")</td>
                            <td colspan="2"></td>
                            <td class="text-right">L: @gPrinciple.ToString("N2")</td>
                            <td colspan="2"></td>
                            <td class="text-right">T: @gTotal.ToString("N2")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="2" class="text-right">Total :</td>
                        <td class="text-right">D: @totalDeposit.ToString("N2")</td>
                        <td class="text-right">W: @totalWithdraw.ToString("N2")</td>
                        <td colspan="2"></td>
                        <td class="text-right">L: @totalLoanPrinciple.ToString("N2")</td>
                        <td colspan="2"></td>
                        <td class="text-right">T: @totalLoan.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="10" class="text-center">No data found</td></tr>
                }
            </tbody>
        </table>

        @* ==================== Table 2: Account-Type Summary ==================== *@
        <table class="data-table" data-sheet-name="CenterCollectionSummary">
            <colgroup>
                <col style="width:5%;" />
                <col style="width:19%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:19%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:10%;" />
            </colgroup>
            <thead>
                <tr class="group-header">
                    <th></th>
                    <th colspan="3">Saving</th>
                    <th colspan="5">Loan</th>
                </tr>
                <tr>
                    <th class="text-center">SN</th>
                    <th>Account Type</th>
                    <th class="text-right">Deposit</th>
                    <th class="text-right">WithDraw</th>
                    <th>Account Type</th>
                    <th class="text-right">Principle</th>
                    <th class="text-right">Interest</th>
                    <th class="text-right">Penalty</th>
                    <th class="text-right">TotalLoan</th>
                </tr>
            </thead>
            <tbody>
                @if (summary.Any())
                {
                    var sn = 0;
                    foreach (var row in summary)
                    {
                        sn++;
                        <tr>
                            <td class="text-center">@sn</td>
                            <td>@(row.SAccountTypeName ?? "")</td>
                            <td class="text-right">@(row.Deposit?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.WithDraw?.ToString("N2") ?? "")</td>
                            <td>@(row.LAccountTypeName ?? "")</td>
                            <td class="text-right">@(row.Principle?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Interest?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Penalty?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.TotalLoan?.ToString("N2") ?? "")</td>
                        </tr>
                    }
                    <tr class="grand-total-row">
                        <td colspan="2" class="text-right">Grand Total :</td>
                        <td class="text-right">@summary.Sum(s => s.Deposit ?? 0).ToString("N2")</td>
                        <td class="text-right">@summary.Sum(s => s.WithDraw ?? 0).ToString("N2")</td>
                        <td></td>
                        <td class="text-right">@summary.Sum(s => s.Principle ?? 0).ToString("N2")</td>
                        <td class="text-right">@summary.Sum(s => s.Interest ?? 0).ToString("N2")</td>
                        <td class="text-right">@summary.Sum(s => s.Penalty ?? 0).ToString("N2")</td>
                        <td class="text-right">@summary.Sum(s => s.TotalLoan ?? 0).ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="9" class="text-center">No data found</td></tr>
                }
            </tbody>
        </table>

    </div>
</body>
</html>