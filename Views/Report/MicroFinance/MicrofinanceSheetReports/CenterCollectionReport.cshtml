@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Microfinance.MicrofinanceSheetReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    const int ColumnCount = 10;   // number of .Column(...) lines below; every block below must add up to 10 columns

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a missing amount prints blank in the rows; totals always print two decimals
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";
    string N2(decimal v) => v.ToString("N2");

    var rows = (Model["Rows"] as List<CenterCollectionRowDto>) ?? new List<CenterCollectionRowDto>();
    var summary = (Model["Summary"] as List<CenterCollectionSummaryDto>) ?? new List<CenterCollectionSummaryDto>();

    var tillDate = Text("TillDate");
    var collectionCenterName = Text("CollectionCenterName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // ── totals (from the controller, or summed from the rows) ──
    var totalDeposit = TotalOr("TotalDeposit", rows.Sum(r => r.SCashReceived ?? 0));
    var totalWithdraw = TotalOr("TotalWithdraw", rows.Sum(r => r.SCashWithdrawl ?? 0));
    var totalLoanPrinciple = TotalOr("TotalLoanPrinciple", rows.Sum(r => r.LoanPrinciple ?? 0));
    var totalLoan = TotalOr("TotalLoan", rows.Sum(r => r.TotalLoan ?? 0));

    // detail rows grouped by member, sorted so the member order is the same on every render
    // (the stored procedure's final select has no ORDER BY)
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.MemberName })
        .OrderBy(g => g.Key.MemberId, StringComparer.OrdinalIgnoreCase)
        .ToList();

    // ── cell helpers: text, span ──
    ReportCell T(string text, int span = 1, string? css = null) => new(text, Align.Left, span, css);
    ReportCell R(string text, int span = 1, string? css = null) => new(text, Align.Right, span, css);
    ReportCell C(string text, int span = 1, string? css = null) => new(text, Align.Center, span, css);

    // one 10-column grid for the whole report: the member detail block uses all 10 columns,
    // the summary block joins columns with spans
    var table = new ReportTable(Model, title: "Center Collection Report", sheetName: "CenterCollection")
        .Column("Account No.", 11)
        .Column("Deposit Type", 11)
        .Column("Deposit", 10, Align.Right)
        .Column("Withdraw", 10, Align.Right)
        .Column("Account No.", 11)
        .Column("Loan Type", 11)
        .Column("Principle", 10, Align.Right)
        .Column("Interest", 9, Align.Right)
        .Column("Penalty", 8, Align.Right)
        .Column("Total", 9, Align.Right)
        .NoColumnHeader()                     // every block writes its own header
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; border: 1px solid #000; }\n" +
            // header line of the summary block (a group row styled like a header)
            "table.sheet-table tr.r-group td.sub-head { background: #f9f9f9; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Report Generated On:", generatedOn), Fmt.Labeled("Date :", tillDate));
    table.MetaRow(HtmlString.Empty, Fmt.Labeled("Collection Center :", collectionCenterName));

    // ═══ Block 1: member saving / loan detail (all 10 columns) ═══
    table.GroupBy(C("Saving", 4), C("Loan", 6));
    table.Header("Account No.", "Deposit Type", "Deposit", "Withdraw",
                 "Account No.", "Loan Type", "Principle", "Interest", "Penalty", "Total");

    if (memberGroups.Count > 0)
    {
        foreach (var group in memberGroups)
        {
            foreach (var row in group)
            {
                table.Data(
                    row.SAccountNo ?? "",
                    row.SAccountTypeName ?? "",
                    N(row.SCashReceived),
                    N(row.SCashWithdrawl),
                    row.LAccountNo ?? "",
                    row.LAccountTypeName ?? "",
                    N(row.LoanPrinciple),
                    N(row.LoanInterest),
                    N(row.LoanPenalty),
                    N(row.TotalLoan));
            }

            // member total: an empty label over the first 2 columns, then D / W / L / T in their own columns
            table.SubTotal("", 2,
                "D: " + N2(group.Sum(r => r.SCashReceived ?? 0)),
                "W: " + N2(group.Sum(r => r.SCashWithdrawl ?? 0)),
                "", "",
                "L: " + N2(group.Sum(r => r.LoanPrinciple ?? 0)),
                "", "",
                "T: " + N2(group.Sum(r => r.TotalLoan ?? 0)));
        }

        table.Total("Total :", 2,
            "D: " + N2(totalDeposit),
            "W: " + N2(totalWithdraw),
            "", "",
            "L: " + N2(totalLoanPrinciple),
            "", "",
            "T: " + N2(totalLoan));
    }
    else
    {
        table.Data(C("No data found", ColumnCount));
    }

    table.Spacer();

    // ═══ Block 2: account type summary (SN | Account Type | Deposit | Withdraw | Account Type (2) | Principle | Interest | Penalty | TotalLoan) ═══
    table.GroupBy(C("", 1), C("Saving", 3), C("Loan", 6));
    table.GroupBy(
        C("SN", 1, "sub-head"), T("Account Type", 1, "sub-head"), R("Deposit", 1, "sub-head"), R("WithDraw", 1, "sub-head"),
        T("Account Type", 2, "sub-head"),
        R("Principle", 1, "sub-head"), R("Interest", 1, "sub-head"), R("Penalty", 1, "sub-head"), R("TotalLoan", 1, "sub-head"));

    if (summary.Count > 0)
    {
        var sn = 0;
        foreach (var row in summary)
        {
            sn++;
            table.Data(
                C(sn.ToString()),
                T(row.SAccountTypeName ?? ""),
                R(N(row.Deposit)),
                R(N(row.WithDraw)),
                T(row.LAccountTypeName ?? "", 2),
                R(N(row.Principle)),
                R(N(row.Interest)),
                R(N(row.Penalty)),
                R(N(row.TotalLoan)));
        }

        // label spans the first 2 columns; the 8 values fill the rest (the 2 empty ones sit under the loan account type)
        table.Total("Grand Total :", 2,
            N2(summary.Sum(s => s.Deposit ?? 0)),
            N2(summary.Sum(s => s.WithDraw ?? 0)),
            "", "",
            N2(summary.Sum(s => s.Principle ?? 0)),
            N2(summary.Sum(s => s.Interest ?? 0)),
            N2(summary.Sum(s => s.Penalty ?? 0)),
            N2(summary.Sum(s => s.TotalLoan ?? 0)));
    }
    else
    {
        table.Data(C("No data found", ColumnCount));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())