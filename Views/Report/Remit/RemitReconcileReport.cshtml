@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Remit
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // any property type prints as its text; a missing value prints blank (same as before)
    string S(object? v) => v?.ToString() ?? "";

    var rows = (Model["Rows"] as List<RemitReconcileReportRowDto>) ?? new List<RemitReconcileReportRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var remittanceGroupName = Text("RemittanceGroupName", "All");
    var reportType = Text("ReportType", "A");
    var reportTypeLabel = reportType == "P" ? "PAID" : (reportType == "C" ? "CANCEL" : "ALL");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalPaid = (int)TotalOr("TotalPaid", 0);
    var totalCancelled = (int)TotalOr("TotalCancelled", 0);
    var totalPayoutAmount = TotalOr("TotalPayoutAmount", 0);
    var totalPayoutCommission = TotalOr("TotalPayoutCommission", 0);

    var table = new ReportTable(Model, title: "Online Remittance Reconcile Report", sheetName: "RemitReconcileReport")
        .Column("S.N.", 3, Align.Center)
        .Column("Pin No", 8)
        .Column("Sender", 10)
        .Column("Receiver", 10)
        .Column("Mode", 7)
        .Column("Payout Amt", 9, Align.Right)
        .Column("Commission", 9, Align.Right)
        .Column("Trans Date", 8)
        .Column("Status", 8)
        .Column("Paid Date", 8)
        .Column("Payment Type", 8)
        .Column("Agent", 6)
        .Column("Branch", 6)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 10, firstPageExtraMm: 75)   // column titles may wrap to two lines
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 4px; }" +
            // column titles may wrap and sit at the bottom of the cell, as in the old report
            "table.sheet-table tr.r-header th { white-space: normal; line-height: 1.2; vertical-align: bottom; }" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #ccc; }" +
            // serial number in grey
            "table.sheet-table tr.r-data td:first-child { color: #555; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(
        Fmt.Labeled("From Date :", fromDate),
        Fmt.Labeled("Till Date :", toDate),
        Fmt.Labeled("Remittance Group :", remittanceGroupName),
        Fmt.Labeled("Report Type :", reportTypeLabel)));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // ── rows ──
    var sn = 0;
    foreach (var row in rows)
    {
        sn++;
        table.Data(
            sn.ToString(),
            S(row.PinNo),
            S(row.SenderName),
            S(row.ReceiverName),
            S(row.TransactionMode),
            S(row.PayoutAmount),
            S(row.PayoutCommission),
            S(row.TransactionDate),
            S(row.Status),
            S(row.PaidDate),
            S(row.PaymentType),
            S(row.AgentName),
            S(row.AgentBranch));
    }

    // label spans the first 5 columns; the two amounts fill columns 6 and 7; the other 6 columns stay empty
    if (rows.Count > 0)
    {
        table.Total($"Total Records: {totalRecords}  |  Paid: {totalPaid}  |  Cancelled: {totalCancelled}", 5,
            totalPayoutAmount.ToString("N2"),
            totalPayoutCommission.ToString("N2"),
            "", "", "", "", "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())