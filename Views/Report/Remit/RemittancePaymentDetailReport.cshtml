@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Remit
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a missing amount prints 0.00 (same as before)
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<RemittancePaymentDetailRowDto>) ?? new List<RemittancePaymentDetailRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var remittanceTypeName = Text("RemittanceTypeName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.Amount ?? 0m));

    // grouped by Receiver: the receiver is a bold line, then one row per payment, then a "Total :" line;
    // rows must arrive pre-sorted by Receiver (the repository's ORDER BY), because GroupBy keeps first-seen order, not sorted order
    var receiverGroups = rows.GroupBy(r => r.Receiver ?? "").ToList();

    var table = new ReportTable(Model, title: "Remittance Payment Detail Reports", sheetName: "RemittancePaymentDetail")
        .Column("Receiver", 14)
        .Column("Sender", 16)
        .Column("Payment By", 20)
        .Column("Payment Amount (Rs)", 16, Align.Right)
        .Column("Date", 16)
        .Column("Cash Teller", 18)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "body { font-family: \"Times New Roman\", Times, serif; } " +
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; vertical-align: top; }" +
            // receiver line and payment rows: no rules
            "table.sheet-table tr.r-group td, table.sheet-table tr.r-data td { border: 0; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("RemittanceType :", remittanceTypeName),
        Fmt.Join(Fmt.Labeled("From Date:", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Labeled("Branch Name :", branchName));

    // ── rows: one group per receiver ──
    foreach (var group in receiverGroups)
    {
        var groupRows = group.ToList();

        table.GroupTitle(group.Key);

        foreach (var row in groupRows)
        {
            table.Data(
                "",
                row.Sender ?? "",
                row.PaymentBy ?? "",
                N(row.Amount),
                row.Date ?? "",
                row.CashTeller ?? "");
        }

        // label spans the first 3 columns; the total fills Payment Amount; the last 2 columns stay empty
        table.SubTotal("Total :", 3, N(groupRows.Sum(r => r.Amount ?? 0m)), "", "");
    }

    // label spans the first 3 columns; the total fills Payment Amount; the last 2 columns stay empty
    if (rows.Count > 0)
    {
        table.Total("Grand Total", 3, totalAmount.ToString("N2"), "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())