@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Remit
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a missing amount prints blank (same as before); totals always print two decimals
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<RemitReceiptPrintRowDto>) ?? new List<RemitReceiptPrintRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var isReceived = Text("IsReceived", "0");
    var amountInWords = Text("AmountInWords");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var transactionAmount = TotalOr("TransactionAmount", rows.Sum(r => r.TransactionAmount ?? 0m));

    var table = new ReportTable(Model, title: "Remit Receipt Print Report", sheetName: "RemitReceiptPrint")
        .Column("S.N.", 4, Align.Center)
        .Column("IME Code No", 11)
        .Column("Sender Name", 11)
        .Column("Name", 14)
        .Column("Country", 9)
        .Column("Receiver Name", 14)
        .Column("Receiver Address", 14)
        .Column("Date", 9)
        .Column("Amount", 8, Align.Right)
        .Column("Entry By", 6)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 10, firstPageExtraMm: 75)   // column titles may wrap to two lines
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }" +
            // column titles may wrap and sit at the bottom of the cell, as in the old report
            "table.sheet-table tr.r-header th { white-space: normal; line-height: 1.2; vertical-align: bottom; }" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #ccc; }" +
            // serial number in grey
            "table.sheet-table tr.r-data td:first-child { color: #555; }" +
            // "Amount in Words" line: italic with a rule above it
            "table.sheet-table td.wd { font-style: italic; border-top: 1px solid #000 !important; border-bottom: 0 !important; padding-top: 5px; padding-bottom: 5px; }" +
            "table.sheet-table td.wl { font-style: normal; font-weight: bold; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(
        Fmt.Labeled("From Date :", fromDate),
        Fmt.Labeled("Till Date :", toDate),
        Fmt.Labeled("Receipt Type :", isReceived == "1" ? "Received" : "Payment")));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // ── rows ──
    var sn = 0;
    foreach (var row in rows)
    {
        sn++;
        table.Data(
            sn.ToString(),
            row.IMECodeNo ?? "",
            row.SenderName ?? "",
            row.Name ?? "",
            row.Country ?? "",
            row.ReceiverName ?? "",
            row.ReceiverAddress ?? "",
            row.TransactionOnBs ?? "",
            N(row.TransactionAmount),
            row.EntryBy ?? "");
    }

    if (rows.Count > 0)
    {
        // label spans the first 8 columns; the amount fills column 9; Entry By stays empty
        table.Total("Total Records: " + totalRecords, 8, transactionAmount.ToString("N2"), "");

        // amount in words: bold label across 2 columns, italic value across the other 8
        table.Data(
            new ReportCell("Amount in Words :", Align.Left, 2, "wd wl"),
            new ReportCell(amountInWords, Align.Left, 8, "wd"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())