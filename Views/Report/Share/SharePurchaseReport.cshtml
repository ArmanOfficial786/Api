@using NexgenCosysReport.Dtos.RequestDtos.Share

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<SharePurchaseRowDto>) ?? new List<SharePurchaseRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalMembers = Model.ContainsKey("TotalMembers") ? (Model["TotalMembers"] as int? ?? 0) : 0;
    var totalNoShare = Model.ContainsKey("TotalNoShare") ? (Model["TotalNoShare"] as decimal? ?? 0) : 0;
    var totalAmount = Model.ContainsKey("TotalAmount") ? (Model["TotalAmount"] as decimal? ?? 0) : 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var officeName = Model["OfficeName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

   
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.Name })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Share Purchase Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .report-title {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            /* Own auto-layout table for the subheader so labels never wrap
                           or overlap — same fix applied throughout this thread. */
            .meta-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 6px;
            }

                .meta-table td {
                    padding: 3px 6px;
                    font-size: 9pt;
                    white-space: nowrap;
                    vertical-align: top;
                }

            .meta-left {
                text-align: left;
                width: 50%;
            }

            .meta-right {
                text-align: right;
                width: 50%;
            }

            .meta-spacer td {
                height: 8px;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

                .data-table th {
                    border-top: none;
                    border-bottom: 1px solid #000;
                    text-align: left;
                    white-space: normal;
                    font-weight: bold;
                }

                    .data-table th.text-right,
                    .data-table td.text-right {
                        text-align: right;
                    }

            .member-row td {
                font-weight: bold;
                padding-top: 8px;
                padding-bottom: 2px;
                border: none;
            }

            .member-row.first-group td {
                padding-top: 2px;
            }

            .detail-row td {
                padding-left: 20px;
                border: none;
            }

            .subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 3px;
                padding-bottom: 6px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">Share Purchase Report</div>

        <table class="meta-table">
            <tr>
                <td class="meta-left"><strong>Report Generated On :</strong> @generatedOn</td>
                <td class="meta-right"><strong>From Date :</strong> @fromDate &nbsp;&nbsp;&nbsp; <strong>To Date :</strong> @toDate</td>
            </tr>
            <tr>
                <td class="meta-left"></td>
                <td class="meta-right"><strong>Branch Name :</strong> @officeName</td>
            </tr>
            <tr class="meta-spacer"><td colspan="2"></td></tr>
        </table>

        <table class="data-table" data-sheet-name="SharePurchase">
            <colgroup>
                <col style="width:11%;" />
                <col style="width:16%;" />
                <col style="width:16%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:13%;" />
            </colgroup>
            <tbody>
                <tr>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Group</th>
                    <th class="text-right">No of Share</th>
                    <th>Share From</th>
                    <th>Share To</th>
                    <th>Date</th>
                    <th class="text-right">Amount (Rs)</th>
                </tr>

                @if (memberGroups.Any())
                {
                    bool isFirstGroup = true;
                    foreach (var group in memberGroups)
                    {
                        var groupRows = group.ToList();

                        <tr class="member-row @(isFirstGroup ? "first-group" : "")">
                            <td>@(group.Key.MemberId ?? "")</td>
                            <td colspan="7">@(group.Key.Name ?? "")</td>
                        </tr>
                        isFirstGroup = false;

                        foreach (var row in groupRows)
                        {
                            <tr class="detail-row">
                                <td></td>
                                <td>@(row.ShareType ?? "")</td>
                                <td>@(row.MemberGroup ?? "")</td>
                                <td class="text-right">@(row.TotalNoShare?.ToString("N0") ?? "")</td>
                                <td>@(row.ShareFrom ?? "")</td>
                                <td>@(row.ShareTO ?? "")</td>
                                <td>@(row.Date ?? "")</td>
                                <td class="text-right">@(row.Amount?.ToString("N2") ?? "")</td>
                            </tr>
                        }

                        <tr class="subtotal-row">
                            <td></td>
                            <td>@(group.Key.Name ?? "")</td>
                            <td></td>
                            <td class="text-right">@groupRows.Sum(r => r.TotalNoShare ?? 0).ToString("N2")</td>
                            <td colspan="3"></td>
                            <td class="text-right">@groupRows.Sum(r => r.Amount ?? 0).ToString("N2")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="3" class="text-right">
                            Total Members: @totalMembers &nbsp;&nbsp;
                        </td>
                        <td class="text-right">@totalNoShare.ToString("N0")</td>
                        <td colspan="3"></td>
                        <td class="text-right">@totalAmount.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>