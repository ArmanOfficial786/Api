@using NexgenCosysReport.Dtos.RequestDtos.Share;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<CopomisRowDto>) ?? new List<CopomisRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalMembers = Model.ContainsKey("TotalMembers") ? (Model["TotalMembers"] as int? ?? 0) : 0;
    var totalShareNo = Model.ContainsKey("TotalShareNo") ? (Model["TotalShareNo"] as decimal? ?? 0) : 0;
    var totalShareAmount = Model.ContainsKey("TotalShareAmount") ? (Model["TotalShareAmount"] as decimal? ?? 0) : 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "All";
    var memberTypeName = Model["MemberTypeName"]?.ToString() ?? "All";
    var showMemberPhoto = Model["ShowMemberPhoto"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Copomis Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 3px 4px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                text-align: left;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
            }

            .detail-row td {
                border-bottom: 1px solid #ccc;
            }

            .sn-col {
                text-align: center;
                color: #555;
            }

            .photo-cell {
                text-align: center;
            }

                .photo-cell img {
                    max-width: 60px;
                    max-height: 70px;
                }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="Copomis">
            <colgroup>
                <col style="width:3%;" />
                <col style="width:9%;" />
                <col style="width:14%;" />
                @if (showMemberPhoto)
                {
                    <col style="width:6%;" />
                }
                <col style="width:5%;" />
                <col style="width:4%;" />
                <col style="width:8%;" />
                <col style="width:10%;" />
                <col style="width:9%;" />
                <col style="width:11%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="@(showMemberPhoto ? 12 : 11)">Copomis Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="@(showMemberPhoto ? 12 : 11)"><strong>Branch :</strong> @branchName</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="@(showMemberPhoto ? 12 : 11)">
                        <strong>Till Date :</strong> @tillDate
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <strong>Collection Center :</strong> @collectionCenterName
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <strong>Member Group :</strong> @memberGroupName
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <strong>Member Type :</strong> @memberTypeName
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="@(showMemberPhoto ? 12 : 11)"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="@(showMemberPhoto ? 12 : 11)"></td></tr>

                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Member ID</th>
                    <th>Member Name</th>
                    @if (showMemberPhoto)
                    {
                        <th class="text-center">Photo</th>
                    }
                    <th>Gender</th>
                    <th class="text-right">Age</th>
                    <th>Registration</th>
                    <th>Contact</th>
                    <th>Address</th>
                    <th>Father / Mother</th>
                    <th class="text-right">Share No</th>
                    <th class="text-right">Amount</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        var address = string.Join(", ", new[]
                        {
                            row.Tole, row.WardNo, row.VDCName, row.DistrictName
                        }.Where(s => !string.IsNullOrWhiteSpace(s) && s != "-"));

                        var contact = string.Join(", ", new[]
                        {
                            row.MobileNo, row.PhoneNo
                        }.Where(s => !string.IsNullOrWhiteSpace(s) && s != "-"));

                        var parents = string.Join(" / ", new[]
                        {
                            row.FatherName, row.MotherName
                        }.Where(s => !string.IsNullOrWhiteSpace(s) && s != "-"));

                        <tr class="detail-row">
                            <td class="sn-col">@sn</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            @if (showMemberPhoto)
                            {
                                <td class="photo-cell">
                                    @if (!string.IsNullOrEmpty(row.MemberImage))
                                    {
                                        <img src="data:image/jpeg;base64,@row.MemberImage" alt="" />
                                    }
                                </td>
                            }
                            <td>@(row.Gender ?? "")</td>
                            <td class="text-right">@(row.Age?.ToString() ?? "")</td>
                            <td>@(row.RegistrationOnBS ?? "")</td>
                            <td>@contact</td>
                            <td>@address</td>
                            <td>@parents</td>
                            <td class="text-right">@(row.ShareNo?.ToString("N0") ?? "")</td>
                            <td class="text-right">@(row.TotalShareAmt?.ToString("N2") ?? "")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="@(showMemberPhoto ? 10 : 9)" class="text-right">
                            Total Members: @totalMembers &nbsp;&nbsp;|&nbsp;&nbsp; Total Records: @totalRecords
                        </td>
                        <td class="text-right">@totalShareNo.ToString("N0")</td>
                        <td class="text-right">@totalShareAmount.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="@(showMemberPhoto ? 12 : 11)" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>