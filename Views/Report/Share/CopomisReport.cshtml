@using NexgenCosysReport.Dtos.RequestDtos.Share
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";
    var metaFontSize = "8pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string JoinParts(string sep, params string?[] parts) =>
        string.Join(sep, parts.Where(s => !string.IsNullOrWhiteSpace(s) && s != "-"));

    var showPhoto = Model.TryGetValue("ShowMemberPhoto", out var sp) && sp is bool spb && spb;

    var rows = (Model["Rows"] as IEnumerable<CopomisRowDto>)?.ToList() ?? new List<CopomisRowDto>();
    var tillDate = Text("TillDate");
    var branchName = Text("BranchName", "All");
    var collectionCenterName = Text("CollectionCenterName", "All");
    var memberGroupName = Text("MemberGroupName", "All");
    var memberTypeName = Text("MemberTypeName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;
    var totalMembers = Model.TryGetValue("TotalMembers", out var tm) && tm != null && Convert.ToInt32(tm) > 0
        ? Convert.ToInt32(tm)
        : rows.Select(r => r.MemberId).Distinct().Count();
    var totalShareNo = Dec("TotalShareNo");
    var totalShareAmount = Dec("TotalShareAmount");

    // ── columns (the Photo column exists only when photos are requested) ──
    var table = new ReportTable(Model, title: "Copomis Report", sheetName: "Copomis")
        .Column("S.N.", 3, Align.Center)
        .Column("Member ID", 9)
        .Column("Member Name", 14);
    if (showPhoto) table.Column("Photo", 6, Align.Center);
    table.Column("Gender", 5)
         .Column("Age", 4, Align.Right)
         .Column("Registration", 8)
         .Column("Contact", 10)
         .Column("Address", 12)
         .Column("Father / Mother", 11)
         .Column("Share No", 9, Align.Right)
         .Column("Amount", 9, Align.Right);

    // photo rows are taller (a 13 mm picture needs about 16 mm of row)
    table.Sizing(rowMm: showPhoto ? 16 : 6, headerMm: 8, firstPageExtraMm: 75)
         .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    // ── title block ──
    table.MetaRow(Fmt.Join(
            Fmt.Labeled("Branch :", branchName),
            Fmt.Labeled("Till Date :", tillDate),
            Fmt.Labeled("Report Generated On :", generatedOn)))
         .MetaRow(Fmt.Join(
            Fmt.Labeled("Collection Center :", collectionCenterName),
            Fmt.Labeled("Member Group :", memberGroupName),
            Fmt.Labeled("Member Type :", memberTypeName)));

    // ── rows ──
    var sn = 0;
    foreach (var row in rows)
    {
        var cells = new List<ReportCell>
        {
            ReportCell.Center((++sn).ToString()),
            ReportCell.Left(row.MemberId ?? ""),
            ReportCell.Left(row.MemberName ?? "")
        };
        if (showPhoto) cells.Add(ReportCell.Image(row.MemberImage));
        cells.Add(ReportCell.Left(row.Gender ?? ""));
        cells.Add(ReportCell.Right(row.Age?.ToString() ?? ""));
        cells.Add(ReportCell.Left(row.RegistrationOnBS ?? ""));
        cells.Add(ReportCell.Left(JoinParts(", ", row.MobileNo, row.PhoneNo)));
        cells.Add(ReportCell.Left(JoinParts(", ", row.Tole, row.WardNo, row.VDCName, row.DistrictName)));
        cells.Add(ReportCell.Left(JoinParts(" / ", row.FatherName, row.MotherName)));
        cells.Add(ReportCell.Right(row.ShareNo?.ToString("N0") ?? ""));
        cells.Add(ReportCell.Right(row.TotalShareAmt?.ToString("N2") ?? ""));
        table.Data(cells.ToArray());
    }

    // ── total: the label spans every column before Share No; the two values fill the last two ──
    if (rows.Count > 0)
    {
        table.Total($"Total Members: {totalMembers}  |  Total Records: {totalRecords}",
            showPhoto ? 10 : 9,
            totalShareNo.ToString("N0"), totalShareAmount.ToString("N2"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())