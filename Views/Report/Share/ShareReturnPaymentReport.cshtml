@using NexgenCosysReport.Dtos.RequestDtos.Share
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 9;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<ShareReturnPaymentRowDto>) ?? new List<ShareReturnPaymentRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("OfficeName", Text("BranchName", "All"));
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalMembers = (int)TotalOr("TotalMembers", rows.Select(r => r.MemberId).Distinct().Count());
    var totalCashAmount = TotalOr("TotalCashAmount", rows.Sum(r => r.CashAmount ?? 0));
    var totalTaxAmount = TotalOr("TotalTaxAmount", rows.Sum(r => r.TaxAmount ?? 0));
    var totalBonusShareAmount = TotalOr("TotalBonusShareAmount", rows.Sum(r => r.BonusShareAmount ?? 0));

    var table = new ReportTable(Model, title: "Share Return Payment Report", sheetName: "ShareReturnPayment")
        .Column("S.N.", 4, Align.Center)
        .Column("Member ID", 11)
        .Column("Member Name", 20)
        .Column("Pan/VAT No", 10)
        .Column("Account No", 12)
        .Column("Cash Amount", 12, Align.Right)
        .Column("Tax Amount", 12, Align.Right)
        .Column("Bonus Share Amount", 12, Align.Right)
        .Column("Transaction Date", 9)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 9, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: normal; vertical-align: bottom; line-height: 1.2; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #ccc; }\n" +
            ".sn-col { color: #555; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("Till Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    table.Header();

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            new ReportCell((++sn).ToString(), Align.Center, 1, "sn-col"),
            ReportCell.Left(row.MemberId ?? ""),
            ReportCell.Left(row.MemberName ?? ""),
            ReportCell.Left(row.PanVatNo ?? ""),
            ReportCell.Left(row.AccountNo ?? ""),
            ReportCell.Right(row.CashAmount?.ToString("N2") ?? ""),
            ReportCell.Right(row.TaxAmount?.ToString("N2") ?? ""),
            ReportCell.Right(row.BonusShareAmount?.ToString("N2") ?? ""),
            ReportCell.Left(row.TransactionOnBs ?? ""));
    }

    if (rows.Count > 0)
    {
        table.Total(
            $"Total Members: {totalMembers}   |   Total Records: {totalRecords}", 4,
            "",
            totalCashAmount.ToString("N2"),
            totalTaxAmount.ToString("N2"),
            totalBonusShareAmount.ToString("N2"),
            "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())