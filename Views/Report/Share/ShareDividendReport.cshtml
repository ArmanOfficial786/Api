@using NexgenCosysReport.Dtos.RequestDtos.Share
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    decimal Amount(string key) =>
        Model.TryGetValue(key, out var value) && value != null ? Convert.ToDecimal(value) : 0m;

    var rows = (Model["Rows"] as IEnumerable<ShareDividendRowDto>)?.ToList()
        ?? new List<ShareDividendRowDto>();

    var totalRecords = Amount("TotalRecords");
    var totalMembers = Amount("TotalMembers");
    var totalPurchaseAmount = Amount("TotalPurchaseAmount");
    var totalAggregateAmount = Amount("TotalAggregateAmount");
    var totalDividendPayableAmount = Amount("TotalDividendPayableAmount");
    var shareDividendPercent = Amount("ShareDividendPercent");
    var dividendAmount = Amount("DividendAmount");
    var remainingReserveAmount = Amount("RemainingReserveAmount");

    var fiscalYear = Text("FiscalYear");
    var officeName = Text("OfficeName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // accounting style: negative values shown in brackets
    string Acct(decimal value) =>
        value < 0 ? "(" + Math.Abs(value).ToString("N2") + ")" : value.ToString("N2");

    var table = new ReportTable(Model, title: "Share Dividend Report", sheetName: "ShareDividend")
        .Column("Member ID", 9)
        .Column("Member Name", 14)
        .Column("Group", 11)
        .Column("Holding From", 9)
        .Column("Holding To", 9)
        .Column("Purchase Amount (Rs)", 11, Align.Right)
        .Column("Holding Days", 7, Align.Right)
        .Column("Aggregate Amount (Rs)", 11, Align.Right)
        .Column("% Reserve", 8, Align.Right)
        .Column("Dividend Payable (Rs)", 11, Align.Right)
        .Style(new ReportStyle { ZebraStripes = false })
        .Sizing(rowMm: 5.5, headerMm: 10, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            /* long column titles wrap onto a second line */
            table.sheet-table tr.r-header th { white-space: normal; line-height: 1.15; vertical-align: bottom; }
            /* the two summary lines sit between two rules, like the old boxed block */
            table.sheet-table tr.meta-title + tr.meta-row td { border-top: 1px solid #000; }
            table.sheet-table tr.meta-spacer td              { border-top: 1px solid #000; }
            table.sheet-table tr.r-data td.group-col         { color: #1F5C99; }");

    // ── title block: two summary lines ──
    table.MetaRow(Fmt.Join(
        Fmt.Labeled("Branch :", officeName),
        Fmt.Labeled("Financial Year :", fiscalYear),
        Fmt.Labeled("Print Date :", generatedOn)));

    table.MetaRow(Fmt.Join(
        Fmt.Labeled("Share Amount :", totalPurchaseAmount.ToString("N0")),
        Fmt.Labeled("Remaining Reserve :", Acct(remainingReserveAmount)),
        Fmt.Labeled("Dividend Percentage :", shareDividendPercent.ToString("N0")),
        Fmt.Labeled("Dividend Amount :", Acct(dividendAmount))));

    // ── rows: member band (id + name), then that member's share holdings ──
    var memberGroups = rows
        .GroupBy(row => new { row.MemberId, row.MemberName })
        .ToList();

    foreach (var memberGroup in memberGroups)
    {
        table.GroupBy(
            ReportCell.Left(memberGroup.Key.MemberId ?? ""),
            ReportCell.Left(memberGroup.Key.MemberName ?? "", 3),
            ReportCell.Left("", 6));

        foreach (var row in memberGroup)
        {
            table.Data(
                ReportCell.Left("", 2),
                new ReportCell(row.MemberGroup ?? "", Align.Left, 1, "group-col"),
                ReportCell.Left(row.ShareHoldingPeriodFromOnBs ?? ""),
                ReportCell.Left(row.ShareHoldingPeriodToOnBs ?? ""),
                ReportCell.Right(row.PurchaseAmount.HasValue ? row.PurchaseAmount.Value.ToString("N2") : ""),
                ReportCell.Right(row.HoldingNoDays?.ToString("N0") ?? ""),
                ReportCell.Right(row.AggregateAmount.HasValue ? row.AggregateAmount.Value.ToString("N2") : ""),
                ReportCell.Right(row.Reserve.HasValue ? row.Reserve.Value.ToString("N6") : ""),
                ReportCell.Right(row.DividendPayableAmount.HasValue ? Acct(row.DividendPayableAmount.Value) : ""));
        }
    }

    if (rows.Count > 0)
    {
        table.Total(
            $"Total Members: {totalMembers:N0}\u00A0\u00A0|\u00A0\u00A0Total Records: {totalRecords:N0}",
            5,
            totalPurchaseAmount.ToString("N2"),
            "",
            totalAggregateAmount.ToString("N2"),
            "",
            Acct(totalDividendPayableAmount));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())