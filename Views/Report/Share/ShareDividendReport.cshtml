@using NexgenCosysReport.Dtos.RequestDtos.Share;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<ShareDividendRowDto>) ?? new List<ShareDividendRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalMembers = Model.ContainsKey("TotalMembers") ? (Model["TotalMembers"] as int? ?? 0) : 0;
    var totalPurchaseAmount = Model.ContainsKey("TotalPurchaseAmount") ? (Model["TotalPurchaseAmount"] as decimal? ?? 0) : 0;
    var totalAggregateAmount = Model.ContainsKey("TotalAggregateAmount") ? (Model["TotalAggregateAmount"] as decimal? ?? 0) : 0;
    var totalDividendPayableAmount = Model.ContainsKey("TotalDividendPayableAmount") ? (Model["TotalDividendPayableAmount"] as decimal? ?? 0) : 0;
    var shareDividendPercent = Model.ContainsKey("ShareDividendPercent") ? (Model["ShareDividendPercent"] as decimal? ?? 0) : 0;
    var dividendAmount = Model.ContainsKey("DividendAmount") ? (Model["DividendAmount"] as decimal? ?? 0) : 0;
    var remainingReserveAmount = Model.ContainsKey("RemainingReserveAmount") ? (Model["RemainingReserveAmount"] as decimal? ?? 0) : 0;
    var fiscalYear = Model["FiscalYear"]?.ToString() ?? "";
    var officeName = Model["OfficeName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Accounting-style: negative values shown in parentheses, matching the image.
    Func<decimal, string> acct = v => v < 0
        ? "(" + Math.Abs(v).ToString("N2") + ")"
        : v.ToString("N2");

    // Grouped by member: member header once (Id + Name), then each of that
    // member's share holdings underneath.
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.MemberName })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Share Dividend Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            /* Bordered summary box, matching the image's boxed header block */
            .summary-box {
                border-top: 1px solid #000;
                border-bottom: 1px solid #000;
                margin: 10px 0;
            }

                .summary-box td {
                    padding: 6px 10px;
                    font-size: 9pt;
                    text-align: left;
                }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
            }

            /* Member group header row (Member Id + Name only) */
            .member-header-row td {
                padding-top: 8px;
                padding-bottom: 2px;
                font-weight: bold;
            }

            /* Share holding rows under a member */
            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .group-col {
                color: #1F5C99;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="ShareDividend">
            <colgroup>
                <col style="width:9%;" />
                <col style="width:15%;" />
                <col style="width:13%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:11%;" />
                <col style="width:8%;" />
                <col style="width:11%;" />
                <col style="width:7%;" />
                <col style="width:8%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="10">Share Dividend Report</td>
                </tr>

                <!-- Bordered summary box, two lines, matching the image -->
                <tr class="summary-box">
                    <td colspan="4"><strong>Branch :</strong> @officeName</td>
                    <td colspan="3"><strong>Financial Year :</strong> @fiscalYear</td>
                    <td colspan="3"><strong>Print Date :</strong> @generatedOn</td>
                </tr>
                <tr class="summary-box">
                    <td colspan="3"><strong>Share Amount :</strong> @totalPurchaseAmount.ToString("N0")</td>
                    <td colspan="3"><strong>Remaining Reserve :</strong> @acct(remainingReserveAmount)</td>
                    <td colspan="2"><strong>Dividend Percentage :</strong> @shareDividendPercent.ToString("N0")</td>
                    <td colspan="2"><strong>Dividend Amount :</strong> @acct(dividendAmount)</td>
                </tr>

                <!-- Table Header -->
                <tr>
                    <th>Member ID</th>
                    <th>Member Name</th>
                    <th>Group</th>
                    <th>Holding From</th>
                    <th>Holding To</th>
                    <th class="text-right">Purchase Amount (Rs)</th>
                    <th class="text-right">Holding Days</th>
                    <th class="text-right">Aggregate Amount (Rs)</th>
                    <th class="text-right">% Reserve</th>
                    <th class="text-right">Dividend Payable (Rs)</th>
                </tr>

                @if (memberGroups.Any())
                {
                    foreach (var grp in memberGroups)
                    {
                        <!-- Member header band -->
                        <tr class="member-header-row">
                            <td>@(grp.Key.MemberId ?? "")</td>
                            <td>@(grp.Key.MemberName ?? "")</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <!-- That member's share holdings -->
                        foreach (var row in grp)
                        {
                            <tr class="detail-row">
                                <td></td>
                                <td></td>
                                <td class="group-col">@(row.MemberGroup ?? "")</td>
                                <td>@(row.ShareHoldingPeriodFromOnBs ?? "")</td>
                                <td>@(row.ShareHoldingPeriodToOnBs ?? "")</td>
                                <td class="text-right">@(row.PurchaseAmount.HasValue ? row.PurchaseAmount.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.HoldingNoDays?.ToString("N0") ?? "")</td>
                                <td class="text-right">@(row.AggregateAmount.HasValue ? row.AggregateAmount.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.Reserve.HasValue ? row.Reserve.Value.ToString("N6") : "")</td>
                                <td class="text-right">@(row.DividendPayableAmount.HasValue ? acct(row.DividendPayableAmount.Value) : "")</td>
                            </tr>
                        }
                    }

                    <!-- Report-level grand total -->
                    <tr class="grand-total-row">
                        <td colspan="5" class="text-right">
                            <strong>Total Members: @totalMembers &nbsp;&nbsp;|&nbsp;&nbsp; Total Records: @totalRecords</strong>
                        </td>
                        <td class="text-right"><strong>@totalPurchaseAmount.ToString("N2")</strong></td>
                        <td></td>
                        <td class="text-right"><strong>@totalAggregateAmount.ToString("N2")</strong></td>
                        <td></td>
                        <td class="text-right"><strong>@acct(totalDividendPayableAmount)</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>