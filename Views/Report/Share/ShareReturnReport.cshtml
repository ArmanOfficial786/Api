@using NexgenCosysReport.Dtos.RequestDtos.Share
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 8;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<ShareReturnRowDto>) ?? new List<ShareReturnRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var officeName = Text("OfficeName", "All");
    var generatedOn = DateTime.Now.ToString("MM/dd/yyyy");

    var shareTypeGroups = rows
        .GroupBy(r => r.ShareType)
        .ToList();

    var totalNoShare = TotalOr("TotalNoShare", rows.Sum(r => r.TotalNoShare ?? 0));
    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.Amount ?? 0));

    var table = new ReportTable(Model, title: "Share Return Report", sheetName: "ShareReturn")
        .Column("Member Id", 9)
        .Column("Member Name", 15)
        .Column("Group", 15)
        .Column("Share Type", 11)
        .Column("No Of Share", 10, Align.Right)
        .Column("Purchase Date", 12)
        .Column("Return Date", 12)
        .Column("Amount (Rs)", 16, Align.Right)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 9, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: normal; vertical-align: bottom; line-height: 1.2; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 8px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; border-bottom: 0; padding-top: 4px; padding-bottom: 4px; }\n" +
            "table.sheet-table tr.r-total td { border-top: 1px solid #000; border-bottom: 0; padding-top: 4px; padding-bottom: 4px; }\n" +
            ".sharetype-label { font-weight: bold; text-decoration: underline; }");

    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        3);
    table.MetaRow(Fmt.Labeled("Branch Name :", officeName));

    table.Header();

    foreach (var grp in shareTypeGroups)
    {
        table.GroupBy(new ReportCell(grp.Key ?? "", Align.Left, ColumnCount, "sharetype-label"));

        var groupShareTotal = 0m;
        var groupAmountTotal = 0m;

        foreach (var row in grp)
        {
            groupShareTotal += row.TotalNoShare ?? 0;
            groupAmountTotal += row.Amount ?? 0;

            table.Data(
                row.MemberId ?? "",
                row.MemberName ?? "",
                row.MemberGroup ?? "",
                "",
                row.TotalNoShare?.ToString("N2") ?? "",
                row.PurchaseDate ?? "",
                row.ReturnDate ?? "",
                row.Amount?.ToString("N2") ?? "");
        }

        table.SubTotal(grp.Key ?? "", 4, groupShareTotal.ToString("N2"), "", "", groupAmountTotal.ToString("N2"));
    }

    if (rows.Count > 0)
        table.Total("Grand Total :", 4, totalNoShare.ToString("N2"), "", "", totalAmount.ToString("N2"));
}
@await Html.PartialAsync("_SheetReport", table.Build())