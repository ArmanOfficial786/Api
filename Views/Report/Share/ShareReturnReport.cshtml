@using NexgenCosysReport.Dtos.RequestDtos.Share;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<ShareReturnRowDto>) ?? new List<ShareReturnRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalMembers = Model.ContainsKey("TotalMembers") ? (Model["TotalMembers"] as int? ?? 0) : 0;
    var totalNoShare = Model.ContainsKey("TotalNoShare") ? (Model["TotalNoShare"] as decimal? ?? 0) : 0;
    var totalAmount = Model.ContainsKey("TotalAmount") ? (Model["TotalAmount"] as decimal? ?? 0) : 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var officeName = Model["OfficeName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("MM/dd/yyyy");

    // Grouped by Share Type: an underlined section label once, then every
    // row of that type, then a per-type subtotal - matches the legacy
    // report exactly (member repeats across rows within a group as needed).
    var shareTypeGroups = rows
        .GroupBy(r => r.ShareType)
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Share Return Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                text-align: left;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
            }

            /* Share Type section label, underlined like the legacy report */
            .sharetype-label-row td {
                padding-top: 8px;
                padding-bottom: 2px;
            }

            .sharetype-label {
                font-weight: bold;
                border-bottom: 1px solid #000;
                padding-bottom: 2px;
                display: inline-block;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            /* Per-share-type subtotal */
            .group-total-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 4px;
                padding-bottom: 4px;
            }

            .grand-total-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 4px;
                padding-bottom: 4px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="ShareReturn">
            <colgroup>
                <col style="width:9%;" />
                <col style="width:15%;" />
                <col style="width:15%;" />
                <col style="width:11%;" />
                <col style="width:10%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:16%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="8">Share Return Report</td>
                </tr>

                <!-- Metadata: Report Generated On + From/To Date on one line, Branch Name on the next -->
                <tr class="meta-row">
                    <td colspan="3"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="5">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="3"></td>
                    <td colspan="5"><strong>Branch Name :</strong> @officeName</td>
                </tr>
                <tr class="meta-spacer"><td colspan="8"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Group</th>
                    <th>Share Type</th>
                    <th class="text-right">No Of Share</th>
                    <th>Purchase Date</th>
                    <th>Return Date</th>
                    <th class="text-right">Amount (Rs)</th>
                </tr>

                @if (shareTypeGroups.Any())
                {
                    foreach (var grp in shareTypeGroups)
                    {
                        <!-- Share Type section label -->
                        <tr class="sharetype-label-row">
                            <td colspan="8"><span class="sharetype-label">@(grp.Key ?? "")</span></td>
                        </tr>

                        <!-- Rows of this share type -->
                        var groupShareTotal = 0m;
                        var groupAmountTotal = 0m;
                        foreach (var row in grp)
                        {
                            groupShareTotal += row.TotalNoShare ?? 0;
                            groupAmountTotal += row.Amount ?? 0;
                            <tr class="detail-row">
                                <td>@(row.MemberId ?? "")</td>
                                <td>@(row.MemberName ?? "")</td>
                                <td>@(row.MemberGroup ?? "")</td>
                                <td></td>
                                <td class="text-right">@(row.TotalNoShare?.ToString("N2") ?? "")</td>
                                <td>@(row.PurchaseDate ?? "")</td>
                                <td>@(row.ReturnDate ?? "")</td>
                                <td class="text-right">@(row.Amount?.ToString("N2") ?? "")</td>
                            </tr>
                        }

                        <!-- Per-share-type subtotal -->
                        <tr class="group-total-row">
                            <td colspan="4" class="text-right">@(grp.Key ?? "")</td>
                            <td class="text-right">@groupShareTotal.ToString("N2")</td>
                            <td colspan="2"></td>
                            <td class="text-right">@groupAmountTotal.ToString("N2")</td>
                        </tr>
                    }

                    <!-- Report-level grand total -->
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Grand Total :</td>
                        <td class="text-right">@totalNoShare.ToString("N2")</td>
                        <td colspan="2"></td>
                        <td class="text-right">@totalAmount.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>