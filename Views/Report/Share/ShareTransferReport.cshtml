@using NexgenCosysReport.Dtos.RequestDtos.Share;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<ShareTransferRowDto>) ?? new List<ShareTransferRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalMembers = Model.ContainsKey("TotalMembers") ? (Model["TotalMembers"] as int? ?? 0) : 0;
    var totalNoShare = Model.ContainsKey("TotalNoShare") ? (Model["TotalNoShare"] as decimal? ?? 0) : 0;
    var totalAmount = Model.ContainsKey("TotalAmount") ? (Model["TotalAmount"] as decimal? ?? 0) : 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var officeName = Model["OfficeName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("MM/dd/yyyy");

    // Grouped by the receiving member: member header once, then a list of
    // share transfers received (from previous owners), then a per-member
    // subtotal - matches the legacy report exactly.
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.Name })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Share Transfer Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                text-align: left;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
            }

            /* Member group header row (Member Id + Name only) */
            .member-header-row td {
                padding-top: 8px;
                padding-bottom: 2px;
                font-weight: bold;
            }

            /* Transfer rows under a member */
            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            /* Per-member subtotal */
            .member-total-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 4px;
                padding-bottom: 8px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                font-weight: bold;
                padding: 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="ShareTransfer">
            <colgroup>
                <col style="width:9%;" />
                <col style="width:15%;" />
                <col style="width:11%;" />
                <col style="width:15%;" />
                <col style="width:13%;" />
                <col style="width:9%;" />
                <col style="width:10%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="9">Share Transfer Report</td>
                </tr>

                <!-- Metadata: Report Generated On + From/To Date on one line, Branch Name on the next -->
                <tr class="meta-row">
                    <td colspan="4"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="5">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="4"></td>
                    <td colspan="5"><strong>Branch Name :</strong> @officeName</td>
                </tr>
                <tr class="meta-spacer"><td colspan="9"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Old Member Id</th>
                    <th>Old Member Name</th>
                    <th>User Name</th>
                    <th class="text-right">No Of Share</th>
                    <th class="text-right">Amount (Rs)</th>
                    <th>Date</th>
                    <th>Share Type</th>
                </tr>

                @if (memberGroups.Any())
                {
                    foreach (var grp in memberGroups)
                    {
                        <!-- Member header band -->
                        <tr class="member-header-row">
                            <td>@(grp.Key.MemberId ?? "")</td>
                            <td>@(grp.Key.Name ?? "")</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <!-- Transfers received by this member -->
                        var groupShareTotal = 0m;
                        var groupAmountTotal = 0m;
                        foreach (var row in grp)
                        {
                            groupShareTotal += row.TotalNoShare ?? 0;
                            groupAmountTotal += row.Amount ?? 0;
                            <tr class="detail-row">
                                <td></td>
                                <td></td>
                                <td>@(row.PreviousMemberId ?? "")</td>
                                <td>@(row.PreviousMemberName ?? "")</td>
                                <td>@(row.UserName ?? "")</td>
                                <td class="text-right">@(row.TotalNoShare?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.Amount?.ToString("N2") ?? "")</td>
                                <td>@(row.Date ?? "")</td>
                                <td>@(row.ShareType ?? "")</td>
                            </tr>
                        }

                        <!-- Per-member subtotal -->
                        <tr class="member-total-row">
                            <td></td>
                            <td></td>
                            <td colspan="2" class="text-right">@(grp.Key.Name ?? "")</td>
                            <td></td>
                            <td class="text-right">@groupShareTotal.ToString("N2")</td>
                            <td class="text-right">@groupAmountTotal.ToString("N2")</td>
                            <td colspan="2"></td>
                        </tr>
                    }

                    <!-- Report-level grand total -->
                    <tr class="grand-total-row">
                        <td colspan="5" class="text-right">Grand Total :</td>
                        <td class="text-right">@totalNoShare.ToString("N2")</td>
                        <td class="text-right">@totalAmount.ToString("N2")</td>
                        <td colspan="2"></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>