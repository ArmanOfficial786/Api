@using NexgenCosysReport.Dtos.RequestDtos.Share
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    bool Flag(string key) =>
        Model.TryGetValue(key, out var value) && value is bool flag && flag;

    decimal Amount(string key) =>
        Model.TryGetValue(key, out var value) && value != null ? Convert.ToDecimal(value) : 0m;

    var rows = (Model["Rows"] as IEnumerable<ShareDetailsRowDto>)?.ToList()
        ?? new List<ShareDetailsRowDto>();

    var totalRecords = Amount("TotalRecords");
    var totalMembers = Amount("TotalMembers");
    var totalShare = Amount("TotalShare");
    var totalShareAmount = Amount("TotalShareAmount");

    var tillDate = Text("TillDate");
    var branchName = Text("BranchName", "All");
    var shareTypeName = Text("ShareTypeName", "All");
    var memberTypeName = Text("MemberTypeName", "All");
    var collectionCenterName = Text("CollectionCenterName", "All");
    var memberGroupName = Text("MemberGroupName", "All");
    var enableCollectionCenter = Flag("EnableCollectionCenter");
    var enableGroup = Flag("EnableGroup");
    var isNepali = Text("ReportType", "ENGLISH") == "NEPALI";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // label in the report language
    string T(string nepali, string english) => isNepali ? nepali : english;

    // 26 columns (+1 for collection center, +1 for group). The numbers are relative widths:
    // roughly the old mm widths, with the text columns given a share of their own.
    var table = new ReportTable(Model, title: T("सेयर विवरण प्रतिवेदन", "Share Details Report"), sheetName: "ShareDetailsReport")
        .Column(T("क्र.सं.", "SN"), 10, Align.Right)
        .Column(T("सदस्य नं.", "Member ID"), 18)
        .Column(T("सदस्यको नाम", "Member Name"), 28)
        .Column(T("लिङ्ग", "Gender"), 12)
        .Column(T("उमेर", "Age"), 10, Align.Right)
        .Column(T("जन्म मिति", "DOB"), 20)
        .Column(T("नागरिकता नं.", "Citizenship No"), 24)
        .Column(T("नागरिकता जिल्ला", "Citizenship Dist."), 20)
        .Column(T("नागरिकता मिति", "Citizenship Date"), 20)
        .Column(T("बाजे/हजुरआमा", "GrandFather/Mother"), 24)
        .Column(T("बुबा", "Father"), 24)
        .Column(T("पति/पत्नी", "Spouse"), 24)
        .Column(T("पेशा", "Occupation"), 20)
        .Column(T("ठेगाना", "Address"), 30)
        .Column(T("मोबाइल नं.", "Mobile No"), 22)
        .Column(T("सम्पर्क नं.", "Contact No"), 22);

    if (enableCollectionCenter)
        table.Column(T("संकलन केन्द्र", "Collection Center"), 20);
    if (enableGroup)
        table.Column(T("समूह", "Member Group"), 20);

    table
        .Column(T("दर्ता मिति (वि.सं.)", "Reg. Date (BS)"), 22)
        .Column(T("दर्ता मिति (ई.सं.)", "Reg. On (AD)"), 22)
        .Column(T("इच्छाइएको व्यक्ति", "Nominee Name"), 24)
        .Column(T("इच्छाइएको उमेर", "Nominee Age"), 12, Align.Right)
        .Column(T("इच्छाइएको ठेगाना", "Nominee Address"), 28)
        .Column(T("सेयर संख्या", "Share No"), 16, Align.Right)
        .Column(T("सेयर रकम", "Share Amount"), 24, Align.Right)
        .Column(T("कैफियत", "Remarks"), 20)
        .Sizing(rowMm: 8, headerMm: 9, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            /* long column titles wrap onto a second line instead of being cut off */
            table.sheet-table tr.r-header th { white-space: normal; text-align: center; line-height: 1.15; }
            /* grid lines like the old report */
            table.sheet-table tr.r-data td   { border: 1px solid #999; }
            table.sheet-table tr.r-header th { border-left: 1px solid #000; border-right: 1px solid #000; }");

    var columnCount = 26 + (enableCollectionCenter ? 1 : 0) + (enableGroup ? 1 : 0);

    // ── title block ──
    table.MetaRow(Fmt.Labeled(T("शाखा", "Branch") + " :", branchName));

    table.MetaRow(Fmt.Join(
        Fmt.Labeled(T("मिति सम्म", "Till Date") + " :", tillDate),
        Fmt.Labeled(T("सेयर प्रकार", "Share Type") + " :", shareTypeName),
        Fmt.Labeled(T("सदस्य प्रकार", "Member Type") + " :", memberTypeName)));

    if (enableCollectionCenter || enableGroup)
    {
        var optionalFilters = new List<Microsoft.AspNetCore.Html.IHtmlContent>();
        if (enableCollectionCenter)
            optionalFilters.Add(Fmt.Labeled(T("संकलन केन्द्र", "Collection Center") + " :", collectionCenterName));
        if (enableGroup)
            optionalFilters.Add(Fmt.Labeled(T("समूह", "Member Group") + " :", memberGroupName));
        table.MetaRow(Fmt.Join(optionalFilters.ToArray()));
    }

    table.MetaRow(Fmt.Labeled(T("प्रतिवेदन मिति", "Report Generated On") + " :", generatedOn));

    // ── rows ──
    var serialNumber = 0;
    foreach (var row in rows)
    {
        serialNumber++;

        var values = new List<string>
        {
            serialNumber.ToString(),
            row.MemberId ?? "",
            row.MemberName ?? "",
            row.Gender ?? "",
            row.MemberAge ?? "",
            row.DateOfBirth ?? "",
            row.CitizenShipNo ?? "",
            row.CitizenShipDistrict ?? "",
            row.CitizenShipDate ?? "",
            row.GrandFatherName ?? "",
            row.FatherName ?? "",
            row.SpouceName ?? "",
            row.Occupation ?? "",
            row.MemberAddress ?? "",
            row.MobileNo ?? "",
            row.ContactNo ?? ""
        };

        if (enableCollectionCenter)
            values.Add(row.Center ?? "");
        if (enableGroup)
            values.Add(row.MemberGroup ?? "");

        values.AddRange(new[]
        {
            row.RegistrationDate ?? "",
            row.RegistrationOn ?? "",
            row.NomineeName ?? "",
            row.NomineeAge ?? "",
            row.NomineeAddress ?? "",
            row.TotalShare?.ToString("N0") ?? "",
            row.TotalShareAmount?.ToString("N2") ?? "",
            row.Remarks ?? ""
        });

        table.Data(values.ToArray());
    }

    // ── grand total: label across everything except the last three columns (Share No, Share Amount, Remarks) ──
    if (rows.Count > 0)
    {
        var totalLabel =
            $"{T("कुल सदस्य", "Total Members")} : {totalMembers:N0}\u00A0\u00A0\u00A0" +
            $"{T("कुल रेकर्ड", "Total Records")} : {totalRecords:N0}\u00A0\u00A0\u00A0" +
            $"{T("कुल", "Grand Total")} :";

        table.Total(totalLabel, columnCount - 3, totalShare.ToString("N0"), totalShareAmount.ToString("N2"), "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())