@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Share
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 11;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<ShareHoldingRowDto>) ?? new List<ShareHoldingRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var officeName = Text("OfficeName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.MemberName })
        .ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalMembers = (int)TotalOr("TotalMembers", memberGroups.Count);
    var totalNoShare = TotalOr("TotalNoShare", rows.Sum(r => r.TotalNoShare ?? 0));
    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.Amount ?? 0));

    var table = new ReportTable(Model, title: "Share Holding Report", sheetName: "ShareHolding")
        .Column("Member Id", 10)
        .Column("Member Name", 17)
        .Column("Share From", 8)
        .Column("Share To", 8)
        .Column("No Of Share", 8, Align.Right)
        .Column("Holding From Date", 10)
        .Column("Holding To Date", 10)
        .Column("No of Days", 7, Align.Right)
        .Column("Amount (Rs.)", 10, Align.Right)
        .Column("Share Type", 9)
        .Column("Group", 9)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 9, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; border-bottom: 1px solid #000; white-space: normal; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 8px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; border-bottom: 0; padding-top: 3px; padding-bottom: 6px; }");

    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        5);
    table.MetaRow(HtmlString.Empty, Fmt.Labeled("Branch Name :", officeName), 5);

    table.Header();

    foreach (var group in memberGroups)
    {
        var groupRows = group.ToList();

        table.GroupBy(
            ReportCell.Left(group.Key.MemberId ?? ""),
            ReportCell.Left(group.Key.MemberName ?? "", ColumnCount - 1));

        foreach (var row in groupRows)
        {
            table.Data(
                "",
                "",
                row.ShareFrom ?? "",
                row.ShareTO ?? "",
                row.TotalNoShare?.ToString("N2") ?? "",
                row.HoldingPeriodFromBs ?? "",
                row.HoldingPeriodToBs ?? "",
                row.HoldingNoDays?.ToString("N0") ?? "",
                row.Amount?.ToString("N2") ?? "",
                row.ShareType ?? "",
                row.MemberGroup ?? "");
        }

        table.SubTotal(
            $"{group.Key.MemberName ?? ""}   Total:", 4,
            groupRows.Sum(r => r.TotalNoShare ?? 0).ToString("N2"),
            "", "", "",
            groupRows.Sum(r => r.Amount ?? 0).ToString("N2"),
            "", "");
    }

    if (rows.Count > 0)
    {
        table.Total(
            $"Total Members: {totalMembers}   |   Total Records: {totalRecords}", 4,
            totalNoShare.ToString("N2"),
            "", "", "",
            totalAmount.ToString("N2"),
            "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())