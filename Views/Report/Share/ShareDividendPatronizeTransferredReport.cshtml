@using NexgenCosysReport.Dtos.RequestDtos.Share
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    decimal Amount(string key) =>
        Model.TryGetValue(key, out var value) && value != null ? Convert.ToDecimal(value) : 0m;

    var rows = (Model["Rows"] as IEnumerable<ShareDividendPatronizeTransferredRowDto>)?.ToList()
        ?? new List<ShareDividendPatronizeTransferredRowDto>();

    var totalRecords = Amount("TotalRecords");
    var totalMembers = Amount("TotalMembers");
    var totalCashAmount = Amount("TotalCashAmount");
    var totalTaxAmount = Amount("TotalTaxAmount");
    var totalBonusShareAmount = Amount("TotalBonusShareAmount");

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var isPatronize = Text("ReportType", "SHARE_DIVIDEND") == "PATRONIZE";
    var reportTitle = isPatronize ? "Patronize Transferred Report" : "Share Dividend Transferred Report";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: reportTitle, sheetName: "ShareDividendPatronizeTransferred")
        .Column("MemberId", 10)
        .Column("Member Name", 20)
        .Column("Pan/Vat", 12)
        .Column("Account No", 14)
        .Column("Cash Amt", 12, Align.Right)
        .Column("Bonus Amt", 11, Align.Right)
        .Column("Tax Amt", 11, Align.Right)
        .Column("Date", 10)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    // generated date on the left; from / to dates together on the right
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(
            Fmt.Labeled("From Date :", fromDate),
            Fmt.Labeled("To Date :", toDate)));

    foreach (var row in rows)
    {
        table.Data(
            row.MemberId ?? "",
            row.MemberName ?? "",
            row.PanVatNo ?? "",
            row.AccountNo ?? "",
            row.CashAmount?.ToString("N2") ?? "",
            row.BonusShareAmount?.ToString("N2") ?? "",
            row.TaxAmount?.ToString("N2") ?? "",
            row.TransactionOnBs ?? "");
    }

    if (rows.Count > 0)
    {
        table.Total(
            $"Total Members: {totalMembers:N0}\u00A0\u00A0|\u00A0\u00A0Total Records: {totalRecords:N0}",
            4,
            totalCashAmount.ToString("N2"),
            totalBonusShareAmount.ToString("N2"),
            totalTaxAmount.ToString("N2"),
            "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())