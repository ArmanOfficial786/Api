@using NexgenCosysReport.Dtos.RequestDtos.Share
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<ShareStatementRowDto>) ?? new List<ShareStatementRowDto>();

    var memberId = Text("MemberId");
    var memberName = Text("MemberName");
    var address = Text("Address");
    var phoneNo = Text("PhoneNo");
    var shareTypeName = Text("ShareTypeName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalPurchasedAmount = TotalOr("TotalPurchasedAmount", rows.Sum(r => r.PurchasedAmount ?? 0));
    var totalReturnedAmount = TotalOr("TotalReturnedAmount", rows.Sum(r => r.ReturnedAmount ?? 0));
    var closingBalance = TotalOr("ClosingBalance", rows.LastOrDefault()?.Balance ?? 0);

    var table = new ReportTable(Model, title: "Share Statement Report", sheetName: "ShareStatement")
        .Column("S.No", 6)
        .Column("Date", 10)
        .Column("DateOnBs", 10)
        .Column("Description", 44)
        .Column("Purchased (Rs)", 10, Align.Right)
        .Column("Returned (Rs)", 10, Align.Right)
        .Column("Balance (Rs)", 10, Align.Right)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 9, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: normal; vertical-align: bottom; line-height: 1.2; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }\n" +
            "table.sheet-table tr.r-total td { border-top: 2px solid #000; border-bottom: 0; padding: 6px; }\n" +
            ".date-col { color: #B5651D; }\n" +
            ".amount-col { color: #1F5C99; }");

    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));
    table.MetaRow(Fmt.Labeled("Member Id :", memberId), Fmt.Labeled("Member Name :", memberName), 3);
    table.MetaRow(Fmt.Labeled("Member Address :", address), Fmt.Labeled("Phone No :", phoneNo), 3);
    table.MetaRow(Fmt.Labeled("Share Type :", shareTypeName));

    table.Header();

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            new ReportCell((++sn).ToString(), Align.Left, 1, "date-col"),
            new ReportCell(row.DateAd ?? "", Align.Left, 1, "date-col"),
            new ReportCell(row.Date ?? "", Align.Left, 1, "date-col"),
            ReportCell.Left(row.Description ?? ""),
            new ReportCell(Money(row.PurchasedAmount), Align.Right, 1, "amount-col"),
            new ReportCell(Money(row.ReturnedAmount), Align.Right, 1, "amount-col"),
            new ReportCell(Money(row.Balance), Align.Right, 1, "amount-col"));
    }

    if (rows.Count > 0)
        table.Total("Total :", 4, totalPurchasedAmount.ToString("N2"), totalReturnedAmount.ToString("N2"), closingBalance.ToString("N2"));
}
@await Html.PartialAsync("_SheetReport", table.Build())