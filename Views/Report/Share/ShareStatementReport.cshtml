@using NexgenCosysReport.Dtos.RequestDtos.Share;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<ShareStatementRowDto>) ?? new List<ShareStatementRowDto>();
    var totalPurchasedAmount = Model.ContainsKey("TotalPurchasedAmount") ? (Model["TotalPurchasedAmount"] as decimal? ?? 0) : 0;
    var totalReturnedAmount = Model.ContainsKey("TotalReturnedAmount") ? (Model["TotalReturnedAmount"] as decimal? ?? 0) : 0;
    var closingBalance = Model.ContainsKey("ClosingBalance") ? (Model["ClosingBalance"] as decimal? ?? 0) : 0;
    var memberId = Model["MemberId"]?.ToString() ?? "";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var address = Model["Address"]?.ToString() ?? "";
    var phoneNo = Model["PhoneNo"]?.ToString() ?? "";
    var shareTypeName = Model["ShareTypeName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Share Statement Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .meta-title {
                text-align: center;
                font-family: Arial, sans-serif;
                font-size: 13pt;
                font-weight: bold;
                padding: 8px 0;
            }

            .meta-row {
                padding: 3px 0;
                font-size: 9pt;
            }

            /* Bordered member-info box */
            .info-grid {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                margin: 10px 0;
                border: 1px solid #000;
            }

                .info-grid td {
                    border: 1px solid #000;
                    padding: 5px 8px;
                    vertical-align: middle;
                }

            .info-label {
                font-weight: bold;
                width: 15%;
            }

            .info-value {
                width: 35%;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: top;
                }

                .data-table th {
                    background: #f9f9f9;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    text-align: left;
                }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .date-col {
                color: #B5651D;
            }

            .amount-col {
                color: #1F5C99;
            }

            .total-row td {
                border-top: 2px solid #000;
                font-weight: bold;
                padding: 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="meta-title">Share Statement Report</div>
        <div class="meta-row"><strong>Report Generated On :</strong> @generatedOn</div>

        <!-- Member info box -->
        <table class="info-grid">
            <tr>
                <td class="info-label">Member Id :</td>
                <td class="info-value">@memberId</td>
                <td class="info-label">Member Name :</td>
                <td class="info-value">@memberName</td>
            </tr>
            <tr>
                <td class="info-label">Member Address :</td>
                <td class="info-value">@address</td>
                <td class="info-label">Phone No :</td>
                <td class="info-value">@phoneNo</td>
            </tr>
            <tr>
                <td class="info-label">Share Type :</td>
                <td class="info-value" colspan="3">@shareTypeName</td>
            </tr>
        </table>

        <table class="data-table">
            <colgroup>
                <col style="width:6%;" />
                <col style="width:10%;" />
                <col style="width:10%;" />
                <col style="width:44%;" />
                <col style="width:10%;" />
                <col style="width:10%;" />
                <col style="width:10%;" />
            </colgroup>
            <tbody>
                <tr>
                    <th>S.No</th>
                    <th>Date</th>
                    <th>DateOnBs</th>
                    <th>Description</th>
                    <th class="text-right">Purchased (Rs)</th>
                    <th class="text-right">Returned (Rs)</th>
                    <th class="text-right">Balance (Rs)</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="detail-row">
                            <td class="date-col">@sn</td>
                            <td class="date-col">@(row.DateAd ?? "")</td>
                            <td class="date-col">@(row.Date ?? "")</td>
                            <td>@(row.Description ?? "")</td>
                            <td class="text-right amount-col">@(row.PurchasedAmount.HasValue ? row.PurchasedAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right amount-col">@(row.ReturnedAmount.HasValue ? row.ReturnedAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right amount-col">@(row.Balance.HasValue ? row.Balance.Value.ToString("N2") : "")</td>
                        </tr>
                    }

                    <tr class="total-row">
                        <td colspan="4" class="text-right">Total :</td>
                        <td class="text-right">@totalPurchasedAmount.ToString("N2")</td>
                        <td class="text-right">@totalReturnedAmount.ToString("N2")</td>
                        <td class="text-right">@closingBalance.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>