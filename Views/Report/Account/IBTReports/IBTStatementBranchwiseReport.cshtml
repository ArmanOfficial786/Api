@* Views/Report/Account/IBTReports/IBTStatementBranchwiseReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Account.IBTReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var detailRows = (Model["DetailRows"] as List<IBTStatementBranchwiseRowDto>) ?? new List<IBTStatementBranchwiseRowDto>();
    var ledgerGroupRows = (Model["LedgerGroupRows"] as List<IBTStatementBranchwiseLedgerGroupRowDto>) ?? new List<IBTStatementBranchwiseLedgerGroupRowDto>();
    var interestRows = (Model["InterestRows"] as List<IBTStatementBranchwiseInterestRowDto>) ?? new List<IBTStatementBranchwiseInterestRowDto>();

    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["LoginBranchName"]?.ToString() ?? "";
    var reportType = Model["ReportType"]?.ToString() ?? "Detail";
    var interestRate = Model["InterestRate"] as decimal? ?? 0;
    var minimumClosingBalance = Model["MinimumClosingBalance"] as decimal? ?? 0;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var reportTitle = "IBT Statement Branchwise Report";

    string Fmt(decimal? v) => v.HasValue ? (v.Value < 0 ? $"({Math.Abs(v.Value):N2})" : v.Value.ToString("N2")) : "0.00";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@reportTitle</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .report-title {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            /* Own auto-layout table for the subheader so long labels never
                           wrap or overlap — same fix applied throughout this thread. */
            .meta-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 6px;
            }

                .meta-table td {
                    padding: 3px 6px;
                    font-size: 9pt;
                    white-space: nowrap;
                    vertical-align: top;
                }

            .meta-left {
                text-align: left;
                width: 50%;
            }

            .meta-right {
                text-align: right;
                width: 50%;
            }

            .meta-spacer td {
                height: 8px;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                    border: 1px solid #000;
                }

                .data-table th {
                    background: #f9f9f9;
                    text-align: left;
                    white-space: normal;
                    font-weight: bold;
                }

                    .data-table th.text-right,
                    .data-table td.text-right {
                        text-align: right;
                    }

            .grand-total-row td {
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">@reportTitle</div>

        <table class="meta-table">
            <tr>
                <td class="meta-left"><strong>Branch Name :</strong> @branchName</td>
                <td class="meta-right"><strong>From Date :</strong> @fromDate &nbsp;&nbsp;&nbsp; <strong>To Date :</strong> @toDate</td>
            </tr>
            <tr>
                <td class="meta-left"><strong>Report Generated On :</strong> @generatedOn</td>
                <td class="meta-right"></td>
            </tr>
            @if (reportType == "InterestCalculation")
            {
                <tr>
                    <td class="meta-left"><strong>Interest Rate :</strong> @interestRate.ToString("N2")%</td>
                    <td class="meta-right"><strong>Minimum Closing Balance :</strong> @Fmt(minimumClosingBalance)</td>
                </tr>
            }
            <tr class="meta-spacer"><td colspan="2"></td></tr>
        </table>

        @if (reportType == "SubLedger")
        {
            <table class="data-table" data-sheet-name="IBTStatementLedgerWise">
                <colgroup>
                    <col style="width:20%;" />
                    <col style="width:20%;" />
                    <col style="width:20%;" />
                    <col style="width:20%;" />
                    <col style="width:20%;" />
                </colgroup>
                <tbody>
                    <tr>
                        <th>Main Ledger</th>
                        <th>Sub Ledger</th>
                        <th class="text-right">Debit</th>
                        <th class="text-right">Credit</th>
                        <th class="text-right">Balance</th>
                    </tr>
                    @if (ledgerGroupRows.Any())
                    {
                        foreach (var row in ledgerGroupRows)
                        {
                            <tr>
                                <td>@(row.MainLedger ?? "")</td>
                                <td>@(row.SubLedger ?? "")</td>
                                <td class="text-right">@Fmt(row.DebitAmount)</td>
                                <td class="text-right">@Fmt(row.CreditAmount)</td>
                                <td class="text-right">@Fmt(row.Balance)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center">No data found for the selected criteria</td></tr>
                    }
                </tbody>
            </table>
        }
        else if (reportType == "InterestCalculation")
        {
            <table class="data-table" data-sheet-name="IBTStatementInterest">
                <colgroup>
                    <col style="width:15%;" />
                    <col style="width:15%;" />
                    <col style="width:35%;" />
                    <col style="width:17.5%;" />
                    <col style="width:17.5%;" />
                </colgroup>
                <tbody>
                    <tr>
                        <th>Voucher Date</th>
                        <th>Voucher No</th>
                        <th>Narration</th>
                        <th class="text-right">Closing Balance</th>
                        <th class="text-right">Interest Amount</th>
                    </tr>
                    @if (interestRows.Any())
                    {
                        foreach (var row in interestRows)
                        {
                            <tr>
                                <td>@(row.VoucherDate ?? "")</td>
                                <td>@(row.VoucherNo ?? "")</td>
                                <td>@(row.Narration ?? "")</td>
                                <td class="text-right">@Fmt(row.ClosingBalance)</td>
                                <td class="text-right">@Fmt(row.InterestAmount)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center">No data found for the selected criteria</td></tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <table class="data-table" data-sheet-name="IBTStatementDetail">
                <colgroup>
                    <col style="width:12%;" />
                    <col style="width:11%;" />
                    <col style="width:14%;" />
                    <col style="width:33%;" />
                    <col style="width:10%;" />
                    <col style="width:10%;" />
                    <col style="width:10%;" />
                </colgroup>
                <tbody>
                    <tr>
                        <th>VoucherNo</th>
                        <th>VoucherOnBs</th>
                        <th>LedgerName</th>
                        <th>Description</th>
                        <th class="text-right">DebitAmount</th>
                        <th class="text-right">CreditAmount</th>
                        <th class="text-right">Balance</th>
                    </tr>
                    @if (detailRows.Any())
                    {
                        foreach (var row in detailRows)
                        {
                            <tr>
                                <td>@(row.VoucherNo ?? "")</td>
                                <td>@(row.VoucherOnBs ?? "")</td>
                                <td>@(row.MainLedger ?? "")</td>
                                <td>@(row.Narration ?? "")</td>
                                <td class="text-right">@Fmt(row.DebitAmount)</td>
                                <td class="text-right">@Fmt(row.CreditAmount)</td>
                                <td class="text-right">@Fmt(row.Balance)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center">No data found for the selected criteria</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</body>
</html>