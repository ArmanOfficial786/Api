@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.IBTReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    // negatives in brackets and a missing amount prints 0.00 (same as before)
    string N(decimal? v) => v.HasValue ? (v.Value < 0 ? $"({Math.Abs(v.Value):N2})" : v.Value.ToString("N2")) : "0.00";

    var detailRows = (Model["DetailRows"] as List<IBTStatementBranchwiseRowDto>) ?? new List<IBTStatementBranchwiseRowDto>();
    var ledgerGroupRows = (Model["LedgerGroupRows"] as List<IBTStatementBranchwiseLedgerGroupRowDto>) ?? new List<IBTStatementBranchwiseLedgerGroupRowDto>();
    var interestRows = (Model["InterestRows"] as List<IBTStatementBranchwiseInterestRowDto>) ?? new List<IBTStatementBranchwiseInterestRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("LoginBranchName");
    var reportType = Text("ReportType", "Detail");
    var interestRate = Dec("InterestRate");
    var minimumClosingBalance = Dec("MinimumClosingBalance");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isSubLedger = reportType == "SubLedger";
    var isInterest = reportType == "InterestCalculation";

    // the report type decides the sheet name and the columns; only one layout is printed per request
    var sheetName = isSubLedger ? "IBTStatementLedgerWise" : isInterest ? "IBTStatementInterest" : "IBTStatementDetail";
    var columnCount = isSubLedger || isInterest ? 5 : 7;

    var table = new ReportTable(Model, title: "IBT Statement Branchwise Report", sheetName: sheetName)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: isInterest ? 85 : 75)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; border: 1px solid #000; }" +
            // column titles may wrap, as in the old report
            "table.sheet-table tr.r-header th { white-space: normal; }");

    if (isSubLedger)
    {
        table.Column("Main Ledger", 20)
             .Column("Sub Ledger", 20)
             .Column("Debit", 20, Align.Right)
             .Column("Credit", 20, Align.Right)
             .Column("Balance", 20, Align.Right);
    }
    else if (isInterest)
    {
        table.Column("Voucher Date", 15)
             .Column("Voucher No", 15)
             .Column("Narration", 35)
             .Column("Closing Balance", 17.5, Align.Right)
             .Column("Interest Amount", 17.5, Align.Right);
    }
    else
    {
        table.Column("VoucherNo", 12)
             .Column("VoucherOnBs", 11)
             .Column("LedgerName", 14)
             .Column("Description", 33)
             .Column("DebitAmount", 10, Align.Right)
             .Column("CreditAmount", 10, Align.Right)
             .Column("Balance", 10, Align.Right);
    }

    // ── title block: left part takes the first half of the columns, the right part the rest ──
    var leftSpan = columnCount / 2;
    table.MetaRow(
        Fmt.Labeled("Branch Name :", branchName),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        leftSpan);
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));
    if (isInterest)
    {
        table.MetaRow(
            Fmt.Labeled("Interest Rate :", interestRate.ToString("N2") + "%"),
            Fmt.Labeled("Minimum Closing Balance :", N(minimumClosingBalance)),
            leftSpan);
    }

    // ── rows ──
    if (isSubLedger)
    {
        foreach (var row in ledgerGroupRows)
        {
            table.Data(
                row.MainLedger ?? "",
                row.SubLedger ?? "",
                N(row.DebitAmount),
                N(row.CreditAmount),
                N(row.Balance));
        }
        if (!ledgerGroupRows.Any())
            table.Data(ReportCell.Center("No data found for the selected criteria", columnCount));
    }
    else if (isInterest)
    {
        foreach (var row in interestRows)
        {
            table.Data(
                row.VoucherDate ?? "",
                row.VoucherNo ?? "",
                row.Narration ?? "",
                N(row.ClosingBalance),
                N(row.InterestAmount));
        }
        if (!interestRows.Any())
            table.Data(ReportCell.Center("No data found for the selected criteria", columnCount));
    }
    else
    {
        foreach (var row in detailRows)
        {
            table.Data(
                row.VoucherNo ?? "",
                row.VoucherOnBs ?? "",
                row.MainLedger ?? "",
                row.Narration ?? "",
                N(row.DebitAmount),
                N(row.CreditAmount),
                N(row.Balance));
        }
        if (!detailRows.Any())
            table.Data(ReportCell.Center("No data found for the selected criteria", columnCount));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())