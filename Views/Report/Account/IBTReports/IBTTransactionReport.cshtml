@using NexgenCosysReport.Dtos.RequestDtos.Account.IBTReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as IEnumerable<IBTTransactionRowDto>)?.ToList() ?? new List<IBTTransactionRowDto>();
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName");
    if (branchName == "") branchName = "All";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;
    var totalReceived = TotalOr("TotalCashReceived", rows.Sum(r => r.CashReceived ?? 0));
    var totalWithdrawl = TotalOr("TotalCashWithdrawl", rows.Sum(r => r.CashWithdrawl ?? 0));

    var table = new ReportTable(Model, title: "IBT Transaction Report", sheetName: "IBTTransaction")
        .Style(new ReportStyle { ZebraStripes = false })
        .Column("Member Id", 10)
        .Column("Member Name", 15)
        .Column("Deposit Amount", 12, Align.Right)
        .Column("Withdrawl Amount", 12, Align.Right)
        .Column("Transaction Date", 11)
        .Column("Nature Of Transaction", 16)
        .Column("Transaction OfficeName", 12)
        .Column("Member OfficeName", 12)
        .Sizing(rowMm: 6, headerMm: 9, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            "table.sheet-table tr.r-data td.shaded { background: #cfcfcf; }");

    table.MetaRow(
            Fmt.Labeled("Branch Name :", branchName),
            Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)))
         .MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // shade flips only when the member changes, so a member's rows keep one shade
    string? currentMemberId = null;
    var shadeOn = false;

    foreach (var row in rows)
    {
        if (row.MemberId != currentMemberId)
        {
            shadeOn = !shadeOn;
            currentMemberId = row.MemberId;
        }

        var css = shadeOn ? "shaded" : null;

        table.Data(new[]
        {
            new ReportCell(row.MemberId ?? "", Align.Left, 1, css),
            new ReportCell(row.FullName ?? "", Align.Left, 1, css),
            new ReportCell(Fmt.Amount(row.CashReceived ?? 0), Align.Right, 1, css),
            new ReportCell(Fmt.Amount(row.CashWithdrawl ?? 0), Align.Right, 1, css),
            new ReportCell(row.TransactionOnBs ?? "", Align.Left, 1, css),
            new ReportCell(row.Description ?? "", Align.Left, 1, css),
            new ReportCell(row.TransactionOfficeName ?? "", Align.Left, 1, css),
            new ReportCell(row.MemMemberRegistrationOfficeName ?? "", Align.Left, 1, css)
        });
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 2, Fmt.Amount(totalReceived), Fmt.Amount(totalWithdrawl), "", "", "", "");
        table.Total("Total Records", 7, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())