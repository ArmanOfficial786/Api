@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // amounts always show two decimals, a missing amount prints 0.00 (same as before)
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<DailyExpenseRowDto>) ?? new List<DailyExpenseRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalDebit = TotalOr("TotalDebitAmount", rows.Sum(r => r.DebitAmount ?? 0));
    var totalCredit = TotalOr("TotalCreditAmount", rows.Sum(r => r.CreditAmount ?? 0));
    var totalBalance = TotalOr("TotalBalance", rows.Sum(r => r.Balance ?? 0));

    // grouped by main ledger, in the order the repository returned the rows:
    // it must already be sorted by MainLedger, SubLedger
    var mainLedgerGroups = rows.GroupBy(r => r.MainLedger ?? "").ToList();

    var table = new ReportTable(Model, title: "Daily Expense Report", sheetName: "DailyExpense")
        .Column("Particulars", 40)
        .Column("Debit Amount", 20, Align.Right)
        .Column("Credit Amount", 20, Align.Right)
        .Column("Balance", 20, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            DataText = "#1565c0",              // sub-ledger rows are blue
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            // main ledger line: bold, no rules
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 8px; }\n" +
            // sub-ledger rows: no rules, name indented
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td.sub-ledger { padding-left: 20px; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));

    // ── rows: one block per main ledger (ledger line, sub-ledgers, ledger total) ──
    foreach (var group in mainLedgerGroups)
    {
        var groupRows = group.ToList();

        // main ledger line: one cell spanning all columns
        table.GroupTitle(group.Key);

        foreach (var row in groupRows)
        {
            table.Data(
                new ReportCell(row.SubLedger ?? "", Align.Left, 1, "sub-ledger"),
                ReportCell.Right(N(row.DebitAmount)),
                ReportCell.Right(N(row.CreditAmount)),
                ReportCell.Right(N(row.Balance)));
        }

        // the ledger total is always printed, even for a ledger with one sub-ledger row
        table.SubTotal(group.Key, 1,
            N(groupRows.Sum(r => r.DebitAmount ?? 0)),
            N(groupRows.Sum(r => r.CreditAmount ?? 0)),
            N(groupRows.Sum(r => r.Balance ?? 0)));
    }

    if (rows.Count > 0)
        table.Total("Grand Total", 1, N(totalDebit), N(totalCredit), N(totalBalance));
}
@await Html.PartialAsync("_SheetReport", table.Build())