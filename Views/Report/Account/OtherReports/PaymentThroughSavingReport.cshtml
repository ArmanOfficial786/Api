@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a missing amount prints blank (same as before); totals always print two decimals
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<PaymentThroughSavingRowDto>) ?? new List<PaymentThroughSavingRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All");
    var transactionType = Text("TransactionType", "all");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.CashReceived ?? 0));

    var table = new ReportTable(Model, title: "Payment Through Saving Report", sheetName: "PaymentThroughSaving")
        .Column("Member Id", 12)
        .Column("Name", 16)
        .Column("Account No", 14)
        .Column("Amount", 12)                 // left-aligned, as in the old report; use Align.Right to right-align
        .Column("Date", 14)
        .Column("Transaction Description", 32)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Transaction Type :", transactionType));

    // ── rows ──
    foreach (var row in rows)
    {
        table.Data(
            row.MemberId ?? "",
            row.MemberName ?? "",
            row.AccountNo ?? "",
            N(row.CashReceived),
            row.TransactionOn ?? row.TransactionOnBs ?? "",
            row.Description ?? "");
    }

    // label spans the first 3 columns; the value fills the Amount column
    if (rows.Count > 0)
    {
        table.Total("Grand Total", 3, totalAmount.ToString("N2"));
        table.Total("Total Records", 3, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())