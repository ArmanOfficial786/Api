@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.AccountOperation.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    // summary amounts: negatives in brackets (same as before); detail amounts: blank when missing
    string N(decimal v) => v < 0 ? $"({Math.Abs(v):N2})" : v.ToString("N2");
    string A(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";

    var transactionRows = (Model["TransactionRows"] as List<TellerCashDetailTransactionRowDto>) ?? new List<TellerCashDetailTransactionRowDto>();
    var manualRows = (Model["ManualRows"] as List<TellerCashDetailManualRowDto>) ?? new List<TellerCashDetailManualRowDto>();

    var transactionDR = Dec("TransactionCashBalanceDR");
    var transactionCR = Dec("TransactionCashBalanceCR");
    var voucherDR = Dec("VoucherCashBalanceDR");
    var voucherCR = Dec("VoucherCashBalanceCR");
    var tellerCashFromVault = Dec("TellerCashFromVault");
    var tellerCashFromTeller = Dec("TellerCashFromTeller");
    var tellerCashToTeller = Dec("TellerCashToTeller");
    var tellerCashToVault = Dec("TellerCashToVault");
    var totalDR = Dec("TotalDR");
    var totalCR = Dec("TotalCR");
    var totalBalance = Dec("TotalBalance");
    var grandTotal = Dec("GrandTotal");

    var transactionDate = Text("TransactionDate");
    var branchName = Text("BranchName", "All");
    var tellerName = Text("TellerName", "All Teller");
    var isDetail = Text("ReportType", "D") == "D";      // "S" = summary only: the two detail blocks are hidden
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // ── cell helpers (every row below covers the 24 grid units) ──
    ReportCell Hd(string t, int span, Align a = Align.Center) => new(t, a, span, "bx bg");          // boxed summary title
    ReportCell Bx(string t, int span, Align a = Align.Right, bool bold = false) => new(t, a, span, bold ? "bx b" : "bx");   // boxed summary value
    ReportCell Gh(string t, int span, Align a = Align.Right) => new(t, a, span);                    // detail column title
    ReportCell Dc(string t, int span, Align a = Align.Right) => new(t, a, span);                    // detail value

    // one 24-unit grid carries all four blocks, so each block just chooses its own spans
    var table = new ReportTable(Model, title: "Teller Cash Detail Report", sheetName: "TellerCashDetail")
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            SectionBackground = "#e8e8e8",
            HeaderBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 110)   // the page 1 title block and the two summary grids are tall
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }" +
            "table.sheet-table tr.r-section td { font-size: 10pt; }" +
            // boxed summary grids
            "table.sheet-table td.bx, table.sheet-table th.bx { border: 1px solid #000 !important; }" +
            "table.sheet-table th.bg { background: #f0f0f0 !important; }" +
            "table.sheet-table td.b { font-weight: bold; }");

    for (var i = 0; i < 24; i++) table.Column("", 1);

    // ── title block ──
    table.MetaRow(
        Fmt.Join(Fmt.Labeled("Transaction Date :", transactionDate), Fmt.Labeled("Branch :", branchName)),
        Fmt.Labeled("Teller :", tellerName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // ── Auto / Manual / Total summary grid (4 blocks of 6 units) ──
    table.Header(Hd("", 6), Hd("DR", 6), Hd("CR", 6), Hd("Balance", 6));
    table.Data(Bx("Auto (Transaction)", 6, Align.Left), Bx(N(transactionDR), 6), Bx(N(transactionCR), 6), Bx(N(transactionDR - transactionCR), 6));
    table.Data(Bx("Manual (Voucher)", 6, Align.Left), Bx(N(voucherDR), 6), Bx(N(voucherCR), 6), Bx(N(voucherDR - voucherCR), 6));
    table.Data(Bx("Total", 6, Align.Left, true), Bx(N(totalDR), 6, bold: true), Bx(N(totalCR), 6, bold: true), Bx(N(totalBalance), 6, bold: true));

    table.Spacer();

    // ── teller cash movement summary (6 blocks of 4 units) ──
    table.Header(Hd("Cash From Vault", 4), Hd("Cash From Teller", 4), Hd("Cash To Teller", 4),
                 Hd("Cash To Vault", 4), Hd("Balance", 4), Hd("Total", 4));
    table.Data(Bx(N(tellerCashFromVault), 4), Bx(N(tellerCashFromTeller), 4), Bx(N(tellerCashToTeller), 4),
               Bx(N(tellerCashToVault), 4), Bx(N(totalBalance), 4), Bx(N(grandTotal), 4, bold: true));

    if (isDetail)
    {
        // ── Transaction Detail (Auto): 7 columns = 3 + 5 + 4 + 3 + 3 + 3 + 3 units ──
        table.Spacer();
        table.Section("Transaction Detail (Auto)");
        table.Header(Gh("Member Id", 3, Align.Left), Gh("Member Name", 5, Align.Left), Gh("Account No", 4),
                     Gh("Bill No", 3), Gh("Type", 3), Gh("DR", 3), Gh("CR", 3));

        if (transactionRows.Any())
        {
            foreach (var row in transactionRows)
            {
                table.Data(
                    Dc(row.MemberId ?? "", 3, Align.Left),
                    Dc(row.MemberName ?? "", 5, Align.Left),
                    Dc(row.AccountNo ?? "", 4),
                    Dc(row.BillNo ?? "", 3),
                    Dc(row.TransactionType ?? "", 3),
                    Dc(A(row.DebitAmount), 3),
                    Dc(A(row.CreditAmount), 3));
            }
        }
        else
        {
            table.Data(Dc("No transaction data found", 24, Align.Center));
        }

        // ── Voucher Detail (Manual): 4 columns = 4 + 14 + 3 + 3 units ──
        table.Spacer();
        table.Section("Voucher Detail (Manual)");
        table.Header(Gh("Voucher No", 4, Align.Left), Gh("Narration", 14, Align.Left), Gh("DR", 3), Gh("CR", 3));

        if (manualRows.Any())
        {
            foreach (var row in manualRows)
            {
                table.Data(
                    Dc(row.VoucherNo ?? "", 4, Align.Left),
                    Dc(row.Narration ?? "", 14, Align.Left),
                    Dc(A(row.DebitAmount), 3),
                    Dc(A(row.CreditAmount), 3));
            }
        }
        else
        {
            table.Data(Dc("No voucher data found", 24, Align.Center));
        }
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())