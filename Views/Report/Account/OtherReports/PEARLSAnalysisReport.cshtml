@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports

@model Dictionary<string, object>
@{
    Layout = null;

    var pearlsP = (Model["PEARLSP"] as List<PEARLSBalanceDto>) ?? new List<PEARLSBalanceDto>();
    var pearlsE = (Model["PEARLSE"] as List<PEARLSBalanceDto>) ?? new List<PEARLSBalanceDto>();
    var pearlsA = (Model["PEARLSA"] as List<PEARLSBalanceDto>) ?? new List<PEARLSBalanceDto>();
    var pearlsR = (Model["PEARLSR"] as List<PEARLSBalanceDto>) ?? new List<PEARLSBalanceDto>();
    var pearlsL = (Model["PEARLSL"] as List<PEARLSBalanceDto>) ?? new List<PEARLSBalanceDto>();
    var pearlsS = (Model["PEARLSS"] as List<PEARLSBalanceDto>) ?? new List<PEARLSBalanceDto>();
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>PEARLS Analysis Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Times New Roman", Times, serif;
                font-size: 9.5pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .meta-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 14px;
            }

                .meta-table td {
                    padding: 2px 4px;
                    font-size: 10pt;
                    vertical-align: top;
                }

            .report-title {
                text-align: center;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 0 12px 0;
            }

            .meta-label {
                font-weight: bold;
            }

            .section-block {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 18px;
            }

                .section-block th, .section-block td {
                    border: 1px solid #000;
                    padding: 5px 8px;
                    vertical-align: middle;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                }

            .section-title-row td {
                text-align: center;
                font-weight: bold;
                font-size: 10.5pt;
                background: #fff;
                padding: 6px;
            }

            .col-header th {
                font-weight: bold;
                text-align: center;
                background: #fff;
                font-size: 9.5pt;
            }

            .text-center {
                text-align: center;
            }

            .text-right {
                text-align: right;
            }

            @@media print {
                .section-block {
                    page-break-inside: auto;
                }

                    .section-block tr {
                        page-break-inside: avoid;
                        break-inside: avoid;
                    }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">PEARLS Analysis Report</div>

        <table class="meta-table">
            <tr>
                <td width="20%"></td>
                <td width="30%"></td>
                <td width="20%" class="meta-label text-right">Till Date :</td>
                <td width="30%">@tillDate</td>
            </tr>
            <tr>
                <td colspan="2"><span class="meta-label">Report Generated On :</span> @generatedOn</td>
                <td class="meta-label text-right">Branch Name :</td>
                <td>@branchNames</td>
            </tr>
        </table>

        @{
            void RenderSection(string sectionTitle, List<PEARLSBalanceDto> rows)
            {
                if (!rows.Any()) { return; }
                <table class="section-block">
                    <colgroup>
                        <col style="width:8%;" />
                        <col style="width:20%;" />
                        <col style="width:37%;" />
                        <col style="width:13%;" />
                        <col style="width:11%;" />
                        <col style="width:11%;" />
                    </colgroup>
                    <tbody>
                        <tr class="section-title-row">
                            <td colspan="6">@sectionTitle</td>
                        </tr>
                        <tr class="col-header">
                            <th>Indicator</th>
                            <th>Objective</th>
                            <th>Formula</th>
                            <th>Measurement (%)</th>
                            <th>Value</th>
                            <th>Achievement (%)</th>
                        </tr>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td>@(row.Indicator ?? "")</td>
                                <td>@(row.Objective ?? "")</td>
                                <td>@(row.Formula ?? "")</td>
                                <td class="text-center">@(row.Measurement ?? "")</td>
                                <td class="text-center">@(row.Value.HasValue ? row.Value.Value.ToString("0.00") : "")</td>
                                <td class="text-center">@(row.Achievement ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            RenderSection("P = PROTECTION", pearlsP);
            RenderSection("E = EFFECTIVE FINANCIAL STRUCTURE", pearlsE);
            RenderSection("A = ASSET QUALITY", pearlsA);
            RenderSection("R = RATES OF RETURN AND COSTS", pearlsR);
            RenderSection("L = LIQUIDITY", pearlsL);
            RenderSection("S = SIGNS OF GROWTH", pearlsS);

            if (!pearlsP.Any() && !pearlsE.Any() && !pearlsA.Any() && !pearlsR.Any() && !pearlsL.Any() && !pearlsS.Any())
            {
                <p class="text-center">No data found for the selected criteria</p>
            }
        }
    </div>
</body>
</html>