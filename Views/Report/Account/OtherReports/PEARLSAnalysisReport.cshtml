@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    List<PEARLSBalanceDto> Rows(string key) => (Model.TryGetValue(key, out var v) ? v as List<PEARLSBalanceDto> : null) ?? new List<PEARLSBalanceDto>();

    var tillDate = Text("TillDate");
    var branchNames = Text("BranchNames", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // one block per PEARLS letter; empty blocks are skipped
    var sections = new (string Title, List<PEARLSBalanceDto> Rows)[]
    {
        ("P = PROTECTION",                    Rows("PEARLSP")),
        ("E = EFFECTIVE FINANCIAL STRUCTURE", Rows("PEARLSE")),
        ("A = ASSET QUALITY",                 Rows("PEARLSA")),
        ("R = RATES OF RETURN AND COSTS",     Rows("PEARLSR")),
        ("L = LIQUIDITY",                     Rows("PEARLSL")),
        ("S = SIGNS OF GROWTH",               Rows("PEARLSS"))
    };

    var table = new ReportTable(Model, title: "PEARLS Analysis Report", sheetName: "PEARLSAnalysis")
        .Column("Indicator", 8)
        .Column("Objective", 20)
        .Column("Formula", 37)
        .Column("Measurement (%)", 13, Align.Center)
        .Column("Value", 11, Align.Center)
        .Column("Achievement (%)", 11, Align.Center)
        .NoColumnHeader()                      // every section prints its own column titles (Header() below)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            SectionBackground = "#fff",
            HeaderBackground = "#fff"
        })
        .Sizing(rowMm: 8, headerMm: 8, firstPageExtraMm: 60)   // formulas can wrap to two lines
        .Css(
            // grid lines like the old report; section titles centred
            "table.sheet-table tr.r-section td, table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ border: 1px solid #000; font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }" +
            "table.sheet-table tr.r-section td.text-left { text-align: center !important; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Labeled("Till Date :", tillDate));
    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));

    // ── rows ──
    var first = true;
    foreach (var (title, rows) in sections)
    {
        if (!rows.Any()) continue;

        if (!first) table.Spacer();
        first = false;

        table.Section(title);
        table.Header();                        // same titles as the columns
        foreach (var row in rows)
        {
            table.Data(
                row.Indicator ?? "",
                row.Objective ?? "",
                row.Formula ?? "",
                row.Measurement ?? "",
                row.Value?.ToString("0.00") ?? "",
                row.Achievement ?? "");
        }
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())