<!-- Views/Report/Account/OtherReports/BankReceivedPaymentReport.cshtml -->
@using NexgenCosysReport.Dtos.RequestDtos.Account.OthersReport
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<BankReceivedPaymentRowDto>) ?? new List<BankReceivedPaymentRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? rows.Sum(r => r.CashReceived ?? 0);
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All";
    var paymentType = Model["PaymentType"]?.ToString() ?? "";
    var transactionType = Model["TransactionType"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    Func<decimal?, string> N = v => (v ?? 0m).ToString("N2");

    // Grouped by Bank Name (LedgerHead) — the recurring categorical field in this
    // report, same pattern as the Deposit Type / Particulars / Saving Type
    // groupings used across the other converted reports. No re-ordering here —
    // groups/rows print in the order the repository already returned (per OrderBy).
    var bankGroups = rows
        .GroupBy(r => r.LedgerHead ?? "")
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Bank Received Payment Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .group-row td {
                font-weight: bold;
                padding-top: 8px;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 5px;
                padding-bottom: 5px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="BankReceivedPayment">
            <colgroup>
                <col style="width:12%;" />
                <col style="width:17%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:35%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="6">Bank Received Payment Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="6"><strong>Branch Name :</strong> @branchNames</td>
                </tr>
                <tr class="meta-spacer"><td colspan="6"></td></tr>

                <tr class="meta-row">
                    <td colspan="3"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="3" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="3"></td>
                    <td colspan="3" class="text-right"><strong>Payment Type :</strong> @paymentType</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="3"></td>
                    <td colspan="3" class="text-right"><strong>Transaction Type :</strong> @transactionType</td>
                </tr>
                <tr class="meta-spacer"><td colspan="6"></td></tr>

                <tr>
                    <th>Member Id</th>
                    <th>Name</th>
                    <th>Account No</th>
                    <th class="text-right">Amount</th>
                    <th>Date</th>
                    <th>Transaction Description</th>
                </tr>

                @if (bankGroups.Any())
                {
                    foreach (var bankGroup in bankGroups)
                    {
                        <tr class="group-row">
                            <td colspan="6">@bankGroup.Key</td>
                        </tr>

                        foreach (var row in bankGroup)
                        {
                            <tr class="detail-row">
                                <td>@(row.MemberId ?? "")</td>
                                <td>@(row.MemberName ?? "")</td>
                                <td>@(row.Accountno ?? "")</td>
                                <td class="text-right">@N(row.CashReceived)</td>
                                <td>@(row.TransactionOn ?? "")</td>
                                <td>@(row.Description ?? "")</td>
                            </tr>
                        }

                        <tr class="subtotal-row">
                            <td colspan="3" class="text-right">@bankGroup.Key</td>
                            <td class="text-right">@N(bankGroup.Sum(r => r.CashReceived ?? 0))</td>
                            <td colspan="2"></td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="3" class="text-right">Grand Total</td>
                        <td class="text-right">@N(totalAmount)</td>
                        <td colspan="2"></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="3" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                        <td colspan="2"></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No bank received payment records found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
