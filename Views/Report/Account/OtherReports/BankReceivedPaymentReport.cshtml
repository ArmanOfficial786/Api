@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // amounts always show two decimals, a missing amount prints 0.00 (same as before)
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<BankReceivedPaymentRowDto>) ?? new List<BankReceivedPaymentRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All");
    var paymentType = Text("PaymentType");
    var transactionType = Text("TransactionType");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.CashReceived ?? 0));

    // grouped by bank name (LedgerHead), in the order the repository returned the rows (per OrderBy)
    var bankGroups = rows.GroupBy(r => r.LedgerHead ?? "").ToList();

    var table = new ReportTable(Model, title: "Bank Received Payment Report", sheetName: "BankReceivedPayment")
        .Column("Member Id", 12)
        .Column("Name", 17)
        .Column("Account No", 12)
        .Column("Amount", 12, Align.Right)
        .Column("Date", 12)
        .Column("Transaction Description", 35)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            // bank line: bold, no rules
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(HtmlString.Empty, Fmt.Labeled("Payment Type :", paymentType));
    table.MetaRow(HtmlString.Empty, Fmt.Labeled("Transaction Type :", transactionType));

    // ── rows: one block per bank (bank line, payments, bank total) ──
    foreach (var bankGroup in bankGroups)
    {
        // bank line: one cell spanning all columns
        table.GroupTitle(bankGroup.Key);

        foreach (var row in bankGroup)
        {
            table.Data(
                row.MemberId ?? "",
                row.MemberName ?? "",
                row.Accountno ?? "",
                N(row.CashReceived),
                row.TransactionOn ?? "",
                row.Description ?? "");
        }

        // label spans the first 3 columns; the 3 values fill Amount, Date and Description
        table.SubTotal(bankGroup.Key, 3, N(bankGroup.Sum(r => r.CashReceived ?? 0)), "", "");
    }

    // grand total and record count, both in the Amount column
    if (rows.Count > 0)
    {
        table.Total("Grand Total", 3, N(totalAmount), "", "");
        table.Total("Total Records", 3, totalRecords.ToString(), "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())