@using System.Globalization
@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // date and time exactly as before, e.g. 3/14/2026 9:05:00 AM
    string Dt(DateTime? v) => v.HasValue ? v.Value.ToString("M/d/yyyy h:mm:ss tt", CultureInfo.InvariantCulture) : "";

    var rows = (Model["Rows"] as List<AccountDayOpenAndCloseRowDto>) ?? new List<AccountDayOpenAndCloseRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);

    // grouped by branch (OfficeName), in the order the branches first appear:
    // the repository must return the rows already sorted by OfficeName
    var branchGroups = rows.GroupBy(r => r.OfficeName ?? "").ToList();

    var table = new ReportTable(Model, title: "Account Date Opened And Closed Report", sheetName: "AccountDayOpenAndClose")
        .Column("Opened Date", 12)
        .Column("Opened By", 14)
        .Column("Opened On", 16)
        .Column("Closed By", 12)
        .Column("Closed On", 16)
        .Column("Status", 10)
        .Column("Type", 10)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            // branch line: bold, no rules
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));

    // ── rows: one block per branch ──
    foreach (var branchGroup in branchGroups)
    {
        // branch line: one cell spanning all columns
        table.GroupTitle(branchGroup.Key);

        foreach (var row in branchGroup)
        {
            table.Data(
                row.OpenedDateOnBs ?? "",
                row.OpenedBy ?? "",
                Dt(row.OpenedOn),
                row.ClosedBy ?? "",
                Dt(row.ClosedOn),
                row.Status ?? "",
                row.EveningCounter ?? "");
        }
    }

    // footer: one right-aligned cell spanning all 7 columns
    if (rows.Count > 0)
        table.Total($"Total Records : {totalRecords}", 7);
}
@await Html.PartialAsync("_SheetReport", table.Build())