@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<AccountYearClosingRowDto>) ?? new List<AccountYearClosingRowDto>();

    var branchNames = Text("BranchNames", "All Branches");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);

    // grouped by branch, in the order the branches first appear:
    // the repository must return the rows already sorted by BranchName
    var branchGroups = rows.GroupBy(r => r.BranchName ?? "").ToList();

    var table = new ReportTable(Model, title: "Account Year Closing Report", sheetName: "AccountYearClosing")
        .Column("Accounting Year", 20)
        .Column("Closed Date", 18)
        .Column("Voucher No", 18)
        .Column("Status", 22)
        .Column("Closed By", 22)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            // branch line: bold, underlined, no rules
            "table.sheet-table tr.r-group td { text-decoration: underline; border-top: 0; border-bottom: 0; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Labeled("Branch Name :", branchNames));

    // ── rows: one block per branch ──
    foreach (var branchGroup in branchGroups)
    {
        // branch line: one cell spanning all columns
        table.GroupTitle(branchGroup.Key);

        foreach (var row in branchGroup)
        {
            table.Data(
                row.AccountYear ?? "",
                row.ClosedOnBs ?? "",
                row.VoucherNo ?? "",
                row.Status ?? "",
                row.ClosedBy ?? "");
        }
    }

    // footer: one right-aligned cell spanning all 5 columns
    if (rows.Count > 0)
        table.Total($"Total Records : {totalRecords}", 5);
}
@await Html.PartialAsync("_SheetReport", table.Build())