<!-- Views/Report/Account/OthersReport/DailyIncomeReport.cshtml -->
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<DailyIncomeRowDto>) ?? new List<DailyIncomeRowDto>();
    var totalDebitAmount = Model["TotalDebitAmount"] as decimal? ?? 0;
    var totalCreditAmount = Model["TotalCreditAmount"] as decimal? ?? 0;
    var totalBalance = Model["TotalBalance"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Grouped by Main Ledger, then aggregated by Sub Ledger — the SP returns one row
    // per voucher/transaction, so the same SubLedger name (e.g. "INTEREST INCOME FROM
    // LOAN") repeats many times. Sum those into a single displayed line per SubLedger
    // per MainLedger group. Rows must arrive pre-sorted by MainLedger, SubLedger
    // (see repository's ORDER BY) since GroupBy preserves first-seen order, not sorted order.
    var mainLedgerGroups = rows
        .GroupBy(r => r.MainLedger ?? "")
        .Select(g => new
        {
            MainLedger = g.Key,
            SubLedgers = g.GroupBy(r => r.SubLedger ?? "")
                          .Select(sg => new
                          {
                              SubLedger = sg.Key,
                              DebitAmount = sg.Sum(r => r.DebitAmount ?? 0m),
                              CreditAmount = sg.Sum(r => r.CreditAmount ?? 0m),
                              Balance = sg.Sum(r => r.Balance ?? 0m)
                          })
                          .ToList()
        })
        .ToList();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Daily Income Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .data-table th {
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
                font-weight: bold;
            }

            .main-ledger-row td {
                font-weight: bold;
                padding-top: 10px;
                padding-bottom: 2px;
                border: none;
            }

            .main-ledger-row.first-group td {
                padding-top: 4px;
            }

            .sub-ledger-row td {
                color: #1565c0;
                border: none;
            }

            .subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="DailyIncome">
            <colgroup>
                <col style="width:40%;" />
                <col style="width:20%;" />
                <col style="width:20%;" />
                <col style="width:20%;" />
            </colgroup>
            <tbody>
                <tr class="meta-row">
                    <td><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="2"></td>
                    <td class="text-right"><strong>Branch Name :</strong> @branchNames</td>
                </tr>
                <tr>
                    <th>Particulars</th>
                    <th class="text-right">Debit Amount</th>
                    <th class="text-right">Credit Amount</th>
                    <th class="text-right">Balance</th>
                </tr>

                @if (mainLedgerGroups.Any())
                {
                    bool isFirstGroup = true;
                    foreach (var group in mainLedgerGroups)
                    {
                        <tr class="main-ledger-row @(isFirstGroup ? "first-group" : "")">
                            <td colspan="4">@group.MainLedger</td>
                        </tr>
                        isFirstGroup = false;

                        foreach (var sub in group.SubLedgers)
                        {
                            <tr class="sub-ledger-row">
                                <td>@sub.SubLedger</td>
                                <td class="text-right">@sub.DebitAmount.ToString("N2")</td>
                                <td class="text-right">@sub.CreditAmount.ToString("N2")</td>
                                <td class="text-right">@sub.Balance.ToString("N2")</td>
                            </tr>
                        }

                        <tr class="subtotal-row">
                            <td class="text-right">@group.MainLedger</td>
                            <td class="text-right">@group.SubLedgers.Sum(s => s.DebitAmount).ToString("N2")</td>
                            <td class="text-right">@group.SubLedgers.Sum(s => s.CreditAmount).ToString("N2")</td>
                            <td class="text-right">@group.SubLedgers.Sum(s => s.Balance).ToString("N2")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td class="text-right">Grand Total</td>
                        <td class="text-right">@totalDebitAmount.ToString("N2")</td>
                        <td class="text-right">@totalCreditAmount.ToString("N2")</td>
                        <td class="text-right">@totalBalance.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>