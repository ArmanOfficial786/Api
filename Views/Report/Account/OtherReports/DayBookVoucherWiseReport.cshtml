@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a missing amount prints blank (same as before); totals always print two decimals
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<DayBookVoucherWiseRowDto>) ?? new List<DayBookVoucherWiseRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.Amount ?? 0));

    // grouped by voucher date, in the order the repository returned the rows:
    // it must already be sorted by VoucherDate
    var dateGroups = rows.GroupBy(r => r.VoucherDate ?? "").ToList();

    var table = new ReportTable(Model, title: "Day Book Voucher Wise Report", sheetName: "DayBookVoucherWise")
        .Column("Voucher Date", 12)
        .Column("Voucher No", 14)
        .Column("Narration", 38)
        .Column("Voucher Type", 18)
        .Column("Amount", 18, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            // date line: bold, no rules
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 8px; }\n" +
            // voucher rows: no rules
            "table.sheet-table tr.r-data td { border-bottom: 0; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));

    // ── rows: one block per voucher date (date line, then its vouchers) ──
    foreach (var group in dateGroups)
    {
        // date line: one cell spanning all columns
        table.GroupTitle(group.Key);

        foreach (var row in group)
        {
            table.Data(
                "",                              // the date is already on the line above
                row.VoucherNo ?? "",
                row.Narration ?? "",
                row.Type ?? "",
                N(row.Amount));
        }
    }

    // label spans the first 4 columns; the value fills Amount
    if (rows.Count > 0)
    {
        table.Total("Grand Total", 4, totalAmount.ToString("N2"));
        table.Total("Total Records", 4, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())