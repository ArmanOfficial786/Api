@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<DayBookVoucherWiseRowDto>) ?? new List<DayBookVoucherWiseRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Grouped by Voucher Date — the date is shown once as a bold header, with all
    // vouchers on that date listed underneath (Voucher Date column left blank on
    // detail rows since the header already states it). Rows must arrive pre-sorted
    // by VoucherDate (see repository's ORDER BY) since GroupBy preserves first-seen
    // order, not sorted order.
    var dateGroups = rows.GroupBy(r => r.VoucherDate ?? "").ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Day Book Voucher Wise Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
                font-weight: bold;
            }

            .date-header-row td {
                font-weight: bold;
                padding-top: 10px;
                padding-bottom: 2px;
                border: none;
            }

            .date-header-row.first-group td {
                padding-top: 4px;
            }

            .detail-row td {
                border: none;
                padding: 3px 6px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="DayBookVoucherWise">
            <colgroup>
                <col style="width:12%;" />
                <col style="width:14%;" />
                <col style="width:38%;" />
                <col style="width:18%;" />
                <col style="width:18%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="5">Day Book Voucher Wise Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="2"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="3" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="2"></td>
                    <td colspan="3" class="text-right"><strong>Branch Name :</strong> @branchName</td>
                </tr>
                <tr class="meta-spacer"><td colspan="5"></td></tr>

                <tr>
                    <th>Voucher Date</th>
                    <th>Voucher No</th>
                    <th>Narration</th>
                    <th>Voucher Type</th>
                    <th class="text-right">Amount</th>
                </tr>

                @if (dateGroups.Any())
                {
                    bool isFirstGroup = true;
                    foreach (var group in dateGroups)
                    {
                        <tr class="date-header-row @(isFirstGroup ? "first-group" : "")">
                            <td colspan="5">@group.Key</td>
                        </tr>
                        isFirstGroup = false;

                        foreach (var row in group)
                        {
                            <tr class="detail-row">
                                <td></td>
                                <td>@(row.VoucherNo ?? "")</td>
                                <td>@(row.Narration ?? "")</td>
                                <td>@(row.Type ?? "")</td>
                                <td class="text-right">@(row.Amount.HasValue ? row.Amount.Value.ToString("N2") : "")</td>
                            </tr>
                        }
                    }

                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Grand Total</td>
                        <td class="text-right">@totalAmount.ToString("N2")</td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>