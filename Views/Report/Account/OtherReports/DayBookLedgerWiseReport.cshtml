@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 4;   // number of .Column(...) lines below; the group lines span all of them

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a negative amount prints in brackets, a missing amount prints 0.00 (same as before)
    // (named Money, not Fmt, because Fmt is the helper class of the report table)
    string Money(decimal? v)
    {
        var val = v ?? 0m;
        return val < 0 ? $"({Math.Abs(val):N2})" : val.ToString("N2");
    }

    var rows = (Model["Rows"] as List<DayBookLedgerWiseRowDto>) ?? new List<DayBookLedgerWiseRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var totalBalance = TotalOr("TotalBalance", rows.Sum(r => r.TodayBalance ?? 0));

    // Two levels: ledger head (e.g. ASSETS) -> main ledger (e.g. CASH & BANK BALANCES).
    // Every row is a different voucher, so rows are NOT added up: each one prints on its own line.
    // The repository must return the rows already sorted by LedgerHead, MainLedger.
    var ledgerHeadGroups = rows.GroupBy(r => r.LedgerHead ?? "").ToList();

    // the three sub ledgers share one cell, separated by non-breaking spaces; a missing one prints "-"
    string Particulars(DayBookLedgerWiseRowDto r) =>
        string.Join("\u00A0\u00A0\u00A0\u00A0",
            new[] { r.SubLedger1, r.SubLedger2, r.SubLedger3 }
                .Select(s => string.IsNullOrWhiteSpace(s) ? "-" : s));

    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;

    var table = new ReportTable(Model, title: "Day Book Ledger Wise Report", sheetName: "DayBookLedgerWise")
        .Column("Particulars", 35)
        .Column("Narration", 25)
        .Column("Voucher No.", 20)
        .Column("Balance", 20, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            // ledger head and main ledger lines: bold, no rules
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 6px; }\n" +
            // the main ledger line is indented under its ledger head
            "table.sheet-table tr.r-group td.main-ledger { padding-left: 20px; padding-top: 3px; }\n" +
            // detail rows: no rules
            "table.sheet-table tr.r-data td { border-bottom: 0; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Labeled("Branch Name :", branchNames));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));

    // ── rows: ledger head line, then for each main ledger its line and its vouchers ──
    foreach (var headGroup in ledgerHeadGroups)
    {
        table.GroupTitle(headGroup.Key);

        foreach (var mainGroup in headGroup.GroupBy(r => r.MainLedger ?? ""))
        {
            // main ledger line: one indented cell spanning all columns
            table.GroupBy(new ReportCell(mainGroup.Key, Align.Left, ColumnCount, "main-ledger"));

            foreach (var row in mainGroup)
            {
                table.Data(
                    Particulars(row),
                    Dash(row.Narration),
                    Dash(row.VoucherNo),
                    Money(row.TodayBalance));
            }
        }
    }

    // label spans the first 3 columns; the value fills Balance
    if (rows.Count > 0)
        table.Total("Grand Total", 3, Money(totalBalance));
}
@await Html.PartialAsync("_SheetReport", table.Build())