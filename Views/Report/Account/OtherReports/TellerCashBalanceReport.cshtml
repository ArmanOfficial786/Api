@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a missing amount prints 0.00 (same as before)
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    var isNepali = Model.TryGetValue("NepaliReport", out var nv) && nv is bool nb && nb;
    string L(string en, string np) => isNepali ? np : en;

    var rows = (Model["Rows"] as List<TellerCashBalanceRowDto>) ?? new List<TellerCashBalanceRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var officeName = Text("OfficeName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalClosingBalance = TotalOr("TotalClosingBalance", rows.Sum(r => r.ClosingBalance ?? 0));

    var dateGroups = rows.GroupBy(r => r.Date ?? "").ToList();

    var table = new ReportTable(Model,
            title: L("Teller Cash Balance Report", "टेलर नगद मौज्दात प्रतिवेदन"),
            sheetName: "TellerCashBalance")
        .Column(L("Date", "मिति"), 8)
        .Column(L("Teller Name", "टेलरको नाम"), 11)
        .Column(L("Cash From Vault", "भल्टबाट नगद"), 10, Align.Right)
        .Column(L("Cash From Teller", "टेलरबाट नगद"), 10, Align.Right)
        .Column(L("Cash Collection", "नगद संकलन"), 10, Align.Right)
        .Column(L("Cash Expense", "नगद खर्च"), 9, Align.Right)
        .Column(L("Cash Balance", "नगद मौज्दात"), 10, Align.Right)
        .Column(L("Cash to Teller", "टेलरलाई नगद"), 9, Align.Right)
        .Column(L("Cash To Vault", "भल्टमा नगद"), 9, Align.Right)
        .Column(L("Closing Cash Balance", "अन्तिम नगद मौज्दात"), 14, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 10, firstPageExtraMm: 75)   // headers may wrap to two lines
        .Css(
            (isNepali ? "body { font-family: 'Kalimati', 'Noto Sans Devanagari', Arial, sans-serif; }" : "") +
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 5px; }" +
            // column titles may wrap, as in the old report
            "table.sheet-table tr.r-header th { white-space: normal; font-size: 8pt; line-height: 1.2; }" +
            // plain detail and date rows: no lines
            "table.sheet-table tr.r-data td, table.sheet-table tr.r-group td { border: 0; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled(L("Report Generated On", "प्रतिवेदन उत्पन्न मिति") + " :", generatedOn),
        Fmt.Join(
            Fmt.Labeled(L("From Date", "देखि मिति") + " :", fromDate),
            Fmt.Labeled(L("To Date", "सम्म मिति") + " :", toDate)),
        leftSpan: 4);
    table.MetaRow(
        new HtmlString(""),
        Fmt.Labeled(L("Branch Name", "शाखाको नाम") + " :", officeName),
        leftSpan: 4);

    // ── rows: one group per date ──
    foreach (var group in dateGroups)
    {
        var g = group.ToList();

        table.GroupTitle(group.Key);

        foreach (var row in g)
        {
            table.Data(
                "",
                row.TellerName ?? "",
                N(row.TellerCashFromVault),
                N(row.TellerFrom),
                N(row.CashCollection),
                N(row.CashExpense),
                N(row.CashBalance),
                N(row.TellerTo),
                N(row.TellerCashToVault),
                N(row.ClosingBalance));
        }

        // label (the date) spans the first 2 columns; the 8 totals fill the rest
        table.SubTotal(group.Key, 2,
            N(g.Sum(r => r.TellerCashFromVault)),
            N(g.Sum(r => r.TellerFrom)),
            N(g.Sum(r => r.CashCollection)),
            N(g.Sum(r => r.CashExpense)),
            N(g.Sum(r => r.CashBalance)),
            N(g.Sum(r => r.TellerTo)),
            N(g.Sum(r => r.TellerCashToVault)),
            N(g.Sum(r => r.ClosingBalance)));
    }

    // label spans the first 9 columns; the value fills the Closing Cash Balance column
    if (rows.Count > 0)
    {
        table.Total(L("Grand Total (Closing Balance)", "जम्मा (अन्तिम मौज्दात)"), 9, totalClosingBalance.ToString("N2"));
        table.Total(L("Total Records", "कुल रेकर्ड"), 9, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())