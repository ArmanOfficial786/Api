@* Views/Report/Account/OtherReports/TellerCashBalanceReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount.OthersReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<TellerCashBalanceRowDto>) ?? new List<TellerCashBalanceRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalClosingBalance = Model["TotalClosingBalance"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var officeName = Model["OfficeName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var isNepali = Model.ContainsKey("NepaliReport") && Model["NepaliReport"] is bool nr && nr;
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string Fmt(decimal? v) => (v ?? 0m).ToString("N2");
    string L(string en, string np) => isNepali ? np : en;

    var dateGroups = rows.GroupBy(r => r.Date ?? "").ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@L("Teller Cash Balance Report", "टेलर नगद मौज्दात प्रतिवेदन")</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: @(isNepali ? "'Kalimati', 'Noto Sans Devanagari', Arial, sans-serif" : "Arial, sans-serif");
                font-size: 8.5pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8.5pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 5px;
                    vertical-align: middle;
                }

            /* Report title / subheader — was missing entirely; this is the visible
                           bold underlined heading that appears inside the rendered report body,
                           distinct from the HTML <title> tag which never shows in a PDF. */
            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: right;
                white-space: normal;
                font-weight: bold;
                font-size: 8pt;
                line-height: 1.2;
            }

                .data-table th:nth-child(-n+2) {
                    text-align: left;
                }

            .detail-row td {
                text-align: right;
                border: none;
            }

                .detail-row td:nth-child(-n+2) {
                    text-align: left;
                }

            .date-group-row td {
                font-weight: bold;
                padding-top: 2px;
            }

            .subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                text-align: right;
            }

                .subtotal-row td:nth-child(-n+2) {
                    text-align: left;
                }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="TellerCashBalance">
            <colgroup>
                <col style="width:8%;" />
                <col style="width:11%;" />
                <col style="width:10%;" />
                <col style="width:10%;" />
                <col style="width:10%;" />
                <col style="width:9%;" />
                <col style="width:10%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:14%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="10">@L("Teller Cash Balance Report", "टेलर नगद मौज्दात प्रतिवेदन")</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="4"><strong>@L("Report Generated On", "प्रतिवेदन उत्पन्न मिति") :</strong> @generatedOn</td>
                    <td colspan="6" class="text-right">
                        <strong>@L("From Date", "देखि मिति") :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>@L("To Date", "सम्म मिति") :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="4"></td>
                    <td colspan="6" class="text-right"><strong>@L("Branch Name", "शाखाको नाम") :</strong> @officeName</td>
                </tr>
                <tr class="meta-spacer"><td colspan="10"></td></tr>

                <tr>
                    <th>@L("Date", "मिति")</th>
                    <th>@L("Teller Name", "टेलरको नाम")</th>
                    <th>@L("Cash From Vault", "भल्टबाट नगद")</th>
                    <th>@L("Cash From Teller", "टेलरबाट नगद")</th>
                    <th>@L("Cash Collection", "नगद संकलन")</th>
                    <th>@L("Cash Expense", "नगद खर्च")</th>
                    <th>@L("Cash Balance", "नगद मौज्दात")</th>
                    <th>@L("Cash to Teller", "टेलरलाई नगद")</th>
                    <th>@L("Cash To Vault", "भल्टमा नगद")</th>
                    <th>@L("Closing Cash Balance", "अन्तिम नगद मौज्दात")</th>
                </tr>

                @if (dateGroups.Any())
                {
                    foreach (var group in dateGroups)
                    {
                        var groupRows = group.ToList();

                        <tr class="date-group-row">
                            <td colspan="10">@group.Key</td>
                        </tr>

                        foreach (var row in groupRows)
                        {
                            <tr class="detail-row">
                                <td></td>
                                <td>@(row.TellerName ?? "")</td>
                                <td>@Fmt(row.TellerCashFromVault)</td>
                                <td>@Fmt(row.TellerFrom)</td>
                                <td>@Fmt(row.CashCollection)</td>
                                <td>@Fmt(row.CashExpense)</td>
                                <td>@Fmt(row.CashBalance)</td>
                                <td>@Fmt(row.TellerTo)</td>
                                <td>@Fmt(row.TellerCashToVault)</td>
                                <td>@Fmt(row.ClosingBalance)</td>
                            </tr>
                        }

                        <tr class="subtotal-row">
                            <td></td>
                            <td>@group.Key</td>
                            <td>@Fmt(groupRows.Sum(r => r.TellerCashFromVault))</td>
                            <td>@Fmt(groupRows.Sum(r => r.TellerFrom))</td>
                            <td>@Fmt(groupRows.Sum(r => r.CashCollection))</td>
                            <td>@Fmt(groupRows.Sum(r => r.CashExpense))</td>
                            <td>@Fmt(groupRows.Sum(r => r.CashBalance))</td>
                            <td>@Fmt(groupRows.Sum(r => r.TellerTo))</td>
                            <td>@Fmt(groupRows.Sum(r => r.TellerCashToVault))</td>
                            <td>@Fmt(groupRows.Sum(r => r.ClosingBalance))</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="9" class="text-right">@L("Grand Total (Closing Balance)", "जम्मा (अन्तिम मौज्दात)")</td>
                        <td class="text-right">@totalClosingBalance.ToString("N2")</td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="9" class="text-right">@L("Total Records", "कुल रेकर्ड")</td>
                        <td class="text-right">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">@L("No data found for the selected criteria", "छानिएको मापदण्डको लागि डाटा फेला परेन")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>