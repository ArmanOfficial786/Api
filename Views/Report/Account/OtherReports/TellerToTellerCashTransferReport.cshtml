@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    // a missing amount prints blank (same as before)
    string A(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<TellerToTellerCashTransferRowDto>) ?? new List<TellerToTellerCashTransferRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // grouped by Teller From; rows must arrive pre-sorted by TellerFrom (the repository's ORDER BY),
    // because GroupBy keeps first-seen order, not sorted order
    var tellerFromGroups = rows.GroupBy(r => r.TellerFrom ?? "").ToList();

    // ── cell helpers (every row covers the 20 grid units) ──
    ReportCell Hd(string t, int span, Align a = Align.Left) => new(t, a, span);    // column title
    ReportCell Pad(int span) => new("", Align.Left, span, "pad");                  // indent in front of the denomination box
    ReportCell Lb(string t, int span) => new(t, Align.Left, span, "bx b");         // "Rs 50"
    ReportCell Xc(string t, int span) => new(t, Align.Left, span, "bx b");         // "X"
    ReportCell Ct(string t, int span) => new(t, Align.Left, span, "bx");           // note count
    ReportCell Am(string t, int span) => new(t, Align.Right, span, "bx");          // note count x face value
    ReportCell St(string t, int span, Align a = Align.Left) => new(t, a, span, "st");   // group subtotal line

    var table = new ReportTable(Model, title: "Teller To Teller Cash Transfer Report", sheetName: "TellerToTellerCashTransfer")
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            GroupBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)   // one text line per row
        .Css(
            "body { font-family: \"Times New Roman\", Times, serif; } " +
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }" +
            // teller line and transaction line: no rules
            "table.sheet-table tr.r-group td, table.sheet-table tr.r-data td { border: 0; }" +
            "table.sheet-table td.ind { padding-left: 20px; }" +
            // denomination box
            "table.sheet-table td.bx { border: 1px solid #000 !important; padding: 1px 8px; }" +
            "table.sheet-table td.pad { border: 0 !important; }" +
            "table.sheet-table td.b { font-weight: bold; }" +
            // group subtotal: bold with a heavy line above
            "table.sheet-table td.st { font-weight: bold; border-top: 2px solid #000 !important; padding-top: 3px; padding-bottom: 3px; }");

    for (var i = 0; i < 20; i++) table.Column("", 1);

    // one line of the denomination box = two notes side by side: 2 + 1 + 2 + 4 units each, after a 2-unit indent
    // (declared after 'table' so it can use it)
    void DenomRow(string l1, decimal? c1, decimal f1, string l2, decimal? c2, decimal f2, bool secondIsPaisa = false)
    {
        var n1 = c1 ?? 0m;
        var n2 = c2 ?? 0m;
        // paisa has no "X" and its amount prints as 0.00 (same as before)
        table.Data(
            Pad(2),
            Lb(l1, 2), Xc("X", 1), Ct(n1.ToString("0.##"), 2), Am((n1 * f1).ToString("N2"), 4),
            Lb(l2, 2), Xc(secondIsPaisa ? "" : "X", 1), Ct(n2.ToString("0.##"), 2), Am(secondIsPaisa ? "0.00" : (n2 * f2).ToString("N2"), 4));
    }

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));

    // column titles, printed once under the title block: 5 columns of 4 units each (20% each; the old widths were 22/22/22/17/17)
    table.Header(Hd("Teller From", 4), Hd("Teller To", 4), Hd("Date", 4), Hd("Amount", 4, Align.Right), Hd("Issued By", 4));

    // ── rows: one group per Teller From, one record (line + denomination box) per transfer, then a subtotal ──
    foreach (var group in tellerFromGroups)
    {
        var groupRows = group.ToList();

        table.GroupTitle(group.Key);

        foreach (var row in groupRows)
        {
            table.Data(
                new ReportCell(row.TellerTo ?? "", Align.Left, 4, "ind"),
                new ReportCell(row.OfficeName ?? "", Align.Left, 4),
                new ReportCell(row.Date ?? "", Align.Left, 4),
                new ReportCell(A(row.Amount), Align.Right, 4),
                new ReportCell(row.IssuedBy ?? "", Align.Left, 4));

            DenomRow("Rs 1",  row.Rs1,  1m,  "Rs 50",   row.Rs50,   50m);
            DenomRow("Rs 2",  row.Rs2,  2m,  "Rs 100",  row.Rs100,  100m);
            DenomRow("Rs 5",  row.Rs5,  5m,  "Rs 250",  row.Rs250,  250m);
            DenomRow("Rs 10", row.Rs10, 10m, "Rs 500",  row.Rs500,  500m);
            DenomRow("Rs 20", row.Rs20, 20m, "Rs 1000", row.Rs1000, 1000m);
            DenomRow("Rs 25", row.Rs25, 25m, "Paisa",   row.Paisa,  0m, secondIsPaisa: true);

            table.Spacer();
        }

        // subtotal of the group: Teller From name centred under Date, the sum under Amount
        table.Data(
            St("", 4),
            St("", 4),
            St(group.Key, 4, Align.Center),
            St(groupRows.Sum(r => r.Amount ?? 0m).ToString("N2"), 4, Align.Right),
            St("", 4));

        table.Spacer();
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())