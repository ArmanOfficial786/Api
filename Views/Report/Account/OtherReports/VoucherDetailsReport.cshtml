<!-- Views/Report/Account/OtherReports/VoucherDetailsReport.cshtml -->
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<VoucherDetailsRowDto>) ?? new List<VoucherDetailsRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalDebitAmount = Model["TotalDebitAmount"] as decimal? ?? 0;
    var totalCreditAmount = Model["TotalCreditAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var viewType = Model["ViewType"]?.ToString() ?? "None";
    var isGrouping = string.Equals(viewType, "Grouping", StringComparison.OrdinalIgnoreCase);

    string Fmt(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";

    var voucherGroups = !isGrouping
        ? rows.GroupBy(r => r.VoucherNo ?? "").ToList()
        : null;

    var ledgerGroups = isGrouping
        ? rows.GroupBy(r => (Main: r.MainLedger ?? "", Sub: r.SubLedger1 ?? ""))
              .OrderBy(g => g.Key.Main).ThenBy(g => g.Key.Sub)
              .ToList()
        : null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Voucher Details Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 8px;
                    vertical-align: top;
                }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            /* -------- Title / meta -------- */
            .report-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 10px 8px 12px 8px;
            }

            .meta-row td {
                padding: 2px 8px;
                font-size: 9pt;
            }

            .meta-row.meta-last td {
                padding-bottom: 6px;
                border-bottom: 1px solid #000;
            }

            .meta-right {
                text-align: right;
            }

            /* -------- Column headers -------- */
            .column-header-row th {
                text-align: left;
                font-weight: bold;
                border-top: none;
                border-bottom: 1.5px solid #000;
                padding: 6px 8px;
            }

            /* -------- "None" (per-voucher) layout -------- */
            .voucher-header-row td {
                border-top: 1px solid #000;
                padding-top: 6px;
            }

            .leg-row td {
                border: none;
            }

            .narration-ledger-row td {
                border: none;
            }

            .voucher-subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 5px;
                padding-bottom: 8px;
            }

            /* -------- "Grouping" (per-ledger) layout -------- */
            .ledger-header-row td {
                font-weight: bold;
                font-size: 9.5pt;
                padding: 10px 8px 4px 8px;
                border-bottom: 1px solid #000;
            }

            .ledger-header-row.first-group td {
                padding-top: 6px;
            }

            .ledger-detail-row td {
                padding: 3px 8px;
            }

            .ledger-subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding: 5px 8px 8px 8px;
            }

            /* -------- Grand total -------- */
            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 8px;
            }

            @@media print {
                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="VoucherDetails">
            <colgroup>
                <col style="width:13%;" />
                <col style="width:13%;" />
                <col style="width:24%;" />
                <col style="width:24%;" />
                <col style="width:13%;" />
                <col style="width:13%;" />
            </colgroup>
            <tbody>
                <tr class="report-title">
                    <td colspan="6">Voucher Details Report@(isGrouping ? " - Group Wise" : "")</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="6"><strong>Branch Name :</strong> @branchNames</td>
                </tr>
                <tr class="meta-row meta-last">
                    <td colspan="3"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="3" class="meta-right">
                        <strong>From Date :</strong> @fromDate &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>

                <tr class="column-header-row">
                    <th>Voucher No</th>
                    <th>Voucher Date</th>
                    <th colspan="2">@(isGrouping ? "Narration" : "Details")</th>
                    <th class="text-right">Debit(Dr)</th>
                    <th class="text-right">Credit(Cr)</th>
                </tr>

                @if (!rows.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
                else if (isGrouping)
                {
                    // ============== GROUPING (ledger-wise) LAYOUT ==============
                    bool isFirstLedger = true;
                    foreach (var ledger in ledgerGroups!)
                    {
                        var ledgerRows = ledger.ToList();
                        var ledgerLabel = string.IsNullOrEmpty(ledger.Key.Sub)
                            ? ledger.Key.Main
                            : $"{ledger.Key.Main} - {ledger.Key.Sub}";

                        <tr class="ledger-header-row @(isFirstLedger ? "first-group" : "")">
                            <td colspan="6">@ledgerLabel</td>
                        </tr>
                        isFirstLedger = false;

                        foreach (var row in ledgerRows)
                        {
                            <tr class="ledger-detail-row">
                                <td>@(row.VoucherNo ?? "")</td>
                                <td>@(row.VoucherOnBs ?? "")</td>
                                <td colspan="2">@(row.Narration ?? row.NarrationLedger ?? "")</td>
                                <td class="text-right">@Fmt(row.DebitAmount)</td>
                                <td class="text-right">@Fmt(row.CreditAmount)</td>
                            </tr>
                        }

                        <tr class="ledger-subtotal-row">
                            <td colspan="4" class="text-right">Sub Total</td>
                            <td class="text-right">@ledgerRows.Sum(r => r.DebitAmount ?? 0m).ToString("N2")</td>
                            <td class="text-right">@ledgerRows.Sum(r => r.CreditAmount ?? 0m).ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    // ============== NONE (per-voucher) LAYOUT ==============
                    foreach (var group in voucherGroups!)
                    {
                        var legRows = group.ToList();
                        var first = legRows.First();

                        <tr class="voucher-header-row">
                            <td>@(first.VoucherNo ?? "")</td>
                            <td>@(first.VoucherOnBs ?? "")</td>
                            <td colspan="2">@(first.OfficeName ?? "")</td>
                            <td></td>
                            <td></td>
                        </tr>

                        foreach (var row in legRows)
                        {
                            <tr class="leg-row">
                                <td></td>
                                <td></td>
                                <td>@(row.MainLedger ?? "")</td>
                                <td>@(row.SubLedger1 ?? "")</td>
                                <td class="text-right">@Fmt(row.DebitAmount)</td>
                                <td class="text-right">@Fmt(row.CreditAmount)</td>
                            </tr>

                            if (!string.IsNullOrEmpty(row.SubLedger2) || !string.IsNullOrEmpty(row.SubLedger3))
                            {
                                <tr class="leg-row">
                                    <td></td>
                                    <td></td>
                                    <td>@(row.SubLedger2 ?? "")</td>
                                    <td>@(row.SubLedger3 ?? "")</td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            }

                            <tr class="narration-ledger-row">
                                <td colspan="4">Ledger Narration : @(row.NarrationLedger ?? "")</td>
                                <td></td>
                                <td></td>
                            </tr>
                        }

                        <tr class="voucher-subtotal-row">
                            <td colspan="4">Narration : &nbsp; @(first.Narration ?? "")</td>
                            <td class="text-right">@legRows.Sum(r => r.DebitAmount ?? 0m).ToString("N2")</td>
                            <td class="text-right">@legRows.Sum(r => r.CreditAmount ?? 0m).ToString("N2")</td>
                        </tr>
                    }
                }

                @if (rows.Any())
                {
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Grand Total</td>
                        <td class="text-right">@totalDebitAmount.ToString("N2")</td>
                        <td class="text-right">@totalCreditAmount.ToString("N2")</td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Total Records</td>
                        <td colspan="2" class="text-center">@totalRecords</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
