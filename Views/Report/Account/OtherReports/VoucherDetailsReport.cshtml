@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    // a missing amount prints blank (same as before); totals always print two decimals
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "";

    // one cell with full control (span, alignment, css)
    ReportCell C(string t, int span = 1, Align a = Align.Left, string? css = null) => new(t, a, span, css);

    var rows = (Model["Rows"] as List<VoucherDetailsRowDto>) ?? new List<VoucherDetailsRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var viewType = Text("ViewType", "None");
    var isGrouping = string.Equals(viewType, "Grouping", StringComparison.OrdinalIgnoreCase);
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalDebit = TotalOr("TotalDebitAmount", rows.Sum(r => r.DebitAmount ?? 0m));
    var totalCredit = TotalOr("TotalCreditAmount", rows.Sum(r => r.CreditAmount ?? 0m));

    var voucherGroups = !isGrouping
        ? rows.GroupBy(r => r.VoucherNo ?? "").ToList()
        : null;

    var ledgerGroups = isGrouping
        ? rows.GroupBy(r => (Main: r.MainLedger ?? "", Sub: r.SubLedger1 ?? ""))
              .OrderBy(g => g.Key.Main).ThenBy(g => g.Key.Sub)
              .ToList()
        : null;

    var table = new ReportTable(Model,
            title: "Voucher Details Report" + (isGrouping ? " - Group Wise" : ""),
            sheetName: "VoucherDetails")
        .Column("Voucher No", 13)
        .Column("Voucher Date", 13)
        .Column(isGrouping ? "Narration" : "Details", 24)
        .Column("", 24)
        .Column("Debit(Dr)", 13, Align.Right)
        .Column("Credit(Cr)", 13, Align.Right)
        .NoColumnHeader()                      // the column titles are printed below with Header(...) because "Details" spans 2 columns
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 8px; }" +
            // ledger line (grouping layout) is a little bigger
            "table.sheet-table tr.r-group td { font-size: 9.5pt; }" +
            // detail lines: no rules
            "table.sheet-table tr.r-data td { border: 0; }" +
            // voucher header line and voucher narration / total line (per-voucher layout)
            "table.sheet-table td.vh { border-top: 1px solid #000 !important; padding-top: 4px; }" +
            "table.sheet-table td.vs { font-weight: bold; border-top: 1px solid #000 !important; padding-top: 3px; padding-bottom: 3px; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));

    // ── column titles ──
    table.Header(
        C("Voucher No"),
        C("Voucher Date"),
        C(isGrouping ? "Narration" : "Details", 2),
        C("Debit(Dr)", 1, Align.Right),
        C("Credit(Cr)", 1, Align.Right));

    if (isGrouping)
    {
        // ============== GROUPING (ledger-wise) LAYOUT ==============
        foreach (var ledger in ledgerGroups!)
        {
            var ledgerRows = ledger.ToList();
            var ledgerLabel = string.IsNullOrEmpty(ledger.Key.Sub)
                ? ledger.Key.Main
                : $"{ledger.Key.Main} - {ledger.Key.Sub}";

            table.GroupTitle(ledgerLabel);

            foreach (var row in ledgerRows)
            {
                table.Data(
                    C(row.VoucherNo ?? ""),
                    C(row.VoucherOnBs ?? ""),
                    C(row.Narration ?? row.NarrationLedger ?? "", 2),
                    C(N(row.DebitAmount), 1, Align.Right),
                    C(N(row.CreditAmount), 1, Align.Right));
            }

            // label spans the first 4 columns; the 2 totals fill Debit and Credit
            table.SubTotal("Sub Total", 4,
                ledgerRows.Sum(r => r.DebitAmount ?? 0m).ToString("N2"),
                ledgerRows.Sum(r => r.CreditAmount ?? 0m).ToString("N2"));
        }
    }
    else
    {
        // ============== NONE (per-voucher) LAYOUT ==============
        foreach (var group in voucherGroups!)
        {
            var legRows = group.ToList();
            var first = legRows.First();

            // voucher header line: number, date, branch
            table.Data(
                C(first.VoucherNo ?? "", 1, Align.Left, "vh"),
                C(first.VoucherOnBs ?? "", 1, Align.Left, "vh"),
                C(first.OfficeName ?? "", 2, Align.Left, "vh"),
                C("", 1, Align.Left, "vh"),
                C("", 1, Align.Left, "vh"));

            foreach (var row in legRows)
            {
                table.Data("", "", row.MainLedger ?? "", row.SubLedger1 ?? "", N(row.DebitAmount), N(row.CreditAmount));

                if (!string.IsNullOrEmpty(row.SubLedger2) || !string.IsNullOrEmpty(row.SubLedger3))
                    table.Data("", "", row.SubLedger2 ?? "", row.SubLedger3 ?? "", "", "");

                table.Data(C("Ledger Narration : " + (row.NarrationLedger ?? ""), 4), C(""), C(""));
            }

            // voucher narration with the voucher's debit and credit totals
            table.Data(
                C("Narration :  " + (first.Narration ?? ""), 4, Align.Left, "vs"),
                C(legRows.Sum(r => r.DebitAmount ?? 0m).ToString("N2"), 1, Align.Right, "vs"),
                C(legRows.Sum(r => r.CreditAmount ?? 0m).ToString("N2"), 1, Align.Right, "vs"));
        }
    }

    // label spans the first 4 columns; the values fill the Debit and Credit columns
    if (rows.Count > 0)
    {
        table.Total("Grand Total", 4, totalDebit.ToString("N2"), totalCredit.ToString("N2"));
        table.Total("Total Records", 4, totalRecords.ToString(), "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())