@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    string N(decimal? v) => (v ?? 0).ToString("N2");

    var rows = (Model["Rows"] as List<ReserveMasterRowDto>) ?? new List<ReserveMasterRowDto>();

    // optional: shown only when the controller supplies "AccountedLoss"
    decimal accountedLoss = 0;
    if (Model.TryGetValue("AccountedLoss", out var lossValue) && lossValue != null)
        accountedLoss = Convert.ToDecimal(lossValue);

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All Branches");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalPercentage = rows.Sum(r => r.Percentage ?? 0);
    var grandTotal = rows.Sum(r => r.Amount ?? 0);

    var table = new ReportTable(Model, title: "Reserve Master Report", sheetName: "ReserveMaster")
        .Column("Title", 60)
        .Column("Percentage", 20, Align.Right)
        .Column("Amount", 20, Align.Right)
        .Style(new ReportStyle
        {
            HeaderBackground = "#f9f9f9",
            ZebraBackground = "#f9f9f9",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 85)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }" +
            // accumulated-loss box, centred on its own line
            "table.sheet-table tr.meta-row td:has(.loss-box) { text-align: center; padding: 4px 0; }" +
            ".loss-box { display: inline-block; border: 1px solid #000; padding: 6px 24px; font-size: 10pt; font-weight: bold; }" +
            ".loss-box .loss-value { margin-left: 40px; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));

    var lossBox = new HtmlContentBuilder();
    lossBox.AppendHtml("<span class=\"loss-box\">ACCUMULATED LOSS<span class=\"loss-value\">")
           .Append(accountedLoss.ToString("N2"))
           .AppendHtml("</span></span>");
    table.MetaRow(lossBox);

    // ── rows ──
    foreach (var row in rows)
    {
        table.Data(
            row.Title ?? "",
            N(row.Percentage),
            N(row.Amount));
    }

    // label fills the Title column; the values fill Percentage and Amount
    if (rows.Count > 0)
    {
        table.Total("Total :", 1, totalPercentage.ToString("N2"), grandTotal.ToString("N2"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())