@* Views/Report/AccountOperation/OthersReport/CashAndBankBalanceReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Account.OthersReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var bankRows = (Model["BankRows"] as List<CashAndBankBalanceBankRowDto>) ?? new List<CashAndBankBalanceBankRowDto>();
    var tellerRows = (Model["TellerRows"] as List<CashAndBankBalanceTellerRowDto>) ?? new List<CashAndBankBalanceTellerRowDto>();
    var cashRows = (Model["CashRows"] as List<CashAndBankBalanceCashRowDto>) ?? new List<CashAndBankBalanceCashRowDto>();

    var finalBankAmount = Model["FinalBankAmount"] as decimal? ?? 0;
    var finalCashAmount = Model["FinalCashAmount"] as decimal? ?? 0;

    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string Fmt(decimal? v) => v.HasValue ? (v.Value < 0 ? $"({Math.Abs(v.Value):N2})" : v.Value.ToString("N2")) : "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Cash And Bank Balance Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 8px;
            }

            .section-header td {
                background: #e8e8e8;
                font-weight: bold;
                font-size: 10pt;
                padding: 5px 6px;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
            }

            .grid-header {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: right;
                white-space: nowrap;
            }

                .grid-header:nth-child(-n+2) {
                    text-align: left;
                }

            .detail-row td {
                border-bottom: 1px solid #eee;
                text-align: right;
            }

                .detail-row td:nth-child(-n+2) {
                    text-align: left;
                }

            .summary-table {
                width: 100%;
                border-collapse: collapse;
                margin: 12px 0;
            }

                .summary-table th, .summary-table td {
                    border: 1px solid #000;
                    padding: 5px 8px;
                    text-align: right;
                }

                .summary-table th {
                    background: #f0f0f0;
                    text-align: center;
                    font-weight: bold;
                }

                .summary-table td:first-child {
                    text-align: left;
                    font-weight: bold;
                }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }

                .section-header td {
                    background: #e8e8e8 !important;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <tr class="meta-title">
                <td colspan="5">Cash And Bank Balance Report</td>
            </tr>
            <tr class="meta-row">
                <td colspan="2"><strong>Branch :</strong> @branchName</td>
                <td colspan="3" class="text-right"><strong>Till Date :</strong> @tillDate</td>
            </tr>
            <tr class="meta-row">
                <td colspan="5"><strong>Report Generated On :</strong> @generatedOn</td>
            </tr>
            <tr class="meta-spacer"><td colspan="5"></td></tr>
        </table>

        <!-- Bank ledger section -->
        <table class="data-table" data-sheet-name="CashAndBankBalance-Bank">
            <tbody>
                <tr class="section-header"><td colspan="5">Bank Balance</td></tr>
                <tr>
                    <th class="grid-header">Main Ledger</th>
                    <th class="grid-header">Sub Ledger</th>
                    <th class="grid-header">Debit</th>
                    <th class="grid-header">Credit</th>
                    <th class="grid-header">Balance</th>
                </tr>
                @if (bankRows.Any())
                {
                    foreach (var row in bankRows)
                    {
                        <tr class="detail-row">
                            <td>@(row.MainLedger ?? "")</td>
                            <td>@(row.SubLedger ?? "")</td>
                            <td>@Fmt(row.DebitAmount)</td>
                            <td>@Fmt(row.CreditAmount)</td>
                            <td>@Fmt(row.Balance)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">No bank data found</td></tr>
                }
            </tbody>
        </table>

        <!-- Teller section -->
        <table class="data-table" data-sheet-name="CashAndBankBalance-Teller">
            <tbody>
                <tr class="section-header"><td colspan="3">Teller Cash Balance</td></tr>
                <tr>
                    <th class="grid-header">Teller Name</th>
                    <th class="grid-header">Branch</th>
                    <th class="grid-header">Cash Balance</th>
                </tr>
                @if (tellerRows.Any())
                {
                    foreach (var row in tellerRows)
                    {
                        <tr class="detail-row">
                            <td>@(row.TellerName ?? "")</td>
                            <td>@(row.OfficeName ?? "")</td>
                            <td>@Fmt(row.CashBalance)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-center">No teller data found</td></tr>
                }
            </tbody>
        </table>

        <!-- Cash ledger section -->
        <table class="data-table" data-sheet-name="CashAndBankBalance-Cash">
            <tbody>
                <tr class="section-header"><td colspan="5">Cash Balance</td></tr>
                <tr>
                    <th class="grid-header">Main Ledger</th>
                    <th class="grid-header">Sub Ledger</th>
                    <th class="grid-header">Debit</th>
                    <th class="grid-header">Credit</th>
                    <th class="grid-header">Balance</th>
                </tr>
                @if (cashRows.Any())
                {
                    foreach (var row in cashRows)
                    {
                        <tr class="detail-row">
                            <td>@(row.MainLedger ?? "")</td>
                            <td>@(row.SubLedger ?? "")</td>
                            <td>@Fmt(row.DebitAmount)</td>
                            <td>@Fmt(row.CreditAmount)</td>
                            <td>@Fmt(row.Balance)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">No cash data found</td></tr>
                }
            </tbody>
        </table>

        <!-- Final summary — matches GetCashAndBankBalanceDetails exactly -->
        <table class="summary-table">
            <tr>
                <th>Bank</th>
                <th>Cash (incl. Teller Balance)</th>
            </tr>
            <tr>
                <td>@Fmt(finalBankAmount)</td>
                <td>@Fmt(finalCashAmount)</td>
            </tr>
        </table>
    </div>
</body>
</html>