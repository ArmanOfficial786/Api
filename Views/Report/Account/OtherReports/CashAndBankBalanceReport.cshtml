@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.OthersReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 4;   // number of .Column(...) lines below; section titles span all of them

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    // amounts always show two decimals, a missing amount prints 0.00 (same as before)
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    var bankRows = (Model["BankRows"] as List<CashAndBankBalanceBankRowDto>) ?? new List<CashAndBankBalanceBankRowDto>();
    var tellerRows = (Model["TellerRows"] as List<CashAndBankBalanceTellerRowDto>) ?? new List<CashAndBankBalanceTellerRowDto>();
    var cashRows = (Model["CashRows"] as List<CashAndBankBalanceCashRowDto>) ?? new List<CashAndBankBalanceCashRowDto>();

    var tillDate = Text("TillDate");
    var branchName = Text("BranchName", "All");
    var isNepali = Model.TryGetValue("NepaliReport", out var np) && np is bool nepali && nepali;
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // ── language-specific labels ──
    string title = isNepali ? "रोकड र बैंक शेष विवरण" : "Cash And Bank Balance Report";
    string lblGenerated = isNepali ? "प्रिन्ट मिति :" : "Report Generated On:";
    string lblTillDate = isNepali ? "आज सम्म :" : "Till Date:";
    string lblBranch = isNepali ? "शाखाको नाम :" : "Branch Name:";
    string lblCashSection = isNepali ? "नगद मौज्दात" : "Cash Balance";
    string lblTellerSection = isNepali ? "टेलर मौज्दात" : "Teller Balance";
    string lblBankSection = isNepali ? "बैंक मौज्दात" : "Bank Balance";
    string lblTellerName = isNepali ? "टेलरको नाम" : "Teller Name";
    string lblCashIn = isNepali ? "नगद भित्रिएको" : "Cash In";
    string lblCashOut = isNepali ? "नगद निस्किएको" : "Cash Out";
    string lblCashBal = isNepali ? "नगद मौज्दात" : "Cash Balance";
    string lblOpening = isNepali ? "अल्या मौज्दात :" : "Opening Balance :-";
    string lblDr = isNepali ? "चालु डे :" : "Current Day DR :-";
    string lblCr = isNepali ? "चालु के :" : "Current Day CR :-";
    string lblTodayBal = isNepali ? "चालु मौज्दात :" : "Current Day Balance :-";
    string lblClosing = isNepali ? "शेष मौज्दात :" : "Closing Balance:-";
    string lblNoBank = isNepali ? "बैंक विवरण फेला परेन" : "No bank records found";

    string BankName(CashAndBankBalanceBankRowDto r) => isNepali ? (r.BankNameInNepali ?? r.BankName ?? "") : (r.BankName ?? "");

    // a bold left cell (label) and a right-aligned cell (amount), for the cash and bank blocks
    ReportCell Label(string text, int span = 1) => new(text, Align.Left, span, "label-cell");
    ReportCell Value(string text) => new(text, Align.Right);

    var table = new ReportTable(Model, title: title, sheetName: "CashAndBankBalance")
        .Column("", 25)
        .Column("", 25, Align.Right)
        .Column("", 25, Align.Right)
        .Column("", 25, Align.Right)
        .NoColumnHeader()                     // every section writes its own header
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            // boxed cells, as before
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td { border: 1px solid #000; }\n" +
            // section titles: centred, underlined, no rules
            "table.sheet-table tr.r-group td { text-align: center; font-size: 11pt; text-decoration: underline; border: 0; padding-top: 6px; }\n" +
            ".label-cell { font-weight: bold; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled(lblGenerated, generatedOn), Fmt.Labeled(lblTillDate, tillDate));
    table.MetaRow(Fmt.Labeled(lblBranch, branchName));

    // ── CASH BALANCE: three lines per cash account ──
    table.GroupBy(ReportCell.Center(lblCashSection, ColumnCount));
    foreach (var row in cashRows)
    {
        table.Data(Label(row.CashName ?? "", 2), Label(lblOpening), Value(N(row.OpeningCashBalance)));
        table.Data(Label(lblDr), Value(N(row.TodayCashDr)), Label(lblTodayBal), Value(N(row.TodayCashBalance)));
        table.Data(Label(lblCr), Value(N(row.TodayCashCr)), Label(lblClosing), Value(N(row.ClosingCashBalance)));
    }

    // ── TELLER BALANCE: a small table with its own header ──
    table.GroupBy(ReportCell.Center(lblTellerSection, ColumnCount));
    table.Header(lblTellerName, lblCashIn, lblCashOut, lblCashBal);
    if (tellerRows.Count > 0)
    {
        foreach (var row in tellerRows)
            table.Data(row.TellerName ?? "", N(row.CashIn), N(row.CashOut), N(row.CashBalance));
    }
    else
    {
        table.Data("", "", "", "");           // one empty line, as before
    }

    // ── BANK BALANCE: three lines per bank ──
    table.GroupBy(ReportCell.Center(lblBankSection, ColumnCount));
    if (bankRows.Count > 0)
    {
        foreach (var row in bankRows)
        {
            table.Data(Label(BankName(row), 2), Label(lblOpening), Value(N(row.OpeningBankBalance)));
            table.Data(Label(lblDr), Value(N(row.TodayBankDr)), Label(lblTodayBal), Value(N(row.TodayBankBalance)));
            table.Data(Label(lblCr), Value(N(row.TodayBankCr)), Label(lblClosing), Value(N(row.ClosingBankBalance)));
        }
    }
    else
    {
        table.Data(ReportCell.Center(lblNoBank, ColumnCount));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())