@using NexgenCosysReport.Dtos.RequestDtos.Account.OthersReport

@model Dictionary<string, object>
@{
    Layout = null;

    var bankRows = (Model["BankRows"] as List<CashAndBankBalanceBankRowDto>) ?? new List<CashAndBankBalanceBankRowDto>();
    var tellerRows = (Model["TellerRows"] as List<CashAndBankBalanceTellerRowDto>) ?? new List<CashAndBankBalanceTellerRowDto>();
    var cashRows = (Model["CashRows"] as List<CashAndBankBalanceCashRowDto>) ?? new List<CashAndBankBalanceCashRowDto>();
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var isNepali = Model["NepaliReport"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Language-specific labels
    string title = isNepali ? "रोकड र बैंक शेष विवरण" : "Cash And Bank Balance Report";
    string lblGenerated = isNepali ? "प्रिन्ट मिति :" : "Report Generated On:";
    string lblTillDate = isNepali ? "आज सम्म :" : "Till Date:";
    string lblBranch = isNepali ? "शाखाको नाम :" : "Branch Name:";
    string lblCashSection = isNepali ? "नगद मौज्दात" : "Cash Balance";
    string lblTellerSection = isNepali ? "टेलर मौज्दात" : "Teller Balance";
    string lblBankSection = isNepali ? "बैंक मौज्दात" : "Bank Balance";
    string lblTellerName = isNepali ? "टेलरको नाम" : "Teller Name";
    string lblCashIn = isNepali ? "नगद भित्रिएको" : "Cash In";
    string lblCashOut = isNepali ? "नगद निस्किएको" : "Cash Out";
    string lblCashBal = isNepali ? "नगद मौज्दात" : "Cash Balance";
    string lblOpening = isNepali ? "अल्या मौज्दात :" : "Opening Balance :-";
    string lblDr = isNepali ? "चालु डे :" : "Current Day DR :-";
    string lblCr = isNepali ? "चालु के :" : "Current Day CR :-";
    string lblTodayBal = isNepali ? "चालु मौज्दात :" : "Current Day Balance :-";
    string lblClosing = isNepali ? "शेष मौज्दात :" : "Closing Balance:-";

    Func<CashAndBankBalanceBankRowDto, string> bankName = r => isNepali ? (r.BankNameInNepali ?? r.BankName ?? "") : (r.BankName ?? "");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                    border: 1px solid #000;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
                border: none;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                border: none;
            }

            .section-title td {
                text-align: center;
                font-size: 11pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px;
                border: none;
            }

            .label-cell {
                font-weight: bold;
            }

            .value-cell {
                text-align: right;
            }

            th {
                background: #f9f9f9;
                font-weight: bold;
                text-align: left;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="CashAndBankBalance">
            <colgroup>
                <col style="width:25%;" />
                <col style="width:25%;" />
                <col style="width:25%;" />
                <col style="width:25%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="4">@title</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="2"><strong>@lblGenerated</strong> @generatedOn</td>
                    <td colspan="2" class="text-right"><strong>@lblTillDate</strong> @tillDate</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="2"><strong>@lblBranch</strong> @branchName</td>
                    <td colspan="2"></td>
                </tr>

                <!-- ============ CASH BALANCE ============ -->
                <tr class="section-title"><td colspan="4">@lblCashSection</td></tr>

                @if (cashRows.Any())
                {
                    foreach (var row in cashRows)
                    {
                        var name = isNepali ? (row.CashName ?? "") : (row.CashName ?? "");
                        <tr>
                            <td colspan="2" class="label-cell">@name</td>
                            <td class="label-cell">@lblOpening</td>
                            <td class="value-cell">@(row.OpeningCashBalance?.ToString("N2") ?? "0.00")</td>
                        </tr>
                        <tr>
                            <td class="label-cell">@lblDr</td>
                            <td class="value-cell">@(row.TodayCashDr?.ToString("N2") ?? "0.00")</td>
                            <td class="label-cell">@lblTodayBal</td>
                            <td class="value-cell">@(row.TodayCashBalance?.ToString("N2") ?? "0.00")</td>
                        </tr>
                        <tr>
                            <td class="label-cell">@lblCr</td>
                            <td class="value-cell">@(row.TodayCashCr?.ToString("N2") ?? "0.00")</td>
                            <td class="label-cell">@lblClosing</td>
                            <td class="value-cell">@(row.ClosingCashBalance?.ToString("N2") ?? "0.00")</td>
                        </tr>
                    }
                }

                <!-- ============ TELLER BALANCE ============ -->
                <tr class="section-title"><td colspan="4">@lblTellerSection</td></tr>
                <tr>
                    <th>@lblTellerName</th>
                    <th class="text-right">@lblCashIn</th>
                    <th class="text-right">@lblCashOut</th>
                    <th class="text-right">@lblCashBal</th>
                </tr>
                @if (tellerRows.Any())
                {
                    foreach (var row in tellerRows)
                    {
                        <tr>
                            <td>@(row.TellerName ?? "")</td>
                            <td class="text-right">@(row.CashIn?.ToString("N2") ?? "0.00")</td>
                            <td class="text-right">@(row.CashOut?.ToString("N2") ?? "0.00")</td>
                            <td class="text-right">@(row.CashBalance?.ToString("N2") ?? "0.00")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                }

                <!-- ============ BANK BALANCE ============ -->
                <tr class="section-title"><td colspan="4">@lblBankSection</td></tr>

                @if (bankRows.Any())
                {
                    foreach (var row in bankRows)
                    {
                        <tr>
                            <td colspan="2" class="label-cell">@bankName(row)</td>
                            <td class="label-cell">@lblOpening</td>
                            <td class="value-cell">@(row.OpeningBankBalance?.ToString("N2") ?? "0.00")</td>
                        </tr>
                        <tr>
                            <td class="label-cell">@lblDr</td>
                            <td class="value-cell">@(row.TodayBankDr?.ToString("N2") ?? "0.00")</td>
                            <td class="label-cell">@lblTodayBal</td>
                            <td class="value-cell">@(row.TodayBankBalance?.ToString("N2") ?? "0.00")</td>
                        </tr>
                        <tr>
                            <td class="label-cell">@lblCr</td>
                            <td class="value-cell">@(row.TodayBankCr?.ToString("N2") ?? "0.00")</td>
                            <td class="label-cell">@lblClosing</td>
                            <td class="value-cell">@(row.ClosingBankBalance?.ToString("N2") ?? "0.00")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">
                            @(isNepali ? "बैंक विवरण फेला परेन" : "No bank records found")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>