@using NexgenCosysReport.Dtos.RequestDtos.Account;
@model Dictionary<string, object>
@{
    Layout = null;
    var rows = (Model["Rows"] as List<DetailTrialBalanceRowDto>) ?? new List<DetailTrialBalanceRowDto>();
    var totalDebit = Model["TotalDebit"] as decimal? ?? 0;
    var totalCredit = Model["TotalCredit"] as decimal? ?? 0;
    var totalAssetExpenses = Model["TotalAssetExpenses"] as decimal? ?? 0;
    var totalLiabilitiesIncome = Model["TotalLiabilitiesIncome"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    int sn = 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Detail Trial Balance Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 0;
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
            }

                .data-table td, .data-table th {
                    padding: 4px 6px;
                    border: 1px solid #ddd;
                }

                .data-table th {
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    background: #f2f2f2;
                }

            .grand-total {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .summary-label {
                font-weight: bold;
                background: #f0f0f0;
            }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr><th colspan="8" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">Detail Trial Balance Report</th></tr>
                <tr><td colspan="8"><strong>Branch:</strong> @branchName &nbsp;&nbsp;|&nbsp;&nbsp; <strong>From:</strong> @fromDate &nbsp;&nbsp;|&nbsp;&nbsp; <strong>To:</strong> @toDate &nbsp;&nbsp;|&nbsp;&nbsp; <strong>Generated:</strong> @generatedOn</td></tr>
                <tr>
                    <th style="width:5%;">SN</th>
                    <th style="width:15%;">Ledger Head</th>
                    <th style="width:15%;">Main Ledger</th>
                    <th style="width:20%;">Sub Ledger</th>
                    <th style="width:15%;">Sub Ledger1</th>
                    <th style="width:15%;">Sub Ledger2</th>
                    <th style="width:10%;" class="text-right">Debit</th>
                    <th style="width:10%;" class="text-right">Credit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    sn++;
                    <tr>
                        <td class="text-center">@sn</td>
                        <td>@row.LedgerHead</td>
                        <td>@row.MainLedger</td>
                        <td>@row.SubLedger</td>
                        <td>@row.SubLedger1</td>
                        <td>@row.SubLedger2</td>
                        <td class="text-right">@FormatAmount(row.DebitAmount)</td>
                        <td class="text-right">@FormatAmount(row.CreditAmount)</td>
                    </tr>
                }
                <tr class="grand-total">
                    <td colspan="6" class="text-right"><strong>Total</strong></td>
                    <td class="text-right"><strong>@FormatAmount(totalDebit)</strong></td>
                    <td class="text-right"><strong>@FormatAmount(totalCredit)</strong></td>
                </tr>
                <tr>
                    <td colspan="7" class="summary-label">Total Assets / Expenses</td>
                    <td class="text-right"><strong>@FormatAmount(totalAssetExpenses)</strong></td>
                </tr>
                <tr>
                    <td colspan="7" class="summary-label">Total Liabilities / Income</td>
                    <td class="text-right"><strong>@FormatAmount(totalLiabilitiesIncome)</strong></td>
                </tr>
                <tr class="grand-total">
                    <td colspan="7"><strong>Difference (Assets - Liabilities)</strong></td>
                    <td class="text-right"><strong>@FormatAmount(totalAssetExpenses - totalLiabilitiesIncome)</strong></td>
                </tr>
            </tbody>
        </table>
    </div>
</body>
</html>