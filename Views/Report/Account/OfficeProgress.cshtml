@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport;
@model Dictionary<string, object>

@{
    Layout = null;
    var rows = (Model["Rows"] as List<OfficeProgressRowDto>) ?? new List<OfficeProgressRowDto>();
    var grandTotal = Model["GrandTotal"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "";
    var reportType = Model["ReportType"]?.ToString() ?? "";
    var provisionType = Model["ProvisionType"]?.ToString() ?? "";
    var enable1to30 = Model["Enable1to30Days"] as bool? ?? false;
    var groupByBranch = Model["GroupByBranch"] as bool? ?? false;
    var groupByCollectionCenter = Model["GroupByCollectionCenter"] as bool? ?? false;
    var viewDetail = Model["ViewDetail"] as bool? ?? true;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    int sn = 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Office Progress Report</title>
    <style>
            * { margin:0; padding:0; box-sizing:border-box; }
            body { margin:0; padding:0; font-family:Arial, sans-serif; font-size:9pt; background:white; }
            .report-container { width:100%; overflow:visible; }
            .data-table { width:100%; border-collapse:collapse; font-size:9pt; }
            .data-table td, .data-table th { padding:4px 6px; border:1px solid #ddd; }
            .data-table th { border-top:2px solid #000; border-bottom:1px solid #000; background:#f2f2f2; }
            .section-title { background:#e6e6e6; font-weight:bold; text-align:center; }
            .grand-total { border-top:2px solid #000; border-bottom:2px solid #000; font-weight:bold; background:#f9f9f9; }
            .text-right { text-align:right !important; }
            .text-center { text-align:center !important; }
            .sub-total { font-weight:bold; background:#f0f0f0; }
    </style>
</head>
<body>
    <div class="report-container">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table">
            <thead>
                <tr><th colspan="6" style="text-align:center; font-size:14pt; font-weight:bold; text-decoration:underline;">@reportType Report</th></tr>
                <tr><td colspan="6"><strong>Branch:</strong> @branchName &nbsp;&nbsp;|&nbsp;&nbsp; <strong>Till Date:</strong> @tillDate &nbsp;&nbsp;|&nbsp;&nbsp; <strong>Generated:</strong> @generatedOn &nbsp;&nbsp;|&nbsp;&nbsp; <strong>Provision:</strong> @provisionType &nbsp;&nbsp;|&nbsp;&nbsp; <strong>1-30 Days:</strong> @(enable1to30 ? "Yes" : "No")</td></tr>
                <tr>
                    <th style="width:5%;">SN</th>
                    @if (groupByBranch)
                    {
                        <th style="width:15%;">Branch</th>
                    }
                    @if (groupByCollectionCenter)
                    {
                        <th style="width:15%;">Collection Center</th>
                    }
                    <th style="width:20%;">Member</th>
                    <th style="width:15%;">Member Id</th>
                    <th style="width:20%;" class="text-right">Balance</th>
                    <th style="width:20%;" class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Any())
                {
                    sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr>
                            <td class="text-center">@sn</td>
                            @if (groupByBranch)
                            {
                                <td>@row.BranchName</td>
                            }
                            @if (groupByCollectionCenter)
                            {
                                <td>@row.CollectionCenterName</td>
                            }
                            <td>@row.MemberName</td>
                            <td>@row.MemberId</td>
                            <td class="text-right">@FormatAmount(row.Balance)</td>
                            <td class="text-right">@FormatAmount(row.Amount)</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td colspan="@(3 + (groupByBranch ? 1 : 0) + (groupByCollectionCenter ? 1 : 0))" class="text-right"><strong>Total</strong></td>
                        <td class="text-right"><strong>@FormatAmount(grandTotal)</strong></td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="6" class="text-center">No data found</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>