@using NexgenCosysReport.Dtos.RequestDtos.Account
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    var rows = (Model["BalanceSheetRows"] as IEnumerable<BalanceSheetDto>)?.ToList()
        ?? new List<BalanceSheetDto>();

    var reportType = Text("ReportType", "Summary");
    var branchName = Text("BranchName", "All");
    var fiscalYearLabel = Text("FiscalYearLabel");
    var tillDate = Text("TillDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var includePrevious = Model.TryGetValue("IncludePreviousYearBalance", out var includePreviousValue)
        && includePreviousValue is bool includePreviousFlag
        && includePreviousFlag;

    decimal grandDebit = rows.Sum(row => row.DebitAmount);
    decimal grandCredit = rows.Sum(row => row.CreditAmount);

    // LIABILITIES (incl. UNDISTRIBUTED SURPLUS) first, then ASSETS (incl. ACCUMULATED LOSS)
    var groupedByLedgerHead = rows
        .GroupBy(row => row.LedgerHead ?? "-")
        .OrderByDescending(ledgerGroup => ledgerGroup.Key == "LIABILITIES")
        .ToList();

    var totalLiabilities = groupedByLedgerHead.Where(ledgerGroup => ledgerGroup.Key == "LIABILITIES")
        .SelectMany(ledgerGroup => ledgerGroup).Sum(row => row.CurrentAmount);
    var totalAssets = groupedByLedgerHead.Where(ledgerGroup => ledgerGroup.Key == "ASSETS")
        .SelectMany(ledgerGroup => ledgerGroup).Sum(row => row.CurrentAmount);
    var difference = totalLiabilities - totalAssets;
    var isBalanced = Math.Abs(difference) < 1m;   // allow for rounding noise

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    string LedgerLabel(int? ledgerNo, string mainLedger) =>
        ledgerNo == null ? mainLedger : $"{ledgerNo}\u00A0\u00A0\u00A0{mainLedger}";

    // deepest available label: "SubLedger — SubLedger1 — SubLedger2" (Detail mode)
    string SubLedgerLabel(BalanceSheetDto row)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(row.SubLedger) && row.SubLedger != "-") parts.Add(row.SubLedger);
        if (!string.IsNullOrEmpty(row.SubLedger1) && row.SubLedger1 != "-") parts.Add(row.SubLedger1);
        if (!string.IsNullOrEmpty(row.SubLedger2) && row.SubLedger2 != "-") parts.Add(row.SubLedger2);
        return parts.Count > 0 ? string.Join(" — ", parts) : "-";
    }

    // Debit | Credit | Current Year | [Previous Year]
    ReportCell[] AmountCells(decimal debit, decimal credit, decimal current, decimal previous, string css = null)
    {
        var cells = new List<ReportCell>
        {
            new ReportCell(Fmt.Amount(debit), Align.Right, 1, css),
            new ReportCell(Fmt.Amount(credit), Align.Right, 1, css),
            new ReportCell(FormatAmount(current), Align.Right, 1, css)
        };
        if (includePrevious)
            cells.Add(new ReportCell(FormatAmount(previous), Align.Right, 1, css));
        return cells.ToArray();
    }

    ReportCell[] WithLeading(ReportCell[] leadingCells, ReportCell[] amountCells) =>
        leadingCells.Concat(amountCells).ToArray();

    var columnCount = includePrevious ? 6 : 5;

    var table = new ReportTable(Model, title: "Balance Sheet Report", sheetName: "BalanceSheetReport")
        .Column("Ledger Head", 16)
        .Column("Sub Ledger", includePrevious ? 28 : 34)
        .Column("Debit Amount", 14, Align.Right)
        .Column("Credit Amount", 14, Align.Right)
        .Column("Current Year", includePrevious ? 14 : 28, Align.Right);

    if (includePrevious)
        table.Column("Previous Year", 14, Align.Right);

    table
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 80)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-data td.bold   { font-weight: bold; }
            table.sheet-table tr.r-data td.indent { padding-left: 12mm; }
            table.sheet-table tr.r-group td.boxed { border: 1px solid #000; }
            table.sheet-table tr.r-group td.balanced-ok   { color: #196f3d; }
            table.sheet-table tr.r-group td.balanced-diff { color: #b03a2e; }");

    table.MetaPair("Branch Name :", branchName, "Fiscal Year :", fiscalYearLabel)
         .MetaPair("Report Generated On :", generatedOn, "As At :", tillDate + " (B.S.)");

    foreach (var ledgerGroup in groupedByLedgerHead)
    {
        // LIABILITIES / ASSETS group line with its totals
        table.GroupBy(WithLeading(
            new[] { ReportCell.Left(ledgerGroup.Key, 2) },
            AmountCells(
                ledgerGroup.Sum(row => row.DebitAmount),
                ledgerGroup.Sum(row => row.CreditAmount),
                ledgerGroup.Sum(row => row.CurrentAmount),
                ledgerGroup.Sum(row => row.PreviousAmount))));

        var mainLedgerGroups = ledgerGroup
            .GroupBy(row => new { row.LedgerNo, row.MainLedger })
            .OrderBy(mainGroup => mainGroup.Key.LedgerNo ?? int.MaxValue)
            .ToList();

        foreach (var mainGroup in mainLedgerGroups)
        {
            var mainCss = reportType == "Summary" ? null : "bold";

            table.Data(WithLeading(
                new[]
                {
                    new ReportCell("", Align.Left, 1, mainCss),
                    new ReportCell(LedgerLabel(mainGroup.Key.LedgerNo, mainGroup.Key.MainLedger), Align.Left, 1, mainCss)
                },
                AmountCells(
                    mainGroup.Sum(row => row.DebitAmount),
                    mainGroup.Sum(row => row.CreditAmount),
                    mainGroup.Sum(row => row.CurrentAmount),
                    mainGroup.Sum(row => row.PreviousAmount),
                    mainCss)));

            if (reportType == "Summary") continue;

            foreach (var row in mainGroup)
            {
                if (reportType == "SubLedger" && (string.IsNullOrEmpty(row.SubLedger) || row.SubLedger == "-"))
                    continue;

                var label = reportType == "SubLedger" ? row.SubLedger : SubLedgerLabel(row);

                table.Data(WithLeading(
                    new[]
                    {
                        ReportCell.Left(""),
                        new ReportCell(label, Align.Left, 1, "indent")
                    },
                    AmountCells(row.DebitAmount, row.CreditAmount, row.CurrentAmount, row.PreviousAmount)));
            }
        }
    }

    if (rows.Count > 0)
    {
        var grandTotalValues = includePrevious
            ? new[] { Fmt.Amount(grandDebit), Fmt.Amount(grandCredit), "", "" }
            : new[] { Fmt.Amount(grandDebit), Fmt.Amount(grandCredit), "" };
        table.Total("Grand Total :", 2, grandTotalValues);

        // balance check: Total Liabilities vs Total Assets
        table.Spacer();
        table.GroupBy(
            new ReportCell("Total Liabilities (incl. Capital & Surplus) :", Align.Left, 2, "boxed"),
            new ReportCell(FormatAmount(totalLiabilities), Align.Right, columnCount - 2, "boxed"));
        table.GroupBy(
            new ReportCell("Total Assets (incl. Accumulated Loss) :", Align.Left, 2, "boxed"),
            new ReportCell(FormatAmount(totalAssets), Align.Right, columnCount - 2, "boxed"));
        table.GroupBy(
            new ReportCell(isBalanced ? "Balanced :" : "Difference :", Align.Left, 2, "boxed"),
            new ReportCell(FormatAmount(difference), Align.Right, columnCount - 2,
                "boxed " + (isBalanced ? "balanced-ok" : "balanced-diff")));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())