@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    var rows = (Model["TrialBalanceRows"] as IEnumerable<SummaryTrialBalanceRowDto>)?.ToList()
        ?? new List<SummaryTrialBalanceRowDto>();

    var reportType = Text("ReportType", "Detail");
    var branchName = Text("BranchName", "All");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    decimal grandDebit = rows.Sum(row => row.DebitAmount);
    decimal grandCredit = rows.Sum(row => row.CreditAmount);

    var table = new ReportTable(Model, title: "Summary Trial Balance Report", sheetName: "SummaryTrialBalance")
        .Column("Ledger Head", 15)
        .Column("Sub Ledger", 35)
        .Column("Debit", 16, Align.Right)
        .Column("Credit", 17, Align.Right)
        .Column("Balance", 17, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-section td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-section td.text-left { text-align: center !important; }");

    table.MetaPair("Branch Name :", branchName, "From Date :", fromDate)
         .MetaPair("Report Generated On :", generatedOn, "To Date :", toDate);

    if (reportType == "Detail")
    {
        // one section per ledger head / main ledger, with its own total
        var mainLedgerGroups = rows
            .GroupBy(row => new { row.LedgerHead, row.MainLedger })
            .OrderBy(mainGroup => mainGroup.Key.LedgerHead)
            .ThenBy(mainGroup => mainGroup.Key.MainLedger)
            .ToList();

        foreach (var mainGroup in mainLedgerGroups)
        {
            table.Section($"{mainGroup.Key.LedgerHead} - {mainGroup.Key.MainLedger}");

            foreach (var row in mainGroup)
            {
                table.Data(
                    "",
                    $"{row.SubLedger}",
                    FormatAmount(row.DebitAmount),
                    FormatAmount(row.CreditAmount),
                    FormatAmount(row.Balance));
            }

            table.SubTotal($"Total {mainGroup.Key.MainLedger}", 2,
                FormatAmount(mainGroup.Sum(row => row.DebitAmount)),
                FormatAmount(mainGroup.Sum(row => row.CreditAmount)),
                FormatAmount(mainGroup.Sum(row => row.Balance)));
        }
    }
    else
    {
        // Summary mode: flat list, no grouping
        foreach (var row in rows)
        {
            table.Data(
                $"{row.LedgerHead}",
                $"{row.SubLedger}",
                FormatAmount(row.DebitAmount),
                FormatAmount(row.CreditAmount),
                FormatAmount(row.Balance));
        }
    }

    if (rows.Count > 0)
        table.Total("Grand Total :", 2, FormatAmount(grandDebit), FormatAmount(grandCredit), "");
}
@await Html.PartialAsync("_SheetReport", table.Build())