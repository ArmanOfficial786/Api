@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    var displayType = Text("DisplayType", "Horizontal");
    var branchName = Text("BranchName", "All");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    // one shared look for both layouts; zebra stripes off because rows are read left/right in parallel
    ReportTable NewTable(string title, string sheetName) =>
        new ReportTable(Model, title: title, sheetName: sheetName)
            .Style(new ReportStyle { ZebraStripes = false });

    string SharedCss() =>
        "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-section td, " +
        "table.sheet-table tr.r-total td " +
        "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
        "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
        @"
        table.sheet-table tr.r-section td.text-left { text-align: center !important; }
        table.sheet-table tr.r-data td.bold         { font-weight: bold; }
        table.sheet-table tr.r-data td.indent       { padding-left: 5mm; }
        table.sheet-table tr.r-data td.totalline    { font-weight: bold; border-top: 2px solid #000; border-bottom: 2px solid #000; }";

    ReportTable table;

    if (displayType == "Horizontal")
    {
        var data = Model["PLData"] as PLAccountHorizontalData;

        table = NewTable("Profit & Loss Account Report (Horizontal)", "PLAccountHorizontal")
            .Column("EXPENSES", 29)
            .Column("Amount", 19, Align.Right)
            .Column("", 4)
            .Column("INCOME", 29)
            .Column("Amount", 19, Align.Right)
            .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
            .Css(SharedCss());

        table.MetaRow(Fmt.Labeled("Branch Name :", branchName))
             .MetaPair("From Date :", fromDate, "To Date :", toDate)
             .MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

        if (data != null)
        {
            var incomeRows = data.IncomeRows ?? new List<PLAccountRowDto>();
            var expenseRows = data.ExpenseRows ?? new List<PLAccountRowDto>();
            var totalIncome = data.TotalIncome;
            var totalExpense = data.TotalExpense;
            var netProfit = totalIncome - totalExpense;

            // main-ledger line, its sub-ledger lines, then a closing total line
            List<(string Label, string Amount, string Css, Align LabelAlign)> BuildLines(
                List<PLAccountRowDto> sectionRows, string sectionLabel, decimal total)
            {
                var lines = new List<(string Label, string Amount, string Css, Align LabelAlign)>();
                if (sectionRows.Any())
                {
                    var mainLedgerGroups = sectionRows
                        .GroupBy(sectionRow => sectionRow.MainLedger ?? "Other")
                        .OrderBy(mainGroup => mainGroup.Key);

                    foreach (var mainGroup in mainLedgerGroups)
                    {
                        lines.Add((mainGroup.Key, FormatAmount(mainGroup.Sum(groupRow => groupRow.Balance)), "bold", Align.Left));
                        foreach (var detailRow in mainGroup.OrderBy(groupRow => groupRow.SubLedger))
                            lines.Add(($"{detailRow.SubLedger}", FormatAmount(detailRow.Balance), "indent", Align.Left));
                    }
                    lines.Add((sectionLabel, FormatAmount(total), "totalline", Align.Left));
                }
                else
                {
                    lines.Add(($"No {sectionLabel.ToLower()} records found", "", null, Align.Center));
                }
                return lines;
            }

            var expenseLines = BuildLines(expenseRows, "EXPENSES", totalExpense);
            var incomeLines = BuildLines(incomeRows, "INCOME", totalIncome);
            var lineCount = Math.Max(expenseLines.Count, incomeLines.Count);
            var emptyLine = (Label: "", Amount: "", Css: (string)null, LabelAlign: Align.Left);

            for (var lineIndex = 0; lineIndex < lineCount; lineIndex++)
            {
                var expenseLine = lineIndex < expenseLines.Count ? expenseLines[lineIndex] : emptyLine;
                var incomeLine = lineIndex < incomeLines.Count ? incomeLines[lineIndex] : emptyLine;

                table.Data(
                    new ReportCell(expenseLine.Label, expenseLine.LabelAlign, 1, expenseLine.Css),
                    new ReportCell(expenseLine.Amount, Align.Right, 1, expenseLine.Css),
                    ReportCell.Left(""),
                    new ReportCell(incomeLine.Label, incomeLine.LabelAlign, 1, incomeLine.Css),
                    new ReportCell(incomeLine.Amount, Align.Right, 1, incomeLine.Css));
            }

            table.Total(netProfit >= 0 ? "Net Profit :" : "Net Loss :", 4, FormatAmount(Math.Abs(netProfit)));
        }
    }
    else
    {
        var data = Model["PLData"] as PLAccountVerticalData;

        table = NewTable("Profit & Loss Account Report (Vertical)", "PLAccountVertical")
            .NoColumnHeader()   // each ledger head prints its own column titles with Header()
            .Column("Sub Ledger", 65)
            .Column("Amount", 35, Align.Right)
            .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
            .Css(SharedCss());

        table.MetaRow(Fmt.Labeled("Branch Name :", branchName))
             .MetaPair("From Date :", fromDate, "To Date :", toDate)
             .MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

        if (data != null)
        {
            var rows = data.Rows ?? new List<PLAccountRowDto>();
            var netProfit = data.NetProfit;

            if (rows.Any())
            {
                var ledgerHeadGroups = rows
                    .GroupBy(row => row.LedgerHead ?? "Other")
                    .OrderByDescending(ledgerGroup => ledgerGroup.Key == "INCOME")
                    .ToList();

                foreach (var ledgerGroup in ledgerHeadGroups)
                {
                    table.Section(ledgerGroup.Key);
                    table.Header();

                    decimal ledgerHeadTotal = 0;
                    var mainLedgerGroups = ledgerGroup
                        .GroupBy(row => row.MainLedger ?? "Other")
                        .OrderBy(mainGroup => mainGroup.Key);

                    foreach (var mainGroup in mainLedgerGroups)
                    {
                        var mainTotal = mainGroup.Sum(row => row.Balance);
                        ledgerHeadTotal += mainTotal;

                        table.Data(
                            new ReportCell(mainGroup.Key, Align.Left, 1, "bold"),
                            new ReportCell(FormatAmount(mainTotal), Align.Right, 1, "bold"));

                        foreach (var detailRow in mainGroup.OrderBy(row => row.SubLedger))
                        {
                            table.Data(
                                new ReportCell($"{detailRow.SubLedger}", Align.Left, 1, "indent"),
                                ReportCell.Right(FormatAmount(detailRow.Balance)));
                        }
                    }

                    table.Data(
                        new ReportCell($"Total {ledgerGroup.Key}", Align.Left, 1, "totalline"),
                        new ReportCell(FormatAmount(ledgerHeadTotal), Align.Right, 1, "totalline"));
                }

                table.Total(netProfit >= 0 ? "Net Profit :" : "Net Loss :", 1, FormatAmount(Math.Abs(netProfit)));
            }
        }
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())