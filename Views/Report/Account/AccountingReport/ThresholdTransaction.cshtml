@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    // empty values are shown as "-"
    string Dash(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "-" : value.ToString()!;
    // negative amounts in brackets:  (1,250.00)
    string Amount(decimal value) => value < 0 ? $"({Math.Abs(value):N2})" : value.ToString("N2");

    var rows = (Model["Rows"] as List<ThresholdTransactionRowDto>) ?? new List<ThresholdTransactionRowDto>();
    var totalDeposit = Model["TotalDepositAmount"] as decimal? ?? rows.Sum(r => r.AmountInvolvedInDeposit);
    var totalWithdraw = Model["TotalWithdrawAmount"] as decimal? ?? rows.Sum(r => r.AmountInvolvedInWithdraw);
    var totalRecords = Model["TotalRecords"] as int? ?? rows.Count;

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName");
    var transactionNumber = Text("TransactionNumber");
    var memberName = Text("MemberName");
    var orderBy = Text("OrderBy");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Threshold Transaction Report", sheetName: "ThresholdTransaction")
        .Column("SN", 5, Align.Center)
        .Column("Member Id", 12)
        .Column("Member Name", 16)
        .Column("Account No", 10)
        .Column("Bill No", 10)
        .Column("Date", 12)
        .Column("Deposit", 14, Align.Right)
        .Column("Withdraw", 14, Align.Right)
        .Column("Status", 7)
        .Style(new ReportStyle
        {
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9",
            ZebraStripes = false
        })
        //.CellLines(2)                                           // a long name or account number may use two lines
        .Sizing(rowMm: 8, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; border-left: 1px solid #ddd; border-right: 1px solid #ddd; }\n" +
            "table.sheet-table tr.r-data td { border: 1px solid #ddd; }");

    // ── title block: one line; optional filters appear only when used ──
    var infoParts = new List<IHtmlContent>
    {
        Fmt.Labeled("Branch:", branchName),
        Fmt.Labeled("From:", fromDate),
        Fmt.Labeled("To:", toDate),
        Fmt.Labeled("Generated:", generatedOn)
    };
    if (!string.IsNullOrEmpty(transactionNumber)) infoParts.Add(Fmt.Labeled("Bill No:", transactionNumber));
    if (!string.IsNullOrEmpty(memberName)) infoParts.Add(Fmt.Labeled("Member:", memberName));
    if (!string.IsNullOrEmpty(orderBy) && orderBy != "-1") infoParts.Add(Fmt.Labeled("Order By:", orderBy));

    table.MetaRow(Fmt.Join(infoParts.ToArray()));

    // ── rows ──
    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            (++sn).ToString(),
            Dash(row.MemberId),
            Dash(row.MemberName),
            Dash(row.AccountNo),
            Dash(row.TransactionNumber),
            Dash(row.DateOfTransactionOnBS),
            Amount(row.AmountInvolvedInDeposit),
            Amount(row.AmountInvolvedInWithdraw),
            row.IsActive ? "Active" : "Inactive");
    }

    if (rows.Count > 0)
    {
        // label spans the first 6 columns; the record count moves into the label
        table.Total($"Total ({totalRecords} records)", 6, Amount(totalDeposit), Amount(totalWithdraw), "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())