@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    bool Flag(string key) =>
        Model.TryGetValue(key, out var value) && value is bool flag && flag;

    var rows = (Model["Rows"] as IEnumerable<OfficeProgressRowDto>)?.ToList()
        ?? new List<OfficeProgressRowDto>();

    var grandTotal = Model.TryGetValue("GrandTotal", out var grandTotalValue) && grandTotalValue is decimal grandTotalAmount
        ? grandTotalAmount
        : 0m;

    var reportType = Text("ReportType");
    var branchName = Text("BranchName", "All");
    var tillDate = Text("TillDate");
    var provisionType = Text("ProvisionType");
    var enable1to30Days = Flag("Enable1to30Days");
    var groupByBranch = Flag("GroupByBranch");
    var groupByCollectionCenter = Flag("GroupByCollectionCenter");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    var title = string.IsNullOrWhiteSpace(reportType) ? "Office Progress Report" : $"{reportType} Report";

    var table = new ReportTable(Model, title: title, sheetName: "OfficeProgressReport")
        .Column("SN", 5, Align.Center);

    if (groupByBranch)
        table.Column("Branch", 15);
    if (groupByCollectionCenter)
        table.Column("Collection Center", 15);

    table
        .Column("Member", 20)
        .Column("Member Id", 15)
        .Column("Balance", 20, Align.Right)
        .Column("Amount", 20, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaPair("Branch Name :", branchName, "Till Date :", tillDate)
         .MetaPair("Report Generated On :", generatedOn, "Provision :", provisionType)
         .MetaRow(Fmt.Labeled("1-30 Days :", enable1to30Days ? "Yes" : "No"));

    var columnCount = 5 + (groupByBranch ? 1 : 0) + (groupByCollectionCenter ? 1 : 0);

    var serialNumber = 0;
    foreach (var row in rows)
    {
        serialNumber++;

        var values = new List<string> { serialNumber.ToString() };
        if (groupByBranch)
            values.Add($"{row.BranchName}");
        if (groupByCollectionCenter)
            values.Add($"{row.CollectionCenterName}");
        values.Add($"{row.MemberName}");
        values.Add($"{row.MemberId}");
        values.Add(FormatAmount(row.Balance));
        values.Add(FormatAmount(row.Amount));

        table.Data(values.ToArray());
    }

    if (rows.Count > 0)
        table.Total("Total :", columnCount - 1, FormatAmount(grandTotal));
}
@await Html.PartialAsync("_SheetReport", table.Build())