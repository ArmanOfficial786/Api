@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    var data = (CostOfFundData)Model["CostOfFundData"];

    var branchName = Text("BranchName", "All");
    var tillDate = Text("TillDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    string FormatPercent(decimal value) => value.ToString("F2") + "%";

    var table = new ReportTable(Model, title: "Cost of Fund Analysis Report", sheetName: "CostOfFundReport")
        .NoColumnHeader()   // each section prints its own column titles with Header()
        .Column("Type Name", 30)
        .Column("No. of Accounts", 15, Align.Right)
        .Column("Balance (Rs)", 20, Align.Right)
        .Column("Average Interest Rate", 17, Align.Right)
        .Column("WACC (%)", 18, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-section td, " +
            "table.sheet-table tr.r-total td, table.sheet-table tr.r-note td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-section td.text-left { text-align: center !important; }
            table.sheet-table tr.r-note td              { text-align: center; }
            table.sheet-table tr.r-data td.bold         { font-weight: bold; }");

    table.MetaPair("Branch Name :", branchName, "Till Date :", tillDate)
         .MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // right-aligned label across the first four columns, value in the last column
    void SummaryLine(string label, string value, bool boldValue = true) =>
        table.Data(
            new ReportCell(label, Align.Right, 4, "bold"),
            new ReportCell(value, Align.Right, 1, boldValue ? "bold" : null));

    // one table: section bar, column titles, rows, total, then its two cost lines
    void AccountSection(
        string title,
        string emptyText,
        IEnumerable<(string TypeName, decimal AccountCount, decimal Balance, decimal AverageInterestRate, decimal Wacc)> accountRows,
        string costLabel,
        decimal costPercent,
        string costInterestLabel,
        decimal costInterest)
    {
        var accountList = accountRows.ToList();

        table.Section(title);
        if (accountList.Count == 0)
        {
            table.Note(emptyText);
            return;
        }

        table.Header();
        foreach (var accountRow in accountList)
        {
            table.Data(
                accountRow.TypeName,
                accountRow.AccountCount.ToString("N0"),
                FormatAmount(accountRow.Balance),
                FormatPercent(accountRow.AverageInterestRate),
                FormatPercent(accountRow.Wacc));
        }

        table.Total("Total :", 1,
            accountList.Sum(accountRow => accountRow.AccountCount).ToString("N0"),
            FormatAmount(accountList.Sum(accountRow => accountRow.Balance)),
            "",
            "");

        SummaryLine(costLabel, FormatPercent(costPercent));
        SummaryLine(costInterestLabel, FormatAmount(costInterest));
    }

    AccountSection(
        "Deposit / Saving Accounts",
        "No deposit data found",
        data.DepositRows.Select(row => (row.TypeName, (decimal)row.NoOfAccount, row.TotalAmount, row.AverageInterestRate, row.WACC)),
        "Cost of Deposit (Interest Expense / Average Balance) * 100", data.CostOfDeposit,
        "Cost of Deposit Interest", data.CostOfDepositInterest);

    table.Spacer();

    AccountSection(
        "Loan Accounts",
        "No loan data found",
        data.LoanRows.Select(row => (row.TypeName, (decimal)row.NoOfAccount, row.TotalAmount, row.AverageInterestRate, row.WACC)),
        "Cost of Loan (Interest Expense / Average Balance) * 100", data.CostOfLoan,
        "Cost of Loan Interest", data.CostOfLoanInterest);

    table.Spacer();

    // ── Additional ratios ──
    table.Section("Additional Ratios");
    SummaryLine("CRR (Cash Reserve Ratio)", FormatPercent(data.CRR), boldValue: false);
    SummaryLine("SLR (Statutory Liquidity Ratio)", FormatPercent(data.SLR), boldValue: false);
    SummaryLine("CDR (Credit Deposit Ratio)", FormatPercent(data.CDR), boldValue: false);
}
@await Html.PartialAsync("_SheetReport", table.Build())