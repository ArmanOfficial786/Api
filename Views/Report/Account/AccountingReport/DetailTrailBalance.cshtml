@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    decimal Amount(string key) =>
        Model.TryGetValue(key, out var value) && value is decimal amount ? amount : 0m;

    var rows = (Model["Rows"] as IEnumerable<DetailTrialBalanceRowDto>)?.ToList()
        ?? new List<DetailTrialBalanceRowDto>();

    var totalDebit = Amount("TotalDebit");
    var totalCredit = Amount("TotalCredit");
    var totalAssetExpenses = Amount("TotalAssetExpenses");
    var totalLiabilitiesIncome = Amount("TotalLiabilitiesIncome");

    var branchName = Text("BranchName", "All");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    var table = new ReportTable(Model, title: "Detail Trial Balance Report", sheetName: "DetailTrialBalanceReport")
        .Column("SN", 5, Align.Center)
        .Column("Ledger Head", 15)
        .Column("Main Ledger", 15)
        .Column("Sub Ledger", 20)
        .Column("Sub Ledger1", 15)
        .Column("Sub Ledger2", 15)
        .Column("Debit", 10, Align.Right)
        .Column("Credit", 10, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaPair("Branch Name :", branchName, "From Date :", fromDate)
         .MetaPair("Report Generated On :", generatedOn, "To Date :", toDate);

    var serialNumber = 0;
    foreach (var row in rows)
    {
        serialNumber++;
        table.Data(
            serialNumber.ToString(),
            $"{row.LedgerHead}",
            $"{row.MainLedger}",
            $"{row.SubLedger}",
            $"{row.SubLedger1}",
            $"{row.SubLedger2}",
            FormatAmount(row.DebitAmount),
            FormatAmount(row.CreditAmount));
    }

    if (rows.Count > 0)
    {
        table.Total("Total :", 6, FormatAmount(totalDebit), FormatAmount(totalCredit));

        table.GroupBy(
            ReportCell.Left("Total Assets / Expenses", 7),
            ReportCell.Right(FormatAmount(totalAssetExpenses)));
        table.GroupBy(
            ReportCell.Left("Total Liabilities / Income", 7),
            ReportCell.Right(FormatAmount(totalLiabilitiesIncome)));

        table.Total("Difference (Assets - Liabilities) :", 7,
            FormatAmount(totalAssetExpenses - totalLiabilitiesIncome));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())