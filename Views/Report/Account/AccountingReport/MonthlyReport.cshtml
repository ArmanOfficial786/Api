@using NexgenCosysReport.Dtos.ReportDtos
@using NexgenCosysReport.Dtos.RequestDtos.Account
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    bool Flag(string key) =>
        Model.TryGetValue(key, out var value) && value is bool flag && flag;

    var data = (MonthlyReportData)Model["MonthlyData"];

    var branchName = Text("BranchName", "All");
    var tillDate = Text("TillDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var reportType = Model.TryGetValue("ReportType", out var reportTypeValue) && reportTypeValue is int reportTypeNumber
        ? reportTypeNumber
        : 1;
    var reportTypeLabel = reportType == 1 ? "Summary" : reportType == 2 ? "SubLedger" : "Detail";

    var isNepali = Flag("IsNepali");
    var showBudget = Flag("ShowBudget");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    string SectionTitle(string title) => isNepali ? title switch
    {
        "Assets" => "सम्पत्ति",
        "Liabilities" => "दायित्व",
        "Income" => "आय",
        "Expenses" => "खर्च",
        _ => title
    } : title;

    // Current | Previous | [Budget]
    ReportCell[] AmountCells(decimal current, decimal previous, decimal budget, string css = null)
    {
        var cells = new List<ReportCell>
        {
            new ReportCell(FormatAmount(current), Align.Right, 1, css),
            new ReportCell(FormatAmount(previous), Align.Right, 1, css)
        };
        if (showBudget)
            cells.Add(new ReportCell(FormatAmount(budget), Align.Right, 1, css));
        return cells.ToArray();
    }

    var table = new ReportTable(Model, title: "Monthly Report", sheetName: "MonthlyReport")
        .Column("SN", 5, Align.Center)
        .Column("Ledger", 25)
        .Column("Sub Ledger", 20)
        .Column("Current", 15, Align.Right)
        .Column("Previous", 15, Align.Right);

    if (showBudget)
        table.Column("Budget", 15, Align.Right);

    table
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-section td, " +
            "table.sheet-table tr.r-total td, table.sheet-table tr.r-note td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-section td.text-left { text-align: center !important; }
            table.sheet-table tr.r-note td              { text-align: center; }
            table.sheet-table tr.r-data td.bold         { font-weight: bold; }
            table.sheet-table tr.r-data td.indent       { padding-left: 5mm; }
            table.sheet-table tr.r-data td.detail       { padding-left: 10mm; }");

    table.MetaPair("Branch Name :", branchName, "Till Date :", tillDate)
         .MetaPair("Report Generated On :", generatedOn, "Report Type :", reportTypeLabel);

    // one section: title bar, then each main ledger with its total and sub ledger rows
    void RenderSection(IEnumerable<MonthlyReportRowDto> sectionRows, string sectionName)
    {
        table.Section(SectionTitle(sectionName));

        var rows = sectionRows?.ToList() ?? new List<MonthlyReportRowDto>();
        if (rows.Count == 0)
        {
            table.Note("No data");
            return;
        }

        var serialNumber = 0;
        var mainLedgerGroups = rows
            .GroupBy(row => row.MainLedger ?? "Other")
            .OrderBy(mainGroup => mainGroup.Key);

        foreach (var mainGroup in mainLedgerGroups)
        {
            table.Data(new[]
            {
                ReportCell.Left(""),
                new ReportCell(mainGroup.Key, Align.Left, 1, "bold"),
                ReportCell.Left("")
            }.Concat(AmountCells(
                mainGroup.Sum(row => row.CurrentAmount),
                mainGroup.Sum(row => row.PreviousAmount),
                mainGroup.Sum(row => row.BudgetAmount))).ToArray());

            foreach (var row in mainGroup.OrderBy(subRow => subRow.SubLedger))
            {
                serialNumber++;
                table.Data(new[]
                {
                    ReportCell.Center(serialNumber.ToString()),
                    new ReportCell($"{row.SubLedger}", Align.Left, 1, "indent"),
                    new ReportCell($"{row.SubLedger1}", Align.Left, 1, "detail")
                }.Concat(AmountCells(row.CurrentAmount, row.PreviousAmount, row.BudgetAmount)).ToArray());
            }
        }
    }

    RenderSection(data.AssetsRows, "Assets");
    RenderSection(data.LiabilitiesRows, "Liabilities");
    RenderSection(data.IncomeRows, "Income");
    RenderSection(data.ExpensesRows, "Expenses");

    // ── Totals ──
    table.Section("Totals");

    void TotalLine(string label, decimal amount)
    {
        var cells = new List<ReportCell>
        {
            new ReportCell(label, Align.Left, 3, "bold"),
            ReportCell.Right(FormatAmount(amount)),
            ReportCell.Right("")
        };
        if (showBudget)
            cells.Add(ReportCell.Right(""));
        table.Data(cells.ToArray());
    }

    TotalLine("Total Assets", data.TotalAssets);
    TotalLine("Total Liabilities", data.TotalLiabilities);
    TotalLine("Net Assets (Assets - Liabilities)", data.TotalAssets - data.TotalLiabilities);
    TotalLine("Total Income", data.TotalIncome);
    TotalLine("Total Expenses", data.TotalExpenses);

    var netProfitValues = showBudget
        ? new[] { FormatAmount(data.TotalIncome - data.TotalExpenses), "", "" }
        : new[] { FormatAmount(data.TotalIncome - data.TotalExpenses), "" };
    table.Total("Net Profit (Income - Expenses) :", 3, netProfitValues);
}
@await Html.PartialAsync("_SheetReport", table.Build())