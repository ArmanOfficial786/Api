@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    bool Flag(string key) =>
        Model.TryGetValue(key, out var value) && value is bool flag && flag;

    var data = (RatioAnalysisData)Model["RatioData"];

    var branchName = Text("BranchName", "All");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var provisionType = Text("ProvisionType");
    var enable1to30Days = Flag("Enable1to30Days");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    var table = new ReportTable(Model, title: "Ratio Analysis Report", sheetName: "RatioAnalysisReport")
        .Column("SN", 5, Align.Center)
        .Column("Ratio Name", 70)
        .Column("Value", 25, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-section td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-section td.text-left { text-align: center !important; }");

    table.MetaPair("Branch Name :", branchName, "From Date :", fromDate)
         .MetaPair("Report Generated On :", generatedOn, "To Date :", toDate)
         .MetaPair("Provision :", provisionType, "1-30 Days :", enable1to30Days ? "Yes" : "No");

    var ratioGroups = data.Rows
        .GroupBy(row => row.Category ?? "Other")
        .OrderBy(categoryGroup => categoryGroup.Key);

    var serialNumber = 0;
    foreach (var categoryGroup in ratioGroups)
    {
        table.Section(categoryGroup.Key);

        foreach (var row in categoryGroup)
        {
            serialNumber++;
            table.Data(
                serialNumber.ToString(),
                $"{row.RatioName}",
                FormatAmount(row.Value));
        }
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())