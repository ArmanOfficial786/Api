@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    var data = (CashFlowData)Model["CashFlowData"];

    var branchName = Text("BranchName", "All");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    var table = new ReportTable(Model, title: "Cash Day Book Report", sheetName: "CashFlowReport")
        .Column("S.N.", 5, Align.Center)
        .Column("Voucher Date", 15)
        .Column("Voucher No", 15)
        .Column("Narration", 45)
        .Column("Amount", 20, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-section td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td, table.sheet-table tr.r-note td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-section td.text-left { text-align: center !important; }
            table.sheet-table tr.r-note td              { text-align: center; }
            table.sheet-table tr.r-data td.bold         { font-weight: bold; }");

    table.MetaPair("Branch Name :", branchName, "From Date :", fromDate)
         .MetaPair("Report Generated On :", generatedOn, "To Date :", toDate);

    // ── Cash inflows ──
    table.Section("Cash Inflows");
    if (data.InflowRows.Any())
    {
        var inflowNumber = 0;
        foreach (var row in data.InflowRows)
        {
            inflowNumber++;
            table.Data(
                inflowNumber.ToString(),
                row.VoucherDate ?? "-",
                $"{row.VoucherNo}",
                $"{row.Narration}",
                FormatAmount(row.Amount));
        }
        table.SubTotal("Total Inflow", 4, FormatAmount(data.TotalInflow));
    }
    else
    {
        table.Note("No cash inflows found");
    }

    // ── Cash outflows ──
    table.Section("Cash Outflows");
    if (data.OutflowRows.Any())
    {
        var outflowNumber = 0;
        foreach (var row in data.OutflowRows)
        {
            outflowNumber++;
            table.Data(
                outflowNumber.ToString(),
                row.VoucherDate ?? "-",
                $"{row.VoucherNo}",
                $"{row.Narration}",
                FormatAmount(row.Amount));
        }
        table.SubTotal("Total Outflow", 4, FormatAmount(data.TotalOutflow));
    }
    else
    {
        table.Note("No cash outflows found");
    }

    // ── Summary ──
    table.Spacer();
    table.Section("Summary");

    void SummaryLine(string label, decimal amount) =>
        table.Data(
            new ReportCell(label, Align.Left, 4, "bold"),
            ReportCell.Right(FormatAmount(amount)));

    SummaryLine("Opening Cash Balance", data.OpeningCashBalance);
    SummaryLine("Total Inflow", data.TotalInflow);
    SummaryLine("Total Outflow", data.TotalOutflow);

    table.Total("Net Cash Flow", 4, FormatAmount(data.NetCashFlow));
    table.Total("Closing Cash Balance", 4, FormatAmount(data.ClosingCashBalance));
}
@await Html.PartialAsync("_SheetReport", table.Build())