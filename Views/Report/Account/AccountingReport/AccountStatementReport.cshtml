@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    var dataSet = (Model["AccountStatementDataSet"] as IEnumerable<AccountStatementModelResponse>)?.ToList()
        ?? new List<AccountStatementModelResponse>();
    var balance = (Model["CashBankBalanceDataSet"] as IEnumerable<CashBankBalanceModelResponse>)?.FirstOrDefault();

    var reportType = Text("ReportType", "Summary");
    var branchName = Text("BranchName", "All");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    decimal grandDebit = dataSet.Sum(x => x.DebitAmount);
    decimal grandCredit = dataSet.Sum(x => x.CreditAmount);

    string FormatBalance(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    string LedgerLabel(string ledgerNo, string mainLedger) =>
        string.IsNullOrEmpty(ledgerNo) || ledgerNo == "-"
            ? mainLedger
            : $"{ledgerNo}\u00A0\u00A0\u00A0{mainLedger}";

    string SubLedgerLabel(AccountStatementModelResponse row) =>
        string.IsNullOrEmpty(row.SubLedger1) || row.SubLedger1 == "-"
            ? row.SubLedger
            : $"{row.SubLedger} — {row.SubLedger1}";

    var table = new ReportTable(Model, title: "Account Statement Report", sheetName: "AccountStatementReport")
        .Column("Ledger Head", 18)
        .Column("Sub Ledger", 37)
        .Column("Debit Amount", 15, Align.Right)
        .Column("Credit Amount", 15, Align.Right)
        .Column("Balance", 15, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 80)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-data td.bold   { font-weight: bold; }
            table.sheet-table tr.r-data td.indent { padding-left: 12mm; }");

    table.MetaPair("Branch Name :", branchName, "From Date :", fromDate)
         .MetaPair("Report Generated On :", generatedOn, "To Date :", toDate);
    if (balance != null)
        table.MetaPair("Opening Cash Balance :", balance.OpeningCashBalance.ToString("N2"),
                       "Opening Bank Balance :", balance.OpeningBankBalance.ToString("N2"));

    foreach (var ledgerGroup in dataSet.GroupBy(x => x.LedgerHead).OrderBy(g => g.Key))
    {
        table.GroupBy(
            ReportCell.Left(ledgerGroup.Key ?? "", 2),
            ReportCell.Right(Fmt.Amount(ledgerGroup.Sum(x => x.DebitAmount))),
            ReportCell.Right(Fmt.Amount(ledgerGroup.Sum(x => x.CreditAmount))),
            ReportCell.Right(FormatBalance(ledgerGroup.Sum(x => x.Balance))));

        var mainLedgerGroups = ledgerGroup
            .GroupBy(x => new { x.LedgerNo, x.MainLedger })
            .OrderBy(g => decimal.TryParse(g.Key.LedgerNo, out var n) ? n : decimal.MaxValue)
            .ToList();

        foreach (var mainGroup in mainLedgerGroups)
        {
            var mainCss = reportType == "Summary" ? null : "bold";

            table.Data(new[]
            {
                new ReportCell("", Align.Left, 1, mainCss),
                new ReportCell(LedgerLabel(mainGroup.Key.LedgerNo, mainGroup.Key.MainLedger), Align.Left, 1, mainCss),
                new ReportCell(Fmt.Amount(mainGroup.Sum(x => x.DebitAmount)), Align.Right, 1, mainCss),
                new ReportCell(Fmt.Amount(mainGroup.Sum(x => x.CreditAmount)), Align.Right, 1, mainCss),
                new ReportCell(FormatBalance(mainGroup.Sum(x => x.Balance)), Align.Right, 1, mainCss)
            });

            if (reportType == "Summary") continue;

            foreach (var row in mainGroup)
            {
                if (reportType == "SubLedger" && (string.IsNullOrEmpty(row.SubLedger) || row.SubLedger == "-"))
                    continue;

                table.Data(new[]
                {
                    ReportCell.Left(""),
                    new ReportCell(SubLedgerLabel(row), Align.Left, 1, "indent"),
                    ReportCell.Right(Fmt.Amount(row.DebitAmount)),
                    ReportCell.Right(Fmt.Amount(row.CreditAmount)),
                    ReportCell.Right(FormatBalance(row.Balance))
                });
            }
        }
    }

    if (dataSet.Count > 0)
    {
        table.Total("Grand Total :", 2, Fmt.Amount(grandDebit), Fmt.Amount(grandCredit), "");

        if (balance != null)
        {
            table.GroupBy(
                ReportCell.Left("Closing Cash Balance :", 2),
                ReportCell.Right(balance.ClosingCashBalance.ToString("N2"), 3));
            table.GroupBy(
                ReportCell.Left("Closing Bank Balance :", 2),
                ReportCell.Right(balance.ClosingBankBalance.ToString("N2"), 3));
        }
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())