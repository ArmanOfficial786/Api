@* Views/Report/_CommonHeader.cshtml *@
@model Dictionary<string, object>
@{
    string GetVal(string key, string fallback = "") =>
        Model != null && Model.TryGetValue(key, out var v) && v != null
            ? v.ToString()
            : fallback;

    var companyName = GetVal("CompanyName", "");
    var companyAddress = GetVal("CompanyAddress", "");
    var regNo = GetVal("RegNo", "");
    var phoneNo = GetVal("PhoneNo", "");
    var faxNo = GetVal("FaxNo", "");
    var email = GetVal("Email", "");
    var website = GetVal("Website", "");
    var panNo = GetVal("PanNo", "");
    var logoUrl = GetVal("LogoUrl", "");
}

<style>
    .common-header-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 6px;
    }

        .common-header-table td {
            vertical-align: top;
            padding: 2px 6px;
            font-size: 9pt;
            font-family: Arial, sans-serif;
        }

    .ch-logo-cell {
        width: 15%;
        text-align: left;
    }

        .ch-logo-cell img {
            max-height: 60px;
        }

    .ch-info-cell {
        width: 70%;
        text-align: center;
    }

    .ch-company-name {
        font-size: 16pt;
        font-weight: bold;
    }

    .ch-address {
        font-size: 10pt;
    }

    .ch-reg-cell {
        width: 15%;
        text-align: right;
        font-weight: bold;
        white-space: nowrap;
    }

    .ch-detail-block td {
        font-size: 9pt;
        text-align: left;
        padding: 1px 6px;
    }

    .ch-label {
        font-weight: bold;
    }
</style>

<table class="common-header-table">
    <tr>
        <td class="ch-logo-cell">
            @if (!string.IsNullOrEmpty(logoUrl))
            {
                <img src="@logoUrl" alt="Logo" />
            }
        </td>
        <td class="ch-info-cell">
            @if (!string.IsNullOrEmpty(companyName))
            {
                <div class="ch-company-name">@companyName</div>
            }
            @if (!string.IsNullOrEmpty(companyAddress))
            {
                <div class="ch-address">@companyAddress</div>
            }
        </td>
        <td class="ch-reg-cell">
            @if (!string.IsNullOrEmpty(regNo))
            {
                <div>Reg. No : @regNo</div>
            }
        </td>
    </tr>
    <tr>
        <td></td>
        <td colspan="2">
            <table style="width:100%; border-collapse:collapse;">
                <tr>
                    <td class="ch-detail-block" style="width:50%;">
                        @if (!string.IsNullOrEmpty(phoneNo))
                        {
                            <div><span class="ch-label">Phone No :</span> @phoneNo</div>
                        }
                        @if (!string.IsNullOrEmpty(faxNo))
                        {
                            <div><span class="ch-label">Fax No :</span> @faxNo</div>
                        }
                    </td>
                    <td class="ch-detail-block" style="width:50%;">
                        @if (!string.IsNullOrEmpty(email))
                        {
                            <div><span class="ch-label">Email :</span> @email</div>
                        }
                        @if (!string.IsNullOrEmpty(website))
                        {
                            <div><span class="ch-label">WebSite :</span> @website</div>
                        }
                        @if (!string.IsNullOrEmpty(panNo))
                        {
                            <div><span class="ch-label">Pan No :</span> @panNo</div>
                        }
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>