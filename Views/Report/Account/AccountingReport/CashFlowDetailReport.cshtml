@using NexgenCosysReport.Dtos.RequestDtos.Account.AccountingReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key, string fallback = "") =>
        Model.TryGetValue(key, out var value) && value != null ? value.ToString() ?? fallback : fallback;

    var data = (CashFlowDetailsData)Model["CashFlowData"];

    var branchName = Text("BranchName", "All");
    var tillDate = Text("TillDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    var table = new ReportTable(Model, title: "Cash Flow Details Report", sheetName: "CashFlowDetailsReport")
        .Column("S.N.", 10)
        .Column("Details", 60)
        .Column("Current Year (Rs)", 30, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-section td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-section td.text-left { text-align: center !important; }
            table.sheet-table tr.r-data td.bold         { font-weight: bold; }");

    table.MetaPair("Branch Name :", branchName, "Till Date :", tillDate)
         .MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // one activity block: numbered section bar, its rows, then the net total line
    void Activity(
        int sectionNumber,
        string title,
        IEnumerable<(string Label, decimal Amount)> activityRows,
        string netLabel,
        decimal netAmount)
    {
        table.Section($"{sectionNumber}. {title}");
        foreach (var activityRow in activityRows)
            table.Data("", activityRow.Label, FormatAmount(activityRow.Amount));
        table.Total(netLabel, 2, FormatAmount(netAmount));
    }

    Activity(1, "Cash Flows From Operating Activities",
        data.OperatingRows.Select(row => (Label: row.SubLedger ?? row.MainLedger, Amount: row.Amount)),
        "Net Cash Provided by Operating Activities", data.NetOperating);

    Activity(2, "Cash Flows From Investing Activities",
        data.InvestingRows.Select(row => (Label: row.SubLedger ?? row.MainLedger, Amount: row.Amount)),
        "Net Cash Used in Investing Activities", data.NetInvesting);

    Activity(3, "Cash Flows From Financing Activities",
        data.FinancingRows.Select(row => (Label: row.SubLedger ?? row.MainLedger, Amount: row.Amount)),
        "Net Cash Used in Financing Activities", data.NetFinancing);

    // ── Summary ──
    table.Total("Net Increase/Decrease in Cash and Bank Equivalent Current Year (1 + 3 - 2)", 2,
        FormatAmount(data.NetIncrease));

    void SummaryLine(string label, decimal amount) =>
        table.Data(
            new ReportCell(label, Align.Right, 2, "bold"),
            new ReportCell(FormatAmount(amount), Align.Right, 1, "bold"));

    SummaryLine("Opening Cash and Bank Equivalent Current Year, Beginning", data.OpeningCashBalance);
    SummaryLine("Net Cash and Bank Equivalent Current Year, Ending", data.ClosingCashBalance);
}
@await Html.PartialAsync("_SheetReport", table.Build())