@using NexgenCosysReport.Dtos.RequestDtos.Account.SecondLedgerDetailsReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";
    bool Flag(string key) => Model.TryGetValue(key, out var fv) && fv is bool fb && fb;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    string BalanceWithDirection(decimal balance, string? acctType)
    {
        var normalIsDebit = string.Equals(acctType, "ASSETS", StringComparison.OrdinalIgnoreCase)
                          || string.Equals(acctType, "EXPENSES", StringComparison.OrdinalIgnoreCase);
        var direction = normalIsDebit
            ? (balance >= 0 ? "DR" : "CR")
            : (balance >= 0 ? "CR" : "DR");
        return $"{Math.Abs(balance):N2} {direction}";
    }

    var rows = (Model["Rows"] as IEnumerable<SecondLedgerDetailsRowDto>)?.ToList() ?? new List<SecondLedgerDetailsRowDto>();
    var accountType = Text("AccountType");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames");
    if (branchNames == "") branchNames = "All Branches";
    var ledgerName = Text("LedgerName");
    var subLedgerName = Text("SubLedgerName");
    var secondSubLedgerName = Text("SecondSubLedgerName");
    var showOpeningBalance = Flag("ShowOpeningBalance");
    var openingBalance = Dec("OpeningBalance");
    var closingBalance = Dec("ClosingBalance");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalDebit = Dec("TotalDebitAmount");
    if (totalDebit == 0) totalDebit = rows.Sum(r => (decimal?)r.DebitAmount ?? 0m);
    var totalCredit = Dec("TotalCreditAmount");
    if (totalCredit == 0) totalCredit = rows.Sum(r => (decimal?)r.CreditAmount ?? 0m);

    var gap = "\u00A0\u00A0\u00A0\u00A0";

    var table = new ReportTable(Model, title: "Second Sub Ledger Report", sheetName: "SecondLedgerDetails")
        .Style(new ReportStyle { ZebraStripes = false })
        .Column("Date", 10)
        .Column("Voucher No", 14)
        .Column("Particulars", 38)
        .Column("DR", 12, Align.Right)
        .Column("CR", 12, Align.Right)
        .Column("Balance", 14, Align.Right)
        .Sizing(rowMm: 5, headerMm: 8, firstPageExtraMm: 85)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: none; }\n" +
            "table.sheet-table tr.r-data td.entry-start { border-top: 1px solid #000; padding-top: 4px; }");

    table.MetaPair("Report Generated On :", generatedOn, "From Date :", fromDate)
         .MetaPair("Branch Name :", branchNames, "To Date :", toDate)
         .MetaRow(Fmt.Labeled("Ledger Name :", ledgerName))
         .MetaRow(Fmt.Labeled("Sub Ledger Name :", subLedgerName))
         .MetaRow(Fmt.Labeled("Second Ledger Name :", secondSubLedgerName));
    if (showOpeningBalance)
        table.MetaRow(Fmt.Labeled("Opening Balance :", BalanceWithDirection(openingBalance, accountType)));

    foreach (var row in rows)
    {
        var adDate = row.VoucherDateOn.HasValue ? row.VoucherDateOn.Value.ToString("MM/dd/yyyy") : "";
        var rowBalance = row.BalanceAmount ?? 0m;
        var line2 = (row.SubLedger2 ?? "") + (string.IsNullOrEmpty(row.SubLedger3) ? "" : gap + row.SubLedger3);

        table.Data(new[]
        {
            new ReportCell(row.VoucherDate ?? "", Align.Left, 1, "entry-start"),
            new ReportCell(row.VoucherNo ?? "", Align.Left, 1, "entry-start"),
            new ReportCell(row.SubLedger1 ?? "", Align.Left, 1, "entry-start"),
            new ReportCell(N(row.DebitAmount), Align.Right, 1, "entry-start"),
            new ReportCell(N(row.CreditAmount), Align.Right, 1, "entry-start"),
            new ReportCell($"{Math.Abs(rowBalance):N2} {row.Type ?? ""}", Align.Right, 1, "entry-start")
        });

        if (adDate != "" || line2 != "")
        {
            table.Data(new[]
            {
                ReportCell.Left(adDate),
                ReportCell.Left(""),
                ReportCell.Left(line2),
                ReportCell.Left(""),
                ReportCell.Left(""),
                ReportCell.Left("")
            });
        }

        if (!string.IsNullOrWhiteSpace(row.NarrationLedger))
        {
            table.Data(new[]
            {
                ReportCell.Left(""),
                ReportCell.Left(""),
                ReportCell.Left(row.NarrationLedger!),
                ReportCell.Left(""),
                ReportCell.Left(""),
                ReportCell.Left("")
            });
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Total", 3, N(totalDebit), N(totalCredit), "");
        if (closingBalance != 0)
            table.Total("Closing Balance :", 5, BalanceWithDirection(closingBalance, accountType));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())