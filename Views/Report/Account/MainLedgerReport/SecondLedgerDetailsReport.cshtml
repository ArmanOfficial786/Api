<!-- Views/Report/Account/SecondLedgerDetailsReport/SecondLedgerDetailsReport.cshtml -->
@using NexgenCosysReport.Dtos.RequestDtos.Account.SecondLedgerDetailsReport

@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<SecondLedgerDetailsRowDto>) ?? new List<SecondLedgerDetailsRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalDebitAmount = Model["TotalDebitAmount"] as decimal? ?? 0;
    var totalCreditAmount = Model["TotalCreditAmount"] as decimal? ?? 0;
    var openingBalance = Model["OpeningBalance"] as decimal? ?? 0;
    var closingBalance = Model["ClosingBalance"] as decimal? ?? 0;
    var accountType = Model["AccountType"]?.ToString() ?? "";
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All Branches";
    var ledgerName = Model["LedgerName"]?.ToString() ?? "";
    var subLedgerName = Model["SubLedgerName"]?.ToString() ?? "";
    var secondSubLedgerName = Model["SecondSubLedgerName"]?.ToString() ?? "";
    var showOpeningBalance = Model["ShowOpeningBalance"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    Func<decimal?, string> N = v => (v ?? 0m).ToString("N2");

    string SummaryBalanceWithDirection(decimal balance, string? acctType)
    {
        var normalIsDebit = string.Equals(acctType, "ASSETS", StringComparison.OrdinalIgnoreCase)
                          || string.Equals(acctType, "EXPENSES", StringComparison.OrdinalIgnoreCase);
        var direction = normalIsDebit
            ? (balance >= 0 ? "DR" : "CR")
            : (balance >= 0 ? "CR" : "DR");
        return $"{Math.Abs(balance):N2} {direction}";
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Second Sub Ledger Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9.5pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9.5pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: top;
                }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .report-title {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 6px 10px 6px;
            }

            .meta-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 6px;
            }

                .meta-table td {
                    padding: 2px 6px;
                    font-size: 9.5pt;
                    white-space: nowrap;
                    vertical-align: top;
                }

            .meta-left {
                text-align: left;
                width: 50%;
            }

            .meta-right {
                text-align: right;
                width: 50%;
            }

            .meta-spacer td {
                height: 14px;
            }

            .column-header-row th {
                text-align: left;
                font-weight: bold;
                border-top: none;
                border-bottom: 1.5px solid #000;
                padding: 6px 6px 8px 6px;
            }

            .entry-line-1 td {
                padding: 6px 6px 0 6px;
                border-top: 1px solid #000;
            }

            .entry-line-2 td {
                padding: 0 6px;
            }

            .entry-line-3 td {
                padding: 0 6px 6px 6px;
            }

            .sub-ledger-code {
                display: inline-block;
                min-width: 90px;
            }

            .opening-balance-row td {
                background: #f2f2f2;
                font-weight: bold;
                padding: 5px 6px;
                border-top: 1px solid #000;
                border-bottom: 1px solid #000;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            @@media print {
                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">Second Sub Ledger Report</div>

        <table class="meta-table">
            <tr>
                <td class="meta-left"><strong>Report Generated On :</strong> @generatedOn</td>
                <td class="meta-right"><strong>From Date :</strong> @fromDate</td>
            </tr>
            <tr>
                <td class="meta-left"></td>
                <td class="meta-right"><strong>To Date :</strong> @toDate</td>
            </tr>
            <tr>
                <td class="meta-left"></td>
                <td class="meta-right"><strong>Branch Name :</strong> @branchNames</td>
            </tr>
            <tr class="meta-spacer"><td colspan="2"></td></tr>
            <tr>
                <td class="meta-left"><strong>Ledger Name :</strong> @ledgerName</td>
            </tr>
            <tr>
                <td class="meta-left"><strong>Sub Ledger Name :</strong> @subLedgerName</td>
            </tr>
            <tr>
                <td class="meta-left"><strong>Second Ledger Name :</strong> @secondSubLedgerName</td>
            </tr>
            <tr class="meta-spacer"><td colspan="2"></td></tr>
        </table>

        <table class="data-table" data-sheet-name="SecondLedgerDetails">
            <colgroup>
                <col style="width:10%;" />
                <col style="width:14%;" />
                <col style="width:38%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:14%;" />
            </colgroup>
            <tbody>
                @if (showOpeningBalance)
                {
                    <tr class="opening-balance-row">
                        <td colspan="5" class="text-right">Opening Balance</td>
                        <td class="text-right">@SummaryBalanceWithDirection(openingBalance, accountType)</td>
                    </tr>
                }

                <tr class="column-header-row">
                    <th>Date</th>
                    <th>Voucher No</th>
                    <th class="text-center">Particulars</th>
                    <th class="text-right">DR</th>
                    <th class="text-right">CR</th>
                    <th class="text-right">Balance</th>
                </tr>

                @if (rows.Any())
                {
                    foreach (var row in rows)
                    {
                        var adDate = row.VoucherDateOn.HasValue ? row.VoucherDateOn.Value.ToString("MM/dd/yyyy") : "";
                        var rowBalance = row.BalanceAmount ?? 0m;
                        var rowType = row.Type ?? "";

                        <tr class="entry-line-1">
                            <td>@(row.VoucherDate ?? "")</td>
                            <td>@(row.VoucherNo ?? "")</td>
                            <td>@(row.SubLedger1 ?? "")</td>
                            <td class="text-right">@N(row.DebitAmount)</td>
                            <td class="text-right">@N(row.CreditAmount)</td>
                            <td class="text-right">@Math.Abs(rowBalance).ToString("N2") @rowType</td>
                        </tr>
                        <tr class="entry-line-2">
                            <td>@adDate</td>
                            <td></td>
                            <td>
                                <span class="sub-ledger-code">@(row.SubLedger2 ?? "")</span>@(row.SubLedger3 ?? "")
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr class="entry-line-3">
                            <td></td>
                            <td></td>
                            <td>@(row.NarrationLedger ?? "")</td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="3" class="text-right">Total</td>
                        <td class="text-right">@N(totalDebitAmount)</td>
                        <td class="text-right">@N(totalCreditAmount)</td>
                        <td></td>
                    </tr>

                    @if (closingBalance != 0)
                    {
                        <tr class="opening-balance-row">
                            <td colspan="5" class="text-right">Closing Balance :</td>
                            <td class="text-right">@SummaryBalanceWithDirection(closingBalance, accountType)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>