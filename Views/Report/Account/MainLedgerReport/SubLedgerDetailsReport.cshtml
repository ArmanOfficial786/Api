@using NexgenCosysReport.Dtos.RequestDtos.Account.SubLedgerDetailsReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9.5pt";
    const int ColumnCount = 6;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    string SummaryBalanceWithDirection(decimal balance, string? acctType)
    {
        var normalIsDebit = string.Equals(acctType, "ASSETS", StringComparison.OrdinalIgnoreCase)
                          || string.Equals(acctType, "EXPENSES", StringComparison.OrdinalIgnoreCase);
        var direction = normalIsDebit
            ? (balance >= 0 ? "DR" : "CR")
            : (balance >= 0 ? "CR" : "DR");
        return $"{Math.Abs(balance):N2} {direction}";
    }

    var rows = (Model["Rows"] as List<SubLedgerDetailsRowDto>) ?? new List<SubLedgerDetailsRowDto>();
    var ledgerHead = (Model["LedgerHead"] as List<string>) ?? new List<string>();

    var accountType = Text("AccountType");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var reportType = Text("ReportType", "LedgerDetailsReport");
    var showOpeningBalance = Model.TryGetValue("ShowOpeningBalance", out var sob) && sob is bool sobValue && sobValue;
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var openingBalance = Dec("OpeningBalance");
    var closingBalance = Dec("ClosingBalance");
    var totalDebitAmount = Dec("TotalDebitAmount");
    var totalCreditAmount = Dec("TotalCreditAmount");
    var totalRecords = (int)Dec("TotalRecords");
    if (totalRecords == 0) totalRecords = rows.Count;

    var reportTitle = reportType switch
    {
        "LedgerDetailsReport" => "Main Ledger Report",
        "1stLedgerDetailsReport" => "First Sub Ledger Report",
        "2ndLedgerDetailsReport" => "Second Sub Ledger Report",
        "3rdLedgerDetailsReport" => "Third Sub Ledger Report",
        "4thLedgerDetailsReport" => "Fourth Sub Ledger Report",
        _ => "Ledger Details Report"
    };

    var ledgerName = ledgerHead.Count > 0 ? ledgerHead[0] : "";
    var gap = "\u00A0\u00A0\u00A0\u00A0";

    var table = new ReportTable(Model, title: reportTitle, sheetName: "MainLedgerReport")
        .Column("Date", 10)
        .Column("Voucher No", 14)
        .Column("Particulars", 38)
        .Column("DR", 12, Align.Right)
        .Column("CR", 12, Align.Right)
        .Column("Balance", 14, Align.Right)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5, headerMm: 9, firstPageExtraMm: 60)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 0 6px; vertical-align: top; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; border-bottom: 1.5px solid #000; padding: 6px 6px 8px 6px; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { font-weight: normal; border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-group td.e1 { border-top: 1px solid #000; padding-top: 6px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td.e3 { padding-bottom: 6px; }\n" +
            "table.sheet-table tr.r-data td.ob { background: #f2f2f2; font-weight: bold; padding: 5px 6px; border-top: 1px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-total td { border-top: 2px solid #000; border-bottom: 2px solid #000; padding: 5px 6px; }");

    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Labeled("From Date :", fromDate),
        3);
    table.MetaRow(
        Fmt.Labeled("Branch Name :", branchName),
        Fmt.Labeled("To Date :", toDate),
        3);
    table.MetaRow(Fmt.Labeled("Ledger Name :", ledgerName));

    if (showOpeningBalance)
    {
        table.Data(
            new ReportCell("Opening Balance", Align.Right, ColumnCount - 1, "ob"),
            new ReportCell(SummaryBalanceWithDirection(openingBalance, accountType), Align.Right, 1, "ob"));
    }

    table.Header();

    foreach (var row in rows)
    {
        var adDate = row.VoucherDateOn.HasValue ? row.VoucherDateOn.Value.ToString("MM/dd/yyyy") : "";
        var rowBalance = row.BalanceAmount ?? 0m;

        table.GroupBy(
            new ReportCell(row.VoucherDate ?? "", Align.Left, 1, "e1"),
            new ReportCell(row.VoucherNo ?? "", Align.Left, 1, "e1"),
            new ReportCell(row.MainLedger ?? "", Align.Left, 1, "e1"),
            new ReportCell(N(row.DebitAmount), Align.Right, 1, "e1"),
            new ReportCell(N(row.CreditAmount), Align.Right, 1, "e1"),
            new ReportCell($"{Math.Abs(rowBalance):N2} {row.Type ?? ""}", Align.Right, 1, "e1"));

        table.GroupBy(
            new ReportCell(adDate, Align.Left, 1, "e2"),
            new ReportCell("", Align.Left, 1, "e2"),
            new ReportCell($"{row.SubLedger1 ?? ""}{gap}{row.SubLedger2 ?? ""}", Align.Left, 1, "e2"),
            new ReportCell("", Align.Left, 1, "e2"),
            new ReportCell("", Align.Left, 1, "e2"),
            new ReportCell("", Align.Left, 1, "e2"));

        table.Data(
            new ReportCell("", Align.Left, 1, "e3"),
            new ReportCell("", Align.Left, 1, "e3"),
            new ReportCell(row.NarrationLedger ?? "", Align.Left, 1, "e3"),
            new ReportCell("", Align.Left, 1, "e3"),
            new ReportCell("", Align.Left, 1, "e3"),
            new ReportCell("", Align.Left, 1, "e3"));
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 3,
            N(totalDebitAmount),
            N(totalCreditAmount),
            SummaryBalanceWithDirection(closingBalance, accountType));
        table.Total("Total Records", ColumnCount - 1, totalRecords.ToString());

        if (closingBalance != 0)
        {
            table.Data(
                new ReportCell("Closing Balance", Align.Right, ColumnCount - 1, "ob"),
                new ReportCell(SummaryBalanceWithDirection(closingBalance, accountType), Align.Right, 1, "ob"));
        }
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())