@* Views/Report/Account/MainLedgerReport/LedgerDetailsReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Account.MainLedgerReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LedgerDetailsRowDto>) ?? new List<LedgerDetailsRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var openingBalance = Model["OpeningBalance"] as decimal? ?? 0;
    var closingBalance = Model["ClosingBalance"] as decimal? ?? 0;
    var accountType = Model["AccountType"]?.ToString() ?? "";
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var voucherType = Model["VoucherType"]?.ToString() ?? "All";
    var ledgerHead = (Model["LedgerHead"] as List<string>) ?? new List<string>();
    var showOpeningBalance = Model["ShowOpeningBalance"] as bool? ?? true;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var ledgerPath = string.Join(" > ", ledgerHead.Where(l => !string.IsNullOrWhiteSpace(l)));
    var runningBalance = showOpeningBalance ? openingBalance : 0m;

    string Fmt(decimal? v) => v.HasValue ? (v.Value < 0 ? $"({Math.Abs(v.Value):N2})" : v.Value.ToString("N2")) : "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ledger Details Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: right;
                white-space: nowrap;
            }

                .data-table th:nth-child(-n+2) {
                    text-align: left;
                }

            .detail-row td {
                border-bottom: 1px solid #eee;
                text-align: right;
            }

                .detail-row td:nth-child(-n+2) {
                    text-align: left;
                }

            .opening-row td, .closing-row td {
                font-weight: bold;
                background: #f5f5f5;
                border-top: 1px solid #666;
                border-bottom: 1px solid #666;
                text-align: right;
            }

                .opening-row td:first-child, .closing-row td:first-child {
                    text-align: left;
                }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
                text-align: right;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LedgerDetails">
            <colgroup>
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:26%;" />
                <col style="width:16%;" />
                <col style="width:16%;" />
                <col style="width:18%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="6">Ledger Details Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="6"><strong>Ledger :</strong> @ledgerPath</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="3"><strong>Branch :</strong> @branchName &nbsp;&nbsp;&nbsp; <strong>Voucher Type :</strong> @voucherType</td>
                    <td colspan="3" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="6"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="6"></td></tr>

                @if (showOpeningBalance)
                {
                    <tr class="opening-row">
                        <td colspan="5" class="text-right">Opening Balance</td>
                        <td class="text-right">@Fmt(openingBalance)</td>
                    </tr>
                }

                <tr>
                    <th>Voucher Date</th>
                    <th>Voucher No</th>
                    <th>Narration</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th>Balance</th>
                </tr>

                @if (rows.Any())
                {
                    foreach (var row in rows)
                    {
                        <tr class="detail-row">
                            <td>@(row.VoucherOn.HasValue ? row.VoucherOn.Value.ToString("yyyy/MM/dd") : "")</td>
                            <td>@(row.VoucherNo ?? "")</td>
                            <td>@(row.Narration ?? "")</td>
                            <td>@Fmt(row.DebitAmount)</td>
                            <td>@Fmt(row.CreditAmount)</td>
                            <td>@Fmt(row.BalanceAmount)</td>
                        </tr>
                    }

                    <tr class="closing-row">
                        <td colspan="5" class="text-right">Closing Balance</td>
                        <td class="text-right">@Fmt(closingBalance)</td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="5" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>