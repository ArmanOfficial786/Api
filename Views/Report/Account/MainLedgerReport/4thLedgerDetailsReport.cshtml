@using NexgenCosysReport.Dtos.RequestDtos.Account.MainLedgerReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";
    var metaFontSize = "8.5pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";
    bool Flag(string key, bool fallback) => Model.TryGetValue(key, out var fv) && fv is bool fb ? fb : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;

    // negative amounts print in brackets
    string Money(decimal? v) => v.HasValue ? (v.Value < 0 ? $"({Math.Abs(v.Value):N2})" : v.Value.ToString("N2")) : "";

    var rows = (Model["Rows"] as IEnumerable<LedgerDetailsRowDto>)?.ToList() ?? new List<LedgerDetailsRowDto>();
    var ledgerHead = (Model["LedgerHead"] as IEnumerable<string>)?.ToList() ?? new List<string>();
    var ledgerPath = string.Join(" > ", ledgerHead.Where(l => !string.IsNullOrWhiteSpace(l)));

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName");
    if (branchName == "") branchName = "All";
    var voucherType = Text("VoucherType");
    if (voucherType == "") voucherType = "All";
    var showOpeningBalance = Flag("ShowOpeningBalance", true);
    var openingBalance = Dec("OpeningBalance");
    var closingBalance = Dec("ClosingBalance");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;

    var table = new ReportTable(Model, title: "Ledger Details Report", sheetName: "LedgerDetails")
        .Column("Voucher Date", 12)
        .Column("Voucher No", 12)
        .Column("Narration", 26)
        .Column("Debit", 16, Align.Right)
        .Column("Credit", 16, Align.Right)
        .Column("Balance", 18, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 4px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }");

    table.MetaRow(Fmt.Labeled("Ledger :", ledgerPath))
         .MetaRow(
            Fmt.Join(Fmt.Labeled("Branch :", branchName), Fmt.Labeled("Voucher Type :", voucherType)),
            Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
            leftSpan: 3)
         .MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));
    if (showOpeningBalance)
        table.MetaRow(Fmt.Labeled("Opening Balance :", Money(openingBalance)));

    foreach (var row in rows)
    {
        table.Data(new[]
        {
            ReportCell.Left(row.VoucherOn.HasValue ? row.VoucherOn.Value.ToString("yyyy/MM/dd") : ""),
            ReportCell.Left(row.VoucherNo ?? ""),
            ReportCell.Left(row.Narration ?? ""),
            ReportCell.Right(Money(row.DebitAmount)),
            ReportCell.Right(Money(row.CreditAmount)),
            ReportCell.Right(Money(row.BalanceAmount))
        });
    }

    if (rows.Count > 0)
    {
        table.Total("Closing Balance", 5, Money(closingBalance));
        table.Total("Total Records", 5, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())