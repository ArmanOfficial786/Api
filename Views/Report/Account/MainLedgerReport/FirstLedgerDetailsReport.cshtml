@using NexgenCosysReport.Dtos.RequestDtos.Account.FirstLedgerDetailsReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9.5pt";
    const int ColumnCount = 6;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    bool Flag(string key) => Model.TryGetValue(key, out var fv) && fv is bool b && b;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    decimal TotalOr(string key, decimal fallback)
    {
        var dv = Dec(key);
        return dv != 0 ? dv : fallback;
    }
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    string SummaryBalanceWithDirection(decimal balance, string? acctType)
    {
        var normalIsDebit = string.Equals(acctType, "ASSETS", StringComparison.OrdinalIgnoreCase)
                          || string.Equals(acctType, "EXPENSES", StringComparison.OrdinalIgnoreCase);
        var direction = normalIsDebit
            ? (balance >= 0 ? "DR" : "CR")
            : (balance >= 0 ? "CR" : "DR");
        return $"{Math.Abs(balance):N2} {direction}";
    }

    var rows = (Model["Rows"] as List<FirstLedgerDetailsRowDto>) ?? new List<FirstLedgerDetailsRowDto>();

    var openingBalance = Dec("OpeningBalance");
    var closingBalance = Dec("ClosingBalance");
    var accountType = Text("AccountType");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All");
    var ledgerName = Text("LedgerName");
    var subLedgerName = Text("SubLedgerName");
    var showOpeningBalance = Flag("ShowOpeningBalance");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalDebitAmount = TotalOr("TotalDebitAmount", rows.Sum(r => r.DebitAmount ?? 0m));
    var totalCreditAmount = TotalOr("TotalCreditAmount", rows.Sum(r => r.CreditAmount ?? 0m));

    var table = new ReportTable(Model, title: "First Sub Ledger Report", sheetName: "FirstLedgerDetails")
        .Column("Date", 10)
        .Column("Voucher No", 14)
        .Column("Particulars", 38)
        .Column("DR", 12, Align.Right)
        .Column("CR", 12, Align.Right)
        .Column("Balance", 14, Align.Right)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            SubTotalBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; border-bottom: 1.5px solid #000; padding: 6px 6px 8px 6px; }\n" +
            "table.sheet-table tr.r-group td { font-weight: normal; border-top: 0; border-bottom: 0; padding: 0 6px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; padding: 0 6px 6px 6px; }\n" +
            "table.sheet-table tr.r-group td.e1 { border-top: 1px solid #000; padding-top: 6px; padding-bottom: 0; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 5px 6px; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchNames), Fmt.Labeled("From Date :", fromDate), 3);
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn), Fmt.Labeled("To Date :", toDate), 3);
    table.MetaRow(Fmt.Labeled("Ledger Name :", ledgerName), Fmt.Labeled("Sub Ledger Name :", subLedgerName), 3);

    if (showOpeningBalance)
        table.SubTotal("Opening Balance", ColumnCount - 1, SummaryBalanceWithDirection(openingBalance, accountType));

    table.Header();

    foreach (var row in rows)
    {
        var adDate = row.VoucherDateOn.HasValue ? row.VoucherDateOn.Value.ToString("MM/dd/yyyy") : "";
        var rowBalance = row.BalanceAmount ?? 0m;
        var rowType = row.Type ?? "";

        table.GroupBy(
            new ReportCell(row.VoucherDate ?? "", Align.Left, 1, "e1"),
            new ReportCell(row.VoucherNo ?? "", Align.Left, 1, "e1"),
            new ReportCell(row.MainLedger ?? "", Align.Left, 1, "e1"),
            new ReportCell(N(row.DebitAmount), Align.Right, 1, "e1"),
            new ReportCell(N(row.CreditAmount), Align.Right, 1, "e1"),
            new ReportCell($"{Math.Abs(rowBalance):N2} {rowType}", Align.Right, 1, "e1"));

        table.GroupBy(
            ReportCell.Left(adDate),
            ReportCell.Left(""),
            ReportCell.Left($"{row.SubLedger1 ?? ""}\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0{row.SubLedger2 ?? ""}"),
            ReportCell.Left(""),
            ReportCell.Left(""),
            ReportCell.Left(""));

        table.Data(
            ReportCell.Left(""),
            ReportCell.Left(""),
            ReportCell.Left(row.NarrationLedger ?? ""),
            ReportCell.Left(""),
            ReportCell.Left(""),
            ReportCell.Left(""));
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 3, N(totalDebitAmount), N(totalCreditAmount), SummaryBalanceWithDirection(closingBalance, accountType));
        table.Total("Total Records", ColumnCount - 1, totalRecords.ToString());

        if (closingBalance != 0)
            table.SubTotal("Closing Balance", ColumnCount - 1, SummaryBalanceWithDirection(closingBalance, accountType));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())