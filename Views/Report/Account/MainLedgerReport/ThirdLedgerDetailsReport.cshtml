@using NexgenCosysReport.Dtos.RequestDtos.Account.ThirdLedgerDetailsReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";
    var metaFontSize = "8.5pt";

    string Text(string key) => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? "" : "";
    bool Flag(string key) => Model.TryGetValue(key, out var fv) && fv is bool fb && fb;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string N(decimal? v) => (v ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as IEnumerable<ThirdLedgerDetailsRowDto>)?.ToList() ?? new List<ThirdLedgerDetailsRowDto>();
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames");
    if (branchNames == "") branchNames = "All Branches";
    var thirdSubLedgerName = Text("ThirdSubLedgerName");
    var voucherType = Text("VoucherType");
    if (voucherType == "") voucherType = "All";
    var reportType = Text("ReportType");
    if (reportType == "") reportType = "Detail";
    var orderBy = Text("OrderBy");
    if (orderBy == "") orderBy = "Voucher Date";
    var ledgerHeadName = Text("LedgerHeadName");
    var showOpeningBalance = Flag("ShowOpeningBalance");
    var openingBalance = Dec("OpeningBalance");
    var closingBalance = Dec("ClosingBalance");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : rows.Count;
    var totalDebit = Dec("TotalDebitAmount");
    if (totalDebit == 0) totalDebit = rows.Sum(r => r.DebitAmount ?? 0m);
    var totalCredit = Dec("TotalCreditAmount");
    if (totalCredit == 0) totalCredit = rows.Sum(r => r.CreditAmount ?? 0m);

    var title = string.IsNullOrEmpty(thirdSubLedgerName)
        ? "Third Sub Ledger Report"
        : $"Third Sub Ledger Report - {thirdSubLedgerName}";

    var table = new ReportTable(Model, title: title, sheetName: "ThirdLedgerDetails")
        .Column("Voucher No", 9)
        .Column("Voucher Date", 9)
        .Column("Main Ledger", 12)
        .Column("Sub Ledger", 12)
        .Column("2nd Sub Ledger", 12)
        .Column("3rd Sub Ledger", 12)
        .Column("Narration", 17)
        .Column("Debit Amount", 9, Align.Right)
        .Column("Credit Amount", 8, Align.Right)
        .Sizing(rowMm: 5.5, headerMm: 9, firstPageExtraMm: 80)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-total td.negative { color: #CC0000; }
            table.sheet-table tr.r-total td.positive { color: #006600; }");

    table.MetaRow(
            Fmt.Labeled("Branch Name :", branchNames),
            Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
            leftSpan: 4)
         .MetaRow(
            Fmt.Labeled("Ledger Head :", ledgerHeadName),
            Fmt.Join(Fmt.Labeled("Voucher Type :", voucherType), Fmt.Labeled("Report Generated On :", generatedOn)),
            leftSpan: 4)
         .MetaRow(
            Fmt.Labeled("Report Type :", reportType),
            Fmt.Labeled("Order By :", orderBy),
            leftSpan: 4);
    if (showOpeningBalance && openingBalance != 0)
        table.MetaRow(Fmt.Labeled("Opening Balance :", N(openingBalance)));

    foreach (var row in rows)
    {
        table.Data(new[]
        {
            ReportCell.Left(row.VoucherNo ?? ""),
            ReportCell.Left(row.VoucherOnBs ?? ""),
            ReportCell.Left(row.MainLedger ?? ""),
            ReportCell.Left(row.SubLedger1 ?? ""),
            ReportCell.Left(row.SubLedger2 ?? ""),
            ReportCell.Left(row.SubLedger3 ?? ""),
            ReportCell.Left(row.Narration ?? ""),
            ReportCell.Right(N(row.DebitAmount)),
            ReportCell.Right(N(row.CreditAmount))
        });
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 7, N(totalDebit), N(totalCredit));
        table.Total("Total Records", 8, totalRecords.ToString());
        if (closingBalance != 0)
            table.Total("Closing Balance", 8,
                $"{(closingBalance < 0 ? "(" : "")}{N(Math.Abs(closingBalance))}{(closingBalance < 0 ? ")" : "")}");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())