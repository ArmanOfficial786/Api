@using NexgenCosysReport.Dtos.RequestDtos.Account
@model Dictionary<string, object>

@{
    Layout = null;

    var rows = (Model["BalanceSheetRows"] as IEnumerable<BalanceSheetDto>)
               ?.ToList() ?? new List<BalanceSheetDto>();

    var reportType = Model.ContainsKey("ReportType") ? Model["ReportType"]?.ToString() : "Summary";
    var branchName = Model.ContainsKey("BranchName") ? Model["BranchName"]?.ToString() : "All";
    var fiscalYearLabel = Model.ContainsKey("FiscalYearLabel") ? Model["FiscalYearLabel"]?.ToString() : "";
    var tillDate = Model.ContainsKey("TillDate") ? Model["TillDate"]?.ToString() : "";
    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var includePrevious = Model.ContainsKey("IncludePreviousYearBalance") && Convert.ToBoolean(Model["IncludePreviousYearBalance"]);
    var isExcel = format == "EXCEL" || format == "XLSX";

    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var colCount = includePrevious ? 6 : 5;

    decimal grandDebit = rows.Sum(x => x.DebitAmount);
    decimal grandCredit = rows.Sum(x => x.CreditAmount);

    // LIABILITIES (incl. UNDISTRIBUTED SURPLUS) then ASSETS (incl. ACCUMULATED LOSS) -
    // matches the AcoAccountTypeId IN (1,2) filter and balancing-figure inserts in the SP.
    var groupedByLedgerHead = rows
        .GroupBy(x => x.LedgerHead ?? "-")
        .OrderByDescending(g => g.Key == "LIABILITIES")
        .ToList();

    var totalLiabilities = groupedByLedgerHead.Where(g => g.Key == "LIABILITIES").SelectMany(g => g).Sum(r => r.CurrentAmount);
    var totalAssets = groupedByLedgerHead.Where(g => g.Key == "ASSETS").SelectMany(g => g).Sum(r => r.CurrentAmount);
    var difference = totalLiabilities - totalAssets;
    var isBalanced = Math.Abs(difference) < 1m; // allow for rounding noise

    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    // Deepest available sub-ledger label for a row, "SubLedger — SubLedger1 — SubLedger2"
    // when present (Detail mode); Summary/SubLedger modes always have '-' below SubLedger.
    string FormatSubLedgerDisplay(BalanceSheetDto row)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(row.SubLedger) && row.SubLedger != "-") parts.Add(row.SubLedger);
        if (!string.IsNullOrEmpty(row.SubLedger1) && row.SubLedger1 != "-") parts.Add(row.SubLedger1);
        if (!string.IsNullOrEmpty(row.SubLedger2) && row.SubLedger2 != "-") parts.Add(row.SubLedger2);
        return parts.Count > 0 ? string.Join(" — ", parts) : "-";
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Balance Sheet Report</title>
    <style>
            /* ── RESET ── */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 0;
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            /* ── CONTAINER ── */
            .report-container {
                width: 100%;
                overflow: visible;
            }

            /* ── STOP THEAD REPEATING ── */
            thead {
                display: table-row-group;
            }

            /* ── TABLE BASE ── */
            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-family: Arial, sans-serif;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td,
                .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    white-space: normal;
                    vertical-align: middle;
                    background: #FFFFFF;
                }

                /* ── COLUMN HEADER ROW ── */
                .data-table th {
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    padding: 5px 8px;
                    font-weight: bold;
                }

            /* ── META ROWS ── */
            .meta-title td {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 4px 8px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            /* ── LEDGER HEAD GROUP HEADER (LIABILITIES / ASSETS) ── */
            .ledger-head-row td {
                font-weight: bold;
                border-top: 1px solid #ccc;
                border-bottom: 1px solid #ccc;
                padding: 5px 8px;
                background: #FFFFFF;
            }

            /* ── MAIN LEDGER SUB-HEADER (SubLedger / Detail modes) ── */
            .main-ledger-row td {
                font-weight: bold;
                padding: 3px 8px;
                background: #FFFFFF;
                border-bottom: 1px solid #ccc;
            }

            /* ── DETAIL DATA ROWS ── */
            .detail-row td {
                padding: 2px 8px;
                background: #FFFFFF;
                border-bottom: 1px solid #ccc;
            }

            /* ── GROUP SEPARATOR LINE ── */
            .group-separator td {
                border-bottom: 1.5px solid #000;
                padding: 0;
                height: 0;
                line-height: 0;
                font-size: 0;
                background: #FFFFFF;
            }

            /* ── GRAND TOTAL ── */
            .grand-total td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                padding: 5px 8px;
                background: #FFFFFF;
            }

            /* ── BALANCE CHECK BLOCK ── */
            .balance-check-row td {
                border: 1px solid #000;
                background: #f0f0f0;
                text-align: left;
                padding: 6px;
                font-weight: bold;
            }

            .balance-check-value td {
                border: 1px solid #000;
                text-align: right;
                padding: 6px;
            }

            .balanced-ok {
                color: #196f3d;
            }

            .balanced-diff {
                color: #b03a2e;
            }

            /* ── TEXT ALIGNMENT HELPERS ── */
            .text-right {
                text-align: right !important;
            }

            .text-left {
                text-align: left !important;
            }

            .text-center {
                text-align: center !important;
            }

            /* ── PRINT ── */
            @@media print {
                body {
                    margin: 0;
                    padding: 0;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }

                    tr.ledger-head-row,
                    tr.main-ledger-row {
                        page-break-after: avoid;
                        break-after: avoid;
                    }

                tbody tr.detail-row {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @* ── COMMON HEADER ── *@
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        @*
        Columns (5 or 6 depending on IncludePreviousYearBalance):
        Ledger Head | Sub Ledger (LedgerNo inline) | Debit Amount | Credit Amount | Current Year | [Previous Year]
    *@
        <table class="data-table" data-sheet-name="BalanceSheetReport">
            <colgroup>
                <col style="width:16%;" />
                <col style="width:@(includePrevious ? 28 : 34)%;" />
                <col style="width:14%;" />
                <col style="width:14%;" />
                <col style="width:@(includePrevious ? 14 : 28)%;" />
                @if (includePrevious)
                {
                    <col style="width:14%;" />
                }
            </colgroup>
            <tbody>

                @* ── REPORT TITLE ── *@
                <tr class="meta-title">
                    <td colspan="@colCount">Balance Sheet Report</td>
                </tr>

                @* ── META INFO ── *@
                <tr class="meta-row">
                    <td colspan="3"><strong>Branch Name :</strong> @branchName</td>
                    <td colspan="@(colCount - 3)" class="text-right"><strong>Fiscal Year :</strong> @fiscalYearLabel</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="3"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="@(colCount - 3)" class="text-right"><strong>As At :</strong> @tillDate (B.S.)</td>
                </tr>
                <tr class="meta-spacer"><td colspan="@colCount"></td></tr>

                @* ── COLUMN HEADERS ── *@
                <tr>
                    <th class="text-left">Ledger Head</th>
                    <th class="text-left">Sub Ledger</th>
                    <th class="text-right">Debit Amount</th>
                    <th class="text-right">Credit Amount</th>
                    <th class="text-right">Current Year</th>
                    @if (includePrevious)
                    {
                        <th class="text-right">Previous Year</th>
                    }
                </tr>

                @* ══════════════════════════════════════════════
               SUMMARY MODE
               LedgerHead group header → MainLedger rows
               LedgerNo shown inline: "90   BANK BALANCE"
            ══════════════════════════════════════════════ *@
                @if (reportType == "Summary")
                {
                    foreach (var ledgerGroup in groupedByLedgerHead)
                    {
                        decimal lhDebit = ledgerGroup.Sum(x => x.DebitAmount);
                        decimal lhCredit = ledgerGroup.Sum(x => x.CreditAmount);
                        decimal lhCurrent = ledgerGroup.Sum(x => x.CurrentAmount);
                        decimal lhPrevious = ledgerGroup.Sum(x => x.PreviousAmount);

                        var mainLedgerGroups = ledgerGroup
                            .GroupBy(x => new { x.LedgerNo, x.MainLedger })
                            .OrderBy(g => g.Key.LedgerNo ?? int.MaxValue)
                            .ToList();

                        @* LedgerHead group header row *@
                        <tr class="ledger-head-row">
                            <td colspan="2">@ledgerGroup.Key</td>
                            <td class="text-right">@lhDebit.ToString("N2")</td>
                            <td class="text-right">@lhCredit.ToString("N2")</td>
                            <td class="text-right">@FormatAmount(lhCurrent)</td>
                            @if (includePrevious)
                            {
                                <td class="text-right">@FormatAmount(lhPrevious)</td>
                            }
                        </tr>

                        foreach (var mainGroup in mainLedgerGroups)
                        {
                            decimal mlDebit = mainGroup.Sum(x => x.DebitAmount);
                            decimal mlCredit = mainGroup.Sum(x => x.CreditAmount);
                            decimal mlCurrent = mainGroup.Sum(x => x.CurrentAmount);
                            decimal mlPrevious = mainGroup.Sum(x => x.PreviousAmount);

                            @* MainLedger summary row — LedgerNo inline in Sub Ledger cell *@
                            <tr class="detail-row">
                                <td style="padding:3px 8px;"></td>
                                <td style="padding:3px 8px;">
                                    <span style="display:inline-block; min-width:40px;">@mainGroup.Key.LedgerNo</span>
                                    @mainGroup.Key.MainLedger
                                </td>
                                <td class="text-right" style="padding:3px 8px;">@mlDebit.ToString("N2")</td>
                                <td class="text-right" style="padding:3px 8px;">@mlCredit.ToString("N2")</td>
                                <td class="text-right" style="padding:3px 8px;">@FormatAmount(mlCurrent)</td>
                                @if (includePrevious)
                                {
                                    <td class="text-right" style="padding:3px 8px;">@FormatAmount(mlPrevious)</td>
                                }
                            </tr>
                        }

                        <tr class="group-separator"><td colspan="@colCount"></td></tr>
                    }

                    <tr class="grand-total">
                        <td colspan="2" class="text-right">Grand Total :</td>
                        <td class="text-right">@grandDebit.ToString("N2")</td>
                        <td class="text-right">@grandCredit.ToString("N2")</td>
                        <td></td>
                        @if (includePrevious)
                        {
                            <td></td>
                        }
                    </tr>
                }

                @* ══════════════════════════════════════════════
               SUBLEDGER MODE
               LedgerHead → MainLedger sub-header → SubLedger rows
            ══════════════════════════════════════════════ *@
                else if (reportType == "SubLedger")
                {
                    foreach (var ledgerGroup in groupedByLedgerHead)
                    {
                        decimal lhDebit = ledgerGroup.Sum(x => x.DebitAmount);
                        decimal lhCredit = ledgerGroup.Sum(x => x.CreditAmount);
                        decimal lhCurrent = ledgerGroup.Sum(x => x.CurrentAmount);
                        decimal lhPrevious = ledgerGroup.Sum(x => x.PreviousAmount);

                        var mainLedgerGroups = ledgerGroup
                            .GroupBy(x => new { x.LedgerNo, x.MainLedger })
                            .OrderBy(g => g.Key.LedgerNo ?? int.MaxValue)
                            .ToList();

                        @* LedgerHead group header row *@
                        <tr class="ledger-head-row">
                            <td colspan="2">@ledgerGroup.Key</td>
                            <td class="text-right">@lhDebit.ToString("N2")</td>
                            <td class="text-right">@lhCredit.ToString("N2")</td>
                            <td class="text-right">@FormatAmount(lhCurrent)</td>
                            @if (includePrevious)
                            {
                                <td class="text-right">@FormatAmount(lhPrevious)</td>
                            }
                        </tr>

                        foreach (var mainGroup in mainLedgerGroups)
                        {
                            decimal mlDebit = mainGroup.Sum(x => x.DebitAmount);
                            decimal mlCredit = mainGroup.Sum(x => x.CreditAmount);
                            decimal mlCurrent = mainGroup.Sum(x => x.CurrentAmount);
                            decimal mlPrevious = mainGroup.Sum(x => x.PreviousAmount);

                            @* MainLedger sub-header — LedgerNo inline *@
                            <tr class="main-ledger-row">
                                <td style="padding:3px 8px;"></td>
                                <td style="padding:3px 8px;">
                                    <span style="display:inline-block; min-width:40px;">@mainGroup.Key.LedgerNo</span>
                                    @mainGroup.Key.MainLedger
                                </td>
                                <td class="text-right" style="padding:3px 8px;">@mlDebit.ToString("N2")</td>
                                <td class="text-right" style="padding:3px 8px;">@mlCredit.ToString("N2")</td>
                                <td class="text-right" style="padding:3px 8px;">@FormatAmount(mlCurrent)</td>
                                @if (includePrevious)
                                {
                                    <td class="text-right" style="padding:3px 8px;">@FormatAmount(mlPrevious)</td>
                                }
                            </tr>

                            foreach (var row in mainGroup)
                            {
                                if (string.IsNullOrEmpty(row.SubLedger) || row.SubLedger == "-")
                                    continue;

                                @* SubLedger detail row *@
                                <tr class="detail-row">
                                    <td></td>
                                    <td style="padding:2px 8px 2px 56px;">@row.SubLedger</td>
                                    <td class="text-right">@row.DebitAmount.ToString("N2")</td>
                                    <td class="text-right">@row.CreditAmount.ToString("N2")</td>
                                    <td class="text-right">@FormatAmount(row.CurrentAmount)</td>
                                    @if (includePrevious)
                                    {
                                        <td class="text-right">@FormatAmount(row.PreviousAmount)</td>
                                    }
                                </tr>
                            }
                        }

                        <tr class="group-separator"><td colspan="@colCount"></td></tr>
                    }

                    <tr class="grand-total">
                        <td colspan="2" class="text-right">Grand Total :</td>
                        <td class="text-right">@grandDebit.ToString("N2")</td>
                        <td class="text-right">@grandCredit.ToString("N2")</td>
                        <td></td>
                        @if (includePrevious)
                        {
                            <td></td>
                        }
                    </tr>
                }

                @* ══════════════════════════════════════════════
               DETAIL MODE
               LedgerHead → MainLedger sub-header → every row (SubLedger — SubLedger1 — SubLedger2)
            ══════════════════════════════════════════════ *@
                else if (reportType == "Detail")
                {
                    foreach (var ledgerGroup in groupedByLedgerHead)
                    {
                        decimal lhDebit = ledgerGroup.Sum(x => x.DebitAmount);
                        decimal lhCredit = ledgerGroup.Sum(x => x.CreditAmount);
                        decimal lhCurrent = ledgerGroup.Sum(x => x.CurrentAmount);
                        decimal lhPrevious = ledgerGroup.Sum(x => x.PreviousAmount);

                        var mainLedgerGroups = ledgerGroup
                            .GroupBy(x => new { x.LedgerNo, x.MainLedger })
                            .OrderBy(g => g.Key.LedgerNo ?? int.MaxValue)
                            .ToList();

                        @* LedgerHead group header row *@
                        <tr class="ledger-head-row">
                            <td colspan="2">@ledgerGroup.Key</td>
                            <td class="text-right">@lhDebit.ToString("N2")</td>
                            <td class="text-right">@lhCredit.ToString("N2")</td>
                            <td class="text-right">@FormatAmount(lhCurrent)</td>
                            @if (includePrevious)
                            {
                                <td class="text-right">@FormatAmount(lhPrevious)</td>
                            }
                        </tr>

                        foreach (var mainGroup in mainLedgerGroups)
                        {
                            decimal mlDebit = mainGroup.Sum(x => x.DebitAmount);
                            decimal mlCredit = mainGroup.Sum(x => x.CreditAmount);
                            decimal mlCurrent = mainGroup.Sum(x => x.CurrentAmount);
                            decimal mlPrevious = mainGroup.Sum(x => x.PreviousAmount);

                            @* MainLedger sub-header — LedgerNo inline *@
                            <tr class="main-ledger-row">
                                <td style="padding:3px 8px;"></td>
                                <td style="padding:3px 8px;">
                                    <span style="display:inline-block; min-width:40px;">@mainGroup.Key.LedgerNo</span>
                                    @mainGroup.Key.MainLedger
                                </td>
                                <td class="text-right" style="padding:3px 8px;">@mlDebit.ToString("N2")</td>
                                <td class="text-right" style="padding:3px 8px;">@mlCredit.ToString("N2")</td>
                                <td class="text-right" style="padding:3px 8px;">@FormatAmount(mlCurrent)</td>
                                @if (includePrevious)
                                {
                                    <td class="text-right" style="padding:3px 8px;">@FormatAmount(mlPrevious)</td>
                                }
                            </tr>

                            foreach (var row in mainGroup)
                            {
                                @* Individual ledger detail row (SubLedger — SubLedger1 — SubLedger2) *@
                                <tr class="detail-row">
                                    <td></td>
                                    <td style="padding:2px 8px 2px 56px;">@FormatSubLedgerDisplay(row)</td>
                                    <td class="text-right">@row.DebitAmount.ToString("N2")</td>
                                    <td class="text-right">@row.CreditAmount.ToString("N2")</td>
                                    <td class="text-right">@FormatAmount(row.CurrentAmount)</td>
                                    @if (includePrevious)
                                    {
                                        <td class="text-right">@FormatAmount(row.PreviousAmount)</td>
                                    }
                                </tr>
                            }
                        }

                        <tr class="group-separator"><td colspan="@colCount"></td></tr>
                    }

                    <tr class="grand-total">
                        <td colspan="2" class="text-right">Grand Total :</td>
                        <td class="text-right">@grandDebit.ToString("N2")</td>
                        <td class="text-right">@grandCredit.ToString("N2")</td>
                        <td></td>
                        @if (includePrevious)
                        {
                            <td></td>
                        }
                    </tr>
                }

                @* ── BALANCE CHECK (Total Liabilities vs Total Assets) ── *@
                <tr class="meta-spacer"><td colspan="@colCount"></td></tr>
                <tr class="balance-check-row">
                    <td colspan="2">Total Liabilities (incl. Capital &amp; Surplus) :</td>
                    <td colspan="@(colCount - 2)" class="balance-check-value" style="border:1px solid #000; text-align:right; padding:6px;">@FormatAmount(totalLiabilities)</td>
                </tr>
                <tr class="balance-check-row">
                    <td colspan="2">Total Assets (incl. Accumulated Loss) :</td>
                    <td colspan="@(colCount - 2)" class="balance-check-value" style="border:1px solid #000; text-align:right; padding:6px;">@FormatAmount(totalAssets)</td>
                </tr>
                <tr class="balance-check-row">
                    <td colspan="2">@(isBalanced ? "Balanced" : "Difference") :</td>
                    <td colspan="@(colCount - 2)" class="@(isBalanced ? "balanced-ok" : "balanced-diff")" style="border:1px solid #000; text-align:right; padding:6px; font-weight:bold;">@FormatAmount(difference)</td>
                </tr>

            </tbody>
        </table>
    </div>
</body>
</html>
