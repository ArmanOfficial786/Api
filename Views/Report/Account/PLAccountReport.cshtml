@using NexgenCosysReport.Dtos.RequestDtos.Account;
@model Dictionary<string, object>

@{
    Layout = null;

    var displayType = Model.ContainsKey("DisplayType") ? Model["DisplayType"]?.ToString() : "Horizontal";
    var isNepali = Model.ContainsKey("IsNepali") && Convert.ToBoolean(Model["IsNepali"]);
    var branchName = Model.ContainsKey("BranchName") ? Model["BranchName"]?.ToString() : "All";
    var fromDate = Model.ContainsKey("FromDate") ? Model["FromDate"]?.ToString() : "";
    var toDate = Model.ContainsKey("ToDate") ? Model["ToDate"]?.ToString() : "";
    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";

    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Helper to format amounts with parentheses for negatives
    string FormatAmount(decimal amount) =>
        amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");

    // Helper to display SubLedger with proper indentation
    string FormatSubLedger(PLAccountRowDto row)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(row.SubLedger) && row.SubLedger != "-") parts.Add(row.SubLedger);
        if (!string.IsNullOrEmpty(row.SubLedger1) && row.SubLedger1 != "-") parts.Add(row.SubLedger1);
        if (!string.IsNullOrEmpty(row.SubLedger2) && row.SubLedger2 != "-") parts.Add(row.SubLedger2);
        return parts.Count > 0 ? string.Join(" — ", parts) : "-";
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Profit & Loss Account Report</title>
    <style>
            /* ── RESET ── */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 0;
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            /* ── CONTAINER ── */
            .report-container {
                width: 100%;
                overflow: visible;
            }

            /* ── STOP THEAD REPEATING ── */
            thead {
                display: table-row-group;
            }

            /* ── TABLE BASE ── */
            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-family: Arial, sans-serif;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    white-space: normal;
                    vertical-align: middle;
                    background: #FFFFFF;
                }

                .data-table th {
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    padding: 5px 8px;
                    font-weight: bold;
                }

            /* ── META ROWS ── */
            .meta-title td {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 4px 8px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            /* ── SECTION HEADERS ── */
            .section-header td {
                font-weight: bold;
                background: #e6e6e6;
                text-align: center;
                font-size: 10pt;
                padding: 6px 4px;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
            }

            /* ── LEDGER HEAD GROUP HEADER (INCOME / EXPENSES) ── */
            .ledger-head-row td {
                font-weight: bold;
                border-top: 1px solid #ccc;
                border-bottom: 1px solid #ccc;
                padding: 5px 8px;
                background: #FFFFFF;
            }

            /* ── MAIN LEDGER SUB-HEADER ── */
            .main-ledger-row td {
                font-weight: bold;
                padding: 3px 8px;
                background: #FFFFFF;
                border-bottom: 1px solid #ccc;
            }

            /* ── DETAIL DATA ROWS ── */
            .detail-row td {
                padding: 2px 8px;
                background: #FFFFFF;
                border-bottom: 1px solid #ccc;
            }

            /* ── GRAND TOTAL ── */
            .grand-total td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                padding: 5px 8px;
                background: #FFFFFF;
            }

            /* ── NET PROFIT ROW ── */
            .net-profit td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 8px;
            }

            /* ── HORIZONTAL LAYOUT ── */
            .pl-horizontal {
                display: flex;
                flex-wrap: wrap;
                gap: 20px;
                margin-top: 10px;
            }

            .pl-column {
                flex: 1 1 45%;
                min-width: 300px;
            }

                .pl-column table {
                    width: 100%;
                    border-collapse: collapse;
                }

                .pl-column .data-table th,
                .pl-column .data-table td {
                    padding: 4px 6px;
                    border: 1px solid #ddd;
                }

                .pl-column .data-table th {
                    background: #f2f2f2;
                    font-weight: bold;
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                }

                .pl-column .data-table .grand-total td {
                    border-top: 2px solid #000;
                    border-bottom: 2px solid #000;
                }

                .pl-column .data-table .detail-row td {
                    border-bottom: 1px solid #eee;
                }

            /* ── TEXT ALIGNMENT ── */
            .text-right {
                text-align: right !important;
            }

            .text-left {
                text-align: left !important;
            }

            .text-center {
                text-align: center !important;
            }

            /* ── PRINT ── */
            @@media print {
                body {
                    margin: 0;
                    padding: 0;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }

                .pl-horizontal {
                    display: flex;
                    flex-wrap: wrap;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @* ── COMMON HEADER ── *@
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        @* ── DATA EXTRACTION ── *@
        @{
            // Determine which type of data we have
            var plData = Model["PLData"];

            if (displayType == "Horizontal")
            {
                var data = plData as PLAccountHorizontalData;
                if (data != null)
                {
                    var incomeRows = data.IncomeRows ?? new List<PLAccountRowDto>();
                    var expenseRows = data.ExpenseRows ?? new List<PLAccountRowDto>();
                    var totalIncome = data.TotalIncome;
                    var totalExpense = data.TotalExpense;
                    var netProfit = totalIncome - totalExpense;

                    <table class="data-table" data-sheet-name="PLAccountHorizontal">
                        <tbody>
                            <tr class="meta-title">
                                <td colspan="2">Profit & Loss Account Report (Horizontal)</td>
                            </tr>
                            <tr class="meta-row">
                                <td colspan="2"><strong>Branch Name :</strong> @branchName</td>
                            </tr>
                            <tr class="meta-row">
                                <td><strong>From Date :</strong> @fromDate</td>
                                <td class="text-right"><strong>To Date :</strong> @toDate</td>
                            </tr>
                            <tr class="meta-row">
                                <td colspan="2"><strong>Report Generated On :</strong> @generatedOn</td>
                            </tr>
                            <tr class="meta-spacer"><td colspan="2"></td></tr>
                        </tbody>
                    </table>

                    <div class="pl-horizontal">
                        @* ── EXPENSES COLUMN ── *@
                        <div class="pl-column">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th style="width:60%;">EXPENSES</th>
                                        <th style="width:40%;" class="text-right">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (expenseRows.Any())
                                    {
                                        // Group by MainLedger to show sub-totals
                                        var expenseGroups = expenseRows
                                            .GroupBy(x => x.MainLedger ?? "Other")
                                            .OrderBy(g => g.Key);

                                        foreach (var group in expenseGroups)
                                        {
                                            decimal groupTotal = group.Sum(x => x.Balance);
                                            <tr class="main-ledger-row">
                                                <td><strong>@group.Key</strong></td>
                                                <td class="text-right"><strong>@FormatAmount(groupTotal)</strong></td>
                                            </tr>
                                            foreach (var row in group.OrderBy(x => x.SubLedger))
                                            {
                                                <tr class="detail-row">
                                                    <td style="padding-left:20px;">@row.SubLedger</td>
                                                    <td class="text-right">@FormatAmount(row.Balance)</td>
                                                </tr>
                                            }
                                        }

                                        <tr class="grand-total">
                                            <td><strong>EXPENSES</strong></td>
                                            <td class="text-right"><strong>@FormatAmount(totalExpense)</strong></td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr><td colspan="2" class="text-center">No expense records found</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @* ── INCOME COLUMN ── *@
                        <div class="pl-column">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th style="width:60%;">INCOME</th>
                                        <th style="width:40%;" class="text-right">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (incomeRows.Any())
                                    {
                                        var incomeGroups = incomeRows
                                            .GroupBy(x => x.MainLedger ?? "Other")
                                            .OrderBy(g => g.Key);

                                        foreach (var group in incomeGroups)
                                        {
                                            decimal groupTotal = group.Sum(x => x.Balance);
                                            <tr class="main-ledger-row">
                                                <td><strong>@group.Key</strong></td>
                                                <td class="text-right"><strong>@FormatAmount(groupTotal)</strong></td>
                                            </tr>
                                            foreach (var row in group.OrderBy(x => x.SubLedger))
                                            {
                                                <tr class="detail-row">
                                                    <td style="padding-left:20px;">@row.SubLedger</td>
                                                    <td class="text-right">@FormatAmount(row.Balance)</td>
                                                </tr>
                                            }
                                        }

                                        <tr class="grand-total">
                                            <td><strong>INCOME</strong></td>
                                            <td class="text-right"><strong>@FormatAmount(totalIncome)</strong></td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr><td colspan="2" class="text-center">No income records found</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* ── NET PROFIT / LOSS ── *@
                    <table class="data-table" style="margin-top:10px;">
                        <tbody>
                            <tr class="net-profit">
                                <td style="width:60%;"><strong>@(netProfit >= 0 ? "Net Profit" : "Net Loss")</strong></td>
                                <td style="width:40%;" class="text-right"><strong>@FormatAmount(Math.Abs(netProfit))</strong></td>
                            </tr>
                        </tbody>
                    </table>
                }
            }
            else // Vertical
            {
                var data = plData as PLAccountVerticalData;
                if (data != null)
                {
                    var rows = data.Rows ?? new List<PLAccountRowDto>();
                    var totalIncome = data.TotalIncome;
                    var totalExpense = data.TotalExpense;
                    var netProfit = data.NetProfit;

                    <table class="data-table" data-sheet-name="PLAccountVertical">
                        <thead>
                            <tr class="meta-title">
                                <td colspan="3">Profit & Loss Account Report (Vertical)</td>
                            </tr>
                            <tr class="meta-row">
                                <td colspan="3"><strong>Branch Name :</strong> @branchName</td>
                            </tr>
                            <tr class="meta-row">
                                <td><strong>From Date :</strong> @fromDate</td>
                                <td class="text-right"><strong>To Date :</strong> @toDate</td>
                                <td></td>
                            </tr>
                            <tr class="meta-row">
                                <td colspan="3"><strong>Report Generated On :</strong> @generatedOn</td>
                            </tr>
                            <tr class="meta-spacer"><td colspan="3"></td></tr>
                        </thead>
                        <tbody>
                            @if (rows.Any())
                            {
                                // Group by LedgerHead (INCOME / EXPENSES)
                                var groups = rows.GroupBy(x => x.LedgerHead ?? "Other")
                                    .OrderByDescending(g => g.Key == "INCOME")
                                    .ToList();

                                foreach (var group in groups)
                                {
                                    <tr class="section-header">
                                        <td colspan="3">@group.Key</td>
                                    </tr>
                                    <tr>
                                        <th style="width:50%;">Sub Ledger</th>
                                        <th style="width:50%;" class="text-right">Amount</th>
                                        <th></th>
                                    </tr>

                                    // Group by MainLedger for sub-totals
                                    var mainGroups = group.GroupBy(x => x.MainLedger ?? "Other")
                                        .OrderBy(g => g.Key);

                                    decimal groupTotal = 0;
                                    foreach (var mainGroup in mainGroups)
                                    {
                                        decimal mainTotal = mainGroup.Sum(x => x.Balance);
                                        groupTotal += mainTotal;
                                        <tr class="main-ledger-row">
                                            <td><strong>@mainGroup.Key</strong></td>
                                            <td class="text-right"><strong>@FormatAmount(mainTotal)</strong></td>
                                            <td></td>
                                        </tr>
                                        foreach (var row in mainGroup.OrderBy(x => x.SubLedger))
                                        {
                                            <tr class="detail-row">
                                                <td style="padding-left:20px;">@row.SubLedger</td>
                                                <td class="text-right">@FormatAmount(row.Balance)</td>
                                                <td></td>
                                            </tr>
                                        }
                                    }

                                    <tr class="grand-total">
                                        <td><strong>Total @group.Key</strong></td>
                                        <td class="text-right"><strong>@FormatAmount(groupTotal)</strong></td>
                                        <td></td>
                                    </tr>
                                    <tr class="meta-spacer"><td colspan="3"></td></tr>
                                }

                                @* ── NET PROFIT / LOSS ── *@
                                <tr class="net-profit">
                                    <td><strong>@(netProfit >= 0 ? "Net Profit" : "Net Loss")</strong></td>
                                    <td class="text-right"><strong>@FormatAmount(Math.Abs(netProfit))</strong></td>
                                    <td></td>
                                </tr>
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center">No data found</td></tr>
                            }
                        </tbody>
                    </table>
                }
            }
        }

    </div>
</body>
</html>