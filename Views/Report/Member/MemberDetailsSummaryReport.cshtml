@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Member
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    // negatives in brackets (same as before); a missing text value prints "-"
    string FormatAmount(decimal amount) => amount < 0 ? $"({Math.Abs(amount):N2})" : amount.ToString("N2");
    string NullDisplay(object? value) => value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "-" : value.ToString()!;

    var memberInfo = Model.TryGetValue("MemberDetail", out var mi) ? mi as MemberDetailInfoDto : null;
    var shareAccounts = (Model["ShareAccounts"] as List<ShareAccountDto>) ?? new List<ShareAccountDto>();
    var savingAccounts = (Model["SavingAccounts"] as List<SavingAccountDto>) ?? new List<SavingAccountDto>();
    var loanIssues = (Model["LoanIssues"] as List<LoanIssueDto>) ?? new List<LoanIssueDto>();
    var groupGuarantees = (Model["GroupGuarantees"] as List<GroupGuaranteeDto>) ?? new List<GroupGuaranteeDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    decimal totalShare = shareAccounts.Sum(x => x.ShareAmount);
    decimal totalSavingBalance = savingAccounts.Sum(x => x.Balance);
    decimal totalGuaranteeAmount = groupGuarantees.Sum(x => x.GuaranteeAmount);

    // ── cell helpers (every row covers the 60 grid units) ──
    ReportCell C(string t, int span, Align a = Align.Left, string? css = null) => new(t, a, span, css);
    ReportCell R(string t, int span, string? css = null) => new(t, Align.Right, span, css);
    ReportCell Hd(string t, int span, Align a = Align.Left) => new(t, a, span);          // column title
    ReportCell Tt(string t, int span, Align a = Align.Right) => new(t, a, span, "tt");    // total line
    ReportCell NoData(string t) => new(t, Align.Center, 60, "nd");

    var table = new ReportTable(Model, title: "Member Details Summary Report", sheetName: "MemberDetailsSummary")
        .NoColumnHeader()                      // every block prints its own column titles (Header(...) below)
        .Style(new ReportStyle
        {
            ZebraStripes = true,
            ZebraBackground = "#fafafa",
            SectionBackground = "#fff",
            HeaderBackground = "#f0f0f0"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 60)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ font-size: 8pt; line-height: 1.25; padding: 1px 5px; }" +
            "table.sheet-table tr.r-header th { white-space: normal; border-top: 1.5px solid #333; border-bottom: 1px solid #555; border-left: 1px solid #ccc; border-right: 1px solid #ccc; }" +
            "table.sheet-table tr.r-data td { border: 1px solid #ddd; }" +
            // block titles: bold with a line under them
            "table.sheet-table tr.r-section td { background: #fff; font-size: 9pt; border-top: 0; border-bottom: 1.5px solid #333; }" +
            // total line
            "table.sheet-table td.tt { font-weight: bold; background: #f5f5f5 !important; border-top: 1.5px solid #333 !important; border-bottom: 1.5px solid #333 !important; }" +
            // loan lines: opening / between dates / total payment
            "table.sheet-table td.lo { background: #fff !important; }" +
            "table.sheet-table td.lb { background: #fafafa !important; }" +
            "table.sheet-table td.lp { background: #f0f4f8 !important; font-weight: bold; border-top: 1px dashed #aaa !important; }" +
            "table.sheet-table td.b { font-weight: bold; }" +
            "table.sheet-table td.nd { color: #888; font-style: italic; }");

    // one 60-unit grid carries all five blocks, so each block just chooses its own spans
    for (var i = 0; i < 60; i++) table.Column("", 1);

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("From Date :", NullDisplay(fromDate)),
        Fmt.Labeled("To Date :", NullDisplay(toDate)));
    table.MetaRow(Fmt.Labeled("Report Generated on :", generatedOn));

    // ═══ 1. MEMBER DETAILS: 8 columns = 6 + 10 + 4 + 7 + 7 + 8 + 11 + 7 ═══
    table.Spacer();
    table.Section("Member Details");
    table.Header(Hd("MemberId", 6), Hd("MemberName", 10), Hd("Gender", 4), Hd("Date Of Birth", 7),
                 Hd("Registration Date", 7), Hd("Contact No", 8), Hd("Address", 11), Hd("Citizenship No", 7));
    if (memberInfo != null)
    {
        table.Data(
            C(NullDisplay(memberInfo.MemberId), 6),
            C(NullDisplay(memberInfo.Name), 10),
            C(NullDisplay(memberInfo.Sex), 4),
            C(NullDisplay(memberInfo.DateOfBirth), 7),
            C(NullDisplay(memberInfo.RegistrationDate), 7),
            C(NullDisplay(memberInfo.MobileNo), 8),
            C(NullDisplay(memberInfo.PermanentAddress), 11),
            C(NullDisplay(memberInfo.CitizenshipNo), 7));
    }
    else
    {
        table.Data(NoData("Member information not available"));
    }

    // ═══ 2. SHARE TYPE: 5 columns = 20 + 10 + 10 + 10 + 10 ═══
    table.Spacer();
    table.Section("Share Type");
    table.Header(Hd("Share Holder", 20), Hd("Previous Share", 10, Align.Right), Hd("Share Purchase", 10, Align.Right),
                 Hd("Share Return", 10, Align.Right), Hd("Total Share", 10, Align.Right));
    if (shareAccounts.Any())
    {
        decimal prev = shareAccounts.Sum(x => x.PreviousShare);
        decimal purchase = shareAccounts.Sum(x => x.SharePurchase);
        decimal ret = shareAccounts.Sum(x => x.ShareReturn);

        table.Data(
            C(NullDisplay(memberInfo?.Name), 20),
            R(FormatAmount(prev), 10),
            R(FormatAmount(purchase), 10),
            R(FormatAmount(ret), 10),
            R(FormatAmount(totalShare), 10));

        // label spans the first 4 columns; the value fills Total Share
        table.Data(Tt("Total :", 50), Tt(FormatAmount(totalShare), 10));
    }
    else
    {
        table.Data(NoData("No share records found"));
    }

    // ═══ 3. ACCOUNT OPENING: 9 columns = 7 + 7 + 5 + 5 + 7 + 8 + 7 + 7 + 7 ═══
    table.Spacer();
    table.Section("Account Opening");
    table.Header(Hd("A/C No", 7), Hd("Deposit Type", 7), Hd("A/C Status", 5), Hd("Interest", 5, Align.Right),
                 Hd("A/C Open Date", 7), Hd("Opening Balance", 8, Align.Right), Hd("Deposit Amount", 7, Align.Right),
                 Hd("Withdraw Amount", 7, Align.Right), Hd("Total Balance", 7, Align.Right));
    if (savingAccounts.Any())
    {
        decimal totalOpening = 0;
        decimal totalDeposit = 0;
        decimal totalWithdraw = 0;

        foreach (var acc in savingAccounts)
        {
            totalOpening += acc.OpeningBalance;
            totalDeposit += acc.DepositAmount;
            totalWithdraw += acc.WithdrawAmount;

            table.Data(
                C(NullDisplay(acc.AccountNo), 7),
                C(NullDisplay(acc.AccountType), 7),
                C(NullDisplay(acc.Status), 5),
                R(acc.InterestRate?.ToString("F2") ?? "0.00", 5),
                C(NullDisplay(acc.OpeningDate), 7),
                R(FormatAmount(acc.OpeningBalance), 8),
                R(FormatAmount(acc.DepositAmount), 7),
                R(FormatAmount(acc.WithdrawAmount), 7),
                R(FormatAmount(acc.Balance), 7));
        }

        // label spans the first 5 columns (31 units); the four amounts fill the rest
        table.Data(Tt("Total :", 31), Tt(FormatAmount(totalOpening), 8), Tt(FormatAmount(totalDeposit), 7),
                   Tt(FormatAmount(totalWithdraw), 7), Tt(FormatAmount(totalSavingBalance), 7));
    }
    else
    {
        table.Data(NoData("No saving accounts found"));
    }

    // ═══ 4. LOAN ISSUE DETAILS: 12 columns = 6 + 5 + 5 + 5 + 5 + 4 + 5 | 8 | 5 + 4 + 4 + 4 ═══
    // each loan prints three lines: Opening Details, Between Date Details, Total Issue Payment
    table.Spacer();
    table.Section("Loan Issue Details");
    table.Header(Hd("A/C NO", 6), Hd("Issue Date", 5), Hd("Maturity Date", 5), Hd("Principle Due", 5, Align.Right),
                 Hd("Interest Due", 5, Align.Right), Hd("Penalty Due", 4, Align.Right), Hd("Total Due Amt", 5, Align.Right),
                 Hd("Issue/Payment Details", 8), Hd("Issue Amount", 5, Align.Right), Hd("Prin Paid", 4, Align.Right),
                 Hd("Int Paid", 4, Align.Right), Hd("Pent Paid", 4, Align.Right));
    if (loanIssues.Any())
    {
        decimal grandIssue = 0;
        decimal grandPrinPaid = 0;
        decimal grandIntPaid = 0;
        decimal grandPentPaid = 0;

        // the first 7 columns stay empty on the second and third line of a loan
        ReportCell[] Blank(string css) => new[] { 6, 5, 5, 5, 5, 4, 5 }.Select(s => C("", s, Align.Left, css)).ToArray();

        foreach (var loan in loanIssues)
        {
            grandIssue += loan.LoanAmount;
            grandPrinPaid += loan.PrincipalPaid;
            grandIntPaid += loan.InterestPaid;
            grandPentPaid += loan.PenaltyPaid;

            // opening details
            table.Data(
                C(NullDisplay(loan.LoanAccountNo), 6, Align.Left, "lo"),
                C(NullDisplay(loan.IssueDate), 5, Align.Left, "lo"),
                C(NullDisplay(loan.MaturityDate), 5, Align.Left, "lo"),
                R(FormatAmount(loan.PrincipleDue), 5, "lo"),
                R(FormatAmount(loan.InterestDue), 5, "lo"),
                R(FormatAmount(loan.PenaltyDue), 4, "lo"),
                R(FormatAmount(loan.TotalDue), 5, "lo"),
                C("Opening Details:", 8, Align.Left, "lo b"),
                R("0.00", 5, "lo"), R("0.00", 4, "lo"), R("0.00", 4, "lo"), R("0.00", 4, "lo"));

            // between date details
            table.Data(Blank("lb")
                .Concat(new[]
                {
                    C("Between Date Details:", 8, Align.Left, "lb b"),
                    R(FormatAmount(loan.LoanAmount), 5, "lb"),
                    R(FormatAmount(loan.PrincipalPaid), 4, "lb"),
                    R(FormatAmount(loan.InterestPaid), 4, "lb"),
                    R(FormatAmount(loan.PenaltyPaid), 4, "lb")
                }).ToArray());

            // total issue payment (per loan)
            table.Data(Blank("lp")
                .Concat(new[]
                {
                    C("Total Issue Payment:", 8, Align.Left, "lp"),
                    R(FormatAmount(loan.LoanAmount), 5, "lp"),
                    R(FormatAmount(loan.PrincipalPaid), 4, "lp"),
                    R(FormatAmount(loan.InterestPaid), 4, "lp"),
                    R(FormatAmount(loan.PenaltyPaid), 4, "lp")
                }).ToArray());
        }

        // label spans the first 8 columns (43 units); the four amounts fill the rest
        table.Data(Tt("Total :", 43), Tt(FormatAmount(grandIssue), 5), Tt(FormatAmount(grandPrinPaid), 4),
                   Tt(FormatAmount(grandIntPaid), 4), Tt(FormatAmount(grandPentPaid), 4));
    }
    else
    {
        table.Data(NoData("No loan records found"));
    }

    // ═══ 5. GROUP GUARANTEE DETAILS: 9 columns = 6 + 8 + 7 + 6 + 6 + 6 + 6 + 8 + 7 ═══
    table.Spacer();
    table.Section("Group Guarantee Details");
    table.Header(Hd("A/C NO", 6), Hd("Loan Type", 8), Hd("Saving A/C No", 7), Hd("Saving Amount", 6, Align.Right),
                 Hd("Share Amount", 6, Align.Right), Hd("Guarantee Date", 6), Hd("Lonee Id", 6), Hd("Lonee Name", 8),
                 Hd("Loan Issue Amount", 7, Align.Right));
    if (groupGuarantees.Any())
    {
        foreach (var g in groupGuarantees)
        {
            table.Data(
                C(NullDisplay(g.AccountNo), 6),
                C(NullDisplay(g.LoanType), 8),
                C(NullDisplay(g.SavingAccountNo), 7),
                R(FormatAmount(g.SavingAmount), 6),
                R(FormatAmount(g.ShareAmount), 6),
                C(NullDisplay(g.GuaranteeDate), 6),
                C(NullDisplay(g.LoneyId), 6),
                C(NullDisplay(g.LoneyName), 8),
                R(FormatAmount(g.LoanIssueAmount), 7));
        }

        // label spans the first 8 columns (53 units); the value fills Loan Issue Amount
        table.Data(Tt("Total :", 53), Tt(FormatAmount(totalGuaranteeAmount), 7));
    }
    else
    {
        table.Data(NoData("No group guarantee records found"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())