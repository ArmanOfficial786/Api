@using NexgenCosysReport.Dtos.RequestDtos.Member
@model Dictionary<string, object>

@{
    Layout = null;

    var dataSet = (Model["MemberDataSet"] as List<MemberBasicDetailsSpDto>) ?? new List<MemberBasicDetailsSpDto>();
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string NullDisplay(object value) =>
        value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "-" : value.ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Member Details With Age Report</title>
    <style>
            /* ---- Reset & full-width ---- */
            html, body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100vh;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
            }

            .report-container {
                width: 100%;
                margin: 0;
                padding: 0;
                overflow: visible;
            }

            /* ---- Table styles ---- */
            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-family: Arial, sans-serif;
                font-size: 8pt;
                table-layout: auto; /* columns size to content */
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    vertical-align: middle;
                    background: #FFFFFF;
                    padding: 3px 4px;
                    border: 1px solid #ddd;
                }

                .data-table th {
                    border-top: 2px solid #000;
                    border-bottom: 1px solid #000;
                    font-weight: bold;
                    background: #f2f2f2;
                }

            /* ---- Special column width hints (via colgroup) ---- */
            .col-sn {
                width: 5%;
            }

            .col-memberid {
                width: 12%;
            }

            .col-name {
                width: 18%;
            }

            .col-gender {
                width: 6%;
            }

            .col-contact {
                width: 12%;
            }

            .col-father {
                width: 12%;
            }

            .col-mother {
                width: 12%;
            }

            .col-dob {
                width: 10%;
            }

            .col-age {
                width: 8%;
            }

            /* Prevent wrapping on short columns */
            .col-sn, .col-memberid, .col-gender, .col-age {
                white-space: nowrap;
            }

            /* ---- Meta rows ---- */
            .meta-title td {
                text-align: center;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 4px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 8px;
            }

            /* ---- Grand total ---- */
            .grand-total td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
            }

            /* ---- Alignment helpers ---- */
            .text-right {
                text-align: right !important;
            }

            .text-left {
                text-align: left !important;
            }

            .text-center {
                text-align: center !important;
            }

            /* ---- Print ---- */
            @@media print {
                body {
                    margin: 0;
                    padding: 0;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="MemberBasicDetails">
            <!-- Column width hints -->
            <colgroup>
                <col class="col-sn" />
                <col class="col-memberid" />
                <col class="col-name" />
                <col class="col-gender" />
                <col class="col-contact" />
                <col class="col-father" />
                <col class="col-mother" />
                <col class="col-dob" />
                <col class="col-age" />
            </colgroup>
            <tbody>
                <!-- Title spans all 9 columns -->
                <tr class="meta-title">
                    <td colspan="9">Member Details With Age Report</td>
                </tr>

                <!-- Branch Name + From Date -->
                <tr class="meta-row">
                    <td colspan="4"><strong>Branch Name :</strong> @branchName</td>
                    <td colspan="5" class="text-right"><strong>From Date :</strong> @fromDate</td>
                </tr>

                <!-- Generated On + To Date -->
                <tr class="meta-row">
                    <td colspan="4"><strong>Report Generated On :</strong> @generatedOn</td>
                    <td colspan="5" class="text-right"><strong>To Date :</strong> @toDate</td>
                </tr>

                <tr class="meta-spacer"><td colspan="9"></td></tr>

                <!-- Header row -->
                <tr>
                    <th>S.N.</th>
                    <th>Member Id</th>
                    <th>Full Name</th>
                    <th>Gender</th>
                    <th>Contact No</th>
                    <th>Father Name</th>
                    <th>Mother Name</th>
                    <th>Date of Birth</th>
                    <th>Age (Y/M/D)</th>
                </tr>

                @{
                    int sn = 0;
                }
                @foreach (var row in dataSet)
                {
                    sn++;
                    <tr>
                        <td class="text-center">@sn</td>
                        <td>@NullDisplay(row.MemberId)</td>
                        <td>@NullDisplay(row.FullName)</td>
                        <td>@NullDisplay(row.Gender)</td>
                        <td>@NullDisplay(row.ContactNo)</td>
                        <td>@NullDisplay(row.FatherName)</td>
                        <td>@NullDisplay(row.MotherName)</td>
                        <td>@NullDisplay(row.DateOfBirth)</td>
                        <td>@NullDisplay(row.NoOfYear)</td>
                    </tr>
                }

                <!-- Grand Total: 2 columns for label + 7 for count = 9 -->
                <tr class="grand-total">
                    <td colspan="2">Total Records</td>
                    <td colspan="7">@dataSet.Count</td>
                </tr>
            </tbody>
        </table>
    </div>
</body>
</html>