@using NexgenCosysReport.Dtos.RequestDtos.Member
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "8pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    string NullDisplay(object? value) =>
        value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "-" : value.ToString()!;

    var dataSet = (Model["MemberDataSet"] as List<MemberBasicDetailsSpDto>) ?? new List<MemberBasicDetailsSpDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Member Details With Age Report", sheetName: "MemberBasicDetails")
        .Column("S.N.", 5, Align.Center)
        .Column("Member Id", 12)
        .Column("Full Name", 18)
        .Column("Gender", 6)
        .Column("Contact No", 12)
        .Column("Father Name", 12)
        .Column("Mother Name", 12)
        .Column("Date of Birth", 10)
        .Column("Age (Y/M/D)", 8)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 3px 4px; border: 1px solid #ddd; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-data td.gt { font-weight: bold; background: #f9f9f9; border-top: 2px solid #000; border-bottom: 2px solid #000; }");

    table.MetaRow(
        Fmt.Labeled("Branch Name :", branchName),
        Fmt.Labeled("From Date :", fromDate),
        4);
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Labeled("To Date :", toDate),
        4);

    var sn = 0;
    foreach (var row in dataSet)
    {
        table.Data(
            (++sn).ToString(),
            NullDisplay(row.MemberId),
            NullDisplay(row.FullName),
            NullDisplay(row.Gender),
            NullDisplay(row.ContactNo),
            NullDisplay(row.FatherName),
            NullDisplay(row.MotherName),
            NullDisplay(row.DateOfBirth),
            NullDisplay(row.NoOfYear));
    }

    if (dataSet.Count > 0)
    {
        table.Data(
            new ReportCell("Total Records", Align.Left, 2, "gt"),
            new ReportCell(dataSet.Count.ToString(), Align.Left, 7, "gt"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())