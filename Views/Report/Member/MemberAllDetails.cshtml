@using NexgenCosysReport.Dtos.ReportDtos
@using NexgenCosysReport.Dtos.RequestDtos.Member
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    var dataSet = (Model["MemberAllDetailDataSet"] as IEnumerable<MemberAllDetailSpResponse>)?.ToList()
                  ?? new List<MemberAllDetailSpResponse>();

    var branchName = Text("BranchName", "All");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var isExcel = Text("Format", "VIEW") is "EXCEL" or "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var selectedColumns = (Model.TryGetValue("SelectedColumns", out var sc) ? sc as IEnumerable<string> : null)?.ToList();
    var showAllColumns = selectedColumns == null || selectedColumns.Count == 0;

    var allColumns = new List<(string Key, string Header, double Width, Func<MemberAllDetailSpResponse, object?> Render)>
    {
        ("MemberId",                  "Member ID",               3.10, r => r.MemberId),
        ("FullName",                  "Full Name",               4.20, r => r.FullName),
        ("MemberType",                "Member Type",             2.90, r => r.MemberType),
        ("BirthOnBS",                 "DOB (BS)",                2.90, r => r.BirthOnBS),
        ("PermanentAddress",          "Perm. Address",           4.20, r => r.PermanentAddress),
        ("TemporaryAddress",          "Temp. Address",           4.20, r => r.TemporaryAddress),
        ("PhoneNo",                   "Phone",                   2.90, r => r.PhoneNo),
        ("MobileNo",                  "Mobile",                  3.10, r => r.MobileNo),
        ("EmailAddress",              "Email",                   4.50, r => r.EmailAddress),
        ("Nationality",               "Nationality",             2.50, r => r.Nationality),
        ("CitizenshipNo",             "Citizenship No",          3.30, r => r.CitizenshipNo),
        ("PassportNo",                "Passport No",             2.90, r => r.PassportNo),
        ("Occupation",                "Occupation",              2.90, r => r.Occupation),
        ("Religion",                  "Religion",                2.40, r => r.Religion),
        ("MaritalStatus",             "Marital Status",          2.60, r => r.MaritalStatus),
        ("GrandFatherMotherName",     "Grandfather/Mother",      3.30, r => r.GrandFatherMotherName),
        ("FatherName",                "Father",                  2.90, r => r.FatherName),
        ("MotherName",                "Mother",                  2.90, r => r.MotherName),
        ("SpouseName",                "Spouse",                  2.90, r => r.SpouseName),
        ("Caste",                     "Caste",                   2.40, r => r.Caste),
        ("Gender",                    "Gender",                  2.00, r => r.Gender),
        ("Vdc",                       "VDC",                     2.40, r => r.Vdc),
        ("RegistrationOnBS",          "Reg. Date (BS)",          2.60, r => r.RegistrationOnBS),
        ("Status",                    "Status",                  2.20, r => r.Status),
        ("MemberGroup",               "Member Group",            3.10, r => r.MemberGroup),
        ("CitizenShipIssuedOnBs",     "Cit. Issued On (BS)",     2.60, r => r.CitizenShipIssuedOnBs),
        ("CitizenShipIssuedDistrict", "Cit. Issued District",    3.10, r => r.CitizenShipIssuedDistrict),
        ("ElectricityNo",             "Electricity No",          2.40, r => r.ElectricityNo),
        ("WaterSupplyNo",             "Water Supply No",         2.40, r => r.WaterSupplyNo),
        ("Education",                 "Education",               2.60, r => r.Education),
        ("IncomeRange",               "Income Range",            3.30, r => r.IncomeRange),
        ("StateVDC",                  "State VDC",               2.40, r => r.StateVDC),
        ("MemberYearlyPaymentTillDateOnBs", "Yearly Paymt Till (BS)", 2.90, r => r.MemberYearlyPaymentTillDateOnBs),
        ("NameInNepali",              "Name (Nepali)",           3.30, r => r.NameInNepali),
        ("AddressInNepali",           "Address (Nepali)",        4.20, r => r.AddressInNepali),
    };

    var columns = showAllColumns
        ? allColumns
        : allColumns.Where(c => selectedColumns!.Contains(c.Key, StringComparer.OrdinalIgnoreCase)).ToList();

    var totalCols = columns.Count + 2;
    var totalRecords = dataSet.Count;

    var pageSetting = Model["PageSetting"] as PageSizeSetting;
    var printableMm = (pageSetting?.ContentWidthMm ?? 570) - 1;
    var photoMm = isExcel ? 12.0 : 29.0;
    var snShare = 1.2;
    var otherShare = snShare + columns.Sum(c => c.Width);
    var photoShare = photoMm * otherShare / (printableMm - photoMm);

    var photoRowCss = isExcel ? "" : "table.sheet-table tr.r-data { height: 28mm; }\n";

    var table = new ReportTable(Model, title: "Member All Detail Report", sheetName: "MemberAllDetailReport")
        .Column("S.N.", snShare, Align.Center)
        .Column("Photo", photoShare, Align.Center);

    foreach (var col in columns)
        table.Column(col.Header, col.Width);

    table
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            GroupBackground = "#fff"
        })
        .Sizing(rowMm: 10, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td " +
            "{ font-size: " + fontSize + "; line-height: 1.3; padding: 3px 4px; }\n" +
            "table.sheet-table tr.r-header th { font-size: 6.8pt; border-top: 1.5px solid #000; border-bottom: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #e0e0e0; }\n" +
            photoRowCss +
            "table.sheet-table tr.r-group td { border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; background: #fff; }\n" +
            "table.sheet-table img.r-img { width: 100px; height: 100px; max-width: none; max-height: none; object-fit: cover; }");

    table.MetaRow(
        Fmt.Labeled("Branch Name :", branchName),
        Fmt.Labeled("From Date :", fromDate));
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Labeled("To Date :", toDate));

    var sn = 0;
    foreach (var row in dataSet)
    {
        var cells = new List<ReportCell>
        {
            ReportCell.Center((++sn).ToString()),
            isExcel ? ReportCell.Center("") : ReportCell.Image(row.MemberImage)
        };

        foreach (var col in columns)
            cells.Add(ReportCell.Left($"{col.Render(row)}"));

        table.Data(cells.ToArray());
    }

    if (dataSet.Count > 0)
    {
        table.GroupBy(
            new ReportCell("Total Records :", Align.Left, 2),
            new ReportCell(totalRecords.ToString(), Align.Left, totalCols - 2));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())