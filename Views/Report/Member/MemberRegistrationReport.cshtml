@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.ReportDtos
@using NexgenCosysReport.Dtos.RequestDtos.Member
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    // any property type prints as its text; a missing value prints blank (same as before)
    string S(object? v) => v?.ToString() ?? "";

    var dataSet = (Model["MemberAllDetailDataSet"] as IEnumerable<MemberRegistrationDetail>)?.ToList()
                  ?? new List<MemberRegistrationDetail>();

    var branchName = Text("BranchName", "All");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null
        ? Convert.ToInt32(tr)
        : dataSet.Count;

    var table = new ReportTable(Model, title: "Member Registration Report", sheetName: "MemberRegistrationReport")
        .Column("S.N.", 2.09, Align.Center)
        .Column("Member ID", 4.94)
        .Column("Full Name", 6.65)
        .Column("DOB", 4.56)
        .Column("Sex", 2.66)
        .Column("Caste", 3.61)
        .Column("Religion", 3.61)
        .Column("Email", 8.56)
        .Column("Mobile", 5.23)
        .Column("Phone", 4.75)
        .Column("Nationality", 3.80)
        .Column("Occupation", 4.56)
        .Column("Citizenship No", 5.23)
        .Column("Passport No", 4.28)
        .Column("Grandfather", 5.23)
        .Column("Father", 4.75)
        .Column("Mother", 4.75)
        .Column("Zone", 3.61)
        .Column("District", 3.99)
        .Column("VDC", 3.61)
        .Column("Perm. Address", 5.51)
        .Column("Reg. Date", 3.99)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)   // addresses and e-mails may wrap to two lines
        .Css(
            "table.sheet-table tr.r-data td { font-size: 7pt; line-height: 1.3; padding: 3px 4px; border-bottom: 1px solid #e0e0e0; }" +
            "table.sheet-table tr.r-header th { font-size: 6.8pt; padding: 4px; }" +
            // total line
            "table.sheet-table td.tt { font-weight: bold; background: #fff !important; border-top: 1.5px solid #000 !important; border-bottom: 1.5px solid #000 !important; }");

    // ── title block ──
    table.MetaRow(
        Fmt.Labeled("Branch Name :", branchName),
        Fmt.Labeled("From Date :", fromDate),
        leftSpan: 13);
    table.MetaRow(
        Fmt.Labeled("Report Generated On :", generatedOn),
        Fmt.Labeled("To Date :", toDate),
        leftSpan: 13);

    // ── rows ──
    var sn = 0;
    foreach (var row in dataSet)
    {
        sn++;
        table.Data(
            sn.ToString(),
            S(row.MemberId),
            S(row.Name),
            S(row.DateOfBirth),
            S(row.Sex),
            S(row.Caste),
            S(row.Religion),
            S(row.EmailId),
            S(row.MobileNo),
            S(row.PhoneNo),
            S(row.Nationality),
            S(row.Occupation),
            S(row.CitizenshipNo),
            S(row.PassportNo),
            S(row.GrandFatherName),
            S(row.FatherName),
            S(row.MotherName),
            S(row.Zone),
            S(row.District),
            S(row.VDC),
            S(row.PermanentAddress),
            S(row.RegistrationDate));
    }

    // label spans the first 2 columns; the count spans the other 20, left-aligned (same as before)
    if (dataSet.Count > 0)
    {
        table.Data(
            new ReportCell("Total Records :", Align.Left, 2, "tt"),
            new ReportCell(totalRecords.ToString(), Align.Left, 20, "tt"));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())