@using NexgenCosysReport.Dtos.RequestDtos.Member
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    string NullDisplay(object? value) =>
        value == null || string.IsNullOrWhiteSpace(value.ToString()) ? "-" : value.ToString()!;

    var data = Model["BloodGroupDataSet"] as List<MemberBloodGroupSpDto> ?? new List<MemberBloodGroupSpDto>();

    var fromDate = Text("FromDate");
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Member Blood Group Report", sheetName: "MemberBloodGroupReport")
        .Column("S.N.", 6, Align.Center)
        .Column("Member Id", 12)
        .Column("Member Name", 22)
        .Column("Gender", 8)
        .Column("Date Of Birth", 14)
        .Column("Registration Date", 14)
        .Column("Blood Group", 12)
        .Column("Contact", 12)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6.5, headerMm: 8, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 4px 6px; border: 1px solid #ddd; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-total td { border-top: 2px solid #000; border-bottom: 2px solid #000; }");

    table.MetaRow(
        Fmt.Labeled("Branch :", branchName),
        Fmt.Labeled("From Date :", fromDate),
        4);
    table.MetaRow(Fmt.Labeled("Report Generated on :", generatedOn));

    var sn = 0;
    foreach (var row in data)
    {
        table.Data(
            (++sn).ToString(),
            NullDisplay(row.MemberId),
            NullDisplay(row.Name),
            NullDisplay(row.Sex),
            NullDisplay(row.DateOfBirth),
            NullDisplay(row.RegistrationDate),
            NullDisplay(row.BloodGroup),
            NullDisplay(row.ContactNo));
    }

    if (data.Count > 0)
    {
        table.Total("Total Records:", 7, data.Count.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())