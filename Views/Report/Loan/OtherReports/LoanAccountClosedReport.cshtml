@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 7;   // number of .Column(...) lines below; the member line spans all of them

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<LoanAccountClosedRowDto>) ?? new List<LoanAccountClosedRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var memberGroupName = Text("MemberGroupName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // grouped by member: member line once, then that member's closed loans underneath
    var memberGroups = rows.GroupBy(r => new { r.MemberId, r.FullName }).ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalMembers = (int)TotalOr("TotalMembers", memberGroups.Count);

    var table = new ReportTable(Model, title: "Loan Account Closed Report", sheetName: "LoanAccountClosed")
        .Column("Member ID", 11)
        .Column("Name", 20)
        .Column("", 6, Align.Center)           // serial number of the loan inside its member
        .Column("A/C No", 14)
        .Column("Loan Type", 17)
        .Column("Issue Date", 16)
        .Column("Closed Date", 16)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            // member line: bold, no rules
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; }\n" +
            // closed loan rows: a rule under each
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #ccc; }\n" +
            ".sn-col { color: #555; }\n" +
            ".loan-account { color: #1F5C99; }");

    // ── title block: stacked, left-aligned ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("Till Date :", toDate)));
    if (!string.IsNullOrEmpty(memberGroupName)) table.MetaRow(Fmt.Labeled("Member Group :", memberGroupName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // ── rows: one block per member ──
    foreach (var grp in memberGroups)
    {
        // member line: id, name, then one empty cell covering the other 5 columns
        table.GroupBy(
            ReportCell.Left(grp.Key.MemberId ?? ""),
            ReportCell.Left(grp.Key.FullName ?? ""),
            ReportCell.Left("", ColumnCount - 2));

        // that member's closed loans, numbered from 1
        var sn = 0;
        foreach (var row in grp)
        {
            table.Data(
                ReportCell.Left(""),
                ReportCell.Left(""),
                new ReportCell((++sn).ToString(), Align.Center, 1, "sn-col"),
                new ReportCell(row.LoanAccountNo ?? "", Align.Left, 1, "loan-account"),
                ReportCell.Left(row.LoanTypeName ?? ""),
                ReportCell.Left(row.LoanIssueDate ?? ""),
                ReportCell.Left(row.CloseDate ?? ""));
        }
    }

    // footer: one cell spanning all 7 columns
    if (rows.Count > 0)
        table.Total($"Total Members: {totalMembers}  |  Total Closed Loans: {totalRecords}", ColumnCount);
}
@await Html.PartialAsync("_SheetReport", table.Build())