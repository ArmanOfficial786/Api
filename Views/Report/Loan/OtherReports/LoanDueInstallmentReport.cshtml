@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 9;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";
    string Sum(decimal value) => value.ToString("N2");

    var rows = (Model["Rows"] as List<LoanDueInstallmentRowDto>) ?? new List<LoanDueInstallmentRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchNames = Text("BranchNames", "All");
    var memberName = Text("MemberName");
    var memberGroupName = Text("MemberGroupName");
    var paymentDurationTypeName = Text("PaymentDurationTypeName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.FullName, r.MobileNo, r.TemporaryAddressDetail })
        .ToList();

    var totalPrincipleAmount = TotalOr("TotalPrincipleAmount", rows.Sum(r => r.PrincipleAmount ?? 0));
    var totalInterestAmount = TotalOr("TotalInterestAmount", rows.Sum(r => r.InterestAmount ?? 0));
    var totalInstallmentAmount = TotalOr("TotalInstallmentAmount", rows.Sum(r => r.InstallmentAmount ?? 0));

    var table = new ReportTable(Model, title: "Loan Due Installment Report", sheetName: "LoanDueInstallment")
        .Column("MemberId", 9)
        .Column("Member Name", 15)
        .Column("A/C No", 11)
        .Column("Loan Type", 11)
        .Column("Date", 11)
        .Column("Principle", 11, Align.Right)
        .Column("Interest", 11, Align.Right)
        .Column("Installment", 11, Align.Right)
        .Column("Balance", 10, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 4px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }");

    if (!string.IsNullOrEmpty(memberName))
        table.MetaRow(Fmt.Labeled("Member :", memberName));
    else
        table.MetaRow(Fmt.Labeled("Branch Name :", branchNames));

    IHtmlContent? filters = null;
    if (!string.IsNullOrEmpty(memberGroupName) && !string.IsNullOrEmpty(paymentDurationTypeName))
        filters = Fmt.Join(Fmt.Labeled("Member Group :", memberGroupName), Fmt.Labeled("Payment Duration :", paymentDurationTypeName));
    else if (!string.IsNullOrEmpty(memberGroupName))
        filters = Fmt.Labeled("Member Group :", memberGroupName);
    else if (!string.IsNullOrEmpty(paymentDurationTypeName))
        filters = Fmt.Labeled("Payment Duration :", paymentDurationTypeName);

    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("Till Date :", toDate)), filters, 4);
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var memberGroup in memberGroups)
    {
        table.GroupBy(
            ReportCell.Left(memberGroup.Key.MemberId ?? ""),
            ReportCell.Left(memberGroup.Key.FullName ?? ""),
            ReportCell.Left("", 2),
            ReportCell.Left(memberGroup.Key.MobileNo ?? "", 2),
            ReportCell.Left(memberGroup.Key.TemporaryAddressDetail ?? "", 3));

        var loanGroups = memberGroup.GroupBy(r => new { r.LoanAccountNo, r.LoanTypeName }).ToList();

        foreach (var loanGroup in loanGroups)
        {
            table.GroupBy(
                ReportCell.Left(""),
                ReportCell.Left(""),
                ReportCell.Left(loanGroup.Key.LoanAccountNo ?? ""),
                ReportCell.Left(loanGroup.Key.LoanTypeName ?? ""),
                ReportCell.Left("", 5));

            foreach (var row in loanGroup)
            {
                table.Data(
                    "",
                    "",
                    "",
                    "",
                    row.DateOnBS ?? "",
                    Money(row.PrincipleAmount),
                    Money(row.InterestAmount),
                    Money(row.InstallmentAmount),
                    Money(row.BalanceAmount));
            }

            table.SubTotal(
                loanGroup.Key.LoanAccountNo ?? "", 5,
                Sum(loanGroup.Sum(r => r.PrincipleAmount ?? 0)),
                Sum(loanGroup.Sum(r => r.InterestAmount ?? 0)),
                Sum(loanGroup.Sum(r => r.InstallmentAmount ?? 0)),
                "");
        }

        table.SubTotal(
            memberGroup.Key.MemberId ?? "", 5,
            Sum(memberGroup.Sum(r => r.PrincipleAmount ?? 0)),
            Sum(memberGroup.Sum(r => r.InterestAmount ?? 0)),
            Sum(memberGroup.Sum(r => r.InstallmentAmount ?? 0)),
            "");
    }

    if (rows.Count > 0)
        table.Total("Grand Total", 5, Sum(totalPrincipleAmount), Sum(totalInterestAmount), Sum(totalInstallmentAmount), "");
}
@await Html.PartialAsync("_SheetReport", table.Build())