@* Views/Report/Loan/OtherReports/LoanDueInstallmentReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanDueInstallmentRowDto>) ?? new List<LoanDueInstallmentRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalPrincipleAmount = Model["TotalPrincipleAmount"] as decimal? ?? 0;
    var totalInterestAmount = Model["TotalInterestAmount"] as decimal? ?? 0;
    var totalInstallmentAmount = Model["TotalInstallmentAmount"] as decimal? ?? 0;
    var totalBalanceAmount = Model["TotalBalanceAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchNames = Model["BranchNames"]?.ToString() ?? "All";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var paymentDurationTypeName = Model["PaymentDurationTypeName"]?.ToString() ?? "";
    var orderBy = Model["OrderBy"]?.ToString() ?? "-1";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberSearch = !string.IsNullOrEmpty(memberName);
    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);
    var isPaymentDurationFiltered = !string.IsNullOrEmpty(paymentDurationTypeName);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Due Installment Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .positive {
                color: #006600;
            }

            .negative {
                color: #CC0000;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanDueInstallment">
            <colgroup>
                <col style="width:9%;" />
                <col style="width:15%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:10%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="9">Loan Due Installment Report</td>
                </tr>

                <!-- Metadata -->
                @if (isMemberSearch)
                {
                    <tr class="meta-row">
                        <td colspan="4"><strong>Member :</strong> @memberName</td>
                        <td colspan="5" class="text-right"><strong>Branch :</strong> @branchNames</td>
                    </tr>
                }
                else
                {
                    <tr class="meta-row">
                        <td colspan="4"><strong>Branch Name :</strong> @branchNames</td>
                        <td colspan="5" class="text-right">
                            <strong>From Date :</strong> @fromDate
                            &nbsp;&nbsp;&nbsp;
                            <strong>To Date :</strong> @toDate
                        </td>
                    </tr>
                }
                @if (isMemberGroupFiltered)
                {
                    <tr class="meta-row">
                        <td colspan="4"><strong>Member Group :</strong> @memberGroupName</td>
                        <td colspan="5" class="text-right">
                            @if (isPaymentDurationFiltered)
                            {
                                <strong>Payment Duration :</strong> 
                                @paymentDurationTypeName
                            }
                        </td>
                    </tr>
                }
                else if (isPaymentDurationFiltered)
                {
                    <tr class="meta-row">
                        <td colspan="9" class="text-right">
                            <strong>Payment Duration :</strong> @paymentDurationTypeName
                        </td>
                    </tr>
                }
                <tr class="meta-row">
                    <td colspan="9"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="9"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Loan A/c No</th>
                    <th>Loan Type</th>
                    <th>Payment Duration</th>
                    <th class="text-right">Principal Due</th>
                    <th class="text-right">Interest Due</th>
                    <th class="text-right">Installment</th>
                    <th class="text-right">Balance</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.FullName ?? "")</td>
                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            <td>@(row.PaymentDurationType ?? "")</td>
                            <td class="text-right">@(row.PrincipleAmount.HasValue ? row.PrincipleAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.InterestAmount.HasValue ? row.InterestAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.InstallmentAmount.HasValue ? row.InstallmentAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.BalanceAmount.HasValue ? row.BalanceAmount.Value.ToString("N2") : "")</td>
                        </tr>
                    }

                    <!-- Grand Total Row -->
                    <tr class="grand-total-row">
                        <td colspan="5" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalPrincipleAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalInterestAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalInstallmentAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalBalanceAmount.ToString("N2")</strong></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="8" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>