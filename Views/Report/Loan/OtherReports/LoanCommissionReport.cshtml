@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 7;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<LoanCommissionRowDto>) ?? new List<LoanCommissionRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var collectorName = Text("CollectorName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var memberGroups = rows.GroupBy(r => new { r.MemberId, r.FullName }).ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalMembers = memberGroups.Count;
    var totalInterestAmount = TotalOr("TotalInterestAmount", rows.Sum(r => r.TotalInterestAmount ?? 0));
    var totalCommissionAmount = TotalOr("TotalCommissionAmount", rows.Sum(r => r.CommissionAmount ?? 0));

    var table = new ReportTable(Model, title: "Loan Commission Report", sheetName: "LoanCommission")
        .Column("Loanee ID", 12)
        .Column("Loanee Name", 18)
        .Column("", 6, Align.Center)
        .Column("Loan A/C No", 16)
        .Column("Total Interest Amount", 18, Align.Right)
        .Column("Commission Amount", 17, Align.Right)
        .Column("Date", 16, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; padding-top: 4px; padding-bottom: 8px; }\n" +
            ".sn-col { color: #555; }\n" +
            ".loan-account { color: #1F5C99; }");

    table.MetaRow(Fmt.Labeled("Collector Name :", string.IsNullOrEmpty(collectorName) ? "All" : collectorName));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var grp in memberGroups)
    {
        table.GroupBy(
            ReportCell.Left(grp.Key.MemberId ?? ""),
            ReportCell.Left(grp.Key.FullName ?? ""),
            ReportCell.Left("", ColumnCount - 2));

        var sn = 0;
        var memberInterestTotal = 0m;
        var memberCommissionTotal = 0m;
        foreach (var row in grp)
        {
            memberInterestTotal += row.TotalInterestAmount ?? 0;
            memberCommissionTotal += row.CommissionAmount ?? 0;

            table.Data(
                ReportCell.Left(""),
                ReportCell.Left(""),
                new ReportCell((++sn).ToString(), Align.Center, 1, "sn-col"),
                new ReportCell(row.LoanAccountNo ?? "", Align.Left, 1, "loan-account"),
                ReportCell.Right(Money(row.TotalInterestAmount)),
                ReportCell.Right(Money(row.CommissionAmount)),
                ReportCell.Right(row.DateOnBs ?? ""));
        }

        table.SubTotal(
            grp.Key.MemberId ?? "", 4,
            memberInterestTotal.ToString("N2"),
            memberCommissionTotal.ToString("N2"),
            "");
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 4, totalInterestAmount.ToString("N2"), totalCommissionAmount.ToString("N2"), "");
        table.Total($"Total Members: {totalMembers}  |  Total Records: {totalRecords}", ColumnCount);
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())