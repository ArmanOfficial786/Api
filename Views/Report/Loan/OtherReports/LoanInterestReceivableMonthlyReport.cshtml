@* Views/Report/Loan/OtherReports/LoanInterestReceivableMonthlyReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanInterestReceivableMonthlyRowDto>) ?? new List<LoanInterestReceivableMonthlyRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalInterestAmount = Model["TotalInterestAmount"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);

    // Grouped by Loan Type: an underlined label line, then a numbered list of
    // members holding a loan of that type, then a subtotal repeating the loan
    // type name. Matches the image exactly — every value shown (MemberId,
    // FullName, LoanAccountNo, LoanTypeName, InterestAmount) comes straight
    // from the SP's own output columns, nothing pulled from another table.
    // Rows must arrive pre-sorted by LoanTypeName (SP's own "order by
    // LoanAccountNo" default won't group types contiguously unless the
    // caller's OrderBy is set to group by type — see note below) since
    // GroupBy preserves first-seen order, not sorted order.
    var loanTypeGroups = rows
        .GroupBy(r => r.LoanTypeName ?? "")
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Interest Receivable Monthly Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .report-title {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px 4px 6px;
            }

            /* Own auto-layout table for the subheader so labels never wrap or
                           overlap — same fix applied throughout this thread. */
            .meta-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 6px;
            }

                .meta-table td {
                    padding: 3px 6px;
                    font-size: 9pt;
                    white-space: nowrap;
                    vertical-align: top;
                }

            .meta-spacer td {
                height: 10px;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

                .data-table th {
                    border-top: none;
                    border-bottom: 1px solid #000;
                    text-align: left;
                    white-space: normal;
                    font-weight: bold;
                }

            /* Loan Type section label, underlined like the image */
            .loantype-label-row td {
                padding-top: 10px;
                padding-bottom: 2px;
            }

            .loantype-label {
                font-weight: bold;
                text-decoration: underline;
            }

            .detail-row td {
                border-bottom: none;
            }

            .sn-col {
                text-align: left;
            }

            /* Per-loan-type subtotal — repeats the loan type name under the
                           "Loanee Details" column, right-aligned, matching the image. */
            .group-total-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 3px;
                padding-bottom: 6px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">Loan Interest Receivable Monthly Report</div>

        <table class="meta-table">
            <tr>
                <td><strong>Branch Name:</strong> @branchName</td>
            </tr>
            @if (isMemberGroupFiltered)
            {
                <tr>
                    <td><strong>Member Group :</strong> @memberGroupName</td>
                </tr>
            }
            <tr class="meta-spacer"><td></td></tr>
            <tr>
                <td><strong>From Date:</strong> @tillDate</td>
            </tr>
            <tr>
                <td><strong>Report Generated On:</strong> @generatedOn</td>
            </tr>
            <tr class="meta-spacer"><td></td></tr>
        </table>

        <table class="data-table" data-sheet-name="LoanInterestReceivableMonthly">
            <colgroup>
                <col style="width:6%;" />
                <col style="width:14%;" />
                <col style="width:26%;" />
                <col style="width:34%;" />
                <col style="width:20%;" />
            </colgroup>
            <tbody>
                <tr>
                    <th>S.No</th>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Loanee Details</th>
                    <th class="text-right">Interest Receivable</th>
                </tr>

                @if (loanTypeGroups.Any())
                {
                    foreach (var grp in loanTypeGroups)
                    {
                        <tr class="loantype-label-row">
                            <td colspan="5"><span class="loantype-label">@grp.Key</span></td>
                        </tr>

                        var sn = 0;
                        var groupTotal = 0m;
                        foreach (var row in grp)
                        {
                            sn++;
                            groupTotal += row.InterestAmount ?? 0;
                            <tr class="detail-row">
                                <td class="sn-col">@sn</td>
                                <td>@(row.MemberId ?? "")</td>
                                <td>@(row.FullName ?? "")</td>
                                <td>@(row.LoanAccountNo ?? "")</td>
                                <td class="text-right">@(row.InterestAmount.HasValue ? row.InterestAmount.Value.ToString("N2") : "0.00")</td>
                            </tr>
                        }

                        <tr class="group-total-row">
                            <td colspan="3"></td>
                            <td class="text-right">@grp.Key</td>
                            <td class="text-right">@groupTotal.ToString("N2")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Grand Total</td>
                        <td class="text-right">@totalInterestAmount.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>