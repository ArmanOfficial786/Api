@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 9;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<MaturedLoanRowDto>) ?? new List<MaturedLoanRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var memberName = Text("MemberName");
    var memberGroupName = Text("MemberGroupName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.FullName, r.MobileNo, r.Addess })
        .ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalMembers = (int)TotalOr("TotalMembers", memberGroups.Count);
    var totalLoanIssueAmount = TotalOr("TotalLoanIssueAmount", rows.Sum(r => r.LoanIssueAmount ?? 0));
    var totalPrincipleDue = TotalOr("TotalPrincipleDue", rows.Sum(r => r.PrincipleDue ?? 0));
    var totalInterestDue = TotalOr("TotalInterestDue", rows.Sum(r => r.InterestDue ?? 0));
    var totalDueAmount = TotalOr("TotalDueAmount", rows.Sum(r => r.TotalDueAmount ?? 0));

    var table = new ReportTable(Model, title: "Matured Loan Report", sheetName: "MaturedLoan")
        .Column("Member Info/ A/C No", 14)
        .Column("Loan Type", 13)
        .Column("Issue Date", 11)
        .Column("Maturity Date", 11)
        .Column("Rate", 7, Align.Right)
        .Column("Disburse Amt", 12, Align.Right)
        .Column("Principle Due", 11, Align.Right)
        .Column("Interest Due", 11, Align.Right)
        .Column("Due Balance", 10, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 9, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-group td { border-top: 1px solid #000; border-bottom: 0; padding-top: 6px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }\n" +
            ".loan-account { color: #1F5C99; padding-left: 14px !important; }\n" +
            ".loan-type { color: #1F5C99; }");

    if (!string.IsNullOrEmpty(memberName))
    {
        table.MetaRow(Fmt.Labeled("Member :", memberName));
        table.MetaRow(Fmt.Labeled("Branch :", branchName));
    }
    else
    {
        table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
        table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("Till Date :", toDate)));
    }
    if (!string.IsNullOrEmpty(memberGroupName)) table.MetaRow(Fmt.Labeled("Member Group :", memberGroupName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var grp in memberGroups)
    {
        table.GroupBy(
            ReportCell.Left(grp.Key.MemberId ?? ""),
            ReportCell.Left(grp.Key.FullName ?? ""),
            ReportCell.Left(string.IsNullOrWhiteSpace(grp.Key.MobileNo) ? "-" : grp.Key.MobileNo),
            ReportCell.Left(string.IsNullOrWhiteSpace(grp.Key.Addess) ? "-" : grp.Key.Addess, ColumnCount - 3));

        foreach (var row in grp)
        {
            table.Data(
                new ReportCell(row.LoanAccountNo ?? "", Align.Left, 1, "loan-account"),
                new ReportCell(row.LoanTypeName ?? "", Align.Left, 1, "loan-type"),
                ReportCell.Left(row.LoanIssueDate ?? ""),
                ReportCell.Left(row.MaturityDate ?? ""),
                ReportCell.Right(Money(row.InterestRate)),
                ReportCell.Right(Money(row.LoanIssueAmount)),
                ReportCell.Right(Money(row.PrincipleDue)),
                ReportCell.Right(Money(row.InterestDue)),
                ReportCell.Right(Money(row.TotalDueAmount)));
        }
    }

    if (rows.Count > 0)
    {
        table.Total(
            "Grand Total", 5,
            totalLoanIssueAmount.ToString("N2"),
            totalPrincipleDue.ToString("N2"),
            totalInterestDue.ToString("N2"),
            totalDueAmount.ToString("N2"));
        table.Total($"Total Members: {totalMembers}  |  Total Loans: {totalRecords}", ColumnCount);
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())