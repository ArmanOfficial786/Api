@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<MaturedLoanRowDto>) ?? new List<MaturedLoanRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalMembers = Model.ContainsKey("TotalMembers") ? (Model["TotalMembers"] as int? ?? 0) : 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalPrincipleDue = Model.ContainsKey("TotalPrincipleDue") ? (Model["TotalPrincipleDue"] as decimal? ?? 0) : 0;
    var totalInterestDue = Model.ContainsKey("TotalInterestDue") ? (Model["TotalInterestDue"] as decimal? ?? 0) : 0;
    var totalDueAmount = Model["TotalDueAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberSearch = !string.IsNullOrEmpty(memberName);
    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);

    // --------------------------------------------------------------
    // Group by member for display, same as the legacy DevExpress
    // report (Member = group header band, loans underneath). Rows
    // sharing a MemberId are grouped together wherever they appear;
    // group order follows first appearance, so this matches the SQL
    // ORDER BY whenever that order keeps each member's loans together
    // (the default MemberId sort, and typically the others too).
    // --------------------------------------------------------------
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.FullName, r.MobileNo, r.Addess })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Matured Loan Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                text-align: left;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                word-wrap: break-word;
                overflow: hidden;
                line-height: 1.2;
                vertical-align: bottom;
            }

            /* Member group header row (Member Id / Name / Mobile / District) */
            .member-header-row td {
                border-top: 1px solid #000;
                padding-top: 6px;
                padding-bottom: 2px;
                font-weight: bold;
                white-space: nowrap;
            }

            /* Loan detail row, indented under its member header */
            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .loan-account, .loan-type {
                color: #1F5C99;
                padding-left: 14px;
            }

            .loan-type {
                padding-left: 6px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="MaturedLoan">
            <colgroup>
                <col style="width:14%;" />
                <col style="width:13%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:7%;" />
                <col style="width:12%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:10%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="9">Matured Loan Report</td>
                </tr>

                <!-- Metadata: stacked, left-aligned, matching the legacy report -->
                @if (isMemberSearch)
                {
                    <tr class="meta-row">
                        <td colspan="9"><strong>Member :</strong> @memberName</td>
                    </tr>
                    <tr class="meta-row">
                        <td colspan="9"><strong>Branch :</strong> @branchName</td>
                    </tr>
                }
                else
                {
                    <tr class="meta-row">
                        <td colspan="9"><strong>Branch Name :</strong> @branchName</td>
                    </tr>
                    <tr class="meta-row">
                        <td colspan="9">
                            <strong>From Date :</strong> @fromDate
                            &nbsp;&nbsp;&nbsp;&nbsp;
                            <strong>Till Date :</strong> @toDate
                        </td>
                    </tr>
                }
                @if (isMemberGroupFiltered)
                {
                    <tr class="meta-row">
                        <td colspan="9"><strong>Member Group :</strong> @memberGroupName</td>
                    </tr>
                }
                <tr class="meta-row">
                    <td colspan="9"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="9"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>Member Info/ A/C No</th>
                    <th>Loan Type</th>
                    <th>Issue Date</th>
                    <th>Maturity Date</th>
                    <th class="text-right">Rate</th>
                    <th class="text-right">Disburse Amt</th>
                    <th class="text-right">Principle Due</th>
                    <th class="text-right">Interest Due</th>
                    <th class="text-right">Due Balance</th>
                </tr>

                @if (memberGroups.Any())
                {
                    foreach (var grp in memberGroups)
                    {
                        <!-- Member group header band -->
                        <tr class="member-header-row">
                            <td>@(grp.Key.MemberId ?? "")</td>
                            <td>@(grp.Key.FullName ?? "")</td>
                            <td>@(string.IsNullOrWhiteSpace(grp.Key.MobileNo) ? "-" : grp.Key.MobileNo)</td>
                            <td>@(string.IsNullOrWhiteSpace(grp.Key.Addess) ? "-" : grp.Key.Addess)</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <!-- Loans belonging to this member -->
                        foreach (var row in grp)
                        {
                            <tr class="detail-row">
                                <td class="loan-account">@(row.LoanAccountNo ?? "")</td>
                                <td class="loan-type">@(row.LoanTypeName ?? "")</td>
                                <td>@(row.LoanIssueDate ?? "")</td>
                                <td>@(row.MaturityDate ?? "")</td>
                                <td class="text-right">@(row.InterestRate.HasValue ? row.InterestRate.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.PrincipleDue.HasValue ? row.PrincipleDue.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.InterestDue.HasValue ? row.InterestDue.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.TotalDueAmount.HasValue ? row.TotalDueAmount.Value.ToString("N2") : "")</td>
                            </tr>
                        }
                    }

                    <!-- Grand Total Row -->
                    <tr class="grand-total-row">
                        <td colspan="5" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalLoanIssueAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalPrincipleDue.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalInterestDue.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalDueAmount.ToString("N2")</strong></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="9" class="text-right">
                            <strong>Total Members: @totalMembers &nbsp;&nbsp;&nbsp; Total Loans: @totalRecords</strong>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
