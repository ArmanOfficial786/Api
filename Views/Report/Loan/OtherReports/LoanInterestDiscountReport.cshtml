@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<LoanInterestDiscountRowDto>) ?? new List<LoanInterestDiscountRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var memberName = Text("MemberName");
    var loanTypeName = Text("LoanTypeName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.CashReceived ?? 0));

    var table = new ReportTable(Model, title: "Loan Interest Discount Report", sheetName: "LoanInterestDiscount")
        .Column("S.No", 6)
        .Column("Transaction Date", 13)
        .Column("Member ID", 10)
        .Column("Member Name", 19)
        .Column("Loan A/C No.", 12)
        .Column("Loan Type", 15)
        .Column("Amount", 12, Align.Right)
        .Column("Operator", 13)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-total td { border-top: 1px solid #000; border-bottom: 0; padding-top: 6px; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    if (!string.IsNullOrEmpty(memberName)) table.MetaRow(Fmt.Labeled("Member :", memberName));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    if (!string.IsNullOrEmpty(loanTypeName)) table.MetaRow(Fmt.Labeled("Loan Type :", loanTypeName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            (++sn).ToString(),
            row.TransactionOnBs ?? "",
            row.MemberId ?? "",
            row.FullName ?? "",
            row.LoanAccountNo ?? "",
            row.LoanTypeName ?? "",
            (row.CashReceived ?? 0m).ToString("N2"),
            row.Operator ?? "");
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total:", 6, "Rs " + totalAmount.ToString("N2"), "");
        table.Total("Total Records", 7, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())