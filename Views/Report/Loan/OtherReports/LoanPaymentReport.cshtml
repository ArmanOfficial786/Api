@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 11;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";
    ReportCell LoanCell(string text, Align align = Align.Left, string extraClass = "") =>
        new ReportCell(text, align, 1, ("loan-cell " + extraClass).Trim());

    var rows = (Model["Rows"] as List<LoanPaymentRowDto>) ?? new List<LoanPaymentRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var memberGroupName = Text("MemberGroupName");
    var paymentBy = Text("PaymentBy");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isPaymentByFiltered = !string.IsNullOrEmpty(paymentBy) && !paymentBy.Equals("All", StringComparison.OrdinalIgnoreCase);

    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.FullName })
        .ToList();

    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.Amount ?? 0));

    var table = new ReportTable(Model, title: "Loan Payment Report", sheetName: "LoanPayment")
        .Column("Member Info", 9)
        .Column("", 14)
        .Column("Issue Date", 10)
        .Column("Duration", 8)
        .Column("Interest", 8)
        .Column("Issue Amount", 10, Align.Right)
        .Column("", 4, Align.Center)
        .Column("Pay Type", 10)
        .Column("Payment by", 10)
        .Column("ChequeNo", 9)
        .Column("Amount", 8, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 6px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-group td.loan-cell { font-weight: normal; padding-bottom: 1px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #ccc; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; padding-top: 4px; padding-bottom: 8px; }\n" +
            ".sn-col { color: #555; }\n" +
            ".loan-account { color: #1F5C99; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("Till Date :", toDate)));
    if (!string.IsNullOrEmpty(memberGroupName)) table.MetaRow(Fmt.Labeled("Member Group :", memberGroupName));
    if (isPaymentByFiltered) table.MetaRow(Fmt.Labeled("Payment By :", paymentBy));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var grp in memberGroups)
    {
        table.GroupBy(
            ReportCell.Left(grp.Key.MemberId ?? ""),
            ReportCell.Left(grp.Key.FullName ?? ""),
            ReportCell.Left("", ColumnCount - 2));

        var memberTotal = 0m;

        var loanGroups = grp
            .GroupBy(r => new { r.LoanAccountNo, r.LoanTypeName, r.IssueDateBS, r.Period, r.InteRate, r.LoanIssueAmount })
            .ToList();

        foreach (var loanGrp in loanGroups)
        {
            table.GroupBy(
                LoanCell(loanGrp.Key.LoanAccountNo ?? "", Align.Left, "loan-account"),
                LoanCell(loanGrp.Key.LoanTypeName ?? ""),
                LoanCell(loanGrp.Key.IssueDateBS ?? ""),
                LoanCell(loanGrp.Key.Period ?? ""),
                LoanCell(loanGrp.Key.InteRate ?? ""),
                LoanCell(Money(loanGrp.Key.LoanIssueAmount), Align.Right),
                new ReportCell("", Align.Left, 5, "loan-cell"));

            var sn = 0;
            foreach (var pay in loanGrp)
            {
                memberTotal += pay.Amount ?? 0;

                table.Data(
                    ReportCell.Left("", 6),
                    new ReportCell((++sn).ToString(), Align.Center, 1, "sn-col"),
                    ReportCell.Left(pay.PaymentBy ?? ""),
                    ReportCell.Left(pay.AccNoBank ?? ""),
                    ReportCell.Left(pay.ChequeNo ?? ""),
                    ReportCell.Right(Money(pay.Amount)));
            }
        }

        table.SubTotal("Total:", ColumnCount - 1, memberTotal.ToString("N2"));
    }

    if (rows.Count > 0)
        table.Total("Grand Total", ColumnCount - 1, totalAmount.ToString("N2"));
}
@await Html.PartialAsync("_SheetReport", table.Build())