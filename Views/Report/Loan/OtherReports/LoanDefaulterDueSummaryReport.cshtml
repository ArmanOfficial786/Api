@* Views/Report/Loan/OtherReports/LoanDefaulterDueSummaryReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanDefaulterDueSummaryRowDto>) ?? new List<LoanDefaulterDueSummaryRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalPrincipleAmount = Model["TotalPrincipleAmount"] as decimal? ?? 0;
    var totalInterest = Model["TotalInterest"] as decimal? ?? 0;
    var totalInstallmentAmount = Model["TotalInstallmentAmount"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    Func<decimal?, string> N = v => (v ?? 0m).ToString("N2");

    // Grouped by Member (MemberId + FullName + MobileNo + Address) — rows must arrive
    // pre-sorted by MemberId (see repository's default order) since GroupBy preserves
    // first-seen order, not sorted order.
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.FullName, r.MobileNo, r.TemporaryAddressDetail })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Defaulter - Due Summary</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            .report-title {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 0;
            }

            .meta-line {
                font-size: 9.5pt;
                padding: 3px 0;
            }

                .meta-line strong {
                    display: inline-block;
                }

            .filter-line {
                font-weight: bold;
                padding: 8px 0 4px 0;
                font-size: 9.5pt;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

                .data-table th {
                    border-top: 2px solid #000;
                    border-bottom: 1.5px solid #000;
                    text-align: left;
                    white-space: nowrap;
                    font-weight: bold;
                }

            .member-row td {
                font-weight: bold;
                padding-top: 10px;
                padding-bottom: 2px;
                border: none;
            }

            .member-row.first-group td {
                padding-top: 4px;
            }

            .detail-row td {
                border: none;
            }

            .subtotal-row td {
                border-top: 1px solid #000;
                font-weight: bold;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">Loan Defaulter - Due Summary</div>

        <div class="meta-line"><strong>Branch Name :</strong> &nbsp;&nbsp;@branchName</div>
        <div class="meta-line"><strong>Report Generated On :</strong> &nbsp;&nbsp;@generatedOn</div>
        <div class="filter-line">Filter By:- Tilldate: @tillDate</div>

        <table class="data-table" data-sheet-name="LoanDefaulterDueSummary">
            <colgroup>
                <col style="width:6%;" />
                <col style="width:12%;" />
                <col style="width:20%;" />
                <col style="width:10%;" />
                <col style="width:13%;" />
                <col style="width:13%;" />
                <col style="width:13%;" />
                <col style="width:8%;" />
            </colgroup>
            <tbody>
                <tr>
                    <th>S.N.</th>
                    <th>Loan A/C No</th>
                    <th>Loan Type</th>
                    <th>Date</th>
                    <th class="text-right">Principle</th>
                    <th class="text-right">Interest</th>
                    <th class="text-right">Installment</th>
                    <th class="text-right">Inst Cnt</th>
                </tr>

                @if (memberGroups.Any())
                {
                    var sn = 0;
                    var isFirstGroup = true;

                    foreach (var memberGroup in memberGroups)
                    {
                        var memberRows = memberGroup.ToList();

                        <tr class="member-row @(isFirstGroup ? "first-group" : "")">
                            <td></td>
                            <td colspan="2">@memberGroup.Key.MemberId &nbsp;&nbsp; @memberGroup.Key.FullName</td>
                            <td colspan="5">@(memberGroup.Key.MobileNo ?? "") &nbsp;&nbsp; @(memberGroup.Key.TemporaryAddressDetail ?? "")</td>
                        </tr>
                        isFirstGroup = false;

                        foreach (var row in memberRows)
                        {
                            sn++;
                            <tr class="detail-row">
                                <td>@sn</td>
                                <td>@(row.LoanAccountNo ?? "")</td>
                                <td>@(row.LoanTypeName ?? "")</td>
                                <td>@(row.DateOnBS ?? "")</td>
                                <td class="text-right">@N(row.PrincipleAmount)</td>
                                <td class="text-right">@N(row.Interest)</td>
                                <td class="text-right">@N(row.InstallamentAmount)</td>
                                <td class="text-right">@(row.InstallmentCount?.ToString() ?? "")</td>
                            </tr>
                        }

                        <tr class="subtotal-row">
                            <td colspan="4"></td>
                            <td class="text-right">@N(memberRows.Sum(r => r.PrincipleAmount ?? 0))</td>
                            <td class="text-right">@N(memberRows.Sum(r => r.Interest ?? 0))</td>
                            <td class="text-right">@N(memberRows.Sum(r => r.InstallamentAmount ?? 0))</td>
                            <td></td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right">Grand Total</td>
                        <td class="text-right">@totalPrincipleAmount.ToString("N2")</td>
                        <td class="text-right">@totalInterest.ToString("N2")</td>
                        <td class="text-right">@totalInstallmentAmount.ToString("N2")</td>
                        <td></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="7" class="text-right">Total Records</td>
                        <td class="text-center">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>