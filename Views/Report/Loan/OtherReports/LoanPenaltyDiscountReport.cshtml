@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<LoanPenaltyDiscountRowDto>) ?? new List<LoanPenaltyDiscountRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var memberName = Text("MemberName");
    var loanTypeName = Text("LoanTypeName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.CashReceived ?? 0));

    var table = new ReportTable(Model, title: "Loan Penalty Discount Report", sheetName: "LoanPenaltyDiscount")
        .Column("Member Id", 10)
        .Column("Member Name", 18)
        .Column("Loan A/c No", 14)
        .Column("Loan Type", 14)
        .Column("Transaction Date", 12)
        .Column("Operator", 16)
        .Column("Amount", 16, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = true,
            ZebraBackground = "#f9f9f9",
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; }");

    if (!string.IsNullOrEmpty(memberName))
        table.MetaRow(Fmt.Labeled("Member :", memberName), Fmt.Labeled("Branch :", branchName), 4);
    else
        table.MetaRow(Fmt.Labeled("Branch Name :", branchName), Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)), 4);

    if (!string.IsNullOrEmpty(loanTypeName)) table.MetaRow(Fmt.Labeled("Loan Type :", loanTypeName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var row in rows)
    {
        table.Data(
            row.MemberId ?? "",
            row.FullName ?? "",
            row.LoanAccountNo ?? "",
            row.LoanTypeName ?? "",
            row.TransactionOnBs ?? "",
            row.Operator ?? "",
            Money(row.CashReceived));
    }

    if (rows.Count > 0)
        table.Total("Grand Total", 6, totalAmount.ToString("N2"));
}
@await Html.PartialAsync("_SheetReport", table.Build())