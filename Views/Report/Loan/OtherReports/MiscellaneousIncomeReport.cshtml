@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanMiscellaneousIncomeRowDto>) ?? new List<LoanMiscellaneousIncomeRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);

    // Grouped by Member, then by Loan A/C No within each member — matches the
    // image's nested structure exactly (Member Id/Name shown once per member,
    // A/C No shown once per account, with numbered line items 1, 2, 3...
    // restarting for each account). Rows must arrive pre-sorted so a member's
    // rows — and within them, an account's rows — are contiguous, since
    // GroupBy preserves first-seen order rather than sorting.
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.MemberName })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Miscellaneous Income Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .report-title {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 6px;
            }

                .meta-table td {
                    padding: 3px 6px;
                    font-size: 9pt;
                    white-space: nowrap;
                    vertical-align: top;
                }

            .meta-spacer td {
                height: 14px;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: top;
                }

                .data-table th {
                    text-align: left;
                    font-weight: bold;
                    border-top: none;
                    border-bottom: 1.5px solid #000;
                    padding: 6px 6px 8px 6px;
                }

            .member-row td {
                padding-top: 10px;
                padding-bottom: 2px;
            }

            .account-row td {
                border-top: 1px solid #000;
                padding-top: 4px;
                padding-bottom: 2px;
            }

            .line-item-row td {
                padding: 1px 6px;
                border: none;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-title">Miscellaneous Income Report</div>

        <table class="meta-table">
            <tr>
                <td><strong>Branch Name:</strong> @branchName</td>
            </tr>
            @if (isMemberGroupFiltered)
            {
                <tr>
                    <td><strong>Member Group :</strong> @memberGroupName</td>
                </tr>
            }
            <tr class="meta-spacer"><td></td></tr>
            <tr>
                <td><strong>Report Generated On:</strong> @generatedOn</td>
            </tr>
            <tr class="meta-spacer"><td></td></tr>
        </table>

        <table class="data-table" data-sheet-name="MiscellaneousIncome">
            <colgroup>
                <col style="width:12%;" />
                <col style="width:16%;" />
                <col style="width:5%;" />
                <col style="width:14%;" />
                <col style="width:22%;" />
                <col style="width:16%;" />
                <col style="width:15%;" />
            </colgroup>
            <tbody>
                <tr>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th></th>
                    <th>A/C No</th>
                    <th>Particulars</th>
                    <th>Type</th>
                    <th class="text-right">Amount</th>
                </tr>

                @if (memberGroups.Any())
                {
                    foreach (var member in memberGroups)
                    {
                        <tr class="member-row">
                            <td>@(member.Key.MemberId ?? "")</td>
                            <td colspan="6">@(member.Key.MemberName ?? "")</td>
                        </tr>

                        var accountGroups = member
                            .GroupBy(r => r.LoanAccountNo)
                            .ToList();

                        foreach (var account in accountGroups)
                        {
                            <tr class="account-row">
                                <td colspan="3"></td>
                                <td colspan="4">@(account.Key ?? "")</td>
                            </tr>

                            var lineNo = 0;
                            foreach (var row in account)
                            {
                                lineNo++;
                                <tr class="line-item-row">
                                    <td></td>
                                    <td></td>
                                    <td>@lineNo</td>
                                    <td></td>
                                    <td>@(row.TypeName ?? "")</td>
                                    <td>@(row.Type ?? "")</td>
                                    <td class="text-right">@(row.Amount.HasValue ? row.Amount.Value.ToString("N2") : "0.00")</td>
                                </tr>
                            }
                        }
                    }

                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Grand Total</td>
                        <td class="text-right">@totalAmount.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>