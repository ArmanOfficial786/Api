@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 7;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<LoanMiscellaneousIncomeRowDto>) ?? new List<LoanMiscellaneousIncomeRowDto>();

    var branchName = Text("BranchName", "All");
    var memberGroupName = Text("MemberGroupName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.MemberName })
        .ToList();

    var totalAmount = TotalOr("TotalAmount", rows.Sum(r => r.Amount ?? 0));

    var table = new ReportTable(Model, title: "Miscellaneous Income Report", sheetName: "MiscellaneousIncome")
        .Column("Member Id", 12)
        .Column("Member Name", 16)
        .Column("", 5)
        .Column("A/C No", 14)
        .Column("Particulars", 22)
        .Column("Type", 16)
        .Column("Amount", 15, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5.5, headerMm: 9, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; border-bottom: 1.5px solid #000; padding: 6px 6px 8px 6px; }\n" +
            "table.sheet-table tr.r-group td { font-weight: normal; border-top: 0; border-bottom: 0; padding-top: 10px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-group td.account-cell { border-top: 1px solid #000; padding-top: 4px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    if (!string.IsNullOrEmpty(memberGroupName)) table.MetaRow(Fmt.Labeled("Member Group :", memberGroupName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var member in memberGroups)
    {
        table.GroupBy(
            ReportCell.Left(member.Key.MemberId ?? ""),
            ReportCell.Left(member.Key.MemberName ?? "", ColumnCount - 1));

        var accountGroups = member
            .GroupBy(r => r.LoanAccountNo)
            .ToList();

        foreach (var account in accountGroups)
        {
            table.GroupBy(
                new ReportCell("", Align.Left, 3, "account-cell"),
                new ReportCell(account.Key ?? "", Align.Left, ColumnCount - 3, "account-cell"));

            var lineNo = 0;
            foreach (var row in account)
            {
                table.Data(
                    "",
                    "",
                    (++lineNo).ToString(),
                    "",
                    row.TypeName ?? "",
                    row.Type ?? "",
                    (row.Amount ?? 0m).ToString("N2"));
            }
        }
    }

    if (rows.Count > 0)
        table.Total("Grand Total", ColumnCount - 1, totalAmount.ToString("N2"));
}
@await Html.PartialAsync("_SheetReport", table.Build())