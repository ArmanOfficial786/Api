@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 5;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<LoanInterestReceivableYearEndRowDto>) ?? new List<LoanInterestReceivableYearEndRowDto>();

    var asOnDate = Text("AsOnDate");
    var branchName = Text("BranchName", "All");
    var memberGroupName = Text("MemberGroupName");
    var selectType = Text("SelectType", "As");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var dateLabel = selectType switch
    {
        "Monthly" => "As on Month End",
        "Yearly" => "As on Year End",
        _ => "From Date"
    };

    var loanTypeGroups = rows
        .GroupBy(r => r.LoanTypeName)
        .ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalInterestAmount = TotalOr("TotalInterestAmount", rows.Sum(r => r.InterestAmount ?? 0));

    var table = new ReportTable(Model, title: "Loan Interest Receivable (Year-End) Report", sheetName: "LoanInterestReceivableYearEnd")
        .Column("S.No", 6)
        .Column("Member Id", 14)
        .Column("Member Name", 26)
        .Column("Loanee Details", 34)
        .Column("Interest Receivable", 20, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 70)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 10px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #000; padding-top: 4px; padding-bottom: 8px; }\n" +
            ".sn-col { color: #555; }\n" +
            ".loantype-label { font-weight: bold; text-decoration: underline; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Labeled(dateLabel + " :", asOnDate));
    if (!string.IsNullOrEmpty(memberGroupName)) table.MetaRow(Fmt.Labeled("Member Group :", memberGroupName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var grp in loanTypeGroups)
    {
        table.GroupBy(new ReportCell(grp.Key ?? "", Align.Left, ColumnCount, "loantype-label"));

        var sn = 0;
        var groupTotal = 0m;
        foreach (var row in grp)
        {
            groupTotal += row.InterestAmount ?? 0;

            table.Data(
                new ReportCell((++sn).ToString(), Align.Center, 1, "sn-col"),
                ReportCell.Left(row.MemberId ?? ""),
                ReportCell.Left(row.FullName ?? ""),
                ReportCell.Left(row.LoanAccountNo ?? ""),
                ReportCell.Right(Money(row.InterestAmount)));
        }

        table.SubTotal(grp.Key ?? "", ColumnCount - 1, groupTotal.ToString("N2"));
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", ColumnCount - 1, totalInterestAmount.ToString("N2"));
        table.Total($"Total Records: {totalRecords}", ColumnCount);
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())