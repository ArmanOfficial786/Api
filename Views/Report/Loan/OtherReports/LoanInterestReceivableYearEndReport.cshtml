@* Views/Report/Loan/OtherReports/LoanInterestReceivableYearEndReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanInterestReceivableYearEndRowDto>) ?? new List<LoanInterestReceivableYearEndRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalInterestAmount = Model["TotalInterestAmount"] as decimal? ?? 0;
    var asOnDate = Model["AsOnDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var selectType = Model["SelectType"]?.ToString() ?? "As";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);
    var dateLabel = selectType switch
    {
        "Monthly" => "As on Month End",
        "Yearly" => "As on Year End",
        _ => "From Date"
    };

    // Grouped by Loan Type: a label line, then a numbered list of members
    // holding that loan type, then a subtotal for that loan type.
    var loanTypeGroups = rows
        .GroupBy(r => r.LoanTypeName)
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Interest Receivable (Year-End) Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                text-align: left;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
            }

            /* Loan Type section label, underlined like the legacy report */
            .loantype-label-row td {
                padding-top: 10px;
                padding-bottom: 2px;
            }

            .loantype-label {
                font-weight: bold;
                border-bottom: 1px solid #000;
                padding-bottom: 2px;
                display: inline-block;
            }

            /* Loan rows under a loan type, numbered */
            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .sn-col {
                text-align: center;
                color: #555;
            }

            /* Per-loan-type subtotal */
            .group-total-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 4px;
                padding-bottom: 8px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanInterestReceivableYearEnd">
            <colgroup>
                <col style="width:6%;" />
                <col style="width:14%;" />
                <col style="width:26%;" />
                <col style="width:34%;" />
                <col style="width:20%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="5">Loan Interest Receivable (Year-End) Report</td>
                </tr>

                <!-- Metadata: stacked, left-aligned -->
                <tr class="meta-row">
                    <td colspan="5"><strong>Branch Name :</strong> @branchName</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="5"><strong>@dateLabel :</strong> @asOnDate</td>
                </tr>
                @if (isMemberGroupFiltered)
                {
                    <tr class="meta-row">
                        <td colspan="5"><strong>Member Group :</strong> @memberGroupName</td>
                    </tr>
                }
                <tr class="meta-row">
                    <td colspan="5"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="5"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>S.No</th>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Loanee Details</th>
                    <th class="text-right">Interest Receivable</th>
                </tr>

                @if (loanTypeGroups.Any())
                {
                    foreach (var grp in loanTypeGroups)
                    {
                        <!-- Loan Type section label -->
                        <tr class="loantype-label-row">
                            <td colspan="5"><span class="loantype-label">@(grp.Key ?? "")</span></td>
                        </tr>

                        <!-- Members holding this loan type, numbered -->
                        var sn = 0;
                        var groupTotal = 0m;
                        foreach (var row in grp)
                        {
                            sn++;
                            groupTotal += row.InterestAmount ?? 0;
                            <tr class="detail-row">
                                <td class="sn-col">@sn</td>
                                <td>@(row.MemberId ?? "")</td>
                                <td>@(row.FullName ?? "")</td>
                                <td>@(row.LoanAccountNo ?? "")</td>
                                <td class="text-right">@(row.InterestAmount.HasValue ? row.InterestAmount.Value.ToString("N2") : "")</td>
                            </tr>
                        }

                        <!-- Per-loan-type subtotal -->
                        <tr class="group-total-row">
                            <td colspan="3"></td>
                            <td class="text-right">@(grp.Key ?? "")</td>
                            <td class="text-right">@groupTotal.ToString("N2")</td>
                        </tr>
                    }

                    <!-- Report-level grand total -->
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalInterestAmount.ToString("N2")</strong></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="5" class="text-right"><strong>Total Records: @totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>