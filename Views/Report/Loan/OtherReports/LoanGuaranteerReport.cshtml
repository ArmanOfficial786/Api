@* Views/Report/Loan/OtherReports/LoanGuaranteerReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanGuaranteerRowDto>) ?? new List<LoanGuaranteerRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalGuaranteeAmount = Model["TotalGuaranteeAmount"] as decimal? ?? 0;
    var totalGuaranteeShareAmount = Model["TotalGuaranteeShareAmount"] as decimal? ?? 0;
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var memberId = Model["MemberId"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Guaranteer Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                text-align: left;
            }

            .section-label td {
                padding: 8px 6px 2px 6px;
                font-size: 9pt;
                font-weight: bold;
            }

            .guarantor-row td {
                padding: 2px 6px 8px 6px;
                font-size: 9pt;
                font-weight: bold;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .amount-col {
                color: #1F5C99;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanGuaranteer">
            <colgroup>
                <col style="width:15%;" />
                <col style="width:17%;" />
                <col style="width:12%;" />
                <col style="width:13%;" />
                <col style="width:16%;" />
                <col style="width:16%;" />
                <col style="width:12%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="7">Loan Guaranteer Report</td>
                </tr>

                <!-- Metadata: stacked, left-aligned -->
                <tr class="meta-row">
                    <td colspan="7"><strong>Branch Name :</strong> @branchName</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="7"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <!-- Guarantor block -->
                <tr class="section-label">
                    <td colspan="7">Guarantee Details :</td>
                </tr>
                <tr class="guarantor-row">
                    <td>@memberId</td>
                    <td colspan="6">@memberName</td>
                </tr>

                @if (rows.Any())
                {
                    <!-- Loanee list section label -->
                    <tr class="section-label">
                        <td colspan="7">Loanee Details :</td>
                    </tr>

                    <!-- Table Header -->
                    <tr>
                        <th>Loanee Id</th>
                        <th>Loanee Name</th>
                        <th>Loan A/C No</th>
                        <th>Savings A/C No</th>
                        <th class="text-right">Savings Amt</th>
                        <th class="text-right">Share Amt</th>
                        <th>Guarantee Date</th>
                    </tr>

                    foreach (var row in rows)
                    {
                        <tr class="detail-row">
                            <td>@(row.LoneeId ?? "")</td>
                            <td>@(row.LoneeFullName ?? "")</td>
                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.AccountNo ?? "")</td>
                            <td class="text-right amount-col">@(row.GuaranteeAmount.HasValue ? row.GuaranteeAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right amount-col">@(row.GuaranteeShareAmount.HasValue ? row.GuaranteeShareAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right amount-col">@(row.GuaranteeDateOnBs ?? "")</td>
                        </tr>
                    }

                    <!-- Grand Total Row -->
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalGuaranteeAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalGuaranteeShareAmount.ToString("N2")</strong></td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>