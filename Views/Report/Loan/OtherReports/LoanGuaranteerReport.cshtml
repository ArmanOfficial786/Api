@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 7;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<LoanGuaranteerRowDto>) ?? new List<LoanGuaranteerRowDto>();

    var branchName = Text("BranchName", "All");
    var memberName = Text("MemberName");
    var memberId = Text("MemberId");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalGuaranteeAmount = TotalOr("TotalGuaranteeAmount", rows.Sum(r => r.GuaranteeAmount ?? 0));
    var totalGuaranteeShareAmount = TotalOr("TotalGuaranteeShareAmount", rows.Sum(r => r.GuaranteeShareAmount ?? 0));

    var table = new ReportTable(Model, title: "Loan Guaranteer Report", sheetName: "LoanGuaranteer")
        .Column("Loanee Id", 15)
        .Column("Loanee Name", 17)
        .Column("Loan A/C No", 12)
        .Column("Savings A/C No", 13)
        .Column("Savings Amt", 16, Align.Right)
        .Column("Share Amt", 16, Align.Right)
        .Column("Guarantee Date", 12)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-group td { border-top: 0; border-bottom: 0; padding-top: 6px; padding-bottom: 2px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }\n" +
            ".amount-col { color: #1F5C99; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    table.GroupTitle("Guarantee Details :");
    table.GroupBy(
        ReportCell.Left(memberId),
        ReportCell.Left(memberName, ColumnCount - 1));

    if (rows.Count > 0)
    {
        table.GroupTitle("Loanee Details :");
        table.Header("Loanee Id", "Loanee Name", "Loan A/C No", "Savings A/C No", "Savings Amt", "Share Amt", "Guarantee Date");

        foreach (var row in rows)
        {
            table.Data(
                ReportCell.Left(row.LoneeId ?? ""),
                ReportCell.Left(row.LoneeFullName ?? ""),
                ReportCell.Left(row.LoanAccountNo ?? ""),
                ReportCell.Left(row.AccountNo ?? ""),
                new ReportCell(Money(row.GuaranteeAmount), Align.Right, 1, "amount-col"),
                new ReportCell(Money(row.GuaranteeShareAmount), Align.Right, 1, "amount-col"),
                new ReportCell(row.GuaranteeDateOnBs ?? "", Align.Right, 1, "amount-col"));
        }

        table.Total("Grand Total", 4, totalGuaranteeAmount.ToString("N2"), totalGuaranteeShareAmount.ToString("N2"), "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())