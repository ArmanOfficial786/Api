@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    var rows = (Model["Rows"] as List<LoanFollowUpRowDto>) ?? new List<LoanFollowUpRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var memberName = Text("MemberName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Loan Follow Up Report", sheetName: "LoanFollowUp")
        .Column("Member Id", 9)
        .Column("Member Name", 14)
        .Column("Loan A/C No.", 9)
        .Column("FollowUp Date", 9)
        .Column("Follow Up Person", 13)
        .Column("Description", 21)
        .Column("Follow Up By", 13)
        .Column("Entry Date", 12)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#d9d9d9"
        })
        .Sizing(rowMm: 8, headerMm: 9, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 3px 6px; border: 1px solid #000; vertical-align: top; }");

    if (!string.IsNullOrEmpty(memberName))
    {
        table.MetaRow(Fmt.Labeled("Member :", memberName), Fmt.Labeled("Branch Name :", branchName));
    }
    else
    {
        table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
        table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    }
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var row in rows)
    {
        table.Data(
            row.MemberId ?? "",
            row.MemberName ?? "",
            row.LoanAccountNo ?? "",
            row.FollowUpDateOnBs ?? "",
            row.FollowUpPerson ?? "",
            row.Description ?? "",
            row.FollowUpBy ?? "",
            row.CreatedOnBs ?? "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())