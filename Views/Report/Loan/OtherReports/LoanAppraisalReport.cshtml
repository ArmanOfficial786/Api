@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 4;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;

    ReportCell Label(string text) => new ReportCell(text, Align.Left, 1, "info-label");
    ReportCell Value(string text) => new ReportCell(text, Align.Left, 1, "info-value");
    ReportCell Line(string text) => new ReportCell(text, Align.Left, ColumnCount, "form-line");

    var rows = (Model["Rows"] as List<LoanAppraisalRowDto>) ?? new List<LoanAppraisalRowDto>();
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Loan Appraisal Report", sheetName: "LoanAppraisal")
        .Column("", 14)
        .Column("", 36)
        .Column("", 14)
        .Column("", 36)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            GroupBackground = "#fff"
        })
        .Sizing(rowMm: 9, firstPageExtraMm: 55)
        .Css(
            "table.sheet-table tr.r-group td, table.sheet-table tr.r-data td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 4px 8px; }\n" +
            "table.sheet-table tr.r-group td.info-label, table.sheet-table tr.r-group td.info-value, " +
            "table.sheet-table tr.r-data td.info-label, table.sheet-table tr.r-data td.info-value " +
            "{ border: 1px solid #000; }\n" +
            "table.sheet-table tr.r-group td.info-label, table.sheet-table tr.r-data td.info-label { font-weight: bold; }\n" +
            "table.sheet-table tr.r-group td.info-value, table.sheet-table tr.r-data td.info-value { font-weight: normal; }\n" +
            "table.sheet-table tr.r-data td.form-line " +
            "{ font-weight: bold; height: 10mm; vertical-align: bottom; border-bottom: 1px solid #000; }\n" +
            "table.sheet-table tr.r-spacer { height: 6mm; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var row in rows)
    {
        table.GroupBy(
            Label("MemberId"),
            Value(row.MemberId ?? ""),
            Label("Member Name"),
            Value(row.FullName ?? ""));

        table.Data(
            Label("Account No"),
            Value(row.LoanAccountNo ?? ""),
            Label("Loan Type"),
            Value(row.LoanTypeName ?? ""));

        table.Data(
            Label("Collateral"),
            Value(row.CollateralName ?? ""),
            Label("Collateral Value"),
            Value(row.CollateralAmount.HasValue ? row.CollateralAmount.Value.ToString("N2") : ""));

        table.Data(
            Label("Collateral Status"),
            Value(row.CollateralCondition ?? ""),
            Label("Collateral Quantity"),
            Value(row.CollateralQuantity ?? ""));

        table.Data(Line("Checked By:"));
        table.Data(Line($"Capacity: {row.CapacityToPay ?? ""}"));
        table.Data(Line($"Character: {row.LoanerCharacter ?? ""}"));
        table.Data(Line($"Capital: {row.Capital ?? ""}"));
        table.Data(Line("Condition:"));
        table.Data(Line($"Decision: {row.ManagerialDecision ?? ""}"));

        table.Spacer();
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())