@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<LoanRepaymentRowDto>) ?? new List<LoanRepaymentRowDto>();

    var branchName = Text("BranchName", "All");
    var memberName = Text("MemberName");
    var memberId = Text("MemberId");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalLoanIssueAmount = TotalOr("TotalLoanIssueAmount", rows.Sum(r => r.LoanIssueAmount ?? 0));
    var totalPrincipleBalance = TotalOr("TotalPrincipleBalance", rows.Sum(r => r.PrincipleBalance ?? 0));

    var table = new ReportTable(Model, title: "Loan Repayment Account Details Report", sheetName: "LoanRepayment")
        .Column("MemberId", 9)
        .Column("Name", 13)
        .Column("Loan A/C No", 10)
        .Column("Issue Amt", 9, Align.Right)
        .Column("Issue Date", 9)
        .Column("Maturity Date", 10)
        .Column("Int Rate", 8, Align.Right)
        .Column("Pri Balance", 10, Align.Right)
        .Column("Saving A/C", 11)
        .Column("A/C Status", 11)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #000; }");

    if (!string.IsNullOrEmpty(memberName))
        table.MetaRow(Fmt.Labeled("Member :", $"{memberName} ({memberId})"));
    else
        table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var row in rows)
    {
        table.Data(
            ReportCell.Left(row.MemberId ?? ""),
            ReportCell.Left(row.FullName ?? ""),
            ReportCell.Left(row.LoanAccountNo ?? ""),
            ReportCell.Right(Money(row.LoanIssueAmount)),
            ReportCell.Left(row.LoanIssueOnBs ?? ""),
            ReportCell.Left(row.MaturityOnBs ?? ""),
            ReportCell.Right(Money(row.InterestRate)),
            ReportCell.Right(Money(row.PrincipleBalance)),
            ReportCell.Left(row.AccountNo ?? ""),
            ReportCell.Right(row.AccountStatus ?? ""));
    }

    if (rows.Count > 0)
    {
        table.Total(
            "Grand Total", 3,
            totalLoanIssueAmount.ToString("N2"),
            "", "", "",
            totalPrincipleBalance.ToString("N2"),
            "", "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())