@* Views/Report/Loan/LoanAnalysisReport/LoanAllDetailsReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanAllDetailsRowDto>) ?? new List<LoanAllDetailsRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalRemainingPrinciple = Model["TotalRemainingPrinciple"] as decimal? ?? 0;
    var totalDefaultPrinciple = Model["TotalDefaultPrinciple"] as decimal? ?? 0;
    var totalCurrInterest = Model["TotalCurrInterest"] as decimal? ?? 0;
    var totalCurrPenalty = Model["TotalCurrPenalty"] as decimal? ?? 0;
    var totalDue = Model["TotalDue"] as decimal? ?? 0;
    var totalRemaining = Model["TotalRemaining"] as decimal? ?? 0;
    var totalProvisionAmount = Model["TotalProvisionAmount"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var loanTypeName = Model["LoanTypeName"]?.ToString() ?? "";
    var statusName = Model["StatusName"]?.ToString() ?? "All";
    var enableCollectionCenter = Model["EnableCollectionCenter"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);
    var isCollectionCenterFiltered = !string.IsNullOrEmpty(collectionCenterName);
    var isCollectorFiltered = !string.IsNullOrEmpty(collectorName);
    var isLoanTypeFiltered = !string.IsNullOrEmpty(loanTypeName);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Detail Report</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 7pt;
            background: white;
            color: #000;
        }

        .report-container {
            width: 100%;
            overflow: visible;
        }

        thead {
            display: table-row-group;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 7pt;
            table-layout: fixed;
        }

        .data-table td, .data-table th {
            word-wrap: break-word;
            overflow-wrap: break-word;
            padding: 2px 3px;
            vertical-align: middle;
        }

        .meta-title td {
            text-align: center;
            font-family: "Times New Roman", Times, serif;
            font-size: 14pt;
            font-weight: bold;
            text-decoration: underline;
            padding: 8px 6px;
        }

        .meta-row td {
            padding: 3px 6px;
            font-size: 8pt;
        }

        .meta-spacer td {
            height: 6px;
        }

        .data-table th {
            background: #f9f9f9;
            border-top: 2px solid #000;
            border-bottom: 1px solid #000;
            text-align: left;
            white-space: nowrap;
        }

        .detail-row td {
            border-bottom: 1px solid #eee;
        }

        .detail-row-alt td {
            background: #f9f9f9;
            border-bottom: 1px solid #eee;
        }

        .grand-total-row td {
            border-top: 2px solid #000;
            border-bottom: 2px solid #000;
            font-weight: bold;
            background: #f9f9f9;
            padding: 5px 6px;
        }

        .collection-center-header td {
            background: #e8f0f8;
            font-weight: bold;
            padding: 4px 6px;
            border-top: 2px solid #000;
            border-bottom: 1px solid #000;
        }

        .text-right {
            text-align: right !important;
        }

        .text-center {
            text-align: center !important;
        }

        .positive {
            color: #006600;
        }

        .negative {
            color: #CC0000;
        }

        @@media print {
            thead {
                display: table-row-group;
            }

            tr {
                page-break-inside: avoid;
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanAllDetails">
            <colgroup>
                <col style="width:4%;" />
                <col style="width:7%;" />
                <col style="width:11%;" />
                <col style="width:8%;" />
                <col style="width:8%;" />
                <col style="width:6%;" />
                <col style="width:6%;" />
                <col style="width:6%;" />
                <col style="width:6%;" />
                <col style="width:6%;" />
                <col style="width:6%;" />
                <col style="width:6%;" />
                <col style="width:6%;" />
                <col style="width:7%;" />
                <col style="width:7%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="15">Loan Detail Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="7">
                        <strong>Branch :</strong> @branchName
                        &nbsp;&nbsp;
                        <strong>Till Date :</strong> @tillDate
                        &nbsp;&nbsp;
                        <strong>Status :</strong> @statusName
                    </td>
                    <td colspan="8" class="text-right">
                        @if (isLoanTypeFiltered)
                        {
                            <strong>Loan Type :</strong> @loanTypeName
                            <text>&nbsp;&nbsp;</text>
                        }
                        @if (isMemberGroupFiltered)
                        {
                            <strong>Member Group :</strong> @memberGroupName
                            <text>&nbsp;&nbsp;</text>
                        }
                        @if (isCollectionCenterFiltered)
                        {
                            <strong>Collection Center :</strong> @collectionCenterName
                            <text>&nbsp;&nbsp;</text>
                        }
                        @if (isCollectorFiltered)
                        {
                            <strong>Collector :</strong> @collectorName
                        }
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="15" class="text-right">
                        <strong>Report Generated On :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="15"></td></tr>

                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Loan A/c No</th>
                    <th>Loan Type</th>
                    <th class="text-right">Interest Rate</th>
                    <th>Issue Date</th>
                    <th>Maturity Date</th>
                    <th class="text-right">Issue Amount</th>
                    <th class="text-right">Principal Paid</th>
                    <th class="text-right">Remaining Principal</th>
                    <th class="text-right">Interest Due</th>
                    <th class="text-right">Penalty Due</th>
                    <th class="text-right">Total Remaining</th>
                    <th class="text-center">Status</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    var currentCollectionCenter = string.Empty;

                    foreach (var row in rows)
                    {
                        if (enableCollectionCenter && !string.IsNullOrEmpty(row.CollectionCenterName) && currentCollectionCenter != row.CollectionCenterName)
                        {
                            currentCollectionCenter = row.CollectionCenterName;
                            <tr class="collection-center-header">
                                <td colspan="15"><strong>Collection Center: @currentCollectionCenter</strong></td>
                            </tr>
                        }

                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td class="text-center">@sn</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            <td class="text-right">@(row.InterestRate ?? "")</td>
                            <td>@(row.IssueDate ?? "")</td>
                            <td>@(row.MaturityDate ?? "")</td>
                            <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.TotalPrincipalpaid.HasValue ? row.TotalPrincipalpaid.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.RemainingPrinciple.HasValue ? row.RemainingPrinciple.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.TotalInterest.HasValue ? row.TotalInterest.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.TotalPenalty.HasValue ? row.TotalPenalty.Value.ToString("N2") : "")</td>
                            <td class="text-right @(row.TotalRemaining.HasValue && row.TotalRemaining.Value > 0 ? "negative" : "")">@(row.TotalRemaining.HasValue ? row.TotalRemaining.Value.ToString("N2") : "")</td>
                            <td class="text-center">@(row.LoanStatus ?? "")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="8" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalLoanIssueAmount.ToString("N2")</strong></td>
                        <td></td>
                        <td class="text-right"><strong>@totalRemainingPrinciple.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalCurrInterest.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalCurrPenalty.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalRemaining.ToString("N2")</strong></td>
                        <td></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="14" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="15" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>