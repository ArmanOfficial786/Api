@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    // ── 1. DATA (set by the controller) ──
    var arrearRows = (Model["Rows"] as List<LoanAgingArrealCalculationRowDto>) ?? new();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalBalanceAmount = Model["TotalBalanceAmount"] as decimal? ?? 0;
    var totalGoodLoan = Model["TotalGoodloan"] as decimal? ?? 0;
    var totalArrear = Model["TotalArrear"] as decimal? ?? 0;
    var totalArrearFor0 = Model["TotalArrearFor0"] as decimal? ?? 0;
    var totalArrearFrom1To365 = Model["TotalArrearfrm1to365"] as decimal? ?? 0;
    var totalArrearGreaterThan365 = Model["TotalArreargrtthan365"] as decimal? ?? 0;
    var totalGoodAmount = Model["TotalGoodAmt"] as decimal? ?? 0;
    var totalFrom1To365 = Model["TotalFrm1to365"] as decimal? ?? 0;
    var totalGreaterThan365 = Model["TotalGrtthan365"] as decimal? ?? 0;
    var totalProvision = Model["TotalProvision"] as decimal? ?? 0;
    var totalRescheduleAmount = Model["TotalRescheduleAmt"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "All";
    var penaltyTypeName = Model["PenaltyTypeName"]?.ToString() ?? "Schedule Wise";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var memberGroupFiltered = !string.IsNullOrEmpty(memberGroupName) && memberGroupName != "All";
    var collectionCenterFiltered = !string.IsNullOrEmpty(collectionCenterName);
    var collectorFiltered = !string.IsNullOrEmpty(collectorName);

    // ── 2. COLUMNS, STYLE, SIZES ──
    var table = new ReportTable(Model, title: "Loan Arrear Risk Calculation Report", sheetName: "LoanAgingArrealCalculation")
        .Column("S.No", 2.2, Align.Center)
        .Column("Member Id", 5.5)
        .Column("Full Name", 7.5)
        .Column("Loan A/C No", 5.5)
        .Column("Pay Mode", 4.5)
        .Column("Disburse Amt.", 6.0, Align.Right)
        .Column("Balance Amt.", 6.0, Align.Right)
        .Column("Good Amt.", 6.0, Align.Right)
        .Column("Risk Amt.", 5.5, Align.Right)
        .Column("Risk 0", 6.0, Align.Right)
        .Column("Risk 1-365", 5.5, Align.Right)
        .Column("Risk >365", 5.5, Align.Right)
        .Column("Good Loan", 5.5, Align.Right)      // under "Arrear Days"
        .Column("1 to 365", 5.5, Align.Right)      // under "Arrear Days"
        .Column(">365", 5.5, Align.Right)      // under "Arrear Days"
        .Column("Total Provision Amt", 6.0, Align.Right)
        .Column("Reschedule Amt", 5.5, Align.Right)
        .Column("Days", 3.5, Align.Center)
        .Column("Last Payment", 6.0)
        .NoColumnHeader()                                      // the two header rows are added below as rows
        .Sizing(rowMm: 7, headerMm: 8, firstPageExtraMm: 75)
        .Css(@"
            table.sheet-table tr.r-data td.group-head       { background: #fff; font-weight: bold; text-align: center; border-bottom: 0; }
            table.sheet-table tr.r-data td.group-head-title { border-bottom: 1px solid #000; }");

    // ── 3. TITLE BLOCK ──
    var filterParts = new List<IHtmlContent> { Fmt.Labeled("Filter By:-", $"Tilldate: {tillDate}") };
    if (memberGroupFiltered) filterParts.Add(Fmt.Labeled("Member Group:", memberGroupName));
    if (collectionCenterFiltered) filterParts.Add(Fmt.Labeled("Collection Center:", collectionCenterName));
    if (collectorFiltered) filterParts.Add(Fmt.Labeled("Collector:", collectorName));
    filterParts.Add(Fmt.Labeled("Penalty Type:", penaltyTypeName));

    table.Meta("Branch Name:", branchName)
         .Meta("Report Generated On:", generatedOn)
         .MetaRow(Fmt.Join(filterParts.ToArray()));

    // ── 4. ROWS ──
    if (arrearRows.Any())
    {
        // header level 1: "Arrear Days" centred over Good Loan / 1 to 365 / >365 (12 + 3 + 4 = 19 columns)
        table.Data(
            new ReportCell("", Align.Center, 12, "group-head"),
            new ReportCell("Arrear Days", Align.Center, 3, "group-head group-head-title"),
            new ReportCell("", Align.Center, 4, "group-head"));

        // header level 2: the column titles
        table.Header();
    }

    var serialNumber = 0;
    foreach (var arrearRow in arrearRows)
    {
        table.Data(
            (++serialNumber).ToString(),
            arrearRow.MemberId ?? "",
            arrearRow.FullName ?? "",
            arrearRow.LoanAccountNo ?? "",
            arrearRow.PaymentMode ?? "",
            Fmt.Amount(arrearRow.LoanIssueAmount),
            Fmt.Amount(arrearRow.BalanceAmount),
            Fmt.Amount(arrearRow.Goodloan),
            Fmt.Amount(arrearRow.Arrear),
            Fmt.Amount(arrearRow.ArrearFor0),
            Fmt.Amount(arrearRow.Arrearfrm1to365),
            Fmt.Amount(arrearRow.Arreargrtthan365),
            Fmt.Amount(arrearRow.GoodAmt),
            Fmt.Amount(arrearRow.Frm1to365),
            Fmt.Amount(arrearRow.Grtthan365),
            Fmt.Amount(arrearRow.TotalProvision),
            Fmt.Amount(arrearRow.RescheduleAmt),
            Fmt.Int(arrearRow.Noofdays ?? 0),
            arrearRow.LastPaymentDate ?? "");
    }

    if (arrearRows.Any())
    {
        // label spans the first 5 columns; the 14 values fill the rest (Last Payment stays empty)
        table.Total("Grand Total", 5,
            Fmt.Amount(totalLoanIssueAmount),
            Fmt.Amount(totalBalanceAmount),
            Fmt.Amount(totalGoodLoan),
            Fmt.Amount(totalArrear),
            Fmt.Amount(totalArrearFor0),
            Fmt.Amount(totalArrearFrom1To365),
            Fmt.Amount(totalArrearGreaterThan365),
            Fmt.Amount(totalGoodAmount),
            Fmt.Amount(totalFrom1To365),
            Fmt.Amount(totalGreaterThan365),
            Fmt.Amount(totalProvision),
            Fmt.Amount(totalRescheduleAmount),
            Fmt.Int(totalRecords),
            "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())