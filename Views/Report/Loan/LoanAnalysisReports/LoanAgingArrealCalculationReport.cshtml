                            <td class="text-center">@(row.Noofdays ?? 0)</td>
                            <td>@(row.LastPaymentDate ?? "")</td>
                        </tr>
                    }

                    <tr class="grand-total" id="grandTotalRow">
                        <td colspan="5">Grand Total</td>
                        <td class="text-right">@totalLoanIssueAmount.ToString("N2")</td>
                        <td class="text-right">@totalBalanceAmount.ToString("N2")</td>
                        <td class="text-right">@totalGoodloan.ToString("N2")</td>
                        <td class="text-right">@totalArrear.ToString("N2")</td>
                        <td class="text-right">@totalArrearFor0.ToString("N2")</td>
                        <td class="text-right">@totalArrearfrm1to365.ToString("N2")</td>
                        <td class="text-right">@totalArreargrtthan365.ToString("N2")</td>
                        <td class="text-right">@totalGoodAmt.ToString("N2")</td>
                        <td class="text-right">@totalFrm1to365.ToString("N2")</td>
                        <td class="text-right">@totalGrtthan365.ToString("N2")</td>
                        <td class="text-right">@totalProvision.ToString("N2")</td>
                        <td class="text-right">@totalRescheduleAmt.ToString("N2")</td>
                        <td class="text-center">@totalRecords</td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="view-outer" id="viewOuter"></div>
    }

