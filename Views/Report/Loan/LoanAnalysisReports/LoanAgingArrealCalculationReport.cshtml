                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.PaymentMode ?? "")</td>
                            <td class="text-right">@(row.LoanIssueAmount?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.BalanceAmount?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Goodloan?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Arrear?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.ArrearFor0?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Arrearfrm1to365?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Arreargrtthan365?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.GoodAmt?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Frm1to365?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.Grtthan365?.ToString("N2") ?? "")</td>
                            <td class="text-right">@(row.TotalProvision?.ToString("N2") ?? "")</td>
