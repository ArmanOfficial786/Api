@* Views/Report/Loan/LoanAnalysisReport/LoanAgingArrealCalculationReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanAgingArrealCalculationRowDto>) ?? new List<LoanAgingArrealCalculationRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalBalanceAmount = Model["TotalBalanceAmount"] as decimal? ?? 0;
    var totalGoodloan = Model["TotalGoodloan"] as decimal? ?? 0;
    var totalArrear = Model["TotalArrear"] as decimal? ?? 0;
    var totalArrearFor0 = Model["TotalArrearFor0"] as decimal? ?? 0;
    var totalArrearfrm1to365 = Model["TotalArrearfrm1to365"] as decimal? ?? 0;
    var totalArreargrtthan365 = Model["TotalArreargrtthan365"] as decimal? ?? 0;
    var totalGoodAmt = Model["TotalGoodAmt"] as decimal? ?? 0;
    var totalFrm1to365 = Model["TotalFrm1to365"] as decimal? ?? 0;
    var totalGrtthan365 = Model["TotalGrtthan365"] as decimal? ?? 0;
    var totalProvision = Model["TotalProvision"] as decimal? ?? 0;
    var totalRescheduleAmt = Model["TotalRescheduleAmt"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "All";
    var penaltyType = Model["PenaltyType"]?.ToString() ?? "S";
    var penaltyTypeName = Model["PenaltyTypeName"]?.ToString() ?? "Schedule Wise";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var enable1To30Days = Model["Enable1To30Days"] as bool? ?? false;
    var enableCollectionCenter = Model["EnableCollectionCenter"] as bool? ?? false;
    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isView = format == "VIEW";
    var isExcel = format is "EXCEL" or "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName) && memberGroupName != "All";
    var isCollectionCenterFiltered = !string.IsNullOrEmpty(collectionCenterName);
    var isCollectorFiltered = !string.IsNullOrEmpty(collectorName);

    // Title matches the reference report exactly, regardless of which SP
    // (0-365 vs 1-to-30) produced the rows.
    var reportTitle = "Loan Arrear Risk Calculation Report";

    // 18 columns total: S.No, Member Id, Full Name, Loan A/C No, Pay Mode,
    // Disburse Amt, Balance Amt, Good Amt, Risk Amt, Risk 0, Risk 1-365,
    // Risk >365, [Arrear Days: Good Loan, 1 to 365, >365], Total Provision Amt,
    // Reschedule Amt, Days, Last Payment
    const int totalCols = 18;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@reportTitle</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8pt;
                background: @(isView ? "#d0d0d0" : "#fff");
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .report-subheader {
                width: 100%;
                padding: 4px 6px 0 6px;
                background: #fff;
            }

            .subheader-title {
                text-align: center;
                font-size: 13pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 4px 4px;
            }

            .subheader-meta {
                font-size: 8.5pt;
                padding: 2px 6px;
            }

            .subheader-spacer {
                height: 5px;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 7.5pt;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 4px;
                    vertical-align: middle;
                    background: #fff;
                    font-size: 7.5pt;
                }

            thead {
                display: table-row-group;
            }

            .data-table th {
                background: #f2f2f2;
                border-top: 1.5px solid #000;
                border-bottom: 1px solid #000;
                font-weight: bold;
                white-space: nowrap;
            }

            .group-header th {
                text-align: center;
                border-bottom: 1px solid #000;
                background: #fff;
            }

            .detail-row td {
                border-bottom: 1px solid #e0e0e0;
            }

            .grand-total td {
                border-top: 1.5px solid #000;
                border-bottom: 1.5px solid #000;
                font-weight: bold;
                background: #fff;
            }

            /* ── Column widths ── */
            col.c-sn {
                width: 2.2%;
            }

            col.c-mid {
                width: 5.5%;
            }

            col.c-name {
                width: 7.5%;
            }

            col.c-acno {
                width: 5.5%;
            }

            col.c-mode {
                width: 4.5%;
            }

            col.c-disb {
                width: 6.0%;
            }

            col.c-bal {
                width: 6.0%;
            }

            col.c-good {
                width: 6.0%;
            }

            col.c-risk {
                width: 5.5%;
            }

            col.c-risk0 {
                width: 6.0%;
            }

            col.c-risk1 {
                width: 5.5%;
            }

            col.c-riskg {
                width: 5.5%;
            }

            col.c-agood {
                width: 5.5%;
            }

            col.c-a1to365 {
                width: 5.5%;
            }

            col.c-agt365 {
                width: 5.5%;
            }

            col.c-provis {
                width: 6.0%;
            }

            col.c-resch {
                width: 5.5%;
            }

            col.c-days {
                width: 3.5%;
            }

            col.c-lastpay {
                width: 6.0%;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }

            /* ── VIEW chrome: horizontal-scroll page cards, same pattern as
                             MemberAllDetailReport.cshtml ── */
            .view-outer {
                background: #d0d0d0;
                padding: 2px 16px 20px 16px;
                min-height: 100vh;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                cursor: grab;
            }

                .view-outer:active {
                    cursor: grabbing;
                }

            .view-page {
                background: #fff;
                margin: 0 auto 24px auto;
                box-shadow: 0 2px 8px rgba(0,0,0,.18);
                width: 2600px;
                height: 1587px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-page-content {
                flex: 1;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-page-footer {
                background: #fff;
                border-top: 1px solid #ccc;
                text-align: center;
                font-size: 9pt;
                font-weight: bold;
                padding: 6px 0;
                flex-shrink: 0;
            }

            .common-header-wrap {
                width: 2600px;
                overflow: hidden;
                flex-shrink: 0;
            }

            .page-subheader {
                flex-shrink: 0;
            }

            .page-table-wrap {
                flex: 1;
                overflow: hidden;
            }

            #sourceWrap {
                opacity: 0;
                pointer-events: none;
                width: 2600px;
                position: absolute;
                top: 0;
                left: 0;
            }

            #commonHeaderSource {
                visibility: hidden;
                position: absolute;
                top: 0;
                left: 0;
                width: 2600px;
                pointer-events: none;
