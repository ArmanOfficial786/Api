                <col class="c-mid" />
                <col class="c-name" />
                <col class="c-acno" />
                <col class="c-mode" />
                <col class="c-disb" />
                <col class="c-bal" />
                <col class="c-good" />
                <col class="c-risk" />
                <col class="c-risk0" />
                <col class="c-risk1" />
                <col class="c-riskg" />
                <col class="c-agood" />
                <col class="c-a1to365" />
                <col class="c-agt365" />
                <col class="c-provis" />
                <col class="c-resch" />
                <col class="c-days" />
                <col class="c-lastpay" />
            </colgroup>
            @if (isExcel)
            {
                <thead>
                    <tr class="text-center"><td colspan="@totalCols"><strong>@reportTitle</strong></td></tr>
                    <tr><td colspan="@totalCols"><strong>Branch Name:</strong> @branchName</td></tr>
                    <tr><td colspan="@totalCols"><strong>Filter By:-</strong> Tilldate: @tillDate</td></tr>
                    <tr><td colspan="@totalCols"></td></tr>
                    <tr class="group-header">
                        <th colspan="12"></th>
                        <th colspan="3">Arrear Days</th>
                        <th colspan="4"></th>
                    </tr>
                    <tr>
                        <th class="text-center">S.No</th>
                        <th>Member Id</th>
                        <th>Full Name</th>
                        <th>Loan A/C No</th>
                        <th>Pay Mode</th>
                        <th class="text-right">Disburse Amt.</th>
                        <th class="text-right">Balance Amt.</th>
                        <th class="text-right">Good Amt.</th>
                        <th class="text-right">Risk Amt.</th>
                        <th class="text-right">Risk 0</th>
                        <th class="text-right">Risk 1-365</th>
                        <th class="text-right">Risk &gt;365</th>
                        <th class="text-right">Good Loan</th>
                        <th class="text-right">1 to 365</th>
                        <th class="text-right">&gt;365</th>
                        <th class="text-right">Total Provision Amt</th>
