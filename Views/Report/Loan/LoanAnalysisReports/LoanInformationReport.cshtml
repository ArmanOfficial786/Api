@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanInformationRowDto>) ?? new List<LoanInformationRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalDisburseAmount = Model["TotalDisburseAmount"] as decimal? ?? 0;
    var totalRepaidTill = Model["TotalRepaidTill"] as decimal? ?? 0;
    var totalRepaid = Model["TotalRepaid"] as decimal? ?? 0;
    var totalBalanceAmount = Model["TotalBalanceAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Grouped by member: member header once (Id + Name), then every loan
    // that member holds (any loan type) underneath - matches the legacy
    // report exactly.
    var memberGroups = rows
        .GroupBy(r => new { r.MemberId, r.FullName })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Principal Information Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 3px 4px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 8pt;
                text-align: left;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
            }

            /* Member group header row (Member Id + Name only) */
            .member-header-row td {
                padding-top: 8px;
                padding-bottom: 2px;
                font-weight: bold;
            }

            /* Loan rows under a member */
            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .loan-account {
                color: #1F5C99;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .positive {
                color: #006600;
            }

            .negative {
                color: #CC0000;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanInformation">
            <colgroup>
                <col style="width:9%;" />
                <col style="width:15%;" />
                <col style="width:15%;" />
                <col style="width:12%;" />
                <col style="width:13%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="8">Loan Principal Information Report</td>
                </tr>

                <!-- Metadata: stacked, left-aligned -->
                <tr class="meta-row">
                    <td colspan="8"><strong>Branch Name :</strong> @branchName</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="8">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="8"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="8"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>Member ID</th>
                    <th>Member Name</th>
                    <th>Loan Type</th>
                    <th>Loan A/C No.</th>
                    <th class="text-right">Disburse Amount</th>
                    <th class="text-right">Previous Received</th>
                    <th class="text-right">Received Between</th>
                    <th class="text-right">Balance</th>
                </tr>

                @if (memberGroups.Any())
                {
                    foreach (var grp in memberGroups)
                    {
                        <!-- Member header band -->
                        <tr class="member-header-row">
                            <td>@(grp.Key.MemberId ?? "")</td>
                            <td>@(grp.Key.FullName ?? "")</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <!-- All loans held by this member, any loan type -->
                        foreach (var row in grp)
                        {
                            <tr class="detail-row">
                                <td></td>
                                <td></td>
                                <td>@(row.LoanTypeName ?? "")</td>
                                <td class="loan-account">@(row.LoanAccountNo ?? "")</td>
                                <td class="text-right">@(row.DisburseAmount.HasValue ? row.DisburseAmount.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.RepaidTill.HasValue ? row.RepaidTill.Value.ToString("N2") : "")</td>
                                <td class="text-right">@(row.Repaid.HasValue ? row.Repaid.Value.ToString("N2") : "")</td>
                                <td class="text-right @(row.BalanceAmount.HasValue && row.BalanceAmount.Value > 0 ? "negative" : "positive")">@(row.BalanceAmount.HasValue ? row.BalanceAmount.Value.ToString("N2") : "")</td>
                            </tr>
                        }
                    }

                    <!-- Grand Total -->
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalDisburseAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalRepaidTill.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalRepaid.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalBalanceAmount.ToString("N2")</strong></td>
                    </tr>
                 
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>