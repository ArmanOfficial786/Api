@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";
    const int ColumnCount = 16;   // number of .Column(...) lines below; the group line spans all of them

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<LoanRegisterRowDto>) ?? new List<LoanRegisterRowDto>();

    var tillDate = !string.IsNullOrEmpty(Text("TillDateAd")) ? Text("TillDateAd") : Text("TillDate");
    var branchName = Text("BranchName", "All");
    var loanTypeFilterName = Text("LoanTypeName");
    var collectorName = Text("CollectorName");
    var collectionCenterName = Text("CollectionCenterName");
    var selectLoanName = Text("SelectLoanName", "All");
    var enableCollectionCenter = Model.TryGetValue("EnableCollectionCenter", out var ec) && ec is bool centerEnabled && centerEnabled;
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalIssue = TotalOr("TotalLoanIssueAmount", rows.Sum(r => r.LoanIssueAmount ?? 0));
    var totalPrincipal = TotalOr("TotalPriBalance", rows.Sum(r => r.PriBalance ?? 0));
    var totalInterest = TotalOr("TotalIntBalance", rows.Sum(r => r.IntBalance ?? 0));
    var totalPenalty = TotalOr("TotalPenaltyBalance", rows.Sum(r => r.PenaltyBalance ?? 0));
    var totalBalance = TotalOr("TotalBalance", rows.Sum(r => r.TotalBalance ?? 0));
    var totalDefaulterAmount = rows.Sum(r => r.defaulterAmount ?? 0);
    var totalDefaulterCount = rows.Sum(r => r.defaulterCount ?? 0);

    // grouped by loan type, in the order the types first appear
    var typeGroups = rows.GroupBy(r => r.LoanTypeName ?? "").ToList();

    var table = new ReportTable(Model, title: "Loan Register Report", sheetName: "LoanRegister")
        .Column("S.No", 3, Align.Center)
        .Column("Member Details", 14)          // member id + name on one line, so this column is wider
        .Column("Contact Address", 8)
        .Column("Contact No", 7)
        .Column("A/C No", 6)
        .Column("Issue Amount", 7, Align.Right)
        .Column("Issue Date", 6)
        .Column("Maturity", 6)
        .Column("Type", 4)
        .Column("Interest", 3, Align.Right)
        .Column("Pri Balance", 7, Align.Right)
        .Column("Int Balance", 7, Align.Right)
        .Column("Pnt Balance", 7, Align.Right)
        .Column("Total Balance", 7, Align.Right)
        .Column("Defaulter Amount", 5, Align.Right)
        .Column("Def Count", 3, Align.Center)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            GroupBackground = "#fff",
            SubTotalBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)   // one text line per row; raise rowMm if rows look tight
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 4px; }\n" +
            "table.sheet-table tr.r-group td { text-decoration: underline; border-top: 0; border-bottom: 0; }\n" +
            "table.sheet-table tr.r-subtotal td { border-top: 1px solid #999; border-bottom: 1px solid #999; }");

    // ── title block ──
    var leftParts = new List<IHtmlContent>
    {
        Fmt.Labeled("Branch :", branchName),
        Fmt.Labeled("Loan :", selectLoanName)
    };
    if (!string.IsNullOrEmpty(loanTypeFilterName)) leftParts.Add(Fmt.Labeled("Type :", loanTypeFilterName));

    var filterParts = new List<IHtmlContent>();
    if (!string.IsNullOrEmpty(collectorName)) filterParts.Add(Fmt.Labeled("Collector :", collectorName));
    if (enableCollectionCenter && !string.IsNullOrEmpty(collectionCenterName))
        filterParts.Add(Fmt.Labeled("Collection Center :", collectionCenterName));

    table.MetaRow(Fmt.Join(leftParts.ToArray()), Fmt.Labeled("Report Generated On :", generatedOn));
    if (filterParts.Count > 0) table.MetaRow(Fmt.Join(filterParts.ToArray()));
    table.MetaRow(Fmt.Labeled("Filter By:-", $"Tilldate: {tillDate}"));

    // ── rows: one block per loan type (group line, loans, sub total) ──
    foreach (var typeGroup in typeGroups)
    {
        // group line: ONE cell with the loan type name, spanning all columns
        table.GroupBy(ReportCell.Left(typeGroup.Key, ColumnCount));

        var sn = 0;
        foreach (var row in typeGroup)
        {
            table.Data(
                (++sn).ToString(),
                $"{row.MemberId} {row.FullName}",       // id and name inline on one line
                row.ContactAddress ?? "",
                row.ContactNo ?? "",
                row.LoanAccountNo ?? "",
                Fmt.Amount(row.LoanIssueAmount),
                row.LoanIssueOnBs ?? "",
                row.MaturityOnBs ?? "",
                row.LoanPaymentTypeCode ?? "",
                Fmt.Amount(row.InterestRate),
                Fmt.Amount(row.PriBalance),
                Fmt.Amount(row.IntBalance),
                Fmt.Amount(row.PenaltyBalance),
                Fmt.Amount(row.TotalBalance),
                Fmt.Amount(row.defaulterAmount),
                (row.defaulterCount ?? 0).ToString());
        }

        // label spans the first 5 columns; the 11 values fill the rest
        table.SubTotal($"Sub Total - {typeGroup.Key} ({typeGroup.Count()})", 5,
            Fmt.Amount(typeGroup.Sum(r => r.LoanIssueAmount ?? 0)), "", "", "", "",
            Fmt.Amount(typeGroup.Sum(r => r.PriBalance ?? 0)),
            Fmt.Amount(typeGroup.Sum(r => r.IntBalance ?? 0)),
            Fmt.Amount(typeGroup.Sum(r => r.PenaltyBalance ?? 0)),
            Fmt.Amount(typeGroup.Sum(r => r.TotalBalance ?? 0)),
            Fmt.Amount(typeGroup.Sum(r => r.defaulterAmount ?? 0)),
            typeGroup.Sum(r => r.defaulterCount ?? 0).ToString());
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 5,
            Fmt.Amount(totalIssue), "", "", "", "",
            Fmt.Amount(totalPrincipal),
            Fmt.Amount(totalInterest),
            Fmt.Amount(totalPenalty),
            Fmt.Amount(totalBalance),
            Fmt.Amount(totalDefaulterAmount),
            totalDefaulterCount.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())