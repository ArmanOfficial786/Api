                    <col class="c-mid" />
                    <col class="c-addr" />
                    <col class="c-contact" />
                    <col class="c-acno" />
                    <col class="c-issueamt" />
                    <col class="c-issdate" />
                    <col class="c-mat" />
                    <col class="c-type" />
                    <col class="c-int" />
                    <col class="c-pri" />
                    <col class="c-intbal" />
                    <col class="c-pnt" />
                    <col class="c-total" />
                    <col class="c-defamt" />
                    <col class="c-defcnt" />
                </colgroup>
                <thead>
                    <tr id="colHeaderRow">
                        <th class="text-center">S.No</th>
                        <th>Member Details</th>
                        <th>Contact Address</th>
                        <th>Contact No</th>
                        <th>A/C No</th>
                        <th class="text-right">Issue Amount</th>
                        <th>Issue Date</th>
                        <th>Maturity</th>
                        <th>Type</th>
                        <th class="text-right">Interest</th>
                        <th class="text-right">Pri Balance</th>
                        <th class="text-right">Int Balance</th>
                        <th class="text-right">Pnt Balance</th>
                        <th class="text-right">Total Balance</th>
                        <th class="text-right">Defaulter Amount</th>
                        <th class="text-center">Def Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grp in groups)
                    {
                        <tr class="detail-row group-header">
                            <td colspan="16">@(grp.Key)</td>
                        </tr>

                        var sn = 0;
                        foreach (var row in grp)
                        {
                            sn++;
                            <tr class="detail-row">
                                <td class="text-center">@sn</td>
                                <td>
                                    <span class="member-id">@(row.MemberId ?? "")</span>
                                    <span class="member-name">@(row.FullName ?? "")</span>
                                </td>
                                <td>@(row.ContactAddress ?? "")</td>
                                <td>@(row.ContactNo ?? "")</td>
                                <td>@(row.LoanAccountNo ?? "")</td>
                                <td class="text-right">@(row.LoanIssueAmount?.ToString("N2") ?? "")</td>
                                <td>@(row.LoanIssueOnBs ?? "")</td>
                                <td>@(row.MaturityOnBs ?? "")</td>
                                <td>@(row.LoanPaymentTypeCode ?? "")</td>
                                <td class="text-right">@(row.InterestRate?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.PriBalance?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.IntBalance?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.PenaltyBalance?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.TotalBalance?.ToString("N2") ?? "")</td>
                                <td class="text-right">@(row.defaulterAmount?.ToString("N2") ?? "")</td>
                                <td class="text-center">@(row.defaulterCount ?? 0)</td>
                            </tr>
                        }

                        <tr class="detail-row sub-total-row">
                            <td class="text-center">@(grp.Count())</td>
                            <td>@(grp.Key)</td>
                            <td colspan="3"></td>
                            <td class="text-right">@(grp.Sum(r => r.LoanIssueAmount ?? 0).ToString("N2"))</td>
                            <td colspan="2"></td>
                            <td colspan="2"></td>
                            <td class="text-right">@(grp.Sum(r => r.PriBalance ?? 0).ToString("N2"))</td>
                            <td class="text-right">@(grp.Sum(r => r.IntBalance ?? 0).ToString("N2"))</td>
                            <td class="text-right">@(grp.Sum(r => r.PenaltyBalance ?? 0).ToString("N2"))</td>
                            <td class="text-right">@(grp.Sum(r => r.TotalBalance ?? 0).ToString("N2"))</td>
                            <td class="text-right">@(grp.Sum(r => r.defaulterAmount ?? 0).ToString("N2"))</td>
                            <td class="text-center">@(grp.Sum(r => r.defaulterCount ?? 0))</td>
                        </tr>
                    }

                    <tr class="grand-total" id="grandTotalRow">
                        <td colspan="5">Grand Total</td>
                        <td class="text-right">@totalLoanIssueAmount.ToString("N2")</td>
                        <td colspan="2"></td>
                        <td colspan="2"></td>
                        <td class="text-right">@totalPriBalance.ToString("N2")</td>
                        <td class="text-right">@totalIntBalance.ToString("N2")</td>
                        <td class="text-right">@totalPenaltyBalance.ToString("N2")</td>
                        <td class="text-right">@totalBalance.ToString("N2")</td>
                        <td class="text-right">@totalDefaulterAmount.ToString("N2")</td>
                        <td class="text-center">@totalDefaulterCount</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="view-outer" id="viewOuter"></div>
    }

    @if (!isView)
