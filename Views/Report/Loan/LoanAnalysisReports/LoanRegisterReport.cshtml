@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanRegisterRowDto>) ?? new List<LoanRegisterRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalPriBalance = Model["TotalPriBalance"] as decimal? ?? 0;
    var totalIntBalance = Model["TotalIntBalance"] as decimal? ?? 0;
    var totalPenaltyBalance = Model["TotalPenaltyBalance"] as decimal? ?? 0;
    var totalBalance = Model["TotalBalance"] as decimal? ?? 0;
    var totalDefaulterAmount = rows.Sum(r => r.defaulterAmount ?? 0);
    var totalDefaulterCount = rows.Sum(r => r.defaulterCount ?? 0);

    var tillDate = Model.ContainsKey("TillDateAd") && !string.IsNullOrEmpty(Model["TillDateAd"]?.ToString())
        ? Model["TillDateAd"]?.ToString()
        : Model["TillDate"]?.ToString() ?? "";

    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var loanTypeFilterName = Model["LoanTypeName"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "";
    var selectLoanName = Model["SelectLoanName"]?.ToString() ?? "All";
    var enableCollectionCenter = Model["EnableCollectionCenter"] as bool? ?? false;
    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isView = format == "VIEW";
    var isExcel = format is "EXCEL" or "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isLoanTypeFiltered = !string.IsNullOrEmpty(loanTypeFilterName);
    var isCollectorFiltered = !string.IsNullOrEmpty(collectorName);
    var isCollectionCenterFiltered = enableCollectionCenter && !string.IsNullOrEmpty(collectionCenterName);

    // Grouped by Loan Type, preserving each type's first-appearance order and
    // the original within-group row order (matches the reference image).
    var groups = rows.GroupBy(r => r.LoanTypeName ?? "").ToList();

    const int totalCols = 16;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Register Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 7.5pt;
                background: @(isView ? "#d0d0d0" : "#fff");
                color: #000;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .report-subheader {
                width: 100%;
                padding: 4px 6px 0 6px;
                background: #fff;
            }

            .subheader-title {
                text-align: center;
                font-size: 13pt;
                font-family: "Times New Roman", Times, serif;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 4px 4px;
            }

            .subheader-meta {
                display: flex;
                justify-content: space-between;
                font-size: 8pt;
                padding: 2px 6px;
            }

            .subheader-filter {
                font-size: 8pt;
                padding: 4px 6px 2px;
            }

            .subheader-spacer {
                height: 6px;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 7.5pt;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 4px;
                    vertical-align: middle;
                    background: #fff;
                    font-size: 7.5pt;
                }

            thead {
                display: table-row-group;
            }

            .data-table th {
                background: #f2f2f2;
                border-top: 1.5px solid #000;
                border-bottom: 1px solid #000;
                font-weight: bold;
                white-space: nowrap;
            }

            .group-header td {
                font-weight: bold;
                text-decoration: underline;
                padding-top: 6px;
            }

            .member-id {
                display: block;
            }

            .member-name {
                display: block;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .sub-total-row td {
                font-weight: bold;
                border-top: 1px solid #999;
                border-bottom: 1px solid #999;
            }

            .grand-total td {
                border-top: 1.5px solid #000;
                border-bottom: 1.5px solid #000;
                font-weight: bold;
            }

            /* ── Column widths ── */
            col.c-sn {
                width: 3%;
            }

            col.c-mid {
                width: 11%;
            }

            col.c-addr {
                width: 9%;
            }

            col.c-contact {
                width: 8%;
            }

            col.c-acno {
                width: 6%;
            }

            col.c-issueamt {
                width: 7%;
            }

            col.c-issdate {
                width: 6%;
            }

            col.c-mat {
                width: 6%;
            }

            col.c-type {
                width: 4%;
            }

            col.c-int {
                width: 4%;
            }

            col.c-pri {
                width: 7%;
            }

            col.c-intbal {
                width: 7%;
            }

            col.c-pnt {
                width: 7%;
            }

            col.c-total {
                width: 7%;
            }

            col.c-defamt {
                width: 5%;
            }

            col.c-defcnt {
                width: 3%;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }

            /* ── VIEW chrome: horizontal-scroll paginated page cards,
                             same pattern as MemberAllDetailReport.cshtml ── */
            .view-outer {
                background: #d0d0d0;
                padding: 2px 16px 20px 16px;
                min-height: 100vh;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                cursor: grab;
            }

                .view-outer:active {
                    cursor: grabbing;
                }

            .view-page {
                background: #fff;
                margin: 0 auto 24px auto;
                box-shadow: 0 2px 8px rgba(0,0,0,.18);
                width: 2400px;
                height: 1587px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-page-content {
                flex: 1;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-page-footer {
                background: #fff;
                border-top: 1px solid #ccc;
                text-align: center;
                font-size: 9pt;
                font-weight: bold;
                padding: 6px 0;
                flex-shrink: 0;
            }

            .common-header-wrap {
                width: 2400px;
                overflow: hidden;
                flex-shrink: 0;
            }

            .page-subheader {
                flex-shrink: 0;
            }

            .page-table-wrap {
                flex: 1;
                overflow: hidden;
            }

            #sourceWrap {
                opacity: 0;
                pointer-events: none;
                width: 2400px;
                position: absolute;
                top: 0;
                left: 0;
            }

            #commonHeaderSource {
                visibility: hidden;
                position: absolute;
                top: 0;
                left: 0;
                width: 2400px;
                pointer-events: none;
            }
    </style>
</head>
<body>

    @if (!isExcel)
    {
        <div id="commonHeaderSource">
            @await Html.PartialAsync("_CommonHeader", Model)
        </div>
    }

    @if (isView)
    {
        <div id="sourceWrap">
