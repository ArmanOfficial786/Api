            @await Html.PartialAsync("_CommonHeader", Model)

            <div class="report-subheader">
                <div class="subheader-title">Loan Register Report</div>
                <div class="subheader-meta">
                    <span>
                        <strong>Branch :</strong> @branchName
                        &nbsp;&nbsp;
                        <strong>Loan :</strong> @selectLoanName
                        @if (isLoanTypeFiltered)
                        {
                            <text>&nbsp;&nbsp;<strong>Type :</strong> @loanTypeFilterName</text>
                        }
                    </span>
                    <span><strong>Report Generated On :</strong> @generatedOn</span>
                </div>
                <div class="subheader-meta">
                    <span>
                        @if (isCollectorFiltered)
                        {
                            <strong>Collector :</strong>
                            @(collectorName)
                        }
                        @if (isCollectionCenterFiltered)
                        {
                            <text>&nbsp;&nbsp;<strong>Collection Center :</strong> @collectionCenterName</text>
                        }
                    </span>
                    <span></span>
                </div>
                <div class="subheader-filter"><strong>Filter By:-</strong> Tilldate: @tillDate</div>
                <div class="subheader-spacer"></div>
            </div>
        }

        <table class="data-table" id="mainTable"
            @(isExcel ? Html.Raw("data-sheet-name=\"LoanRegister\"") : Html.Raw(""))>
            <colgroup>
                <col class="c-sn" />
                <col class="c-mid" />
                <col class="c-addr" />
                <col class="c-contact" />
                <col class="c-acno" />
                <col class="c-issueamt" />
                <col class="c-issdate" />
                <col class="c-mat" />
                <col class="c-type" />
                <col class="c-int" />
                <col class="c-pri" />
                <col class="c-intbal" />
                <col class="c-pnt" />
                <col class="c-total" />
                <col class="c-defamt" />
                <col class="c-defcnt" />
            </colgroup>
            @if (isExcel)
            {
                <thead>
                    <tr class="text-center"><td colspan="@totalCols"><strong>Loan Register Report</strong></td></tr>
                    <tr><td colspan="@totalCols"><strong>Branch :</strong> @branchName</td></tr>
                    <tr><td colspan="@totalCols"><strong>Filter By:-</strong> Tilldate: @tillDate</td></tr>
                    <tr><td colspan="@totalCols"></td></tr>
                    <tr>
                        <th class="text-center">S.No</th>
                        <th>Member Details</th>
                        <th>Contact Address</th>
                        <th>Contact No</th>
                        <th>A/C No</th>
                        <th class="text-right">Issue Amount</th>
                        <th>Issue Date</th>
                        <th>Maturity</th>
                        <th>Type</th>
                        <th class="text-right">Interest</th>
                        <th class="text-right">Pri Balance</th>
                        <th class="text-right">Int Balance</th>
                        <th class="text-right">Pnt Balance</th>
                        <th class="text-right">Total Balance</th>
                        <th class="text-right">Defaulter Amount</th>
                        <th class="text-center">Def Count</th>
                    </tr>
                </thead>
            }
            else
            {
                <thead>
                    <tr>
                        <th class="text-center">S.No</th>
                        <th>Member Details</th>
                        <th>Contact Address</th>
                        <th>Contact No</th>
                        <th>A/C No</th>
                        <th class="text-right">Issue Amount</th>
                        <th>Issue Date</th>
                        <th>Maturity</th>
                        <th>Type</th>
                        <th class="text-right">Interest</th>
                        <th class="text-right">Pri Balance</th>
                        <th class="text-right">Int Balance</th>
