                            <td colspan="2"></td>
                            <td colspan="2"></td>
                            <td class="text-right">@(grp.Sum(r => r.PriBalance ?? 0).ToString("N2"))</td>
                            <td class="text-right">@(grp.Sum(r => r.IntBalance ?? 0).ToString("N2"))</td>
                            <td class="text-right">@(grp.Sum(r => r.PenaltyBalance ?? 0).ToString("N2"))</td>
                            <td class="text-right">@(grp.Sum(r => r.TotalBalance ?? 0).ToString("N2"))</td>
                            <td class="text-right">@(grp.Sum(r => r.defaulterAmount ?? 0).ToString("N2"))</td>
