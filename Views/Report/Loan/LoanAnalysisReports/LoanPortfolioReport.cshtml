@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var particulars = (Model["Particulars"] as List<LoanPortfolioParticularsDto>) ?? new List<LoanPortfolioParticularsDto>();
    var outstanding = (Model["Outstanding"] as List<LoanPortfolioOutstandingDto>) ?? new List<LoanPortfolioOutstandingDto>();
    var loanTypeWise = (Model["LoanTypeWise"] as List<LoanPortfolioLoanTypeWiseDto>) ?? new List<LoanPortfolioLoanTypeWiseDto>();
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Portfolio Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Times New Roman", Times, serif;
                font-size: 11pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 11pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 6px;
                    vertical-align: middle;
                }

            /* ── Title band: double rule above + below, centered, underlined ── */
            .title-row td {
                text-align: center;
                font-size: 15pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 6px 8px;
                border-top: 3px double #000;
                border-bottom: 3px double #000;
            }

            /* ── Branch / Generated-On meta rows ── */
            .meta-row td {
                padding: 6px 6px 2px;
                font-size: 11pt;
                vertical-align: top;
            }

            .meta-label {
                font-weight: bold;
                white-space: nowrap;
                width: 1%;
            }

            .meta-spacer td {
                height: 8px;
            }

            /* ── Gray section bars: Particulars / Outstanding / Loan Type Wise ── */
            .section-header td {
                background: #808080;
                color: #000;
                font-weight: bold;
                font-size: 11pt;
                padding: 3px 6px;
                border-top: 1px solid #000;
                border-bottom: 1px solid #000;
            }

            /* ── Particulars / Outstanding rows: label + single number ── */
            .kv-row td {
                padding: 2px 6px;
                color: #1a3d7c;
            }

            .kv-value {
                text-align: left;
            }

            /* ── Loan Type Wise header row ── */
            .type-header th {
                text-align: left;
                font-weight: bold;
                border-bottom: 1px solid #000;
                padding: 4px 6px;
                background: transparent;
            }

            /* ── Loan Type Wise detail rows ── */
            .type-row td {
                padding: 2px 6px;
                color: #1a3d7c;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanPortfolio">
            <colgroup>
                <col style="width:45%;" />
                <col style="width:15%;" />
                <col style="width:40%;" />
            </colgroup>
            <tbody>
                <!-- Title -->
                <tr class="title-row">
                    <td colspan="3">Loan Portfolio Report</td>
                </tr>

                <!-- Branch / Generated On -->
                <tr class="meta-row">
                    <td class="meta-label" colspan="1">Branch Name:</td>
                    <td colspan="2">@branchName</td>
                </tr>
                <tr class="meta-row">
                    <td class="meta-label" colspan="1">Report Generated On:</td>
                    <td colspan="2">@generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="3"></td></tr>

                <!-- Particulars -->
                @if (particulars.Any())
                {
                    <tr class="section-header">
                        <td colspan="3">Particulars</td>
                    </tr>
                    foreach (var row in particulars)
                    {
                        <tr class="kv-row">
                            <td>@(row.Particulars ?? "")</td>
                            <td class="kv-value">@(row.NoofLoan?.ToString() ?? "")</td>
                            <td></td>
                        </tr>
                    }
                }

                <!-- Loan Outstanding Details (Gender Wise) -->
                @if (outstanding.Any())
                {
                    <tr class="section-header">
                        <td colspan="3">Loan Outstanding Details (Gender Wise)</td>
                    </tr>
                    foreach (var row in outstanding)
                    {
                        <tr class="kv-row">
                            <td>@(row.Particulars ?? "")</td>
                            <td class="kv-value">@(row.NoofLoan?.ToString() ?? "")</td>
                            <td></td>
                        </tr>
                    }
                }

                <!-- Loan Details (Loan Type Wise) -->
                @if (loanTypeWise.Any())
                {
                    <tr class="section-header">
                        <td colspan="3">Loan Details (Loan Type Wise)</td>
                    </tr>
                    <tr class="type-header">
                        <th>Lone Type</th>
                        <th class="text-center">Total No</th>
                        <th class="text-right">Remaining Principal</th>
                    </tr>
                    foreach (var row in loanTypeWise)
                    {
                        <tr class="type-row">
                            <td>@(row.LoanTypeName ?? "")</td>
                            <td class="text-center">@(row.NoofLoan?.ToString() ?? "")</td>
                            <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : "")</td>
                        </tr>
                    }
                }

                @if (!particulars.Any() && !outstanding.Any() && !loanTypeWise.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>