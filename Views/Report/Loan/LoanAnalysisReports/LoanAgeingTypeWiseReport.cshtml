@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanAgeingTypeWiseRowDto>) ?? new List<LoanAgeingTypeWiseRowDto>();
    var totalLoans = Model["TotalLoans"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalRepaid = Model["TotalRepaid"] as decimal? ?? 0;
    var totalBalance = Model["TotalBalance"] as decimal? ?? 0;
    var totalOverdue = Model["TotalOverdue"] as decimal? ?? 0;
    var tillDateAd = Model.ContainsKey("TillDateAd") ? Model["TillDateAd"]?.ToString() : "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Ageing Type Wise Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Times New Roman", Times, serif;
                font-size: 10pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 10pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-size: 13pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 6px 8px;
            }

            .meta-row td {
                padding: 2px 6px;
                font-size: 10pt;
            }

            .meta-row .label {
                font-weight: bold;
                white-space: nowrap;
                width: 1%;
            }

            .section-bar td {
                background: #808080;
                font-weight: bold;
                padding: 3px 6px;
                border-top: 1px solid #000;
                border-bottom: 1px solid #000;
            }

            .filter-row td {
                padding: 4px 6px 2px;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                text-align: left;
                font-weight: bold;
                padding: 4px 6px;
            }

            .detail-row td {
                color: #1a3d7c;
                padding: 2px 6px;
            }

            .total-row td {
                border-top: 2px solid #000;
                font-weight: bold;
                padding: 4px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanAgeingTypeWise">
            <colgroup>
                <col style="width:6%;" />
                <col style="width:28%;" />
                <col style="width:11%;" />
                <col style="width:14%;" />
                <col style="width:14%;" />
                <col style="width:13%;" />
                <col style="width:14%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="7">Loan Ageing Type Wise Report</td>
                </tr>

                <tr class="meta-row">
                    <td class="label" colspan="1">Branch Name:</td>
                    <td colspan="6">@branchName</td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <tr class="section-bar">
                    <td colspan="7">Report Generated On: &nbsp; @generatedOn</td>
                </tr>

                <tr class="filter-row">
                    <td colspan="7"><strong>Filter By:-</strong> Tilldate: @tillDateAd</td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <tr>
                    <th class="text-center">S.No</th>
                    <th>Loan Type</th>
                    <th class="text-center">No of Loan</th>
                    <th class="text-right">Disburse Amt</th>
                    <th class="text-right">Repaid Amt</th>
                    <th class="text-right">Balance Amt</th>
                    <th class="text-right">Overdue Amt(P)</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="detail-row">
                            <td class="text-center">@sn</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            <td class="text-center">@(row.LoanAccountNo?.ToString() ?? "0")</td>
                            <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.Repaid.HasValue ? row.Repaid.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.TotalPrincipalAmount.HasValue ? row.TotalPrincipalAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.Overdue.HasValue ? row.Overdue.Value.ToString("N2") : "")</td>
                        </tr>
                    }

                    <tr class="total-row">
                        <td colspan="2">Total:</td>
                        <td class="text-center">@totalLoans</td>
                        <td class="text-right">@totalLoanIssueAmount.ToString("N2")</td>
                        <td class="text-right">@totalRepaid.ToString("N2")</td>
                        <td class="text-right">@totalBalance.ToString("N2")</td>
                        <td class="text-right">@totalOverdue.ToString("N2")</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>