@* Views/Report/Loan/LoanAnalysisReport/LoanAgeingTypeWiseReport.cshtml *@
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanAgeingTypeWiseRowDto>) ?? new List<LoanAgeingTypeWiseRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoans = Model["TotalLoans"] as int? ?? 0;
    var totalMembers = Model["TotalMembers"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalRepaid = Model["TotalRepaid"] as decimal? ?? 0;
    var totalOverdue = Model["TotalOverdue"] as decimal? ?? 0;
    var totalGoodLoan = Model["TotalGoodLoan"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var penaltyType = Model["PenaltyType"]?.ToString() ?? "S";
    var penaltyTypeName = Model["PenaltyTypeName"]?.ToString() ?? "Schedule Wise";
    var orderBy = Model["OrderBy"]?.ToString() ?? "-1";
    var withMemberCount = Model["WithMemberCount"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Ageing Type Wise Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .positive {
                color: #006600;
            }

            .negative {
                color: #CC0000;
            }

            .penalty-badge {
                display: inline-block;
                padding: 2px 10px;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            .badge-schedule {
                background: #d1ecf1;
                color: #0c5460;
            }

            .badge-remaining {
                background: #fff3cd;
                color: #856404;
            }

            .badge-maturity {
                background: #f8d7da;
                color: #721c24;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanAgeingTypeWise">
            <colgroup>
                <col style="width:5%;" />
                <col style="width:35%;" />
                @if (withMemberCount)
                {
                    <col style="width:12%;" />
                }
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="7">Loan Ageing Type Wise Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="3">
                        <strong>Branch :</strong> @branchName
                        &nbsp;&nbsp;
                        <strong>Till Date :</strong> @tillDate
                    </td>
                    <td colspan="4" class="text-right">
                        <strong>Penalty Type :</strong>
                        <span class="penalty-badge @(penaltyType == "S" ? "badge-schedule" : penaltyType == "R" ? "badge-remaining" : "badge-maturity")">
                            @penaltyTypeName
                        </span>
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="3">
                        @if (isMemberGroupFiltered)
                        {
                            <strong>Member Group :</strong> 
                            @memberGroupName
                        }
                    </td>
                    <td colspan="4" class="text-right">
                        <strong>Report Generated On :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Loan Type</th>
                    @if (withMemberCount)
                    {
                        <th class="text-center">Member Count</th>
                    }
                    <th class="text-center">No. of Loans</th>
                    <th class="text-right">Disburse Amount</th>
                    <th class="text-right">Repaid Amount</th>
                    <th class="text-right">Overdue Amount</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td class="text-center">@sn</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            @if (withMemberCount)
                            {
                                <td class="text-center">@(row.MemberCount ?? 0)</td>
                            }
                            <td class="text-center">@(row.NoofLoan ?? 0)</td>
                            <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.Repaid.HasValue ? row.Repaid.Value.ToString("N2") : "")</td>
                            <td class="text-right @(row.Overdue.HasValue && row.Overdue.Value > 0 ? "negative" : "")">@(row.Overdue.HasValue ? row.Overdue.Value.ToString("N2") : "")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="@(withMemberCount ? 3 : 2)" class="text-right"><strong>Grand Total</strong></td>
                        @if (withMemberCount)
                        {
                            <td class="text-center"><strong>@totalMembers</strong></td>
                        }
                        <td class="text-center"><strong>@totalLoans</strong></td>
                        <td class="text-right"><strong>@totalLoanIssueAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalRepaid.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalOverdue.ToString("N2")</strong></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="@(withMemberCount ? 6 : 5)" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>