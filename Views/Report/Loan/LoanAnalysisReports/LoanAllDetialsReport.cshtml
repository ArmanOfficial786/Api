        ("priDefaulter",       "Pri Defaulter",        2.3, Align.Right, r => N2(r.PrincipleDefaulter)),
        ("intDefaulter",       "Int Defaulter",        2.3, Align.Right, r => N2(r.InterestDefaulter)),
        ("totDefaulter",       "Tot Defaulter",        2.3, Align.Right, r => N2(r.TotalDefaulter)),
    };

    // columns that get a total in the last row (key -> value to add up)
    var totalSelectors = new Dictionary<string, Func<LoanAllDetailsRowDto, decimal?>>(StringComparer.OrdinalIgnoreCase)
    {
        ["rePrincipal"] = r => r.RemainingPrinciple,
        ["defPrincipal"] = r => r.DefaultPrinciple,
        ["currInterest"] = r => r.CurrInterest,
        ["prevInterest"] = r => r.PreviousInterest,
        ["totalInterest"] = r => r.TotalInterest,
        ["currPenalty"] = r => r.CurrPenalty,
        ["prevPenalty"] = r => r.PreviousPenalty,
        ["totalPenalty"] = r => r.TotalPenalty,
        ["totalDue"] = r => r.TotalDue,
        ["totRemaining"] = r => r.TotalRemaining,
        ["priDefaulter"] = r => r.PrincipleDefaulter,
        ["intDefaulter"] = r => r.InterestDefaulter,
        ["totDefaulter"] = r => r.TotalDefaulter,
        ["instAmt"] = r => r.InstallmentAmount,
        ["provisionAmt"] = r => r.ProvisionalAmount,
    };

    // default request -> all columns, specific request -> only the selected ones (catalog order)
    var columns = showAllColumns
        ? allColumns
        : allColumns.Where(c => selectedColumns!.Contains(c.Key)).ToList();
    if (columns.Count == 0) columns = allColumns;   // nothing matched: show all

    // ── 3. COLUMNS, STYLE, SIZES ──
    var table = new ReportTable(Model, title: "Loan Detail Report", sheetName: "LoanAllDetails")
        .Column("S.N.", 1.2, Align.Center);
    foreach (var c in columns)
        table.Column(c.Header, c.Width, c.Align);

    table.Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75);

    // ── 4. TITLE BLOCK ──
    table.MetaPair("Branch :", branchName, "Till Date :", tillDate)
         .MetaPair("Report Generated On :", generatedOn, "Status :", statusName);

    // ── 5. ROWS ──
    var sn = 0;
    foreach (var r in rows)
    {
        var values = new string[columns.Count + 1];
        values[0] = (++sn).ToString();
        for (var i = 0; i < columns.Count; i++)
            values[i + 1] = columns[i].Render(r);
        table.Data(values);
    }

    // ── 6. TOTAL ──
    // label spans S.N. plus every visible column before the first totaled column;
    // each later column shows its total, or stays empty
    if (rows.Count > 0)
    {
        var firstTotalIndex = columns.FindIndex(c => totalSelectors.ContainsKey(c.Key));
        var labelSpan = firstTotalIndex < 0 ? columns.Count : firstTotalIndex + 1;   // +1 for S.N.
        var remaining = columns.Skip(labelSpan - 1).ToList();

        var totalValues = remaining.Count == 0
            ? new[] { "" }
            : remaining.Select(c => totalSelectors.TryGetValue(c.Key, out var sel)
                    ? N2(rows.Sum(r => sel(r) ?? 0))
                    : "").ToArray();

        table.Total("Total :", labelSpan, totalValues);
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())