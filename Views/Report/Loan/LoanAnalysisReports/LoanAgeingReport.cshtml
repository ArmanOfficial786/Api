@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var sections = (Model["Sections"] as List<LoanAgeingSectionDto>) ?? new List<LoanAgeingSectionDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalOverDue = Model["TotalOverDue"] as decimal? ?? 0;
    var totalPrincipalAmount = Model["TotalPrincipalAmount"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? string.Empty;
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? string.Empty;
    var collectorName = Model["CollectorName"]?.ToString() ?? string.Empty;
    var penaltyType = Model["PenaltyType"]?.ToString() ?? "S";
    var penaltyTypeName = Model["PenaltyTypeName"]?.ToString() ?? "Schedule Wise";
    var ageingOn = Model["AgeingOn"]?.ToString() ?? "P";
    var ageingOnName = Model["AgeingOnName"]?.ToString() ?? "Principle";
    var showLoanIssueDate = Model["ShowLoanIssueDate"]?.ToString() ?? "ID";
    var showLoanIssueDateName = Model["ShowLoanIssueDateName"]?.ToString() ?? "Issue Date";
    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isView = format == "VIEW";
    var isExcel = format is "EXCEL" or "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);
    var isCollectorFiltered = !string.IsNullOrEmpty(collectorName);

    const int totalCols = 11;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Ageing Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8pt;
                background: @(isView ? "#d0d0d0" : "#fff");
                color: #000;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .report-subheader {
                width: 100%;
                padding: 4px 6px 0 6px;
                background: #fff;
            }

            .subheader-title {
                text-align: center;
                font-size: 14pt;
                font-family: "Times New Roman", Times, serif;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 4px 4px;
            }

            .subheader-meta {
                display: flex;
                justify-content: space-between;
                font-size: 8pt;
                padding: 2px 6px;
            }

            .subheader-spacer {
                height: 6px;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 8pt;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 4px;
                    vertical-align: middle;
                    background: #fff;
                    font-size: 8pt;
                }

            thead {
                display: table-row-group;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .section-header td {
                background: #e8e8e8;
                font-weight: bold;
                font-size: 9pt;
                padding: 4px 6px;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .sub-total-row td {
                background: #f0f0f0;
                font-weight: bold;
                padding: 4px 6px;
                border-top: 1px solid #666;
                border-bottom: 1px solid #666;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .positive {
                color: #006600;
            }

            .negative {
                color: #CC0000;
            }

            .penalty-badge {
                display: inline-block;
                padding: 2px 10px;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            .badge-schedule {
                background: #d1ecf1;
                color: #0c5460;
            }

            .badge-remaining {
                background: #fff3cd;
                color: #856404;
            }

            .badge-maturity {
                background: #f8d7da;
                color: #721c24;
            }

            /* ── Column widths ── */
            col.c-sn {
                width: 3.5%;
            }

            col.c-mid {
                width: 8%;
            }

            col.c-name {
                width: 13%;
            }

            col.c-acno {
                width: 9%;
            }

            col.c-type {
                width: 9%;
            }

            col.c-idate {
                width: 9%;
            }

            col.c-mdate {
                width: 9%;
            }

            col.c-amt {
                width: 10%;
            }

            col.c-paid {
                width: 9%;
            }

            col.c-over {
                width: 10%;
            }

            col.c-days {
                width: 8%;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }

            /* ── VIEW chrome: horizontal-scroll paginated page cards,
                         same pattern as MemberAllDetailReport.cshtml ── */
            .view-outer {
                background: #d0d0d0;
                padding: 2px 16px 20px 16px;
                min-height: 100vh;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                cursor: grab;
            }

                .view-outer:active {
                    cursor: grabbing;
                }

            .view-page {
                background: #fff;
                margin: 0 auto 24px auto;
                box-shadow: 0 2px 8px rgba(0,0,0,.18);
                width: 2200px;
                height: 1587px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-page-content {
                flex: 1;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-page-footer {
                background: #fff;
                border-top: 1px solid #ccc;
                text-align: center;
                font-size: 9pt;
                font-weight: bold;
                padding: 6px 0;
                flex-shrink: 0;
            }

            .common-header-wrap {
                width: 2200px;
                overflow: hidden;
                flex-shrink: 0;
            }

            .page-subheader {
                flex-shrink: 0;
            }

            .page-table-wrap {
                flex: 1;
                overflow: hidden;
            }

            #sourceWrap {
                opacity: 0;
                pointer-events: none;
                width: 2200px;
                position: absolute;
                top: 0;
                left: 0;
            }

            #commonHeaderSource {
                visibility: hidden;
                position: absolute;
                top: 0;
                left: 0;
                width: 2200px;
                pointer-events: none;
            }
    </style>
</head>
<body>

    @if (!isExcel)
    {
        <div id="commonHeaderSource">
            @await Html.PartialAsync("_CommonHeader", Model)
        </div>
    }

    @if (isView)
    {
        <div id="sourceWrap">
            <div id="subheaderTemplate" class="report-subheader">
                <div class="subheader-title">Loan Ageing Report</div>
                <div class="subheader-meta">
                    <span>
                        <strong>Branch :</strong> @branchName
                        &nbsp;&nbsp;
                        <strong>Till Date :</strong> @tillDate
                    </span>
                    <span>
                        <strong>Penalty Type :</strong> @penaltyTypeName
                        &nbsp;&nbsp;
                        <strong>Ageing On :</strong> @ageingOnName
                    </span>
                </div>
                <div class="subheader-meta">
                    <span>
                        @if (isMemberGroupFiltered)
                        {
                            <strong>Member Group :</strong>
                            @(memberGroupName)
                        }
                        @if (isCollectorFiltered)
                        {
                            <text>&nbsp;&nbsp;</text>
                            <strong>Collector :</strong>
                            @(collectorName)
                        }
                    </span>
                    <span>
                        <strong>Date On :</strong> @showLoanIssueDateName
                        &nbsp;&nbsp;
                        <strong>Report Generated On :</strong> @generatedOn
                    </span>
                </div>
                <div class="subheader-spacer"></div>
            </div>

            <table class="data-table" id="mainTable">
                <colgroup>
                    <col class="c-sn" />
                    <col class="c-mid" />
                    <col class="c-name" />
                    <col class="c-acno" />
                    <col class="c-type" />
                    <col class="c-idate" />
                    <col class="c-mdate" />
                    <col class="c-amt" />
                    <col class="c-paid" />
                    <col class="c-over" />
                    <col class="c-days" />
                </colgroup>
                <thead>
                    <tr id="colHeaderRow">
                        <th class="text-center">S.N.</th>
                        <th>Member Id</th>
                        <th>Full Name</th>
                        <th>Loan A/c No</th>
                        <th>Loan Type</th>
                        <th>Issue Date</th>
                        <th>Maturity Date</th>
                        <th class="text-right">Loan Amount</th>
                        <th class="text-right">Paid</th>
                        <th class="text-right">Overdue</th>
                        <th class="text-center">Due Days</th>
                    </tr>
                </thead>
                <tbody>
                    @if (sections.Any() && sections.SelectMany(s => s.Rows).Any())
                    {
                        foreach (var grp in sections)
                        {
                            if (!grp.Rows.Any()) { continue; }

                            <tr class="detail-row section-header">
                                <td colspan="11"><strong>@(grp.SectionName)</strong></td>
                            </tr>

                            var sn = 0;
                            foreach (var row in grp.Rows)
                            {
                                sn++;
                                <tr class="detail-row @(sn % 2 == 0 ? "" : "detail-row-alt")">
                                    <td class="text-center">@sn</td>
                                    <td>@(row.MemberId ?? string.Empty)</td>
                                    <td>@(row.FullName ?? string.Empty)</td>
                                    <td>@(row.LoanAccountNo ?? string.Empty)</td>
                                    <td>@(row.LoanTypeName ?? string.Empty)</td>
                                    <td>@(row.LoanIssueOnBs ?? string.Empty)</td>
                                    <td>@(row.MaturityOnBs ?? string.Empty)</td>
                                    <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : string.Empty)</td>
                                    <td class="text-right">@(row.PrinciplePaidAmt.HasValue ? row.PrinciplePaidAmt.Value.ToString("N2") : string.Empty)</td>
                                    <td class="text-right @(row.OverDue.HasValue && row.OverDue.Value > 0 ? "negative" : "")">@(row.OverDue.HasValue ? row.OverDue.Value.ToString("N2") : string.Empty)</td>
                                    <td class="text-center">@(row.DueDays ?? 0)</td>
                                </tr>
                            }

                            <tr class="detail-row sub-total-row">
                                <td colspan="7" class="text-right"><strong>@(grp.SectionName) Sub Total</strong></td>
                                <td class="text-right"><strong>@(grp.TotalLoanIssueAmount.ToString("N2"))</strong></td>
                                <td></td>
                                <td class="text-right"><strong>@(grp.TotalOverDue.ToString("N2"))</strong></td>
                                <td class="text-center"><strong>@(grp.TotalRecords)</strong></td>
                            </tr>
                        }
                    }

                    <tr class="grand-total" id="grandTotalRow">
                        <td colspan="7" class="text-right">Grand Total</td>
                        <td class="text-right">@totalLoanIssueAmount.ToString("N2")</td>
                        <td></td>
                        <td class="text-right">@totalOverDue.ToString("N2")</td>
                        <td class="text-center">@totalRecords</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="view-outer" id="viewOuter"></div>
    }

    @if (!isView)
    {
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)

            <div class="report-subheader">
                <div class="subheader-title">Loan Ageing Report</div>
                <div class="subheader-meta">
                    <span>
                        <strong>Branch :</strong> @branchName
                        &nbsp;&nbsp;
                        <strong>Till Date :</strong> @tillDate
                    </span>
                    <span>
                        <strong>Penalty Type :</strong> @penaltyTypeName
                        &nbsp;&nbsp;
                        <strong>Ageing On :</strong> @ageingOnName
                    </span>
                </div>
                <div class="subheader-meta">
                    <span>
                        @if (isMemberGroupFiltered)
                        {
                            <strong>Member Group :</strong>
                            @(memberGroupName)
                        }
                        @if (isCollectorFiltered)
                        {
                            <text>&nbsp;&nbsp;</text>
                            <strong>Collector :</strong>
                            @(collectorName)
                        }
                    </span>
                    <span>
                        <strong>Date On :</strong> @showLoanIssueDateName
                        &nbsp;&nbsp;
                        <strong>Report Generated On :</strong> @generatedOn
                    </span>
                </div>
                <div class="subheader-spacer"></div>
            </div>
        }

        <table class="data-table" id="mainTable"
            @(isExcel ? Html.Raw("data-sheet-name=\"LoanAgeing\"") : Html.Raw(""))>
            <colgroup>
                <col class="c-sn" />
                <col class="c-mid" />
                <col class="c-name" />
                <col class="c-acno" />
                <col class="c-type" />
                <col class="c-idate" />
                <col class="c-mdate" />
                <col class="c-amt" />
                <col class="c-paid" />
                <col class="c-over" />
                <col class="c-days" />
            </colgroup>
            @if (isExcel)
            {
                <thead>
                    <tr class="text-center"><td colspan="@totalCols"><strong>Loan Ageing Report</strong></td></tr>
                    <tr><td colspan="@totalCols"><strong>Branch :</strong> @branchName &nbsp;&nbsp; <strong>Till Date :</strong> @tillDate</td></tr>
                    <tr><td colspan="@totalCols"></td></tr>
                    <tr>
                        <th class="text-center">S.N.</th>
                        <th>Member Id</th>
                        <th>Full Name</th>
                        <th>Loan A/c No</th>
                        <th>Loan Type</th>
                        <th>Issue Date</th>
                        <th>Maturity Date</th>
                        <th class="text-right">Loan Amount</th>
                        <th class="text-right">Paid</th>
                        <th class="text-right">Overdue</th>
                        <th class="text-center">Due Days</th>
                    </tr>
                </thead>
            }
            else
            {
                <thead>
                    <tr>
                        <th class="text-center">S.N.</th>
                        <th>Member Id</th>
                        <th>Full Name</th>
                        <th>Loan A/c No</th>
                        <th>Loan Type</th>
                        <th>Issue Date</th>
                        <th>Maturity Date</th>
                        <th class="text-right">Loan Amount</th>
                        <th class="text-right">Paid</th>
                        <th class="text-right">Overdue</th>
                        <th class="text-center">Due Days</th>
                    </tr>
                </thead>
            }
            <tbody>
                @if (sections.Any() && sections.SelectMany(s => s.Rows).Any())
                {
                    foreach (var grp in sections)
                    {
                        if (!grp.Rows.Any()) { continue; }

                        <tr class="section-header">
                            <td colspan="11"><strong>@(grp.SectionName)</strong></td>
                        </tr>

                        var sn = 0;
                        foreach (var row in grp.Rows)
                        {
                            sn++;
                            <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                                <td class="text-center">@sn</td>
                                <td>@(row.MemberId ?? string.Empty)</td>
                                <td>@(row.FullName ?? string.Empty)</td>
                                <td>@(row.LoanAccountNo ?? string.Empty)</td>
                                <td>@(row.LoanTypeName ?? string.Empty)</td>
                                <td>@(row.LoanIssueOnBs ?? string.Empty)</td>
                                <td>@(row.MaturityOnBs ?? string.Empty)</td>
                                <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : string.Empty)</td>
                                <td class="text-right">@(row.PrinciplePaidAmt.HasValue ? row.PrinciplePaidAmt.Value.ToString("N2") : string.Empty)</td>
                                <td class="text-right @(row.OverDue.HasValue && row.OverDue.Value > 0 ? "negative" : "")">@(row.OverDue.HasValue ? row.OverDue.Value.ToString("N2") : string.Empty)</td>
                                <td class="text-center">@(row.DueDays ?? 0)</td>
                            </tr>
                        }

                        <tr class="sub-total-row">
                            <td colspan="7" class="text-right"><strong>@(grp.SectionName) Sub Total</strong></td>
                            <td class="text-right"><strong>@(grp.TotalLoanIssueAmount.ToString("N2"))</strong></td>
                            <td></td>
                            <td class="text-right"><strong>@(grp.TotalOverDue.ToString("N2"))</strong></td>
                            <td class="text-center"><strong>@(grp.TotalRecords)</strong></td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="7" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalLoanIssueAmount.ToString("N2")</strong></td>
                        <td></td>
                        <td class="text-right"><strong>@totalOverDue.ToString("N2")</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (isView)
    {
        <script>
                (function () {
                    'use strict';
                    var MAX_RETRIES = 5, RETRY_DELAY = 80, retryCount = 0;
                    var PAGE_W = 2200, PAGE_H = 1587, FOOTER_H = 28;

                    function buildPages() {
                        var tbl = document.getElementById('mainTable');
                        var colHdrRow = document.getElementById('colHeaderRow');
                        var grandTotalEl = document.getElementById('grandTotalRow');
                        var subHdrTpl = document.getElementById('subheaderTemplate');

                        if (!tbl || !colHdrRow || !subHdrTpl) {
                            if (retryCount++ < MAX_RETRIES) setTimeout(function () { requestAnimationFrame(buildPages); }, RETRY_DELAY);
                            return;
                        }

                        var colHdrH = colHdrRow.getBoundingClientRect().height;
                        var subHdrH = subHdrTpl.getBoundingClientRect().height;
                        var gtH = grandTotalEl ? grandTotalEl.getBoundingClientRect().height : 0;
                        var gtHtml = grandTotalEl ? grandTotalEl.outerHTML : '';

                        var commonHdrEl = document.getElementById('commonHeaderSource');
                        var commonHdrHtml = commonHdrEl ? commonHdrEl.innerHTML : '';
                        var commonHdrH = commonHdrEl ? commonHdrEl.getBoundingClientRect().height : 0;

                        // All rows — section headers, detail rows, sub-totals — carry
                        // .detail-row so they're all paginated together in document order.
                        var detailRows = tbl.querySelectorAll('tbody > tr.detail-row');
                        var rowData = Array.from(detailRows).map(function (r) {
                            return { html: r.outerHTML, h: r.getBoundingClientRect().height };
                        });

                        var allZero = rowData.length > 0 && rowData.every(function (r) { return r.h === 0; });
                        if (allZero) {
                            if (retryCount++ < MAX_RETRIES) setTimeout(function () { requestAnimationFrame(buildPages); }, RETRY_DELAY);
                            return;
                        }

                        var colgroupHtml = tbl.querySelector('colgroup').outerHTML;
                        var colHdrHtml = colHdrRow.outerHTML;
                        var subHdrHtml = subHdrTpl.outerHTML;

                        var availP1 = PAGE_H - FOOTER_H - commonHdrH - subHdrH - colHdrH;
                        var availPN = PAGE_H - FOOTER_H - colHdrH;

                        var pages = [], cur = [], usedH = 0, isFirstPage = true;
                        for (var i = 0; i < rowData.length; i++) {
                            var rh = rowData[i].h || 14;
                            var avail = isFirstPage ? availP1 : availPN;
                            var extra = (i === rowData.length - 1) ? gtH : 0;
                            if (cur.length > 0 && usedH + rh + extra > avail) {
                                pages.push(cur); cur = []; usedH = 0; isFirstPage = false;
                            }
                            cur.push(i); usedH += rh;
                        }
                        pages.push(cur);
                        var totalPages = pages.length;

                        var sourceWrap = document.getElementById('sourceWrap');
                        if (sourceWrap) sourceWrap.parentNode.removeChild(sourceWrap);
                        if (commonHdrEl) commonHdrEl.parentNode.removeChild(commonHdrEl);

                        var viewOuter = document.getElementById('viewOuter');
                        var fragment = document.createDocumentFragment();

                        for (var p = 0; p < totalPages; p++) {
                            var card = document.createElement('div');
                            card.className = 'view-page';
                            card.setAttribute('data-page', String(p + 1));

                            var contentHtml = '<div class="view-page-content">';
                            if (p === 0 && commonHdrHtml) contentHtml += '<div class="common-header-wrap">' + commonHdrHtml + '</div>';
                            if (p === 0) contentHtml += '<div class="page-subheader">' + subHdrHtml + '</div>';

                            contentHtml += '<div class="page-table-wrap">'
                                         + '<table class="data-table" style="width:' + PAGE_W + 'px;">'
                                         + colgroupHtml
                                         + '<thead>' + colHdrHtml + '</thead>'
                                         + '<tbody>';

                            var pageRows = pages[p];
                            for (var r = 0; r < pageRows.length; r++) contentHtml += rowData[pageRows[r]].html;
                            if (p === totalPages - 1 && gtHtml) contentHtml += gtHtml;

                            contentHtml += '</tbody></table></div></div>';
                            contentHtml += '<div class="view-page-footer">Page ' + (p + 1) + ' of ' + totalPages + '</div>';

                            card.innerHTML = contentHtml;
                            fragment.appendChild(card);
                        }

                        viewOuter.appendChild(fragment);

                        (function (el) {
                            var drag = false, sx = 0, ss = 0;
                            el.addEventListener('mousedown', function (e) {
                                if (e.button !== 0) return;
                                drag = true; sx = e.clientX; ss = el.scrollLeft;
                                el.style.userSelect = 'none'; e.preventDefault();
                            });
                            document.addEventListener('mousemove', function (e) { if (drag) el.scrollLeft = ss - (e.clientX - sx); });
                            document.addEventListener('mouseup', function () { drag = false; el.style.userSelect = ''; });
                        })(viewOuter);

                        window.scrollToPage = function (pageNumber) {
                            var target = document.querySelector('.view-page[data-page="' + pageNumber + '"]');
                            if (!target) return;
                            window.scrollTo({ top: target.offsetTop, behavior: 'smooth' });
                        };

                        if (window.parent && window.parent !== window) {
                            window.parent.postMessage({ type: 'REPORT_PAGES_READY', totalPages: totalPages }, '*');
                        }
                    }

                    requestAnimationFrame(function () { requestAnimationFrame(buildPages); });
                }());
        </script>
    }
</body>
</html>