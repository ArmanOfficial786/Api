@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "6.5pt";
    var metaFontSize = "8pt";
    var nepaliDigits = false;

    var isNepali = Model.TryGetValue("IsNepaliReport", out var nf) && nf is bool nb && nb;
    string L(string en, string ne) => isNepali ? ne : en;

    string Nd(string? s)
    {
        if (!isNepali || !nepaliDigits || string.IsNullOrEmpty(s)) return s ?? "";
        const string map = "०१२३४५६७८९";
        return new string(s.Select(c => c >= '0' && c <= '9' ? map[c - '0'] : c).ToArray());
    }

    string Pick(string? en, string? ne) => isNepali && !string.IsNullOrWhiteSpace(ne) ? ne! : (en ?? "");

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    bool IsOverdraft(LoanAgeingRowDto r) => string.Equals(r.LoanODorNormal, "O", StringComparison.OrdinalIgnoreCase);

    string SectionTitle(string? name) => name switch
    {
        "Greater than 365 Days" => L("Defaulter Greater Than 12 Months (Bad Loan):", "१२ महिना भन्दा बढी म्याद नाघेको (खराब ऋण):"),
        _ => (name ?? "") + ":"
    };

    int SectionRank(string? name) => name switch
    {
        "Greater than 365 Days" => 0,
        "181 to 365 Days" => 1,
        "91 to 180 Days" => 2,
        "1 to 90 Days" => 3,
        _ => 4
    };

    var sections = (Model["Sections"] as IEnumerable<LoanAgeingSectionDto>)?
        .Where(s => s.Rows.Any())
        .OrderBy(s => SectionRank(s.SectionName))
        .ToList()
        ?? new List<LoanAgeingSectionDto>();
    var allRows = sections.SelectMany(s => s.Rows).ToList();

    var branchName = Text("BranchName", "All");
    var memberGroupName = Text("MemberGroupName");
    var collectorName = Text("CollectorName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = Model.TryGetValue("TotalRecords", out var tr) && tr != null && Convert.ToInt32(tr) > 0
        ? Convert.ToInt32(tr)
        : allRows.Count;
    var totalDisburse = TotalOr("TotalLoanIssueAmount", allRows.Sum(x => x.LoanIssueAmount ?? 0));
    var totalBalance = TotalOr("TotalPrincipalAmount", allRows.Sum(x => x.TotalPrincipalAmount ?? 0));
    var totalOverDue = TotalOr("TotalOverDue", allRows.Sum(x => x.OverDue ?? 0));

    var nepaliFont = isNepali
        ? "table.sheet-table, table.sheet-table th, table.sheet-table td { font-family: 'Mukta', 'Noto Sans Devanagari', 'Mangal', 'Nirmala UI', Arial, sans-serif; }\n"
        : "";

    var table = new ReportTable(Model, title: L("Loan Ageing Report", "ऋण एजिङ प्रतिवेदन"), sheetName: "LoanAgeing")
        .Column(L("S.N.", "क्र.सं."), 3, Align.Center)
        .Column(L("Member Id", "सदस्य नं."), 6.5)
        .Column(L("Member Name", "सदस्यको नाम"), 8)
        .Column(L("Contact Address", "सम्पर्क ठेगाना"), 7)
        .Column(L("Contact No", "सम्पर्क नं."), 7)
        .Column(L("A/C No", "खाता नं."), 6.5)
        .Column(L("Payment Mode", "भुक्तानी तरिका"), 5.5)
        .Column(L("Loan Type", "ऋणको किसिम"), 7)
        .Column(L("Loan Guarantee", "ऋण धितो"), 7.5)
        .Column(L("Issue Date", "ऋण जारी मिति"), 5.5)
        .Column(L("Maturity Date", "म्याद मिति"), 5.5)
        .Column(L("Disburse Amt", "ऋण रकम"), 7.5, Align.Right)
        .Column(L("Balance Amt", "बाँकी रकम"), 7.5, Align.Right)
        .Column(L("From Inst No", "किस्ता नं. देखि"), 4, Align.Center)
        .Column(L("Default Date", "म्याद नाघेको मिति"), 5.5)
        .Column(L("Over Due", "म्याद नाघेको रकम"), 7.5, Align.Right)
        .Sizing(rowMm: 8.5, headerMm: 9, firstPageExtraMm: 60)
        .Css(
            nepaliFont +
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-section td, " +
            "table.sheet-table tr.r-subtotal td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 2px 3px; }\n" +
            "table.sheet-table tr.meta-row td { font-size: " + metaFontSize + "; }\n" +
            @"
            table.sheet-table tr.r-data td.negative { color: #CC0000; }");

    var filterParts = new List<IHtmlContent>();
    if (!string.IsNullOrEmpty(memberGroupName)) filterParts.Add(Fmt.Labeled(L("Member Group :", "सदस्य समूह :"), memberGroupName));
    if (!string.IsNullOrEmpty(collectorName)) filterParts.Add(Fmt.Labeled(L("Collector :", "संकलक :"), collectorName));

    table.MetaRow(Fmt.Labeled(L("Branch Name :", "शाखाको नाम :"), branchName));
    if (filterParts.Count > 0) table.MetaRow(Fmt.Join(filterParts.ToArray()));
    table.MetaRow(Fmt.Labeled(L("Report Generated On :", "प्रतिवेदन तयार मिति :"), Nd(generatedOn)));

    foreach (var section in sections)
    {
        table.Section(SectionTitle(section.SectionName));

        var sn = 0;
        foreach (var row in section.Rows)
        {
            var od = IsOverdraft(row);

            table.Data(new[]
            {
                ReportCell.Center(Nd((++sn).ToString())),
                ReportCell.Left(row.MemberId ?? ""),
                ReportCell.Left(Pick(row.FullName, row.NameInNepali)),
                ReportCell.Left(Pick(row.ContactAddress, row.AddressInNepali)),
                ReportCell.Left(Nd(row.ContactNo)),
                ReportCell.Left(row.LoanAccountNo ?? ""),
                ReportCell.Left(Pick(row.PaymentMode, row.PaymentDurationTypeInNepali)),
                ReportCell.Left(Pick(row.LoanTypeName, row.LoanTypeNameInNepali)),
                ReportCell.Left(row.LoanGuarantee ?? ""),
                ReportCell.Left(Nd(row.LoanIssueOnBs)),
                ReportCell.Left(od ? Nd(row.MaturityOnBs) : ""),
                ReportCell.Right(Nd(Fmt.Amount(row.LoanIssueAmount))),
                ReportCell.Right(Nd(Fmt.Amount(row.TotalPrincipalAmount))),
                ReportCell.Center(Nd((row.InstallmentNo ?? 0).ToString())),
                ReportCell.Left(od ? Nd(row.DefaultDateBs) : ""),
                new ReportCell(Nd(Fmt.Amount(row.OverDue)), Align.Right, 1, row.OverDue > 0 ? "negative" : null)
            });
        }

        table.SubTotal((section.SectionName ?? "") + L(" Sub Total", " उप-जम्मा") + " (" + Nd(section.TotalRecords.ToString()) + ")", 11,
            Nd(Fmt.Amount(section.TotalLoanIssueAmount)),
            Nd(Fmt.Amount(section.TotalPrincipalAmount)),
            "",
            "",
            Nd(Fmt.Amount(section.TotalOverDue)));
    }

    if (allRows.Count > 0)
    {
        table.Total(L("Grand Total", "कुल जम्मा") + " (" + Nd(totalRecords.ToString()) + ")", 11,
            Nd(Fmt.Amount(totalDisburse)),
            Nd(Fmt.Amount(totalBalance)),
            "",
            "",
            Nd(Fmt.Amount(totalOverDue)));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())