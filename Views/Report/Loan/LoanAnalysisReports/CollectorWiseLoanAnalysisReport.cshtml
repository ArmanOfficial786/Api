@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<CollectorWiseLoanAnalysisSummaryRowDto>) ?? new List<CollectorWiseLoanAnalysisSummaryRowDto>();
    var leafRows = rows.Where(r => !r.IsGroupHeader).ToList();
    var hasHeaders = rows.Any(r => r.IsGroupHeader);

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalOpening = TotalOr("TotalOpeningBalance", leafRows.Sum(r => r.OpeningBalance));
    var totalOpeningCount = (int)TotalOr("TotalOpeningActiveCount", leafRows.Sum(r => r.OpeningActiveCount));
    var totalDisburse = TotalOr("TotalDisburseAmount", leafRows.Sum(r => r.DisburseAmount));
    var totalPayment = TotalOr("TotalPaymentAmount", leafRows.Sum(r => r.PaymentAmount));
    var totalBalance = TotalOr("TotalBalanceAmount", leafRows.Sum(r => r.BalanceAmount));
    var totalBalanceCount = (int)TotalOr("TotalBalanceActiveCount", leafRows.Sum(r => r.BalanceActiveCount));
    var totalClosing = TotalOr("TotalClosingBalance", leafRows.Sum(r => r.ClosingBalance));
    var totalClosingCount = (int)TotalOr("TotalClosingActiveCount", leafRows.Sum(r => r.ClosingActiveCount));
    var totalGood = TotalOr("TotalGoodAmt", leafRows.Sum(r => r.GoodAmt));
    var totalDue = TotalOr("TotalDueAmt", leafRows.Sum(r => r.DueAmt));
    var totalDue1To365 = TotalOr("TotalDue1To365", leafRows.Sum(r => r.Due1To365));
    var totalDueGt365 = TotalOr("TotalDueGt365", leafRows.Sum(r => r.DueGt365));

    string Pct(decimal amount, decimal closing) => closing == 0 ? "0.00" : (amount / closing * 100m).ToString("N2");

    var table = new ReportTable(Model, title: "Collector Wise Loan Analysis Report", sheetName: "CollectorWiseLoanAnalysis")
        .Column("Loan Type", 12)
        .Column("Open Bal", 8, Align.Right)
        .Column("Open Cnt", 5, Align.Center)
        .Column("Disburse", 9, Align.Right)
        .Column("Payment", 9, Align.Right)
        .Column("Bal Amt", 9, Align.Right)
        .Column("Bal Cnt", 5, Align.Center)
        .Column("Close Bal", 9, Align.Right)
        .Column("Close Cnt", 5, Align.Center)
        .Column("Good Amt", 6, Align.Right)
        .Column("Good %", 4, Align.Right)
        .Column("Due Amt", 6, Align.Right)
        .Column("Due %", 4, Align.Right)
        .Column("1-365 Amt", 6, Align.Right)
        .Column("1-365 %", 4, Align.Right)
        .Column(">365 Amt", 6, Align.Right)
        .Column(">365 %", 4, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6.5, headerMm: 8, firstPageExtraMm: 75)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 4px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; text-align: center; }\n" +
            "table.sheet-table tr.r-data td { color: #1a3d7c; }\n" +
            @"
            table.sheet-table tr.r-data td:first-child {
                white-space: normal !important;
                overflow: visible !important;
                text-overflow: clip !important;
                overflow-wrap: break-word;
                height: auto !important;
                vertical-align: top;
            }
            table.sheet-table tr.r-data td.grp { font-weight: bold; color: #000; }
            table.sheet-table tr.r-data td.lt:first-child { padding-left: 18px; font-size: 7pt; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    table.MetaRow(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    foreach (var r in rows)
    {
        // collector rows are bold; loan-type rows under a collector are indented
        string? css = r.IsGroupHeader ? "grp" : (hasHeaders ? "lt" : null);

        ReportCell C(string text, Align align) => new ReportCell(text, align, 1, css);

        table.Data(new[]
        {
            C(r.GroupName ?? "", Align.Left),
            C(Fmt.Amount(r.OpeningBalance), Align.Right),
            C(r.OpeningActiveCount.ToString(), Align.Center),
            C(Fmt.Amount(r.DisburseAmount), Align.Right),
            C(Fmt.Amount(r.PaymentAmount), Align.Right),
            C(Fmt.Amount(r.BalanceAmount), Align.Right),
            C(r.BalanceActiveCount.ToString(), Align.Center),
            C(Fmt.Amount(r.ClosingBalance), Align.Right),
            C(r.ClosingActiveCount.ToString(), Align.Center),
            C(Fmt.Amount(r.GoodAmt), Align.Right),
            C(Pct(r.GoodAmt, r.ClosingBalance), Align.Right),
            C(Fmt.Amount(r.DueAmt), Align.Right),
            C(Pct(r.DueAmt, r.ClosingBalance), Align.Right),
            C(Fmt.Amount(r.Due1To365), Align.Right),
            C(Pct(r.Due1To365, r.ClosingBalance), Align.Right),
            C(Fmt.Amount(r.DueGt365), Align.Right),
            C(Pct(r.DueGt365, r.ClosingBalance), Align.Right)
        });
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total :", 1,
            Fmt.Amount(totalOpening), totalOpeningCount.ToString(),
            Fmt.Amount(totalDisburse), Fmt.Amount(totalPayment),
            Fmt.Amount(totalBalance), totalBalanceCount.ToString(),
            Fmt.Amount(totalClosing), totalClosingCount.ToString(),
            Fmt.Amount(totalGood), Pct(totalGood, totalClosing),
            Fmt.Amount(totalDue), Pct(totalDue, totalClosing),
            Fmt.Amount(totalDue1To365), Pct(totalDue1To365, totalClosing),
            Fmt.Amount(totalDueGt365), Pct(totalDueGt365, totalClosing));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())