@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    // ── 1. DATA (set by the controller) ──
    var agingRows = (Model["Rows"] as List<LoanAgingRiskCalculationRowDto>) ?? new();
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalBalanceAmount = Model["TotalBalanceAmount"] as decimal? ?? 0;
    var totalOverDue = Model["TotalOverDue"] as decimal? ?? 0;
    var totalGoodLoan = Model["TotalGoodLoan"] as decimal? ?? 0;
    var totalArrear = Model["TotalArrear"] as decimal? ?? 0;
    var totalFrom1To365 = Model["TotalFrm1to365"] as decimal? ?? 0;
    var totalGreaterThan365 = Model["TotalGrtthan365"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "All";
    var penaltyType = Model["PenaltyType"]?.ToString() ?? "S";
    var penaltyTypeName = Model["PenaltyTypeName"]?.ToString() ?? "Schedule Wise";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var memberGroupFiltered = !string.IsNullOrEmpty(memberGroupName) && memberGroupName != "All";

    var badgeClass = penaltyType == "S" ? "badge-schedule" : penaltyType == "R" ? "badge-remaining" : "badge-maturity";

    // ── 2. COLUMNS, STYLE, SIZES ──
    var table = new ReportTable(Model, title: "Loan Ageing Risk Calculation Report", sheetName: "LoanAgingRiskCalculation")
        .Column("Member Id", 9)
        .Column("Full Name", 14)
        .Column("Loan A/c No", 10)
        .Column("Loan Amount", 9, Align.Right)
        .Column("Paid", 9, Align.Right)
        .Column("Balance", 9, Align.Right)
        .Column("Good Loan", 9, Align.Center)
        .Column("Arrear", 7, Align.Right)
        .Column("Overdue", 7, Align.Right)
        .Column("1-365", 7, Align.Right)
        .Column(">365", 7, Align.Right)
        .Column("Days", 7, Align.Center)
        .Column("Last Payment", 9)
        //.Style(new ReportStyle { ZebraBackground = "#f9f9f9" })
        //.Sizing(rowMm: 7, headerMm: 8, firstPageExtraMm: 75)
        .Css(@"
            table.sheet-table tr.r-data td.negative { color: #CC0000; }
            .penalty-badge { display: inline-block; padding: 2px 10px; border-radius: 3px; font-size: 8pt; font-weight: bold; }
            .badge-schedule  { background: #d1ecf1; color: #0c5460; }
            .badge-remaining { background: #fff3cd; color: #856404; }
            .badge-maturity  { background: #f8d7da; color: #721c24; }");

    // ── 3. TITLE BLOCK ──
    table.MetaRow(
             Fmt.Join(Fmt.Labeled("Branch :", branchName), Fmt.Labeled("Till Date :", tillDate)),
             Fmt.Labeled("Penalty Type :", Fmt.Badge(penaltyTypeName, $"penalty-badge {badgeClass}")),
             leftSpan: 5)
         .MetaRow(
             memberGroupFiltered ? Fmt.Labeled("Member Group :", memberGroupName) : new HtmlString(""),
             Fmt.Labeled("Report Generated On :", generatedOn),
             leftSpan: 5);

    // ── 4. ROWS ──
    foreach (var agingRow in agingRows)
    {
        var overdueIsPositive = agingRow.OverDue.HasValue && agingRow.OverDue.Value > 0;

        table.Data(
            ReportCell.Left(agingRow.MemberId ?? ""),
            ReportCell.Left(agingRow.FullName ?? ""),
            ReportCell.Left(agingRow.LoanAccountNo ?? ""),
            ReportCell.Right(Fmt.Amount(agingRow.LoanIssueAmount)),
            ReportCell.Right(Fmt.Amount(agingRow.PaidAmount)),
            ReportCell.Right(Fmt.Amount(agingRow.BalanceAmount)),
            ReportCell.Right(Fmt.Amount(agingRow.Goodloan)),
            ReportCell.Right(Fmt.Amount(agingRow.Arrear)),
            new ReportCell(Fmt.Amount(agingRow.OverDue), Align.Right, 1, overdueIsPositive ? "negative" : null),
            ReportCell.Right(Fmt.Amount(agingRow.Frm1to365)),
            ReportCell.Right(Fmt.Amount(agingRow.Grtrhan365)),
            ReportCell.Center(Fmt.Int(agingRow.Noofdays ?? 0)),
            ReportCell.Left(agingRow.LastPaymentDate ?? ""));
    }

    if (agingRows.Any())
    {
        // label spans Member Id, Full Name and Loan A/c No; the 10 values fill the rest (Paid, Days and Last Payment stay empty)
        table.Total("Grand Total", 3,
            Fmt.Amount(totalLoanIssueAmount),
            "",
            Fmt.Amount(totalBalanceAmount),
            Fmt.Amount(totalGoodLoan),
            Fmt.Amount(totalArrear),
            Fmt.Amount(totalOverDue),
            Fmt.Amount(totalFrom1To365),
            Fmt.Amount(totalGreaterThan365),
            "",
            "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())
