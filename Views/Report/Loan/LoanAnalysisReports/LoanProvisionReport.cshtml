
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanProvisionRowDto>) ?? new List<LoanProvisionRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var totalProvisionAmount = Model["TotalProvisionAmount"] as decimal? ?? 0;
    var totalLoans = Model["TotalLoans"] as int? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "All";
    var penaltyType = Model["PenaltyType"]?.ToString() ?? "S";
    var penaltyTypeName = Model["PenaltyTypeName"]?.ToString() ?? "Schedule Wise";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName) && memberGroupName != "All";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Provision Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .positive {
                color: #006600;
            }

            .negative {
                color: #CC0000;
            }

            .penalty-badge {
                display: inline-block;
                padding: 2px 10px;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            .badge-schedule {
                background: #d1ecf1;
                color: #0c5460;
            }

            .badge-remaining {
                background: #fff3cd;
                color: #856404;
            }

            .badge-maturity {
                background: #f8d7da;
                color: #721c24;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanProvision">
            <colgroup>
                <col style="width:8%;" />
                <col style="width:30%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:19%;" />
                <col style="width:19%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="6">Loan Provision Report</td>
                </tr>

                <!-- Metadata -->
                <tr class="meta-row">
                    <td colspan="3"><strong>Branch :</strong> @branchName</td>
                    <td colspan="3" class="text-right">
                        <strong>Till Date :</strong> @tillDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="3">
                        <strong>Penalty Type :</strong>
                        <span class="penalty-badge @(penaltyType == "S" ? "badge-schedule" : penaltyType == "R" ? "badge-remaining" : "badge-maturity")">
                            @penaltyTypeName
                        </span>
                    </td>
                    <td colspan="3" class="text-right">
                        @if (isMemberGroupFiltered)
                        {
                            <strong>Member Group :</strong> 
                            @memberGroupName
                            <text>&nbsp;&nbsp;&nbsp;</text>
                        }
                        <strong>Report Generated On :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="6"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Provision Name</th>
                    <th class="text-right">Provision %</th>
                    <th class="text-center">No. of Loans</th>
                    <th class="text-right">Amount</th>
                    <th class="text-right">Provision Amount</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td class="text-center">@sn</td>
                            <td>@(row.ProvisionName ?? "")</td>
                            <td class="text-right">@(row.ProvisionPercentage.HasValue ? row.ProvisionPercentage.Value.ToString("N2") : "")</td>
                            <td class="text-center">@(row.NoofLoan ?? 0)</td>
                            <td class="text-right">@(row.Amount.HasValue ? row.Amount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.ProvisionAmount.HasValue ? row.ProvisionAmount.Value.ToString("N2") : "")</td>
                        </tr>
                    }

                    <!-- Grand Total Row -->
                    <tr class="grand-total-row">
                        <td colspan="3" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-center"><strong>@totalLoans</strong></td>
                        <td class="text-right"><strong>@totalAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalProvisionAmount.ToString("N2")</strong></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="5" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>