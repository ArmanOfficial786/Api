@using Microsoft.AspNetCore.Html
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "7.5pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<LoanCICRowDto>) ?? new List<LoanCICRowDto>();

    var tillDate = !string.IsNullOrEmpty(Text("TillDateAd")) ? Text("TillDateAd") : Text("TillDate");
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // ── totals (from the controller, or summed from the rows) ──
    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalIssue = TotalOr("TotalLoanIssueAmount", rows.Sum(r => r.LoanIssueAmount ?? 0));
    var totalPrincipal = TotalOr("TotalPriBalance", rows.Sum(r => r.PriBalance ?? 0));
    var totalInterest = TotalOr("TotalIntBalance", rows.Sum(r => r.IntBalance ?? 0));
    var totalGood = TotalOr("TotalGoodLoan", rows.Sum(r => r.GoodLoan ?? 0));
    var totalRisk1To365 = TotalOr("TotalLoanRisk1to365", rows.Sum(r => r.LoanRisk1to365 ?? 0));
    var totalRiskGt365 = TotalOr("TotalLoanRiskGreaterThan365", rows.Sum(r => r.LoanRiskGreaterThan365 ?? 0));

    var table = new ReportTable(Model, title: "Loan CIC Report", sheetName: "LoanCIC")
        .Column("SN", 2, Align.Center)
        .Column("Member Id", 6)
        .Column("Member Name", 8)
        .Column("Permanent Address", 6)
        .Column("Temporary Address", 6)
        .Column("Citizen No.", 5)
        .Column("Issue On", 5)
        .Column("Issue District", 5)
        .Column("Loan Type", 6)
        .Column("Account No.", 5)
        .Column("Issue On", 5)
        .Column("Maturity On", 5)
        .Column("Issued Principle", 6, Align.Right)
        .Column("Remaining Principle", 6, Align.Right)
        .Column("Due Interest", 5, Align.Right)
        .Column("Guarantor", 8)
        .Column("Guarantor Citizenship No.", 6)
        .Column("Good Loan", 5, Align.Right)
        .Column("1-365 Days", 4, Align.Right)
        .Column(">365 Days", 4, Align.Right)
        .NoColumnHeader()                      // the header is written below: a group band + the column titles
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f2f2f2",
            DataText = "#1a3d7c",
            GroupBackground = "#f2f2f2",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 75)   // one text line per row
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 3px; }\n" +
            // group band: centred titles over their columns
            "table.sheet-table tr.r-group td { text-align: center; border-top: 1.5px solid #000; border-bottom: 1px solid #000; }\n" +
            // the column titles sit right under the band
            "table.sheet-table tr.r-header th { border-top: 0; border-bottom: 1px solid #000; }");

    // ── title block ──
    table.MetaRow(Fmt.Labeled("Branch Name :", branchName), Fmt.Labeled("Till Date :", tillDate));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    // ── header: group band (cells cover all 20 columns: 5 + 3 + 9 + 1 + 2), then the column titles ──
    table.GroupBy(
        ReportCell.Center("", 5),
        ReportCell.Center("Citizenship Detail", 3),
        ReportCell.Center("Loan Detail", 9),
        ReportCell.Center("", 1),
        ReportCell.Center("Delinquency Loan", 2));
    table.Header();

    // ── rows ──
    var sn = 0;
    foreach (var r in rows)
    {
        table.Data(
            (++sn).ToString(),
            r.MemberId ?? "",
            r.FullName ?? "",
            r.PermanentAddessDetail ?? "",
            r.TemporaryAddressDetail ?? "",
            r.CitizenshipNo ?? "",
            r.CitizenShipIssuedOnBs ?? "",
            r.CitizenShipIssuedDistrict ?? "",
            r.LoanTypeName ?? "",
            r.LoanAccountNo ?? "",
            r.LoanIssueOnBs ?? "",
            r.MaturityOnBs ?? "",
            Fmt.Amount(r.LoanIssueAmount),
            Fmt.Amount(r.PriBalance),
            Fmt.Amount(r.IntBalance),
            r.Guaranteer ?? "",
            r.GuaranteerCitizenshipNo ?? "",
            Fmt.Amount(r.GoodLoan),
            Fmt.Amount(r.LoanRisk1to365),
            Fmt.Amount(r.LoanRiskGreaterThan365));
    }

    // label spans the first 12 columns; the 8 values fill the rest (columns 13-20)
    if (rows.Count > 0)
    {
        table.Total($"Grand Total ({totalRecords})", 12,
            Fmt.Amount(totalIssue), Fmt.Amount(totalPrincipal), Fmt.Amount(totalInterest),
            "", "",
            Fmt.Amount(totalGood), Fmt.Amount(totalRisk1To365), Fmt.Amount(totalRiskGt365));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())