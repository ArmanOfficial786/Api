
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanFineInterestPrinciplePaymentSummaryRowDto>) ?? new List<LoanFineInterestPrinciplePaymentSummaryRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalFine = Model["TotalFine"] as decimal? ?? 0;
    var totalInterest = Model["TotalInterest"] as decimal? ?? 0;
    var totalPrincipal = Model["TotalPrincipal"] as decimal? ?? 0;
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var collectionCenterName = Model["CollectionCenterName"]?.ToString() ?? "";
    var collectorName = Model["CollectorName"]?.ToString() ?? "";
    var selectAllOrOnlyCash = Model["SelectAllOrOnlyCash"]?.ToString() ?? "-1";
    var orderBy = Model["OrderBy"]?.ToString() ?? "-1";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isCollectionCenterFiltered = !string.IsNullOrEmpty(collectionCenterName);
    var isCollectorFiltered = !string.IsNullOrEmpty(collectorName);
    var hasDateRange = !string.IsNullOrEmpty(fromDate) && !string.IsNullOrEmpty(toDate);
    var isOnlyCash = selectAllOrOnlyCash == "Cash";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Principal, Interest, Fine Payment Summary Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .collection-center-header td {
                background: #e8f0f8;
                font-weight: bold;
                padding: 5px 6px;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .positive {
                color: #006600;
            }

            .negative {
                color: #CC0000;
            }

            .cash-badge {
                display: inline-block;
                padding: 2px 10px;
                background: #d4edda;
                color: #155724;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            .all-badge {
                display: inline-block;
                padding: 2px 10px;
                background: #d1ecf1;
                color: #0c5460;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanFineInterestPrinciplePaymentSummary">
            <colgroup>
                <col style="width:9%;" />
                <col style="width:17%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:12%;" />
                <col style="width:5%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="9">Loan Principal, Interest, Fine Payment Summary Report</td>
                </tr>

                <!-- Metadata -->
                <tr class="meta-row">
                    <td colspan="5">
                        <strong>Branch Name :</strong> @branchName
                        &nbsp;&nbsp;&nbsp;
                        <span class="cash-badge @(isOnlyCash ? "cash-badge" : "all-badge")">
                            @(isOnlyCash ? "Only Cash" : "All")
                        </span>
                    </td>
                    <td colspan="4" class="text-right">
                        @if (hasDateRange)
                        {
                            <strong>From Date :</strong> 
                            @fromDate
                            <text>&nbsp;&nbsp;&nbsp;</text>
                            <strong>To Date :</strong> 
                            @toDate
                        }
                    </td>
                </tr>
                @if (isCollectionCenterFiltered || isCollectorFiltered)
                {
                    <tr class="meta-row">
                        <td colspan="5">
                            @if (isCollectionCenterFiltered)
                            {
                                <strong>Collection Center :</strong> 
                                @collectionCenterName
                            }
                        </td>
                        <td colspan="4" class="text-right">
                            @if (isCollectorFiltered)
                            {
                                <strong>Collector :</strong> 
                                @collectorName
                                <text>&nbsp;&nbsp;&nbsp;</text>
                            }
                            <strong>Report Generated On :</strong> @generatedOn
                        </td>
                    </tr>
                }
                else
                {
                    <tr class="meta-row">
                        <td colspan="9" class="text-right"><strong>Report Generated On :</strong> @generatedOn</td>
                    </tr>
                }
                <tr class="meta-spacer"><td colspan="9"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Loan A/c No</th>
                    <th>Loan Type</th>
                    <th class="text-right">Principal</th>
                    <th class="text-right">Interest</th>
                    <th class="text-right">Fine</th>
                    <th class="text-right">Total Amount</th>
                    <th>Remarks</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    var currentCollectionCenter = string.Empty;

                    foreach (var row in rows)
                    {
                        // Show collection center header if grouping enabled
                        if (isCollectionCenterFiltered && !string.IsNullOrEmpty(row.CollectionCenterName) && currentCollectionCenter != row.CollectionCenterName)
                        {
                            currentCollectionCenter = row.CollectionCenterName;
                            <tr class="collection-center-header">
                                <td colspan="9"><strong>Collection Center: @currentCollectionCenter</strong></td>
                            </tr>
                        }

                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.FullName ?? "")</td>
                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            <td class="text-right">@(row.Principal.HasValue ? row.Principal.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.Interest.HasValue ? row.Interest.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.Fine.HasValue ? row.Fine.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.TotalAmount.HasValue ? row.TotalAmount.Value.ToString("N2") : "")</td>
                            <td></td>
                        </tr>
                    }

                    <!-- Grand Total Row -->
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalPrincipal.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalInterest.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalFine.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalAmount.ToString("N2")</strong></td>
                        <td></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="8" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>