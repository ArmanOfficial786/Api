@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAccountWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<LoanDeletedRowDto>) ?? new List<LoanDeletedRowDto>();

    var reportType = Text("ReportType", "All");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var isDateFiltered = reportType.Equals("BtnDate", StringComparison.OrdinalIgnoreCase);

    var totalIssueAmount = rows.Sum(r => r.LoanIssueAmount ?? 0m);

    var table = new ReportTable(Model, title: "Loan Deleted Report", sheetName: "LoanDeleted")
        .Column("S.No", 6)
        .Column("Member ID", 11)
        .Column("Name", 14)
        .Column("Account No", 11)
        .Column("Account Type", 12)
        .Column("Period", 8)
        .Column("Issue Amount", 12, Align.Right)
        .Column("Int Rate", 8, Align.Right)
        .Column("Issue Date", 9)
        .Column("Deleted Date", 9)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }\n" +
            "table.sheet-table tr.r-total td { border-top: 1px solid #000; border-bottom: 0; padding-top: 5px; padding-bottom: 5px; }");

    table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
    if (isDateFiltered)
        table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            (++sn).ToString(),
            row.MemberId ?? "",
            row.FullName ?? "",
            row.LoanAccountNo ?? "",
            row.LoanTypeName ?? "",
            row.Period ?? "",
            Money(row.LoanIssueAmount),
            row.InterestRate ?? "",
            row.LoanIssueDate ?? "",
            row.DeletedDateOn.HasValue ? row.DeletedDateOn.Value.ToString("yyyy/MM/dd") : "");
    }

    if (rows.Count > 0)
        table.Total("Grand Total:", 6, totalIssueAmount.ToString("N2"), "", "", "");
}
@await Html.PartialAsync("_SheetReport", table.Build())