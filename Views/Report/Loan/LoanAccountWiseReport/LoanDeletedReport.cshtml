
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAccountWiseReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanDeletedRowDto>) ?? new List<LoanDeletedRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var reportType = Model["ReportType"]?.ToString() ?? "All";
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var isDateFiltered = reportType.Equals("BtnDate", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Deleted Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanDeleted">
            <colgroup>
                <col style="width:10%;" />
                <col style="width:16%;" />
                <col style="width:14%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:10%;" />
                <col style="width:14%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="8">Loan Deleted Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="4"><strong>Branch :</strong> @branchName &nbsp;&nbsp;&nbsp; <strong>Member Group :</strong> @memberGroupName</td>
                    @if (isDateFiltered)
                    {
                        <td colspan="4" class="text-right">
                            <strong>From Date :</strong> @fromDate
                            &nbsp;&nbsp;&nbsp;
                            <strong>To Date :</strong> @toDate
                        </td>
                    }
                    else
                    {
                        <td colspan="4" class="text-right"><strong>Showing :</strong> All Deleted Loans</td>
                    }
                </tr>
                <tr class="meta-row">
                    <td colspan="8"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="8"></td></tr>

                <tr>
                    <th>Member Id</th>
                    <th>Full Name</th>
                    <th>Loan Account No</th>
                    <th>Loan Type</th>
                    <th class="text-right">Issue Amount</th>
                    <th>Issue Date</th>
                    <th>Period</th>
                    <th>Interest Rate / Modified</th>
                </tr>

                @if (rows.Any())
                {
                    foreach (var row in rows)
                    {
                        <tr class="detail-row">
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.FullName ?? "")</td>
                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : "")</td>
                            <td>@(row.LoanIssueDate ?? "")</td>
                            <td>@(row.Period ?? "")</td>
                            <td>@(row.InterestRate ?? "") @(!string.IsNullOrEmpty(row.ModifyDate) ? " / " + row.ModifyDate : "")</td>
                        </tr>
                    }

                    <tr class="grand-total-row">
                        <td colspan="7" class="text-right">Total Records</td>
                        <td class="text-right">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>