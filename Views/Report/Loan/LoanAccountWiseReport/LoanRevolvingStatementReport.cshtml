@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanRevolvingStatementRowDto>) ?? new List<LoanRevolvingStatementRowDto>();
    var totalIssueAmount = Model["TotalIssueAmount"] as decimal? ?? 0;
    var totalPrincipal = Model["TotalPrincipal"] as decimal? ?? 0;
    var totalInterest = Model["TotalInterest"] as decimal? ?? 0;
    var totalFine = Model["TotalFine"] as decimal? ?? 0;

    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var memberId = Model["MemberId"]?.ToString() ?? "";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var address = Model["Address"]?.ToString() ?? "";
    var contactNo = Model["ContactNo"]?.ToString() ?? "";
    var accountNo = Model["AccountNo"]?.ToString() ?? "";
    var loanTypeName = Model["LoanTypeName"]?.ToString() ?? "";
    var sanctionAmount = Model["SanctionAmount"] as decimal? ?? 0;
    var interestRate = Model["InterestRate"] as decimal? ?? 0;
    var loanIssueAmount = Model["LoanIssueAmount"] as decimal? ?? 0;
    var loanPeriod = Model["LoanPeriod"]?.ToString() ?? "";
    var loanIssueOnBs = Model["LoanIssueOnBs"]?.ToString() ?? "";
    var maturityOnBs = Model["MaturityOnBs"]?.ToString() ?? "";

    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isExcel = format is "EXCEL" or "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Statement Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Times New Roman", Times, serif;
                font-size: 10pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 10pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-size: 13pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 4px 6px 10px;
            }

            .between-row td {
                padding: 2px 6px;
                font-size: 10pt;
            }

            .between-row .label {
                font-weight: bold;
                white-space: nowrap;
            }

            .meta-spacer td {
                height: 8px;
            }

            /* ── Info box: bordered key/value grid ── */
            .info-box td {
                border: 1px solid #000;
                padding: 4px 8px;
            }

            .info-label {
                font-weight: bold;
                width: 15%;
                white-space: nowrap;
            }

            .info-value {
                width: 35%;
            }

            /* ── Transaction table ── */
            .txn-header th {
                border: 1px solid #000;
                border-top: 2px solid #000;
                font-weight: bold;
                text-align: center;
                background: #fff;
                padding: 4px 6px;
            }

            .detail-row td {
                border: 1px solid #000;
                padding: 4px 6px;
                color: #1a3d7c;
            }

            .total-row td {
                border: 1px solid #000;
                font-weight: bold;
                padding: 4px 6px;
                color: #000;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanStatement">
            <colgroup>
                <col style="width:12%;" />
                <col style="width:28%;" />
                <col style="width:13%;" />
                <col style="width:12%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:13%;" />
            </colgroup>
            <tbody>
                <!-- Title -->
                <tr class="meta-title">
                    <td colspan="7">Loan Statement Report</td>
                </tr>

                <!-- Statement Between -->
                <tr class="between-row">
                    <td class="label" colspan="1">Statement Between :</td>
                    <td colspan="1">@fromDate &nbsp;&nbsp;-&nbsp;&nbsp; @toDate</td>
                    <td colspan="5"></td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <tr class="between-row">
                    <td class="label" colspan="1">Report Generated On :</td>
                    <td colspan="6">@generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <!-- Member / Loan info box -->
                <tr class="info-box">
                    <td class="info-label">MemberID</td>
                    <td class="info-value">@memberId</td>
                    <td class="info-label">Member Name</td>
                    <td class="info-value" colspan="4">@memberName</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">Address</td>
                    <td class="info-value">@address</td>
                    <td class="info-label">Contact No</td>
                    <td class="info-value" colspan="4">@contactNo</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">Account No</td>
                    <td class="info-value">@accountNo</td>
                    <td class="info-label">Loan Type</td>
                    <td class="info-value" colspan="4">@loanTypeName</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">SanctionAmount</td>
                    <td class="info-value">@sanctionAmount.ToString("N2")</td>
                    <td class="info-label">Interest Rate</td>
                    <td class="info-value" colspan="4">@interestRate.ToString("N2") %</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">Loan Issue Amount</td>
                    <td class="info-value">@loanIssueAmount.ToString("N2")</td>
                    <td class="info-label">Loan Period</td>
                    <td class="info-value" colspan="4">@loanPeriod</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">Loan Issue Date</td>
                    <td class="info-value">@loanIssueOnBs</td>
                    <td class="info-label">Loan Maturity Date</td>
                    <td class="info-value" colspan="4">@maturityOnBs</td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <!-- Transaction table header -->
                <tr class="txn-header">
                    <th>DateNep</th>
                    <th>Description</th>
                    <th class="text-right">Issue Amount</th>
                    <th class="text-right">Principle Amt</th>
                    <th class="text-right">Interest Amt</th>
                    <th class="text-right">Penalty</th>
                    <th class="text-right">Balance Amt</th>
                </tr>

                @if (rows.Any())
                {
                    foreach (var row in rows)
                    {
                        <tr class="detail-row">
                            <td>@(row.DateOnBs ?? "")</td>
                            <td>@(row.Description ?? "")</td>
                            <td class="text-right">@(row.LoanIssueAmount?.ToString("N2") ?? "0.00")</td>
                            <td class="text-right">@(row.Principal?.ToString("N2") ?? "0.00")</td>
                            <td class="text-right">@(row.Interest?.ToString("N2") ?? "0.00")</td>
                            <td class="text-right">@(row.Fine?.ToString("N2") ?? "0.00")</td>
                            <td class="text-right">@(row.BalanceAmount?.ToString("N2") ?? "0.00")</td>
                        </tr>
                    }

                    <tr class="total-row">
                        <td></td>
                        <td class="text-right">Total:</td>
                        <td class="text-right">@totalIssueAmount.ToString("N2")</td>
                        <td class="text-right">@totalPrincipal.ToString("N2")</td>
                        <td class="text-right">@totalInterest.ToString("N2")</td>
                        <td class="text-right">@totalFine.ToString("N2")</td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>