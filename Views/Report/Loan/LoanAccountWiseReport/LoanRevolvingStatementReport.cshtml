@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string Money(decimal? value) => (value ?? 0m).ToString("N2");

    var rows = (Model["Rows"] as List<LoanRevolvingStatementRowDto>) ?? new List<LoanRevolvingStatementRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Loan Statement Report", sheetName: "LoanStatement")
        .Column("DateNep", 12)
        .Column("Description", 28)
        .Column("Issue Amount", 13, Align.Right)
        .Column("Principle Amt", 12, Align.Right)
        .Column("Interest Amt", 11, Align.Right)
        .Column("Penalty", 11, Align.Right)
        .Column("Balance Amt", 13, Align.Right)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; border: 1px solid #000; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; }\n" +
            "table.sheet-table tr.r-data td { color: #1a3d7c; }\n" +
            "table.sheet-table tr.r-data td.info-label { color: #000; font-weight: bold; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td.info-value { color: #000; }");

    table.MetaRow(Fmt.Labeled("Statement Between :", $"{fromDate}   -   {toDate}"));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    ReportCell Label(string text) => new ReportCell(text, Align.Left, 1, "info-label");
    ReportCell Value(string text, int span = 1) => new ReportCell(text, Align.Left, span, "info-value");

    table.Data(Label("MemberID"), Value(Text("MemberId")), Label("Member Name"), Value(Text("MemberName"), 4));
    table.Data(Label("Address"), Value(Text("Address")), Label("Contact No"), Value(Text("ContactNo"), 4));
    table.Data(Label("Account No"), Value(Text("AccountNo")), Label("Loan Type"), Value(Text("LoanTypeName"), 4));
    table.Data(Label("SanctionAmount"), Value(Dec("SanctionAmount").ToString("N2")), Label("Interest Rate"), Value(Dec("InterestRate").ToString("N2") + " %", 4));
    table.Data(Label("Loan Issue Amount"), Value(Dec("LoanIssueAmount").ToString("N2")), Label("Loan Period"), Value(Text("LoanPeriod"), 4));
    table.Data(Label("Loan Issue Date"), Value(Text("LoanIssueOnBs")), Label("Loan Maturity Date"), Value(Text("MaturityOnBs"), 4));

    table.Spacer();
    table.Header();

    foreach (var row in rows)
    {
        table.Data(
            row.DateOnBs ?? "",
            row.Description ?? "",
            Money(row.LoanIssueAmount),
            Money(row.Principal),
            Money(row.Interest),
            Money(row.Fine),
            Money(row.BalanceAmount));
    }

    if (rows.Count > 0)
    {
        table.Total("Total:", 2,
            Dec("TotalIssueAmount").ToString("N2"),
            Dec("TotalPrincipal").ToString("N2"),
            Dec("TotalInterest").ToString("N2"),
            Dec("TotalFine").ToString("N2"),
            "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())