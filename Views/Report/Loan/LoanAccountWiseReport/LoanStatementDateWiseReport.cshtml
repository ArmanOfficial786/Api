@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string Money(decimal? value) => (value ?? 0m).ToString("N2");
    string S(object? value) => $"{value}";

    var memberInfo = Model["MemberInfo"] as LoanStatementDateWiseMemberInfoDto;
    var rows = (Model["Rows"] as List<LoanStatementDateWiseRowDto>) ?? new List<LoanStatementDateWiseRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All Branch");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Loan Statement Details - Date wise", sheetName: "LoanStatementDateWise")
        .Column("S.No", 7)
        .Column("Installment Amount", 17, Align.Right)
        .Column("Interest Amount", 15, Align.Right)
        .Column("Fine Amount", 13, Align.Right)
        .Column("Principal Amount", 16, Align.Right)
        .Column("Balance Amount", 16, Align.Right)
        .Column("Payment Date", 16)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }\n" +
            "table.sheet-table tr.r-data td.info-label, table.sheet-table tr.r-data td.info-value " +
            "{ border: 1px solid #000; padding: 2px 8px; }\n" +
            "table.sheet-table tr.r-data td.info-label { font-weight: bold; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-data td.sec-title { font-weight: bold; font-size: 10pt; padding: 6px; }\n" +
            "table.sheet-table tr.r-total td { border-top: 1px solid #000; border-bottom: 0; }");

    table.MetaRow(Fmt.Labeled("Branch Name:", branchName));
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));
    table.MetaRow(Fmt.Labeled("Filter By:-", $"From Date: {fromDate}\u00A0\u00A0\u00A0To Date: {toDate}"));

    ReportCell Label(string text) => new ReportCell(text, Align.Left, 1, "info-label");
    ReportCell Value(string text, int span = 1) => new ReportCell(text, Align.Left, span, "info-value");

    if (memberInfo != null)
    {
        table.Data(Label("MemberID"), Value(S(memberInfo.MemberId)), Label("Member Name"), Value(S(memberInfo.FullName), 4));
        table.Data(Label("Address"), Value(S(memberInfo.Address)), Label("Contact No"), Value(S(memberInfo.ContactNo), 4));
        table.Data(Label("Account No"), Value(S(memberInfo.LoanAccountNo)), Label("Loan Type"), Value(S(memberInfo.LoanTypeName), 4));
        table.Data(Label("Loan Issue Amount"), Value(memberInfo.LoanIssueAmount?.ToString("N2") ?? ""), Label("Interest Rate"), Value(S(memberInfo.InterestRate), 4));
        table.Data(Label("Term of Loan"), Value(S(memberInfo.Period)), Label("Installment Payment"), Value(S(memberInfo.PaymentType), 4));
        table.Data(Label("Loan Issue Date"), Value(S(memberInfo.LoanIssueDate)), Label("Loan Maturity Date"), Value(S(memberInfo.MaturityDateBs), 4));
        table.Spacer();
    }

    table.Data(new ReportCell("Loan Statement Details", Align.Center, 7, "sec-title"));
    table.Header();

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            (++sn).ToString(),
            Money(row.InstallmentAmt),
            Money(row.Interest),
            Money(row.Fine),
            Money(row.Principal),
            Money(row.BalanceAmount),
            row.DateOnBs ?? "");
    }

    if (rows.Count > 0)
    {
        table.Total("Total:", 1,
            Dec("TotalInstallmentAmt").ToString("N2"),
            Dec("TotalInterest").ToString("N2"),
            Dec("TotalFine").ToString("N2"),
            Dec("TotalPrincipal").ToString("N2"),
            "",
            "");
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())