
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var memberInfo = Model["MemberInfo"] as LoanStatementDateWiseMemberInfoDto;
    var rows = (Model["Rows"] as List<LoanStatementDateWiseRowDto>) ?? new List<LoanStatementDateWiseRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var totalPrincipal = Model["TotalPrincipal"] as decimal? ?? 0;
    var totalInterest = Model["TotalInterest"] as decimal? ?? 0;
    var totalFine = Model["TotalFine"] as decimal? ?? 0;
    var totalInstallmentAmt = Model["TotalInstallmentAmt"] as decimal? ?? 0;
    var totalBalanceAmount = Model["TotalBalanceAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Statement Report Date Wise</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .section-header td {
                background: #e8e8e8;
                font-weight: bold;
                font-size: 10pt;
                padding: 5px 6px;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
            }

            .member-info td {
                padding: 3px 6px;
                font-size: 9pt;
                border-bottom: 1px solid #eee;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .positive {
                color: #006600;
            }

            .negative {
                color: #CC0000;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanStatementDateWise">
            <colgroup>
                <col style="width:5%;" />
                <col style="width:11%;" />
                <col style="width:13%;" />
                <col style="width:13%;" />
                <col style="width:11%;" />
                <col style="width:13%;" />
                <col style="width:13%;" />
                <col style="width:21%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="8">Loan Statement Report Date Wise</td>
                </tr>

                <!-- Metadata -->
                <tr class="meta-row">
                    <td colspan="4"><strong>Branch :</strong> @branchName</td>
                    <td colspan="4" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="4">
                        <strong>Account No :</strong> @(memberInfo?.LoanAccountNo ?? "")
                    </td>
                    <td colspan="4" class="text-right">
                        <strong>Report Generated On :</strong> @generatedOn
                    </td>
                </tr>

                <!-- Member Information Section -->
                @if (memberInfo != null)
                {
                    <tr class="meta-spacer"><td colspan="8"></td></tr>
                    <tr class="section-header">
                        <td colspan="8"><strong>Member Information</strong></td>
                    </tr>
                    <tr class="member-info">
                        <td colspan="2"><strong>Member Id :</strong> @memberInfo.MemberId</td>
                        <td colspan="3"><strong>Member Name :</strong> @memberInfo.MemberName</td>
                        <td colspan="3"><strong>Loan Type :</strong> @memberInfo.LoanTypeName</td>
                    </tr>
                    <tr class="member-info">
                        <td colspan="2"><strong>Loan Amount :</strong> @(memberInfo.LoanIssueAmount?.ToString("N2"))</td>
                        <td colspan="2"><strong>Interest Rate :</strong> @(memberInfo.InterestRate?.ToString("N2"))%</td>
                        <td colspan="2"><strong>Issue Date :</strong> @memberInfo.LoanIssueOnBs</td>
                        <td colspan="2"><strong>Maturity Date :</strong> @memberInfo.MaturityOnBs</td>
                    </tr>
                    <tr class="member-info">
                        <td colspan="4"><strong>Address :</strong> @memberInfo.ContactAddress</td>
                        <td colspan="2"><strong>Contact :</strong> @memberInfo.ContactNo</td>
                        <td colspan="2"><strong>Status :</strong> @memberInfo.AccountStatus</td>
                    </tr>
                    <tr class="meta-spacer"><td colspan="8"></td></tr>
                }

                <!-- Table Header -->
                <tr>
                    <th class="text-center">S.N.</th>
                    <th>Date (BS)</th>
                    <th class="text-right">Principal</th>
                    <th class="text-right">Interest</th>
                    <th class="text-right">Fine</th>
                    <th class="text-right">Installment Amount</th>
                    <th class="text-right">Balance Amount</th>
                    <th>Narration</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td class="text-center">@sn</td>
                            <td>@(row.DateOnBs ?? "")</td>
                            <td class="text-right">@(row.Principal.HasValue ? row.Principal.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.Interest.HasValue ? row.Interest.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.Fine.HasValue ? row.Fine.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.InstallmentAmt.HasValue ? row.InstallmentAmt.Value.ToString("N2") : "")</td>
                            <td class="text-right @(row.BalanceAmount.HasValue && row.BalanceAmount.Value < 0 ? "negative" : "positive")">
                                @(row.BalanceAmount.HasValue ? row.BalanceAmount.Value.ToString("N2") : "")
                            </td>
                            <td>@(row.Narration ?? "")</td>
                        </tr>
                    }

                    <!-- Grand Total Row -->
                    <tr class="grand-total-row">
                        <td colspan="2" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalPrincipal.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalInterest.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalFine.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalInstallmentAmt.ToString("N2")</strong></td>
                        <td class="text-right @(totalBalanceAmount < 0 ? "negative" : "positive")">
                            <strong>@totalBalanceAmount.ToString("N2")</strong>
                        </td>
                        <td></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="7" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>