@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAccountWiseReport

@model Dictionary<string, object>
@{
    Layout = null;

    var memberInfo = Model["MemberInfo"] as LoanScheduleMemberInfoDto;
    var rows = (Model["Rows"] as List<LoanScheduleRowDto>) ?? new List<LoanScheduleRowDto>();
    var totalInstallmentAmount = Model["TotalInstallmentAmount"] as decimal? ?? 0;
    var totalPrincipleAmount = Model["TotalPrincipleAmount"] as decimal? ?? 0;
    var totalInterestAmount = Model["TotalInterestAmount"] as decimal? ?? 0;
    var totalDays = rows.Sum(r => r.LmtLoanScheduleId.HasValue ? 0 : 0); // placeholder, replaced below
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Schedule Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                text-align: left;
            }

            .meta-spacer td {
                height: 8px;
            }

            /* ── Bordered info box, same pattern as the Loan Statement report ── */
            .info-box td {
                border: 1px solid #000;
                padding: 4px 8px;
            }

            .info-label {
                font-weight: bold;
                width: 15%;
                white-space: nowrap;
            }

            .info-value {
                width: 35%;
            }

            .data-table th {
                background: #fff;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
                font-weight: bold;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
                color: #1a3d7c;
            }

            .total-row td {
                border-top: 1px solid #000;
                font-weight: bold;
                padding-top: 4px;
                color: #000;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanSchedule">
            <colgroup>
                <col style="width:9%;" />
                <col style="width:15%;" />
                <col style="width:13%;" />
                <col style="width:14%;" />
                <col style="width:15%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:10%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="8">Loan Schedule Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="8"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="8"></td></tr>

                <!-- Member / Loan info box -->
                <tr class="info-box">
                    <td class="info-label">MemberID</td>
                    <td class="info-value">@memberInfo?.MemberId</td>
                    <td class="info-label">Member Name</td>
                    <td class="info-value" colspan="5">@memberInfo?.MemberName</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">Address</td>
                    <td class="info-value">@memberInfo?.ContactAddress</td>
                    <td class="info-label">Contact No</td>
                    <td class="info-value" colspan="5">@memberInfo?.ContactNo</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">Account No</td>
                    <td class="info-value" colspan="7">@memberInfo?.LoanAccountNo</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">Loan Type</td>
                    <td class="info-value">@memberInfo?.LoanTypeName</td>
                    <td class="info-label">Interest Rate</td>
                    <td class="info-value" colspan="5">@memberInfo?.InterestRate</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">Loan Issue Amount</td>
                    <td class="info-value">@(memberInfo?.LoanIssueAmount?.ToString("N2"))</td>
                    <td class="info-label">Loan Period</td>
                    <td class="info-value" colspan="5">@memberInfo?.Period</td>
                </tr>
                <tr class="info-box">
                    <td class="info-label">Loan Issue Date</td>
                    <td class="info-value">@memberInfo?.LoanIssueOnBs</td>
                    <td class="info-label">Loan Maturity Date</td>
                    <td class="info-value" colspan="5">@memberInfo?.MaturityOnBs</td>
                </tr>
                <tr class="meta-spacer"><td colspan="8"></td></tr>

                <!-- Schedule table -->
                <tr>
                    <th>S.No.</th>
                    <th class="text-right">Principal Amt</th>
                    <th class="text-right">Interest Amt</th>
                    <th class="text-right">Installment Amt</th>
                    <th class="text-right">Principle Balance</th>
                    <th class="text-center">ScheduleOn(AD)</th>
                    <th class="text-center">ScheduleOn(BS)</th>
                    <th class="text-right">Days</th>
                </tr>

                @if (rows.Any())
                {
                    foreach (var row in rows)
                    {
                        <tr class="detail-row">
                            <td>@(row.LoanFrequency?.ToString() ?? "")</td>
                            <td class="text-right">@(row.PrincipleAmount.HasValue ? row.PrincipleAmount.Value.ToString("N2") : "0.00")</td>
                            <td class="text-right">@(row.InterestAmount.HasValue ? row.InterestAmount.Value.ToString("N2") : "0.00")</td>
                            <td class="text-right">@(row.InstallmentAmount.HasValue ? row.InstallmentAmount.Value.ToString("N2") : "0.00")</td>
                            <td class="text-right">@(row.PrincipleBalanceAmount.HasValue ? row.PrincipleBalanceAmount.Value.ToString("N2") : "0.00")</td>
                            <td class="text-center">@(row.ScheduleDateOn.HasValue ? row.ScheduleDateOn.Value.ToString("yyyy/MM/dd") : "")</td>
                            <td class="text-center">@(row.ScheduleDateOnBs ?? "")</td>
                            <td class="text-right">@(row.NoOfDays?.ToString() ?? "")</td>
                        </tr>
                    }

                    <tr class="total-row">
                        <td class="text-right">Total:</td>
                        <td class="text-right">@totalPrincipleAmount.ToString("N2")</td>
                        <td class="text-right">@totalInterestAmount.ToString("N2")</td>
                        <td class="text-right">@totalInstallmentAmount.ToString("N2")</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@(rows.Sum(r => r.NoOfDays ?? 0))</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No schedule found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>