@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAccountWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    string Money(decimal? value) => (value ?? 0m).ToString("N2");
    string S(object? value) => $"{value}";

    var memberInfo = (Model["MemberInfo"] as LoanScheduleMemberInfoDto) ?? new LoanScheduleMemberInfoDto();
    var rows = (Model["Rows"] as List<LoanScheduleRowDto>) ?? new List<LoanScheduleRowDto>();

    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var table = new ReportTable(Model, title: "Loan Schedule Report", sheetName: "LoanSchedule")
        .Column("S.No.", 9)
        .Column("Principal Amt", 15, Align.Right)
        .Column("Interest Amt", 13, Align.Right)
        .Column("Installment Amt", 14, Align.Right)
        .Column("Principle Balance", 15, Align.Right)
        .Column("ScheduleOn(AD)", 12, Align.Center)
        .Column("ScheduleOn(BS)", 12, Align.Center)
        .Column("Days", 10, Align.Right)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 0; }\n" +
            "table.sheet-table tr.r-data td { color: #1a3d7c; }\n" +
            "table.sheet-table tr.r-data td.info-label, table.sheet-table tr.r-data td.info-value " +
            "{ color: #000; border: 1px solid #000; padding: 2px 8px; }\n" +
            "table.sheet-table tr.r-data td.info-label { font-weight: bold; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-total td { border-top: 1px solid #000; border-bottom: 0; }");

    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    ReportCell Label(string text) => new ReportCell(text, Align.Left, 1, "info-label");
    ReportCell Value(string text, int span = 1) => new ReportCell(text, Align.Left, span, "info-value");

    table.Data(Label("MemberID"), Value(S(memberInfo.MemberId)), Label("Member Name"), Value(S(memberInfo.MemberName), 5));
    table.Data(Label("Address"), Value(S(memberInfo.ContactAddress)), Label("Contact No"), Value(S(memberInfo.ContactNo), 5));
    table.Data(Label("Account No"), Value(S(memberInfo.LoanAccountNo), 7));
    table.Data(Label("Loan Type"), Value(S(memberInfo.LoanTypeName)), Label("Interest Rate"), Value(S(memberInfo.InterestRate), 5));
    table.Data(Label("Loan Issue Amount"), Value(memberInfo.LoanIssueAmount?.ToString("N2") ?? ""), Label("Loan Period"), Value(S(memberInfo.Period), 5));
    table.Data(Label("Loan Issue Date"), Value(S(memberInfo.LoanIssueOnBs)), Label("Loan Maturity Date"), Value(S(memberInfo.MaturityOnBs), 5));

    table.Spacer();
    table.Header();

    foreach (var row in rows)
    {
        table.Data(
            row.LoanFrequency?.ToString() ?? "",
            Money(row.PrincipleAmount),
            Money(row.InterestAmount),
            Money(row.InstallmentAmount),
            Money(row.PrincipleBalanceAmount),
            row.ScheduleDateOn.HasValue ? row.ScheduleDateOn.Value.ToString("yyyy/MM/dd") : "",
            row.ScheduleDateOnBs ?? "",
            row.NoOfDays?.ToString() ?? "");
    }

    if (rows.Count > 0)
    {
        table.Total("Total:", 1,
            Dec("TotalPrincipleAmount").ToString("N2"),
            Dec("TotalInterestAmount").ToString("N2"),
            Dec("TotalInstallmentAmount").ToString("N2"),
            "",
            "",
            "",
            rows.Sum(r => r.NoOfDays ?? 0).ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())