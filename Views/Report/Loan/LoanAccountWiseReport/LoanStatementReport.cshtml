
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var memberInfo = Model["MemberInfo"] as LoanStatementMemberInfoDto;
    var transactions = (Model["Transactions"] as List<LoanStatementTransactionDto>) ?? new List<LoanStatementTransactionDto>();
    var guarantees = (Model["Guarantees"] as List<LoanStatementGuaranteeDto>) ?? new List<LoanStatementGuaranteeDto>();
    var closingDues = (Model["ClosingDues"] as List<LoanStatementClosingDueDto>) ?? new List<LoanStatementClosingDueDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalDebitAmount = Model["TotalDebitAmount"] as decimal? ?? 0;
    var totalCreditAmount = Model["TotalCreditAmount"] as decimal? ?? 0;
    var openingBalance = Model["OpeningBalance"] as decimal? ?? 0;
    var closingBalance = Model["ClosingBalance"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var reportType = Model["ReportType"]?.ToString() ?? "English";
    var verifiedTill = Model["VerifiedTill"]?.ToString() ?? "";
    var showEntryBy = Model["ShowEntryBy"] as bool? ?? false;
    var showDetailNarration = Model["ShowDetailNarration"] as bool? ?? false;
    var showAccountCloseDetails = Model["ShowAccountCloseDetails"] as bool? ?? false;
    var enableBillNumber = Model["EnableBillNumber"] as bool? ?? false;
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var hasVerification = !string.IsNullOrEmpty(verifiedTill);
    var showClosingDues = showAccountCloseDetails && closingDues.Any();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Statement Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .section-header td {
                background: #e8e8e8;
                font-weight: bold;
                font-size: 10pt;
                padding: 5px 6px;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
            }

            .member-info td {
                padding: 3px 6px;
                font-size: 9pt;
                border-bottom: 1px solid #eee;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .opening-row td {
                background: #e8f0f8;
                font-weight: bold;
                padding: 4px 6px;
                border-top: 1px solid #999;
                border-bottom: 1px solid #999;
            }

            .closing-row td {
                background: #e8f0f8;
                font-weight: bold;
                padding: 4px 6px;
                border-top: 1px solid #999;
                border-bottom: 2px solid #000;
            }

            .verified-badge {
                display: inline-block;
                padding: 2px 10px;
                background: #d4edda;
                color: #155724;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .positive {
                color: #006600;
            }

            .negative {
                color: #CC0000;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanStatement">
            <colgroup>
                <col style="width:11%;" />
                <col style="width:14%;" />
                <col style="width:11%;" />
                <col style="width:12%;" />
                <col style="width:20%;" />
                <col style="width:10%;" />
                <col style="width:10%;" />
                <col style="width:12%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="8">Loan Statement Report</td>
                </tr>

                <!-- Metadata -->
                <tr class="meta-row">
                    <td colspan="4"><strong>Branch :</strong> @branchName</td>
                    <td colspan="4" class="text-right">
                        <strong>From Date :</strong> @fromDate
                        &nbsp;&nbsp;&nbsp;
                        <strong>To Date :</strong> @toDate
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="4">
                        <strong>Account No :</strong> @memberInfo?.LoanAccountNo
                    </td>
                    <td colspan="4" class="text-right">
                        @if (hasVerification)
                        {
                            <span class="verified-badge">Verified Till: @verifiedTill</span>
                            <text>&nbsp;&nbsp;&nbsp;</text>
                        }
                        <strong>Report Generated On :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="8"></td></tr>

                <!-- Member Information Section -->
                @if (memberInfo != null)
                {
                    <tr class="section-header">
                        <td colspan="8"><strong>Member Information</strong></td>
                    </tr>
                    <tr class="member-info">
                        <td colspan="2"><strong>Member Id :</strong> @memberInfo.MemberId</td>
                        <td colspan="3"><strong>Member Name :</strong> @memberInfo.MemberName</td>
                        <td colspan="3"><strong>Loan Type :</strong> @memberInfo.LoanType</td>
                    </tr>
                    <tr class="member-info">
                        <td colspan="2"><strong>Loan Amount :</strong> @(memberInfo.LoanIssueAmount?.ToString("N2"))</td>
                        <td colspan="2"><strong>Interest Rate :</strong> @(memberInfo.InterestRate?.ToString("N2"))%</td>
                        <td colspan="2"><strong>Issue Date :</strong> @memberInfo.LoanIssueOnBs</td>
                        <td colspan="2"><strong>Maturity Date :</strong> @memberInfo.MaturityOnBs</td>
                    </tr>
                    <tr class="member-info">
                        <td colspan="4"><strong>Address :</strong> @memberInfo.ContactAddress</td>
                        <td colspan="2"><strong>Contact :</strong> @memberInfo.ContactNo</td>
                        <td colspan="2"><strong>Status :</strong> @memberInfo.AccountStatus</td>
                    </tr>
                    <tr class="meta-spacer"><td colspan="8"></td></tr>
                }

                <!-- Opening Balance Row -->
                <tr class="opening-row">
                    <td colspan="6" class="text-right"><strong>Opening Balance</strong></td>
                    <td colspan="2" class="text-right"><strong>@openingBalance.ToString("N2")</strong></td>
                </tr>

                <!-- Transaction Table Header -->
                <tr>
                    <th>Date (BS)</th>
                    <th>Particulars</th>
                    <th>Voucher No</th>
                    <th>Cheque No</th>
                    <th>Narration</th>
                    @if (showEntryBy)
                    {
                        <th>Entered By</th>
                    }
                    <th class="text-right">Debit</th>
                    <th class="text-right">Credit</th>
                    <th class="text-right">Balance</th>
                </tr>

                @if (transactions.Any())
                {
                    var sn = 0;
                    foreach (var txn in transactions)
                    {
                        sn++;
                        <tr class="@(sn % 2 == 0 ? "detail-row" : "detail-row-alt")">
                            <td>@(txn.TransactionOnBs ?? "")</td>
                            <td>@(txn.Particulars ?? "")</td>
                            <td>@(txn.VoucherNo ?? "")</td>
                            <td>@(txn.ChequeNo ?? "")</td>
                            <td>@(txn.Narration ?? "")</td>
                            @if (showEntryBy)
                            {
                                <td>@(txn.EnteredBy ?? "")</td>
                            }
                            <td class="text-right">@(txn.DebitAmount.HasValue ? txn.DebitAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(txn.CreditAmount.HasValue ? txn.CreditAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right @(txn.Balance.HasValue && txn.Balance.Value < 0 ? "negative" : "positive")">
                                @(txn.Balance.HasValue ? txn.Balance.Value.ToString("N2") : "")
                            </td>
                        </tr>
                    }

                    <!-- Grand Total Row -->
                    <tr class="grand-total-row">
                        <td colspan="@(showEntryBy ? 5 : 4)" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalDebitAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalCreditAmount.ToString("N2")</strong></td>
                        <td></td>
                    </tr>

                    <!-- Closing Balance Row -->
                    <tr class="closing-row">
                        <td colspan="@(showEntryBy ? 6 : 5)" class="text-right"><strong>Closing Balance</strong></td>
                        <td colspan="2" class="text-right @(closingBalance < 0 ? "negative" : "positive")">
                            <strong>@closingBalance.ToString("N2")</strong>
                        </td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="@(showEntryBy ? 7 : 6)" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="@(showEntryBy ? 8 : 7)" class="text-center">No transactions found for the selected criteria</td>
                    </tr>
                }

                <!-- Guarantees Section -->
                @if (guarantees.Any())
                {
                    <tr class="meta-spacer"><td colspan="8"></td></tr>
                    <tr class="section-header">
                        <td colspan="8"><strong>Guarantee Details</strong></td>
                    </tr>
                    <tr>
                        <th colspan="2">Guarantor Name</th>
                        <th colspan="2">Guarantor Member Id</th>
                        <th class="text-right">Guarantee Amount</th>
                        <th class="text-right">Guarantee Share Amount</th>
                        <th colspan="2">Guarantee Date (BS)</th>
                    </tr>
                    foreach (var g in guarantees)
                    {
                        <tr class="detail-row">
                            <td colspan="2">@(g.GuarantorName ?? "")</td>
                            <td colspan="2">@(g.GuarantorMemberId ?? "")</td>
                            <td class="text-right">@(g.GuaranteeAmount ?? "")</td>
                            <td class="text-right">@(g.GuaranteeShareAmount ?? "")</td>
                            <td colspan="2">@(g.GuaranteeDateOnBs ?? "")</td>
                        </tr>
                    }
                }

                <!-- Account Closing Due Details Section -->
                @if (showClosingDues)
                {
                    <tr class="meta-spacer"><td colspan="8"></td></tr>
                    <tr class="section-header">
                        <td colspan="8"><strong>Account Closing Due Details</strong></td>
                    </tr>
                    <tr>
                        <th colspan="5">Title</th>
                        <th colspan="3" class="text-right">Amount</th>
                    </tr>
                    foreach (var due in closingDues)
                    {
                        <tr class="detail-row">
                            <td colspan="5">@(due.Title ?? "")</td>
                            <td colspan="3" class="text-right">@(due.Amount.HasValue ? due.Amount.Value.ToString("N2") : "")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</body>
</html>