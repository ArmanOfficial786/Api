@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    string Money(decimal? value) => (value ?? 0m).ToString("N2");
    string S(object? value) => $"{value}";

    var memberInfo = (Model["MemberInfo"] as LoanStatementMemberInfoDto) ?? new LoanStatementMemberInfoDto();
    var transactions = (Model["Transactions"] as List<LoanStatementTransactionDto>) ?? new List<LoanStatementTransactionDto>();
    var guarantees = (Model["Guarantees"] as List<LoanStatementGuaranteeDto>) ?? new List<LoanStatementGuaranteeDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var reportType = Text("Language", "English");
    var isNepali = reportType.Equals("Nepali", StringComparison.OrdinalIgnoreCase);
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    string L(string en, string np) => isNepali ? np : en;

    var totalPrincipal = transactions.Sum(t => t.Principal ?? 0);
    var totalInterest = transactions.Sum(t => t.Interest ?? 0);
    var totalPenalty = transactions.Sum(t => t.Penalty ?? 0);
    var loanIssueAmount = memberInfo.LoanIssueAmount ?? 0;
    var balancePrincipal = loanIssueAmount - totalPrincipal;

    var table = new ReportTable(Model, title: L("Loan Statement Report", "ऋण स्टेटमेन्ट प्रतिवेदन"), sheetName: "LoanStatement")
        .Column("DateNep", 16)
        .Column("Description", 20)
        .Column("Principal", 16, Align.Right)
        .Column("Interest", 16, Align.Right)
        .Column("Penalty", 16, Align.Right)
        .Column("Balance Amt", 16, Align.Right)
        .NoColumnHeader()
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            TotalBackground = "#fff"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; border: 1px solid #000; }\n" +
            "table.sheet-table tr.r-header th { border-top: 2px solid #000; text-align: center; }\n" +
            "table.sheet-table tr.r-data td { color: #1a3d7c; }\n" +
            "table.sheet-table tr.r-data td.info-label, table.sheet-table tr.r-data td.info-value, " +
            "table.sheet-table tr.r-data td.box-header " +
            "{ color: #000; padding: 2px 8px; }\n" +
            "table.sheet-table tr.r-data td.info-label, table.sheet-table tr.r-data td.box-header { font-weight: bold; }\n" +
            "table.sheet-table tr.r-data td.info-label { white-space: nowrap; }");

    table.MetaRow(Fmt.Labeled(L("Statement Between", "स्टेटमेन्ट अवधि") + " :", $"{fromDate}   -   {toDate}"));
    table.MetaRow(Fmt.Labeled(L("Report Generated On", "प्रतिवेदन मिति") + " :", generatedOn));

    ReportCell Label(string text, int span = 1, Align align = Align.Left) => new ReportCell(text, align, span, "info-label");
    ReportCell Value(string text, int span = 1, Align align = Align.Left) => new ReportCell(text, align, span, "info-value");
    ReportCell Box(string text) => new ReportCell(text, Align.Center, 6, "box-header");

    table.Data(Label(L("MemberID", "सदस्य आईडी")), Value(S(memberInfo.MemberId)), Label(L("Member Name", "सदस्य नाम")), Value(S(memberInfo.MemberName), 3));
    table.Data(Label(L("Address", "ठेगाना")), Value(S(memberInfo.ContactAddress)), Label(L("Contact No", "सम्पर्क नं")), Value(S(memberInfo.ContactNo), 3));
    table.Data(Label(L("Account No", "खाता नं")), Value(S(memberInfo.LoanAccountNo)), Label(L("Remarks", "कैफियत")), Value(S(memberInfo.Remark), 3));
    table.Data(Label(L("Loan Type", "ऋण प्रकार")), Value(S(memberInfo.LoanTypeName)), Label(L("Interest Rate", "ब्याज दर")), Value((memberInfo.InterestRate ?? "0.00") + " %", 3));
    table.Data(Label(L("Loan Issue Amount", "ऋण जारी रकम")), Value(loanIssueAmount.ToString("N2")), Label(L("Loan Period", "ऋण अवधि")), Value(S(memberInfo.Period), 3));
    table.Data(Label(L("Loan Issue Date", "ऋण जारी मिति")), Value(S(memberInfo.LoanIssueOnBs)), Label(L("Loan Maturity Date", "ऋण भाखा मिति")), Value(S(memberInfo.MaturityOnBs), 3));

    table.Spacer();
    table.Header(
        L("DateNep", "मिति"),
        L("Description", "विवरण"),
        L("Principal", "साँवा"),
        L("Interest", "ब्याज"),
        L("Penalty", "जरिवाना"),
        L("Balance Amt", "बाँकी रकम"));

    if (transactions.Count > 0)
    {
        foreach (var txn in transactions)
        {
            table.Data(
                txn.TransactionOnBs ?? "-",
                txn.Narration ?? txn.Particulars ?? "-",
                Money(txn.Principal),
                Money(txn.Interest),
                Money(txn.Penalty),
                Money(txn.Balance));
        }

        table.Total(L("Total:", "जम्मा:"), 2,
            totalPrincipal.ToString("N2"),
            totalInterest.ToString("N2"),
            totalPenalty.ToString("N2"),
            "");
    }
    else
    {
        table.Data(ReportCell.Center(L("No transactions found for the selected criteria", "छानिएको मापदण्ड अनुसार कुनै कारोबार फेला परेन"), 6));
    }

    table.Spacer();
    table.Data(Box(L("Transaction Summary", "कारोबार सारांश")));
    table.Data(
        Label(L("Loan Issue Amount", "ऋण जारी रकम"), 1, Align.Center),
        Label(L("Principal Paid", "साँवा तिरेको"), 1, Align.Center),
        Label(L("Interest Paid", "ब्याज तिरेको"), 1, Align.Center),
        Label(L("Penalty Paid", "जरिवाना तिरेको"), 1, Align.Center),
        Label(L("Balance Principle Amt", "बाँकी साँवा रकम"), 2, Align.Center));
    table.Data(
        Value(loanIssueAmount.ToString("N2"), 1, Align.Center),
        Value(totalPrincipal.ToString("N2"), 1, Align.Center),
        Value(totalInterest.ToString("N2"), 1, Align.Center),
        Value(totalPenalty.ToString("N2"), 1, Align.Center),
        Value(balancePrincipal.ToString("N2"), 2, Align.Center));

    table.Spacer();
    table.Data(Box(L("Guarantee Detail", "जमानी विवरण")));
    table.Data(
        Label(L("Member Id", "सदस्य आईडी"), 1, Align.Center),
        Label(L("Member Name", "सदस्य नाम"), 1, Align.Center),
        Label(L("Contact No.", "सम्पर्क नं."), 1, Align.Center),
        Label(L("Saving A/C No.", "बचत खाता नं."), 1, Align.Center),
        Label(L("Saving Amount", "बचत रकम"), 1, Align.Center),
        Label(L("Share Amount", "सेयर रकम"), 1, Align.Center));

    if (guarantees.Count > 0)
    {
        foreach (var g in guarantees)
        {
            table.Data(
                Value(S(g.GuarantorMemberId), 1, Align.Center),
                Value(S(g.GuarantorName), 1, Align.Center),
                Value(S(g.ContactNo), 1, Align.Center),
                Value(S(g.AccountNo), 1, Align.Center),
                Value(S(g.GuaranteeAmount), 1, Align.Center),
                Value(S(g.GuaranteeShareAmount), 1, Align.Center));
        }
    }
    else
    {
        table.Data(
            Value("", 1, Align.Center), Value("", 1, Align.Center), Value("", 1, Align.Center),
            Value("", 1, Align.Center), Value("", 1, Align.Center), Value("", 1, Align.Center));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())