
@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var memberInfo = Model["MemberInfo"] as LoanInstallmentDueACClosingMemberInfoDto;
    var payments = (Model["Payments"] as List<LoanInstallmentDueACClosingPaymentDto>) ?? new List<LoanInstallmentDueACClosingPaymentDto>();
    var installments = (Model["Installments"] as List<LoanInstallmentDueACClosingInstallmentDto>) ?? new List<LoanInstallmentDueACClosingInstallmentDto>();
    var closingDues = (Model["ClosingDues"] as List<LoanInstallmentDueACClosingDueDto>) ?? new List<LoanInstallmentDueACClosingDueDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalPrinciple = Model["TotalPrinciple"] as decimal? ?? 0;
    var totalInterest = Model["TotalInterest"] as decimal? ?? 0;
    var totalPenalty = Model["TotalPenalty"] as decimal? ?? 0;
    var totalDueAmount = Model["TotalDueAmount"] as decimal? ?? 0;
    var totalNetPenalty = Model["TotalNetPenalty"] as decimal? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var calcBySwOrAsOnDate = Model["CalcBySwOrAsOnDate"]?.ToString() ?? "AOD";
    var calcByPenaltyType = Model["CalcByPenaltyType"]?.ToString() ?? "ACP";
    var calcByPrincipleInterest = Model["CalcByPrincipleInterest"]?.ToString() ?? "PI";
    var penaltyAmount = Model["PenaltyAmount"]?.ToString() ?? "0.00";
    var lastDueDate = Model["LastDueDate"]?.ToString() ?? "";
    var nextDueDate = Model["NextDueDate"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var hasLastDueDate = !string.IsNullOrEmpty(lastDueDate);
    var hasNextDueDate = !string.IsNullOrEmpty(nextDueDate);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan Installment Due A/C Closing Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .section-header td {
                background: #e8e8e8;
                font-weight: bold;
                font-size: 10pt;
                padding: 5px 6px;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
            }

            .member-info td {
                padding: 3px 6px;
                font-size: 9pt;
                border-bottom: 1px solid #eee;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .detail-row-alt td {
                background: #f9f9f9;
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .positive {
                color: #006600;
            }

            .negative {
                color: #CC0000;
            }

            .penalty-row td {
                background: #fff3cd;
            }

            .due-row td {
                background: #f8d7da;
                font-weight: bold;
            }

            .badge {
                display: inline-block;
                padding: 2px 10px;
                border-radius: 3px;
                font-size: 8pt;
                font-weight: bold;
            }

            .badge-ok {
                background: #d4edda;
                color: #155724;
            }

            .badge-warning {
                background: #fff3cd;
                color: #856404;
            }

            .badge-danger {
                background: #f8d7da;
                color: #721c24;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanInstallmentDueACClosing">
            <colgroup>
                <col style="width:5%;" />
                <col style="width:11%;" />
                <col style="width:10%;" />
                <col style="width:10%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:12%;" />
                <col style="width:11%;" />
                <col style="width:11%;" />
                <col style="width:6%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="10">Loan Installment Due A/C Closing Report</td>
                </tr>

                <!-- Metadata -->
                <tr class="meta-row">
                    <td colspan="5">
                        <strong>Account No :</strong> @(memberInfo?.LoanAccountNo ?? "")
                        &nbsp;&nbsp;&nbsp;
                        <strong>Till Date :</strong> @tillDate
                    </td>
                    <td colspan="5" class="text-right">
                        <strong>Report Generated On :</strong> @generatedOn
                    </td>
                </tr>
                <tr class="meta-row">
                    <td colspan="5">
                        <strong>Calculation :</strong> @calcBySwOrAsOnDate / @calcByPenaltyType / @calcByPrincipleInterest
                    </td>
                    <td colspan="5" class="text-right">
                        @if (hasLastDueDate)
                        {
                            <span class="badge badge-danger">Last Due Date: @lastDueDate</span>
                        }
                        else if (hasNextDueDate)
                        {
                            <span class="badge badge-warning">Next Due Date: @nextDueDate</span>
                        }
                        else
                        {
                            <span class="badge badge-ok">No Dues</span>
                        }
                    </td>
                </tr>
                <tr class="meta-spacer"><td colspan="10"></td></tr>

                <!-- Member Information Section -->
                @if (memberInfo != null)
                {
                    <tr class="section-header">
                        <td colspan="10"><strong>Member Information</strong></td>
                    </tr>
                    <tr class="member-info">
                        <td colspan="2"><strong>Member Id :</strong> @memberInfo.MemberId</td>
                        <td colspan="4"><strong>Member Name :</strong> @memberInfo.MemberName</td>
                        <td colspan="4"><strong>Loan Type :</strong> @memberInfo.LoanTypeName</td>
                    </tr>
                    <tr class="member-info">
                        <td colspan="2"><strong>Loan Amount :</strong> @(memberInfo.LoanIssueAmount?.ToString("N2"))</td>
                        <td colspan="2"><strong>Interest Rate :</strong> @(memberInfo.InterestRate?.ToString("N2"))%</td>
                        <td colspan="3"><strong>Issue Date :</strong> @memberInfo.LoanIssueOnBs</td>
                        <td colspan="3"><strong>Maturity Date :</strong> @memberInfo.MaturityOnBs</td>
                    </tr>
                    <tr class="member-info">
                        <td colspan="4"><strong>Address :</strong> @memberInfo.ContactAddress</td>
                        <td colspan="3"><strong>Contact :</strong> @memberInfo.ContactNo</td>
                        <td colspan="3"><strong>Status :</strong> @memberInfo.AccountStatus</td>
                    </tr>
                    <tr class="meta-spacer"><td colspan="10"></td></tr>
                }

                <!-- Installment Dues Detail Section -->
                @if (installments.Any())
                {
                    <tr class="section-header">
                        <td colspan="10"><strong>Installment Dues Detail</strong></td>
                    </tr>
                    <tr>
                        <th class="text-center">S.N.</th>
                        <th>Due Date</th>
                        <th class="text-center">Days</th>
                        <th class="text-center">Penalty %</th>
                        <th class="text-right">Principal</th>
                        <th class="text-right">Interest</th>
                        <th class="text-right">Due Amount</th>
                        <th class="text-right">Net Penalty</th>
                        <th>Default From</th>
                        <th class="text-center">Default Days</th>
                    </tr>
                    foreach (var item in installments)
                    {
                        <tr class="detail-row">
                            <td class="text-center">@(item.Sno ?? 0)</td>
                            <td>@(item.DueDate ?? "")</td>
                            <td class="text-center">@(item.NoOfDays ?? 0)</td>
                            <td class="text-center">@(item.PenaltyPercent ?? "")</td>
                            <td class="text-right">@(item.Principle.HasValue ? item.Principle.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(item.Interest.HasValue ? item.Interest.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(item.DueAmount.HasValue ? item.DueAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(item.NetPenalty.HasValue ? item.NetPenalty.Value.ToString("N2") : "")</td>
                            <td>@(item.DefaultFrom ?? "")</td>
                            <td class="text-center">@(item.DefaultDays ?? 0)</td>
                        </tr>
                    }
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalPrinciple.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalInterest.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalDueAmount.ToString("N2")</strong></td>
                        <td class="text-right"><strong>@totalNetPenalty.ToString("N2")</strong></td>
                        <td colspan="2"></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="9" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">No installment dues found for the selected criteria</td>
                    </tr>
                }

                <!-- Closing Dues Section -->
                @if (closingDues.Any())
                {
                    <tr class="meta-spacer"><td colspan="10"></td></tr>
                    <tr class="section-header">
                        <td colspan="10"><strong>Account Closing Due Details</strong></td>
                    </tr>
                    <tr>
                        <th colspan="7">Title</th>
                        <th colspan="3" class="text-right">Amount</th>
                    </tr>
                    foreach (var due in closingDues)
                    {
                        <tr class="detail-row">
                            <td colspan="7">@(due.Title ?? "")</td>
                            <td colspan="3" class="text-right">@(due.Amount.HasValue ? due.Amount.Value.ToString("N2") : "")</td>
                        </tr>
                    }
                }

                <!-- Payment Details Section -->
                @if (payments.Any())
                {
                    <tr class="meta-spacer"><td colspan="10"></td></tr>
                    <tr class="section-header">
                        <td colspan="10"><strong>Payment Details</strong></td>
                    </tr>
                    <tr>
                        <th colspan="2">Payment Date</th>
                        <th colspan="2">Payment Mode</th>
                        <th colspan="2" class="text-right">Amount</th>
                        <th colspan="2">Cheque No</th>
                        <th colspan="2">Narration</th>
                    </tr>
                    foreach (var pay in payments)
                    {
                        <tr class="detail-row">
                            <td colspan="2">@(pay.PaymentDate ?? "")</td>
                            <td colspan="2">@(pay.PaymentMode ?? "")</td>
                            <td colspan="2" class="text-right">@(pay.PaymentAmount.HasValue ? pay.PaymentAmount.Value.ToString("N2") : "")</td>
                            <td colspan="2">@(pay.ChequeNo ?? "")</td>
                            <td colspan="2">@(pay.Narration ?? "")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</body>
</html>