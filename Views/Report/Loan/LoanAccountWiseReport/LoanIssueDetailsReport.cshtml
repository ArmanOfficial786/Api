@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAccountWiseReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanIssueDetailsRowDto>) ?? new List<LoanIssueDetailsRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var memberId = Model["MemberId"]?.ToString() ?? "";
    var memberName = Model["MemberName"]?.ToString() ?? "";
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var reportType = Model["ReportType"]?.ToString() ?? "LIR";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberSearch = !string.IsNullOrEmpty(memberId);
    var reportTitle = reportType.Equals("LIRR", StringComparison.OrdinalIgnoreCase)
        ? "Loan Issue Report (Reschedule)."
        : "Loan Issue Report.";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@reportTitle</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    overflow: hidden;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                text-align: left;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: normal;
                line-height: 1.2;
                vertical-align: bottom;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .sn-col {
                text-align: center;
                color: #555;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanIssueDetails">
            <colgroup>
                <col style="width:4%;" />
                <col style="width:9%;" />
                <col style="width:15%;" />
                <col style="width:10%;" />
                <col style="width:12%;" />
                <col style="width:9%;" />
                <col style="width:7%;" />
                <col style="width:12%;" />
                <col style="width:8%;" />
                <col style="width:14%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="10">@reportTitle</td>
                </tr>

                <!-- Metadata -->
                @if (isMemberSearch)
                {
                    <tr class="meta-row">
                        <td colspan="10"><strong>Member :</strong> @memberId — @memberName</td>
                    </tr>
                    <tr class="meta-row">
                        <td colspan="10"><strong>Branch :</strong> @branchName</td>
                    </tr>
                }
                else
                {
                    <tr class="meta-row">
                        <td colspan="10"><strong>Branch Name :</strong> @branchName</td>
                    </tr>
                    <tr class="meta-row">
                        <td colspan="10">
                            <strong>From Date :</strong> @fromDate
                            &nbsp;&nbsp;&nbsp;&nbsp;
                            <strong>To Date :</strong> @toDate
                        </td>
                    </tr>
                }
                <tr class="meta-row">
                    <td colspan="10"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="10"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>S.No</th>
                    <th>Member ID</th>
                    <th>Name</th>
                    <th>Account No</th>
                    <th>Account Type</th>
                    <th>Issue Date</th>
                    <th>Period</th>
                    <th class="text-right">Issue Amount</th>
                    <th class="text-right">Int Rate</th>
                    <th>Loan Status</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="detail-row">
                            <td class="sn-col">@sn</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.FullName ?? "")</td>
                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            <td>@(row.LoanIssueDate ?? "")</td>
                            <td>@(row.Period ?? "")</td>
                            <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.InterestRate ?? "")</td>
                            <td>@(row.TransStatus ?? "")</td>
                        </tr>
                    }
                
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>