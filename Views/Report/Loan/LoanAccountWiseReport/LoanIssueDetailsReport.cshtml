@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAccountWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<LoanIssueDetailsRowDto>) ?? new List<LoanIssueDetailsRowDto>();

    var memberId = Text("MemberId");
    var memberName = Text("MemberName");
    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var reportType = Text("ReportType", "LIR");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberSearch = !string.IsNullOrEmpty(memberId);
    var reportTitle = reportType.Equals("LIRR", StringComparison.OrdinalIgnoreCase)
        ? "Loan Issue Report (Reschedule)."
        : "Loan Issue Report.";

    var table = new ReportTable(Model, title: reportTitle, sheetName: "LoanIssueDetails")
        .Column("S.No", 4, Align.Center)
        .Column("Member ID", 9)
        .Column("Name", 15)
        .Column("Account No", 10)
        .Column("Account Type", 12)
        .Column("Issue Date", 9)
        .Column("Period", 7)
        .Column("Issue Amount", 12, Align.Right)
        .Column("Int Rate", 8, Align.Right)
        .Column("Loan Status", 14)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 1px solid #eee; }\n" +
            ".sn-col { color: #555; }");

    if (isMemberSearch)
    {
        table.MetaRow(Fmt.Labeled("Member :", $"{memberId} — {memberName}"));
        table.MetaRow(Fmt.Labeled("Branch :", branchName));
    }
    else
    {
        table.MetaRow(Fmt.Labeled("Branch Name :", branchName));
        table.MetaRow(Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)));
    }
    table.MetaRow(Fmt.Labeled("Report Generated On :", generatedOn));

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            new ReportCell((++sn).ToString(), Align.Center, 1, "sn-col"),
            ReportCell.Left(row.MemberId ?? ""),
            ReportCell.Left(row.FullName ?? ""),
            ReportCell.Left(row.LoanAccountNo ?? ""),
            ReportCell.Left(row.LoanTypeName ?? ""),
            ReportCell.Left(row.LoanIssueDate ?? ""),
            ReportCell.Left(row.Period ?? ""),
            ReportCell.Right(Money(row.LoanIssueAmount)),
            ReportCell.Right(row.InterestRate ?? ""),
            ReportCell.Left(row.TransStatus ?? ""));
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())