@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAccountWiseReport;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanVerifiedUnverifiedRowDto>) ?? new List<LoanVerifiedUnverifiedRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalLoanIssueAmount = Model["TotalLoanIssueAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var reportType = Model["ReportType"]?.ToString() ?? "V";
    var reportTypeName = Model["ReportTypeName"]?.ToString() ?? "Loan Verified Report";
    var orderBy = Model["OrderBy"]?.ToString() ?? "-1";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@reportTypeName</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    word-break: break-word;
                    padding: 5px 6px;
                    vertical-align: top;
                    line-height: 1.35;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
                line-height: 1.4;
                vertical-align: top;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                vertical-align: middle;
            }

            .detail-row td {
                border-bottom: 1px solid #eee;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanVerifiedUnverified">
            <colgroup>
                <col style="width:6%;" />
                <col style="width:9%;" />
                <col style="width:13%;" />
                <col style="width:12%;" />
                <col style="width:10%;" />
                <col style="width:9%;" />
                <col style="width:10%;" />
                <col style="width:8%;" />
                <col style="width:9%;" />
                <col style="width:9%;" />
                <col style="width:5%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="11">@reportTypeName</td>
                </tr>

                <!-- Metadata -->
                <tr class="meta-row">
                    <td colspan="11"><strong>Branch Name:</strong> @branchName</td>
                </tr>
                <tr class="meta-spacer"><td colspan="11"></td></tr>

                <tr class="meta-row">
                    <td colspan="5"><strong>From Date :</strong> @fromDate &nbsp;&nbsp;&nbsp; <strong>To Date :</strong> @toDate</td>
                    <td colspan="6" class="text-right"><strong>Report Generated On:</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="11"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>S.No.</th>
                    <th>Member Id</th>
                    <th>Member Name</th>
                    <th>Loan Type</th>
                    <th>Loan Account</th>
                    <th>Issued On</th>
                    <th class="text-right">Amount</th>
                    <th class="text-right">Rate(%)</th>
                    <th>Verified On</th>
                    <th>Verified By</th>
                    <th>Period</th>
                </tr>

                @if (rows.Any())
                {
                    var sn = 0;
                    foreach (var row in rows)
                    {
                        sn++;
                        <tr class="detail-row">
                            <td>@sn</td>
                            <td>@(row.MemberId ?? "")</td>
                            <td>@(row.MemberName ?? "")</td>
                            <td>@(row.LoanTypeName ?? "")</td>
                            <td>@(row.LoanAccountNo ?? "")</td>
                            <td>@(row.LoanIssueOn ?? "")</td>
                            <td class="text-right">@(row.LoanIssueAmount.HasValue ? row.LoanIssueAmount.Value.ToString("N2") : "")</td>
                            <td class="text-right">@(row.InterestRate ?? "")</td>
                            <td>@(row.VerifiedOnBS ?? "")</td>
                            <td>@(row.VerifiedBy ?? "")</td>
                            <td>@(row.Period ?? "")</td>
                        </tr>
                    }

                    <!-- Grand Total Row -->
                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Grand Total</td>
                        <td class="text-right">@totalLoanIssueAmount.ToString("N2")</td>
                        <td colspan="4"></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="10" class="text-right">Total Records</td>
                        <td class="text-center">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>