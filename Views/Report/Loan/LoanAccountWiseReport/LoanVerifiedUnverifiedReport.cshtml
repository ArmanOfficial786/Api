@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAccountWiseReport
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 11;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal Dec(string key) => Model.TryGetValue(key, out var dv) && dv != null ? Convert.ToDecimal(dv) : 0m;
    decimal TotalOr(string key, decimal fallback)
    {
        var value = Dec(key);
        return value != 0 ? value : fallback;
    }

    var rows = (Model["Rows"] as List<LoanVerifiedUnverifiedRowDto>) ?? new List<LoanVerifiedUnverifiedRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var reportTypeName = Text("ReportTypeName");
    if (string.IsNullOrEmpty(reportTypeName)) reportTypeName = "Loan Verified Report";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalLoanIssueAmount = Dec("TotalLoanIssueAmount");

    var table = new ReportTable(Model, title: reportTypeName, sheetName: "LoanVerifiedUnverified")
        .Column("S.No.", 6)
        .Column("Member Id", 9)
        .Column("Member Name", 13)
        .Column("Loan Type", 12)
        .Column("Loan Account", 10)
        .Column("Issued On", 9)
        .Column("Amount", 10, Align.Right)
        .Column("Rate(%)", 8, Align.Right)
        .Column("Verified On", 9)
        .Column("Verified By", 9)
        .Column("Period", 5)
        .Style(new ReportStyle
        {
            ZebraStripes = false
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }");

    table.MetaRow(Fmt.Labeled("Branch Name:", branchName));
    table.MetaRow(
        Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)),
        Fmt.Labeled("Report Generated On:", generatedOn),
        5);

    var sn = 0;
    foreach (var row in rows)
    {
        table.Data(
            (++sn).ToString(),
            row.MemberId ?? "",
            row.MemberName ?? "",
            row.LoanTypeName ?? "",
            row.LoanAccountNo ?? "",
            row.LoanIssueOn ?? "",
            Fmt.Amount(row.LoanIssueAmount),
            row.InterestRate ?? "",
            row.VerifiedOnBS ?? "",
            row.VerifiedBy ?? "",
            row.Period ?? "");
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", 6, totalLoanIssueAmount.ToString("N2"), "", "", "", "");
        table.Total("Total Records", ColumnCount - 1, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())