@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 7;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "";

    var rows = (Model["Rows"] as List<LoanPrinciplePaymentRowDto>) ?? new List<LoanPrinciplePaymentRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var paymentTypeName = Text("PaymentTypeName");
    if (string.IsNullOrEmpty(paymentTypeName)) paymentTypeName = "Principle Payment";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var accountGroups = rows
        .GroupBy(r => new { r.MemberId, r.FullName, r.LoanAccountNo, r.LoanTypeName })
        .ToList();

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);
    var totalPaidAmount = TotalOr("TotalPaidAmount", rows.Sum(r => r.PaidAmount ?? 0));

    var table = new ReportTable(Model, title: $"Loan {paymentTypeName} Report", sheetName: "LoanPrinciplePayment")
        .Column("Member Id", 10)
        .Column("Name", 18)
        .Column("Account No", 14)
        .Column("Account Type", 16)
        .Column("", 6)
        .Column("Date", 14)
        .Column("Paid Amount (p)", 22, Align.Right)
        .Style(new ReportStyle
        {
            ZebraStripes = false,
            HeaderBackground = "#fff",
            GroupBackground = "#fff",
            TotalBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 5.5, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-group td, " +
            "table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-header th { border-top: 1px solid #000; white-space: nowrap; }\n" +
            "table.sheet-table tr.r-group td { border-top: 1px solid #eee; border-bottom: 0; padding-top: 6px; }\n" +
            "table.sheet-table tr.r-data td { border-bottom: 0; }");

    table.MetaRow(Fmt.Labeled("Branch Name:", branchName));
    table.MetaRow(Fmt.Join(Fmt.Labeled("From Date:", fromDate), Fmt.Labeled("Till Date:", toDate)));
    table.MetaRow(Fmt.Labeled("Report Generated On:", generatedOn));

    foreach (var account in accountGroups)
    {
        table.GroupBy(
            ReportCell.Left(account.Key.MemberId ?? ""),
            ReportCell.Left(account.Key.FullName ?? ""),
            ReportCell.Left(account.Key.LoanAccountNo ?? ""),
            ReportCell.Left(account.Key.LoanTypeName ?? ""),
            ReportCell.Left("", ColumnCount - 4));

        var sn = 0;
        foreach (var row in account)
        {
            table.Data(
                "",
                "",
                "",
                "",
                (++sn).ToString(),
                row.Date ?? "",
                Money(row.PaidAmount));
        }
    }

    if (rows.Count > 0)
    {
        table.Total("Grand Total", ColumnCount - 1, totalPaidAmount.ToString("N2"));
        table.Total("Total Records", ColumnCount - 1, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())