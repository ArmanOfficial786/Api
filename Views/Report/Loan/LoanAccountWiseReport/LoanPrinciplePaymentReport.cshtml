@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanPrinciplePaymentRowDto>) ?? new List<LoanPrinciplePaymentRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalPaidAmount = Model["TotalPaidAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var paymentTypeName = Model["PaymentTypeName"]?.ToString() ?? "Principle Payment";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    // Grouped by Member Id + Name + Loan A/C No + Loan Type — matches the image:
    // each member/account combo's identifying columns are shown once, with a
    // numbered payment list (SN, Date, Paid Amount) nested underneath. Rows must
    // arrive pre-sorted so a member's/account's rows are contiguous, since
    // GroupBy preserves first-seen order rather than sorting.
    var accountGroups = rows
        .GroupBy(r => new { r.MemberId, r.FullName, r.LoanAccountNo, r.LoanTypeName })
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan @paymentTypeName Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 3px 6px;
                    vertical-align: top;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 2px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 10px;
            }

            .data-table th {
                border-top: 1px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
                font-weight: bold;
            }

            .account-row td {
                border-top: 1px solid #eee;
                padding-top: 6px;
                font-weight: bold;
            }

            .payment-row td {
                padding: 1px 6px;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanPrinciplePayment">
            <colgroup>
                <col style="width:10%;" />
                <col style="width:18%;" />
                <col style="width:14%;" />
                <col style="width:16%;" />
                <col style="width:6%;" />
                <col style="width:14%;" />
                <col style="width:22%;" />
            </colgroup>
            <tbody>
                <tr class="meta-title">
                    <td colspan="7">Loan @paymentTypeName Report</td>
                </tr>

                <tr class="meta-row">
                    <td colspan="7"><strong>Branch Name:</strong> &nbsp;&nbsp;@branchName</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="7"><strong>From Date:</strong> &nbsp;&nbsp;@fromDate &nbsp;&nbsp;&nbsp;&nbsp; <strong>Till Date:</strong> &nbsp;&nbsp;@toDate</td>
                </tr>
                <tr class="meta-row">
                    <td colspan="7"><strong>Report Generated On:</strong> &nbsp;&nbsp;@generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <tr>
                    <th>Member Id</th>
                    <th>Name</th>
                    <th>Account No</th>
                    <th>Account Type</th>
                    <th></th>
                    <th>Date</th>
                    <th class="text-right">Paid Amount (p)</th>
                </tr>

                @if (accountGroups.Any())
                {
                    foreach (var account in accountGroups)
                    {
                        <tr class="account-row">
                            <td>@(account.Key.MemberId ?? "")</td>
                            <td>@(account.Key.FullName ?? "")</td>
                            <td>@(account.Key.LoanAccountNo ?? "")</td>
                            <td>@(account.Key.LoanTypeName ?? "")</td>
                            <td colspan="3"></td>
                        </tr>

                        var sn = 0;
                        foreach (var row in account)
                        {
                            sn++;
                            <tr class="payment-row">
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>@sn</td>
                                <td>@(row.Date ?? "")</td>
                                <td class="text-right">@(row.PaidAmount.HasValue ? row.PaidAmount.Value.ToString("N2") : "")</td>
                            </tr>
                        }
                    }

                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Grand Total</td>
                        <td class="text-right">@totalPaidAmount.ToString("N2")</td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right">Total Records</td>
                        <td class="text-center">@totalRecords</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>