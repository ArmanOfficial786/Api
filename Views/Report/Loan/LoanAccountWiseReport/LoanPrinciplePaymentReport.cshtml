@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports;
@model Dictionary<string, object>
@{
    Layout = null;

    var rows = (Model["Rows"] as List<LoanPrinciplePaymentRowDto>) ?? new List<LoanPrinciplePaymentRowDto>();
    var totalRecords = Model["TotalRecords"] as int? ?? 0;
    var totalPaidAmount = Model["TotalPaidAmount"] as decimal? ?? 0;
    var fromDate = Model["FromDate"]?.ToString() ?? "";
    var toDate = Model["ToDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var paymentTypeName = Model["PaymentTypeName"]?.ToString() ?? "Principle Payment";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "";
    var format = Model["Format"]?.ToString() ?? "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberGroupFiltered = !string.IsNullOrEmpty(memberGroupName);
    var hasDateRange = !string.IsNullOrEmpty(fromDate) && !string.IsNullOrEmpty(toDate);

    // ── Group consecutive rows by member so the member's Id/Name/Account
    // columns render once per group (via rowspan), matching the target
    // layout, instead of repeating on every transaction row.
    var groups = new List<List<LoanPrinciplePaymentRowDto>>();
    foreach (var r in rows)
    {
        var last = groups.Count > 0 ? groups[groups.Count - 1] : null;
        if (last != null
            && last[0].MemberId == r.MemberId
            && last[0].LoanAccountNo == r.LoanAccountNo)
        {
            last.Add(r);
        }
        else
        {
            groups.Add(new List<LoanPrinciplePaymentRowDto> { r });
        }
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Loan @paymentTypeName Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                background: white;
                color: #000;
            }

            .report-container {
                width: 100%;
                overflow: visible;
            }

            thead {
                display: table-row-group;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 9pt;
                table-layout: fixed;
            }

                .data-table td, .data-table th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    padding: 4px 6px;
                    vertical-align: middle;
                }

            .meta-title td {
                text-align: center;
                font-family: "Times New Roman", Times, serif;
                font-size: 14pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 8px 6px;
            }

            .meta-row td {
                padding: 3px 6px;
                font-size: 9pt;
            }

            .meta-spacer td {
                height: 6px;
            }

            .data-table th {
                background: #f9f9f9;
                border-top: 2px solid #000;
                border-bottom: 1px solid #000;
                text-align: left;
                white-space: nowrap;
            }

            /* Every transaction/detail cell gets a thin bottom rule. Because
                           the member-info cells use rowspan, their single bottom border
                           naturally lands at the bottom of the last transaction row in
                           that member's group — producing the group separator seen in
                           the target image with no extra markup needed. */
            .data-table td {
                border-bottom: 1px solid #ddd;
            }

            .grand-total-row td {
                border-top: 2px solid #000;
                border-bottom: 2px solid #000;
                font-weight: bold;
                background: #f9f9f9;
                padding: 5px 6px;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            @@media print {
                thead {
                    display: table-row-group;
                }

                tr {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }
    </style>
</head>
<body>
    <div class="report-container">

        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <table class="data-table" data-sheet-name="LoanPrinciplePayment">
            <colgroup>
                <col style="width:10%;" />
                <col style="width:20%;" />
                <col style="width:15%;" />
                <col style="width:15%;" />
                <col style="width:8%;" />
                <col style="width:15%;" />
                <col style="width:17%;" />
            </colgroup>
            <tbody>
                <!-- Report Title -->
                <tr class="meta-title">
                    <td colspan="7">Loan @paymentTypeName Report</td>
                </tr>

                <!-- Metadata -->
                <tr class="meta-row">
                    <td colspan="7"><strong>Branch Name :</strong> @branchName</td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>
                @if (hasDateRange)
                {
                    <tr class="meta-row">
                        <td colspan="7">
                            <strong>From Date :</strong> @fromDate
                            <text>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</text>
                            <strong>Till Date :</strong> @toDate
                        </td>
                    </tr>
                }
                @if (isMemberGroupFiltered)
                {
                    <tr class="meta-row">
                        <td colspan="7"><strong>Member Group :</strong> @memberGroupName</td>
                    </tr>
                }
                <tr class="meta-row">
                    <td colspan="7"><strong>Report Generated On :</strong> @generatedOn</td>
                </tr>
                <tr class="meta-spacer"><td colspan="7"></td></tr>

                <!-- Table Header -->
                <tr>
                    <th>Member Id</th>
                    <th>Name</th>
                    <th>Account No</th>
                    <th>Account Type</th>
                    <th></th>
                    <th>Date</th>
                    <th class="text-right">Paid Amount (p)</th>
                </tr>

                @if (rows.Any())
                {
                    foreach (var group in groups)
                    {
                        var count = group.Count;
                        for (var i = 0; i < count; i++)
                        {
                            var row = group[i];
                            <tr>
                                @if (i == 0)
                                {
                                    <td rowspan="@count">@(row.MemberId ?? "")</td>
                                    <td rowspan="@count">@(row.FullName ?? "")</td>
                                    <td rowspan="@count">@(row.LoanAccountNo ?? "")</td>
                                    <td rowspan="@count">@(row.LoanTypeName ?? "")</td>
                                }
                                <td class="text-center">@(i + 1)</td>
                                <td>@(row.Date ?? "")</td>
                                <td class="text-right">@(row.PaidAmount.HasValue ? row.PaidAmount.Value.ToString("N2") : "")</td>
                            </tr>
                        }
                    }

                    <!-- Grand Total Row -->
                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>@totalPaidAmount.ToString("N2")</strong></td>
                    </tr>
                    <tr class="grand-total-row">
                        <td colspan="6" class="text-right"><strong>Total Records</strong></td>
                        <td class="text-center"><strong>@totalRecords</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No data found for the selected criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>