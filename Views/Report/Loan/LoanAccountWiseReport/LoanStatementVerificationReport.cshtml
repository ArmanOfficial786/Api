@using NexgenCosysReport.Dtos.RequestDtos.Loan.OtherReports
@using NexgenCosysReport.Services.ReportService.Table
@model Dictionary<string, object>
@{
    Layout = null;

    var fontSize = "9pt";
    const int ColumnCount = 7;

    string Text(string key, string fallback = "") => Model.TryGetValue(key, out var sv) && sv != null ? sv.ToString() ?? fallback : fallback;
    decimal TotalOr(string key, decimal fallback)
    {
        if (Model.TryGetValue(key, out var tv) && tv != null)
        {
            var dv = Convert.ToDecimal(tv);
            if (dv != 0) return dv;
        }
        return fallback;
    }

    var rows = (Model["Rows"] as List<LoanStatementVerificationRowDto>) ?? new List<LoanStatementVerificationRowDto>();

    var fromDate = Text("FromDate");
    var toDate = Text("ToDate");
    var branchName = Text("BranchName", "All");
    var memberName = Text("MemberName");
    var collectorName = Text("CollectorName");
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    var isMemberSearch = !string.IsNullOrEmpty(memberName);
    var isCollectorFiltered = !string.IsNullOrEmpty(collectorName);
    var hasDateRange = !string.IsNullOrEmpty(fromDate) && !string.IsNullOrEmpty(toDate);

    var totalRecords = (int)TotalOr("TotalRecords", rows.Count);

    var table = new ReportTable(Model, title: "Loan Statement Verification Report", sheetName: "LoanStatementVerification")
        .Column("Member Id", 10)
        .Column("Member Name", 20)
        .Column("Loan A/c No", 15)
        .Column("Pass Book Verified Till", 17)
        .Column("Verified Date", 13)
        .Column("Verified Time", 14)
        .Column("Verified By", 11)
        .Style(new ReportStyle
        {
            ZebraStripes = true,
            ZebraBackground = "#f9f9f9"
        })
        .Sizing(rowMm: 6, headerMm: 8, firstPageExtraMm: 65)
        .Css(
            "table.sheet-table tr.r-header th, table.sheet-table tr.r-data td, table.sheet-table tr.r-total td " +
            "{ font-size: " + fontSize + "; line-height: 1.25; padding: 1px 6px; }\n" +
            "table.sheet-table tr.r-data td.verified-cell " +
            "{ background: #d4edda; color: #155724; font-weight: bold; font-size: 8pt; }");

    if (isMemberSearch)
    {
        table.MetaRow(Fmt.Labeled("Member :", memberName), Fmt.Labeled("Branch :", branchName), 4);
    }
    else
    {
        table.MetaRow(
            Fmt.Labeled("Branch Name :", branchName),
            hasDateRange ? Fmt.Join(Fmt.Labeled("From Date :", fromDate), Fmt.Labeled("To Date :", toDate)) : null,
            4);
    }

    if (isCollectorFiltered)
        table.MetaRow(Fmt.Labeled("Collector :", collectorName), Fmt.Labeled("Report Generated On :", generatedOn), 4);
    else
        table.MetaRow(Fmt.Join(), Fmt.Labeled("Report Generated On :", generatedOn), 4);

    foreach (var row in rows)
    {
        var verifiedTill = row.PassBookVerifiedTill ?? "";
        table.Data(
            ReportCell.Left(row.MemberId ?? ""),
            ReportCell.Left(row.MemberName ?? ""),
            ReportCell.Left(row.LoanAccountNo ?? ""),
            new ReportCell(verifiedTill, Align.Left, 1, verifiedTill.Length > 0 ? "verified-cell" : null),
            ReportCell.Left(row.VerifiedDate ?? ""),
            ReportCell.Left(row.VerifiedTime.HasValue ? row.VerifiedTime.Value.ToString("yyyy/MM/dd HH:mm:ss") : ""),
            ReportCell.Left(row.VerifiedBy ?? ""));
    }

    if (rows.Count > 0)
    {
        table.Total("Total Records", ColumnCount - 1, totalRecords.ToString());
    }
}
@await Html.PartialAsync("_SheetReport", table.Build())