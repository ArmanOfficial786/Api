@model Dictionary<string, object>
@using NexgenCosysReport.Dtos.ReportDtos
@using NexgenCosysReport.Dtos.RequestDtos
@using NexgenCosysReport.Dtos.RequestDtos.MemberAccount
@{
    Layout = null;

    var dataSet = (Model["AccountStatementDataSet"] as IEnumerable<AccountStatementModelResponse>)
                  ?.ToList() ?? new List<AccountStatementModelResponse>();

    var balanceData = (Model["CashBankBalanceDataSet"] as IEnumerable<CashBankBalanceModelResponse>)
                      ?.ToList() ?? new List<CashBankBalanceModelResponse>();

    var reportType = Model.ContainsKey("ReportType") ? Model["ReportType"]?.ToString() : "SubLedger";
    var transactionType = Model.ContainsKey("TransactionType") ? Model["TransactionType"]?.ToString() : "All";
    var branchName = Model.ContainsKey("BranchName") ? Model["BranchName"]?.ToString() : "All";
    var fromDate = Model.ContainsKey("FromDate") ? Model["FromDate"]?.ToString() : "";
    var toDate = Model.ContainsKey("ToDate") ? Model["ToDate"]?.ToString() : "";
    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";

    var balance = balanceData.FirstOrDefault();
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss");

    List<string> chartLabels = new List<string>();
    List<decimal> chartDebits = new List<decimal>();
    List<decimal> chartCredits = new List<decimal>();
    List<decimal> chartBalances = new List<decimal>();

    if (reportType == "Summary")
    {
        var groups = dataSet.GroupBy(x => x.LedgerHead).OrderBy(g => g.Key);
        chartLabels = groups.Select(g => g.Key).ToList();
        chartDebits = groups.Select(g => g.Sum(x => x.DebitAmount)).ToList();
        chartCredits = groups.Select(g => g.Sum(x => x.CreditAmount)).ToList();
        chartBalances = groups.Select(g => g.Sum(x => x.Balance)).ToList();
    }
    else if (reportType == "SubLedger")
    {
        var groups = dataSet
            .GroupBy(x => string.IsNullOrEmpty(x.MainLedger) ? x.SubLedger : x.MainLedger)
            .OrderBy(g => g.Key);
        chartLabels = groups.Select(g => g.Key).ToList();
        chartDebits = groups.Select(g => g.Sum(x => x.DebitAmount)).ToList();
        chartCredits = groups.Select(g => g.Sum(x => x.CreditAmount)).ToList();
        chartBalances = groups.Select(g => g.Sum(x => x.Balance)).ToList();
    }
    else
    {
        var groups = dataSet
            .GroupBy(x => string.IsNullOrEmpty(x.SubLedger1) || x.SubLedger1 == "-"
                            ? x.SubLedger
                            : $"{x.SubLedger} — {x.SubLedger1}")
            .OrderBy(g => g.Key);
        chartLabels = groups.Select(g => g.Key).ToList();
        chartDebits = groups.Select(g => g.Sum(x => x.DebitAmount)).ToList();
        chartCredits = groups.Select(g => g.Sum(x => x.CreditAmount)).ToList();
        chartBalances = groups.Select(g => g.Sum(x => x.Balance)).ToList();
    }

    string ToJsonString(IEnumerable<string> items) =>
        "[" + string.Join(",", items.Select(i => $"\"{i.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("'", "\\'")}\"")) + "]";
    string ToJsonNumber(IEnumerable<decimal> items) =>
        "[" + string.Join(",", items.Select(i => i.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))) + "]";
    string FormatFull(decimal value) => value.ToString("N2");

    // Server-side: max label character length to pre-compute Y-axis left margin
    int maxLabelLen = chartLabels.Any() ? chartLabels.Max(l => (l ?? "").Length) : 10;
    int rowCount = chartLabels.Count;

    decimal grandDebit = chartDebits.Sum();
    decimal grandCredit = chartCredits.Sum();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Account Statement – @reportType</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        /* ═══════════════════════════════════════════════
        RESET — zero all margin/padding everywhere
        ═══════════════════════════════════════════════ */
        *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        }

        html {
        width: 100%;
        }

        body {
        width: 100%;
        background: #EEF2F7;
        font-family: 'Segoe UI', system-ui, sans-serif;
        font-size: 13px;
        /* NO flex/justify — let content flow naturally top-to-bottom */
        }

        /* ═══════════════════════════════════════════════
        OUTER WRAPPER
        - 100% width, no max-width cap
        - Only horizontal padding; no vertical padding
        except a small top/bottom breathing room
        ═══════════════════════════════════════════════ */
        .rw {
        width: 100%;
        background: #fff;
        padding: 20px 24px 32px;
        }

        /* ═══════════════════════════════════════════════
        SECTION WRAPPER
        - display:block so height is determined purely
        by its children (no extra space)
        - margin-top only at the top of each section
        - overflow:visible so nothing is clipped
        ═══════════════════════════════════════════════ */
        .sec {
        display: block;
        width: 100%;
        margin-top: 20px;
        }

        /* Section heading — tight, no bottom margin beyond 8px */
        .sec-head {
        display: flex;
        align-items: center;
        border-left: 4px solid #1C7A9C;
        padding-left: 10px;
        margin-bottom: 8px;
        font-size: 15px;
        font-weight: 700;
        color: #0B2B40;
        line-height: 1.2;
        }

        /* ═══════════════════════════════════════════════
        CHART CARD
        - width:100%, height is SET BY JS to exactly
        fit all rows — no more, no less
        - position:relative so canvas is positioned
        inside it correctly
        - overflow:hidden clips canvas exactly to card
        ═══════════════════════════════════════════════ */
        .cc {
        width: 100%;
        background: #fff;
        border: 1.5px solid #DDE3EA;
        border-radius: 10px;
        box-shadow: 0 1px 6px rgba(0,0,0,.05);
        /* height injected by JS */
        position: relative;
        overflow: hidden;
        }

        /* Canvas fills card exactly */
        .cc canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100% !important;
        height: 100% !important;
        }

        /* ═══════════════════════════════════════════════
        PILL / BALANCE ROWS
        ═══════════════════════════════════════════════ */
        .pill-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 14px;
        }

        .pill {
        display: flex;
        align-items: center;
        gap: 8px;
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
        font-size: 13px;
        }

        .bal-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 10px;
        }

        .bal-pill {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        padding: 10px 6px;
        border-radius: 12px;
        text-align: center;
        }

        .bal-lbl {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #8896A3;
        }

        .bal-val {
        font-size: 14px;
        font-weight: 800;
        }

        /* ═══════════════════════════════════════════════
        DONUT ROW — 2 equal columns, NO fixed height
        height grows with content automatically
        ═══════════════════════════════════════════════ */
        .donut-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        width: 100%;
        /* NO height, NO overflow:hidden — grows naturally */
        }

        .donut-card {
        background: #fff;
        border: 1.5px solid #E9ECEF;
        border-radius: 16px;
        box-shadow: 0 3px 12px rgba(11,43,64,.06);
        padding: 18px 20px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        }

        .donut-wrap {
        position: relative;
        /* Responsive: fills column width up to 240px */
        width: min(240px, 100%);
        aspect-ratio: 1 / 1;
        }

        .donut-wrap canvas {
        width: 100% !important;
        height: 100% !important;
        }

        .donut-centre {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
        width: 80px;
        }

        .d-leg-box {
        width: 100%;
        background: #F8FAFC;
        border-radius: 10px;
        padding: 8px 10px;
        border: 1px solid #EEF2F7;
        margin-top: 14px;
        }

        .d-leg-hdr {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        color: #8896A3;
        padding-bottom: 6px;
        border-bottom: 1px solid #E9ECEF;
        margin-bottom: 5px;
        }

        .d-leg-scroll {
        display: flex;
        flex-direction: column;
        gap: 3px;
        max-height: 200px;
        overflow-y: auto;
        }

        .lv {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 5px;
        border-radius: 6px;
        }

        .lvd {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
        }

        .lvn {
        flex: 1;
        font-size: 11px;
        font-weight: 500;
        color: #374151;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        }

        .lva {
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
        }

        .lvp {
        font-size: 10px;
        font-weight: 600;
        padding: 1px 6px;
        border-radius: 16px;
        white-space: nowrap;
        }

        /* ═══════════════════════════════════════════════
        DIVIDER — zero margin above, fixed below
        ═══════════════════════════════════════════════ */
        .div {
        width: 100%;
        height: 1.5px;
        background: #111;
        margin-top: 20px;
        }

        /* Filter bar */
        .fb {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        font-size: 12px;
        color: #5A6A78;
        margin-top: 12px;
        }

        .fbr {
        display: flex;
        width: 100%;
        justify-content: space-between;
        }

        /* Footer */
        .footer {
        text-align: center;
        font-size: 10px;
        color: #9CA8B3;
        margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="rw">

        @await Html.PartialAsync("_CommonHeader", Model)

        <!-- Title -->
        <div style="text-align:center;margin-top:6px;">
            <span style="font-size:18px;font-weight:700;color:#000;">Account Statement</span>
        </div>

        <!-- Filter bar -->
        <div class="fb">
            <span><strong>🏢 Branch</strong>&nbsp;@branchName</span>
            <div class="fbr">
                <span><strong>📅 Period</strong>&nbsp;@fromDate → @toDate</span>
                <span><strong>📌 Report Type</strong>&nbsp;@reportType</span>
            </div>
            <div class="fbr">
                <span><strong>🔄 Transaction</strong>&nbsp;@transactionType</span>
                <span><strong>🕒 Generated</strong>&nbsp;@generatedOn</span>
            </div>
        </div>
        <div style="width:100%;height:1px;background:#000;margin-top:6px;"></div>

        <!-- Gray divider above summary pills -->
        <div style="width:100%;height:1px;border:1.5px solid #D1D5DB;background:#FEF7F7;"></div>

        <!-- Summary pills -->
        <div class="pill-row">
            <div class="pill" style="border:1.5px solid #F4BFBD;background:#FEF7F7;color:#C0392B;">
                💸 <strong>TOTAL DEBIT</strong>&nbsp;&nbsp;@FormatFull(grandDebit)
            </div>
            <div class="pill" style="border:1.5px solid #AEDFC3;background:#F2FBF6;color:#1A7A3F;">
                💰 <strong>TOTAL CREDIT</strong>&nbsp;&nbsp;@FormatFull(grandCredit)
            </div>
        </div>

        <!-- Balance pills -->
        @if (balance != null)
        {
            <div class="bal-row">
                <div class="bal-pill" style="background:#F0F7FC;border:1.5px solid #BFD9EC;">
                    <span class="bal-lbl">💰 Opening Cash</span>
                    <span class="bal-val" style="color:#1C5D7A;">@FormatFull(balance.OpeningCashBalance)</span>
                </div>
                <div class="bal-pill" style="background:#F0F7FC;border:1.5px solid #BFD9EC;">
                    <span class="bal-lbl">🏦 Opening Bank</span>
                    <span class="bal-val" style="color:#1C5D7A;">@FormatFull(balance.OpeningBankBalance)</span>
                </div>
                <div class="bal-pill" style="background:#F2FBF6;border:1.5px solid #AEDFC3;">
                    <span class="bal-lbl">📉 Closing Cash</span>
                    <span class="bal-val" style="color:#1A7A3F;">@FormatFull(balance.ClosingCashBalance)</span>
                </div>
                <div class="bal-pill" style="background:#F2FBF6;border:1.5px solid #AEDFC3;">
                    <span class="bal-lbl">📈 Closing Bank</span>
                    <span class="bal-val" style="color:#1A7A3F;">@FormatFull(balance.ClosingBankBalance)</span>
                </div>
            </div>
        }

        @if (!isExcel)
        {
            @* ══════════════════════════════════════════════
           JS DATA — injected once, used by all charts
        ══════════════════════════════════════════════ *@
            <script id="chartData" type="application/json">
                {
                "labels":   @Html.Raw(ToJsonString(chartLabels)),
                "debits":   @Html.Raw(ToJsonNumber(chartDebits)),
                "credits":  @Html.Raw(ToJsonNumber(chartCredits)),
                "balances": @Html.Raw(ToJsonNumber(chartBalances)),
                "maxLen":   @maxLabelLen,
                "rowCount": @rowCount,
                "reportType": "@reportType"
                }
            </script>

            @* ══ SECTION 1: Grouped bar ══ *@
            <div class="sec">
                <div class="sec-head">
                    📊 Debit &amp; Credit by
                    @(reportType == "Summary" ? "Ledger Head" : reportType == "SubLedger" ? "Main Ledger" : "Transaction")
                </div>
                <div class="cc" id="cc1"><canvas id="ch1"></canvas></div>
            </div>

            <div class="div"></div>

            @* ══ SECTION 2: Donut distribution ══ *@
            <div class="sec">
                <div class="sec-head">⚖️ Debit vs Credit Distribution</div>
                <div class="donut-row">
                    <div class="donut-card">
                        <div style="font-size:13px;font-weight:700;align-self:flex-start;color:#C0392B;margin-bottom:12px;">💸 Debit Share</div>
                        <div class="donut-wrap">
                            <canvas id="dPie"></canvas>
                            <div class="donut-centre" id="dCtr"></div>
                        </div>
                        <div class="d-leg-box">
                            <div class="d-leg-hdr">📋 Breakdown by Head</div>
                            <div class="d-leg-scroll" id="dLeg"></div>
                        </div>
                    </div>
                    <div class="donut-card">
                        <div style="font-size:13px;font-weight:700;align-self:flex-start;color:#1A7A3F;margin-bottom:12px;">💰 Credit Share</div>
                        <div class="donut-wrap">
                            <canvas id="cPie"></canvas>
                            <div class="donut-centre" id="cCtr"></div>
                        </div>
                        <div class="d-leg-box">
                            <div class="d-leg-hdr">📋 Breakdown by Head</div>
                            <div class="d-leg-scroll" id="cLeg"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="div"></div>

            @* ══ SECTION 3: Net Balance ══ *@
            <div class="sec">
                <div class="sec-head">📉 Net Balance by Group</div>
                <div class="cc" id="cc2"><canvas id="ch2"></canvas></div>
            </div>

            <div class="div"></div>

            @* ══ SECTION 4: Stacked bar ══ *@
            <div class="sec">
                <div class="sec-head">📚 Stacked Debit &amp; Credit</div>
                <div class="cc" id="cc3"><canvas id="ch3"></canvas></div>
            </div>

            <p class="footer">Generated on @generatedOn — Amounts in local currency</p>

            <script>
                (function () {
                /* ── Parse injected data ── */
                const raw      = JSON.parse(document.getElementById('chartData').textContent);
                const labels   = raw.labels;
                const debits   = raw.debits.map(Number);
                const credits  = raw.credits.map(Number);
                const balances = raw.balances.map(Number);
                const n        = labels.length;
                const maxLen   = raw.maxLen;

                /* ── Number formatters ── */
                const fmt = v => {
                const a = Math.abs(v);
                if (a >= 1e9) return (v/1e9).toFixed(1)+'B';
                if (a >= 1e6) return (v/1e6).toFixed(1)+'M';
                if (a >= 1e3) return (v/1e3).toFixed(1)+'K';
                return v.toFixed(0);
                };
                const full = v =>
                Number(v).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});

                /* ── Colour palette ── */
                const semantic = {
                assets:'#2C7DA0', expenses:'#E67E22', income:'#28A745', liabilities:'#9B59B6',
                equity:'#F4A261', revenue:'#20C997', capital:'#E74C3C', bank:'#457B9D',
                cash:'#1E8449',   tax:'#C0392B',     payable:'#8E44AD', receivable:'#2980B9',
                provision:'#D35400', reserve:'#16A085', loan:'#7D3C98', investment:'#117A65',
                depreciation:'#884EA0', prepaid:'#1A5276', accrued:'#6E2F1A', profit:'#1D8348'
                };
                const fallback = ['#1C5D7A','#E67E22','#28A745','#9B59B6','#F4A261',
                '#20C997','#E74C3C','#457B9D','#C0392B','#16A085'];
                const colours = labels.map(l => {
                const k = (l||'').toLowerCase();
                for (const [kw,c] of Object.entries(semantic)) if (k.includes(kw)) return c;
                let h = 0;
                for (let i = 0; i < l.length; i++) h = (h*31+l.charCodeAt(i))>>>0;
                return fallback[h % fallback.length];
                });

                /* ══════════════════════════════════════════════════
                HEIGHT CALCULATION
                ─────────────────────────────────────────────────
                Problem in old PDF: charts had a fixed or under-
                estimated height, so bars crushed together and
                the canvas rendered outside its card, overlapping
                the next section heading.

                Fix: compute EXACT pixel height based on:
                - number of rows  (n)
                - row height (ROW_H) — pixels each bar group needs
                - legend / axis overhead (OVERHEAD)

                For grouped bar: each label = 2 bars, needs more
                vertical space per row than single bar.
                ══════════════════════════════════════════════════ */
                const OVERHEAD = 50; // top + bottom axis overhead in px

                // ROW_H: px per label for grouped chart (2 datasets)
                // Smaller when many rows so the page stays manageable.
                // But NEVER below 16px — below that bars are invisible.
                function rowH(count, datasets) {
                const base = datasets === 2 ? 28 : 20;
                if (count > 100) return Math.max(16, base - 8);
                if (count > 60)  return Math.max(18, base - 5);
                if (count > 30)  return Math.max(20, base - 2);
                return base;
                }

                function cardHeight(count, datasets) {
                return Math.max(200, count * rowH(count, datasets) + OVERHEAD);
                }

                /* ── Set card heights (before chart init so canvas
                already has correct pixel dimensions) ── */
                document.getElementById('cc1').style.height = cardHeight(n, 2) + 'px';
                document.getElementById('cc2').style.height = cardHeight(n, 1) + 'px';
                document.getElementById('cc3').style.height = cardHeight(n, 2) + 'px';

                /* ══════════════════════════════════════════════════
                Y-AXIS LEFT PADDING
                ─────────────────────────────────────────────────
                Chart.js reserves a fixed left area for Y-axis
                labels. When labels are long (e.g. "INTEREST
                EXPENSES — Recurring Saving 3 Months mat") the
                text gets clipped or wrapped onto the bars.

                Fix: set afterFit callback to force the Y-axis
                width based on the longest label character count.
                ~6.5px per character is a reliable estimate for
                the default font size.
                ══════════════════════════════════════════════════ */
                const yAxisWidth = Math.min(400, Math.max(100, maxLen * 6.5));

                /* ── Font size scales with row density ── */
                const tickFontSize = n > 100 ? 8 : n > 60 ? 9 : n > 30 ? 10 : 11;

                /* ── Shared options factory for horizontal bar charts ── */
                function hBarOpts(tipCb, stacked) {
                return {
                indexAxis: 'y',
                responsive: false,       // We set explicit px size; Chart.js must NOT override it
                maintainAspectRatio: false,
                layout: { padding: { top: 6, bottom: 6, left: 0, right: 12 } },
                plugins: {
                legend: { display: true, position: 'top',
                labels: { boxWidth: 12, font: { size: 11 } } },
                tooltip: { callbacks: { label: tipCb } }
                },
                scales: {
                x: {
                stacked: !!stacked,
                ticks: { callback: v => fmt(v), font: { size: 10 } },
                grid: { color: '#E9ECEF' }
                },
                y: {
                stacked: !!stacked,
                ticks: {
                font: { size: tickFontSize },
                autoSkip: false,   // NEVER skip labels
                maxRotation: 0,
                padding: 4
                },
                grid: { color: '#F3F4F6' },
                afterFit(axis) {
                // Force the left area to be exactly wide enough for labels
                axis.width = yAxisWidth;
                }
                }
                }
                };
                }

                /* ── Helper: set canvas pixel size to match its card ── */
                function sizeCanvas(canvasId, cardId) {
                const card   = document.getElementById(cardId);
                const canvas = document.getElementById(canvasId);
                canvas.width  = card.clientWidth;
                canvas.height = card.clientHeight;
                }

                /* ════════════════════════════════════════
                CHART 1 — Grouped horizontal bar
                ════════════════════════════════════════ */
                sizeCanvas('ch1', 'cc1');
                new Chart(document.getElementById('ch1'), {
                type: 'bar',
                data: {
                labels,
                datasets: [
                { label:'Debit',  data:debits,
                backgroundColor:colours.map(c=>c+'D9'), borderRadius:3,
                barPercentage:0.82, categoryPercentage:0.88 },
                { label:'Credit', data:credits,
                backgroundColor:colours.map(c=>c+'88'), borderRadius:3,
                barPercentage:0.82, categoryPercentage:0.88 }
                ]
                },
                options: hBarOpts(ctx => `${ctx.dataset.label}: ${full(ctx.raw)}`, false)
                });

                /* ════════════════════════════════════════
                DONUT CHARTS — top 10 only
                ════════════════════════════════════════ */
                const topN   = Math.min(n, 10);
                const tLbls  = labels.slice(0, topN);
                const tCols  = tLbls.map((_, i) => colours[i]);
                const tDeb   = debits.slice(0,  topN);
                const tCred  = credits.slice(0, topN);

                /* Plugin: draw % text on each pie slice */
                const pctPlugin = {
                id: 'pct',
                afterDraw(chart) {
                const { ctx: c, data } = chart;
                const ds   = data.datasets[0];
                const meta = chart.getDatasetMeta(0);
                const tot  = ds.data.reduce((a,b)=>+a+ +b, 0);
                if (!tot) return;
                meta.data.forEach((arc, i) => {
                const pct = (+ds.data[i]/tot)*100;
                if (pct < 3) return;
                const mid = (arc.startAngle+arc.endAngle)/2;
                const r   = (arc.innerRadius+arc.outerRadius)/2;
                c.save();
                c.shadowColor='rgba(0,0,0,.45)'; c.shadowBlur=3;
                c.font = `bold ${pct>10?12:10}px 'Segoe UI',sans-serif`;
                c.fillStyle='#fff'; c.textAlign='center'; c.textBaseline='middle';
                c.fillText(pct.toFixed(1)+'%', arc.x+Math.cos(mid)*r, arc.y+Math.sin(mid)*r);
                c.restore();
                });
                }
                };

                function donutLegendHtml(arr, total, cols) {
                return arr.map((val,i)=>{
                const pct = total>0?((val/total)*100).toFixed(1):'0.0';
                const c = cols[i], nm = tLbls[i];
                return `<div class="lv">
                <span class="lvd" style="background:${c}"></span>
                <span class="lvn" title="${nm}">${nm}</span>
                <span class="lva" style="color:${c}">${full(val)}</span>
                <span class="lvp" style="color:${c};background:${c}1A;border:1px solid ${c}44">${pct}%</span>
                </div>`;
                }).join('');
                }

                function makeDonut(cId, arr, ctrId, legId, cols) {
                const tot = arr.reduce((a,b)=>+a+ +b, 0);
                new Chart(document.getElementById(cId), {
                type: 'doughnut',
                data: {
                labels: tLbls,
                datasets:[{ data:arr, backgroundColor:cols,
                borderWidth:2, borderColor:'#fff', hoverOffset:8 }]
                },
                options: {
                responsive: true,
                maintainAspectRatio: true,
                cutout: '58%',
                layout: { padding: 4 },
                animation: { animateRotate:true, duration:600 },
                plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: ctx => {
                const v = +ctx.raw;
                const p = tot>0?((v/tot)*100).toFixed(1):'0.0';
                return `  ${ctx.label}: ${full(v)}  (${p}%)`;
                }}}
                }
                },
                plugins: [pctPlugin]
                });
                const cEl = document.getElementById(ctrId);
                if (cEl) cEl.innerHTML =
                `<div style="font-size:9px;font-weight:700;color:#8896A3;line-height:1.3">TOTAL</div>
                <div style="font-size:18px;font-weight:900;color:#0B2B40;line-height:1.2">${fmt(tot)}</div>`;
                const lEl = document.getElementById(legId);
                if (lEl) lEl.innerHTML = donutLegendHtml(arr, tot, cols);
                }

                makeDonut('dPie', tDeb,  'dCtr', 'dLeg', tCols);
                makeDonut('cPie', tCred, 'cCtr', 'cLeg', tCols);

                /* ════════════════════════════════════════
                CHART 2 — Net Balance bar
                ════════════════════════════════════════ */
                sizeCanvas('ch2', 'cc2');
                new Chart(document.getElementById('ch2'), {
                type: 'bar',
                data: {
                labels,
                datasets: [{
                label: 'Net Balance',
                data: balances,
                backgroundColor: balances.map((v,i) => +v>=0 ? colours[i]+'CC' : '#E76F51CC'),
                borderRadius: 3,
                barPercentage: 0.7,
                categoryPercentage: 0.88
                }]
                },
                options: hBarOpts(ctx => `Balance: ${full(ctx.raw)}`, false)
                });

                /* ════════════════════════════════════════
                CHART 3 — Stacked bar
                ════════════════════════════════════════ */
                sizeCanvas('ch3', 'cc3');
                const sOpts = hBarOpts(ctx => `${ctx.dataset.label}: ${full(ctx.raw)}`, true);
                new Chart(document.getElementById('ch3'), {
                type: 'bar',
                data: {
                labels,
                datasets: [
                { label:'Debit',  data:debits,
                backgroundColor:colours.map(c=>c+'D9'), borderRadius:3,
                barPercentage:0.82, categoryPercentage:0.88 },
                { label:'Credit', data:credits,
                backgroundColor:colours.map(c=>c+'77'), borderRadius:3,
                barPercentage:0.82, categoryPercentage:0.88 }
                ]
                },
                options: sOpts
                });

                })();
            </script>
        }

    </div>
</body>
</html>
