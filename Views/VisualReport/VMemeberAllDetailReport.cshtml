    @* ════════════════════════════════════════════════════════════════════
       Shared chart data + rendering
       (runs for both VIEW hidden-source and PDF)
    ════════════════════════════════════════════════════════════════════ *@
    <script>
        (function () {
        'use strict';

        // ── Data from server ──────────────────────────────────────────
        var DATA = {
        memberType:  { labels: @Html.Raw(memberTypeLabelsJson),  counts: @Html.Raw(memberTypeCountsJson)  },
        status:      { labels: @Html.Raw(statusLabelsJson),      counts: @Html.Raw(statusCountsJson)      },
        gender:      { labels: @Html.Raw(genderLabelsJson),      counts: @Html.Raw(genderCountsJson)      },
        religion:    { labels: @Html.Raw(religionLabelsJson),    counts: @Html.Raw(religionCountsJson)    },
        occupation:  { labels: @Html.Raw(occupationLabelsJson),  counts: @Html.Raw(occupationCountsJson)  },
        memberGroup: { labels: @Html.Raw(memberGroupLabelsJson), counts: @Html.Raw(memberGroupCountsJson) }
        };

        var PALETTE = [
        '#4e73df','#1cc88a','#f6c23e','#e74a3b',
        '#36b9cc','#6f42c1','#fd7e14','#20c997',
        '#e83e8c','#17a2b8','#ffc107','#6610f2'
        ];

        function colors(n) {
        return Array.from({ length: n }, function (_, i) { return PALETTE[i % PALETTE.length]; });
        }

        // ── Plugins ───────────────────────────────────────────────────
        // Center-total text for doughnut charts
        var centerTotalPlugin = {
        id: 'centerTotal',
        afterDraw: function (chart) {
        if (chart.config.type !== 'doughnut') return;
        var total = chart.data.datasets[0].data.reduce(function (a, b) { return a + b; }, 0);
        var cx = chart.ctx;
        var w  = chart.chartArea.left + (chart.chartArea.right  - chart.chartArea.left) / 2;
        var h  = chart.chartArea.top  + (chart.chartArea.bottom - chart.chartArea.top)  / 2;
        cx.save();
        cx.font         = 'bold 13px Arial';
        cx.fillStyle    = '#444';
        cx.textAlign    = 'center';
        cx.textBaseline = 'middle';
        cx.fillText(total, w, h);
        cx.restore();
        }
        };

        // ── Chart factories ───────────────────────────────────────────
        // Doughnut
        function makeDoughnut(canvasId, data) {
        var el = document.getElementById(canvasId);
        if (!el) return;
        if (!data.counts.length) {
        el.parentElement.innerHTML = '<div class="no-data-msg">No data</div>';
        return;
        }
        var existing = Chart.getChart(el);
        if (existing) existing.destroy();

        new Chart(el, {
        type: 'doughnut',
        data: {
        labels: data.labels,
        datasets: [{
        data: data.counts,
        backgroundColor: colors(data.counts.length),
        borderWidth: 2,
        hoverOffset: 6
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '58%',
        plugins: {
        legend: {
        position: 'bottom',
        labels: { font: { size: 9 }, usePointStyle: true, padding: 8 }
        },
        datalabels: {
        color: '#fff',
        font: { weight: 'bold', size: 9 },
        formatter: function (value, ctx) {
        var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
        if (!total) return '';
        var pct = ((value / total) * 100).toFixed(1);
        return pct + '%';
        },
        anchor: 'center',
        align: 'center'
        },
        tooltip: {
        callbacks: {
        label: function (ctx) {
        var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
        var pct   = total ? ((ctx.parsed / total) * 100).toFixed(1) : '0.0';
        return ' ' + ctx.label + ': ' + ctx.parsed + ' (' + pct + '%)';
        }
        }
        }
        }
        },
        plugins: [centerTotalPlugin]
        });
        }

        // Horizontal bar (for Religion and Occupation which can have many labels)
        function makeHBar(canvasId, data) {
        var el = document.getElementById(canvasId);
        if (!el) return;
        if (!data.counts.length) {
        el.parentElement.innerHTML = '<div class="no-data-msg">No data</div>';
        return;
        }
        var existing = Chart.getChart(el);
        if (existing) existing.destroy();

        // Frequency-based colour gradient (red = low, green = high)
        var minV = Math.min.apply(null, data.counts);
        var maxV = Math.max.apply(null, data.counts);
        var diff = maxV - minV || 1;
        var bgColors = data.counts.map(function (v) {
        var ratio = (v - minV) / diff;
        return 'hsl(' + Math.round(120 * ratio) + ',65%,45%)';
        });

        new Chart(el, {
        type: 'bar',
        data: {
        labels: data.labels,
        datasets: [{
        label: 'Members',
        data: data.counts,
        backgroundColor: bgColors,
        borderColor: bgColors.map(function (c) { return c.replace('45%', '35%'); }),
        borderWidth: 1,
        borderRadius: 3
        }]
        },
        options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        scales: {
        x: {
        beginAtZero: true,
        ticks: { font: { size: 8 } },
        title: { display: true, text: 'Members', font: { size: 8 } }
        },
        y: {
        ticks: { font: { size: 8 } }
        }
        },
        plugins: {
        legend: { display: false },
        datalabels: {
        anchor: 'end',
        align: 'end',
        color: '#333',
        font: { size: 8 },
        formatter: function (v) { return v; }
        },
        tooltip: {
        callbacks: {
        label: function (ctx) { return ' ' + ctx.parsed.x + ' members'; }
        }
        }
        }
        }
        });
        }

        // ── Render all charts (given a root context) ──────────────────
        function renderAllCharts() {
        if (typeof Chart === 'undefined') return;
        if (typeof ChartDataLabels !== 'undefined') {
        Chart.register(ChartDataLabels);
        }

        makeDoughnut('chartMemberType',  DATA.memberType);
        makeDoughnut('chartStatus',      DATA.status);
        makeDoughnut('chartMemberGroup', DATA.memberGroup);
        makeDoughnut('chartGender',      DATA.gender);
        makeHBar('chartReligion',        DATA.religion);
        makeHBar('chartOccupation',      DATA.occupation);
        }

        // Run once DOM is ready
        if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderAllCharts);
        } else {
        renderAllCharts();
        }

        // Expose for post-pagination re-render
        window._vReportRenderCharts = renderAllCharts;

        }());
    </script>

    @* ════════════════════════════════════════════════════════════════════
       VIEW-only pagination (same architecture as MemberAllDetails)
    ════════════════════════════════════════════════════════════════════ *@
    @if (isView)
    {
        <script>
            (function () {
            'use strict';

            var MAX_RETRIES = 6;
            var RETRY_DELAY = 100;
            var retryCount  = 0;
            var PAGE_W      = 3600;
            var PAGE_H      = 1587;   // 420 mm @@ 96 dpi
            var FOOTER_H    = 28;

            function buildPages() {
            var subHdrTpl  = document.getElementById('subheaderTemplate');
            var kpiTpl     = document.getElementById('kpiTemplate');
            var chartsTpl  = document.getElementById('chartsTemplate');
            var commonHdrEl = document.getElementById('commonHeaderSource');

            if (!subHdrTpl || !kpiTpl || !chartsTpl) {
            if (retryCount++ < MAX_RETRIES)
            setTimeout(function () { requestAnimationFrame(buildPages); }, RETRY_DELAY);
            return;
            }

            // Wait until charts are painted (canvas height > 0)
            var anyCanvas = chartsTpl.querySelector('canvas');
            if (anyCanvas && anyCanvas.getBoundingClientRect().height === 0) {
            if (retryCount++ < MAX_RETRIES)
            setTimeout(function () { requestAnimationFrame(buildPages); }, RETRY_DELAY);
            return;
            }

            // ── Measure source element heights ─────────────────────────
            var commonHdrH = commonHdrEl ? commonHdrEl.getBoundingClientRect().height : 0;
            var commonHdrHtml = commonHdrEl ? commonHdrEl.innerHTML : '';
            var subHdrH    = subHdrTpl.getBoundingClientRect().height;
            var kpiH       = kpiTpl.getBoundingClientRect().height;
            var chartsH    = chartsTpl.getBoundingClientRect().height;

            var subHdrHtml  = subHdrTpl.outerHTML;
            var kpiHtml     = kpiTpl.outerHTML;
            var chartsHtml  = chartsTpl.outerHTML;

            // ── Remove source DOM ──────────────────────────────────────
            var sourceWrap = document.getElementById('sourceWrap');
            if (sourceWrap)  sourceWrap.parentNode.removeChild(sourceWrap);
            if (commonHdrEl) commonHdrEl.parentNode.removeChild(commonHdrEl);

            var viewOuter = document.getElementById('viewOuter');

            // ── Build page card ────────────────────────────────────────
            // This report is always ONE visual page (charts only, no rows to paginate).
            var card = document.createElement('div');
            card.className = 'view-page';
            card.setAttribute('data-page', '1');

            var contentHtml = '<div class="view-page-content">';

            if (commonHdrHtml) {
            contentHtml += '<div class="common-header-wrap">' + commonHdrHtml + '</div>';
            }
            contentHtml += '<div class="page-subheader">' + subHdrHtml + '</div>';
            contentHtml += '<div class="page-kpi">'        + kpiHtml    + '</div>';
            contentHtml += '<div class="page-charts">'     + chartsHtml + '</div>';

            contentHtml += '</div>';  // .view-page-content
            contentHtml += '<div class="view-page-footer">Page 1 of 1</div>';

            card.innerHTML = contentHtml;
            viewOuter.appendChild(card);

            // ── Re-render charts inside the live card ──────────────────
            // innerHTML clones DOM but canvas pixels are lost — must re-init.
            setTimeout(function () {
            if (typeof window._vReportRenderCharts === 'function') {
            window._vReportRenderCharts();
            }
            }, 80);

            // ── Drag-to-scroll ─────────────────────────────────────────
            (function (el) {
            var drag = false, sx = 0, ss = 0;
            el.addEventListener('mousedown', function (e) {
            if (e.button !== 0) return;
            drag = true; sx = e.clientX; ss = el.scrollLeft;
            el.style.userSelect = 'none'; e.preventDefault();
            });
            document.addEventListener('mousemove', function (e) {
            if (drag) el.scrollLeft = ss - (e.clientX - sx);
            });
            document.addEventListener('mouseup', function () {
            drag = false; el.style.userSelect = '';
            });
            })(viewOuter);

            // ── Notify parent iframe ───────────────────────────────────
            if (window.parent && window.parent !== window) {
            window.parent.postMessage(
            { type: 'REPORT_PAGES_READY', totalPages: 1 }, '*'
            );
            }
            }

            // Give Chart.js time to paint before we measure heights
            setTimeout(function () {
            requestAnimationFrame(function () { requestAnimationFrame(buildPages); });
            }, 200);

            }());
        </script>
    }

</body>
</html>
