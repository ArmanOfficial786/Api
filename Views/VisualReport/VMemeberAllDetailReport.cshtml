                    <div class="chart-card">
                        <div class="chart-card-title yellow">Gender Breakdown</div>
                        <div class="chart-canvas-wrap">
                            <canvas id="chartGender"></canvas>
                        </div>
                    </div>
                    <div class="chart-card">
                        <div class="chart-card-title red">Religion Distribution</div>
                        <div class="chart-canvas-wrap">
                            <canvas id="chartReligion"></canvas>
                        </div>
                    </div>
                    <div class="chart-card">
                        <div class="chart-card-title teal">Occupation Distribution</div>
                        <div class="chart-canvas-wrap">
