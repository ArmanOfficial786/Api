@* Views/VisualReport/VMemberAllDetailReport.cshtml *@
@model Dictionary<string, object>
@using NexgenCosysReport.Dtos.ReportDtos
@using NexgenCosysReport.Dtos.RequestDtos.Member
@using Newtonsoft.Json
@{
    Layout = null;

    var dataSet = (Model["MemberAllDetailDataSet"] as IEnumerable<MemberAllDetailSpResponse>)?.ToList()
                  ?? new List<MemberAllDetailSpResponse>();

    var branchName = Model.ContainsKey("BranchName") ? Model["BranchName"]?.ToString() : "All";
    var fromDate = Model.ContainsKey("FromDate") ? Model["FromDate"]?.ToString() : "";
    var toDate = Model.ContainsKey("ToDate") ? Model["ToDate"]?.ToString() : "";
    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";

    var isView = format == "VIEW";
    var isPdf = format == "PDF";

    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    int totalRecords = Model.ContainsKey("TotalRecords")
                       ? Convert.ToInt32(Model["TotalRecords"])
                       : dataSet.Count;

    // ── Server-side aggregations (6 groups) ───────────────────────────────
    // 1. Member Type
    var memberTypeGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.MemberType))
        .GroupBy(r => r.MemberType!.Trim())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count).ToList();

    // 2. Status
    var statusGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.Status))
        .GroupBy(r => r.Status!.Trim())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count).ToList();

    // 3. Gender
    var genderGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.Gender))
        .GroupBy(r => r.Gender!.Trim())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count).ToList();

    // 4. Religion
    var religionGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.Religion))
        .GroupBy(r => r.Religion!.Trim())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count).ToList();

    // 5. Occupation
    var occupationGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.Occupation))
        .GroupBy(r => r.Occupation!.Trim())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count).ToList();

    // 6. Member Group
    var memberGroupGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.MemberGroup))
        .GroupBy(r => r.MemberGroup!.Trim())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count).ToList();

    // ── JSON for JS ───────────────────────────────────────────────────────
    var memberTypeLabelsJson = JsonConvert.SerializeObject(memberTypeGroups.Select(x => x.Label));
    var memberTypeCountsJson = JsonConvert.SerializeObject(memberTypeGroups.Select(x => x.Count));
    var statusLabelsJson = JsonConvert.SerializeObject(statusGroups.Select(x => x.Label));
    var statusCountsJson = JsonConvert.SerializeObject(statusGroups.Select(x => x.Count));
    var genderLabelsJson = JsonConvert.SerializeObject(genderGroups.Select(x => x.Label));
    var genderCountsJson = JsonConvert.SerializeObject(genderGroups.Select(x => x.Count));
    var religionLabelsJson = JsonConvert.SerializeObject(religionGroups.Select(x => x.Label));
    var religionCountsJson = JsonConvert.SerializeObject(religionGroups.Select(x => x.Count));
    var occupationLabelsJson = JsonConvert.SerializeObject(occupationGroups.Select(x => x.Label));
    var occupationCountsJson = JsonConvert.SerializeObject(occupationGroups.Select(x => x.Count));
    var memberGroupLabelsJson = JsonConvert.SerializeObject(memberGroupGroups.Select(x => x.Label));
    var memberGroupCountsJson = JsonConvert.SerializeObject(memberGroupGroups.Select(x => x.Count));
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Member All Detail – Visual Report</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <style>
        /* ── Reset & base ─────────────────────────────────────────────── */
        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        }

        body {
        font-family: Arial, sans-serif;
        font-size: 7pt;
        background: @(isView ? "#d0d0d0" : "#fff");
        @(isView ? "" : "margin-top: 25px;")
        }

        /* ── Sub-header (IDENTICAL to MemberAllDetails) ──────────────── */
        .report-subheader {
        width: 100%;
        padding: 4px 6px 0 6px;
        background: #fff;
        }

        .subheader-title {
        text-align: center;
        font-size: 13pt;
        font-weight: bold;
        text-decoration: underline;
        padding: 6px 4px 4px;
        }

        .subheader-meta {
        display: flex;
        justify-content: space-between;
        font-size: 7.5pt;
        padding: 2px 4px;
        }

        .subheader-spacer {
        height: 5px;
        }

        /* ── KPI strip ────────────────────────────────────────────────── */
        .kpi-strip {
        display: flex;
        gap: 10px;
        padding: 10px 12px;
        background: #fff;
        border-bottom: 1px solid #e0e0e0;
        }

        .kpi-card {
        flex: 1;
        background: #f4f6fb;
        border-left: 4px solid #4e73df;
        padding: 8px 14px;
        border-radius: 3px;
        }

        .kpi-card.green {
        border-color: #1cc88a;
        }

        .kpi-card.yellow {
        border-color: #f6c23e;
        }

        .kpi-card.red {
        border-color: #e74a3b;
        }

        .kpi-card.teal {
        border-color: #36b9cc;
        }

        .kpi-card.purple {
        border-color: #6f42c1;
        }

        .kpi-label {
        font-size: 6.5pt;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 2px;
        }

        .kpi-value {
        font-size: 15pt;
        font-weight: bold;
        color: #333;
        line-height: 1.1;
        }

        /* ── Charts grid ──────────────────────────────────────────────── */
        .charts-section {
        background: #fff;
        padding: 14px 12px 10px;
        }

        .charts-row {
        display: flex;
        gap: 14px;
        margin-bottom: 14px;
        }

        .chart-card {
        flex: 1;
        border: 1px solid #e4e6ef;
        border-radius: 4px;
        padding: 10px 12px 8px;
        background: #fff;
        min-width: 0;
        }

        .chart-card-title {
        font-size: 8pt;
        font-weight: bold;
        color: #444;
        margin-bottom: 6px;
        padding-bottom: 4px;
        border-bottom: 2px solid #4e73df;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        }

        .chart-card-title.green {
        border-color: #1cc88a;
        }

        .chart-card-title.yellow {
        border-color: #f6c23e;
        }

        .chart-card-title.red {
        border-color: #e74a3b;
        }

        .chart-card-title.teal {
        border-color: #36b9cc;
        }

        .chart-card-title.purple {
        border-color: #6f42c1;
        }

        .chart-canvas-wrap {
        position: relative;
        width: 100%;
        height: 220px;
        }

        .chart-canvas-wrap canvas {
        display: block;
        }

        .no-data-msg {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #bbb;
        font-size: 8pt;
        }

        @@media print {
        body {
        margin: 0;
        background: #fff;
        }
        }

        /* ── VIEW chrome (identical dimensions to MemberAllDetails) ───── */
        .view-outer {
        background: #d0d0d0;
        padding: 2px 16px 20px 16px;
        min-height: 100vh;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        cursor: grab;
        }

        .view-outer:active {
        cursor: grabbing;
        }

        .view-page {
        background: #fff;
        margin: 0 auto 24px auto;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
        width: 3600px;
        height: 1587px; /* 420 mm @@ 96 dpi */
        overflow: hidden;
        display: flex;
        flex-direction: column;
        }

        .view-page-content {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        }

        .view-page-footer {
        background: #fff;
        border-top: 1px solid #ccc;
        text-align: center;
        font-size: 9pt;
        font-weight: bold;
        padding: 6px 0;
        flex-shrink: 0;
        }

        .common-header-wrap {
        width: 3600px;
        overflow: hidden;
        flex-shrink: 0;
        }

        .page-subheader {
        flex-shrink: 0;
        }

        .page-kpi {
        flex-shrink: 0;
        }

        .page-charts {
        flex: 1;
        overflow: hidden;
        }

        /* Hidden source elements */
        #sourceWrap {
        opacity: 0;
        pointer-events: none;
        width: 3600px;
        position: absolute;
        top: 0;
        left: 0;
        }

        #commonHeaderSource {
        visibility: hidden;
        position: absolute;
        top: 0;
        left: 0;
        width: 3600px;
        pointer-events: none;
        }
    </style>
</head>
<body>

