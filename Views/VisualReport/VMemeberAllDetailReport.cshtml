        @* Charts – 2 rows x 3 cards *@
        <div class="charts-section">
            <div class="charts-row">
                <div class="chart-card">
                    <div class="chart-card-title">Member Type Distribution</div>
                    <div class="chart-canvas-wrap">
                        <canvas id="chartMemberType"></canvas>
                    </div>
                </div>
                <div class="chart-card">
                    <div class="chart-card-title green">Member Status Distribution</div>
                    <div class="chart-canvas-wrap">
                        <canvas id="chartStatus"></canvas>
                    </div>
                </div>
                <div class="chart-card">
                    <div class="chart-card-title purple">Member Group Distribution</div>
                    <div class="chart-canvas-wrap">
