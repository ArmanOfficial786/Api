@* Views/Report/MemberRegistrationReport.cshtml *@
@model Dictionary<string, object>
@using NexgenCosysReport.Dtos.ReportDtos
@using Newtonsoft.Json
@{
    Layout = null;

    var dataSet = (Model["StudentDataSet"] as IEnumerable<MemberRegistrationDetail>)?.ToList()
                  ?? new List<MemberRegistrationDetail>();

    var branchName = Model.ContainsKey("BranchName") ? Model["BranchName"]?.ToString() : "All";
    var fromDate = Model.ContainsKey("FromDate") ? Model["FromDate"]?.ToString() : "";
    var toDate = Model.ContainsKey("ToDate") ? Model["ToDate"]?.ToString() : "";
    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";
    var isPdf = format == "PDF";
    var isView = format == "VIEW";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");

    int totalRecords = Model.ContainsKey("TotalRecords")
                       ? Convert.ToInt32(Model["TotalRecords"])
                       : dataSet.Count;

    // --- Chart data aggregation (only for VIEW) ---
    var genderGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.Sex))
        .GroupBy(r => r.Sex.Trim().ToUpperInvariant())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .ToList();

    var districtGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.District))
        .GroupBy(r => r.District.Trim())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .Take(10)
        .ToList();

    var genderLabelsJson = JsonConvert.SerializeObject(genderGroups.Select(x => x.Label));
    var genderCountsJson = JsonConvert.SerializeObject(genderGroups.Select(x => x.Count));
    var districtLabelsJson = JsonConvert.SerializeObject(districtGroups.Select(x => x.Label));
    var districtCountsJson = JsonConvert.SerializeObject(districtGroups.Select(x => x.Count));
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Member Registration Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                margin-top: 35px;
                font-family: Arial, sans-serif;
                font-size: 7pt;
                background: #fff !important;
            }

            .text-right {
                text-align: right !important;
            }

            .text-center {
                text-align: center !important;
            }

            .text-left {
                text-align: left !important;
            }

            .meta-title td {
                text-align: center;
                font-size: 13pt;
                font-weight: bold;
                text-decoration: underline;
                padding: 6px 4px 4px;
            }

            .meta-row td {
                padding: 3px 4px;
                font-size: 7.5pt;
            }

            .meta-spacer td {
                height: 5px;
            }

            .view-outer {
                background: #fff;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .report-card {
                background: #fff;
                margin: 16px 16px 0 16px;
                border: 1px solid #ccc;
                border-bottom: none;
                overflow: hidden;
            }

            /* ---- Chart layout ---- */
            .chart-stack {
                padding: 16px;
            }

            .chart-block {
                width: 100%;
                margin-bottom: 30px;
            }

                .chart-block h4 {
                    margin: 0 0 8px;
                    font-size: 10pt;
                }

            canvas {
                width: 100% !important;
                max-height: 400px;
            }

            .no-data-msg {
                padding: 20px;
                text-align: center;
                color: #666;
                font-size: 10pt;
            }

            /* ---- Pagination bar (exactly as in original table report) ---- */
            .pagination-bar {
                margin: 0 16px 16px 16px;
                background: #fff;
                border: 1px solid #ccc;
                border-top: 1px solid #999;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 7px 12px;
                font-size: 9pt;
                font-weight: bold;
                user-select: none;
                flex-shrink: 0;
            }

                .pagination-bar.hidden {
                    display: none;
                }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
</head>
<body>
    <div class="view-outer">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }
        <div class="report-card">

            <div class="chart-stack">
                <div class="chart-block">
                    <h4>Top Territories (Districts) – Colour indicates performance</h4>
                    <canvas id="districtChart"></canvas>
                </div>
                <div class="chart-block">
                    <h4>Gender Distribution with Percentage</h4>
                    <canvas id="genderChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Pagination bar – static “Page 1 of 1” (no pagination logic needed) -->
        <div class="pagination-bar" id="paginationBar">
            Page <span id="spanCurrent">1</span> of <span id="spanTotal">1</span>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
        if (typeof Chart === 'undefined') {
        document.querySelector('.chart-stack').innerHTML = '<div class="no-data-msg">Charts cannot be loaded.</div>';
        return;
        }
        if (typeof ChartDataLabels !== 'undefined') {
        Chart.register(ChartDataLabels);
        }

        // ----- Custom plugin to draw total in center of doughnut -----
        const centerTextPlugin = {
        id: 'centerText',
        afterDraw(chart) {
        const { ctx, chartArea: { left, top, width, height } } = chart;
        const total = chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
        ctx.save();
        ctx.font = 'bold 18px Arial';
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('Total: ' + total, left + width / 2, top + height / 2);
        ctx.restore();
        }
        };

        // ====== 1. District Bar Chart (horizontal) ======
        var districtData = @Html.Raw(districtCountsJson);
        var districtLabels = @Html.Raw(districtLabelsJson);

        if (districtData.length > 0) {
        var minVal = Math.min.apply(null, districtData);
        var maxVal = Math.max.apply(null, districtData);

        function valueToColor(value, min, max) {
        var diff = max - min;
        if (diff === 0) diff = 1;
        var ratio = (value - min) / diff;
        var hue = 120 * ratio;
        return 'hsl(' + hue + ', 70%, 45%)';
        }

        var backgroundColors = districtData.map(function (v) {
        return valueToColor(v, minVal, maxVal);
        });
        var borderColors = backgroundColors.map(function (c) {
        return c.replace('45%', '35%');
        });

        new Chart(document.getElementById('districtChart'), {
        type: 'bar',
        data: {
        labels: districtLabels,
        datasets: [{
        label: 'Members',
        data: districtData,
        backgroundColor: backgroundColors,
        borderColor: borderColors,
        borderWidth: 1,
        borderRadius: 3
        }]
        },
        options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        scales: {
        x: { beginAtZero: true, title: { display: true, text: 'Number of Members' } },
        y: { ticks: { font: { size: 10 } } }
        },
        plugins: {
        legend: { display: false },
        tooltip: {
        callbacks: {
        label: function (ctx) { return ctx.parsed.x + ' members'; }
        }
        }
        }
        }
        });
        } else {
        document.getElementById('districtChart').parentElement.innerHTML = '<div class="no-data-msg">No district data available.</div>';
        }

        // ====== 2. Gender Donut Chart with percentage labels and center total ======
        var genderData = @Html.Raw(genderCountsJson);
        var genderLabels = @Html.Raw(genderLabelsJson);

        if (genderData.length > 0) {
        var palette = ['#4e73df', '#1cc88a', '#f6c23e', '#e74a3b', '#858796'];
        var colors = genderData.map(function(_, i) { return palette[i % palette.length]; });

        new Chart(document.getElementById('genderChart'), {
        type: 'doughnut',
        data: {
        labels: genderLabels,
        datasets: [{
        data: genderData,
        backgroundColor: colors,
        borderWidth: 2
        }]
        },
        options: {
        responsive: true,
        plugins: {
        legend: {
        position: 'bottom',
        labels: { font: { size: 10 }, usePointStyle: true }
        },
        datalabels: {
        color: '#fff',
        font: { weight: 'bold', size: 12 },
        formatter: function (value, ctx) {
        var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
        if (total === 0) return '0%';
        return ((value / total) * 100).toFixed(1) + '%';
        },
        anchor: 'center',
        align: 'center',
        offset: 0
        }
        }
        },
        plugins: [centerTextPlugin]
        });
        } else {
        document.getElementById('genderChart').parentElement.innerHTML = '<div class="no-data-msg">No gender data available.</div>';
        }
        });
    </script>
</body>
</html>