@* Views/VisualReport/Member/VMemberRegistrationReport.cshtml *@
@model Dictionary<string, object>
@using NexgenCosysReport.Dtos.ReportDtos
@using NexgenCosysReport.Dtos.RequestDtos.Member
@using Newtonsoft.Json
@{
    Layout = null;

    IEnumerable<MemberRegistrationDetail>? source = null;
    if (Model.ContainsKey("MemberAllDetailDataSet"))
        source = Model["MemberAllDetailDataSet"] as IEnumerable<MemberRegistrationDetail>;
    if (source == null && Model.ContainsKey("StudentDataSet"))
        source = Model["StudentDataSet"] as IEnumerable<MemberRegistrationDetail>;

    var dataSet = source?.ToList() ?? new List<MemberRegistrationDetail>();

    var format = Model.ContainsKey("Format") ? Model["Format"]?.ToString() : "VIEW";
    var isExcel = format == "EXCEL" || format == "XLSX";

    int totalRecords = Model.ContainsKey("TotalRecords")
                       ? Convert.ToInt32(Model["TotalRecords"])
                       : dataSet.Count;

    var genderGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.Sex))
        .GroupBy(r => r.Sex.Trim().ToUpperInvariant())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .ToList();

    var districtGroups = dataSet
        .Where(r => !string.IsNullOrEmpty(r.District))
        .GroupBy(r => r.District.Trim())
        .Select(g => new { Label = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .Take(10)
        .ToList();

    var genderLabelsJson = JsonConvert.SerializeObject(genderGroups.Select(x => x.Label));
    var genderCountsJson = JsonConvert.SerializeObject(genderGroups.Select(x => x.Count));
    var districtLabelsJson = JsonConvert.SerializeObject(districtGroups.Select(x => x.Label));
    var districtCountsJson = JsonConvert.SerializeObject(districtGroups.Select(x => x.Count));

    int districtHeight = Math.Max(240, districtGroups.Count * 38 + 80);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Member Registration Report</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                margin-top: 35px;
                font-family: Arial, sans-serif;
                font-size: 7pt;
                background: #fff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .view-outer {
                background: #fff;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .report-card {
                background: #fff;
                margin: 16px 16px 0 16px;
                border: 1px solid #ccc;
                border-bottom: none;
                overflow: hidden;
            }

            .chart-stack {
                padding: 16px;
            }

            .chart-block {
                width: 100%;
                margin-bottom: 30px;
            }

                .chart-block h4 {
                    margin: 0 0 8px;
                    font-size: 10pt;
                }

            .chart-wrap {
                position: relative;
                width: 100%;
            }

                .chart-wrap.gender {
                    height: 380px;
                }

            .no-data-msg {
                padding: 20px;
                text-align: center;
                color: #666;
                font-size: 10pt;
            }

            .pagination-bar {
                margin: 0 16px 16px 16px;
                background: #fff;
                border: 1px solid #ccc;
                border-top: 1px solid #999;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 7px 12px;
                font-size: 9pt;
                font-weight: bold;
                user-select: none;
                flex-shrink: 0;
            }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
</head>
<body>
    <div class="view-outer">
        @if (!isExcel)
        {
            @await Html.PartialAsync("_CommonHeader", Model)
        }

        <div class="report-card">
            <div class="chart-stack">
                <div class="chart-block">
                    <h4>Top Territories (Districts) – Colour indicates performance</h4>
                    <div class="chart-wrap" id="districtWrap" style="height:@(districtHeight)px">
                        <canvas id="districtChart"></canvas>
                    </div>
                </div>
                <div class="chart-block">
                    <h4>Gender Distribution with Percentage</h4>
                    <div class="chart-wrap gender" id="genderWrap">
                        <canvas id="genderChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="pagination-bar">Page 1 of 1 &nbsp;|&nbsp; Total Records : @totalRecords</div>
    </div>

    <script>
            window.chartsReady = false;

            document.addEventListener('DOMContentLoaded', function () {
                function noData(id, msg) {
                    var w = document.getElementById(id);
                    w.style.height = 'auto';
                    w.innerHTML = '<div class="no-data-msg">' + msg + '</div>';
                }

                if (typeof Chart === 'undefined') {
                    noData('districtWrap', 'Charts cannot be loaded (Chart.js CDN unreachable).');
                    noData('genderWrap', 'Charts cannot be loaded (Chart.js CDN unreachable).');
                    window.chartsReady = true;
                    return;
                }
                if (typeof ChartDataLabels !== 'undefined') {
                    Chart.register(ChartDataLabels);
                }

                function sum(a) { return a.reduce(function (x, y) { return x + y; }, 0); }

                var centerTextPlugin = {
                    id: 'centerText',
                    afterDraw: function (chart) {
                        var ctx = chart.ctx, area = chart.chartArea;
                        ctx.save();
                        ctx.font = 'bold 18px Arial';
                        ctx.fillStyle = '#333333';
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.fillText('Total: ' + sum(chart.data.datasets[0].data),
                            (area.left + area.right) / 2, (area.top + area.bottom) / 2);
                        ctx.restore();
                    }
                };

                // ── District horizontal bar ──
                var districtData = @Html.Raw(districtCountsJson);
                var districtLabels = @Html.Raw(districtLabelsJson);

                if (districtData.length > 0) {
                    var minVal = Math.min.apply(null, districtData);
                    var maxVal = Math.max.apply(null, districtData);

                    function valueToColor(v, min, max) {
                        var diff = max - min; if (diff === 0) diff = 1;
                        return 'hsl(' + (120 * ((v - min) / diff)) + ', 70%, 45%)';
                    }

                    var bg = districtData.map(function (v) { return valueToColor(v, minVal, maxVal); });
                    var bd = bg.map(function (c) { return c.replace('45%', '35%'); });

                    new Chart(document.getElementById('districtChart'), {
                        type: 'bar',
                        data: {
                            labels: districtLabels,
                            datasets: [{ label: 'Members', data: districtData, backgroundColor: bg,
                                         borderColor: bd, borderWidth: 1, borderRadius: 3 }]
                        },
                        options: {
                            indexAxis: 'y', responsive: true, maintainAspectRatio: false, animation: false,
                            scales: {
                                x: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Number of Members' } },
                                y: { ticks: { font: { size: 10 } } }
                            },
                            plugins: {
                                legend: { display: false },
                                datalabels: { anchor: 'end', align: 'end', color: '#333', font: { weight: 'bold', size: 10 } },
                                tooltip: { callbacks: { label: function (c) { return c.parsed.x + ' members'; } } }
                            }
                        }
                    });
                } else {
                    noData('districtWrap', 'No district data available.');
                }

                // ── Gender doughnut ──
                var genderData = @Html.Raw(genderCountsJson);
                var genderLabels = @Html.Raw(genderLabelsJson);

                if (genderData.length > 0) {
                    var palette = ['#4e73df', '#1cc88a', '#f6c23e', '#e74a3b', '#858796'];
                    new Chart(document.getElementById('genderChart'), {
                        type: 'doughnut',
                        data: {
                            labels: genderLabels,
                            datasets: [{ data: genderData,
                                         backgroundColor: genderData.map(function (_, i) { return palette[i % palette.length]; }),
                                         borderWidth: 2 }]
                        },
                        options: {
                            responsive: true, maintainAspectRatio: false, animation: false,
                            plugins: {
                                legend: { position: 'bottom', labels: { font: { size: 10 }, usePointStyle: true } },
                                datalabels: {
                                    color: '#fff', font: { weight: 'bold', size: 12 },
                                    formatter: function (v, ctx) {
                                        var t = sum(ctx.dataset.data);
                                        return t === 0 ? '0%' : ((v / t) * 100).toFixed(1) + '%';
                                    }
                                }
                            }
                        },
                        plugins: [centerTextPlugin]
                    });
                } else {
                    noData('genderWrap', 'No gender data available.');
                }

                window.chartsReady = true;
            });
    </script>
</body>
</html>