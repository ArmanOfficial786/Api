@using NexgenCosysReport.Dtos.ReportDtos
@using NexgenCosysReport.Dtos.RequestDtos.Loan.LoanAnalysisReport
@using NexgenCosysReport.Services.ReportService.Table
@using NexgenCosysReport.Services.ReportService.Visual
@model Dictionary<string, object>
@{
    Layout = null;

    // ── 1. DATA (set by the controller) ──
    var provisionRows = (Model["Rows"] as List<LoanProvisionRowDto>) ?? new();
    var totalAmount = Model["TotalAmount"] as decimal? ?? 0;
    var totalProvisionAmount = Model["TotalProvisionAmount"] as decimal? ?? 0;
    var totalLoans = Model["TotalLoans"] as int? ?? 0;
    var tillDate = Model["TillDate"]?.ToString() ?? "";
    var branchName = Model["BranchName"]?.ToString() ?? "All";
    var memberGroupName = Model["MemberGroupName"]?.ToString() ?? "All";
    var penaltyType = Model["PenaltyType"]?.ToString() ?? "S";
    var penaltyTypeName = Model["PenaltyTypeName"]?.ToString() ?? "Schedule Wise";
    var generatedOn = DateTime.Now.ToString("yyyy/MM/dd");
    var memberGroupFiltered = !string.IsNullOrEmpty(memberGroupName) && memberGroupName != "All";

    // totals fall back to the sum of the rows when the controller did not send them
    if (totalLoans == 0) totalLoans = provisionRows.Sum(row => row.NoofLoan ?? 0);
    if (totalAmount == 0) totalAmount = provisionRows.Sum(row => row.Amount ?? 0);
    if (totalProvisionAmount == 0) totalProvisionAmount = provisionRows.Sum(row => row.ProvisionAmount ?? 0);

    // ── 2. NUMBERS FOR THE KPI CARDS ──
    var coveragePercent = totalAmount == 0 ? 0 : Math.Round(totalProvisionAmount / totalAmount * 100, 2);
    var averageLoan = totalLoans == 0 ? 0 : totalAmount / totalLoans;
    var highestRow = provisionRows.OrderByDescending(row => row.ProvisionAmount ?? 0).FirstOrDefault();
    var highestName = highestRow?.ProvisionName ?? "-";
    var highestShare = (highestRow == null || totalProvisionAmount == 0)
                          ? 0 : Math.Round((highestRow.ProvisionAmount ?? 0) / totalProvisionAmount * 100, 1);

    var badgeClass = penaltyType == "S" ? "badge-schedule" : penaltyType == "R" ? "badge-remaining" : "badge-maturity";

    // ── 3. REPORT: data, title, special CSS ──
    var report = new VisualReport(Model, title: "Loan Provision Visual Report", sheetName: "LoanProvision")
        .PrintedTitle("Loan Provision Report — Visual Summary")
        .NoDataWhen(!provisionRows.Any())
        .ChartRows(provisionRows.Select(row => new
        {
            name = row.ProvisionName ?? "",
            pct = row.ProvisionPercentage ?? 0,
            loans = row.NoofLoan ?? 0,
            amount = row.Amount ?? 0,
            provision = row.ProvisionAmount ?? 0,
            avg = (row.NoofLoan ?? 0) > 0 ? (row.Amount ?? 0) / (row.NoofLoan ?? 0) : 0m
        }))
        .Sizing(chartRowMm: 75)
        .Css(@"
            .penalty-badge { display: inline-block; padding: 2px 10px; border-radius: 3px; font-size: 8pt; font-weight: bold; }
            .badge-schedule  { background: #d1ecf1; color: #0c5460; }
            .badge-remaining { background: #fff3cd; color: #856404; }
            .badge-maturity  { background: #f8d7da; color: #721c24; }");

    // ── 4. TITLE BLOCK (a line is drawn under it automatically) ──
    var generatedLine = Fmt.Labeled("Report Generated On :", generatedOn);
    report.MetaLeft("Branch :", branchName)
          .MetaLeft(Fmt.Labeled("Penalty Type :", Fmt.Badge(penaltyTypeName, $"penalty-badge {badgeClass}")))
          .MetaRight("Till Date :", tillDate)
          .MetaRight(memberGroupFiltered
              ? Fmt.Join(Fmt.Labeled("Member Group :", memberGroupName), generatedLine)
              : generatedLine);

    // ── 5. BLOCKS (the builder decides which page each one lands on) ──
    report.Kpis(kpis => kpis
            .Add("Total Loans", totalLoans.ToString("N0"), $"{provisionRows.Count} provision categories")
            .Add("Loan Outstanding", totalAmount.ToString("N2"), $"avg {averageLoan:N2} / loan")
            .Add("Total Provision", totalProvisionAmount.ToString("N2"), "required provision")
            .Add("Provision Coverage", $"{coveragePercent:0.00}%", "provision / outstanding")
            .Add("Highest Provision", highestName, $"{highestShare:0.0}% of total provision", smallValue: true))
          .ChartGrid(3, grid => grid
            .Donut("No. of Loans by Category", "loans")
            .Donut("Outstanding Amount Share", "amount", money: true)
            .Donut("Provision Amount Share", "provision", money: true))
          
          .ChartGrid(2, grid => grid
            .Grouped("Outstanding vs Provision Amount",
                     new VisualSeries("Amount", "amount", "#2563eb"),
                     new VisualSeries("Provision Amount", "provision", "#ef4444"))
            .BarLine("Provision Rate (%) by Category", "pct", "#f59e0b", "#8b5cf6", format: "percent")
            .Bar("Average Loan Size by Category", "avg", "#10b981", thickness: 26)
            .Bar("Provision Amount by Category", "provision", "#ef4444"));
}
@await Html.PartialAsync("_SheetReport", await report.BuildAsync(Html))